{"PageNumber":379,"Verses":[{"SurahNumber":27,"SurahIndex":"027","VerseNumber":23,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنِّي وَجَدتُّ ٱمۡرَأَةٗ تَمۡلِكُهُمۡ وَأُوتِيَتۡ مِن كُلِّ شَيۡءٖ وَلَهَا عَرۡشٌ عَظِيمٞ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>ِى وَجَ<tajweed class=idgham_mutajanisayn>د</tajweed>تُّ <tajweed class=ham_wasl>ٱ</tajweed>مْرَأَ<tajweed class=ikhafa>ةً ت</tajweed>َمْلِكُهُمْ وَأُوتِيَتْ مِ<tajweed class=ikhafa>ن ك</tajweed>ُلِّ ش<tajweed class=idgham_ghunnah>َىْءٍ و</tajweed>َلَهَا عَرْشٌ عَظ<tajweed class=madda_permissible>ِي</tajweed>مٌ <span class=end>٢٣</span>","End":"٢٣","PageNumber":379,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":328,"MaqraNumber":151,"HizbNumber":38,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":24,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَجَدتُّهَا وَقَوۡمَهَا يَسۡجُدُونَ لِلشَّمۡسِ مِن دُونِ ٱللَّهِ وَزَيَّنَ لَهُمُ ٱلشَّيۡطَٰنُ أَعۡمَٰلَهُمۡ فَصَدَّهُمۡ عَنِ ٱلسَّبِيلِ فَهُمۡ لَا يَهۡتَدُونَ","TajweedText":"وَجَ<tajweed class=idgham_mutajanisayn>د</tajweed>تُّهَا وَقَوْمَهَا يَسْجُدُونَ لِلشَّمْسِ مِ<tajweed class=ikhafa>ن د</tajweed>ُونِ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ وَزَيَّنَ لَهُمُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>شَّيْطَ<tajweed class=madda_normal>ـٰ</tajweed>نُ أَعْمَ<tajweed class=madda_normal>ـٰ</tajweed>لَهُمْ فَصَدَّهُمْ عَنِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّبِيلِ فَهُمْ لَا يَهْتَد<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٤</span>","End":"٢٤","PageNumber":379,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":328,"MaqraNumber":151,"HizbNumber":38,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":25,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَلَّاۤ يَسۡجُدُواْۤ لِلَّهِ ٱلَّذِي يُخۡرِجُ ٱلۡخَبۡءَ فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَيَعۡلَمُ مَا تُخۡفُونَ وَمَا تُعۡلِنُونَ","TajweedText":"أَلَّا يَسْجُدُو<tajweed class=slnt>اْ</tajweed> لِلَّهِ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى يُخْرِجُ <tajweed class=ham_wasl>ٱ</tajweed>لْخَ<tajweed class=qalaqah>بْ</tajweed>ءَ فِى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّمَ<tajweed class=madda_normal>ـٰ</tajweed>و<tajweed class=madda_normal>َٲ</tajweed>تِ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ وَيَعْلَمُ مَا تُخْفُونَ وَمَا تُعْلِن<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٥</span>","End":"٢٥","PageNumber":379,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":328,"MaqraNumber":151,"HizbNumber":38,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":26,"ShowSurahName":false,"ShowBismillah":false,"Text":"ٱللَّهُ لَآ إِلَٰهَ إِلَّا هُوَ رَبُّ ٱلۡعَرۡشِ ٱلۡعَظِيمِ۩","TajweedText":"ٱللَّهُ ل<tajweed class=madda_obligatory>َآ</tajweed> إِلَ<tajweed class=madda_normal>ـٰ</tajweed>هَ إِلَّا هُوَ رَبُّ <tajweed class=ham_wasl>ٱ</tajweed>لْعَرْشِ <tajweed class=ham_wasl>ٱ</tajweed>لْعَظِ<tajweed class=madda_permissible>ي</tajweed>مِ ۩ <span class=end>٢٦</span>","End":"٢٦","PageNumber":379,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":328,"MaqraNumber":151,"HizbNumber":38,"HizbDecimal":0.5,"HasSajda":true},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":27,"ShowSurahName":false,"ShowBismillah":false,"Text":"۞قَالَ سَنَنظُرُ أَصَدَقۡتَ أَمۡ كُنتَ مِنَ ٱلۡكَٰذِبِينَ","TajweedText":"۞ قَالَ سَنَ<tajweed class=ikhafa>نظ</tajweed>ُرُ أَصَدَ<tajweed class=qalaqah>قْ</tajweed>تَ أَمْ كُ<tajweed class=ikhafa>نت</tajweed>َ مِنَ <tajweed class=ham_wasl>ٱ</tajweed>لْكَ<tajweed class=madda_normal>ـٰ</tajweed>ذِب<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٢٧</span>","End":"٢٧","PageNumber":379,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":328,"MaqraNumber":152,"HizbNumber":38,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":28,"ShowSurahName":false,"ShowBismillah":false,"Text":"ٱذۡهَب بِّكِتَٰبِي هَٰذَا فَأَلۡقِهۡ إِلَيۡهِمۡ ثُمَّ تَوَلَّ عَنۡهُمۡ فَٱنظُرۡ مَاذَا يَرۡجِعُونَ","TajweedText":"ٱذْهَب بِّكِتَ<tajweed class=madda_normal>ـٰ</tajweed>بِى هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا فَأَلْقِهْ إِلَيْهِمْ ثُ<tajweed class=ghunnah>مّ</tajweed>َ تَوَلَّ عَنْهُمْ فَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=ikhafa>نظ</tajweed>ُرْ مَاذَا يَرْجِع<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٨</span>","End":"٢٨","PageNumber":379,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":328,"MaqraNumber":152,"HizbNumber":38,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":29,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَتۡ يَـٰٓأَيُّهَا ٱلۡمَلَؤُاْ إِنِّيٓ أُلۡقِيَ إِلَيَّ كِتَٰبٞ كَرِيمٌ","TajweedText":"قَالَتْ يَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>أَيُّهَا <tajweed class=ham_wasl>ٱ</tajweed>لْمَلَؤُ<tajweed class=slnt>اْ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed><tajweed class=madda_obligatory>ِىٓ</tajweed> أُلْقِىَ إِلَىَّ كِتَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=ikhafa>بٌ ك</tajweed>َر<tajweed class=madda_permissible>ِي</tajweed>مٌ <span class=end>٢٩</span>","End":"٢٩","PageNumber":379,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":328,"MaqraNumber":152,"HizbNumber":38,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":30,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّهُۥ مِن سُلَيۡمَٰنَ وَإِنَّهُۥ بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> مِ<tajweed class=ikhafa>ن س</tajweed>ُلَيْمَ<tajweed class=madda_normal>ـٰ</tajweed>نَ وَإِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> بِسْمِ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رَّحْمَ<tajweed class=madda_normal>ـٰ</tajweed>نِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رَّح<tajweed class=madda_permissible>ِي</tajweed>مِ <span class=end>٣٠</span>","End":"٣٠","PageNumber":379,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":328,"MaqraNumber":152,"HizbNumber":38,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":31,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَلَّا تَعۡلُواْ عَلَيَّ وَأۡتُونِي مُسۡلِمِينَ","TajweedText":"أَلَّا تَعْلُو<tajweed class=slnt>اْ</tajweed> عَلَىَّ وَأْتُونِى مُسْلِم<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٣١</span>","End":"٣١","PageNumber":379,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":328,"MaqraNumber":152,"HizbNumber":38,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":32,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَتۡ يَـٰٓأَيُّهَا ٱلۡمَلَؤُاْ أَفۡتُونِي فِيٓ أَمۡرِي مَا كُنتُ قَاطِعَةً أَمۡرًا حَتَّىٰ تَشۡهَدُونِ","TajweedText":"قَالَتْ يَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>أَيُّهَا <tajweed class=ham_wasl>ٱ</tajweed>لْمَلَؤُ<tajweed class=slnt>اْ</tajweed> أَفْتُونِى ف<tajweed class=madda_obligatory>ِىٓ</tajweed> أَمْرِى مَا كُ<tajweed class=ikhafa>نت</tajweed>ُ قَاطِعَةً أَمْرًا حَتَّىٰ تَشْهَد<tajweed class=madda_permissible>ُو</tajweed>نِ <span class=end>٣٢</span>","End":"٣٢","PageNumber":379,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":329,"MaqraNumber":152,"HizbNumber":38,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":33,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالُواْ نَحۡنُ أُوْلُواْ قُوَّةٖ وَأُوْلُواْ بَأۡسٖ شَدِيدٖ وَٱلۡأَمۡرُ إِلَيۡكِ فَٱنظُرِي مَاذَا تَأۡمُرِينَ","TajweedText":"قَالُو<tajweed class=slnt>اْ</tajweed> نَحْنُ أُ<tajweed class=slnt>وْ</tajweed>لُو<tajweed class=slnt>اْ</tajweed> قُوَّ<tajweed class=idgham_ghunnah>ةٍ و</tajweed>َأُ<tajweed class=slnt>وْ</tajweed>لُو<tajweed class=slnt>اْ</tajweed> بَأْ<tajweed class=ikhafa>سٍ ش</tajweed>َدِي<tajweed class=idgham_ghunnah>دٍ و</tajweed>َ<tajweed class=ham_wasl>ٱ</tajweed>لْأَمْرُ إِلَيْكِ فَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=ikhafa>نظ</tajweed>ُرِى مَاذَا تَأْمُر<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٣٣</span>","End":"٣٣","PageNumber":379,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":329,"MaqraNumber":152,"HizbNumber":38,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":34,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَتۡ إِنَّ ٱلۡمُلُوكَ إِذَا دَخَلُواْ قَرۡيَةً أَفۡسَدُوهَا وَجَعَلُوٓاْ أَعِزَّةَ أَهۡلِهَآ أَذِلَّةٗۚ وَكَذَٰلِكَ يَفۡعَلُونَ","TajweedText":"قَالَتْ إِ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>لْمُلُوكَ إِذَا دَخَلُو<tajweed class=slnt>اْ</tajweed> قَرْيَةً أَفْسَدُوهَا وَجَعَل<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> أَعِزَّةَ أَهْلِه<tajweed class=madda_obligatory>َآ</tajweed> أَذِلَّ<tajweed class=idgham_ghunnah>ةً‌ۖ و</tajweed>َكَذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ يَفْعَل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣٤</span>","End":"٣٤","PageNumber":379,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":329,"MaqraNumber":152,"HizbNumber":38,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":35,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِنِّي مُرۡسِلَةٌ إِلَيۡهِم بِهَدِيَّةٖ فَنَاظِرَةُۢ بِمَ يَرۡجِعُ ٱلۡمُرۡسَلُونَ","TajweedText":"وَإِ<tajweed class=ghunnah>نّ</tajweed>ِى مُرْسِلَةٌ إِلَيْه<tajweed class=ikhafa_shafawi>ِم ب</tajweed>ِهَدِيَّ<tajweed class=ikhafa>ةٍ ف</tajweed>َنَاظِرَ<tajweed class=iqlab>ةُۢ ب</tajweed>ِمَ يَرْجِعُ <tajweed class=ham_wasl>ٱ</tajweed>لْمُرْسَل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣٥</span>","End":"٣٥","PageNumber":379,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":329,"MaqraNumber":152,"HizbNumber":38,"HizbDecimal":0.75,"HasSajda":false}]}