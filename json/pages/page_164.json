{"PageNumber":164,"Verses":[{"SurahNumber":7,"SurahIndex":"007","VerseNumber":105,"ShowSurahName":false,"ShowBismillah":false,"Text":"حَقِيقٌ عَلَىٰٓ أَن لَّآ أَقُولَ عَلَى ٱللَّهِ إِلَّا ٱلۡحَقَّۚ قَدۡ جِئۡتُكُم بِبَيِّنَةٖ مِّن رَّبِّكُمۡ فَأَرۡسِلۡ مَعِيَ بَنِيٓ إِسۡرَـٰٓءِيلَ","TajweedText":"حَقِيقٌ عَلَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> أ<tajweed class=idgham_wo_ghunnah>َن ل</tajweed>ّ<tajweed class=madda_obligatory>َآ</tajweed> أَقُولَ عَلَى <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ إِلَّا <tajweed class=ham_wasl>ٱ</tajweed>لْحَقَّ‌ۚ قَ<tajweed class=qalaqah>دْ</tajweed> جِئْتُك<tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِبَيِّنَ<tajweed class=idgham_ghunnah>ةٍ م</tajweed>ّ<tajweed class=idgham_wo_ghunnah>ِن ر</tajweed>َّبِّكُمْ فَأَرْسِلْ مَعِىَ بَن<tajweed class=madda_obligatory>ِىٓ</tajweed> إِسْر<tajweed class=madda_obligatory>َٲ</tajweed>ٓء<tajweed class=madda_permissible>ِي</tajweed>لَ <span class=end>١٠٥</span>","End":"١٠٥","PageNumber":164,"JuzNumber":9,"ManzilNumber":2,"RukuNumber":134,"MaqraNumber":65,"HizbNumber":17,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":7,"SurahIndex":"007","VerseNumber":106,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَ إِن كُنتَ جِئۡتَ بِـَٔايَةٖ فَأۡتِ بِهَآ إِن كُنتَ مِنَ ٱلصَّـٰدِقِينَ","TajweedText":"قَالَ إِ<tajweed class=ikhafa>ن ك</tajweed>ُ<tajweed class=ikhafa>نت</tajweed>َ جِئْتَ بِـَٔـايَ<tajweed class=ikhafa>ةٍ ف</tajweed>َأْتِ بِه<tajweed class=madda_obligatory>َآ</tajweed> إِ<tajweed class=ikhafa>ن ك</tajweed>ُ<tajweed class=ikhafa>نت</tajweed>َ مِنَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>صَّ<tajweed class=madda_normal>ـٰ</tajweed>دِق<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٠٦</span>","End":"١٠٦","PageNumber":164,"JuzNumber":9,"ManzilNumber":2,"RukuNumber":134,"MaqraNumber":65,"HizbNumber":17,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":7,"SurahIndex":"007","VerseNumber":107,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَأَلۡقَىٰ عَصَاهُ فَإِذَا هِيَ ثُعۡبَانٞ مُّبِينٞ","TajweedText":"فَأَلْقَىٰ عَصَاهُ فَإِذَا هِىَ ثُعْبَا<tajweed class=idgham_ghunnah>نٌ م</tajweed>ُّب<tajweed class=madda_permissible>ِي</tajweed>نٌ <span class=end>١٠٧</span>","End":"١٠٧","PageNumber":164,"JuzNumber":9,"ManzilNumber":2,"RukuNumber":134,"MaqraNumber":65,"HizbNumber":17,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":7,"SurahIndex":"007","VerseNumber":108,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَنَزَعَ يَدَهُۥ فَإِذَا هِيَ بَيۡضَآءُ لِلنَّـٰظِرِينَ","TajweedText":"وَنَزَعَ يَدَهُ<tajweed class=madda_normal>ۥ</tajweed> فَإِذَا هِىَ بَيْض<tajweed class=madda_obligatory>َا</tajweed>ٓءُ لِل<tajweed class=ghunnah>نّ</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed>ظِر<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٠٨</span>","End":"١٠٨","PageNumber":164,"JuzNumber":9,"ManzilNumber":2,"RukuNumber":134,"MaqraNumber":65,"HizbNumber":17,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":7,"SurahIndex":"007","VerseNumber":109,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَ ٱلۡمَلَأُ مِن قَوۡمِ فِرۡعَوۡنَ إِنَّ هَٰذَا لَسَٰحِرٌ عَلِيمٞ","TajweedText":"قَالَ <tajweed class=ham_wasl>ٱ</tajweed>لْمَلَأُ مِ<tajweed class=ikhafa>ن ق</tajweed>َوْمِ فِرْعَوْنَ إِ<tajweed class=ghunnah>نّ</tajweed>َ هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا لَسَ<tajweed class=madda_normal>ـٰ</tajweed>حِرٌ عَل<tajweed class=madda_permissible>ِي</tajweed>مٌ <span class=end>١٠٩</span>","End":"١٠٩","PageNumber":164,"JuzNumber":9,"ManzilNumber":2,"RukuNumber":135,"MaqraNumber":65,"HizbNumber":17,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":7,"SurahIndex":"007","VerseNumber":110,"ShowSurahName":false,"ShowBismillah":false,"Text":"يُرِيدُ أَن يُخۡرِجَكُم مِّنۡ أَرۡضِكُمۡۖ فَمَاذَا تَأۡمُرُونَ","TajweedText":"يُرِيدُ أ<tajweed class=idgham_ghunnah>َن ي</tajweed>ُخْرِجَك<tajweed class=idgham_shafawi>ُم م</tajweed>ِّنْ أَرْضِكُمْ‌ۖ فَمَاذَا تَأْمُر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١١٠</span>","End":"١١٠","PageNumber":164,"JuzNumber":9,"ManzilNumber":2,"RukuNumber":135,"MaqraNumber":65,"HizbNumber":17,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":7,"SurahIndex":"007","VerseNumber":111,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالُوٓاْ أَرۡجِهۡ وَأَخَاهُ وَأَرۡسِلۡ فِي ٱلۡمَدَآئِنِ حَٰشِرِينَ","TajweedText":"قَال<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> أَرْجِهْ وَأَخَاهُ وَأَرْسِلْ فِى <tajweed class=ham_wasl>ٱ</tajweed>لْمَد<tajweed class=madda_obligatory>َا</tajweed>ٓئِنِ حَ<tajweed class=madda_normal>ـٰ</tajweed>شِر<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١١١</span>","End":"١١١","PageNumber":164,"JuzNumber":9,"ManzilNumber":2,"RukuNumber":135,"MaqraNumber":65,"HizbNumber":17,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":7,"SurahIndex":"007","VerseNumber":112,"ShowSurahName":false,"ShowBismillah":false,"Text":"يَأۡتُوكَ بِكُلِّ سَٰحِرٍ عَلِيمٖ","TajweedText":"يَأْتُوكَ بِكُلِّ سَ<tajweed class=madda_normal>ـٰ</tajweed>حِرٍ عَل<tajweed class=madda_permissible>ِي</tajweed>مٍ <span class=end>١١٢</span>","End":"١١٢","PageNumber":164,"JuzNumber":9,"ManzilNumber":2,"RukuNumber":135,"MaqraNumber":65,"HizbNumber":17,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":7,"SurahIndex":"007","VerseNumber":113,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَجَآءَ ٱلسَّحَرَةُ فِرۡعَوۡنَ قَالُوٓاْ إِنَّ لَنَا لَأَجۡرًا إِن كُنَّا نَحۡنُ ٱلۡغَٰلِبِينَ","TajweedText":"وَج<tajweed class=madda_obligatory>َا</tajweed>ٓءَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّحَرَةُ فِرْعَوْنَ قَال<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َ لَنَا لَأَ<tajweed class=qalaqah>جْ</tajweed>رًا إِ<tajweed class=ikhafa>ن ك</tajweed>ُ<tajweed class=ghunnah>نّ</tajweed>َا نَحْنُ <tajweed class=ham_wasl>ٱ</tajweed>لْغَ<tajweed class=madda_normal>ـٰ</tajweed>لِب<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١١٣</span>","End":"١١٣","PageNumber":164,"JuzNumber":9,"ManzilNumber":2,"RukuNumber":135,"MaqraNumber":65,"HizbNumber":17,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":7,"SurahIndex":"007","VerseNumber":114,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَ نَعَمۡ وَإِنَّكُمۡ لَمِنَ ٱلۡمُقَرَّبِينَ","TajweedText":"قَالَ نَعَمْ وَإِ<tajweed class=ghunnah>نّ</tajweed>َكُمْ لَمِنَ <tajweed class=ham_wasl>ٱ</tajweed>لْمُقَرَّب<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١١٤</span>","End":"١١٤","PageNumber":164,"JuzNumber":9,"ManzilNumber":2,"RukuNumber":135,"MaqraNumber":65,"HizbNumber":17,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":7,"SurahIndex":"007","VerseNumber":115,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالُواْ يَٰمُوسَىٰٓ إِمَّآ أَن تُلۡقِيَ وَإِمَّآ أَن نَّكُونَ نَحۡنُ ٱلۡمُلۡقِينَ","TajweedText":"قَالُو<tajweed class=slnt>اْ</tajweed> يَ<tajweed class=madda_normal>ـٰ</tajweed>مُوسَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> إِ<tajweed class=ghunnah>مّ</tajweed><tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=ikhafa>ن ت</tajweed>ُلْقِىَ وَإِ<tajweed class=ghunnah>مّ</tajweed><tajweed class=madda_obligatory>َآ</tajweed> أ<tajweed class=idgham_ghunnah>َن ن</tajweed>َّكُونَ نَحْنُ <tajweed class=ham_wasl>ٱ</tajweed>لْمُلْق<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١١٥</span>","End":"١١٥","PageNumber":164,"JuzNumber":9,"ManzilNumber":2,"RukuNumber":135,"MaqraNumber":65,"HizbNumber":17,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":7,"SurahIndex":"007","VerseNumber":116,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَ أَلۡقُواْۖ فَلَمَّآ أَلۡقَوۡاْ سَحَرُوٓاْ أَعۡيُنَ ٱلنَّاسِ وَٱسۡتَرۡهَبُوهُمۡ وَجَآءُو بِسِحۡرٍ عَظِيمٖ","TajweedText":"قَالَ أَلْقُو<tajweed class=slnt>اْ‌ۖ</tajweed> فَلَ<tajweed class=ghunnah>مّ</tajweed><tajweed class=madda_obligatory>َآ</tajweed> أَلْقَوْ<tajweed class=slnt>اْ</tajweed> سَحَر<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> أَعْيُنَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َاسِ وَ<tajweed class=ham_wasl>ٱ</tajweed>سْتَرْهَبُوهُمْ وَج<tajweed class=madda_obligatory>َا</tajweed>ٓءُو بِسِحْرٍ عَظ<tajweed class=madda_permissible>ِي</tajweed>مٍ <span class=end>١١٦</span>","End":"١١٦","PageNumber":164,"JuzNumber":9,"ManzilNumber":2,"RukuNumber":135,"MaqraNumber":65,"HizbNumber":17,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":7,"SurahIndex":"007","VerseNumber":117,"ShowSurahName":false,"ShowBismillah":false,"Text":"۞وَأَوۡحَيۡنَآ إِلَىٰ مُوسَىٰٓ أَنۡ أَلۡقِ عَصَاكَۖ فَإِذَا هِيَ تَلۡقَفُ مَا يَأۡفِكُونَ","TajweedText":"۞ وَأَوْحَيْن<tajweed class=madda_obligatory>َآ</tajweed> إِلَىٰ مُوسَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> أَنْ أَلْقِ عَصَاكَ‌ۖ فَإِذَا هِىَ تَلْقَفُ مَا يَأْفِك<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١١٧</span>","End":"١١٧","PageNumber":164,"JuzNumber":9,"ManzilNumber":2,"RukuNumber":135,"MaqraNumber":66,"HizbNumber":17,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":7,"SurahIndex":"007","VerseNumber":118,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَوَقَعَ ٱلۡحَقُّ وَبَطَلَ مَا كَانُواْ يَعۡمَلُونَ","TajweedText":"فَوَقَعَ <tajweed class=ham_wasl>ٱ</tajweed>لْحَقُّ وَبَطَلَ مَا كَانُو<tajweed class=slnt>اْ</tajweed> يَعْمَل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١١٨</span>","End":"١١٨","PageNumber":164,"JuzNumber":9,"ManzilNumber":2,"RukuNumber":135,"MaqraNumber":66,"HizbNumber":17,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":7,"SurahIndex":"007","VerseNumber":119,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَغُلِبُواْ هُنَالِكَ وَٱنقَلَبُواْ صَٰغِرِينَ","TajweedText":"فَغُلِبُو<tajweed class=slnt>اْ</tajweed> هُنَالِكَ وَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=ikhafa>نق</tajweed>َلَبُو<tajweed class=slnt>اْ</tajweed> صَ<tajweed class=madda_normal>ـٰ</tajweed>غِر<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١١٩</span>","End":"١١٩","PageNumber":164,"JuzNumber":9,"ManzilNumber":2,"RukuNumber":135,"MaqraNumber":66,"HizbNumber":17,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":7,"SurahIndex":"007","VerseNumber":120,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَأُلۡقِيَ ٱلسَّحَرَةُ سَٰجِدِينَ","TajweedText":"وَأُلْقِىَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّحَرَةُ سَ<tajweed class=madda_normal>ـٰ</tajweed>جِد<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٢٠</span>","End":"١٢٠","PageNumber":164,"JuzNumber":9,"ManzilNumber":2,"RukuNumber":135,"MaqraNumber":66,"HizbNumber":17,"HizbDecimal":0.25,"HasSajda":false}]}