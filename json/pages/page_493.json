{"PageNumber":493,"Verses":[{"SurahNumber":43,"SurahIndex":"043","VerseNumber":48,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَا نُرِيهِم مِّنۡ ءَايَةٍ إِلَّا هِيَ أَكۡبَرُ مِنۡ أُخۡتِهَاۖ وَأَخَذۡنَٰهُم بِٱلۡعَذَابِ لَعَلَّهُمۡ يَرۡجِعُونَ","TajweedText":"وَمَا نُرِيه<tajweed class=idgham_shafawi>ِم م</tajweed>ِّنْ ءَايَةٍ إِلَّا هِىَ أَكْبَرُ مِنْ أُخْتِهَا‌ۖ وَأَخَذْنَ<tajweed class=madda_normal>ـٰ</tajweed>ه<tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِ<tajweed class=ham_wasl>ٱ</tajweed>لْعَذَابِ لَعَلَّهُمْ يَرْجِع<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٤٨</span>","End":"٤٨","PageNumber":493,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":428,"MaqraNumber":197,"HizbNumber":50,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":49,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَقَالُواْ يَـٰٓأَيُّهَ ٱلسَّاحِرُ ٱدۡعُ لَنَا رَبَّكَ بِمَا عَهِدَ عِندَكَ إِنَّنَا لَمُهۡتَدُونَ","TajweedText":"وَقَالُو<tajweed class=slnt>اْ</tajweed> يَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>أَيُّهَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّاحِرُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=qalaqah>دْ</tajweed>عُ لَنَا رَبَّكَ بِمَا عَهِدَ عِ<tajweed class=ikhafa>ند</tajweed>َكَ إِ<tajweed class=ghunnah>نّ</tajweed>َنَا لَمُهْتَد<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٤٩</span>","End":"٤٩","PageNumber":493,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":428,"MaqraNumber":197,"HizbNumber":50,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":50,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَلَمَّا كَشَفۡنَا عَنۡهُمُ ٱلۡعَذَابَ إِذَا هُمۡ يَنكُثُونَ","TajweedText":"فَلَ<tajweed class=ghunnah>مّ</tajweed>َا كَشَفْنَا عَنْهُمُ <tajweed class=ham_wasl>ٱ</tajweed>لْعَذَابَ إِذَا هُمْ يَ<tajweed class=ikhafa>نك</tajweed>ُث<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٥٠</span>","End":"٥٠","PageNumber":493,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":428,"MaqraNumber":197,"HizbNumber":50,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":51,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَنَادَىٰ فِرۡعَوۡنُ فِي قَوۡمِهِۦ قَالَ يَٰقَوۡمِ أَلَيۡسَ لِي مُلۡكُ مِصۡرَ وَهَٰذِهِ ٱلۡأَنۡهَٰرُ تَجۡرِي مِن تَحۡتِيٓۚ أَفَلَا تُبۡصِرُونَ","TajweedText":"وَنَادَىٰ فِرْعَوْنُ فِى قَوْمِه<tajweed class=madda_normal>ِۦ</tajweed> قَالَ يَ<tajweed class=madda_normal>ـٰ</tajweed>قَوْمِ أَلَيْسَ لِى مُلْكُ مِصْرَ وَهَ<tajweed class=madda_normal>ـٰ</tajweed>ذِهِ <tajweed class=ham_wasl>ٱ</tajweed>لْأَنْهَ<tajweed class=madda_normal>ـٰ</tajweed>رُ تَ<tajweed class=qalaqah>جْ</tajweed>رِى مِ<tajweed class=ikhafa>ن ت</tajweed>َحْت<tajweed class=madda_obligatory>ِىٓ‌ۖ</tajweed> أَفَلَا تُ<tajweed class=qalaqah>بْ</tajweed>صِر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٥١</span>","End":"٥١","PageNumber":493,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":428,"MaqraNumber":197,"HizbNumber":50,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":52,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَمۡ أَنَا۠ خَيۡرٞ مِّنۡ هَٰذَا ٱلَّذِي هُوَ مَهِينٞ وَلَا يَكَادُ يُبِينُ","TajweedText":"أَمْ أَنَا۟ خَيْ<tajweed class=idgham_ghunnah>رٌ م</tajweed>ِّنْ هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى هُوَ مَهِي<tajweed class=idgham_ghunnah>نٌ و</tajweed>َلَا يَكَادُ يُب<tajweed class=madda_permissible>ِي</tajweed>نُ <span class=end>٥٢</span>","End":"٥٢","PageNumber":493,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":428,"MaqraNumber":197,"HizbNumber":50,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":53,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَلَوۡلَآ أُلۡقِيَ عَلَيۡهِ أَسۡوِرَةٞ مِّن ذَهَبٍ أَوۡ جَآءَ مَعَهُ ٱلۡمَلَـٰٓئِكَةُ مُقۡتَرِنِينَ","TajweedText":"فَلَوْل<tajweed class=madda_obligatory>َآ</tajweed> أُلْقِىَ عَلَيْهِ أَسْوِرَ<tajweed class=idgham_ghunnah>ةٌ م</tajweed>ِّ<tajweed class=ikhafa>ن ذ</tajweed>َهَبٍ أَوْ ج<tajweed class=madda_obligatory>َا</tajweed>ٓءَ مَعَهُ <tajweed class=ham_wasl>ٱ</tajweed>لْمَلَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ئِكَةُ مُ<tajweed class=qalaqah>قْ</tajweed>تَرِن<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٥٣</span>","End":"٥٣","PageNumber":493,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":428,"MaqraNumber":197,"HizbNumber":50,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":54,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَٱسۡتَخَفَّ قَوۡمَهُۥ فَأَطَاعُوهُۚ إِنَّهُمۡ كَانُواْ قَوۡمٗا فَٰسِقِينَ","TajweedText":"فَ<tajweed class=ham_wasl>ٱ</tajweed>سْتَخَفَّ قَوْمَهُ<tajweed class=madda_normal>ۥ</tajweed> فَأَطَاعُوهُ‌ۚ إِ<tajweed class=ghunnah>نّ</tajweed>َهُمْ كَانُو<tajweed class=slnt>اْ</tajweed> قَوْ<tajweed class=ikhafa>مًا ف</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed>سِق<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٥٤</span>","End":"٥٤","PageNumber":493,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":428,"MaqraNumber":197,"HizbNumber":50,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":55,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَلَمَّآ ءَاسَفُونَا ٱنتَقَمۡنَا مِنۡهُمۡ فَأَغۡرَقۡنَٰهُمۡ أَجۡمَعِينَ","TajweedText":"فَلَ<tajweed class=ghunnah>مّ</tajweed><tajweed class=madda_obligatory>َآ</tajweed> ءَاسَفُونَا <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=ikhafa>نت</tajweed>َقَمْنَا مِنْهُمْ فَأَغْرَ<tajweed class=qalaqah>قْ</tajweed>نَ<tajweed class=madda_normal>ـٰ</tajweed>هُمْ أَ<tajweed class=qalaqah>جْ</tajweed>مَع<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٥٥</span>","End":"٥٥","PageNumber":493,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":428,"MaqraNumber":197,"HizbNumber":50,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":56,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَجَعَلۡنَٰهُمۡ سَلَفٗا وَمَثَلٗا لِّلۡأٓخِرِينَ","TajweedText":"فَجَعَلْنَ<tajweed class=madda_normal>ـٰ</tajweed>هُمْ سَلَ<tajweed class=idgham_ghunnah>فًا و</tajweed>َمَثَل<tajweed class=idgham_wo_ghunnah>اً ل</tajweed>ِّلْأَخِر<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٥٦</span>","End":"٥٦","PageNumber":493,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":428,"MaqraNumber":197,"HizbNumber":50,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":57,"ShowSurahName":false,"ShowBismillah":false,"Text":"۞وَلَمَّا ضُرِبَ ٱبۡنُ مَرۡيَمَ مَثَلًا إِذَا قَوۡمُكَ مِنۡهُ يَصِدُّونَ","TajweedText":"۞ وَلَ<tajweed class=ghunnah>مّ</tajweed>َا ضُرِبَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=qalaqah>بْ</tajweed>نُ مَرْيَمَ مَثَلاً إِذَا قَوْمُكَ مِنْهُ يَصِدّ<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٥٧</span>","End":"٥٧","PageNumber":493,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":429,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":58,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَقَالُوٓاْ ءَأَٰلِهَتُنَا خَيۡرٌ أَمۡ هُوَۚ مَا ضَرَبُوهُ لَكَ إِلَّا جَدَلَۢاۚ بَلۡ هُمۡ قَوۡمٌ خَصِمُونَ","TajweedText":"وَقَال<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> ءَأ<tajweed class=madda_normal>َٲ</tajweed>لِهَتُنَا خَيْرٌ أَمْ هُوَ‌ۚ مَا ضَرَبُوهُ لَكَ إِلَّا جَدَل<tajweed class=iqlab>اَۢ‌ۚ ب</tajweed>َلْ هُمْ قَوْمٌ خَصِم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٥٨</span>","End":"٥٨","PageNumber":493,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":429,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":59,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنۡ هُوَ إِلَّا عَبۡدٌ أَنۡعَمۡنَا عَلَيۡهِ وَجَعَلۡنَٰهُ مَثَلٗا لِّبَنِيٓ إِسۡرَـٰٓءِيلَ","TajweedText":"إِنْ هُوَ إِلَّا عَ<tajweed class=qalaqah>بْ</tajweed>دٌ أَنْعَمْنَا عَلَيْهِ وَجَعَلْنَ<tajweed class=madda_normal>ـٰ</tajweed>هُ مَثَل<tajweed class=idgham_wo_ghunnah>اً ل</tajweed>ِّبَن<tajweed class=madda_obligatory>ِىٓ</tajweed> إِسْر<tajweed class=madda_obligatory>َٲ</tajweed>ٓء<tajweed class=madda_permissible>ِي</tajweed>لَ <span class=end>٥٩</span>","End":"٥٩","PageNumber":493,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":429,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":60,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَوۡ نَشَآءُ لَجَعَلۡنَا مِنكُم مَّلَـٰٓئِكَةٗ فِي ٱلۡأَرۡضِ يَخۡلُفُونَ","TajweedText":"وَلَوْ نَش<tajweed class=madda_obligatory>َا</tajweed>ٓءُ لَجَعَلْنَا مِ<tajweed class=ikhafa>نك</tajweed><tajweed class=idgham_shafawi>ُم م</tajweed>َّلَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ئِكَ<tajweed class=ikhafa>ةً ف</tajweed>ِى <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ يَخْلُف<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٠</span>","End":"٦٠","PageNumber":493,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":429,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false}]}