{"PageNumber":383,"Verses":[{"SurahNumber":27,"SurahIndex":"027","VerseNumber":64,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَمَّن يَبۡدَؤُاْ ٱلۡخَلۡقَ ثُمَّ يُعِيدُهُۥ وَمَن يَرۡزُقُكُم مِّنَ ٱلسَّمَآءِ وَٱلۡأَرۡضِۗ أَءِلَٰهٞ مَّعَ ٱللَّهِۚ قُلۡ هَاتُواْ بُرۡهَٰنَكُمۡ إِن كُنتُمۡ صَٰدِقِينَ","TajweedText":"أَ<tajweed class=ghunnah>مّ</tajweed><tajweed class=idgham_ghunnah>َن ي</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>دَؤُ<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed>لْخَلْقَ ثُ<tajweed class=ghunnah>مّ</tajweed>َ يُعِيدُهُ<tajweed class=madda_normal>ۥ</tajweed> وَم<tajweed class=idgham_ghunnah>َن ي</tajweed>َرْزُقُك<tajweed class=idgham_shafawi>ُم م</tajweed>ِّنَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّم<tajweed class=madda_obligatory>َا</tajweed>ٓءِ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ‌ۗ أَءِلَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>هٌ م</tajweed>َّعَ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ‌ۚ قُلْ هَاتُو<tajweed class=slnt>اْ</tajweed> بُرْهَ<tajweed class=madda_normal>ـٰ</tajweed>نَكُمْ إِ<tajweed class=ikhafa>ن ك</tajweed>ُ<tajweed class=ikhafa>نت</tajweed>ُمْ صَ<tajweed class=madda_normal>ـٰ</tajweed>دِق<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٦٤</span>","End":"٦٤","PageNumber":383,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":331,"MaqraNumber":153,"HizbNumber":39,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":65,"ShowSurahName":false,"ShowBismillah":false,"Text":"قُل لَّا يَعۡلَمُ مَن فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ ٱلۡغَيۡبَ إِلَّا ٱللَّهُۚ وَمَا يَشۡعُرُونَ أَيَّانَ يُبۡعَثُونَ","TajweedText":"قُل لَّا يَعْلَمُ مَ<tajweed class=ikhafa>ن ف</tajweed>ِى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّمَ<tajweed class=madda_normal>ـٰ</tajweed>و<tajweed class=madda_normal>َٲ</tajweed>تِ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ <tajweed class=ham_wasl>ٱ</tajweed>لْغَيْبَ إِلَّا <tajweed class=ham_wasl>ٱ</tajweed>للَّهُ‌ۚ وَمَا يَشْعُرُونَ أَيَّانَ يُ<tajweed class=qalaqah>بْ</tajweed>عَث<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٥</span>","End":"٦٥","PageNumber":383,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":331,"MaqraNumber":153,"HizbNumber":39,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":66,"ShowSurahName":false,"ShowBismillah":false,"Text":"بَلِ ٱدَّـٰرَكَ عِلۡمُهُمۡ فِي ٱلۡأٓخِرَةِۚ بَلۡ هُمۡ فِي شَكّٖ مِّنۡهَاۖ بَلۡ هُم مِّنۡهَا عَمُونَ","TajweedText":"بَلِ <tajweed class=ham_wasl>ٱ</tajweed>دّ<tajweed class=madda_normal>َٲ</tajweed>رَكَ عِلْمُهُمْ فِى <tajweed class=ham_wasl>ٱ</tajweed>لْأَخِرَةِ‌ۚ بَلْ هُمْ فِى شَ<tajweed class=idgham_ghunnah>كٍّ م</tajweed>ِّنْهَا‌ۖ بَلْ ه<tajweed class=idgham_shafawi>ُم م</tajweed>ِّنْهَا عَم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٦</span>","End":"٦٦","PageNumber":383,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":331,"MaqraNumber":153,"HizbNumber":39,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":67,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَقَالَ ٱلَّذِينَ كَفَرُوٓاْ أَءِذَا كُنَّا تُرَٰبٗا وَءَابَآؤُنَآ أَئِنَّا لَمُخۡرَجُونَ","TajweedText":"وَقَالَ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ كَفَر<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> أَءِذَا كُ<tajweed class=ghunnah>نّ</tajweed>َا تُر<tajweed class=madda_normal>َٲ</tajweed><tajweed class=idgham_ghunnah>بًا و</tajweed>َءَاب<tajweed class=madda_obligatory>َا</tajweed>ٓؤُن<tajweed class=madda_obligatory>َآ</tajweed> أَئِ<tajweed class=ghunnah>نّ</tajweed>َا لَمُخْرَج<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٧</span>","End":"٦٧","PageNumber":383,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":332,"MaqraNumber":153,"HizbNumber":39,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":68,"ShowSurahName":false,"ShowBismillah":false,"Text":"لَقَدۡ وُعِدۡنَا هَٰذَا نَحۡنُ وَءَابَآؤُنَا مِن قَبۡلُ إِنۡ هَٰذَآ إِلَّآ أَسَٰطِيرُ ٱلۡأَوَّلِينَ","TajweedText":"لَقَ<tajweed class=qalaqah>دْ</tajweed> وُعِ<tajweed class=qalaqah>دْ</tajweed>نَا هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا نَحْنُ وَءَاب<tajweed class=madda_obligatory>َا</tajweed>ٓؤُنَا مِ<tajweed class=ikhafa>ن ق</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>لُ إِنْ هَ<tajweed class=madda_normal>ـٰ</tajweed>ذ<tajweed class=madda_obligatory>َآ</tajweed> إِلّ<tajweed class=madda_obligatory>َآ</tajweed> أَسَ<tajweed class=madda_normal>ـٰ</tajweed>طِيرُ <tajweed class=ham_wasl>ٱ</tajweed>لْأَوَّل<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٦٨</span>","End":"٦٨","PageNumber":383,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":332,"MaqraNumber":153,"HizbNumber":39,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":69,"ShowSurahName":false,"ShowBismillah":false,"Text":"قُلۡ سِيرُواْ فِي ٱلۡأَرۡضِ فَٱنظُرُواْ كَيۡفَ كَانَ عَٰقِبَةُ ٱلۡمُجۡرِمِينَ","TajweedText":"قُلْ سِيرُو<tajweed class=slnt>اْ</tajweed> فِى <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ فَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=ikhafa>نظ</tajweed>ُرُو<tajweed class=slnt>اْ</tajweed> كَيْفَ كَانَ عَ<tajweed class=madda_normal>ـٰ</tajweed>قِبَةُ <tajweed class=ham_wasl>ٱ</tajweed>لْمُ<tajweed class=qalaqah>جْ</tajweed>رِم<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٦٩</span>","End":"٦٩","PageNumber":383,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":332,"MaqraNumber":153,"HizbNumber":39,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":70,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَا تَحۡزَنۡ عَلَيۡهِمۡ وَلَا تَكُن فِي ضَيۡقٖ مِّمَّا يَمۡكُرُونَ","TajweedText":"وَلَا تَحْزَنْ عَلَيْهِمْ وَلَا تَكُ<tajweed class=ikhafa>ن ف</tajweed>ِى ضَيْ<tajweed class=idgham_ghunnah>قٍ م</tajweed>ِّ<tajweed class=ghunnah>مّ</tajweed>َا يَمْكُر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٧٠</span>","End":"٧٠","PageNumber":383,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":332,"MaqraNumber":153,"HizbNumber":39,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":71,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَيَقُولُونَ مَتَىٰ هَٰذَا ٱلۡوَعۡدُ إِن كُنتُمۡ صَٰدِقِينَ","TajweedText":"وَيَقُولُونَ مَتَىٰ هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا <tajweed class=ham_wasl>ٱ</tajweed>لْوَعْدُ إِ<tajweed class=ikhafa>ن ك</tajweed>ُ<tajweed class=ikhafa>نت</tajweed>ُمْ صَ<tajweed class=madda_normal>ـٰ</tajweed>دِق<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٧١</span>","End":"٧١","PageNumber":383,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":332,"MaqraNumber":153,"HizbNumber":39,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":72,"ShowSurahName":false,"ShowBismillah":false,"Text":"قُلۡ عَسَىٰٓ أَن يَكُونَ رَدِفَ لَكُم بَعۡضُ ٱلَّذِي تَسۡتَعۡجِلُونَ","TajweedText":"قُلْ عَسَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> أ<tajweed class=idgham_ghunnah>َن ي</tajweed>َكُونَ رَدِفَ لَك<tajweed class=ikhafa_shafawi>ُم ب</tajweed>َعْضُ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى تَسْتَعْجِل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٧٢</span>","End":"٧٢","PageNumber":383,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":332,"MaqraNumber":153,"HizbNumber":39,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":73,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِنَّ رَبَّكَ لَذُو فَضۡلٍ عَلَى ٱلنَّاسِ وَلَٰكِنَّ أَكۡثَرَهُمۡ لَا يَشۡكُرُونَ","TajweedText":"وَإِ<tajweed class=ghunnah>نّ</tajweed>َ رَبَّكَ لَذُو فَضْلٍ عَلَى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َاسِ وَلَ<tajweed class=madda_normal>ـٰ</tajweed>كِ<tajweed class=ghunnah>نّ</tajweed>َ أَكْثَرَهُمْ لَا يَشْكُ