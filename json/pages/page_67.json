{"PageNumber":67,"Verses":[{"SurahNumber":3,"SurahIndex":"003","VerseNumber":133,"ShowSurahName":false,"ShowBismillah":false,"Text":"۞وَسَارِعُوٓاْ إِلَىٰ مَغۡفِرَةٖ مِّن رَّبِّكُمۡ وَجَنَّةٍ عَرۡضُهَا ٱلسَّمَٰوَٰتُ وَٱلۡأَرۡضُ أُعِدَّتۡ لِلۡمُتَّقِينَ","TajweedText":"۞ وَسَارِع<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> إِلَىٰ مَغْفِرَ<tajweed class=idgham_ghunnah>ةٍ م</tajweed>ّ<tajweed class=idgham_wo_ghunnah>ِن ر</tajweed>َّبِّكُمْ وَجَ<tajweed class=ghunnah>نّ</tajweed>َةٍ عَرْضُهَا <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّمَ<tajweed class=madda_normal>ـٰ</tajweed>و<tajweed class=madda_normal>َٲ</tajweed>تُ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضُ أُعِدَّتْ لِلْمُتَّق<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٣٣</span>","End":"١٣٣","PageNumber":67,"JuzNumber":4,"ManzilNumber":1,"RukuNumber":55,"MaqraNumber":27,"HizbNumber":7,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":3,"SurahIndex":"003","VerseNumber":134,"ShowSurahName":false,"ShowBismillah":false,"Text":"ٱلَّذِينَ يُنفِقُونَ فِي ٱلسَّرَّآءِ وَٱلضَّرَّآءِ وَٱلۡكَٰظِمِينَ ٱلۡغَيۡظَ وَٱلۡعَافِينَ عَنِ ٱلنَّاسِۗ وَٱللَّهُ يُحِبُّ ٱلۡمُحۡسِنِينَ","TajweedText":"ٱلَّذِينَ يُ<tajweed class=ikhafa>نف</tajweed>ِقُونَ فِى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّرّ<tajweed class=madda_obligatory>َا</tajweed>ٓءِ وَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>ضَّرّ<tajweed class=madda_obligatory>َا</tajweed>ٓءِ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْكَ<tajweed class=madda_normal>ـٰ</tajweed>ظِمِينَ <tajweed class=ham_wasl>ٱ</tajweed>لْغَيْظَ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْعَافِينَ عَنِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َاسِ‌ۗ وَ<tajweed class=ham_wasl>ٱ</tajweed>للَّهُ يُحِبُّ <tajweed class=ham_wasl>ٱ</tajweed>لْمُحْسِن<tajweed class=madda_permissible>ِي</tajwee