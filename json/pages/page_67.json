 class=idgham_ghunnah>دًى و</tajweed>َمَوْعِظَ<tajweed class=idgham_wo_ghunnah>ةٌ ل</tajweed>ِّلْمُتَّق<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٣٨</span>","End":"١٣٨","PageNumber":67,"JuzNumber":4,"ManzilNumber":1,"RukuNumber":55,"MaqraNumber":27,"HizbNumber":7,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":3,"SurahIndex":"003","VerseNumber":139,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَا تَهِنُواْ وَلَا تَحۡزَنُواْ وَأَنتُمُ ٱلۡأَعۡلَوۡنَ إِن كُنتُم مُّؤۡمِنِينَ","TajweedText":"وَلَا تَهِنُو<tajweed class=slnt>اْ</tajweed> وَلَا تَحْزَنُو<tajweed class=slnt>اْ</tajweed> وَأَ<tajweed class=ikhafa>نت</tajweed>ُمُ <tajweed class=ham_wasl>ٱ</tajweed>لْأَعْلَوْنَ إِ<tajweed class=ikhafa>ن ك</tajweed>ُ<tajweed class=ikhafa>نت</tajweed><tajweed class=idgham_shafawi>ُم م</tajweed>ُّؤْمِن<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٣٩</span>","End":"١٣٩","PageNumber":67,"JuzNumber":4,"ManzilNumber":1,"RukuNumber":55,"MaqraNumber":27,"HizbNumber":7,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":3,"SurahIndex":"003","VerseNumber":140,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِن يَمۡسَسۡكُمۡ قَرۡحٞ فَقَدۡ مَسَّ ٱلۡقَوۡمَ قَرۡحٞ مِّثۡلُهُۥۚ وَتِلۡكَ ٱلۡأَيَّامُ نُدَاوِلُهَا بَيۡنَ ٱلنَّاسِ وَلِيَعۡلَمَ ٱللَّهُ ٱلَّذِينَ ءَامَنُواْ وَيَتَّخِذَ مِنكُمۡ شُهَدَآءَۗ وَٱللَّهُ لَا يُحِبُّ ٱلظَّـٰلِمِينَ","TajweedText":"إ<tajweed class=idgham_ghunnah>ِن ي</tajweed>َمْسَسْكُمْ قَرْ<tajweed class=ikhafa>حٌ ف</tajweed>َقَ<tajweed class=qalaqah>دْ</tajweed> مَسَّ <tajweed class=ham_wasl>ٱ</tajweed>لْقَوْمَ قَرْ<tajweed class=idgham_ghunnah>حٌ م</tajweed>ِّثْلُهُ<tajweed class=madda_normal>ۥ</tajweed>‌ۚ وَتِلْكَ <tajweed class=ham_wasl>ٱ</tajweed>لْأَيَّامُ نُدَاوِلُهَا بَيْنَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َاسِ وَلِيَعْلَمَ <tajweed class=ham_wasl>ٱ</tajweed>للَّهُ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ ءَامَنُو<tajweed class=slnt>اْ</tajweed> وَيَتَّخِذَ مِ<tajweed class=ikhafa>نك</tajweed>ُمْ شُهَد<tajweed class=madda_obligatory>َا</tajweed>ٓءَ‌ۗ وَ<tajweed class=ham_wasl>ٱ</tajweed>للَّهُ لَا يُحِبُّ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>ظَّ<tajweed class=madda_normal>ـٰ</tajweed>لِم<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٤٠</span>","End":"١٤٠","PageNumber":67,"JuzNumber":4,"ManzilNumber":1,"RukuNumber":55,"MaqraNumber":27,"HizbNumber":7,"HizbDecimal":0.5,"HasSajda":false}]}