{"PageNumber":473,"Verses":[{"SurahNumber":40,"SurahIndex":"040","VerseNumber":50,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالُوٓاْ أَوَلَمۡ تَكُ تَأۡتِيكُمۡ رُسُلُكُم بِٱلۡبَيِّنَٰتِۖ قَالُواْ بَلَىٰۚ قَالُواْ فَٱدۡعُواْۗ وَمَا دُعَـٰٓؤُاْ ٱلۡكَٰفِرِينَ إِلَّا فِي ضَلَٰلٍ","TajweedText":"قَال<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> أَوَلَمْ تَكُ تَأْتِيكُمْ رُسُلُك<tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِ<tajweed class=ham_wasl>ٱ</tajweed>لْبَيِّنَ<tajweed class=madda_normal>ـٰ</tajweed>تِۖ قَالُو<tajweed class=slnt>اْ</tajweed> بَلَىٰۚ قَالُو<tajweed class=slnt>اْ</tajweed> فَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=qalaqah>دْ</tajweed>عُو<tajweed class=slnt>اْۗ</tajweed> وَمَا دُعَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ؤُ<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed>لْكَ<tajweed class=madda_normal>ـٰ</tajweed>فِرِينَ إِلَّا فِى ضَلَ<tajweed class=madda_permissible>ـٰ</tajweed>لٍ <span class=end>٥٠</span>","End":"٥٠","PageNumber":473,"JuzNumber":24,"ManzilNumber":6,"RukuNumber":408,"MaqraNumber":189,"HizbNumber":48,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":40,"SurahIndex":"040","VerseNumber":51,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّا لَنَنصُرُ رُسُلَنَا وَٱلَّذِينَ ءَامَنُواْ فِي ٱلۡحَيَوٰةِ ٱلدُّنۡيَا وَيَوۡمَ يَقُومُ ٱلۡأَشۡهَٰدُ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َا لَنَ<tajweed class=ikhafa>نص</tajweed>ُرُ رُسُلَنَا وَ<tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ ءَامَنُو<tajweed class=slnt>اْ</tajweed> فِى <tajweed class=ham_wasl>ٱ</tajweed>لْحَيَ<tajweed class=slnt>و</tajweed><tajweed class=madda_normal>ٲ</tajweed>ةِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>دُّنْيَا وَيَوْمَ يَقُومُ <tajweed class=ham_wasl>ٱ</tajweed>لْأَشْهَ<tajweed class=madda_permissible>ـٰ</tajweed><tajweed class=qalaqah>د</tajweed>ُ <span class=end>٥١</span>","End":"٥١","PageNumber":473,"JuzNumber":24,"ManzilNumber":6,"RukuNumber":409,"MaqraNumber":189,"HizbNumber":48,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":40,"SurahIndex":"040","VerseNumber":52,"ShowSurahName":false,"ShowBismillah":false,"Text":"يَوۡمَ لَا يَنفَعُ ٱلظَّـٰلِمِينَ مَعۡذِرَتُهُمۡۖ وَلَهُمُ ٱللَّعۡنَةُ وَلَهُمۡ سُوٓءُ ٱلدَّارِ","TajweedText":"يَوْمَ لَا يَ<tajweed class=ikhafa>نف</tajweed>َعُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>ظَّ<tajweed class=madda_normal>ـٰ</tajweed>لِمِينَ مَعْذِرَتُهُمْۖ وَلَهُمُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>لَّعْنَةُ وَلَهُمْ س<tajweed class=madda_obligatory>ُو</tajweed>ٓءُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>دّ<tajweed class=madda_permissible>َا</tajweed>رِ <span class=end>٥٢</span>","End":"٥٢","PageNumber":473,"JuzNumber":24,"ManzilNumber":6,"RukuNumber":409,"MaqraNumber":189,"HizbNumber":48,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":40,"SurahIndex":"040","VerseNumber":53,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَقَدۡ ءَاتَيۡنَا مُوسَى ٱلۡهُدَىٰ وَأَوۡرَثۡنَا بَنِيٓ إِسۡرَـٰٓءِيلَ ٱلۡكِتَٰبَ","TajweedText":"وَلَقَ<tajweed class=qalaqah>دْ</tajweed> ءَاتَيْنَا مُوسَى <tajweed class=ham_wasl>ٱ</tajweed>لْهُدَىٰ وَأَوْرَثْنَا بَن<tajweed class=madda_obligatory>ِىٓ</tajweed> إِسْر<tajweed class=madda_obligatory>َٲ</tajweed>ٓءِيلَ <tajweed class=ham_wasl>ٱ</tajweed>لْكِتَ<tajweed class=madda_permissible>ـٰ</tajweed><tajweed class=qalaqah>ب</tajweed>َ <span class=end>٥٣</span>","End":"٥٣","PageNumber":473,"JuzNumber":24,"ManzilNumber":6,"RukuNumber":409,"MaqraNumber":189,"HizbNumber":48,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":40,"SurahIndex":"040","VerseNumber":54,"ShowSurahName":false,"ShowBismillah":false,"Text":"هُدٗى وَذِكۡرَىٰ لِأُوْلِي ٱلۡأَلۡبَٰبِ","TajweedText":"هُ<tajweed class=idgham_ghunnah>دًى و</tajweed>َذِكْرَىٰ لِأُ<tajweed class=slnt>وْ</tajweed>لِى <tajweed class=ham_wasl>ٱ</tajweed>لْأَلْبَ<tajweed class=madda_permissible>ـٰ</tajweed><tajweed class=qalaqah>ب</tajweed>ِ <span class=end>٥٤</span>","End":"٥٤","PageNumber":473,"JuzNumber":24,"ManzilNumber":6,"RukuNumber":409,"MaqraNumber":189,"HizbNumber":48,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":40,"SurahIndex":"040","VerseNumber":55,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَٱصۡبِرۡ إِنَّ وَعۡدَ ٱللَّهِ حَقّٞ وَٱسۡتَغۡفِرۡ لِذَنۢبِكَ وَسَبِّحۡ بِحَمۡدِ رَبِّكَ بِٱلۡعَشِيِّ وَٱلۡإِبۡكَٰرِ","TajweedText":"فَ<tajweed class=ham_wasl>ٱ</tajweed>صْبِرْ إِ<tajweed class=ghunnah>نّ</tajweed>َ وَعْدَ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ حَ<tajweed class=idgham_ghunnah>قٌّ و</tajweed>َ<tajweed class=ham_wasl>ٱ</tajweed>سْتَغْفِرْ لِذَ<tajweed class=iqlab>نۢب</tajweed>ِكَ وَسَبِّحْ بِحَمْدِ رَبِّكَ بِ<tajweed class=ham_wasl>ٱ</tajweed>لْعَشِىِّ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْإِ<tajweed class=qalaqah>بْ</tajweed>كَ<tajweed class=madda_permissible>ـٰ</tajweed>رِ <span class=end>٥٥</span>","End":"٥٥","PageNumber":473,"JuzNumber":24,"ManzilNumber":6,"RukuNumber":409,"MaqraNumber":189,"HizbNumber":48,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":40,"SurahIndex":"040","VerseNumber":56,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّ ٱلَّذِينَ يُجَٰدِلُونَ فِيٓ ءَايَٰتِ ٱللَّهِ بِغَيۡرِ سُلۡطَٰنٍ أَتَىٰهُمۡ إِن فِي صُدُورِهِمۡ إِلَّا كِبۡرٞ مَّا هُم بِبَٰلِغِيهِۚ فَٱسۡتَعِذۡ بِٱللَّهِۖ إِنَّهُۥ هُوَ ٱلسَّمِيعُ ٱلۡبَصِيرُ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ يُجَ<tajweed class=madda_normal>ـٰ</tajweed>دِلُونَ ف<tajweed class=madda_obligatory>ِىٓ</tajweed> ءَايَ<tajweed class=madda_normal>ـٰ</tajweed>تِ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ بِغَيْرِ سُلْطَ<tajweed class=madda_normal>ـٰ</tajweed>نٍ أَتَ<tajweed class=madda_normal>ـٰ</tajweed>هُمْۙ إِ<tajweed class=ikhafa>ن ف</tajweed>ِى صُدُورِهِمْ إِلَّا كِ<tajweed class=qalaqah>بْ</tajweed><tajweed class=idgham_ghunnah>رٌ م</tajweed>َّا ه<tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِبَ<tajweed class=madda_normal>ـٰ</tajweed>لِغِيهِۚ فَ<tajweed class=ham_wasl>ٱ</tajweed>سْتَعِذْ بِ<tajweed class=ham_wasl>ٱ</tajweed>للَّهِۖ إِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> هُوَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّمِيعُ <tajweed class=ham_wasl>ٱ</tajweed>لْبَص<tajweed class=madda_permissible>ِي</tajweed>رُ <span class=end>٥٦</span>","End":"٥٦","PageNumber":473,"JuzNumber":24,"ManzilNumber":6,"RukuNumber":409,"MaqraNumber":189,"HizbNumber":48,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":40,"SurahIndex":"040","VerseNumber":57,"ShowSurahName":false,"ShowBismillah":false,"Text":"لَخَلۡقُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ أَكۡبَرُ مِنۡ خَلۡقِ ٱلنَّاسِ وَلَٰكِنَّ أَكۡثَرَ ٱلنَّاسِ لَا يَعۡلَمُونَ","TajweedText":"لَخَلْقُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّمَ<tajweed class=madda_normal>ـٰ</tajweed>و<tajweed class=madda_normal>َٲ</tajweed>تِ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ أَكْبَرُ مِنْ خَلْقِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َاسِ وَلَ<tajweed class=madda_normal>ـٰ</tajweed>كِ<tajweed class=ghunnah>نّ</tajweed>َ أَكْثَرَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َاسِ لَا يَعْلَم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٥٧</span>","End":"٥٧","PageNumber":473,"JuzNumber":24,"ManzilNumber":6,"RukuNumber":409,"MaqraNumber":189,"HizbNumber":48,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":40,"SurahIndex":"040","VerseNumber":58,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَا يَسۡتَوِي ٱلۡأَعۡمَىٰ وَٱلۡبَصِيرُ وَٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّـٰلِحَٰتِ وَلَا ٱلۡمُسِيٓءُۚ قَلِيلٗا مَّا تَتَذَكَّرُونَ","TajweedText":"وَمَا يَسْتَوِى <tajweed class=ham_wasl>ٱ</tajweed>لْأَعْمَىٰ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْبَصِيرُ وَ<tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ ءَامَنُو<tajweed class=slnt>اْ</tajweed> وَعَمِلُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>صَّ<tajweed class=madda_normal>ـٰ</tajweed>لِحَ<tajweed class=madda_normal>ـٰ</tajweed>تِ وَلَا <tajweed class=ham_wasl>ٱ</tajweed>لْمُس<tajweed class=madda_obligatory>ِى</tajweed>ٓءُۚ قَلِيل<tajweed class=idgham_ghunnah>اً م</tajweed>َّا تَتَذَكَّر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٥٨</span>","End":"٥٨","PageNumber":473,"JuzNumber":24,"ManzilNumber":6,"RukuNumber":409,"MaqraNumber":189,"HizbNumber":48,"HizbDecimal":0.0,"HasSajda":false}]}