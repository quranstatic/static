{"PageNumber":272,"Verses":[{"SurahNumber":16,"SurahIndex":"016","VerseNumber":43,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَآ أَرۡسَلۡنَا مِن قَبۡلِكَ إِلَّا رِجَالٗا نُّوحِيٓ إِلَيۡهِمۡۖ فَسۡـَٔلُوٓاْ أَهۡلَ ٱلذِّكۡرِ إِن كُنتُمۡ لَا تَعۡلَمُونَ","TajweedText":"وَم<tajweed class=madda_obligatory>َآ</tajweed> أَرْسَلْنَا مِ<tajweed class=ikhafa>ن ق</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>لِكَ إِلَّا رِجَال<tajweed class=idgham_ghunnah>اً ن</tajweed>ُّوح<tajweed class=madda_obligatory>ِىٓ</tajweed> إِلَيْهِمْ‌ۚ فَسْــَٔل<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> أَهْلَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>ذِّكْرِ إِ<tajweed class=ikhafa>ن ك</tajweed>ُ<tajweed class=ikhafa>نت</tajweed>ُمْ لَا تَعْلَم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٤٣</span>","End":"٤٣","PageNumber":272,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":229,"MaqraNumber":108,"HizbNumber":27,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":16,"SurahIndex":"016","VerseNumber":44,"ShowSurahName":false,"ShowBismillah":false,"Text":"بِٱلۡبَيِّنَٰتِ وَٱلزُّبُرِۗ وَأَنزَلۡنَآ إِلَيۡكَ ٱلذِّكۡرَ لِتُبَيِّنَ لِلنَّاسِ مَا نُزِّلَ إِلَيۡهِمۡ وَلَعَلَّهُمۡ يَتَفَكَّرُونَ","TajweedText":"بِ<tajweed class=ham_wasl>ٱ</tajweed>لْبَيِّنَ<tajweed class=madda_normal>ـٰ</tajweed>تِ وَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>زُّبُرِ‌ۗ وَأَ<tajweed class=ikhafa>نز</tajweed>َلْن<tajweed class=madda_obligatory>َآ</tajweed> إِلَيْكَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>ذِّكْرَ لِتُبَيِّنَ لِل<tajweed class=ghunnah>نّ</tajweed>َاسِ مَا نُزِّلَ إِلَيْهِمْ وَلَعَلَّهُمْ يَتَفَكَّر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٤٤</span>","End":"٤٤","PageNumber":272,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":229,"MaqraNumber":108,"HizbNumber":27,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":16,"SurahIndex":"01