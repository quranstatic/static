eed class=qalaqah>طْ</tajweed>فَ<tajweed class=ikhafa>ةٍ ف</tajweed>َإِذَا هُوَ خَصِي<tajweed class=idgham_ghunnah>مٌ م</tajweed>ُّب<tajweed class=madda_permissible>ِي</tajweed>نٌ <span class=end>٤</span>","End":"٤","PageNumber":267,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":224,"MaqraNumber":107,"HizbNumber":27,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":16,"SurahIndex":"016","VerseNumber":5,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَٱلۡأَنۡعَٰمَ خَلَقَهَاۖ لَكُمۡ فِيهَا دِفۡءٞ وَمَنَٰفِعُ وَمِنۡهَا تَأۡكُلُونَ","TajweedText":"وَ<tajweed class=ham_wasl>ٱ</tajweed>لْأَنْعَ<tajweed class=madda_normal>ـٰ</tajweed>مَ خَلَقَهَا‌ۗ لَكُمْ فِيهَا دِفْ<tajweed class=idgham_ghunnah>ءٌ و</tajweed>َمَنَ<tajweed class=madda_normal>ـٰ</tajweed>فِعُ وَمِنْهَا تَأْكُل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٥</span>","End":"٥","PageNumber":267,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":224,"MaqraNumber":107,"HizbNumber":27,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":16,"SurahIndex":"016","VerseNumber":6,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَكُمۡ فِيهَا جَمَالٌ حِينَ تُرِيحُونَ وَحِينَ تَسۡرَحُونَ","TajweedText":"وَلَكُمْ فِيهَا جَمَالٌ حِينَ تُرِيحُونَ وَحِينَ تَسْرَح<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦</span>","End":"٦","PageNumber":267,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":224,"MaqraNumber":107,"HizbNumber":27,"HizbDecimal":0.5,"HasSajda":false}]}