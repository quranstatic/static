{"PageNumber":475,"Verses":[{"SurahNumber":40,"SurahIndex":"040","VerseNumber":67,"ShowSurahName":false,"ShowBismillah":false,"Text":"هُوَ ٱلَّذِي خَلَقَكُم مِّن تُرَابٖ ثُمَّ مِن نُّطۡفَةٖ ثُمَّ مِنۡ عَلَقَةٖ ثُمَّ يُخۡرِجُكُمۡ طِفۡلٗا ثُمَّ لِتَبۡلُغُوٓاْ أَشُدَّكُمۡ ثُمَّ لِتَكُونُواْ شُيُوخٗاۚ وَمِنكُم مَّن يُتَوَفَّىٰ مِن قَبۡلُۖ وَلِتَبۡلُغُوٓاْ أَجَلٗا مُّسَمّٗى وَلَعَلَّكُمۡ تَعۡقِلُونَ","TajweedText":"هُوَ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى خَلَقَك<tajweed class=idgham_shafawi>ُم م</tajweed>ِّ<tajweed class=ikhafa>ن ت</tajweed>ُرَا<tajweed class=ikhafa>بٍ ث</tajweed>ُ<tajweed class=ghunnah>مّ</tajweed>َ م<tajweed class=idgham_ghunnah>ِن ن</tajweed>ُّ<tajweed class=qalaqah>طْ</tajweed>فَ<tajweed class=ikhafa>ةٍ ث</tajweed>ُ<tajweed class=ghunnah>مّ</tajweed>َ مِنْ عَلَقَ<tajweed class=ikhafa>ةٍ ث</tajweed>ُ<tajweed class=ghunnah>مّ</tajweed>َ يُخْرِجُكُمْ طِفْل<tajweed class=ikhafa>اً ث</tajweed>ُ<tajweed class=ghunnah>مّ</tajweed>َ لِتَ<tajweed class=qalaqah>بْ</tajweed>لُغ<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> أَشُدَّكُمْ ثُ<tajweed class=ghunnah>مّ</tajweed>َ لِتَكُونُو<tajweed class=slnt>اْ</tajweed> شُيُو<tajweed class=idgham_ghunnah>خًاۚ و</tajweed>َمِ<tajweed class=ikhafa>نك</tajweed><tajweed class=idgham_shafawi>ُم م</tajweed>ّ<tajweed class=idgham_ghunnah>َن ي</tajweed>ُتَوَفَّىٰ مِ<tajweed class=ikhafa>ن ق</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>لُۖ وَلِتَ<tajweed class=qalaqah>بْ</tajweed>لُغ<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> أَجَل<tajweed class=idgham_ghunnah>اً م</tajweed>ُّسَم<tajweed class=idgham_ghunnah>ًّى و</tajweed>َلَعَلَّكُمْ تَعْقِل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٧</span>","End":"٦٧","PageNumber":475,"JuzNumber":24,"ManzilNumber":6,"RukuNumber":410,"MaqraNumber":190,"HizbNumber":48,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":40,"SurahIndex":"040","VerseNumber":68,"ShowSurahName":false,"ShowBismillah":false,"Text":"هُوَ ٱلَّذِي يُحۡيِۦ وَيُمِيتُۖ فَإِذَا قَضَىٰٓ أَمۡرٗا فَإِنَّمَا يَقُولُ لَهُۥ كُن فَيَكُونُ","TajweedText":"هُوَ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى يُحْى<tajweed class=madda_normal>ِۦ</tajweed> وَيُمِيتُۖ فَإِذَا قَضَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> أَمْ<tajweed class=ikhafa>رًا ف</tajweed>َإِ<tajweed class=ghunnah>نّ</tajweed>َمَا يَقُولُ لَهُ<tajweed class=madda_normal>ۥ</tajweed> كُ<tajweed class=ikhafa>ن ف</tajweed>َيَك<tajweed class=madda_permissible>ُو</tajweed>نُ <span class=end>٦٨</span>","End":"٦٨","PageNumber":475,"JuzNumber":24,"ManzilNumber":6,"RukuNumber":410,"MaqraNumber":190,"HizbNumber":48,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":40,"SurahIndex":"040","VerseNumber":69,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَلَمۡ تَرَ إِلَى ٱلَّذِينَ يُجَٰدِلُونَ فِيٓ ءَايَٰتِ ٱللَّهِ أَنَّىٰ يُصۡرَفُونَ","TajweedText":"أَلَمْ تَرَ إِلَى <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ يُجَ<tajweed class=madda_normal>ـٰ</tajweed>دِلُونَ ف<tajweed class=madda_obligatory>ِىٓ</tajweed> ءَايَ<tajweed class=madda_normal>ـٰ</tajweed>تِ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ أَ<tajweed class=ghunnah>نّ</tajweed>َىٰ يُصْرَف<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٩</span>","End":"٦٩","PageNumber":475,"JuzNumber":24,"ManzilNumber":6,"RukuNumber":411,"MaqraNumber":190,"HizbNumber":48,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":40,"SurahIndex":"040","VerseNumber":70,"ShowSurahName":false,"ShowBismillah":false,"Text":"ٱلَّذِينَ كَذَّبُواْ بِٱلۡكِتَٰبِ وَبِمَآ أَرۡسَلۡنَا بِهِۦ رُسُلَنَاۖ فَسَوۡفَ يَعۡلَمُونَ","TajweedText":"ٱلَّذِينَ كَذَّبُو<tajweed class=slnt>اْ</tajweed> بِ<tajweed class=ham_wasl>ٱ</tajweed>لْكِتَ<tajweed class=madda_normal>ـٰ</tajweed>بِ وَبِم<tajweed class=madda_obligatory>َآ</tajweed> أَرْسَلْنَا بِه<tajweed class=madda_normal>ِۦ</tajweed> رُسُلَنَاۖ فَسَوْفَ يَعْلَم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٧٠</span>","End":"٧٠","PageNumber":475,"JuzNumber":24,"ManzilNumber":6,"RukuNumber":411,"MaqraNumber":190,"HizbNumber":48,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":40,"SurahIndex":"040","VerseNumber":71,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِذِ ٱلۡأَغۡلَٰلُ فِيٓ أَعۡنَٰقِهِمۡ وَٱلسَّلَٰسِلُ يُسۡحَبُونَ","TajweedText":"إِذِ <tajweed class=ham_wasl>ٱ</tajweed>لْأَغْلَ<tajweed class=madda_normal>ـٰ</tajweed>لُ ف<tajweed class=madda_obligatory>ِىٓ</tajweed> أَعْنَ<tajweed class=madda_normal>ـٰ</tajweed>قِهِمْ وَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّلَ<tajweed class=madda_normal>ـٰ</tajweed>سِلُ يُسْحَب<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٧١</span>","End":"٧١","PageNumber":475,"JuzNumber":24,"ManzilNumber":6,"RukuNumber":411,"MaqraNumber":190,"HizbNumber":48,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":40,"SurahIndex":"040","VerseNumber":72,"ShowSurahName":false,"ShowBismillah":false,"Text":"فِي ٱلۡحَمِيمِ ثُمَّ فِي ٱلنَّارِ يُسۡجَرُونَ","TajweedText":"فِى <tajweed class=ham_wasl>ٱ</tajweed>لْحَمِيمِ ثُ<tajweed class=ghunnah>مّ</tajweed>َ فِى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َارِ يُسْجَر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٧٢</span>","End":"٧٢","PageNumber":475,"JuzNumber":24,"ManzilNumber":6,"RukuNumber":411,"MaqraNumber":190,"HizbNumber":48,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":40,"SurahIndex":"040","VerseNumber":73,"ShowSurahName":false,"ShowBismillah":false,"Text":"ثُمَّ قِيلَ لَهُمۡ أَيۡنَ مَا كُنتُمۡ تُشۡرِكُونَ","TajweedText":"ثُ<tajweed class=ghunnah>مّ</tajweed>َ قِيلَ لَهُمْ أَيْنَ مَا كُ<tajweed class=ikhafa>نت</tajweed>ُمْ تُشْرِك<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٧٣</span>","End":"٧٣","PageNumber":475,"JuzNumber":24,"ManzilNumber":6,"RukuNumber":411,"MaqraNumber":190,"HizbNumber":48,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":40,"SurahIndex":"040","VerseNumber":74,"ShowSurahName":false,"ShowBismillah":false,"Text":"مِن دُونِ ٱللَّهِۖ قَالُواْ ضَلُّواْ عَنَّا بَل لَّمۡ نَكُن نَّدۡعُواْ مِن قَبۡلُ شَيۡـٔٗاۚ كَذَٰلِكَ يُضِلُّ ٱللَّهُ ٱلۡكَٰفِرِينَ","TajweedText":"مِ<tajweed class=ikhafa>ن د</tajweed>ُونِ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِۖ قَالُو<tajweed class=slnt>اْ</tajweed> ضَلُّو<tajweed class=slnt>اْ</tajweed> عَ<tajweed class=ghunnah>نّ</tajweed>َا بَل لَّمْ نَك<tajweed class=idgham_ghunnah>ُن ن</tajweed>َّ<tajweed class=qalaqah>دْ</tajweed>عُو<tajweed class=slnt>اْ</tajweed> مِ<tajweed class=ikhafa>ن ق</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>لُ شَيْـ<tajweed class=ikhafa>ـًٔاۚ ك</tajweed>َذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ يُضِلُّ <tajweed class=ham_wasl>ٱ</tajweed>للَّهُ <tajweed class=ham_wasl>ٱ</tajweed>لْكَ<tajweed class=madda_normal>ـٰ</tajweed>فِر<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٧٤</span>","End":"٧٤","PageNumber":475,"JuzNumber":24,"ManzilNumber":6,"RukuNumber":411,"MaqraNumber":190,"HizbNumber":48,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":40,"SurahIndex":"040","VerseNumber":75,"ShowSurahName":false,"ShowBismillah":false,"Text":"ذَٰلِكُم بِمَا كُنتُمۡ تَفۡرَحُونَ فِي ٱلۡأَرۡضِ بِغَيۡرِ ٱلۡحَقِّ وَبِمَا كُنتُمۡ تَمۡرَحُونَ","TajweedText":"ذ<tajweed class=madda_normal>َٲ</tajweed>لِك<tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِمَا كُ<tajweed class=ikhafa>نت</tajweed>ُمْ تَفْرَحُونَ فِى <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ بِغَيْرِ <tajweed class=ham_wasl>ٱ</tajweed>لْحَقِّ وَبِمَا كُ<tajweed class=ikhafa>نت</tajweed>ُمْ تَمْرَح<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٧٥</span>","End":"٧٥","PageNumber":475,"JuzNumber":24,"ManzilNumber":6,"RukuNumber":411,"MaqraNumber":190,"HizbNumber":48,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":40,"SurahIndex":"040","VerseNumber":76,"ShowSurahName":false,"ShowBismillah":false,"Text":"ٱدۡخُلُوٓاْ أَبۡوَٰبَ جَهَنَّمَ خَٰلِدِينَ فِيهَاۖ فَبِئۡسَ مَثۡوَى ٱلۡمُتَكَبِّرِينَ","TajweedText":"ٱ<tajweed class=qalaqah>دْ</tajweed>خُل<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> أَ<tajweed class=qalaqah>بْ</tajweed>و<tajweed class=madda_normal>َٲ</tajweed>بَ جَهَ<tajweed class=ghunnah>نّ</tajweed>َمَ خَ<tajweed class=madda_normal>ـٰ</tajweed>لِدِينَ فِيهَاۖ فَبِئْسَ مَثْوَى <tajweed class=ham_wasl>ٱ</tajweed>لْمُتَكَبِّر<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٧٦</span>","End":"٧٦","PageNumber":475,"JuzNumber":24,"ManzilNumber":6,"RukuNumber":411,"MaqraNumber":190,"HizbNumber":48,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":40,"SurahIndex":"040","VerseNumber":77,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَٱصۡبِرۡ إِنَّ وَعۡدَ ٱللَّهِ حَقّٞۚ فَإِمَّا نُرِيَنَّكَ بَعۡضَ ٱلَّذِي نَعِدُهُمۡ أَوۡ نَتَوَفَّيَنَّكَ فَإِلَيۡنَا يُرۡجَعُونَ","TajweedText":"فَ<tajweed class=ham_wasl>ٱ</tajweed>صْبِرْ إِ<tajweed class=ghunnah>نّ</tajweed>َ وَعْدَ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ حَۚ<tajweed class=ikhafa>قٌّ ف</tajweed>َإِ<tajweed class=ghunnah>مّ</tajweed>َا نُرِيَ<tajweed class=ghunnah>نّ</tajweed>َكَ بَعْضَ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى نَعِدُهُمْ أَوْ نَتَوَفَّيَ<tajweed class=ghunnah>نّ</tajweed>َكَ فَإِلَيْنَا يُرْجَع<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٧٧</span>","End":"٧٧","PageNumber":475,"JuzNumber":24,"ManzilNumber":6,"RukuNumber":411,"MaqraNumber":190,"HizbNumber":48,"HizbDecimal":0.25,"HasSajda":false}]}