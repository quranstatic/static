{"PageNumber":563,"Verses":[{"SurahNumber":67,"SurahIndex":"067","VerseNumber":13,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَأَسِرُّواْ قَوۡلَكُمۡ أَوِ ٱجۡهَرُواْ بِهِۦٓۖ إِنَّهُۥ عَلِيمُۢ بِذَاتِ ٱلصُّدُورِ","TajweedText":"وَأَسِرُّو<tajweed class=slnt>اْ</tajweed> قَوْلَكُمْ أَوِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=qalaqah>جْ</tajweed>هَرُو<tajweed class=slnt>اْ</tajweed> بِه<tajweed class=madda_obligatory>ِۦٓ‌ۖ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> عَلِي<tajweed class=iqlab>مُۢ ب</tajweed>ِذَاتِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>صُّد<tajweed class=madda_permissible>ُو</tajweed>رِ <span class=end>١٣</span>","End":"١٣","PageNumber":563,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":496,"MaqraNumber":225,"HizbNumber":57,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":67,"SurahIndex":"067","VerseNumber":14,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَلَا يَعۡلَمُ مَنۡ خَلَقَ وَهُوَ ٱللَّطِيفُ ٱلۡخَبِيرُ","TajweedText":"أَلَا يَعْلَمُ مَنْ خَلَقَ وَهُوَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>لَّطِيفُ <tajweed class=ham_wasl>ٱ</tajweed>لْخَب<tajweed class=madda_permissible>ِي</tajweed>رُ <span class=end>١٤</span>","End":"١٤","PageNumber":563,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":496,"MaqraNumber":225,"HizbNumber":57,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":67,"SurahIndex":"067","VerseNumber":15,"ShowSurahName":false,"ShowBismillah":false,"Text":"هُوَ ٱلَّذِي جَعَلَ لَكُمُ ٱلۡأَرۡضَ ذَلُولٗا فَٱمۡشُواْ فِي مَنَاكِبِهَا وَكُلُواْ مِن رِّزۡقِهِۦۖ وَإِلَيۡهِ ٱلنُّشُورُ","TajweedText":"هُوَ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى جَعَلَ لَكُمُ <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضَ ذَلُول<tajweed class=ikhafa>اً ف</tajweed>َ<tajweed class=ham_wasl>ٱ</tajweed>مْشُو<tajweed class=slnt>اْ</tajweed> فِى مَنَاكِبِهَا وَكُلُو<tajweed class=slnt>اْ</tajweed> م<tajweed class=idgham_wo_ghunnah>ِن ر</tajweed>ِّزْقِه<tajweed class=madda_normal>ِۦ</tajweed>‌ۖ وَإِلَيْهِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>ُش<tajweed class=madda_permissible>ُو</tajweed>رُ <span class=end>١٥</span>","End":"١٥","PageNumber":563,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":497,"MaqraNumber":225,"HizbNumber":57,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":67,"SurahIndex":"067","VerseNumber":16,"ShowSurahName":false,"ShowBismillah":false,"Text":"ءَأَمِنتُم مَّن فِي ٱلسَّمَآءِ أَن يَخۡسِفَ بِكُمُ ٱلۡأَرۡضَ فَإِذَا هِيَ تَمُورُ","TajweedText":"ءَأَمِ<tajweed class=ikhafa>نت</tajweed><tajweed class=idgham_shafawi>ُم م</tajweed>َّ<tajweed class=ikhafa>ن ف</tajweed>ِى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّم<tajweed class=madda_obligatory>َا</tajweed>ٓءِ أ<tajweed class=idgham_ghunnah>َن ي</tajweed>َخْسِفَ بِكُمُ <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضَ فَإِذَا هِىَ تَم<tajweed class=madda_permissible>ُو</tajweed>رُ <span class=end>١٦</span>","End":"١٦","PageNumber":563,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":497,"MaqraNumber":225,"HizbNumber":57,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":67,"SurahIndex":"067","VerseNumber":17,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَمۡ أَمِنتُم مَّن فِي ٱلسَّمَآءِ أَن يُرۡسِلَ عَلَيۡكُمۡ حَاصِبٗاۖ فَسَتَعۡلَمُونَ كَيۡفَ نَذِيرِ","TajweedText":"أَمْ أَمِ<tajweed class=ikhafa>نت</tajweed><tajweed class=idgham_shafawi>ُم م</tajweed>َّ<tajweed class=ikhafa>ن ف</tajweed>ِى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّم<tajweed class=madda_obligatory>َا</tajweed>ٓءِ أ<tajweed class=idgham_ghunnah>َن ي</tajweed>ُرْسِلَ عَلَيْكُمْ حَاصِ<tajweed class=ikhafa>بًا‌ۖ ف</tajweed>َسَتَعْلَمُونَ كَيْفَ نَذ<tajweed class=madda_permissible>ِي</tajweed>رِ <span class=end>١٧</span>","End":"١٧","PageNumber":563,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":497,"MaqraNumber":225,"HizbNumber":57,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":67,"SurahIndex":"067","VerseNumber":18,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَقَدۡ كَذَّبَ ٱلَّذِينَ مِن قَبۡلِهِمۡ فَكَيۡفَ كَانَ نَكِيرِ","TajweedText":"وَلَقَ<tajweed class=qalaqah>دْ</tajweed> كَذَّبَ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ مِ<tajweed class=ikhafa>ن ق</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>لِهِمْ فَكَيْفَ كَانَ نَك<tajweed class=madda_permissible>ِي</tajweed>رِ <span class=end>١٨</span>","End":"١٨","PageNumber":563,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":497,"MaqraNumber":225,"HizbNumber":57,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":67,"SurahIndex":"067","VerseNumber":19,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَوَلَمۡ يَرَوۡاْ إِلَى ٱلطَّيۡرِ فَوۡقَهُمۡ صَـٰٓفَّـٰتٖ وَيَقۡبِضۡنَۚ مَا يُمۡسِكُهُنَّ إِلَّا ٱلرَّحۡمَٰنُۚ إِنَّهُۥ بِكُلِّ شَيۡءِۭ بَصِيرٌ","TajweedText":"أَوَلَمْ يَرَوْ<tajweed class=slnt>اْ</tajweed> إِلَى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>طَّيْرِ فَوْقَهُمْ صَ<tajweed class=madda_necessary>ـٰٓ</tajweed>فَّ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>تٍ و</tajweed>َيَ<tajweed class=qalaqah>قْ</tajweed>بِضْنَ‌ۚ مَا يُمْسِكُهُ<tajweed class=ghunnah>نّ</tajweed>َ إِلَّا <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رَّحْمَ<tajweed class=madda_normal>ـٰ</tajweed>نُ‌ۚ إِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> بِكُلِّ شَىْ<tajweed class=iqlab>ءِۭ ب</tajweed>َص<tajweed class=madda_permissible>ِي</tajweed>رٌ <span class=end>١٩</span>","End":"١٩","PageNumber":563,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":497,"MaqraNumber":225,"HizbNumber":57,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":67,"SurahIndex":"067","VerseNumber":20,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَمَّنۡ هَٰذَا ٱلَّذِي هُوَ جُندٞ لَّكُمۡ يَنصُرُكُم مِّن دُونِ ٱلرَّحۡمَٰنِۚ إِنِ ٱلۡكَٰفِرُونَ إِلَّا فِي غُرُورٍ","TajweedText":"أَ<tajweed class=ghunnah>مّ</tajweed>َنْ هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى هُوَ جُن<tajweed class=idgham_wo_ghunnah>دٌ ل</tajweed>َّكُمْ يَ<tajweed class=ikhafa>نص</tajweed>ُرُك<tajweed class=idgham_shafawi>ُم م</tajweed>ِّ<tajweed class=ikhafa>ن د</tajweed>ُونِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رَّحْمَ<tajweed class=madda_normal>ـٰ</tajweed>نِ‌ۚ إِنِ <tajweed class=ham_wasl>ٱ</tajweed>لْكَ<tajweed class=madda_normal>ـٰ</tajweed>فِرُونَ إِلَّا فِى غُر<tajweed class=madda_permissible>ُو</tajweed>رٍ <span class=end>٢٠</span>","End":"٢٠","PageNumber":563,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":497,"MaqraNumber":225,"HizbNumber":57,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":67,"SurahIndex":"067","VerseNumber":21,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَمَّنۡ هَٰذَا ٱلَّذِي يَرۡزُقُكُمۡ إِنۡ أَمۡسَكَ رِزۡقَهُۥۚ بَل لَّجُّواْ فِي عُتُوّٖ وَنُفُورٍ","TajweedText":"أَ<tajweed class=ghunnah>مّ</tajweed>َنْ هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى يَرْزُقُكُمْ إِنْ أَمْسَكَ رِزْقَهُ<tajweed class=madda_normal>ۥ</tajweed>‌ۚ بَل لَّجُّو<tajweed class=slnt>اْ</tajweed> فِى عُتُ<tajweed class=idgham_ghunnah>وٍّ و</tajweed>َنُف<tajweed class=madda_permissible>ُو</tajweed>رٍ <span class=end>٢١</span>","End":"٢١","PageNumber":563,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":497,"MaqraNumber":225,"HizbNumber":57,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":67,"SurahIndex":"067","VerseNumber":22,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَفَمَن يَمۡشِي مُكِبًّا عَلَىٰ وَجۡهِهِۦٓ أَهۡدَىٰٓ أَمَّن يَمۡشِي سَوِيًّا عَلَىٰ صِرَٰطٖ مُّسۡتَقِيمٖ","TajweedText":"أَفَم<tajweed class=idgham_ghunnah>َن ي</tajweed>َمْشِى مُكِبًّا عَلَىٰ وَ<tajweed class=qalaqah>جْ</tajweed>هِه<tajweed class=madda_obligatory>ِۦٓ</tajweed> أَهْدَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> أَ<tajweed class=ghunnah>مّ</tajweed><tajweed class=idgham_ghunnah>َن ي</tajweed>َمْشِى سَوِيًّا عَلَىٰ صِر<tajweed class=madda_normal>َٲ</tajweed><tajweed class=idgham_ghunnah>طٍ م</tajweed>ُّسْتَق<tajweed class=madda_permissible>ِي</tajweed>مٍ <span class=end>٢٢</span>","End":"٢٢","PageNumber":563,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":497,"MaqraNumber":225,"HizbNumber":57,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":67,"SurahIndex":"067","VerseNumber":23,"ShowSurahName":false,"ShowBismillah":false,"Text":"قُلۡ هُوَ ٱلَّذِيٓ أَنشَأَكُمۡ وَجَعَلَ لَكُمُ ٱلسَّمۡعَ وَٱلۡأَبۡصَٰرَ وَٱلۡأَفۡـِٔدَةَۚ قَلِيلٗا مَّا تَشۡكُرُونَ","TajweedText":"قُلْ هُوَ <tajweed class=ham_wasl>ٱ</tajweed>لَّذ<tajweed class=madda_obligatory>ِىٓ</tajweed> أَ<tajweed class=ikhafa>نش</tajweed>َأَكُمْ وَجَعَلَ لَكُمُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّمْعَ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْأَ<tajweed class=qalaqah>بْ</tajweed>صَ<tajweed class=madda_normal>ـٰ</tajweed>رَ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْأَفْــِٔدَةَ‌ۖ قَلِيل<tajweed class=idgham_ghunnah>اً م</tajweed>َّا تَشْكُر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٣</span>","End":"٢٣","PageNumber":563,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":497,"MaqraNumber":225,"HizbNumber":57,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":67,"SurahIndex":"067","VerseNumber":24,"ShowSurahName":false,"ShowBismillah":false,"Text":"قُلۡ هُوَ ٱلَّذِي ذَرَأَكُمۡ فِي ٱلۡأَرۡضِ وَإِلَيۡهِ تُحۡشَرُونَ","TajweedText":"قُلْ هُوَ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى ذَرَأَكُمْ فِى <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ وَإِلَيْهِ تُحْشَر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٤</span>","End":"٢٤","PageNumber":563,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":497,"MaqraNumber":225,"HizbNumber":57,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":67,"SurahIndex":"067","VerseNumber":25,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَيَقُولُونَ مَتَىٰ هَٰذَا ٱلۡو