{"PageNumber":444,"Verses":[{"SurahNumber":36,"SurahIndex":"036","VerseNumber":55,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّ أَصۡحَٰبَ ٱلۡجَنَّةِ ٱلۡيَوۡمَ فِي شُغُلٖ فَٰكِهُونَ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َ أَصْحَ<tajweed class=madda_normal>ـٰ</tajweed>بَ <tajweed class=ham_wasl>ٱ</tajweed>لْجَ<tajweed class=ghunnah>نّ</tajweed>َةِ <tajweed class=ham_wasl>ٱ</tajweed>لْيَوْمَ فِى شُغُ<tajweed class=ikhafa>لٍ ف</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed>كِه<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٥٥</span>","End":"٥٥","PageNumber":444,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":384,"MaqraNumber":177,"HizbNumber":45,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":56,"ShowSurahName":false,"ShowBismillah":false,"Text":"هُمۡ وَأَزۡوَٰجُهُمۡ فِي ظِلَٰلٍ عَلَى ٱلۡأَرَآئِكِ مُتَّكِـُٔونَ","TajweedText":"هُمْ وَأَزْو<tajweed class=madda_normal>َٲ</tajweed>جُهُمْ فِى ظِلَ<tajweed class=madda_normal>ـٰ</tajweed>لٍ عَلَى <tajweed class=ham_wasl>ٱ</tajweed>لْأَر<tajweed class=madda_obligatory>َا</tajweed>ٓئِكِ مُتَّكِــٔ<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٥٦</span>","End":"٥٦","PageNumber":444,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":384,"MaqraNumber":177,"HizbNumber":45,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":57,"ShowSurahName":false,"ShowBismillah":false,"Text":"لَهُمۡ فِيهَا فَٰكِهَةٞ وَلَهُم مَّا يَدَّعُونَ","TajweedText":"لَهُمْ فِيهَا فَ<tajweed class=madda_normal>ـٰ</tajweed>كِهَ<tajweed class=idgham_ghunnah>ةٌ و</tajweed>َلَه<tajweed class=idgham_shafawi>ُم م</tajweed>َّا يَدَّع<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٥٧</span>","End":"٥٧","PageNumber":444,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":384,"MaqraNumber":177,"HizbNumber":45,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":58,"ShowSurahName":false,"ShowBismillah":false,"Text":"سَلَٰمٞ قَوۡلٗا مِّن رَّبّٖ رَّحِيمٖ","TajweedText":"سَلَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=ikhafa>مٌ ق</tajweed>َوْل<tajweed class=idgham_ghunnah>اً م</tajweed>ّ<tajweed class=idgham_wo_ghunnah>ِن ر</tajweed>َّ<tajweed class=idgham_wo_ghunnah>بٍّ ر</tajweed>َّح<tajweed class=madda_permissible>ِي</tajweed>مٍ <span class=end>٥٨</span>","End":"٥٨","PageNumber":444,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":384,"MaqraNumber":177,"HizbNumber":45,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":59,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَٱمۡتَٰزُواْ ٱلۡيَوۡمَ أَيُّهَا ٱلۡمُجۡرِمُونَ","TajweedText":"وَ<tajweed class=ham_wasl>ٱ</tajweed>مْتَ<tajweed class=madda_normal>ـٰ</tajweed>زُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed>لْيَوْمَ أَيُّهَا <tajweed class=ham_wasl>ٱ</tajweed>لْمُ<tajweed class=qalaqah>جْ</tajweed>رِم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٥٩</span>","End":"٥٩","PageNumber":444,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":384,"MaqraNumber":177,"HizbNumber":45,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":60,"ShowSurahName":false,"ShowBismillah":false,"Text":"۞أَلَمۡ أَعۡهَدۡ إِلَيۡكُمۡ يَٰبَنِيٓ ءَادَمَ أَن لَّا تَعۡبُدُواْ ٱلشَّيۡطَٰنَۖ إِنَّهُۥ لَكُمۡ عَدُوّٞ مُّبِينٞ","TajweedText":"۞ أَلَمْ أَعْهَ<tajweed class=qalaqah>دْ</tajweed> إِلَيْكُمْ يَ<tajweed class=madda_normal>ـٰ</tajweed>بَن<tajweed class=madda_obligatory>ِىٓ</tajweed> ءَادَمَ أ<tajweed class=idgham_wo_ghunnah>َن ل</tajweed>َّا تَعْبُدُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>شَّيْطَ<tajweed class=madda_normal>ـٰ</tajweed>نَ‌ۖ إِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> لَكُمْ عَدُ<tajweed class=idgham_ghunnah>وٌّ م</tajweed>ُّب<tajweed class=madda_permissible>ِي</tajweed>نٌ <span class=end>٦٠</span>","End":"٦٠","PageNumber":444,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":384,"MaqraNumber":178,"HizbNumber":45,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":61,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَأَنِ ٱعۡبُدُونِيۚ هَٰذَا صِرَٰطٞ مُّسۡتَقِيمٞ","TajweedText":"وَأَنِ <tajweed class=ham_wasl>ٱ</tajweed>عْبُدُونِى‌ۚ هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا صِر<tajweed class=madda_normal>َٲ</tajweed><tajweed class=idgham_ghunnah>طٌ م</tajweed>ُّسْتَق<tajweed class=madda_permissible>ِي</tajweed>مٌ <span class=end>٦١</span>","End":"٦١","PageNumber":444,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":384,"MaqraNumber":178,"HizbNumber":45,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":62,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَقَدۡ أَضَلَّ مِنكُمۡ جِبِلّٗا كَثِيرًاۖ أَفَلَمۡ تَكُونُواْ تَعۡقِلُونَ","TajweedText":"وَلَقَ<tajweed class=qalaqah>دْ</tajweed> أَضَلَّ مِ<tajweed class=ikhafa>نك</tajweed>ُمْ جِبِل<tajweed class=ikhafa>اًّ ك</tajweed>َثِيرًا‌ۖ أَفَلَمْ تَكُونُو<tajweed class=slnt>اْ</tajweed> تَعْقِل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٢</span>","End":"٦٢","PageNumber":444,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":384,"MaqraNumber":178,"HizbNumber":45,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":63,"ShowSurahName":false,"ShowBismillah":false,"Text":"هَٰذِهِۦ جَهَنَّمُ ٱلَّتِي كُنتُمۡ تُوعَدُونَ","TajweedText":"هَ<tajweed class=madda_normal>ـٰ</tajweed>ذِه<tajweed class=madda_normal>ِۦ</tajweed> جَهَ<tajweed class=ghunnah>نّ</tajweed>َمُ <tajweed class=ham_wasl>ٱ</tajweed>لَّتِى كُ<tajweed class=ikhafa>نت</tajweed>ُمْ تُوعَد<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٣</span>","End":"٦٣","PageNumber":444,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":384,"MaqraNumber":178,"HizbNumber":45,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":64,"ShowSurahName":false,"ShowBismillah":false,"Text":"ٱصۡلَوۡهَا ٱلۡيَوۡمَ بِمَا كُنتُمۡ تَكۡفُرُونَ","TajweedText":"ٱصْلَوْهَا <tajweed class=ham_wasl>ٱ</tajweed>لْيَوْمَ بِمَا كُ<tajweed class=ikhafa>نت</tajweed>ُمْ تَكْفُر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٤</span>","End":"٦٤","PageNumber":444,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":384,"MaqraNumber":178,"HizbNumber":45,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":65,"ShowSurahName":false,"ShowBismillah":false,"Text":"ٱلۡيَوۡمَ نَخۡتِمُ عَلَىٰٓ أَفۡوَٰهِهِمۡ وَتُكَلِّمُنَآ أَيۡدِيهِمۡ وَتَشۡهَدُ أَرۡجُلُهُم بِمَا كَانُواْ يَكۡسِبُونَ","TajweedText":"ٱلْيَوْمَ نَخْتِمُ عَلَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> أَفْو<tajweed class=madda_normal>َٲ</tajweed>هِهِمْ وَتُكَلِّمُن<tajweed class=madda_obligatory>َآ</tajweed> أَيْدِيهِمْ وَتَشْهَدُ أَرْجُلُه<tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِمَا كَانُو<tajweed class=slnt>اْ</tajweed> يَكْسِب<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٥</span>","End":"٦٥","PageNumber":444,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":384,"MaqraNumber":178,"HizbNumber":45,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":66,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَوۡ نَشَآءُ لَطَمَسۡنَا عَلَىٰٓ أَعۡيُنِهِمۡ فَٱسۡتَبَقُواْ ٱلصِّرَٰطَ فَأَنَّىٰ يُبۡصِرُونَ","TajweedText":"وَلَوْ نَش<tajweed class=madda_obligatory>َا</tajweed>ٓءُ لَطَمَسْنَا عَلَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> أَعْيُنِهِمْ فَ<tajweed class=ham_wasl>ٱ</tajweed>سْتَبَقُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>صِّر<tajweed class=madda_normal>َٲ</tajweed>طَ فَأَ<tajweed class=ghunnah>نّ</tajweed>َىٰ يُ<tajweed class=qalaqah>بْ</tajweed>صِر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٦</span>","End":"٦٦","PageNumber":444,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":384,"MaqraNumber":178,"HizbNumber":45,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":67,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَوۡ نَشَآءُ لَمَسَخۡنَٰهُمۡ عَلَىٰ مَكَانَتِهِمۡ فَمَا ٱسۡتَطَٰعُواْ مُضِيّٗا وَلَا يَرۡجِعُونَ","TajweedText":"وَلَوْ نَش<tajweed class=madda_obligatory>َا</tajweed>ٓءُ لَمَسَخْنَ<tajweed class=madda_normal>ـٰ</tajweed>هُمْ عَلَىٰ مَكَانَتِهِمْ فَمَا <tajweed class=ham_wasl>ٱ</tajweed>سْتَطَ<tajweed class=madda_normal>ـٰ</tajweed>عُو<tajweed class=slnt>اْ</tajweed> مُضِي<tajweed class=idgham_ghunnah>ًّا و</tajweed>َلَا يَرْجِع<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٧</span>","End":"٦٧","PageNumber":444,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":384,"MaqraNumber":178,"HizbNumber":45,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":68,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَن نُّعَمِّرۡهُ نُنَكِّسۡهُ فِي ٱلۡخَلۡقِۚ أَفَلَا يَعۡقِلُونَ","TajweedText":"وَم<tajweed class=idgham_ghunnah>َن ن</tajweed>ُّعَ<tajweed class=ghunnah>مّ</tajweed>ِرْهُ نُنَكِّسْهُ فِى <tajweed class=ham_wasl>ٱ</tajweed>لْخَلْقِ‌ۖ أَفَلَا يَعْقِل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٨</span>","End":"٦٨","PageNumber":444,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":385,"MaqraNumber":178,"HizbNumber":45,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":69,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَا عَلَّمۡنَٰهُ ٱلشِّعۡرَ وَمَا يَنۢبَغِي لَهُۥٓۚ إِنۡ هُوَ إِلَّا ذِكۡرٞ وَقُرۡءَانٞ مُّبِينٞ","TajweedText":"وَمَا عَلَّمْنَ<tajweed class=madda_normal>ـٰ</tajweed>هُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>شِّعْرَ وَمَا يَ<tajweed class=iqlab>نۢب</tajweed>َغِى لَهُ<tajweed class=madda_obligatory>ۥٓ‌ۚ</tajweed> إِنْ هُوَ إِلَّا ذِكْ<tajweed class=idgham_ghunnah>رٌ و</tajweed>َقُرْءَا<tajweed class=idgham_ghunnah>نٌ م</tajweed>ُّب<tajweed class=madda_permissible>ِي</tajweed>نٌ <span class=end>٦٩</span>","End":"٦٩","PageNumber":444,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":385,"MaqraNumber":178,"HizbNumber":45,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":70,"ShowSurahName":false,"ShowBismillah":false,"Text":"لِّيُنذِرَ مَن كَانَ حَيّٗا وَيَحِقَّ ٱلۡقَوۡلُ عَلَى ٱلۡكَٰفِرِينَ","TajweedText":"لِّيُ<tajweed class=ikhafa>نذ</tajweed>ِرَ مَ<tajweed class=ikhafa>ن ك</tajweed>َانَ حَي<tajweed class=idgham_ghunnah>ًّا و</tajweed>َيَحِقَّ <tajweed class=ham_wasl>ٱ</tajweed>لْقَوْلُ عَلَى <tajweed class=ham_wasl>ٱ</tajweed>لْكَ<tajweed class=madda_normal>ـٰ</tajweed>فِر<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٧٠</span>","End":"٧٠","PageNumber":444,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":385,"MaqraNumber":178,"HizbNumber":45,"HizbDecimal":0.25,"HasSajda":false}]}