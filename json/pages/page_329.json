{"PageNumber":329,"Verses":[{"SurahNumber":21,"SurahIndex":"021","VerseNumber":82,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمِنَ ٱلشَّيَٰطِينِ مَن يَغُوصُونَ لَهُۥ وَيَعۡمَلُونَ عَمَلٗا دُونَ ذَٰلِكَۖ وَكُنَّا لَهُمۡ حَٰفِظِينَ","TajweedText":"وَمِنَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>شَّيَ<tajweed class=madda_normal>ـٰ</tajweed>طِينِ م<tajweed class=idgham_ghunnah>َن ي</tajweed>َغُوصُونَ لَهُ<tajweed class=madda_normal>ۥ</tajweed> وَيَعْمَلُونَ عَمَل<tajweed class=ikhafa>اً د</tajweed>ُونَ ذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ‌ۖ وَكُ<tajweed class=ghunnah>نّ</tajweed>َا لَهُمْ حَ<tajweed class=madda_normal>ـٰ</tajweed>فِظ<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٨٢</span>","End":"٨٢","PageNumber":329,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":283,"MaqraNumber":131,"HizbNumber":33,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":83,"ShowSurahName":false,"ShowBismillah":false,"Text":"۞وَأَيُّوبَ إِذۡ نَادَىٰ رَبَّهُۥٓ أَنِّي مَسَّنِيَ ٱلضُّرُّ وَأَنتَ أَرۡحَمُ ٱلرَّـٰحِمِينَ","TajweedText":"۞ وَأَيُّوبَ إِذْ نَادَىٰ رَبَّهُ<tajweed class=madda_obligatory>ۥٓ</tajweed> أَ<tajweed class=ghunnah>نّ</tajweed>ِى مَسَّنِىَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>ضُّرُّ وَأَ<tajweed class=ikhafa>نت</tajweed>َ أَرْحَمُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رّ<tajweed class=madda_normal>َٲ</tajweed>حِم<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٨٣</span>","End":"٨٣","PageNumber":329,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":283,"MaqraNumber":132,"HizbNumber":33,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":84,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَٱسۡتَجَبۡنَا لَهُۥ فَكَشَفۡنَا مَا بِهِۦ مِن ضُرّٖۖ وَءَاتَيۡنَٰهُ أَهۡلَهُۥ وَمِثۡلَهُم مَّعَهُمۡ رَحۡمَةٗ مِّنۡ عِندِنَا وَذِكۡرَىٰ لِلۡعَٰبِدِينَ","TajweedText":"فَ<tajweed class=ham_wasl>ٱ</tajweed>سْتَجَ<tajweed class=qalaqah>بْ</tajweed>نَا لَهُ<tajweed class=madda_normal>ۥ</tajweed> فَكَشَفْنَا مَا بِه<tajweed class=madda_normal>ِۦ</tajweed> مِ<tajweed class=ikhafa>ن ض</tajweed>ُ<tajweed class=idgham_ghunnah>رٍّ‌ۖ و</tajweed>َءَاتَيْنَ<tajweed class=madda_normal>ـٰ</tajweed>هُ أَهْلَهُ<tajweed class=madda_normal>ۥ</tajweed> وَمِثْلَه<tajweed class=idgham_shafawi>ُم م</tajweed>َّعَهُمْ رَحْمَ<tajweed class=idgham_ghunnah>ةً م</tajweed>ِّنْ عِ<tajweed class=ikhafa>ند</tajweed>ِنَا وَذِكْرَىٰ لِلْعَ<tajweed class=madda_normal>ـٰ</tajweed>بِد<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٨٤</span>","End":"٨٤","PageNumber":329,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":283,"MaqraNumber":132,"HizbNumber":33,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":85,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِسۡمَٰعِيلَ وَإِدۡرِيسَ وَذَا ٱلۡكِفۡلِۖ كُلّٞ مِّنَ ٱلصَّـٰبِرِينَ","TajweedText":"وَإِسْمَ<tajweed class=madda_normal>ـٰ</tajweed>عِيلَ وَإِ<tajweed class=qalaqah>دْ</tajweed>رِيسَ وَذَا <tajweed class=ham_wasl>ٱ</tajweed>لْكِفْلِ‌ۖ كُ<tajweed class=idgham_ghunnah>لٌّ م</tajweed>ِّنَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>صَّ<tajweed class=madda_normal>ـٰ</tajweed>بِر<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٨٥</span>","End":"٨٥","PageNumber":329,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":283,"MaqraNumber":132,"HizbNumber":33,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":86,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَأَدۡخَلۡنَٰهُمۡ فِي رَحۡمَتِنَآۖ إِنَّهُم مِّنَ ٱلصَّـٰلِحِينَ","TajweedText":"وَأَ<tajweed class=qalaqah>دْ</tajweed>خَلْنَ<tajweed class=madda_normal>ـٰ</tajweed>هُمْ فِى رَحْمَتِن<tajweed class=madda_obligatory>َآ‌ۖ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َه<tajweed class=idgham_shafawi>ُم م</tajweed>ِّنَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>صَّ<tajweed class=madda_normal>ـٰ</tajweed>لِح<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٨٦</span>","End":"٨٦","PageNumber":329,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":283,"MaqraNumber":132,"HizbNumber":33,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":87,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَذَا ٱلنُّونِ إِذ ذَّهَبَ مُغَٰضِبٗا فَظَنَّ أَن لَّن نَّقۡدِرَ عَلَيۡهِ فَنَادَىٰ فِي ٱلظُّلُمَٰتِ أَن لَّآ إِلَٰهَ إِلَّآ أَنتَ سُبۡحَٰنَكَ إِنِّي كُنتُ مِنَ ٱلظَّـٰلِمِينَ","TajweedText":"وَذَا <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>ُونِ إِذ ذَّهَبَ مُغَ<tajweed class=madda_normal>ـٰ</tajweed>ضِ<tajweed class=ikhafa>بًا ف</tajweed>َظَ<tajweed class=ghunnah>نّ</tajweed>َ أ<tajweed class=idgham_wo_ghunnah>َن ل</tajweed>ّ<tajweed class=idgham_ghunnah>َن ن</tajweed>َّ<tajweed class=qalaqah>قْ</tajweed>دِرَ عَلَيْهِ فَنَادَىٰ فِى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>ظُّلُمَ<tajweed class=madda_normal>ـٰ</tajweed>تِ أ<tajweed class=idgham_wo_ghunnah>َن ل</tajweed>ّ<tajweed class=madda_obligatory>َآ</tajweed> إِلَ<tajweed class=madda_normal>ـٰ</tajweed>هَ إِلّ<tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=ikhafa>نت</tajweed>َ سُ<tajweed class=qalaqah>بْ</tajweed>حَ<tajweed class=madda_normal>ـٰ</tajweed>نَكَ إِ<tajweed class=ghunnah>نّ</tajweed>ِى كُ<tajweed class=ikhafa>نت</tajweed>ُ مِنَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>ظَّ<tajweed class=madda_normal>ـٰ</tajweed>لِم<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٨٧</span>","End":"٨٧","PageNumber":329,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":283,"MaqraNumber":132,"HizbNumber":33,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":88,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَٱسۡتَجَبۡنَا لَهُۥ وَنَجَّيۡنَٰهُ مِنَ ٱلۡغَمِّۚ وَكَذَٰلِكَ نُـۨجِي ٱلۡمُؤۡمِنِينَ","TajweedText":"فَ<tajweed class=ham_wasl>ٱ</tajweed>سْتَجَ<tajweed class=qalaqah>بْ</tajweed>نَا لَهُ<tajweed class=madda_normal>ۥ</tajweed> وَنَجَّيْنَ<tajweed class=madda_normal>ـٰ</tajweed>هُ مِنَ <tajweed class=ham_wasl>ٱ</tajweed>لْغَ<tajweed class=ghunnah>مّ</tajweed>ِ‌ۚ وَكَذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ نُـۨجِى <tajweed class=ham_wasl>ٱ</tajweed>لْمُؤْمِن<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٨٨</span>","End":"٨٨","PageNumber":329,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":283,"MaqraNumber":132,"HizbNumber":33,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":89,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَزَكَرِيَّآ إِذۡ نَادَىٰ رَبَّهُۥ رَبِّ لَا تَذَرۡنِي فَرۡدٗا وَأَنتَ خَيۡرُ ٱلۡوَٰرِثِينَ","TajweedText":"وَزَكَرِيّ<tajweed class=madda_obligatory>َآ</tajweed> إِذْ نَادَىٰ رَبَّهُ<tajweed class=madda_normal>ۥ</tajweed> رَبِّ لَا تَذَرْنِى فَرْ<tajweed class=idgham_ghunnah>دًا و</tajweed>َأَ<tajweed class=ikhafa>نت</tajweed>َ خَيْرُ <tajweed class=ham_wasl>ٱ</tajweed>لْو<tajweed class=madda_normal>َٲ</tajweed>رِث<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٨٩</span>","End":"٨٩","PageNumber":329,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":283,"MaqraNumber":132,"HizbNumber":33,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":90,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَٱسۡتَجَبۡنَا لَهُۥ وَوَهَبۡنَا لَهُۥ يَحۡيَىٰ وَأَصۡلَحۡنَا لَهُۥ زَوۡجَهُۥٓۚ إِنَّهُمۡ كَانُواْ يُسَٰرِعُونَ فِي ٱلۡخَيۡرَٰتِ وَيَدۡعُونَنَا رَغَبٗا وَرَهَبٗاۖ وَكَانُواْ لَنَا خَٰشِعِينَ","TajweedText":"فَ<tajweed class=ham_wasl>ٱ</tajweed>سْتَجَ<tajweed class=qalaqah>بْ</tajweed>نَا لَهُ<tajweed class=madda_normal>ۥ</tajweed> وَوَهَ<tajweed class=qalaqah>بْ</tajweed>نَا لَهُ<tajweed class=madda_normal>ۥ</tajweed> يَحْيَىٰ وَأ