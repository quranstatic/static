{"PageNumber":377,"Verses":[{"SurahNumber":27,"SurahIndex":"027","VerseNumber":1,"ShowSurahName":true,"ShowBismillah":true,"Text":"طسٓۚ تِلۡكَ ءَايَٰتُ ٱلۡقُرۡءَانِ وَكِتَابٖ مُّبِينٍ","TajweedText":"ط<tajweed class=madda_necessary>سٓ</tajweed>‌ۚ تِلْكَ ءَايَ<tajweed class=madda_normal>ـٰ</tajweed>تُ <tajweed class=ham_wasl>ٱ</tajweed>لْقُرْءَانِ وَكِتَا<tajweed class=idgham_ghunnah>بٍ م</tajweed>ُّب<tajweed class=madda_permissible>ِي</tajweed>نٍ <span class=end>١</span>","End":"١","PageNumber":377,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":327,"MaqraNumber":151,"HizbNumber":38,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":2,"ShowSurahName":false,"ShowBismillah":false,"Text":"هُدٗى وَبُشۡرَىٰ لِلۡمُؤۡمِنِينَ","TajweedText":"هُ<tajweed class=idgham_ghunnah>دًى و</tajweed>َبُشْرَىٰ لِلْمُؤْمِن<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٢</span>","End":"٢","PageNumber":377,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":327,"MaqraNumber":151,"HizbNumber":38,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":3,"ShowSurahName":false,"ShowBismillah":false,"Text":"ٱلَّذِينَ يُقِيمُونَ ٱلصَّلَوٰةَ وَيُؤۡتُونَ ٱلزَّكَوٰةَ وَهُم بِٱلۡأٓخِرَةِ هُمۡ يُوقِنُونَ","TajweedText":"ٱلَّذِينَ يُقِيمُونَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>صَّلَ<tajweed class=slnt>و</tajweed><tajweed class=madda_normal>ٲ</tajweed>ةَ وَيُؤْتُونَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>زَّكَ<tajweed class=slnt>و</tajweed><tajweed class=madda_normal>ٲ</tajweed>ةَ وَه<tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِ<tajweed class=ham_wasl>ٱ</tajweed>لْأَخِرَةِ هُمْ يُوقِن<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣</span>","End":"٣","PageNumber":377,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":327,"MaqraNumber":151,"HizbNumber":38,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":4,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّ ٱلَّذِينَ لَا يُؤۡمِنُونَ بِٱلۡأٓخِرَةِ زَيَّنَّا لَهُمۡ أَعۡمَٰلَهُمۡ فَهُمۡ يَعۡمَهُونَ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ لَا يُؤْمِنُونَ بِ<tajweed class=ham_wasl>ٱ</tajweed>لْأَخِرَةِ زَيَّ<tajweed class=ghunnah>نّ</tajweed>َا لَهُمْ أَعْمَ<tajweed class=madda_normal>ـٰ</tajweed>لَهُمْ فَهُمْ يَعْمَه<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٤</span>","End":"٤","PageNumber":377,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":327,"MaqraNumber":151,"HizbNumber":38,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":5,"ShowSurahName":false,"ShowBismillah":false,"Text":"أُوْلَـٰٓئِكَ ٱلَّذِينَ لَهُمۡ سُوٓءُ ٱلۡعَذَابِ وَهُمۡ فِي ٱلۡأٓخِرَةِ هُمُ ٱلۡأَخۡسَرُونَ","TajweedText":"أُ<tajweed class=slnt>وْ</tajweed>لَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ئِكَ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ لَهُمْ س<tajweed class=madda_obligatory>ُو</tajweed>ٓءُ <tajweed class=ham_wasl>ٱ</tajweed>لْعَذَابِ وَهُمْ فِى <tajweed class=ham_wasl>ٱ</tajweed>لْأَخِرَةِ هُمُ <tajweed class=ham_wasl>ٱ</tajweed>لْأَخْسَر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٥</span>","End":"٥","PageNumber":377,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":327,"MaqraNumber":151,"HizbNumber":38,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":6,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِنَّكَ لَتُلَقَّى ٱلۡقُرۡءَانَ مِن لَّدُنۡ حَكِيمٍ عَلِيمٍ","TajweedText":"وَإِ<tajweed class=ghunnah>نّ</tajweed>َكَ لَتُلَقَّى <tajweed class=ham_wasl>ٱ</tajweed>لْقُرْءَانَ م<tajweed class=idgham_wo_ghunnah>ِن ل</tajweed>َّدُنْ حَكِيمٍ عَل<tajweed class=madda_permissible>ِي</tajweed>مٍ <span class=end>٦</span>","End":"٦","PageNumber":377,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":327,"MaqraNumber":151,"HizbNumber":38,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":7,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِذۡ قَالَ مُوسَىٰ لِأَهۡلِهِۦٓ إِنِّيٓ ءَانَسۡتُ نَارٗا سَـَٔاتِيكُم مِّنۡهَا بِخَبَرٍ أَوۡ ءَاتِيكُم بِشِهَابٖ قَبَسٖ لَّعَلَّكُمۡ تَصۡطَلُونَ","TajweedText":"إِذْ قَالَ مُوسَىٰ لِأَهْلِه<tajweed class=madda_obligatory>ِۦٓ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed><tajweed class=madda_obligatory>ِىٓ</tajweed> ءَانَسْتُ نَا<tajweed class=ikhafa>رًا س</tajweed>َـَٔـاتِيك<tajweed class=idgham_shafawi>ُم م</tajweed>ِّنْهَا بِخَبَرٍ أَوْ ءَاتِيك<tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِشِهَا<tajweed class=ikhafa>بٍ ق</tajweed>َبَ<tajweed class=idgham_wo_ghunnah>سٍ ل</tajweed>َّعَلَّكُمْ تَصْطَل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٧</span>","End":"٧","PageNumber":377,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":327,"MaqraNumber":151,"HizbNumber":38,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":8,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَلَمَّا جَآءَهَا نُودِيَ أَنۢ بُورِكَ مَن فِي ٱلنَّارِ وَمَنۡ حَوۡلَهَا وَسُبۡحَٰنَ ٱللَّهِ رَبِّ ٱلۡعَٰلَمِينَ","TajweedText":"فَلَ<tajweed class=ghunnah>مّ</tajweed>َا ج<tajweed class=madda_obligatory>َا</tajweed>ٓءَهَا نُودِىَ أ<tajweed class=iqlab>َنۢ ب</tajweed>ُورِكَ مَ<tajweed class=ikhafa>ن ف</tajweed>ِى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َارِ وَمَنْ حَوْلَهَا وَسُ<tajweed class=qalaqah>بْ</tajweed>حَ<tajweed class=madda_normal>ـٰ</tajweed>نَ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ رَبِّ <tajweed class=ham_wasl>ٱ</tajweed>لْعَ<tajweed class=madda_normal>ـٰ</tajweed>لَم<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٨</span>","End":"٨","PageNumber":377,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":327,"MaqraNumber":151,"HizbNumber":38,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":9,"ShowSurahName":false,"ShowBismillah":false,"Text":"يَٰمُوسَىٰٓ إِنَّهُۥٓ أَنَا ٱللَّهُ ٱلۡعَزِيزُ ٱلۡحَكِيمُ","TajweedText":"يَ<tajweed class=madda_normal>ـٰ</tajweed>مُوسَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_obligatory>ۥٓ</tajweed> أَنَا <tajweed class=ham_wasl>ٱ</tajweed>للَّهُ <tajweed class=ham_wasl>ٱ</tajweed>لْعَزِيزُ <tajweed class=ham_wasl>ٱ</tajweed>لْحَك<tajweed class=madda_permissible>ِي</tajweed>مُ <span class=end>٩</span>","End":"٩","PageNumber":377,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":327,"MaqraNumber":151,"HizbNumber":38,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":10,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَأَلۡقِ عَصَاكَۚ فَلَمَّا رَءَاهَا تَهۡتَزُّ كَأَنَّهَا جَآنّٞ وَلَّىٰ مُدۡبِرٗا وَلَمۡ يُعَقِّبۡۚ يَٰمُوسَىٰ لَا تَخَفۡ إِنِّي لَا يَخَافُ لَدَيَّ ٱلۡمُرۡسَلُونَ","TajweedText":"وَأَلْقِ عَصَاكَ‌ۚ فَلَ<tajweed class=ghunnah>مّ</tajweed>َا رَءَاهَا تَهْتَزُّ كَأَ<tajweed class=ghunnah>نّ</tajweed>َهَا ج<tajweed class=madda_necessary>َا</tajweed>ٓ<tajweed class=idgham_ghunnah><tajweed class=ghunnah>نّ</tajweed>ٌ و</tajweed>َلَّىٰ مُ<tajweed class=qalaqah>دْ</tajweed>بِ<tajweed class=idgham_ghunnah>رًا و</tajweed>َلَمْ يُعَقِّ<tajweed class=qalaqah>بْ</tajweed>‌ۚ يَ<tajweed class=madda_normal>ـٰ</tajweed>مُوسَىٰ لَا تَخَفْ إِ<tajweed class=ghunnah>نّ</tajweed>ِى لَا يَخَافُ لَدَىَّ <tajweed class=ham_wasl>ٱ</tajweed>لْمُرْسَل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٠</span>","End":"١٠","PageNumber":377,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":327,"MaqraNumber":151,"HizbNumber":38,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":11,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِلَّا مَن ظَلَمَ ثُمَّ بَدَّلَ حُسۡنَۢا بَعۡدَ سُوٓءٖ فَإِنِّي غَفُورٞ رَّحِيمٞ","TajweedText":"إِلَّا مَ<tajweed class=ikhafa>ن ظ</tajweed>َلَمَ ثُ<tajweed class=ghunnah>مّ</tajweed>َ بَدَّلَ حُسْن<tajweed class=iqlab>َۢا ب</tajweed>َعْدَ س<tajweed class=madda_obligatory>ُو</tajweed>ٓ<tajweed class=ikhafa>ءٍ ف</tajweed>َإِ<tajweed class=ghunnah>نّ</tajweed>ِى غَفُو<tajweed class=idgham_wo_ghunnah>رٌ ر</tajweed>َّح<tajweed class=madda_permissible>ِي</tajweed>مٌ <span class=end>١١</span>","End":"١١","PageNumber":377,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":327,"MaqraNumber":151,"HizbNumber":38,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":12,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَأَدۡخِلۡ يَدَكَ فِي جَيۡبِكَ تَخۡرُجۡ بَيۡضَآءَ مِنۡ غَيۡرِ سُوٓءٖۖ فِي تِسۡعِ ءَايَٰتٍ إِلَىٰ فِرۡعَوۡنَ وَقَوۡمِهِۦٓۚ إِنَّهُمۡ كَانُواْ قَوۡمٗا فَٰسِقِينَ","TajweedText":"وَأَ<tajweed class=qalaqah>دْ</tajweed>خِلْ يَدَكَ فِى جَيْبِكَ تَخْرُ<tajweed class=qalaqah>جْ</tajweed> بَيْض<tajweed class=madda_obligatory>َا</tajweed>ٓءَ مِنْ غَيْرِ س<tajweed class=madda_obligatory>ُو</tajweed>ٓ<tajweed class=ikhafa>ءٍ‌ۖ ف</tajweed>ِى تِسْعِ ءَايَ<tajweed class=madda_normal>ـٰ</tajweed>تٍ إِلَىٰ فِرْعَوْنَ وَقَوْمِه<tajweed class=madda_obligatory>ِۦٓ‌ۚ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َهُمْ كَانُو<tajweed class=slnt>اْ</tajweed> قَوْ<tajweed class=ikhafa>مًا ف</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed>سِق<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٢</span>","End":"١٢","PageNumber":377,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":327,"MaqraNumber":151,"HizbNumber":38,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":13,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَلَمَّا جَآءَتۡهُمۡ ءَايَٰتُنَا مُبۡصِرَةٗ قَالُواْ هَٰذَا سِحۡرٞ مُّبِينٞ","TajweedText":"فَلَ<tajweed class=ghunnah>مّ</tajweed>َا ج<tajweed class=madda_obligatory>َا</tajweed>ٓءَتْهُمْ ءَايَ<tajweed class=madda_normal>ـٰ</tajweed>تُنَا مُ<tajweed class=qalaqah>بْ</tajweed>صِرَ<tajweed class=ikhafa>ةً ق</tajweed>َالُو<tajweed class=slnt>اْ</tajweed> هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا سِحْ<ta