HasSajda":false},{"SurahNumber":23,"SurahIndex":"023","VerseNumber":114,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَٰلَ إِن لَّبِثۡتُمۡ إِلَّا قَلِيلٗاۖ لَّوۡ أَنَّكُمۡ كُنتُمۡ تَعۡلَمُونَ","TajweedText":"قَ<tajweed class=madda_normal>ـٰ</tajweed>لَ إ<tajweed class=idgham_wo_ghunnah>ِن ل</tajweed>َّبِثْتُمْ إِلَّا قَلِيل<tajweed class=idgham_wo_ghunnah>اً‌ۖ ل</tajweed>َّوْ أَ<tajweed class=ghunnah>نّ</tajweed>َكُمْ كُ<tajweed class=ikhafa>نت</tajweed>ُمْ تَعْلَم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١١٤</span>","End":"١١٤","PageNumber":349,"JuzNumber":18,"ManzilNumber":4,"RukuNumber":300,"MaqraNumber":139,"HizbNumber":35,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":23,"SurahIndex":"023","VerseNumber":115,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَفَحَسِبۡتُمۡ أَنَّمَا خَلَقۡنَٰكُمۡ عَبَثٗا وَأَنَّكُمۡ إِلَيۡنَا لَا تُرۡجَعُونَ","TajweedText":"أَفَحَسِ<tajweed class=qalaqah>بْ</tajweed>تُمْ أَ<tajweed class=ghunnah>نّ</tajweed>َمَا خَلَ<tajweed class=qalaqah>قْ</tajweed>نَ<tajweed class=madda_normal>ـٰ</tajweed>كُمْ عَبَ<tajweed class=idgham_ghunnah>ثًا و</tajweed>َأَ<tajweed class=ghunnah>نّ</tajweed>َكُمْ إِلَيْنَا لَا تُرْجَع<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١١٥</span>","End":"١١٥","PageNumber":349,"JuzNumber":18,"ManzilNumber":4,"RukuNumber":300,"MaqraNumber":139,"HizbNumber":35,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":23,"SurahIndex":"023","VerseNumber":116,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَتَعَٰلَى ٱللَّهُ ٱلۡمَلِكُ ٱلۡحَقُّۖ لَآ إِلَٰهَ إِلَّا هُوَ رَبُّ ٱلۡعَرۡشِ ٱلۡكَرِيمِ","TajweedText":"فَتَعَ<tajweed class=madda_normal>ـٰ</tajweed>لَى <tajweed class=ham_wasl>ٱ</tajweed>للَّهُ <tajweed class=ham_wasl>ٱ</tajweed>لْمَلِكُ <tajweed class=ham_wasl>ٱ</tajweed>لْحَقُّ‌ۖ ل<tajweed class=madda_obligatory>َآ</tajweed> إِلَ<tajweed class=madda_normal>ـٰ</tajweed>هَ إِلَّا هُوَ رَبُّ <tajweed class=ham_wasl>ٱ</tajweed>لْعَرْشِ <tajweed class=ham_wasl>ٱ</tajweed>لْكَر<tajweed class=madda_permissible>ِي</tajweed>مِ <span class=end>١١٦</span>","End":"١١٦","PageNumber":349,"JuzNumber":18,"ManzilNumber":4,"RukuNumber":300,"MaqraNumber":139,"HizbNumber":35,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":23,"SurahIndex":"023","VerseNumber":117,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَن يَدۡعُ مَعَ ٱللَّهِ إِلَٰهًا ءَاخَرَ لَا بُرۡهَٰنَ لَهُۥ بِهِۦ فَإِنَّمَا حِسَابُهُۥ عِندَ رَبِّهِۦٓۚ إِنَّهُۥ لَا يُفۡلِحُ ٱلۡكَٰفِرُونَ","TajweedText":"وَم<tajweed class=idgham_ghunnah>َن ي</tajweed>َ<tajweed class=qalaqah>دْ</tajweed>عُ مَعَ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ إِلَ<tajweed class=madda_normal>ـٰ</tajweed>هًا ءَاخَرَ لَا بُرْهَ<tajweed class=madda_normal>ـٰ</tajweed>نَ لَهُ<tajweed class=madda_normal>ۥ</tajweed> بِه<tajweed class=madda_normal>ِۦ</tajweed> فَإِ<tajweed class=ghunnah>نّ</tajweed>َمَا حِسَابُهُ<tajweed class=madda_normal>ۥ</tajweed> عِ<tajweed class=ikhafa>ند</tajweed>َ رَبِّه<tajweed class=madda_obligatory>ِۦٓ‌ۚ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> لَا يُفْلِحُ <tajweed class=ham_wasl>ٱ</tajweed>لْكَ<tajweed class=madda_normal>ـٰ</tajweed>فِر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١١٧</span>","End":"١١٧","PageNumber":349,"JuzNumber":18,"ManzilNumber":4,"RukuNumber":300,"MaqraNumber":139,"HizbNumber":35,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":23,"SurahIndex":"023","VerseNumber":118,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَقُل رَّبِّ ٱغۡفِرۡ وَٱرۡحَمۡ وَأَنتَ خَيۡرُ ٱلرَّـٰحِمِينَ","TajweedText":"وَقُ<tajweed class=idgham_mutaqaribayn>ل</tajweed> رَّبِّ <tajweed class=ham_wasl>ٱ</tajweed>غْفِرْ وَ<tajweed class=ham_wasl>ٱ</tajweed>رْحَمْ وَأَ<tajweed class=ikhafa>نت</tajweed>َ خَيْرُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رّ<tajweed class=madda_normal>َٲ</tajweed>حِم<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١١٨</span>","End":"١١٨"