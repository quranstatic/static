{"PageNumber":407,"Verses":[{"SurahNumber":30,"SurahIndex":"030","VerseNumber":25,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمِنۡ ءَايَٰتِهِۦٓ أَن تَقُومَ ٱلسَّمَآءُ وَٱلۡأَرۡضُ بِأَمۡرِهِۦۚ ثُمَّ إِذَا دَعَاكُمۡ دَعۡوَةٗ مِّنَ ٱلۡأَرۡضِ إِذَآ أَنتُمۡ تَخۡرُجُونَ","TajweedText":"وَمِنْ ءَايَ<tajweed class=madda_normal>ـٰ</tajweed>تِه<tajweed class=madda_obligatory>ِۦٓ</tajweed> أَ<tajweed class=ikhafa>ن ت</tajweed>َقُومَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّم<tajweed class=madda_obligatory>َا</tajweed>ٓءُ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضُ بِأَمْرِه<tajweed class=madda_normal>ِۦ</tajweed>‌ۚ ثُ<tajweed class=ghunnah>مّ</tajweed>َ إِذَا دَعَاكُمْ دَعْوَ<tajweed class=idgham_ghunnah>ةً م</tajweed>ِّنَ <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ إِذ<tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=ikhafa>نت</tajweed>ُمْ تَخْرُج<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٥</span>","End":"٢٥","PageNumber":407,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":351,"MaqraNumber":162,"HizbNumber":41,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":30,"SurahIndex":"030","VerseNumber":26,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَهُۥ مَن فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۖ كُلّٞ لَّهُۥ قَٰنِتُونَ","TajweedText":"وَلَهُ<tajweed class=madda_normal>ۥ</tajweed> مَ<tajweed class=ikhafa>ن ف</tajweed>ِى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّمَ<tajweed class=madda_normal>ـٰ</tajweed>و<tajweed class=madda_normal>َٲ</tajweed>تِ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ‌ۖ كُ<tajweed class=idgham_wo_ghunnah>لٌّ ل</tajweed>َّهُ<tajweed class=madda_normal>ۥ</tajweed> قَ<tajweed class=madda_normal>ـٰ</tajweed>نِت<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٦</span>","End":"٢٦","PageNumber":407,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":351,"MaqraNumber":162,"HizbNumber":41,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":30,"SurahIndex":"030","VerseNumber":27,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَهُوَ ٱلَّذِي يَبۡدَؤُاْ ٱلۡخَلۡقَ ثُمَّ يُعِيدُهُۥ وَهُوَ أَهۡوَنُ عَلَيۡهِۚ وَلَهُ ٱلۡمَثَلُ ٱلۡأَعۡلَىٰ فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ وَهُوَ ٱلۡعَزِيزُ ٱلۡحَكِيمُ","TajweedText":"وَهُوَ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى يَ<tajweed class=qalaqah>بْ</tajweed>دَؤُ<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed>لْخَلْقَ ثُ<tajweed class=ghunnah>مّ</tajweed>َ يُعِيدُهُ<tajweed class=madda_normal>ۥ</tajweed> وَهُوَ أَهْوَنُ عَلَيْهِ‌ۚ وَلَهُ <tajweed class=ham_wasl>ٱ</tajweed>لْمَثَلُ <tajweed class=ham_wasl>ٱ</tajweed>لْأَعْلَىٰ فِى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّمَ<tajweed class=madda_normal>ـٰ</tajweed>و<tajweed class=madda_normal>َٲ</tajweed>تِ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ‌ۚ وَهُوَ <tajweed class=ham_wasl>ٱ</tajweed>لْعَزِيزُ <tajweed class=ham_wasl>ٱ</tajweed>لْحَك<tajweed class=madda_permissible>ِي</tajweed>مُ <span class=end>٢٧</span>","End":"٢٧","PageNumber":407,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":351,"MaqraNumber":162,"HizbNumber":41,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":30,"SurahIndex":"030","VerseNumber":28,"ShowSurahName":false,"ShowBismillah":false,"Text":"ضَرَبَ لَكُم مَّثَلٗا مِّنۡ أَنفُسِكُمۡۖ هَل لَّكُم مِّن مَّا مَلَكَتۡ أَيۡمَٰنُكُم مِّن شُرَكَآءَ فِي مَا رَزَقۡنَٰكُمۡ فَأَنتُمۡ فِيهِ سَوَآءٞ تَخَافُونَهُمۡ كَخِيفَتِكُمۡ أَنفُسَكُمۡۚ كَذَٰلِكَ نُفَصِّلُ ٱلۡأٓيَٰتِ لِقَوۡمٖ يَعۡقِلُونَ","TajweedText":"ضَرَبَ لَك<tajweed class=idgham_shafawi>ُم م</tajweed>َّثَل<tajweed class=idgham_ghunnah>اً م</tajweed>ِّنْ أَ<tajweed class=ikhafa>نف</tajweed>ُسِكُمْ‌ۖ هَل لَّك<tajweed class=idgham_shafawi>ُم م</tajweed>ّ<tajweed class=idgham_ghunnah>ِن م</tajweed>َّا مَلَكَتْ أَيْمَ<tajweed class=madda_normal>ـٰ</tajweed>نُك<tajweed class=idgham_shafawi>ُم م</tajweed>ِّ<tajweed class=ikhafa>ن ش</tajweed>ُرَك<tajweed class=madda_obligatory>َا</tajweed>ٓءَ فِى مَا رَزَ<tajweed class=qalaqah>قْ</tajweed>نَ<tajweed class=madda_normal>ـٰ</tajweed>كُمْ فَأَ<tajweed class=ikhafa>نت</tajweed>ُمْ فِيهِ سَو<tajweed class=madda_obligatory>َا</tajweed>ٓ<tajweed class=ikhafa>ءٌ ت</tajweed>َخَافُونَهُمْ كَخِيفَتِكُمْ أَ<tajweed class=ikhafa>نف</tajweed>ُسَكُمْ‌ۚ كَذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ نُفَصِّلُ <tajweed class=ham_wasl>ٱ</tajweed>لْأَيَ<tajweed class=madda_normal>ـٰ</tajweed>تِ لِقَوْ<tajweed class=idgham_ghunnah>مٍ ي</tajweed>َعْقِل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٨</span>","End":"٢٨","PageNumber":407,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":352,"MaqraNumber":162,"HizbNumber":41,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":30,"SurahIndex":"030","VerseNumber":29,"ShowSurahName":false,"ShowBismillah":false,"Text":"بَلِ ٱتَّبَعَ ٱلَّذِينَ ظَلَمُوٓاْ أَهۡوَآءَهُم بِغَيۡرِ عِلۡمٖۖ فَمَن يَهۡدِي مَنۡ أَضَلَّ ٱللَّهُۖ وَمَا لَهُم مِّن نَّـٰصِرِينَ","TajweedText":"بَلِ <tajweed class=ham_wasl>ٱ</tajweed>تَّبَعَ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ ظَلَم<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> أَهْو<tajweed class=madda_obligatory>َا</tajweed>ٓءَه<tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِغَيْرِ عِلْ<tajweed class=ikhafa>مٍ‌ۖ ف</tajweed>َم<tajweed class=idgham_ghunnah>َن ي</tajweed>َهْدِى مَنْ أَضَلَّ <tajweed class=ham_wasl>ٱ</tajweed>للَّهُ‌ۖ وَمَا لَه<tajweed class=idgham_shafawi>ُم م</tajweed>ّ<tajweed class=idgham_ghunnah>ِن ن</tajweed>َّ<tajweed class=madda_normal>ـٰ</tajweed>صِر<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٢٩</span>","End":"٢٩","PageNumber":407,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":352,"MaqraNumber":162,"HizbNumber":41,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":30,"SurahIndex":"030","VerseNumber":30,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَأَقِمۡ وَجۡهَكَ لِلدِّينِ حَنِيفٗاۚ فِطۡرَتَ ٱللَّهِ ٱلَّتِي فَطَرَ ٱلنَّاسَ عَلَيۡهَاۚ لَا تَبۡدِيلَ لِخَلۡقِ ٱللَّهِۚ ذَٰلِكَ ٱلدِّينُ ٱلۡقَيِّمُ وَلَٰكِنَّ أَكۡثَرَ ٱلنَّاسِ لَا يَعۡلَمُونَ","TajweedText":"فَأَقِمْ وَ<tajweed class=qalaqah>جْ</tajweed>هَكَ لِلدِّينِ حَنِي<tajweed class=ikhafa>فًا‌ۚ ف</tajweed>ِ<tajweed class=qalaqah>طْ</tajweed>رَتَ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ <tajweed class=ham_wasl>ٱ</tajweed>لَّتِى فَطَرَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َاسَ عَلَيْهَا‌ۚ لَا تَ<tajweed class=qalaqah>بْ</tajweed>دِيلَ لِخَلْقِ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ‌ۚ ذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>دِّينُ <tajweed class=ham_wasl>ٱ</tajweed>لْقَيِّمُ وَلَ<tajweed class=madda_normal>ـٰ</tajweed>كِ<tajweed class=ghunnah>نّ</tajweed>َ أَكْثَرَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َاسِ لَا يَعْلَم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣٠</span>","End":"٣٠","PageNumber":407,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":352,"MaqraNumber":162,"HizbNumber":41,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":30,"SurahIndex":"030","VerseNumber":31,"ShowSurahName":false,"ShowBismillah":false,"Text":"۞مُنِيبِينَ إِلَيۡهِ وَٱتَّقُوهُ وَأَقِيمُواْ ٱلصَّلَوٰةَ وَلَا تَكُونُواْ مِنَ ٱلۡمُشۡرِكِينَ","TajweedText":"۞ مُنِيبِينَ إِلَيْهِ وَ<tajweed class=ham_wasl>ٱ</tajweed>تَّقُوهُ وَأَقِيمُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>صَّلَ<tajweed class=slnt>و</tajweed><tajweed class=madda_normal>ٲ</tajweed>ةَ وَلَا تَكُونُو<tajweed class=slnt>اْ</tajweed> مِنَ <tajweed class=ham_wasl>ٱ</tajweed>لْمُشْرِك<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٣١</span>","End":"٣١","PageNumber":407,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":352,"MaqraNumber":163,"HizbNumber":41,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":30,"SurahIndex":"030","VerseNumber":32,"ShowSurahName":false,"ShowBismillah":false,"Text":"مِنَ ٱلَّذِينَ فَرَّقُواْ دِينَهُمۡ وَكَانُواْ شِيَعٗاۖ كُلُّ حِزۡبِۭ بِمَا لَدَيۡهِمۡ فَرِحُونَ","TajweedText":"مِنَ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ فَرَّقُو<tajweed class=slnt>اْ</tajweed> دِينَهُمْ وَكَانُو<tajweed class=slnt>اْ</tajweed> شِيَ<tajweed class=ikhafa>عًا‌ۖ ك</tajweed>ُلُّ حِزْ<tajweed class=iqlab>بِۭ ب</tajweed>ِمَا لَدَيْهِمْ فَرِح<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣٢</span>","End":"٣٢","PageNumber":407,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":352,"MaqraNumber":163,"HizbNumber":41,"HizbDecimal":0.5,"HasSajda":false}]}