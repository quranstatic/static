{"PageNumber":315,"Verses":[{"SurahNumber":20,"SurahIndex":"020","VerseNumber":52,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَ عِلۡمُهَا عِندَ رَبِّي فِي كِتَٰبٖۖ لَّا يَضِلُّ رَبِّي وَلَا يَنسَى","TajweedText":"قَالَ عِلْمُهَا عِ<tajweed class=ikhafa>ند</tajweed>َ رَبِّى فِى كِتَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_wo_ghunnah>بٍ‌ۖ ل</tajweed>َّا يَضِلُّ رَبِّى وَلَا يَ<tajweed class=ikhafa>نس</tajweed>َى <span class=end>٥٢</span>","End":"٥٢","PageNumber":315,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":271,"MaqraNumber":125,"HizbNumber":32,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":53,"ShowSurahName":false,"ShowBismillah":false,"Text":"ٱلَّذِي جَعَلَ لَكُمُ ٱلۡأَرۡضَ مَهۡدٗا وَسَلَكَ لَكُمۡ فِيهَا سُبُلٗا وَأَنزَلَ مِنَ ٱلسَّمَآءِ مَآءٗ فَأَخۡرَجۡنَا بِهِۦٓ أَزۡوَٰجٗا مِّن نَّبَاتٖ شَتَّىٰ","TajweedText":"ٱلَّذِى جَعَلَ لَكُمُ <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضَ مَهْ<tajweed class=idgham_ghunnah>دًا و</tajweed>َسَلَكَ لَكُمْ فِيهَا سُبُل<tajweed class=idgham_ghunnah>اً و</tajweed>َأَ<tajweed class=ikhafa>نز</tajweed>َلَ مِنَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّم<tajweed class=madda_obligatory>َا</tajweed>ٓءِ م<tajweed class=madda_obligatory>َا</tajweed>ٓ<tajweed class=ikhafa>ءً ف</tajweed>َأَخْرَ<tajweed class=qalaqah>جْ</tajweed>نَا بِه<tajweed class=madda_obligatory>ِۦٓ</tajweed> أَزْو<tajweed class=madda_normal>َٲ</tajweed><tajweed class=idgham_ghunnah>جًا م</tajweed>ّ<tajweed class=idgham_ghunnah>ِن ن</tajweed>َّبَا<tajweed class=ikhafa>تٍ ش</tajweed>َتَّىٰ <span class=end>٥٣</span>","End":"٥٣","PageNumber":315,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":271,"MaqraNumber":125,"HizbNumber":32,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":54,"ShowSurahName":false,"ShowBismillah":false,"Text":"كُلُواْ وَٱرۡعَوۡاْ أَنۡعَٰمَكُمۡۚ إِنَّ فِي ذَٰلِكَ لَأٓيَٰتٖ لِّأُوْلِي ٱلنُّهَىٰ","TajweedText":"كُلُو<tajweed class=slnt>اْ</tajweed> وَ<tajweed class=ham_wasl>ٱ</tajweed>رْعَوْ<tajweed class=slnt>اْ</tajweed> أَنْعَ<tajweed class=madda_normal>ـٰ</tajweed>مَكُمْ‌ۗ إِ<tajweed class=ghunnah>نّ</tajweed>َ فِى ذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ لَأَيَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_wo_ghunnah>تٍ ل</tajweed>ِّأُ<tajweed class=slnt>وْ</tajweed>لِى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>ُهَىٰ <span class=end>٥٤</span>","End":"٥٤","PageNumber":315,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":271,"MaqraNumber":125,"HizbNumber":32,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":55,"ShowSurahName":false,"ShowBismillah":false,"Text":"۞مِنۡهَا خَلَقۡنَٰكُمۡ وَفِيهَا نُعِيدُكُمۡ وَمِنۡهَا نُخۡرِجُكُمۡ تَارَةً أُخۡرَىٰ","TajweedText":"۞ مِنْهَا خَلَ<tajweed class=qalaqah>قْ</tajweed>نَ<tajweed class=madda_normal>ـٰ</tajweed>كُمْ وَفِيهَا نُعِيدُكُمْ وَمِنْهَا نُخْرِجُكُمْ تَارَةً أُخْرَىٰ <span class=end>٥٥</span>","End":"٥٥","PageNumber":315,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":272,"MaqraNumber":126,"HizbNumber":32,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":56,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَقَدۡ أَرَيۡنَٰهُ ءَايَٰتِنَا كُلَّهَا فَكَذَّبَ وَأَبَىٰ","TajweedText":"وَلَقَ<tajweed class=qalaqah>دْ</tajweed> أَرَيْنَ<tajweed class=madda_normal>ـٰ</tajweed>هُ ءَايَ<tajweed class=madda_normal>ـٰ</tajweed>تِنَا كُلَّهَا فَكَذَّبَ وَأَبَىٰ <span class=end>٥٦</span>","End":"٥٦","PageNumber":315,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":272,"MaqraNumber":126,"HizbNumber":32,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":57,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَ أَجِئۡتَنَا لِتُخۡرِجَنَا مِنۡ أَرۡضِنَا بِسِحۡرِكَ يَٰمُوسَىٰ","TajweedText":"قَالَ أَجِئْتَنَا لِتُخْرِجَنَا مِنْ أَرْضِنَا بِسِحْرِكَ يَ<tajweed class=madda_normal>ـٰ</tajweed>مُوسَىٰ <span class=end>٥٧</span>","End":"٥٧","PageNumber":315,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":272,"MaqraNumber":126,"HizbNumber":32,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":58,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَلَنَأۡتِيَنَّكَ بِسِحۡرٖ مِّثۡلِهِۦ فَٱجۡعَلۡ بَيۡنَنَا وَبَيۡنَكَ مَوۡعِدٗا لَّا نُخۡلِفُهُۥ نَحۡنُ وَلَآ أَنتَ مَكَانٗا سُوٗى","TajweedText":"فَلَنَأْتِيَ<tajweed class=ghunnah>نّ</tajweed>َكَ بِسِحْ<tajweed class=idgham_ghunnah>رٍ م</tajweed>ِّثْلِه<tajweed class=madda_normal>ِۦ</tajweed> فَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=qalaqah>جْ</tajweed>عَلْ بَيْنَنَا وَبَيْنَكَ مَوْعِ<tajweed class=idgham_wo_ghunnah>دًا ل</tajweed>َّا نُخْلِفُهُ<tajweed class=madda_normal>ۥ</tajweed> نَحْنُ وَل<tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=ikhafa>نت</tajweed>َ مَكَا<tajweed class=ikhafa>نًا سُ</tajweed>وًى <span class=end>٥٨</span>","End":"٥٨","PageNumber":315,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":272,"MaqraNumber":126,"HizbNumber":32,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":59,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَ مَوۡعِدُكُمۡ يَوۡمُ ٱلزِّينَةِ وَأَن يُحۡشَرَ ٱلنَّاسُ ضُحٗى","TajweedText":"قَالَ مَوْعِدُكُمْ يَوْمُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>زِّينَةِ وَأ<tajweed class=idgham_ghunnah>َن ي</tajweed>ُحْشَرَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َاسُ ضُحًى <span class=end>٥٩</span>","End":"٥٩","PageNumber":315,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":272,"MaqraNumber":126,"HizbNumber":32,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":60,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَتَوَلَّىٰ فِرۡعَوۡنُ فَجَمَعَ كَيۡدَهُۥ ثُمَّ أَتَىٰ","TajweedText":"فَتَوَلَّىٰ فِرْعَوْنُ فَجَمَعَ كَيْدَهُ<tajweed class=madda_normal>ۥ</tajweed> ثُ<tajweed class=ghunnah>مّ</tajweed>َ أَتَىٰ <span class=end>٦٠</span>","End":"٦٠","PageNumber":315,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":272,"MaqraNumber":126,"HizbNumber":32,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":61,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَ لَهُم مُّوسَىٰ وَيۡلَكُمۡ لَا تَفۡتَرُواْ عَلَى ٱللَّهِ كَذِبٗا فَيُسۡحِتَكُم بِعَذَابٖۖ وَقَدۡ خَابَ مَنِ ٱفۡتَرَىٰ","TajweedText":"قَالَ لَه<tajweed class=idgham_shafawi>ُم م</tajweed>ُّوسَىٰ وَيْلَكُمْ لَا تَفْتَرُو<tajweed class=slnt>اْ</tajweed> عَلَى <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ كَذِ<tajweed class=ikhafa>بًا ف</tajweed>َيُسْحِتَك<tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِعَذَا<tajweed class=idgham_ghunnah>بٍ‌ۖ و</tajweed>َقَ<tajweed class=qalaqah>دْ</tajweed> خَابَ مَنِ <tajweed class=ham_wasl>ٱ</tajweed>فْتَرَىٰ <span class=end>٦١</span>","End":"٦١","PageNumber":315,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":272,"MaqraNumber":126,"HizbNumber":32,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":62,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَتَنَٰزَعُوٓاْ أَمۡرَهُم بَيۡنَهُمۡ وَأَسَرُّواْ ٱلنَّجۡوَىٰ","TajweedText":"فَتَنَ<tajweed class=madda_normal>ـٰ</tajweed>زَع<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> أَمْرَه<tajweed class=ikhafa_shafawi>ُم ب</tajweed>َيْنَهُمْ وَأَسَرُّو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َ<tajweed class=qalaqah>جْ</tajweed>وَىٰ <span class=end>٦٢</span>","End":"٦٢","PageNumber":315,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":272,"MaqraNumber":126,"HizbNumber":32,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":63,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالُوٓاْ إِنۡ هَٰذَٰنِ لَسَٰحِرَٰنِ يُرِيدَانِ أَن يُخۡرِجَاكُم مِّنۡ أَرۡضِكُم بِسِحۡرِهِمَا وَيَذۡهَبَا بِطَرِيقَتِكُمُ ٱلۡمُثۡلَىٰ","TajweedText":"قَال<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> إِنْ هَ<tajweed class=madda_normal>ـٰ</tajweed>ذ<tajweed class=madda_normal>َٲ</tajweed>نِ لَسَ<tajweed class=madda_normal>ـٰ</tajweed>حِر<tajweed class=madda_normal>َٲ</tajweed>نِ يُرِيدَانِ أ<tajweed class=idgham_ghunnah>َن ي</tajweed>ُخْرِجَاك<tajweed class=idgham_shafawi>ُم م</tajweed>ِّنْ أَرْضِك<tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِسِحْرِهِمَا وَيَذْهَبَا بِطَرِيقَتِكُمُ <tajweed class=ham_wasl>ٱ</tajweed>لْمُثْلَىٰ <span class=end>٦٣</span>","End":"٦٣","PageNumber":315,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":272,"MaqraNumber":126,"HizbNumber":32,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":64,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَأَجۡمِعُواْ كَيۡدَكُمۡ ثُمَّ ٱئۡتُواْ صَفّٗاۚ وَقَدۡ أَفۡلَحَ ٱلۡيَوۡمَ مَنِ ٱسۡتَعۡلَىٰ","TajweedText":"فَأَ<tajweed class=qalaqah>جْ</tajweed>مِعُو<tajweed class=slnt>اْ</tajweed> كَيْدَكُمْ ثُ<tajweed class=ghunnah>مّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>ئْتُو<tajweed class=slnt>اْ</tajweed> صَف<tajweed class=idgham_ghunnah>ًّا‌ۚ و</tajweed>َقَ<tajweed class=qalaqah>دْ</tajweed> أَفْلَحَ <tajweed class=ham_wasl>ٱ</tajweed>لْيَوْمَ مَنِ <tajweed class=ham_wasl>ٱ</tajweed>سْتَعْلَىٰ <span class=end>٦٤</span>","End":"٦٤","PageNumber":315,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":272,"MaqraNumber":126,"HizbNumber":32,"HizbDecimal":0.25,"HasSajda":false}]}