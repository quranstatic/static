{"PageNumber":464,"Verses":[{"SurahNumber":39,"SurahIndex":"039","VerseNumber":48,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَبَدَا لَهُمۡ سَيِّـَٔاتُ مَا كَسَبُواْ وَحَاقَ بِهِم مَّا كَانُواْ بِهِۦ يَسۡتَهۡزِءُونَ","TajweedText":"وَبَدَا لَهُمْ سَيِّـَٔـاتُ مَا كَسَبُو<tajweed class=slnt>اْ</tajweed> وَحَاقَ بِه<tajweed class=idgham_shafawi>ِم م</tajweed>َّا كَانُو<tajweed class=slnt>اْ</tajweed> بِه<tajweed class=madda_normal>ِۦ</tajweed> يَسْتَهْزِء<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٤٨</span>","End":"٤٨","PageNumber":464,"JuzNumber":24,"ManzilNumber":6,"RukuNumber":400,"MaqraNumber":185,"HizbNumber":47,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":39,"SurahIndex":"039","VerseNumber":49,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَإِذَا مَسَّ ٱلۡإِنسَٰنَ ضُرّٞ دَعَانَا ثُمَّ إِذَا خَوَّلۡنَٰهُ نِعۡمَةٗ مِّنَّا قَالَ إِنَّمَآ أُوتِيتُهُۥ عَلَىٰ عِلۡمِۭۚ بَلۡ هِيَ فِتۡنَةٞ وَلَٰكِنَّ أَكۡثَرَهُمۡ لَا يَعۡلَمُونَ","TajweedText":"فَإِذَا مَسَّ <tajweed class=ham_wasl>ٱ</tajweed>لْإِ<tajweed class=ikhafa>نس</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed>نَ ضُ<tajweed class=ikhafa>رٌّ د</tajweed>َعَانَا ثُ<tajweed class=ghunnah>مّ</tajweed>َ إِذَا خَوَّلْنَ<tajweed class=madda_normal>ـٰ</tajweed>هُ نِعْمَ<tajweed class=idgham_ghunnah>ةً م</tajweed>ِّ<tajweed class=ghunnah>نّ</tajweed>َا قَالَ إِ<tajweed class=ghunnah>نّ</tajweed>َم<tajweed class=madda_obligatory>َآ</tajweed> أُوتِيتُهُ<tajweed class=madda_normal>ۥ</tajweed> عَلَىٰ عِلْ<tajweed class=iqlab>مِۭ‌ۚ ب</tajweed>َلْ هِىَ فِتْنَ<tajweed class=idgham_ghunnah>ةٌ و</tajweed>َلَ<tajweed class=madda_normal>ـٰ</tajweed>كِ<tajweed class=ghunnah>نّ</tajweed>َ أَكْثَرَهُمْ لَا يَعْلَم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٤٩</span>","End":"٤٩","PageNumber":464,"JuzNumber":24,"ManzilNumber":6,"RukuNumber":400,"MaqraNumber":185,"HizbNumber":47,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":39,"SurahIndex":"039","VerseNumber":50,"ShowSur