{"PageNumber":367,"Verses":[{"SurahNumber":26,"SurahIndex":"026","VerseNumber":1,"ShowSurahName":true,"ShowBismillah":true,"Text":"طسٓمٓ","TajweedText":"ط<tajweed class=madda_necessary>سٓ</tajweed><tajweed class=madda_necessary>مٓ</tajweed> <span class=end>١</span>","End":"١","PageNumber":367,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":316,"MaqraNumber":147,"HizbNumber":37,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":26,"SurahIndex":"026","VerseNumber":2,"ShowSurahName":false,"ShowBismillah":false,"Text":"تِلۡكَ ءَايَٰتُ ٱلۡكِتَٰبِ ٱلۡمُبِينِ","TajweedText":"تِلْكَ ءَايَ<tajweed class=madda_normal>ـٰ</tajweed>تُ <tajweed class=ham_wasl>ٱ</tajweed>لْكِتَ<tajweed class=madda_normal>ـٰ</tajweed>بِ <tajweed class=ham_wasl>ٱ</tajweed>لْمُب<tajweed class=madda_permissible>ِي</tajweed>نِ <span class=end>٢</span>","End":"٢","PageNumber":367,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":316,"MaqraNumber":147,"HizbNumber":37,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":26,"SurahIndex":"026","VerseNumber":3,"ShowSurahName":false,"ShowBismillah":false,"Text":"لَعَلَّكَ بَٰخِعٞ نَّفۡسَكَ أَلَّا يَكُونُواْ مُؤۡمِنِينَ","TajweedText":"لَعَلَّكَ بَ<tajweed class=madda_normal>ـٰ</tajweed>خِ<tajweed class=idgham_ghunnah>عٌ ن</tajweed>َّفْسَكَ أَلَّا يَكُونُو<tajweed class=slnt>اْ</tajweed> مُؤْمِن<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٣</span>","End":"٣","PageNumber":367,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":316,"MaqraNumber":147,"HizbNumber":37,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":26,"SurahIndex":"026","VerseNumber":4,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِن نَّشَأۡ نُنَزِّلۡ عَلَيۡهِم مِّنَ ٱلسَّمَآءِ ءَايَةٗ فَظَلَّتۡ أَعۡنَٰقُهُمۡ لَهَا خَٰضِعِينَ","TajweedText":"إ<tajweed class=idgham_ghunnah>ِن ن</tajweed>َّشَأْ نُنَزِّلْ عَلَيْه<tajweed class=idgham_shafawi>ِم م</tajweed>ِّنَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّم<tajweed class=madda_obligatory>َا</tajweed>ٓءِ ءَايَ<tajweed class=ikhafa>ةً ف</tajweed>َظَلَّتْ أَعْنَ<tajweed class=madda_normal>ـٰ</tajweed>قُهُمْ لَهَا خَ<tajweed class=madda_normal>ـٰ</tajweed>ضِع<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٤</span>","End":"٤","PageNumber":367,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":316,"MaqraNumber":147,"HizbNumber":37,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":26,"SurahIndex":"026","VerseNumber":5,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَا يَأۡتِيهِم مِّن ذِكۡرٖ مِّنَ ٱلرَّحۡمَٰنِ مُحۡدَثٍ إِلَّا كَانُواْ عَنۡهُ مُعۡرِضِينَ","TajweedText":"وَمَا يَأْتِيه<tajweed class=idgham_shafawi>ِم م</tajweed>ِّ<tajweed class=ikhafa>ن ذ</tajweed>ِكْ<tajweed class=idgham_ghunnah>رٍ م</tajweed>ِّنَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رَّحْمَ<tajweed class=madda_normal>ـٰ</tajweed>نِ مُحْدَثٍ إِلَّا كَانُو<tajweed class=slnt>اْ</tajweed> عَنْهُ مُعْرِض<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٥</span>","End":"٥","PageNumber":367,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":316,"MaqraNumber":147,"HizbNumber":37,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":26,"SurahIndex":"026","VerseNumber":6,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَقَدۡ كَذَّبُواْ فَسَيَأۡتِيهِمۡ أَنۢبَـٰٓؤُاْ مَا كَانُواْ بِهِۦ يَسۡتَهۡزِءُونَ","TajweedText":"فَقَ<tajweed class=qalaqah>دْ</tajweed> كَذَّبُو<tajweed class=slnt>اْ</tajweed> فَسَيَأْتِيهِمْ أَ<tajweed class=iqlab>نۢب</tajweed>َ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ؤُ<tajweed class=slnt>اْ</tajweed> مَا كَانُو<tajweed class=slnt>اْ</tajweed> بِه<tajweed class=madda_normal>ِۦ</tajweed> يَسْتَهْزِء<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦</span>","End":"٦","PageNumber":367,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":316,"MaqraNumber":147,"HizbNumber":37,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":26,"SurahIndex":"026","VerseNumber":7,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَوَلَمۡ يَرَوۡاْ إِلَى ٱلۡأَرۡضِ كَمۡ أَنۢبَتۡنَا فِيهَا مِن كُلِّ زَوۡجٖ كَرِيمٍ","TajweedText":"أَوَلَمْ يَرَوْ<tajweed class=slnt>اْ</tajweed> إِلَى <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ كَمْ أَ<tajweed class=iqlab>نۢب</tajweed>َتْنَا فِيهَا مِ<tajweed class=ikhafa>ن ك</tajweed>ُلِّ زَوْ<tajweed class=ikhafa>جٍ ك</tajweed>َر<tajweed class=madda_permissible>ِي</tajweed>مٍ <span class=end>٧</span>","End":"٧","PageNumber":367,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":316,"MaqraNumber":147,"HizbNumber":37,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":26,"SurahIndex":"026","VerseNumber":8,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّ فِي ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكۡثَرُهُم مُّؤۡمِنِينَ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َ فِى ذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ لَأَيَ<tajweed class=idgham_ghunnah>ةً‌ۖ و</tajweed>َمَا كَانَ أَكْثَرُه<tajweed class=idgham_shafawi>ُم م</tajweed>ُّؤْمِن<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٨</span>","End":"٨","PageNumber":367,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":316,"MaqraNumber":147,"HizbNumber":37,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":26,"SurahIndex":"026","VerseNumber":9,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِنَّ رَبَّكَ لَهُوَ ٱلۡعَزِيزُ ٱلرَّحِيمُ","TajweedText":"وَإِ<tajweed class=ghunnah>نّ</tajweed>َ رَبَّكَ لَهُوَ <tajweed class=ham_wasl>ٱ</tajweed>لْعَزِيزُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رَّح<tajweed class=madda_permissible>ِي</tajweed>مُ <span class=end>٩</span>","End":"٩","PageNumber":367,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":316,"MaqraNumber":147,"HizbNumber":37,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":26,"SurahIndex":"026","VerseNumber":10,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِذۡ نَادَىٰ رَبُّكَ مُوسَىٰٓ أَنِ ٱئۡتِ ٱلۡقَوۡمَ ٱلظَّـٰلِمِينَ","TajweedText":"وَإِذْ نَادَىٰ رَبُّكَ مُوسَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> أَنِ <tajweed class=ham_wasl>ٱ</tajweed>ئْتِ <tajweed class=ham_wasl>ٱ</tajweed>لْقَوْمَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>ظَّ<tajweed class=madda_normal>ـٰ</tajweed>لِم<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٠</span>","End":"١٠","PageNumber":367,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":317,"MaqraNumber":147,"HizbNumber":37,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":26,"SurahIndex":"026","VerseNumber":11,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَوۡمَ فِرۡعَوۡنَۚ أَلَا يَتَّقُونَ","TajweedText":"قَوْمَ فِرْعَوْنَ‌ۚ أَلَا يَتَّق<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١١</span>","End":"١١","PageNumber":367,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":317,"MaqraNumber":147,"HizbNumber":37,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":26,"SurahIndex":"026","VerseNumber":12,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَ رَبِّ إِنِّيٓ أَخَافُ أَن يُكَذِّبُونِ","TajweedText":"قَالَ رَبِّ إِ<tajweed class=ghunnah>نّ</tajweed><tajweed class=madda_obligatory>ِىٓ</tajweed> أَخَافُ أ<tajweed class=idgham_ghunnah>َن ي</tajweed>ُكَذِّب<tajweed class=madda_permissible>ُو</tajweed>نِ <span class=end>١٢</span>","End":"١٢","PageNumber":367,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":317,"MaqraNumber":147,"HizbNumber":37,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":26,"SurahIndex":"026","VerseNumber":13,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَيَضِيقُ صَدۡرِي وَلَا يَنطَلِقُ لِسَانِي فَأَرۡسِلۡ إِلَىٰ هَٰرُونَ","TajweedText":"وَيَضِيقُ صَ<tajweed class=qalaqah>دْ</tajweed>رِى وَلَا يَ<tajweed class=ikhafa>نط</tajweed>َلِقُ لِسَانِى فَأَرْسِلْ إِلَىٰ هَ<tajweed class=madda_normal>ـٰ</tajweed>ر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٣</span>","End":"١٣","PageNumber":367,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":317,"MaqraNumber":147,"HizbNumber":37,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":26,"SurahIndex":"026","VerseNumber":14,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَهُمۡ عَلَيَّ ذَنۢبٞ فَأَخَافُ أَن يَقۡتُلُونِ","TajweedText":"وَلَهُمْ عَلَىَّ ذَ<tajweed class=iqlab>نۢب</tajweed><tajweed class=ikhafa>ٌ ف</tajweed>َأَخَافُ أ<tajweed class=idgham_ghunnah>َن ي</tajweed>َ<tajweed class=qalaqah>قْ</tajweed>تُل<tajweed class=madda_permissible>ُو</tajweed>نِ <span class=end>١٤</span>","End":"١٤","PageNumber":367,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":317,"MaqraNumber":147,"HizbNumber":37,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":26,"SurahIndex":"026","VerseNumber":15,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَ كَلَّاۖ فَٱذۡهَبَا بِـَٔايَٰتِنَآۖ إِنَّا مَعَكُم مُّسۡتَمِعُونَ","TajweedText":"قَالَ كَلَّا‌ۖ فَ<tajweed class=ham_wasl>ٱ</tajweed>ذْهَبَا بِـَٔـايَ<tajweed class=madda_normal>ـٰ</tajweed>تِن<tajweed class=madda_obligatory>َآ‌ۖ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َا مَعَك<tajweed class=idgham_shafawi>ُم م</tajweed>ُّسْتَمِع<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٥</span>","End":"١٥","PageNumber":367,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":317,"MaqraNumber":147,"HizbNumber":37,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":26,"SurahIndex":"026","VerseNumber":16,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَأۡتِيَا فِرۡعَوۡنَ فَقُولَآ إِنَّا رَسُولُ رَبِّ ٱلۡعَٰلَمِينَ","TajweedText":"فَأْتِيَا فِرْعَوْنَ فَقُول<tajweed class=madda_obligatory>َآ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َا رَسُولُ رَبِّ <tajweed class=ham_wasl>ٱ</tajweed>لْعَ<tajweed class=madda_normal>ـٰ</tajweed>لَم<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٦</span>","End":"١٦","PageNumber":367,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":317,"MaqraNumber":147,"HizbNumber":37,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":26,"SurahIndex":"026","VerseNumber":17,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَنۡ أَرۡسِلۡ مَعَنَا بَنِيٓ إِسۡرَـٰٓءِيلَ","TajweedText":"أَنْ أَرْسِلْ مَعَنَا بَن<tajweed class=madda_obligatory>ِىٓ</tajweed> إِسْر<tajweed class=madda_obligatory>َٲ</tajweed>ٓء<tajweed class=madda_permissible>ِي</tajweed>لَ <span class=end>١٧</span>","End":"١٧","PageNumber":367,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":317,"MaqraNumber":147,"HizbNumber":37,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":26,"SurahIndex":"026","VerseNumber":18,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَ أَلَمۡ نُرَبِّكَ فِينَا وَلِيدٗا وَلَبِثۡتَ فِينَا مِنۡ عُمُرِكَ سِنِينَ","TajweedText":"قَالَ أَلَمْ نُرَبِّكَ فِينَا وَلِي<tajweed class=idgham_ghunnah>دًا و</tajweed>َلَبِثْتَ فِينَا مِنْ عُمُرِكَ سِن<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٨</span>","End":"١٨","PageNumber":367,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":317,"MaqraNumber":147,"HizbNumber":37,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":26,"SurahIndex":"026","VerseNumber":19,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَفَعَلۡتَ فَعۡلَتَكَ ٱلَّتِي فَعَلۡتَ وَأَنتَ مِنَ ٱلۡكَٰفِرِينَ","TajweedText":"وَفَعَلْتَ فَعْلَتَكَ <tajweed class=ham_wasl>ٱ</tajweed>لَّتِى فَعَلْتَ وَأَ<tajweed class=ikhafa>نت</tajweed>َ مِنَ <tajweed class=ham_wasl>ٱ</tajweed>لْكَ<tajweed class=madda_normal>ـٰ</tajweed>فِر<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٩</span>","End":"١٩","PageNumber":367,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":317,"MaqraNumber":147,"HizbNumber":37,"HizbDecimal":0.5,"HasSajda":false}]}