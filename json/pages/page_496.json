م</tajweed>ُّوقِن<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٧</span>","End":"٧","PageNumber":496,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":431,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":44,"SurahIndex":"044","VerseNumber":8,"ShowSurahName":false,"ShowBismillah":false,"Text":"لَآ إِلَٰهَ إِلَّا هُوَ يُحۡيِۦ وَيُمِيتُۖ رَبُّكُمۡ وَرَبُّ ءَابَآئِكُمُ ٱلۡأَوَّلِينَ","TajweedText":"ل<tajweed class=madda_obligatory>َآ</tajweed> إِلَ<tajweed class=madda_normal>ـٰ</tajweed>هَ إِلَّا هُوَ يُحْى<tajweed class=madda_normal>ِۦ</tajweed> وَيُمِيتُ‌ۖ رَبُّكُمْ وَرَبُّ ءَاب<tajweed class=madda_obligatory>َا</tajweed>ٓئِكُمُ <tajweed class=ham_wasl>ٱ</tajweed>لْأَوَّل<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٨</span>","End":"٨","PageNumber":496,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":431,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":44,"SurahIndex":"044","VerseNumber":9,"ShowSurahName":false,"ShowBismillah":false,"Text":"بَلۡ هُمۡ فِي شَكّٖ يَلۡعَبُونَ","TajweedText":"بَلْ هُمْ فِى شَ<tajweed class=idgham_ghunnah>كٍّ ي</tajweed>َلْعَب<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٩</span>","End":"٩","PageNumber":496,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":431,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":44,"SurahIndex":"044","VerseNumber":10,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَٱرۡتَقِبۡ يَوۡمَ تَأۡتِي ٱلسَّمَآءُ بِدُخَانٖ مُّبِينٖ","TajweedText":"فَ<tajweed class=ham_wasl>ٱ</tajweed>رْتَقِ<tajweed class=qalaqah>بْ</tajweed> يَوْمَ تَأْتِى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّم<tajweed class=madda_obligatory>َا</tajweed>ٓءُ بِدُخَا<tajweed class=idgham_ghunnah>نٍ م</tajweed>ُّب<tajweed class=madda_permissible>ِي</tajweed>نٍ <span class=end>١٠</span>","End":"١٠","PageNumber":496,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":431,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":44,"SurahIndex":"044","VerseNumber":11,"ShowSurahName":false,"ShowBismillah":false,"Text":"يَغۡشَى ٱلنَّاسَۖ هَٰذَا عَذَابٌ أَلِيمٞ","TajweedText":"يَغْشَى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َاسَ‌ۖ هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا عَذَابٌ أَل<tajweed class=madda_permissible>ِي</tajweed>مٌ <span class=end>١١</span>","End":"١١","PageNumber":496,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":431,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":44,"SurahIndex":"044","VerseNumber":12,"ShowSurahName":false,"ShowBismillah":false,"Text":"رَّبَّنَا ٱكۡشِفۡ عَنَّا ٱلۡعَذَابَ إِنَّا مُؤۡمِنُونَ","TajweedText":"رَّبَّنَا <tajweed class=ham_wasl>ٱ</tajweed>كْشِفْ عَ<tajweed class=ghunnah>نّ</tajweed>َا <tajweed class=ham_wasl>ٱ</tajweed>لْعَذَابَ إِ<tajweed class=ghunnah>نّ</tajweed>َا مُؤْمِن<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٢</span>","End":"١٢","PageNumber":496,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":431,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":44,"SurahIndex":"044","VerseNumber":13,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَنَّىٰ لَهُمُ ٱلذِّكۡرَىٰ وَقَدۡ جَآءَهُمۡ رَسُولٞ مُّبِينٞ","TajweedText":"أَ<tajweed class=ghunnah>نّ</tajweed>َىٰ لَهُمُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>ذِّكْرَىٰ وَقَ<tajweed class=qalaqah>دْ</tajweed> ج<tajweed class=madda_obligatory>َا</tajweed>ٓءَهُمْ رَسُو<tajweed class=idgham_ghunnah>لٌ م</tajweed>ُّب<tajweed class=madda_permissible>ِي</tajweed>نٌ <span class=end>١٣</span>","End":"١٣","PageNumber":496,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":431,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":44,"SurahIndex":"044","VerseNumber":14,"ShowSurahName":false,"ShowBismillah