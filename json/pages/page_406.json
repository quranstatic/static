{"PageNumber":406,"Verses":[{"SurahNumber":30,"SurahIndex":"030","VerseNumber":16,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَأَمَّا ٱلَّذِينَ كَفَرُواْ وَكَذَّبُواْ بِـَٔايَٰتِنَا وَلِقَآيِٕ ٱلۡأٓخِرَةِ فَأُوْلَـٰٓئِكَ فِي ٱلۡعَذَابِ مُحۡضَرُونَ","TajweedText":"وَأَ<tajweed class=ghunnah>مّ</tajweed>َا <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ كَفَرُو<tajweed class=slnt>اْ</tajweed> وَكَذَّبُو<tajweed class=slnt>اْ</tajweed> بِـَٔـايَ<tajweed class=madda_normal>ـٰ</tajweed>تِنَا وَلِقَآىِٕ <tajweed class=ham_wasl>ٱ</tajweed>لْأَخِرَةِ فَأُ<tajweed class=slnt>وْ</tajweed>لَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ئِكَ فِى <tajweed class=ham_wasl>ٱ</tajweed>لْعَذَابِ مُحْضَر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٦</span>","End":"١٦","PageNumber":406,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":350,"MaqraNumber":162,"HizbNumber":41,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":30,"SurahIndex":"030","VerseNumber":17,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَسُبۡحَٰنَ ٱللَّهِ حِينَ تُمۡسُونَ وَحِينَ تُصۡبِحُونَ","TajweedText":"فَسُ<tajweed class=qalaqah>بْ</tajweed>حَ<tajweed class=madda_normal>ـٰ</tajweed>نَ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ حِينَ تُمْسُونَ وَحِينَ تُصْبِح<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٧</span>","End":"١٧","PageNumber":406,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":350,"MaqraNumber":162,"HizbNumber":41,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":30,"SurahIndex":"030","VerseNumber":18,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَهُ ٱلۡحَمۡدُ فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَعَشِيّٗا وَحِينَ تُظۡهِرُونَ","TajweedText":"وَلَهُ <tajweed class=ham_wasl>ٱ</tajweed>لْحَمْدُ فِى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّمَ<tajweed class=madda_normal>ـٰ</tajweed>و<tajweed class=madda_normal>َٲ</tajweed>تِ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ وَعَشِي<tajweed class=idgham_ghunnah>ًّا و</tajweed>َ