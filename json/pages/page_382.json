ed class=laam_shamsiyah>ل</tajweed>سَّم<tajweed class=madda_obligatory>َا</tajweed>ٓءِ م<tajweed class=madda_obligatory>َا</tajweed>ٓ<tajweed class=ikhafa>ءً ف</tajweed>َأَ<tajweed class=iqlab>نۢب</tajweed>َتْنَا بِه<tajweed class=madda_normal>ِۦ</tajweed> حَد<tajweed class=madda_obligatory>َا</tajweed>ٓئِقَ ذَاتَ بَهْجَ<tajweed class=idgham_ghunnah>ةٍ م</tajweed>َّا كَانَ لَكُمْ أَ<tajweed class=ikhafa>ن ت</tajweed>ُ<tajweed class=iqlab>نۢب</tajweed>ِتُو<tajweed class=slnt>اْ</tajweed> شَجَرَه<tajweed class=madda_obligatory>َآ‌ۗ</tajweed> أَءِلَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>هٌ م</tajweed>َّعَ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ‌ۚ بَلْ هُمْ قَوْ<tajweed class=idgham_ghunnah>مٌ ي</tajweed>َعْدِل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٠</span>","End":"٦٠","PageNumber":382,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":331,"MaqraNumber":153,"HizbNumber":39,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":61,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَمَّن جَعَلَ ٱلۡأَرۡضَ قَرَارٗا وَجَعَلَ خِلَٰلَهَآ أَنۡهَٰرٗا وَجَعَلَ لَهَا رَوَٰسِيَ وَجَعَلَ بَيۡنَ ٱلۡبَحۡرَيۡنِ حَاجِزًاۗ أَءِلَٰهٞ مَّعَ ٱللَّهِۚ بَلۡ أَكۡثَرُهُمۡ لَا يَعۡلَمُونَ","TajweedText":"أَ<tajweed class=ghunnah>مّ</tajweed>َ<tajweed class=ikhafa>ن ج</tajweed>َعَلَ <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضَ قَرَا<tajweed class=idgham_ghunnah>رًا و</tajweed>َجَعَلَ خِلَ<tajweed class=madda_normal>ـٰ</tajweed>لَه<tajweed class=madda_obligatory>َآ</tajweed> أَنْهَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>رًا و</tajweed>َجَعَلَ لَهَا رَو<tajweed class=madda_normal>َٲ</tajweed>سِىَ وَجَعَلَ بَيْنَ <tajweed class=ham_wasl>ٱ</tajweed>لْبَحْرَيْنِ حَاجِزًا‌ۗ أَءِلَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>هٌ م</tajweed>َّعَ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ‌ۚ بَلْ أَكْثَرُهُمْ لَا يَعْلَم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦١</span>","End":"٦١","PageNumber":382,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":331,"MaqraNumber":153,"HizbNumber":39,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":62,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَمَّن يُجِيبُ ٱلۡمُضۡطَرَّ إِذَا دَعَاهُ وَيَكۡشِفُ ٱلسُّوٓءَ وَيَجۡعَلُكُمۡ خُلَفَآءَ ٱلۡأَرۡضِۗ أَءِلَٰهٞ مَّعَ ٱللَّهِۚ قَلِيلٗا مَّا تَذَكَّرُونَ","TajweedText":"أَ<tajweed class=ghunnah>مّ</tajweed><tajweed class=idgham_ghunnah>َن ي</tajweed>ُجِيبُ <tajweed class=ham_wasl>ٱ</tajweed>لْمُضْطَرَّ إِذَا دَعَاهُ وَيَكْشِفُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سّ<tajweed class=madda_obligatory>ُو</tajweed>ٓءَ وَيَ<tajweed class=qalaqah>جْ</tajweed>عَلُكُمْ خُلَف<tajweed class=madda_obligatory>َا</tajweed>ٓءَ <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ‌ۗ أَءِلَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>هٌ م</tajweed>َّعَ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ‌ۚ قَلِيل<tajweed class=idgham_ghunnah>اً م</tajweed>َّا تَذَكَّر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٢</span>","End":"٦٢","PageNumber":382,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":331,"MaqraNumber":153,"HizbNumber":39,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":63,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَمَّن يَهۡدِيكُمۡ فِي ظُلُمَٰتِ ٱلۡبَرِّ وَٱلۡبَحۡرِ وَمَن يُرۡسِلُ ٱلرِّيَٰحَ بُشۡرَۢا بَيۡنَ يَدَيۡ رَحۡمَتِهِۦٓۗ أَءِلَٰهٞ مَّعَ ٱللَّهِۚ تَعَٰلَى ٱللَّهُ عَمَّا يُشۡرِكُونَ","TajweedText":"أَ<tajweed class=ghunnah>مّ</tajweed><tajweed class=idgham_ghunnah>َن ي</tajweed>َهْدِيكُمْ فِى ظُلُمَ<tajweed class=madda_normal>ـٰ</tajweed>تِ <tajweed class=ham_wasl>ٱ</tajweed>لْبَرِّ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْبَحْرِ وَم<tajweed class=idgham_ghunnah>َن ي</tajweed>ُرْسِلُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رِّيَ<tajweed class=madda_norm