{"PageNumber":343,"Verses":[{"SurahNumber":23,"SurahIndex":"023","VerseNumber":18,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَأَنزَلۡنَا مِنَ ٱلسَّمَآءِ مَآءَۢ بِقَدَرٖ فَأَسۡكَنَّـٰهُ فِي ٱلۡأَرۡضِۖ وَإِنَّا عَلَىٰ ذَهَابِۭ بِهِۦ لَقَٰدِرُونَ","TajweedText":"وَأَ<tajweed class=ikhafa>نز</tajweed>َلْنَا مِنَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّم<tajweed class=madda_obligatory>َا</tajweed>ٓءِ م<tajweed class=madda_obligatory>َا</tajweed>ٓ<tajweed class=iqlab>ءَۢ ب</tajweed>ِقَدَ<tajweed class=ikhafa>رٍ ف</tajweed>َأَسْكَ<tajweed class=ghunnah>نّ</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed>هُ فِى <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ‌ۖ وَإِ<tajweed class=ghunnah>نّ</tajweed>َا عَلَىٰ ذَهَا<tajweed class=iqlab>بِۭ ب</tajweed>ِه<tajweed class=madda_normal>ِۦ</tajweed> لَقَ<tajweed class=madda_normal>ـٰ</tajweed>دِر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٨</span>","End":"١٨","PageNumber":343,"JuzNumber":18,"ManzilNumber":4,"RukuNumber":295,"MaqraNumber":137,"HizbNumber":35,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":23,"SurahIndex":"023","VerseNumber":19,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَأَنشَأۡنَا لَكُم بِهِۦ جَنَّـٰتٖ مِّن نَّخِيلٖ وَأَعۡنَٰبٖ لَّكُمۡ فِيهَا فَوَٰكِهُ كَثِيرَةٞ وَمِنۡهَا تَأۡكُلُونَ","TajweedText":"فَأَ<tajweed class=ikhafa>نش</tajweed>َأْنَا لَك<tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِه<tajweed class=madda_normal>ِۦ</tajweed> جَ<tajweed class=ghunnah>نّ</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>تٍ م</tajweed>ّ<tajweed class=idgham_ghunnah>ِن ن</tajweed>َّخِي<tajweed class=idgham_ghunnah>لٍ و</tajweed>َأَعْنَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_wo_ghunnah>بٍ ل</tajweed>َّكُمْ فِيهَا فَو<tajweed class=madda_normal>َٲ</tajweed>كِهُ كَثِيرَ<tajweed class=idgham_ghunnah>ةٌ و</tajweed>َمِنْهَا تَأْكُل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٩</span>","End":"١٩","PageNumber":343,"JuzNumber":18,"ManzilNumber":4,"RukuNumber":295,"MaqraNumber":137,"HizbNumber":35,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":23,"SurahIndex":"023","VerseNumber":20,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَشَجَرَةٗ تَخۡرُجُ مِن طُورِ سَيۡنَآءَ تَنۢبُتُ بِٱلدُّهۡنِ وَصِبۡغٖ لِّلۡأٓكِلِينَ","TajweedText":"وَشَجَرَ<tajweed class=ikhafa>ةً ت</tajweed>َخْرُجُ مِ<tajweed class=ikhafa>ن ط</tajweed>ُورِ سَيْن<tajweed class=madda_obligatory>َا</tajweed>ٓءَ تَ<tajweed class=iqlab>نۢب</tajweed>ُتُ بِ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>دُّهْنِ وَصِ<tajweed class=qalaqah>بْ</tajweed><tajweed class=idgham_wo_ghunnah>غٍ ل</tajweed>ِّلْأَكِل<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٢٠</span>","End":"٢٠","PageNumber":343,"JuzNumber":18,"ManzilNumber":4,"RukuNumber":295,"MaqraNumber":137,"HizbNumber":35,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":23,"SurahIndex":"023","VerseNumber":21,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِنَّ لَكُمۡ فِي ٱلۡأَنۡعَٰمِ لَعِبۡرَةٗۖ نُّسۡقِيكُم مِّمَّا فِي بُطُونِهَا وَلَكُمۡ فِيهَا مَنَٰفِعُ كَثِيرَةٞ وَمِنۡهَا تَأۡكُلُونَ","TajweedText":"وَإِ<tajweed class=ghunnah>نّ</tajweed>َ لَكُمْ فِى <tajweed class=ham_wasl>ٱ</tajweed>لْأَنْعَ<tajweed class=madda_normal>ـٰ</tajweed>مِ لَعِ<tajweed class=qalaqah>بْ</tajweed>رَ<tajweed class=idgham_ghunnah>ةً‌ۖ ن</tajweed>ُّسْقِيك<tajweed class=idgham_shafawi>ُم م</tajweed>ِّ<tajweed class=ghunnah>مّ</tajweed>َا فِى بُطُونِهَا وَلَكُمْ فِيهَا مَنَ<tajweed class=madda_normal>ـٰ</tajweed>فِعُ كَثِيرَ<tajweed class=idgham_ghunnah>ةٌ و</tajweed>َمِنْهَا تَأْكُل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢١</span>","End":"٢١","PageNumber":343,"JuzNumber":18,"ManzilNumber":4,"RukuNumber":295,"MaqraNumber":137,"HizbNumber":35,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":23,"SurahIndex":"023","VerseNumber":22,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَعَلَيۡهَا وَعَلَى ٱلۡفُلۡكِ تُحۡمَلُونَ","TajweedText":"وَعَلَيْهَا وَعَلَى <tajweed class=ham_wasl>ٱ</tajweed>لْفُلْكِ تُحْمَل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٢</span>","End":"٢٢","PageNumber":343,"JuzNumber":18,"ManzilNumber":4,"RukuNumber":295,"MaqraNumber":137,"HizbNumber":35,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":23,"SurahIndex":"023","VerseNumber":23,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَقَدۡ أَرۡسَلۡنَا نُوحًا إِلَىٰ قَوۡمِهِۦ فَقَالَ يَٰقَوۡمِ ٱعۡبُدُواْ ٱللَّهَ مَا لَكُم مِّنۡ إِلَٰهٍ غَيۡرُهُۥٓۚ أَفَلَا تَتَّقُونَ","TajweedText":"وَلَقَ<tajweed class=qalaqah>دْ</tajweed> أَرْسَلْنَا نُوحًا إِلَىٰ قَوْمِه<tajweed class=madda_normal>ِۦ</tajweed> فَقَالَ يَ<tajweed class=madda_normal>ـٰ</tajweed>قَوْمِ <tajweed class=ham_wasl>ٱ</tajweed>عْبُدُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed>للَّهَ مَا لَك<tajweed class=idgham_shafawi>ُم م</tajweed>ِّنْ إِلَ<tajweed class=madda_normal>ـٰ</tajweed>هٍ غَيْرُهُ<tajweed class=madda_obligatory>ۥٓ‌ۖ</tajweed> أَفَلَا تَتَّق<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٣</span>","End":"٢٣","PageNumber":343,"JuzNumber":18,"ManzilNumber":4,"RukuNumber":296,"MaqraNumber":137,"HizbNumber":35,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":23,"SurahIndex":"023","VerseNumber":24,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَقَالَ ٱلۡمَلَؤُاْ ٱلَّذِينَ كَفَرُواْ مِن قَوۡمِهِۦ مَا هَٰذَآ إِلَّا بَشَرٞ مِّثۡلُكُمۡ يُرِيدُ أَن يَتَفَضَّلَ عَلَيۡكُمۡ وَلَوۡ شَآءَ ٱللَّهُ لَأَنزَلَ مَلَـٰٓئِكَةٗ مَّا سَمِعۡنَا بِهَٰذَا فِيٓ ءَابَآئِنَا ٱلۡأَوَّلِينَ","TajweedText":"فَقَالَ <tajweed class=ham_wasl>ٱ</tajweed>لْمَلَؤُ<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ كَفَرُو<tajweed class=slnt>اْ</tajweed> مِ<tajweed class=ikhafa>ن ق</tajweed>َوْمِه<tajweed class=madda_normal>ِۦ</tajweed> مَا هَ<tajweed class=madda_normal>ـٰ</tajweed>ذ<tajweed class=madda_obligatory>َآ</tajweed> إِلَّا بَشَ<tajweed class=idgham_ghunnah>رٌ م</tajweed>ِّثْلُكُمْ يُرِيدُ أ<tajweed class=idgham_ghunnah>َن ي</tajweed>َتَفَضَّلَ عَلَيْكُمْ وَلَوْ ش<tajweed class=madda_obligatory>َا</tajweed>ٓءَ <tajweed class=ham_wasl>ٱ</tajweed>للَّهُ لَأَ<tajweed class=ikhafa>نز</tajweed>َلَ مَلَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ئِكَ<tajweed class=idgham_ghunnah>ةً م</tajweed>َّا سَمِعْنَا بِهَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا ف<tajweed class=madda_obligatory>ِىٓ</tajweed> ءَاب<tajweed class=madda_obligatory>َا</tajweed>ٓئِنَا <tajweed class=ham_wasl>ٱ</tajweed>لْأَوَّل<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٢٤</span>","End":"٢٤","PageNumber":343,"JuzNumber":18,"ManzilNumber":4,"RukuNumber":296,"MaqraNumber":137,"HizbNumber":35,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":23,"SurahIndex":"023","VerseNumber":25,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنۡ هُوَ إِلَّا رَجُلُۢ بِهِۦ جِنَّةٞ فَتَرَبَّصُواْ بِهِۦ حَتَّىٰ حِينٖ","TajweedText":"إِنْ هُوَ إِلَّا رَجُ<tajweed class=iqlab>لُۢ ب</tajweed>ِه<tajweed class=madda_normal>ِۦ</tajweed> جِ<tajweed class=ghunnah>نّ</tajweed>َ<tajweed class=ikhafa>ةٌ ف</tajweed>َتَرَبَّصُو<tajweed class=slnt>اْ</tajweed> بِه<tajweed class=madda_normal>ِۦ</tajweed> حَتَّىٰ ح<tajweed class=madda_permissible>ِي</tajweed>نٍ <span class=end>٢٥</span>","End":"٢٥","PageNumber":343,"JuzNumber":18,"ManzilNumber":4,"RukuNumber":296,"MaqraNumber":137,"HizbNumber":35,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":23,"SurahIndex":"023","VerseNumber":26,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَ رَبِّ ٱنصُرۡنِي بِمَا كَذَّبُونِ","TajweedText":"قَالَ رَبِّ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=ikhafa>نص</tajweed>ُرْنِى بِمَا كَذَّب<tajweed class=madda_permissible>ُو</tajweed>نِ <span class=end>٢٦</span>","End":"٢٦","PageNumber":343,"JuzNumber":18,"ManzilNumber":4,"RukuNumber":296,"MaqraNumber":137,"HizbNumber":35,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":23,"SurahIndex":"023","VerseNumber":27,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَأَوۡحَيۡنَآ إِلَيۡهِ أَنِ ٱصۡنَعِ ٱلۡفُلۡكَ بِأَعۡيُنِنَا وَوَحۡيِنَا فَإِذَا جَآءَ أَمۡرُنَا وَفَارَ ٱلتَّنُّورُ فَٱسۡلُكۡ فِيهَا مِن كُلّٖ زَوۡجَيۡنِ ٱثۡنَيۡنِ وَأَهۡلَكَ إِلَّا مَن سَبَقَ عَلَيۡهِ ٱلۡقَوۡلُ مِنۡهُمۡۖ وَلَا تُخَٰطِبۡنِي فِي ٱلَّذِينَ ظَلَمُوٓاْ إِنَّهُم مُّغۡرَقُونَ","TajweedText":"فَأَوْحَيْن<tajweed class=madda_obligatory>َآ</tajweed> إِلَيْهِ أَنِ <tajweed class=ham_wasl>ٱ</tajweed>صْنَعِ <tajweed class=ham_wasl>ٱ</tajweed>لْفُلْكَ بِأَعْيُنِنَا وَوَحْيِنَا فَإِذَا ج<tajweed class=madda_obligatory>َا</tajweed>ٓءَ أَمْرُنَا وَفَارَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>تَّ<tajweed class=ghunnah>نّ</tajweed>ُورُ‌ۙ فَ<tajweed class=ham_wasl>ٱ</tajweed>سْلُكْ فِيهَا مِ<tajweed class=ikhafa>ن ك</tajweed>ُ<tajweed class=ikhafa>لٍّ ز</tajweed>َوْجَيْنِ <tajweed class=ham_wasl>ٱ</tajweed>ثْنَيْنِ وَأَهْلَكَ إِلَّا مَ<tajweed class=ikhafa>ن س</tajweed>َبَقَ عَلَيْهِ <tajweed class=ham_wasl>ٱ</tajweed>لْقَوْلُ مِنْهُمْ‌ۖ وَلَا تُخَ<tajweed class=madda_normal>ـٰ</tajweed>طِ<tajweed class=qalaqah>بْ</tajweed>نِى فِى <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ ظَلَم<tajweed class=madda_obligatory>ُوٓ<tajweed class=slnt>اْ</tajweed>‌ۖ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َه<tajweed class=idgham_shafawi>ُم م</tajweed>ُّغْرَق<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٧</span>","End":"٢٧","PageNumber":343,"JuzNumber":18,"ManzilNumber":4,"RukuNumber":296,"MaqraNumber":137,"HizbNumber":35,"HizbDecimal":0.0,"HasSajda":false}]}