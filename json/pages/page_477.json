ذِي<tajweed class=ikhafa>رًا ف</tajweed>َأَعْرَضَ أَكْثَرُهُمْ فَهُمْ لَا يَسْمَع<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٤</span>","End":"٤","PageNumber":477,"JuzNumber":24,"ManzilNumber":6,"RukuNumber":413,"MaqraNumber":190,"HizbNumber":48,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":41,"SurahIndex":"041","VerseNumber":5,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَقَالُواْ قُلُوبُنَا فِيٓ أَكِنَّةٖ مِّمَّا تَدۡعُونَآ إِلَيۡهِ وَفِيٓ ءَاذَانِنَا وَقۡرٞ وَمِنۢ بَيۡنِنَا وَبَيۡنِكَ حِجَابٞ فَٱعۡمَلۡ إِنَّنَا عَٰمِلُونَ","TajweedText":"وَقَالُو<tajweed class=slnt>اْ</tajweed> قُلُوبُنَا ف<tajweed class=madda_obligatory>ِىٓ</tajweed> أَكِ<tajweed class=ghunnah>نّ</tajweed>َ<tajweed class=idgham_ghunnah>ةٍ م</tajweed>ِّ<tajweed class=ghunnah>مّ</tajweed>َا تَ<tajweed class=qalaqah>دْ</tajweed>عُون<tajweed class=madda_obligatory>َآ</tajweed> إِلَيْهِ وَف<tajweed class=madda_obligatory>ِىٓ</tajweed> ءَاذَانِنَا وَ<tajweed class=qalaqah>قْ</tajweed><tajweed class=idgham_ghunnah>رٌ و</tajweed>َم<tajweed class=iqlab>ِنۢ ب</tajweed>َيْنِنَا وَبَيْنِكَ حِجَا<tajweed class=ikhafa>بٌ ف</tajweed>َ<tajweed class=ham_wasl>ٱ</tajweed>عْمَلْ إِ<tajweed class=ghunnah>نّ</tajweed>َنَا عَ<tajweed class=madda_normal>ـٰ</tajweed>مِل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٥</span>","End":"٥","PageNumber":477,"JuzNumber":24,"ManzilNumber":6,"RukuNumber":413,"MaqraNumber":190,"HizbNumber":48,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":41,"SurahIndex":"041","VerseNumber":6,"ShowSurahName":false,"ShowBismillah":false,"Text":"قُلۡ إِنَّمَآ أَنَا۠ بَشَرٞ مِّثۡلُكُمۡ يُوحَىٰٓ إِلَيَّ أَنَّمَآ إِلَٰهُكُمۡ إِلَٰهٞ وَٰحِدٞ فَٱسۡتَقِيمُوٓاْ إِلَيۡهِ وَٱسۡتَغۡفِرُوهُۗ وَوَيۡلٞ لِّلۡمُشۡرِكِينَ","TajweedText":"قُلْ إِ<tajweed class=ghunnah>نّ</tajweed>َم<tajweed class=madda_obligatory>َآ</tajweed> أَنَا۟ بَشَ<tajweed class=idgham_ghunnah>رٌ م</tajweed>ِّثْلُكُمْ يُوحَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> إِلَىَّ أَ<tajweed class=ghunnah>نّ</tajweed>َم<tajweed class=madda_obligatory>َآ</tajweed> إِلَ<tajweed class=madda_normal>ـٰ</tajweed>هُكُمْ إِلَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>هٌ و</tajweed><tajweed class=madda_normal>َٲ</tajweed>حِ<tajweed class=ikhafa>دٌ ف</tajweed>َ<tajweed class=ham_wasl>ٱ</tajweed>سْتَقِيم<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> إِلَيْهِ وَ<tajweed class=ham_wasl>ٱ</tajweed>سْتَغْفِرُوهُ‌ۗ وَوَيْ<tajweed class=idgham_wo_ghunnah>لٌ ل</tajweed>ِّلْمُشْرِك<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٦</span>","End":"٦","PageNumber":477,"JuzNumber":24,"ManzilNumber":6,"RukuNumber":413,"MaqraNumber":190,"HizbNumber":48,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":41,"SurahIndex":"041","VerseNumber":7,"ShowSurahName":false,"ShowBismillah":false,"Text":"ٱلَّذِينَ لَا يُؤۡتُونَ ٱلزَّكَوٰةَ وَهُم بِٱلۡأٓخِرَةِ هُمۡ كَٰفِرُونَ","TajweedText":"ٱلَّذِينَ لَا يُؤْتُونَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>زَّكَ<tajweed class=slnt>و</tajweed><tajweed class=madda_normal>ٲ</tajweed>ةَ وَه<tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِ<tajweed class=ham_wasl>ٱ</tajweed>لْأَخِرَةِ هُمْ كَ<tajweed class=madda_normal>ـٰ</tajweed>فِر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٧</span>","End":"٧","PageNumber":477,"JuzNumber":24,"ManzilNumber":6,"RukuNumber":413,"MaqraNumber":190,"HizbNumber":48,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":41,"SurahIndex":"041","VerseNumber":8,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّـٰلِحَٰتِ لَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونٖ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ ءَامَنُو<tajweed class=slnt>اْ</tajweed> وَعَمِلُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>صَّ<tajweed class=madda_normal>ـٰ</tajweed>لِحَ<tajweed class=madda_normal>ـٰ</tajweed>تِ لَهُمْ أَ<tajweed class=qalaqah>جْ</tajweed>رٌ غَيْرُ مَمْن<tajweed class=madda_permissible>ُو</tajweed>نٍ <span class=end>٨</span>","End":"٨","PageNumber":477,"JuzNumber":24,"ManzilNumber":6,"RukuNumber":413,"MaqraNumber":190,"HizbNumber":48,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":41,"SurahIndex":"041","VerseNumber":9,"ShowSurahName":false,"ShowBismillah":false,"Text":"۞قُلۡ أَئِنَّكُمۡ لَتَكۡفُرُونَ بِٱلَّذِي خَلَقَ ٱلۡأَرۡضَ فِي يَوۡمَيۡنِ وَتَجۡعَلُونَ لَهُۥٓ أَندَادٗاۚ ذَٰلِكَ رَبُّ ٱلۡعَٰلَمِينَ","TajweedText":"۞ قُلْ أَئِ<tajweed class=ghunnah>نّ</tajweed>َكُمْ لَتَكْفُرُونَ بِ<tajweed class=ham_wasl>ٱ</tajweed>لَّذِى خَلَقَ <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضَ فِى يَوْمَيْنِ وَتَ<tajweed class=qalaqah>جْ</tajweed>عَلُونَ لَهُ<tajweed class=madda_obligatory>ۥٓ</tajweed> أَ<tajweed class=ikhafa>ند</tajweed>َا<tajweed class=ikhafa>دًا‌ۚ ذ</tajweed><tajweed class=madda_normal>َٲ</tajweed>لِكَ رَبُّ <tajweed class=ham_wasl>ٱ</tajweed>لْعَ<tajweed class=madda_normal>ـٰ</tajweed>لَم<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٩</span>","End":"٩","PageNumber":477,"JuzNumber":24,"ManzilNumber":6,"RukuNumber":414,"MaqraNumber":191,"HizbNumber":48,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":41,"SurahIndex":"041","VerseNumber":10,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَجَعَلَ فِيهَا رَوَٰسِيَ مِن فَوۡقِهَا وَبَٰرَكَ فِيهَا وَقَدَّرَ فِيهَآ أَقۡوَٰتَهَا فِيٓ أَرۡبَعَةِ أَيَّامٖ سَوَآءٗ لِّلسَّآئِلِينَ","TajweedText":"وَجَعَلَ فِيهَا رَو<tajweed class=madda_normal>َٲ</tajweed>سِىَ مِ<tajweed class=ikhafa>ن ف</tajweed>َوْقِهَا وَبَ<tajweed class=madda_normal>ـٰ</tajweed>رَكَ فِيهَا وَقَدَّرَ فِيه<tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=qalaqah>قْ</tajweed>و<tajweed class=madda_normal>َٲ</tajweed>تَهَا ف<tajweed class=madda_obligatory>ِىٓ</tajweed> أَرْبَعَةِ أَيَّا<tajweed class=ikhafa>مٍ س</tajweed>َو<tajweed class=madda_obligatory>َا</tajweed>ٓ<tajweed class=idgham_wo_ghunnah>ءً ل</tajweed>ِّلسّ<tajweed class=madda_obligatory>َا</tajweed>ٓئِل<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٠</span>","End":"١٠","PageNumber":477,"JuzNumber":24,"ManzilNumber":6,"RukuNumber":414,"MaqraNumber":191,"HizbNumber":48,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":41,"SurahIndex":"041","VerseNumber":11,"ShowSurahName":false,"ShowBismillah":false,"Text":"ثُمَّ ٱسۡتَوَىٰٓ إِلَى ٱلسَّمَآءِ وَهِيَ دُخَانٞ فَقَالَ لَهَا وَلِلۡأَرۡضِ ٱئۡتِيَا طَوۡعًا أَوۡ كَرۡهٗا قَالَتَآ أَتَيۡنَا طَآئِعِينَ","TajweedText":"ثُ<tajweed class=ghunnah>مّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>سْتَوَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> إِلَى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّم<tajweed class=madda_obligatory>َا</tajweed>ٓءِ وَهِىَ دُخَا<tajweed class=ikhafa>نٌ ف</tajweed>َقَالَ لَهَا وَلِلْأَرْضِ <tajweed class=ham_wasl>ٱ</tajweed>ئْتِيَا طَوْعًا أَوْ كَرْ<tajweed class=ikhafa>هًا ق</tajweed>َالَت<tajweed class=madda_obligatory>َآ</tajweed> أَتَيْنَا ط<tajweed class=madda_obligatory>َا</tajweed>ٓئِع<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١١</span>","End":"١١","PageNumber":477,"JuzNumber":24,"ManzilNumber":6,"RukuNumber":414,"MaqraNumber":191,"HizbNumber":48,"HizbDecimal":0.5,"HasSajda":false}]}