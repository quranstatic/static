{"PageNumber":312,"Verses":[{"SurahNumber":19,"SurahIndex":"019","VerseNumber":96,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّـٰلِحَٰتِ سَيَجۡعَلُ لَهُمُ ٱلرَّحۡمَٰنُ وُدّٗا","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ ءَامَنُو<tajweed class=slnt>اْ</tajweed> وَعَمِلُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>صَّ<tajweed class=madda_normal>ـٰ</tajweed>لِحَ<tajweed class=madda_normal>ـٰ</tajweed>تِ سَيَ<tajweed class=qalaqah>جْ</tajweed>عَلُ لَهُمُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رَّحْمَ<tajweed class=madda_normal>ـٰ</tajweed>نُ وُدًّا <span class=end>٩٦</span>","End":"٩٦","PageNumber":312,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":269,"MaqraNumber":124,"HizbNumber":31,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":19,"SurahIndex":"019","VerseNumber":97,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَإِنَّمَا يَسَّرۡنَٰهُ بِلِسَانِكَ لِتُبَشِّرَ بِهِ ٱلۡمُتَّقِينَ وَتُنذِرَ بِهِۦ قَوۡمٗا لُّدّٗا","TajweedText":"فَإِ<tajweed class=ghunnah>نّ</tajweed>َمَا يَسَّرْنَ<tajweed class=madda_normal>ـٰ</tajweed>هُ بِلِسَانِكَ لِتُبَشِّرَ بِهِ <tajweed class=ham_wasl>ٱ</tajweed>لْمُتَّقِينَ وَتُ<tajweed class=ikhafa>نذ</tajweed>ِرَ بِه<tajweed class=madda_normal>ِۦ</tajweed> قَوْ<tajweed class=idgham_wo_ghunnah>مًا ل</tajweed>ُّدًّا <span class=end>٩٧</span>","End":"٩٧","PageNumber":312,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":269,"MaqraNumber":124,"HizbNumber":31,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":19,"SurahIndex":"019","VerseNumber":98,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَكَمۡ أَهۡلَكۡنَا قَبۡلَهُم مِّن قَرۡنٍ هَلۡ تُحِسُّ مِنۡهُم مِّنۡ أَحَدٍ أَوۡ تَسۡمَعُ لَهُمۡ رِكۡزَۢا","TajweedText":"وَكَمْ أَهْلَكْنَا قَ<tajweed class=qalaqah>بْ</tajweed>لَه<tajweed class=idgham_shafawi>ُم م</tajweed>ِّ<tajweed class=ikhafa>ن ق</tajweed>َرْنٍ هَلْ تُحِسُّ مِنْه<tajweed class=idgham_shafawi>ُم م</tajweed>ِّنْ أَحَدٍ أَوْ تَسْمَعُ لَهُمْ رِكْزَۢا <span class=end>٩٨</span>","End":"٩٨","PageNumber":312,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":269,"MaqraNumber":124,"HizbNumber":31,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":1,"ShowSurahName":true,"ShowBismillah":true,"Text":"طه","TajweedText":"طه <span class=end>١</span>","End":"١","PageNumber":312,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":270,"MaqraNumber":125,"HizbNumber":32,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":2,"ShowSurahName":false,"ShowBismillah":false,"Text":"مَآ أَنزَلۡنَا عَلَيۡكَ ٱلۡقُرۡءَانَ لِتَشۡقَىٰٓ","TajweedText":"م<tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=ikhafa>نز</tajweed>َلْنَا عَلَيْكَ <tajweed class=ham_wasl>ٱ</tajweed>لْقُرْءَانَ لِتَشْقَىٰٓ <span class=end>٢</span>","End":"٢","PageNumber":312,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":270,"MaqraNumber":125,"HizbNumber":32,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":3,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِلَّا تَذۡكِرَةٗ لِّمَن يَخۡشَىٰ","TajweedText":"إِلَّا تَذْكِرَ<tajweed class=idgham_wo_ghunnah>ةً ل</tajweed>ِّم<tajweed class=idgham_ghunnah>َن ي</tajweed>َخْشَىٰ <span class=end>٣</span>","End":"٣","PageNumber":312,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":270,"MaqraNumber":125,"HizbNumber":32,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":4,"ShowSurahName":false,"ShowBismillah":false,"Text":"تَنزِيلٗا مِّمَّنۡ خَلَقَ ٱلۡأَرۡضَ وَٱلسَّمَٰوَٰتِ ٱلۡعُلَى","TajweedText":"تَ<tajweed class=ikhafa>نز</tajweed>ِيل<tajweed class=idgham_ghunnah>اً م</tajweed>ِّ<tajweed class=ghunnah>مّ</tajweed>َنْ خَلَقَ <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضَ وَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّمَ<tajweed class=madda_normal>ـٰ</tajweed>و<tajweed class=madda_normal>َٲ</tajweed>تِ <tajweed class=ham_wasl>ٱ</tajweed>لْعُلَى <span class=end>٤</span>","End":"٤","PageNumber":312,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":270,"MaqraNumber":125,"HizbNumber":32,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":5,"ShowSurahName":false,"ShowBismillah":false,"Text":"ٱلرَّحۡمَٰنُ عَلَى ٱلۡعَرۡشِ ٱسۡتَوَىٰ","TajweedText":"ٱ<tajweed class=laam_shamsiyah>ل</tajweed>رَّحْمَ<tajweed class=madda_normal>ـٰ</tajweed>نُ عَلَى <tajweed class=ham_wasl>ٱ</tajweed>لْعَرْشِ <tajweed class=ham_wasl>ٱ</tajweed>سْتَوَىٰ <span class=end>٥</span>","End":"٥","PageNumber":312,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":270,"MaqraNumber":125,"HizbNumber":32,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":6,"ShowSurahName":false,"ShowBismillah":false,"Text":"لَهُۥ مَا فِي ٱلسَّمَٰوَٰتِ وَمَا فِي ٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا وَمَا تَحۡتَ ٱلثَّرَىٰ","TajweedText":"لَهُ<tajweed class=madda_normal>ۥ</tajweed> مَا فِى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّمَ<tajweed class=madda_normal>ـٰ</tajweed>و<tajweed class=madda_normal>َٲ</tajweed>تِ وَمَا فِى <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ وَمَا بَيْنَهُمَا وَمَا تَحْتَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>ثَّرَىٰ <span class=end>٦</span>","End":"٦","PageNumber":312,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":270,"MaqraNumber":125,"HizbNumber":32,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":7,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِن تَجۡهَرۡ بِٱلۡقَوۡلِ فَإِنَّهُۥ يَعۡلَمُ ٱلسِّرَّ وَأَخۡفَى","TajweedText":"وَإِ<tajweed class=ikhafa>ن ت</tajweed>َ<tajweed class=qalaqah>جْ</tajweed>هَرْ بِ<tajweed class=ham_wasl>ٱ</tajweed>لْقَوْلِ فَإِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> يَعْلَمُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سِّرَّ وَأَخْفَى <span class=end>٧</span>","End":"٧","PageNumber":312,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":270,"MaqraNumber":125,"HizbNumber":32,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":8,"ShowSurahName":false,"ShowBismillah":false,"Text":"ٱللَّهُ لَآ إِلَٰهَ إِلَّا هُوَۖ لَهُ ٱلۡأَسۡمَآءُ ٱلۡحُسۡنَىٰ","TajweedText":"ٱللَّهُ ل<tajweed class=madda_obligatory>َآ</tajweed> إِلَ<tajweed class=madda_normal>ـٰ</tajweed>هَ إِلَّا هُوَ‌ۖ لَهُ <tajweed class=ham_wasl>ٱ</tajweed>لْأَسْم<tajweed class=madda_obligatory>َا</tajweed>ٓءُ <tajweed class=ham_wasl>ٱ</tajweed>لْحُسْنَىٰ <span class=end>٨</span>","End":"٨","PageNumber":312,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":270,"MaqraNumber":125,"HizbNumber":32,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":9,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَهَلۡ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ","TajweedText":"وَهَلْ أَتَ<tajweed class=madda_normal>ـٰ</tajweed>كَ حَدِيثُ مُوسَىٰٓ <span class=end>٩</span>","End":"٩","PageNumber":312,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":270,"MaqraNumber":125,"HizbNumber":32,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":10,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِذۡ رَءَا نَارٗا فَقَالَ لِأَهۡلِهِ ٱمۡكُثُوٓاْ إِنِّيٓ ءَانَسۡتُ نَارٗا لَّعَلِّيٓ ءَاتِيكُم مِّنۡهَا بِقَبَسٍ أَوۡ أَجِدُ عَلَى ٱلنَّارِ هُدٗى","TajweedText":"إِذْ رَءَا نَا<tajweed class=ikhafa>رًا ف</tajweed>َقَالَ لِأَهْلِهِ <tajweed class=ham_wasl>ٱ</tajweed>مْكُث<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed><tajweed class=madda_obligatory>ِىٓ</tajweed> ءَانَسْتُ نَا<tajweed class=idgham_wo_ghunnah>رًا ل</tajweed>َّعَلّ<tajweed class=madda_obligatory>ِىٓ</tajweed> ءَاتِيك<tajweed class=idgham_shafawi>ُم م</tajweed>ِّنْهَا بِقَبَسٍ أَوْ أَجِدُ عَلَى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َارِ هُدًى <span class=end>١٠</span>","End":"١٠","PageNumber":312,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":270,"MaqraNumber":125,"HizbNumber":32,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":11,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَلَمَّآ أَتَىٰهَا نُودِيَ يَٰمُوسَىٰٓ","TajweedText":"فَلَ<tajweed class=ghunnah>مّ</tajweed><tajweed class=madda_obligatory>َآ</tajweed> أَتَ<tajweed class=madda_normal>ـٰ</tajweed>هَا نُودِىَ يَ<tajweed class=madda_normal>ـٰ</tajweed>مُوسَىٰٓ <span class=end>١١</span>","End":"١١","PageNumber":312,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":270,"MaqraNumber":125,"HizbNumber":32,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":12,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنِّيٓ أَنَا۠ رَبُّكَ فَٱخۡلَعۡ نَعۡلَيۡكَ إِنَّكَ بِٱلۡوَادِ ٱلۡمُقَدَّسِ طُوٗى","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed><tajweed class=madda_obligatory>ِىٓ</tajweed> أَنَا۟ رَبُّكَ فَ<tajweed class=ham_wasl>ٱ</tajweed>خْلَعْ نَعْلَيْكَ‌ۖ إِ<tajweed class=ghunnah>نّ</tajweed>َكَ بِ<tajweed class=ham_wasl>ٱ</tajweed>لْوَادِ <tajweed class=ham_wasl>ٱ</tajweed>لْمُقَدَّسِ طُوًى <span class=end>١٢</span>","End":"١٢","PageNumber":312,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":270,"MaqraNumber":125,"HizbNumber":32,"HizbDecimal":0.0,"HasSajda":false}]}