{"PageNumber":417,"Verses":[{"SurahNumber":32,"SurahIndex":"032","VerseNumber":21,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَنُذِيقَنَّهُم مِّنَ ٱلۡعَذَابِ ٱلۡأَدۡنَىٰ دُونَ ٱلۡعَذَابِ ٱلۡأَكۡبَرِ لَعَلَّهُمۡ يَرۡجِعُونَ","TajweedText":"وَلَنُذِيقَ<tajweed class=ghunnah>نّ</tajweed>َه<tajweed class=idgham_shafawi>ُم م</tajweed>ِّنَ <tajweed class=ham_wasl>ٱ</tajweed>لْعَذَابِ <tajweed class=ham_wasl>ٱ</tajweed>لْأَ<tajweed class=qalaqah>دْ</tajweed>نَىٰ دُونَ <tajweed class=ham_wasl>ٱ</tajweed>لْعَذَابِ <tajweed class=ham_wasl>ٱ</tajweed>لْأَكْبَرِ لَعَلَّهُمْ يَرْجِع<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢١</span>","End":"٢١","PageNumber":417,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":359,"MaqraNumber":166,"HizbNumber":42,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":32,"SurahIndex":"032","VerseNumber":22,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَنۡ أَظۡلَمُ مِمَّن ذُكِّرَ بِـَٔايَٰتِ رَبِّهِۦ ثُمَّ أَعۡرَضَ عَنۡهَآۚ إِنَّا مِنَ ٱلۡمُجۡرِمِينَ مُنتَقِمُونَ","TajweedText":"وَمَنْ أَظْلَمُ مِ<tajweed class=ghunnah>مّ</tajweed>َ<tajweed class=ikhafa>ن ذ</tajweed>ُكِّرَ بِـَٔـايَ<tajweed class=madda_normal>ـٰ</tajweed>تِ رَبِّه<tajweed class=madda_normal>ِۦ</tajweed> ثُ<tajweed class=ghunnah>مّ</tajweed>َ أَعْرَضَ عَنْه<tajweed class=madda_obligatory>َآ‌ۚ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َا مِنَ <tajweed class=ham_wasl>ٱ</tajweed>لْمُ<tajweed class=qalaqah>جْ</tajweed>رِمِينَ مُ<tajweed class=ikhafa>نت</tajweed>َقِم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٢</span>","End":"٢٢","PageNumber":417,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":359,"MaqraNumber":166,"HizbNumber":42,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":32,"SurahIndex":"032","VerseNumber":23,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَقَدۡ ءَاتَيۡنَا مُوسَى ٱلۡكِتَٰبَ فَلَا تَكُن فِي مِرۡيَةٖ مِّن لِّقَآئِهِۦۖ وَجَعَلۡنَٰهُ هُدٗى لِّبَنِيٓ إِسۡرَـٰٓءِيلَ","TajweedText":"وَلَقَ<tajweed class=qalaqah>دْ</tajweed> ءَاتَيْنَا مُوسَى <tajweed class=ham_wasl>ٱ</tajweed>لْكِتَ<tajweed class=madda_normal>ـٰ</tajweed>بَ فَلَا تَكُ<tajweed class=ikhafa>ن ف</tajweed>ِى مِرْيَ<tajweed class=idgham_ghunnah>ةٍ م</tajweed>ّ<tajweed class=idgham_wo_ghunnah>ِن ل</tajweed>ِّق<tajweed class=madda_obligatory>َا</tajweed>ٓئِه<tajweed class=madda_normal>ِۦ‌ۖ</tajweed> وَجَعَلْنَ<tajweed class=madda_normal>ـٰ</tajweed>هُ هُ<tajweed class=idgham_wo_ghunnah>دًى ل</tajweed>ِّبَن<tajweed class=madda_obligatory>ِىٓ</tajweed> إِسْر<tajweed class=madda_obligatory>َٲ</tajweed>ٓء<tajweed class=madda_permissible>ِي</tajweed>لَ <span class=end>٢٣</span>","End":"٢٣","PageNumber":417,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":360,"MaqraNumber":166,"HizbNumber":42,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":32,"SurahIndex":"032","VerseNumber":24,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَجَعَلۡنَا مِنۡهُمۡ أَئِمَّةٗ يَهۡدُونَ بِأَمۡرِنَا لَمَّا صَبَرُواْۖ وَكَانُواْ بِـَٔايَٰتِنَا يُوقِنُونَ","TajweedText":"وَجَعَلْنَا مِنْهُمْ أَئِ<tajweed class=ghunnah>مّ</tajweed>َ<tajweed class=idgham_ghunnah>ةً ي</tajweed>َهْدُونَ بِأَمْرِنَا لَ<tajweed class=ghunnah>مّ</tajweed>َا صَبَرُو<tajweed class=slnt>اْ‌ۖ</tajweed> وَكَانُو<tajweed class=slnt>اْ</tajweed> بِـَٔـايَ<tajweed class=madda_normal>ـٰ</tajweed>تِنَا يُوقِن<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٤</span>","End":"٢٤","PageNumber":417,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":360,"MaqraNumber":166,"HizbNumber":42,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":32,"SurahIndex":"032","VerseNumber":25,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّ رَبَّكَ هُوَ يَفۡصِلُ بَيۡنَهُمۡ يَوۡمَ ٱلۡقِيَٰمَةِ فِيمَا كَانُواْ فِيهِ يَخۡتَلِفُونَ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َ رَبَّكَ هُوَ يَفْصِلُ بَيْنَهُمْ يَوْمَ <tajweed class=ham_wasl>ٱ</tajweed>لْقِيَ<tajweed class=madda_normal>ـٰ</tajweed>مَةِ فِيمَا كَانُو<tajweed class=slnt>اْ</tajweed> فِيهِ يَخْتَلِف<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٥</span>","End":"٢٥","PageNumber":417,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":360,"MaqraNumber":166,"HizbNumber":42,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":32,"SurahIndex":"032","VerseNumber":26,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَوَلَمۡ يَهۡدِ لَهُمۡ كَمۡ أَهۡلَكۡنَا مِن قَبۡلِهِم مِّنَ ٱلۡقُرُونِ يَمۡشُونَ فِي مَسَٰكِنِهِمۡۚ إِنَّ فِي ذَٰلِكَ لَأٓيَٰتٍۚ أَفَلَا يَسۡمَعُونَ","TajweedText":"أَوَلَمْ يَهْدِ لَهُمْ كَمْ أَهْلَكْنَا مِ<tajweed class=ikhafa>ن ق</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>لِه<tajweed class=idgham_shafawi>ِم م</tajweed>ِّنَ <tajweed class=ham_wasl>ٱ</tajweed>لْقُرُونِ يَمْشُونَ فِى مَسَ<tajweed class=madda_normal>ـٰ</tajweed>كِنِهِمْ‌ۚ إِ<tajweed class=ghunnah>نّ</tajweed>َ فِى ذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ لَأَيَ<tajweed class=madda_normal>ـٰ</tajweed>تٍ‌ۖ أَفَلَا يَسْمَع<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٦</span>","End":"٢٦","PageNumber":417,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":360,"MaqraNumber":166,"HizbNumber":42,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":32,"SurahIndex":"032","VerseNumber":27,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَوَلَمۡ يَرَوۡاْ أَنَّا نَسُوقُ ٱلۡمَآءَ إِلَى ٱلۡأَرۡضِ ٱلۡجُرُزِ فَنُخۡرِجُ بِهِۦ زَرۡعٗا تَأۡكُلُ مِنۡهُ أَنۡعَٰمُهُمۡ وَأَنفُسُهُمۡۚ أَفَلَا يُبۡصِرُونَ","TajweedText":"أَوَلَمْ يَرَوْ<tajweed class=slnt>اْ</tajweed> أَ<tajweed class=ghunnah>نّ</tajweed>َا نَسُوقُ <tajweed class=ham_wasl>ٱ</tajweed>لْم<tajweed class=madda_obligatory>َا</tajweed>ٓءَ إِلَى <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ <tajweed class=ham_wasl>ٱ</tajweed>لْجُرُزِ فَنُخْرِجُ بِه<tajweed class=madda_normal>ِۦ</tajweed> زَرْ<tajweed class=ikhafa>عًا ت</tajweed>َأْكُلُ مِنْهُ أَنْعَ<tajweed class=madda_normal>ـٰ</tajweed>مُهُمْ وَأَ<tajweed class=ikhafa>نف</tajweed>ُسُهُمْ‌ۖ أَفَلَا يُ<tajweed class=qalaqah>بْ</tajweed>صِر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٧</span>","End":"٢٧","PageNumber":417,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":360,"MaqraNumber":166,"HizbNumber":42,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":32,"SurahIndex":"032","VerseNumber":28,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَيَقُولُونَ مَتَىٰ هَٰذَا ٱلۡفَتۡحُ إِن كُنتُمۡ صَٰدِقِينَ","TajweedText":"وَيَقُولُونَ مَتَىٰ هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا <tajweed class=ham_wasl>ٱ</tajweed>لْفَتْحُ إِ<tajweed class=ikhafa>ن ك</tajweed>ُ<tajweed class=ikhafa>نت</tajweed>ُمْ صَ<tajweed class=madda_normal>ـٰ</tajweed>دِق<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٢٨</span>","End":"٢٨","PageNumber":417,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":360,"MaqraNumber":166,"HizbNumber":42,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":32,"SurahIndex":"032","VerseNumber":29,"ShowSurahName":false,"ShowBismillah":false,"Text":"قُلۡ يَوۡمَ ٱلۡفَتۡحِ لَا يَنفَعُ ٱلَّذِينَ كَفَرُوٓاْ إِيمَٰنُهُمۡ وَلَا هُمۡ يُنظَرُونَ","TajweedText":"قُلْ يَوْمَ <tajweed class=ham_wasl>ٱ</tajweed>لْفَتْحِ لَا يَ<tajweed class=ikhafa>نف</tajweed>َعُ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ كَفَر<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> إِيمَ<tajweed class=madda_normal>ـٰ</tajweed>نُهُمْ وَلَا هُمْ يُ<tajweed class=ikhafa>نظ</tajweed>َر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٩</span>","End":"٢٩","PageNumber":417,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":360,"MaqraNumber":166,"HizbNumber":42,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":32,"SurahIndex":"032","VerseNumber":30,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَأَعۡرِضۡ عَنۡهُمۡ وَٱنتَظِرۡ إِنَّهُم مُّنتَظِرُونَ","TajweedText":"فَأَعْرِضْ عَنْهُمْ وَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=ikhafa>نت</tajweed>َظِرْ إِ<tajweed class=ghunnah>نّ</tajweed>َه<tajweed class=idgham_shafawi>ُم م</tajweed>ُّ<tajweed class=ikhafa>نت</tajweed>َظِر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣٠</span>","End":"٣٠","PageNumber":417,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":360,"MaqraNumber":166,"HizbNumber":42,"HizbDecimal":0.25,"HasSajda":false}]}