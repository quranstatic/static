{"PageNumber":434,"Verses":[{"SurahNumber":34,"SurahIndex":"034","VerseNumber":49,"ShowSurahName":false,"ShowBismillah":false,"Text":"قُلۡ جَآءَ ٱلۡحَقُّ وَمَا يُبۡدِئُ ٱلۡبَٰطِلُ وَمَا يُعِيدُ","TajweedText":"قُلْ ج<tajweed class=madda_obligatory>َا</tajweed>ٓءَ <tajweed class=ham_wasl>ٱ</tajweed>لْحَقُّ وَمَا يُ<tajweed class=qalaqah>بْ</tajweed>دِئُ <tajweed class=ham_wasl>ٱ</tajweed>لْبَ<tajweed class=madda_normal>ـٰ</tajweed>طِلُ وَمَا يُع<tajweed class=madda_permissible>ِي</tajweed><tajweed class=qalaqah>د</tajweed>ُ <span class=end>٤٩</span>","End":"٤٩","PageNumber":434,"JuzNumber":22,"ManzilNumber":5,"RukuNumber":375,"MaqraNumber":174,"HizbNumber":44,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":34,"SurahIndex":"034","VerseNumber":50,"ShowSurahName":false,"ShowBismillah":false,"Text":"قُلۡ إِن ضَلَلۡتُ فَإِنَّمَآ أَضِلُّ عَلَىٰ نَفۡسِيۖ وَإِنِ ٱهۡتَدَيۡتُ فَبِمَا يُوحِيٓ إِلَيَّ رَبِّيٓۚ إِنَّهُۥ سَمِيعٞ قَرِيبٞ","TajweedText":"قُلْ إِ<tajweed class=ikhafa>ن ض</tajweed>َلَلْتُ فَإِ<tajweed class=ghunnah>نّ</tajweed>َم<tajweed class=madda_obligatory>َآ</tajweed> أَضِلُّ عَلَىٰ نَفْسِىۖ وَإِنِ <tajweed class=ham_wasl>ٱ</tajweed>هْتَدَيْتُ فَبِمَا يُوح<tajweed class=madda_obligatory>ِىٓ</tajweed> إِلَىَّ رَبّ<tajweed class=madda_obligatory>ِىٓۚ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> سَمِي<tajweed class=ikhafa>عٌ ق</tajweed>َر<tajweed class=madda_permissible>ِي</tajweed><tajweed class=qalaqah>ب</tajweed>ٌ <span class=end>٥٠</span>","End":"٥٠","PageNumber":434,"JuzNumber":22,"ManzilNumber":5,"RukuNumber":375,"MaqraNumber":174,"HizbNumber":44,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":34,"SurahIndex":"034","VerseNumber":51,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَوۡ تَرَىٰٓ إِذۡ فَزِعُواْ فَلَا فَوۡتَ وَأُخِذُواْ مِن مَّكَانٖ قَرِيبٖ","TajweedText":"وَلَوْ تَرَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> إِذْ فَزِعُو<tajweed class=slnt>اْ</tajweed> فَلَا فَوْتَ وَأُخِذُو<tajweed class=slnt>اْ</tajweed> م<tajweed class=idgham_ghunnah>ِن م</tajweed>َّكَا<tajweed class=ikhafa>نٍ ق</tajweed>َر<tajweed class=madda_permissible>ِي</tajweed><tajweed class=qalaqah>ب</tajweed>ٍ <span class=end>٥١</span>","End":"٥١","PageNumber":434,"JuzNumber":22,"ManzilNumber":5,"RukuNumber":375,"MaqraNumber":174,"HizbNumber":44,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":34,"SurahIndex":"034","VerseNumber":52,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَقَالُوٓاْ ءَامَنَّا بِهِۦ وَأَنَّىٰ لَهُمُ ٱلتَّنَاوُشُ مِن مَّكَانِۭ بَعِيدٖ","TajweedText":"وَقَال<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> ءَامَ<tajweed class=ghunnah>نّ</tajweed>َا بِه<tajweed class=madda_normal>ِۦ</tajweed> وَأَ<tajweed class=ghunnah>نّ</tajweed>َىٰ لَهُمُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>تَّنَاوُشُ م<tajweed class=idgham_ghunnah>ِن م</tajweed>َّكَا<tajweed class=iqlab>نِۭ ب</tajweed>َع<tajweed class=madda_permissible>ِي</tajweed><tajweed class=qalaqah>د</tajweed>ٍ <span class=end>٥٢</span>","End":"٥٢","PageNumber":434,"JuzNumber":22,"ManzilNumber":5,"RukuNumber":375,"MaqraNumber":174,"HizbNumber":44,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":34,"SurahIndex":"034","VerseNumber":53,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَقَدۡ كَفَرُواْ بِهِۦ مِن قَبۡلُۖ وَيَقۡذِفُونَ بِٱلۡغَيۡبِ مِن مَّكَانِۭ بَعِيدٖ","TajweedText":"وَقَ<tajweed class=qalaqah>دْ</tajweed> كَفَرُو<tajweed class=slnt>اْ</tajweed> بِه<tajweed class=madda_normal>ِۦ</tajweed> مِ<tajweed class=ikhafa>ن ق</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>لُۖ وَيَ<tajweed class=qalaqah>قْ</tajweed>ذِفُونَ بِ<tajweed class=ham_wasl>ٱ</tajweed>لْغَيْبِ م<tajweed class=idgham_ghunnah>ِن م</tajweed>َّكَا<tajweed class=iqlab>نِۭ ب</tajweed>َع<tajweed class=madda_permissible>ِي</tajweed><tajweed class=qalaqah>د</tajweed>ٍ <span class=end>٥٣</span>","End":"٥٣","PageNumber":434,"JuzNumber":22,"ManzilNumber":5,"RukuNumber":375,"MaqraNumber":174,"HizbNumber":44,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":34,"SurahIndex":"034","VerseNumber":54,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَحِيلَ بَيۡنَهُمۡ وَبَيۡنَ مَا يَشۡتَهُونَ كَمَا فُعِلَ بِأَشۡيَاعِهِم مِّن قَبۡلُۚ إِنَّهُمۡ كَانُواْ فِي شَكّٖ مُّرِيبِۭ","TajweedText":"وَحِيلَ بَيْنَهُمْ وَبَيْنَ مَا يَشْتَهُونَ كَمَا فُعِلَ بِأَشْيَاعِه<tajweed class=idgham_shafawi>ِم م</tajweed>ِّ<tajweed class=ikhafa>ن ق</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>لُۚ إِ<tajweed class=ghunnah>نّ</tajweed>َهُمْ كَانُو<tajweed class=slnt>اْ</tajweed> فِى شَ<tajweed class=idgham_ghunnah>كٍّ م</tajweed>ُّر<tajweed class=madda_permissible>ِي</tajweed><tajweed class=qalaqah>ب</tajweed>ِۭ <span class=end>٥٤</span>","End":"٥٤","PageNumber":434,"JuzNumber":22,"ManzilNumber":5,"RukuNumber":375,"MaqraNumber":174,"HizbNumber":44,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":35,"SurahIndex":"035","VerseNumber":1,"ShowSurahName":true,"ShowBismillah":true,"Text":"ٱلۡحَمۡدُ لِلَّهِ فَاطِرِ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ جَاعِلِ ٱلۡمَلَـٰٓئِكَةِ رُسُلًا أُوْلِيٓ أَجۡنِحَةٖ مَّثۡنَىٰ وَثُلَٰثَ وَرُبَٰعَۚ يَزِيدُ فِي ٱلۡخَلۡقِ مَا يَشَآءُۚ إِنَّ ٱللَّهَ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٞ","TajweedText":"ٱلْحَمْدُ لِلَّهِ فَاطِرِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّمَ<tajweed class=madda_normal>ـٰ</tajweed>و<tajweed class=madda_normal>َٲ</tajweed>تِ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ جَاعِلِ <tajweed class=ham_wasl>ٱ</tajweed>لْمَلَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ئِكَةِ رُسُلاً أُ<tajweed class=slnt>وْ</tajweed>ل<tajweed class=madda_obligatory>ِىٓ</tajweed> أَ<tajweed class=qalaqah>جْ</tajweed>نِحَ<tajweed class=idgham_ghunnah>ةٍ م</tajweed>َّثْنَىٰ وَثُلَ<tajweed class=madda_normal>ـٰ</tajweed>ثَ وَرُبَ<tajweed class=madda_normal>ـٰ</tajweed>عَۚ يَزِيدُ فِى <tajweed class=ham_wasl>ٱ</tajweed>لْخَلْقِ مَا يَش<tajweed class=madda_obligatory>َا</tajweed>ٓءُۚ إِ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>للَّهَ عَلَىٰ كُلِّ ش<tajweed class=ikhafa>َىْءٍ ق</tajweed>َد<tajweed class=madda_permissible>ِي</tajweed>رٌ <span class=end>١</span>","End":"١","PageNumber":434,"JuzNumber":22,"ManzilNumber":5,"RukuNumber":376,"MaqraNumber":174,"HizbNumber":44,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":35,"SurahIndex":"035","VerseNumber":2,"ShowSurahName":false,"ShowBismillah":false,"Text":"مَّا يَفۡتَحِ ٱللَّهُ لِلنَّاسِ مِن رَّحۡمَةٖ فَلَا مُمۡسِكَ لَهَاۖ وَمَا يُمۡسِكۡ فَلَا مُرۡسِلَ لَهُۥ مِنۢ بَعۡدِهِۦۚ وَهُوَ ٱلۡعَزِيزُ ٱلۡحَكِيمُ","TajweedText":"مَّا يَفْتَحِ <tajweed class=ham_wasl>ٱ</tajweed>للَّهُ لِل<tajweed class=ghunnah>نّ</tajweed>َاسِ م<tajweed class=idgham_wo_ghunnah>ِن ر</tajweed>َّحْمَ<tajweed class=ikhafa>ةٍ ف</tajweed>َلَا مُمْسِكَ لَهَاۖ وَمَا يُمْسِكْ فَلَا مُرْسِلَ لَهُ<tajweed class=madda_normal>ۥ</tajweed> م<tajweed class=iqlab>ِنۢ ب</tajweed>َعْدِهِ<tajweed class=madda_normal>ۚۦ</tajweed> وَهُوَ <tajweed class=ham_wasl>ٱ</tajweed>لْعَزِيزُ <tajweed class=ham_wasl>ٱ</tajweed>لْحَك<tajweed class=madda_permissible>ِي</tajweed>مُ <span class=end>٢</span>","End":"٢","PageNumber":434,"JuzNumber":22,"ManzilNumber":5,"RukuNumber":376,"MaqraNumber":174,"HizbNumber":44,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":35,"SurahIndex":"035","VerseNumber":3,"ShowSurahName":false,"ShowBismillah":false,"Text":"يَـٰٓأَيُّهَا ٱلنَّاسُ ٱذۡكُرُواْ نِعۡمَتَ ٱللَّهِ عَلَيۡكُمۡۚ هَلۡ مِنۡ خَٰلِقٍ غَيۡرُ ٱللَّهِ يَرۡزُقُكُم مِّنَ ٱلسَّمَآءِ وَٱلۡأَرۡضِۚ لَآ إِلَٰهَ إِلَّا هُوَۖ فَأَنَّىٰ تُؤۡفَكُونَ","TajweedText":"يَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>أَيُّهَا <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َاسُ <tajweed class=ham_wasl>ٱ</tajweed>ذْكُرُو<tajweed class=slnt>اْ</tajweed> نِعْمَتَ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ عَلَيْكُمْۚ هَلْ مِنْ خَ<tajweed class=madda_normal>ـٰ</tajweed>لِقٍ غَيْرُ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ يَرْزُقُك