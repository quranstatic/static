{"PageNumber":385,"Verses":[{"SurahNumber":27,"SurahIndex":"027","VerseNumber":89,"ShowSurahName":false,"ShowBismillah":false,"Text":"مَن جَآءَ بِٱلۡحَسَنَةِ فَلَهُۥ خَيۡرٞ مِّنۡهَا وَهُم مِّن فَزَعٖ يَوۡمَئِذٍ ءَامِنُونَ","TajweedText":"مَ<tajweed class=ikhafa>ن ج</tajweed><tajweed class=madda_obligatory>َا</tajweed>ٓءَ بِ<tajweed class=ham_wasl>ٱ</tajweed>لْحَسَنَةِ فَلَهُ<tajweed class=madda_normal>ۥ</tajweed> خَيْ<tajweed class=idgham_ghunnah>رٌ م</tajweed>ِّنْهَا وَه<tajweed class=idgham_shafawi>ُم م</tajweed>ِّ<tajweed class=ikhafa>ن ف</tajweed>َزَ<tajweed class=idgham_ghunnah>عٍ ي</tajweed>َوْمَئِذٍ ءَامِن<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٨٩</span>","End":"٨٩","PageNumber":385,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":333,"MaqraNumber":154,"HizbNumber":39,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":90,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَن جَآءَ بِٱلسَّيِّئَةِ فَكُبَّتۡ وُجُوهُهُمۡ فِي ٱلنَّارِ هَلۡ تُجۡزَوۡنَ إِلَّا مَا كُنتُمۡ تَعۡمَلُونَ","TajweedText":"وَمَ<tajweed class=ikhafa>ن ج</tajweed><tajweed class=madda_obligatory>َا</tajweed>ٓءَ بِ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّيِّئَةِ فَكُبَّتْ وُجُوهُهُمْ فِى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َارِ هَلْ تُ<tajweed class=qalaqah>جْ</tajweed>زَوْنَ إِلَّا مَا كُ<tajweed class=ikhafa>نت</tajweed>ُمْ تَعْمَل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٩٠</span>","End":"٩٠","PageNumber":385,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":333,"MaqraNumber":154,"HizbNumber":39,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":91,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّمَآ أُمِرۡتُ أَنۡ أَعۡبُدَ رَبَّ هَٰذِهِ ٱلۡبَلۡدَةِ ٱلَّذِي حَرَّمَهَا وَلَهُۥ كُلُّ شَيۡءٖۖ وَأُمِرۡتُ أَنۡ أَكُونَ مِنَ ٱلۡمُسۡلِمِينَ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َم<tajweed class=madda_obligatory>َآ</tajweed> أُمِرْتُ أَنْ أَعْبُدَ رَبَّ هَ<tajweed class=madda_normal>ـٰ</tajweed>ذِهِ <tajweed class=ham_wasl>ٱ</tajweed>لْبَلْدَةِ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى حَرَّمَهَا وَلَهُ<tajweed class=madda_normal>ۥ</tajweed> كُلُّ ش<tajweed class=idgham_ghunnah>َىْءٍ‌ۖ و</tajweed>َأُمِرْتُ أَنْ أَكُونَ مِنَ <tajweed class=ham_wasl>ٱ</tajweed>لْمُسْلِم<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٩١</span>","End":"٩١","PageNumber":385,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":333,"MaqraNumber":154,"HizbNumber":39,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":92,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَأَنۡ أَتۡلُوَاْ ٱلۡقُرۡءَانَۖ فَمَنِ ٱهۡتَدَىٰ فَإِنَّمَا يَهۡتَدِي لِنَفۡسِهِۦۖ وَمَن ضَلَّ فَقُلۡ إِنَّمَآ أَنَا۠ مِنَ ٱلۡمُنذِرِينَ","TajweedText":"وَأَنْ أَتْلُوَ<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed>لْقُرْءَانَ‌ۖ فَمَنِ <tajweed class=ham_wasl>ٱ</tajweed>هْتَدَىٰ فَإِ<tajweed class=ghunnah>نّ</tajweed>َمَا يَهْتَدِى لِنَفْسِه<tajweed class=madda_normal>ِۦ</tajweed>‌ۖ وَمَ<tajweed class=ikhafa>ن ض</tajweed>َلَّ فَقُلْ إِ<tajweed class=ghunnah>نّ</tajweed>َم<tajweed class=madda_obligatory>َآ</tajweed> أَنَا۟ مِنَ <tajweed class=ham_wasl>ٱ</tajweed>لْمُ<tajweed class=ikhafa>نذ</tajweed>ِر<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٩٢</span>","End":"٩٢","PageNumber":385,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":333,"MaqraNumber":154,"HizbNumber":39,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":93,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَقُلِ ٱلۡحَمۡدُ لِلَّهِ سَيُرِيكُمۡ ءَايَٰتِهِۦ فَتَعۡرِفُونَهَاۚ وَمَا رَبُّكَ بِغَٰفِلٍ عَمَّا تَعۡمَلُونَ","TajweedText":"وَقُلِ <tajweed class=ham_wasl>ٱ</tajweed>لْحَمْدُ لِلَّهِ سَيُرِيكُمْ ءَايَ<tajweed class=madda_normal>ـٰ</tajweed>تِه<tajweed class=madda_normal>ِۦ</tajweed> فَتَعْرِفُونَهَا‌ۚ وَمَا رَبُّكَ بِغَ<tajweed class=madda_normal>ـٰ</tajweed>فِلٍ عَ<tajweed class=ghunnah>مّ</tajweed>َا تَعْمَل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٩٣</span>","End":"٩٣","PageNumber":385,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":333,"MaqraNumber":154,"HizbNumber":39,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":28,"SurahIndex":"028","VerseNumber":1,"ShowSurahName":true,"ShowBismillah":true,"Text":"طسٓمٓ","TajweedText":"ط<tajweed class=madda_necessary>سٓ</tajweed><tajweed class=madda_necessary>مٓ</tajweed> <span class=end>١</span>","End":"١","PageNumber":385,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":334,"MaqraNumber":154,"HizbNumber":39,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":28,"SurahIndex":"028","VerseNumber":2,"ShowSurahName":false,"ShowBismillah":false,"Text":"تِلۡكَ ءَايَٰتُ ٱلۡكِتَٰبِ ٱلۡمُبِينِ","TajweedText":"تِلْكَ ءَايَ<tajweed class=madda_normal>ـٰ</tajweed>تُ <tajweed class=ham_wasl>ٱ</tajweed>لْكِتَ<tajweed class=madda_normal>ـٰ</tajweed>بِ <tajweed class=ham_wasl>ٱ</tajweed>لْمُب<tajweed class=madda_permissible>ِي</tajweed>نِ <span class=end>٢</span>","End":"٢","PageNumber":385,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":334,"MaqraNumber":154,"HizbNumber":39,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":28,"SurahIndex":"028","VerseNumber":3,"ShowSurahName":false,"ShowBismillah":false,"Text":"نَتۡلُواْ عَلَيۡكَ مِن نَّبَإِ مُوسَىٰ وَفِرۡعَوۡنَ بِٱلۡحَقِّ لِقَوۡمٖ يُؤۡمِنُونَ","TajweedText":"نَتْلُو<tajweed class=slnt>اْ</tajweed> عَلَيْكَ م<tajweed class=idgham_ghunnah>ِن ن</tajweed>َّبَإِ مُوسَىٰ وَفِرْعَوْنَ بِ<tajweed class=ham_wasl>ٱ</tajweed>لْحَقِّ لِقَوْ<tajweed class=idgham_ghunnah>مٍ ي</tajweed>ُؤْمِن<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣</span>","End":"٣","PageNumber":385,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":334,"MaqraNumber":154,"HizbNumber":39,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":28,"SurahIndex":"028","VerseNumber":4,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّ فِرۡعَوۡنَ عَلَا فِي ٱلۡأَرۡضِ وَجَعَلَ أَهۡلَهَا شِيَعٗا يَسۡتَضۡعِفُ طَآئِفَةٗ مِّنۡهُمۡ يُذَبِّحُ أَبۡنَآءَهُمۡ وَيَسۡتَحۡيِۦ نِسَآءَهُمۡۚ إِنَّهُۥ كَانَ مِنَ ٱلۡمُفۡسِدِينَ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َ فِرْعَوْنَ عَلَا فِى <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ وَجَعَلَ أَهْلَهَا شِيَ<tajweed class=idgham_ghunnah>عًا ي</tajweed>َسْتَضْعِفُ ط<tajweed class=madda_obligatory>َا</tajweed>ٓئِفَ<tajweed class=idgham_ghunnah>ةً م</tajweed>ِّنْهُمْ يُذَبِّحُ أَ<tajweed class=qalaqah>بْ</tajweed>ن<tajweed class=madda_obligatory>َا</tajweed>ٓءَهُمْ وَيَسْتَحْى<tajweed class=madda_normal>ِۦ</tajweed> نِس<tajweed class=madda_obligatory>َا</tajweed>ٓءَهُمْ‌ۚ إِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> كَانَ مِنَ <tajweed class=ham_wasl>ٱ</tajweed>لْمُفْسِد<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٤</span>","End":"٤","PageNumber":385,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":334,"MaqraNumber":154,"HizbNumber":39,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":28,"SurahIndex":"028","VerseNumber":5,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَنُرِيدُ أَن نَّمُنَّ عَلَى ٱلَّذِينَ ٱسۡتُضۡعِفُواْ فِي ٱلۡأَرۡضِ وَنَجۡعَلَهُمۡ أَئِمَّةٗ وَنَجۡعَلَهُمُ ٱلۡوَٰرِثِينَ","TajweedText":"وَنُرِيدُ أ<tajweed class=idgham_ghunnah>َن ن</tajweed>َّمُ<tajweed class=ghunnah>نّ</tajweed>َ عَلَى <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ <tajweed class=ham_wasl>ٱ</tajweed>سْتُضْعِفُو<tajweed class=slnt>اْ</tajweed> فِى <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ وَنَ<tajweed class=qalaqah>جْ</tajweed>عَلَهُمْ أَئِ<tajweed class=ghunnah>مّ</tajweed>َ<tajweed class=idgham_ghunnah>ةً و</tajweed>َنَ<tajweed class=qalaqah>جْ</tajweed>عَلَهُمُ <tajweed class=ham_wasl>ٱ</tajweed>لْو<tajweed class=madda_normal>َٲ</tajweed>رِث<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٥</span>","End":"٥","PageNumber":385,"JuzNumber":20,"Man