ss=madda_obligatory>َآ</tajweed> أُرْسِلَ <tajweed class=ham_wasl>ٱ</tajweed>لْأَوَّل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٥</span>","End":"٥","PageNumber":322,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":278,"MaqraNumber":129,"HizbNumber":33,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":6,"ShowSurahName":false,"ShowBismillah":false,"Text":"مَآ ءَامَنَتۡ قَبۡلَهُم مِّن قَرۡيَةٍ أَهۡلَكۡنَٰهَآۖ أَفَهُمۡ يُؤۡمِنُونَ","TajweedText":"م<tajweed class=madda_obligatory>َآ</tajweed> ءَامَنَتْ قَ<tajweed class=qalaqah>بْ</tajweed>لَه<tajweed class=idgham_shafawi>ُم م</tajweed>ِّ<tajweed class=ikhafa>ن ق</tajweed>َرْيَةٍ أَهْلَكْنَ<tajweed class=madda_normal>ـٰ</tajweed>ه<tajweed class=madda_obligatory>َآ‌ۖ</tajweed> أَفَهُمْ يُؤْمِن<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦</span>","End":"٦","PageNumber":322,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":278,"MaqraNumber":129,"HizbNumber":33,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":7,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَآ أَرۡسَلۡنَا قَبۡلَكَ إِلَّا رِجَالٗا نُّوحِيٓ إِلَيۡهِمۡۖ فَسۡـَٔلُوٓاْ أَهۡلَ ٱلذِّكۡرِ إِن كُنتُمۡ لَا تَعۡلَمُونَ","TajweedText":"وَم<tajweed class=madda_obligatory>َآ</tajweed> أَرْسَلْنَا قَ<tajweed class=qalaqah>بْ</tajweed>لَكَ إِلَّا رِجَال<tajweed class=idgham_ghunnah>اً ن</tajweed>ُّوح<tajweed class=madda_obligatory>ِىٓ</tajweed> إِلَيْهِمْ‌ۖ فَسْــَٔل<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> أَهْلَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>ذِّكْرِ إِ<tajweed class=ikhafa>ن ك</tajweed>ُ<tajweed class=ikhafa>نت</tajweed>ُمْ لَا تَعْلَم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٧</span>","End":"٧","PageNumber":322,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":278,"MaqraNumber":129,"HizbNumber":33,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":8,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَا جَعَلۡنَٰهُمۡ جَسَدٗا لَّا يَأۡكُلُونَ ٱلطَّعَامَ وَمَا كَانُواْ خَٰلِدِينَ","TajweedText":"وَمَا جَعَلْنَ<tajweed class=madda_normal>ـٰ</tajweed>هُمْ جَسَ<tajweed class=idgham_wo_ghunnah>دًا ل</tajweed>َّا يَأْكُلُونَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>طَّعَامَ وَمَا كَانُو<tajweed class=slnt>اْ</tajweed> خَ<tajweed class=madda_normal>ـٰ</tajweed>لِد<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٨</span>","End":"٨","PageNumber":322,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":278,"MaqraNumber":129,"HizbNumber":33,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":9,"ShowSurahName":false,"ShowBismillah":false,"Text":"ثُمَّ صَدَقۡنَٰهُمُ ٱلۡوَعۡدَ فَأَنجَيۡنَٰهُمۡ وَمَن نَّشَآءُ وَأَهۡلَكۡنَا ٱلۡمُسۡرِفِينَ","TajweedText":"ثُ<tajweed class=ghunnah>مّ</tajweed>َ صَدَ<tajweed class=qalaqah>قْ</tajweed>نَ<tajweed class=madda_normal>ـٰ</tajweed>هُمُ <tajweed class=ham_wasl>ٱ</tajweed>لْوَعْدَ فَأَ<tajweed class=ikhafa>نج</tajweed>َيْنَ<tajweed class=madda_normal>ـٰ</tajweed>هُمْ وَم<tajweed class=idgham_ghunnah>َن ن</tajweed>َّش<tajweed class=madda_obligatory>َا</tajweed>ٓءُ وَأَهْلَكْنَا <tajweed class=ham_wasl>ٱ</tajweed>لْمُسْرِف<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٩</span>","End":"٩","PageNumber":322,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":278,"MaqraNumber":129,"HizbNumber":33,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":10,"ShowSurahName":false,"ShowBismillah":false,"Text":"لَقَدۡ أَنزَلۡنَآ إِلَيۡكُمۡ كِتَٰبٗا فِيهِ ذِكۡرُكُمۡۚ أَفَلَا تَعۡقِلُونَ","TajweedText":"لَقَ<tajweed class=qalaqah>دْ</tajweed> أَ<tajweed class=ikhafa>نز</tajweed>َلْن<tajweed class=madda_obligatory>َآ</tajweed> إِلَيْكُمْ كِتَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=ikhafa>بًا ف</tajweed>ِيهِ ذِكْرُكُمْ‌ۖ أَفَلَا تَعْقِل<