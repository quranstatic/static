{"PageNumber":570,"Verses":[{"SurahNumber":70,"SurahIndex":"070","VerseNumber":40,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَلَآ أُقۡسِمُ بِرَبِّ ٱلۡمَشَٰرِقِ وَٱلۡمَغَٰرِبِ إِنَّا لَقَٰدِرُونَ","TajweedText":"فَل<tajweed class=madda_obligatory>َآ</tajweed> أُ<tajweed class=qalaqah>قْ</tajweed>سِمُ بِرَبِّ <tajweed class=ham_wasl>ٱ</tajweed>لْمَشَ<tajweed class=madda_normal>ـٰ</tajweed>رِقِ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْمَغَ<tajweed class=madda_normal>ـٰ</tajweed>رِبِ إِ<tajweed class=ghunnah>نّ</tajweed>َا لَقَ<tajweed class=madda_normal>ـٰ</tajweed>دِر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٤٠</span>","End":"٤٠","PageNumber":570,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":503,"MaqraNumber":228,"HizbNumber":57,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":70,"SurahIndex":"070","VerseNumber":41,"ShowSurahName":false,"ShowBismillah":false,"Text":"عَلَىٰٓ أَن نُّبَدِّلَ خَيۡرٗا مِّنۡهُمۡ وَمَا نَحۡنُ بِمَسۡبُوقِينَ","TajweedText":"عَلَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> أ<tajweed class=idgham_ghunnah>َن ن</tajweed>ُّبَدِّلَ خَيْ<tajweed class=idgham_ghunnah>رًا م</tajweed>ِّنْهُمْ وَمَا نَحْنُ بِمَسْبُوق<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٤١</span>","End":"٤١","PageNumber":570,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":503,"MaqraNumber":228,"HizbNumber":57,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":70,"SurahIndex":"070","VerseNumber":42,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَذَرۡهُمۡ يَخُوضُواْ وَيَلۡعَبُواْ حَتَّىٰ يُلَٰقُواْ يَوۡمَهُمُ ٱلَّذِي يُوعَدُونَ","TajweedText":"فَذَرْهُمْ يَخُوضُو<tajweed class=slnt>اْ</tajweed> وَيَلْعَبُو<tajweed class=slnt>اْ</tajweed> حَتَّىٰ يُلَ<tajweed class=madda_normal>ـٰ</tajweed>قُو<tajweed class=slnt>اْ</tajweed> يَوْمَهُمُ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى يُوعَد<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٤٢</span>","End":"٤٢","PageNumber":570,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":503,"MaqraNumber":228,"HizbNumber":57,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":70,"SurahIndex":"070","VerseNumber":43,"ShowSurahName":false,"ShowBismillah":false,"Text":"يَوۡمَ يَخۡرُجُونَ مِنَ ٱلۡأَجۡدَاثِ سِرَاعٗا كَأَنَّهُمۡ إِلَىٰ نُصُبٖ يُوفِضُونَ","TajweedText":"يَوْمَ يَخْرُجُونَ مِنَ <tajweed class=ham_wasl>ٱ</tajweed>لْأَ<tajweed class=qalaqah>جْ</tajweed>دَاثِ سِرَا<tajweed class=ikhafa>عًا ك</tajweed>َأَ<tajweed class=ghunnah>نّ</tajweed>َهُمْ إِلَىٰ نُصُ<tajweed class=idgham_ghunnah>بٍ ي</tajweed>ُوفِض<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٤٣</span>","End":"٤٣","PageNumber":570,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":503,"MaqraNumber":228,"HizbNumber":57,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":70,"SurahIndex":"070","VerseNumber":44,"ShowSurahName":false,"ShowBismillah":false,"Text":"خَٰشِعَةً أَبۡصَٰرُهُمۡ تَرۡهَقُهُمۡ ذِلَّةٞۚ ذَٰلِكَ ٱلۡيَوۡمُ ٱلَّذِي كَانُواْ يُوعَدُونَ","TajweedText":"خَ<tajweed class=madda_normal>ـٰ</tajweed>شِعَةً أَ<tajweed class=qalaqah>بْ</tajweed>صَ<tajweed class=madda_normal>ـٰ</tajweed>رُهُمْ تَرْهَقُهُمْ ذِلَّ<tajweed class=ikhafa>ةٌ‌ۚ ذ</tajweed><tajweed class=madda_normal>َٲ</tajweed>لِكَ <tajweed class=ham_wasl>ٱ</tajweed>لْيَوْمُ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى كَانُو<tajweed class=slnt>اْ</tajweed> يُوعَد<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٤٤</span>","End":"٤٤","PageNumber":570,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":503,"MaqraNumber":228,"HizbNumber":57,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":71,"SurahIndex":"071","VerseNumber":1,"ShowSurahName":true,"ShowBismillah":true,"Text":"إِنَّآ أَرۡسَلۡنَا نُوحًا إِلَىٰ قَوۡمِهِۦٓ أَنۡ أَنذِرۡ قَوۡمَكَ مِن قَبۡلِ أَن يَأۡتِيَهُمۡ عَذَابٌ أَلِيمٞ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed><tajweed class=madda_obligatory>َآ</tajweed> أَرْسَلْنَا نُوحًا إِلَىٰ قَوْمِه<tajweed class=madda_obligatory>ِۦٓ</tajweed> أَنْ أَ<tajweed class=ikhafa>نذ</tajweed>ِرْ قَوْمَكَ مِ<tajweed class=ikhafa>ن ق</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>لِ أ<tajweed class=idgham_ghunnah>َن ي</tajweed>َأْتِيَهُمْ عَذَابٌ أَل<tajweed class=madda_permissible>ِي</tajweed>مٌ <span class=end>١</span>","End":"١","PageNumber":570,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":504,"MaqraNumber":228,"HizbNumber":57,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":71,"SurahIndex":"071","VerseNumber":2,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَ يَٰقَوۡمِ إِنِّي لَكُمۡ نَذِيرٞ مُّبِينٌ","TajweedText":"قَالَ يَ<tajweed class=madda_normal>ـٰ</tajweed>قَوْمِ إِ<tajweed class=ghunnah>نّ</tajweed>ِى لَكُمْ نَذِي<tajweed class=idgham_ghunnah>رٌ م</tajweed>ُّب<tajweed class=madda_permissible>ِي</tajweed>نٌ <span class=end>٢</span>","End":"٢","PageNumber":570,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":504,"MaqraNumber":228,"HizbNumber":57,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":71,"SurahIndex":"071","VerseNumber":3,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَنِ ٱعۡبُدُواْ ٱللَّهَ وَٱتَّقُوهُ وَأَطِيعُونِ","TajweedText":"أَنِ <tajweed class=ham_wasl>ٱ</tajweed>عْبُدُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed>للَّهَ وَ<tajweed class=ham_wasl>ٱ</tajweed>تَّقُوهُ وَأَطِيع<tajweed class=madda_permissible>ُو</tajweed>نِ <span class=end>٣</span>","End":"٣","PageNumber":570,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":504,"MaqraNumber":228,"HizbNumber":57,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":71,"SurahIndex":"071","VerseNumber":4,"ShowSurahName":false,"ShowBismillah":false,"Text":"يَغۡفِرۡ لَكُم مِّن ذُنُوبِكُمۡ وَيُؤَخِّرۡكُمۡ إِلَىٰٓ أَجَلٖ مُّسَمًّىۚ إِنَّ أَجَلَ ٱللَّهِ إِذَا جَآءَ لَا يُؤَخَّرُۚ لَوۡ كُنتُمۡ تَعۡلَمُونَ","TajweedText":"يَغْفِرْ لَك<tajweed class=idgham_shafawi>ُم م</tajweed>ِّ<tajweed class=ikhafa>ن ذ</tajweed>ُنُوبِكُمْ وَيُؤَخِّرْكُمْ إِلَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> أَجَ<tajweed class=idgham_ghunnah>لٍ م</tajweed>ُّسَ<tajweed class=ghunnah>مّ</tajweed>ًى‌ۚ إِ<tajweed class=ghunnah>نّ</tajweed>َ أَجَلَ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ إِذَا ج<tajweed class=madda_obligatory>َا</tajweed>ٓءَ لَا يُؤَخَّرُ‌ۖ لَوْ كُ<tajweed class=ikhafa>نت</tajweed>ُمْ تَعْلَم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٤</span>","End":"٤","PageNumber":570,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":504,"MaqraNumber":228,"HizbNumber":57,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":71,"SurahIndex":"071","VerseNumber":5,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَ رَبِّ إِنِّي دَعَوۡتُ قَوۡمِي لَيۡلٗا وَنَهَارٗا","TajweedText":"قَالَ رَبِّ إِ<tajweed class=ghunnah>نّ</tajweed>ِى دَعَوْتُ قَوْمِى لَيْل<tajweed class=idgham_ghunnah>اً و</tajweed>َنَهَارًا <span class=end>٥</span>","End":"٥","PageNumber":570,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":504,"MaqraNumber":228,"HizbNumber":57,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":71,"SurahIndex":"071","VerseNumber":6,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَلَمۡ يَزِدۡهُمۡ دُعَآءِيٓ إِلَّا فِرَارٗا","TajweedText":"فَلَمْ يَزِ<tajweed class=qalaqah>دْ</tajweed>هُمْ دُع<tajweed class=madda_obligatory>َا</tajweed>ٓء<tajweed class=madda_obligatory>ِىٓ</tajweed> إِلَّا فِرَارًا <span class=end>٦</span>","End":"٦","PageNumber":570,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":504,"MaqraNumber":228,"HizbNumber":57,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":71,"SurahIndex":"071","VerseNumber":7,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِنِّي كُلَّمَا دَعَوۡتُهُمۡ لِتَغۡفِرَ لَهُمۡ جَعَلُوٓاْ أَصَٰبِعَهُمۡ فِيٓ ءَاذَانِهِمۡ وَٱسۡتَغۡشَوۡاْ ثِيَابَهُمۡ وَأَصَرُّواْ وَٱسۡتَكۡبَرُواْ ٱسۡتِكۡبَارٗا","TajweedText":"وَإِ<tajweed class=ghunnah>نّ</tajweed>ِى كُلَّمَا دَعَوْتُهُمْ لِتَغْفِرَ لَهُمْ جَعَل<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> أَصَ<tajweed class=madda_normal>ـٰ</tajweed>بِعَهُمْ ف<tajweed class=madda_obligatory>ِىٓ</tajweed> ءَاذَانِهِمْ وَ<tajweed class=ham_wasl>ٱ</tajweed>سْتَغْشَوْ<tajweed class=slnt>اْ</tajweed> ثِيَابَهُمْ وَأَصَرُّو<tajweed class=slnt>اْ</tajweed> وَ<tajweed class=ham_wasl>ٱ</tajweed>سْتَكْبَرُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed>سْتِكْبَارًا <span class=end>٧</span>","End":"٧","PageNumber":570,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":504,"MaqraNumber":228,"HizbNumber":57,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":71,"SurahIndex":"071","VerseNumber":8,"ShowSurahName":false,"ShowBismillah":false,"Text":"ثُمَّ إِنِّي دَعَوۡتُهُمۡ جِهَارٗا","TajweedText":"ثُ<tajweed class=ghunnah>مّ</tajweed>َ إِ<tajweed class=ghunnah>نّ</tajweed>ِى دَعَوْتُهُمْ جِهَارًا <span class=end>٨</span>","End":"٨","PageNumber":570,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":504,"MaqraNumber":228,"HizbNumber":57,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":71,"SurahIndex":"071","VerseNumber":9,"ShowSurahName":false,"ShowBismillah":false,"Text":"ثُمَّ إِنِّيٓ أَعۡلَنتُ لَهُمۡ وَأَسۡرَرۡتُ لَهُمۡ إِسۡرَارٗا","TajweedText":"ثُ<tajweed class=ghunnah>مّ</tajweed>َ إِ<tajweed class=ghunnah>نّ</tajweed><tajweed class=madda_obligatory>ِىٓ</tajweed> أَعْلَ<tajweed class=ikhafa>نت</tajweed>ُ لَهُمْ وَأَسْرَرْتُ لَهُمْ إِسْرَارًا <span class=end>٩</span>","End":"٩","PageNumber":570,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":504,"MaqraNumber":228,"HizbNumber":57,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":71,"SurahIndex":"071","VerseNumber":10,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَقُلۡتُ ٱسۡتَغۡفِرُواْ رَبَّكُمۡ إِنَّهُۥ كَانَ غَفَّارٗا","TajweedText":"فَقُلْتُ <tajweed class=ham_wasl>ٱ</tajweed>سْتَغْفِرُو<tajweed class=slnt>اْ</tajweed> رَبَّكُمْ إِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> كَانَ غَفَّارًا <span class=end>١٠</span>","End":"١٠","PageNumber":570,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":504,"MaqraNumber":228,"HizbNumber":57,"HizbDecimal":0.75,"HasSajda":false}]}