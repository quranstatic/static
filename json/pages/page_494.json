umber":494,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":429,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":66,"ShowSurahName":false,"ShowBismillah":false,"Text":"هَلۡ يَنظُرُونَ إِلَّا ٱلسَّاعَةَ أَن تَأۡتِيَهُم بَغۡتَةٗ وَهُمۡ لَا يَشۡعُرُونَ","TajweedText":"هَلْ يَ<tajweed class=ikhafa>نظ</tajweed>ُرُونَ إِلَّا <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّاعَةَ أَ<tajweed class=ikhafa>ن ت</tajweed>َأْتِيَه<tajweed class=ikhafa_shafawi>ُم ب</tajweed>َغْتَ<tajweed class=idgham_ghunnah>ةً و</tajweed>َهُمْ لَا يَشْعُر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٦</span>","End":"٦٦","PageNumber":494,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":429,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":67,"ShowSurahName":false,"ShowBismillah":false,"Text":"ٱلۡأَخِلَّآءُ يَوۡمَئِذِۭ بَعۡضُهُمۡ لِبَعۡضٍ عَدُوٌّ إِلَّا ٱلۡمُتَّقِينَ","TajweedText":"ٱلْأَخِلّ<tajweed class=madda_obligatory>َا</tajweed>ٓءُ يَوْمَئِ<tajweed class=iqlab>ذِۭ ب</tajweed>َعْضُهُمْ لِبَعْضٍ عَدُوٌّ إِلَّا <tajweed class=ham_wasl>ٱ</tajweed>لْمُتَّق<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٦٧</span>","End":"٦٧","PageNumber":494,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":429,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":68,"ShowSurahName":false,"ShowBismillah":false,"Text":"يَٰعِبَادِ لَا خَوۡفٌ عَلَيۡكُمُ ٱلۡيَوۡمَ وَلَآ أَنتُمۡ تَحۡزَنُونَ","TajweedText":"يَ<tajweed class=madda_normal>ـٰ</tajweed>عِبَادِ لَا خَوْفٌ عَلَيْكُمُ <tajweed class=ham_wasl>ٱ</tajweed>لْيَوْمَ وَل<tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=ikhafa>نت</tajweed>ُمْ تَحْزَن<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٨</span>","End":"٦٨","PageNumber":494,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":430,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":69,"ShowSurahName":false,"ShowBismillah":false,"Text":"ٱلَّذِينَ ءَامَنُواْ بِـَٔايَٰتِنَا وَكَانُواْ مُسۡلِمِينَ","TajweedText":"ٱلَّذِينَ ءَامَنُو<tajweed class=slnt>اْ</tajweed> بِـَٔـايَ<tajweed class=madda_normal>ـٰ</tajweed>تِنَا وَكَانُو<tajweed class=slnt>اْ</tajweed> مُسْلِم<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٦٩</span>","End":"٦٩","PageNumber":494,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":430,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":70,"ShowSurahName":false,"ShowBismillah":false,"Text":"ٱدۡخُلُواْ ٱلۡجَنَّةَ أَنتُمۡ وَأَزۡوَٰجُكُمۡ تُحۡبَرُونَ","TajweedText":"ٱ<tajweed class=qalaqah>دْ</tajweed>خُلُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed>لْجَ<tajweed class=ghunnah>نّ</tajweed>َةَ أَ<tajweed class=ikhafa>نت</tajweed>ُمْ وَأَزْو<tajweed class=madda_normal>َٲ</tajweed>جُكُمْ تُحْبَر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٧٠</span>","End":"٧٠","PageNumber":494,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":430,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":71,"ShowSurahName":false,"ShowBismillah":false,"Text":"يُطَافُ عَلَيۡهِم بِصِحَافٖ مِّن ذَهَبٖ وَأَكۡوَابٖۖ وَفِيهَا مَا تَشۡتَهِيهِ ٱلۡأَنفُسُ وَتَلَذُّ ٱلۡأَعۡيُنُۖ وَأَنتُمۡ فِيهَا خَٰلِدُونَ","TajweedText":"يُطَافُ عَلَيْه<tajweed class=ikhafa_shafawi>ِم ب</tajweed>ِصِحَا<tajweed class=idgham_ghunnah>فٍ م</tajweed>ِّ<tajweed class=ikhafa>ن ذ</tajweed>َهَ<tajweed class=idgham_ghunnah>بٍ و</tajweed>َأَكْوَا<tajweed class=idgham_ghunnah>بٍ‌ۖ و</tajweed>َفِيهَا مَا تَشْتَهِيهِ <tajweed class=ham_wasl>ٱ</tajweed>لْأَ<tajweed class=ikhafa>نف</tajweed>ُسُ وَتَلَذُّ <tajweed class=ham_wasl>ٱ</tajweed>لْأَعْيُنُ‌ۖ وَأَ<tajweed class=ikhafa>نت</tajweed>ُمْ فِيهَا خَ<tajweed class=madda_normal>ـٰ</tajweed>لِد<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٧١</span>","End":"٧١","PageNumber":494,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":430,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":72,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَتِلۡكَ ٱلۡجَنَّةُ ٱلَّتِيٓ أُورِثۡتُمُوهَا بِمَا كُنتُمۡ تَعۡمَلُونَ","TajweedText":"وَتِلْكَ <tajweed class=ham_wasl>ٱ</tajweed>لْجَ<tajweed class=ghunnah>نّ</tajweed>َةُ <tajweed class=ham_wasl>ٱ</tajweed>لَّت<tajweed class=madda_obligatory>ِىٓ</tajweed> أُورِثْتُمُوهَا بِمَا كُ<tajweed class=ikhafa>نت</tajweed>ُمْ تَعْمَل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٧٢</span>","End":"٧٢","PageNumber":494,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":430,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":73,"ShowSurahName":false,"ShowBismillah":false,"Text":"لَكُمۡ فِيهَا فَٰكِهَةٞ كَثِيرَةٞ مِّنۡهَا تَأۡكُلُونَ","TajweedText":"لَكُمْ فِيهَا فَ<tajweed class=madda_normal>ـٰ</tajweed>كِهَ<tajweed class=ikhafa>ةٌ ك</tajweed>َثِيرَ<tajweed class=idgham_ghunnah>ةٌ م</tajweed>ِّنْهَا تَأْكُل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٧٣</span>","End":"٧٣","PageNumber":494,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":430,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false}]}