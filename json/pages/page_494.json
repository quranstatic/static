{"PageNumber":494,"Verses":[{"SurahNumber":43,"SurahIndex":"043","VerseNumber":61,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِنَّهُۥ لَعِلۡمٞ لِّلسَّاعَةِ فَلَا تَمۡتَرُنَّ بِهَا وَٱتَّبِعُونِۚ هَٰذَا صِرَٰطٞ مُّسۡتَقِيمٞ","TajweedText":"وَإِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> لَعِلْ<tajweed class=idgham_wo_ghunnah>مٌ ل</tajweed>ِّلسَّاعَةِ فَلَا تَمْتَرُ<tajweed class=ghunnah>نّ</tajweed>َ بِهَا وَ<tajweed class=ham_wasl>ٱ</tajweed>تَّبِعُونِ‌ۚ هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا صِر<tajweed class=madda_normal>َٲ</tajweed><tajweed class=idgham_ghunnah>طٌ م</tajweed>ُّسْتَق<tajweed class=madda_permissible>ِي</tajweed>مٌ <span class=end>٦١</span>","End":"٦١","PageNumber":494,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":429,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":62,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَا يَصُدَّنَّكُمُ ٱلشَّيۡطَٰنُۖ إِنَّهُۥ لَكُمۡ عَدُوّٞ مُّبِينٞ","TajweedText":"وَلَا يَصُدَّ<tajweed class=ghunnah>نّ</tajweed>َكُمُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>شَّيْطَ<tajweed class=madda_normal>ـٰ</tajweed>نُ‌ۖ إِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> لَكُمْ عَدُ<tajweed class=idgham_ghunnah>وٌّ م</tajweed>ُّب<tajweed class=madda_permissible>ِي</tajweed>نٌ <span class=end>٦٢</span>","End":"٦٢","PageNumber":494,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":429,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":63,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَمَّا جَآءَ عِيسَىٰ بِٱلۡبَيِّنَٰتِ قَالَ قَدۡ جِئۡتُكُم بِٱلۡحِكۡمَةِ وَلِأُبَيِّنَ لَكُم بَعۡضَ ٱلَّذِي تَخۡتَلِفُونَ فِيهِۖ فَٱتَّقُواْ ٱللَّهَ وَأَطِيعُونِ","TajweedText":"وَلَ<tajweed class=ghunnah>مّ</tajweed>َا ج<tajweed class=madda_obligatory>َا</tajweed>ٓءَ عِيسَىٰ بِ<tajweed cla