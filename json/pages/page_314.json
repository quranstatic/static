{"PageNumber":314,"Verses":[{"SurahNumber":20,"SurahIndex":"020","VerseNumber":38,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِذۡ أَوۡحَيۡنَآ إِلَىٰٓ أُمِّكَ مَا يُوحَىٰٓ","TajweedText":"إِذْ أَوْحَيْن<tajweed class=madda_obligatory>َآ</tajweed> إِلَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> أُ<tajweed class=ghunnah>مّ</tajweed>ِكَ مَا يُوحَىٰٓ <span class=end>٣٨</span>","End":"٣٨","PageNumber":314,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":271,"MaqraNumber":125,"HizbNumber":32,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":39,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَنِ ٱقۡذِفِيهِ فِي ٱلتَّابُوتِ فَٱقۡذِفِيهِ فِي ٱلۡيَمِّ فَلۡيُلۡقِهِ ٱلۡيَمُّ بِٱلسَّاحِلِ يَأۡخُذۡهُ عَدُوّٞ لِّي وَعَدُوّٞ لَّهُۥۚ وَأَلۡقَيۡتُ عَلَيۡكَ مَحَبَّةٗ مِّنِّي وَلِتُصۡنَعَ عَلَىٰ عَيۡنِيٓ","TajweedText":"أَنِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=qalaqah>قْ</tajweed>ذِفِيهِ فِى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>تَّابُوتِ فَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=qalaqah>قْ</tajweed>ذِفِيهِ فِى <tajweed class=ham_wasl>ٱ</tajweed>لْيَ<tajweed class=ghunnah>مّ</tajweed>ِ فَلْيُلْقِهِ <tajweed class=ham_wasl>ٱ</tajweed>لْيَ<tajweed class=ghunnah>مّ</tajweed>ُ بِ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّاحِلِ يَأْخُذْهُ عَدُ<tajweed class=idgham_wo_ghunnah>وٌّ ل</tajweed>ِّى وَعَدُ<tajweed class=idgham_wo_ghunnah>وٌّ ل</tajweed>َّهُ<tajweed class=madda_normal>ۥ</tajweed>‌ۚ وَأَلْقَيْتُ عَلَيْكَ مَحَبَّ<tajweed class=idgham_ghunnah>ةً م</tajweed>ِّ<tajweed class=ghunnah>نّ</tajweed>ِى وَلِتُصْنَعَ عَلَىٰ عَيْنِىٓ <span class=end>٣٩</span>","End":"٣٩","PageNumber":314,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":271,"MaqraNumber":125,"HizbNumber":32,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":40,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِذۡ تَمۡشِيٓ أُخۡتُكَ فَتَقُولُ هَلۡ أَدُلُّكُمۡ عَلَىٰ مَن يَكۡفُلُهُۥۖ فَرَجَعۡنَٰكَ إِلَىٰٓ أُمِّكَ كَيۡ تَقَرَّ عَيۡنُهَا وَلَا تَحۡزَنَۚ وَقَتَلۡتَ نَفۡسٗا فَنَجَّيۡنَٰكَ مِنَ ٱلۡغَمِّ وَفَتَنَّـٰكَ فُتُونٗاۚ فَلَبِثۡتَ سِنِينَ فِيٓ أَهۡلِ مَدۡيَنَ ثُمَّ جِئۡتَ عَلَىٰ قَدَرٖ يَٰمُوسَىٰ","TajweedText":"إِذْ تَمْش<tajweed class=madda_obligatory>ِىٓ</tajweed> أُخْتُكَ فَتَقُولُ هَلْ أَدُلُّكُمْ عَلَىٰ م<tajweed class=idgham_ghunnah>َن ي</tajweed>َكْفُلُهُ<tajweed class=madda_normal>ۥ</tajweed>‌ۖ فَرَجَعْنَ<tajweed class=madda_normal>ـٰ</tajweed>كَ إِلَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> أُ<tajweed class=ghunnah>مّ</tajweed>ِكَ كَىْ تَقَرَّ عَيْنُهَا وَلَا تَحْزَنَ‌ۚ وَقَتَلْتَ نَفْ<tajweed class=ikhafa>سًا ف</tajweed>َنَجَّيْنَ<tajweed class=madda_normal>ـٰ</tajweed>كَ مِنَ <tajweed class=ham_wasl>ٱ</tajweed>لْغَ<tajweed class=ghunnah>مّ</tajweed>ِ وَفَتَ<tajweed class=ghunnah>نّ</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed>كَ فُتُو<tajweed class=ikhafa>نًا‌ۚ ف</tajweed>َلَبِثْتَ سِنِينَ ف<tajweed class=madda_obligatory>ِىٓ</tajweed> أَهْلِ مَ<tajweed class=qalaqah>دْ</tajweed>يَنَ ثُ<tajweed class=ghunnah>مّ</tajweed>َ جِئْتَ عَلَىٰ قَدَ<tajweed class=idgham_ghunnah>رٍ ي</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed>مُوسَىٰ <span class=end>٤٠</span>","End":"٤٠","PageNumber":314,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":271,"MaqraNumber":125,"HizbNumber":32,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":41,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَٱصۡطَنَعۡتُكَ لِنَفۡسِي","TajweedText":"وَ<tajweed class=ham_wasl>ٱ</tajweed>صْطَنَعْتُكَ لِنَفْسِى <span class=end>٤١</span>","End":"٤١","PageNumber":314,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":271,"MaqraNumber":125,"HizbNumber":32,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":42,"ShowSurahName":false,"ShowBismillah":false,"Text":"ٱذۡهَبۡ أَنتَ وَأَخُوكَ بِـَٔايَٰتِي وَلَا تَنِيَا فِي ذِكۡرِي","TajweedText":"ٱذْهَ<tajweed class=qalaqah>بْ</tajweed> أَ<tajweed class=ikhafa>نت</tajweed>َ وَأَخُوكَ بِـَٔـايَ<tajweed class=madda_normal>ـٰ</tajweed>تِى وَلَا تَنِيَا فِى ذِكْرِى <span class=end>٤٢</span>","End":"٤٢","PageNumber":314,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":271,"MaqraNumber":125,"HizbNumber":32,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":43,"ShowSurahName":false,"ShowBismillah":false,"Text":"ٱذۡهَبَآ إِلَىٰ فِرۡعَوۡنَ إِنَّهُۥ طَغَىٰ","TajweedText":"ٱذْهَب<tajweed class=madda_obligatory>َآ</tajweed> إِلَىٰ فِرْعَوْنَ إِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> طَغَىٰ <span class=end>٤٣</span>","End":"٤٣","PageNumber":314,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":271,"MaqraNumber":125,"HizbNumber":32,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":44,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَقُولَا لَهُۥ قَوۡلٗا لَّيِّنٗا لَّعَلَّهُۥ يَتَذَكَّرُ أَوۡ يَخۡشَىٰ","TajweedText":"فَقُولَا لَهُ<tajweed class=madda_normal>ۥ</tajweed> قَوْل<tajweed class=idgham_wo_ghunnah>اً ل</tajweed>َّيِّ<tajweed class=idgham_wo_ghunnah>نًا ل</tajweed>َّعَلَّهُ<tajweed class=madda_normal>ۥ</tajweed> يَتَذَكَّرُ أَوْ يَخْشَىٰ <span class=end>٤٤</span>","End":"٤٤","PageNumber":314,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":271,"MaqraNumber":125,"HizbNumber":32,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":45,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَا رَبَّنَآ إِنَّنَا نَخَافُ أَن يَفۡرُطَ عَلَيۡنَآ أَوۡ أَن يَطۡغَىٰ","TajweedText":"قَالَا رَبَّن<tajweed class=madda_obligatory>َآ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َنَا نَخَافُ أ<tajweed class=idgham_ghunnah>َن ي</tajweed>َفْرُطَ عَلَيْن<tajweed class=madda_obligatory>َآ</tajweed> أَوْ أ<tajweed class=idgham_ghunnah>َن ي</tajweed>َ<tajweed class=qalaqah>طْ</tajweed>غَىٰ <span class=end>٤٥</span>","End":"٤٥","PageNumber":314,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":271,"MaqraNumber":125,"HizbNumber":32,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":46,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَ لَا تَخَافَآۖ إِنَّنِي مَعَكُمَآ أَسۡمَعُ وَأَرَىٰ","TajweedText":"قَالَ لَا تَخَاف<tajweed class=madda_obligatory>َآ‌ۖ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َنِى مَعَكُم<tajweed class=madda_obligatory>َآ</tajweed> أَسْمَعُ وَأَرَىٰ <span class=end>٤٦</span>","End":"٤٦","PageNumber":314,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":271,"MaqraNumber":125,"HizbNumber":32,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":47,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَأۡتِيَاهُ فَقُولَآ إِنَّا رَسُولَا رَبِّكَ فَأَرۡسِلۡ مَعَنَا بَنِيٓ إِسۡرَـٰٓءِيلَ وَلَا تُعَذِّبۡهُمۡۖ قَدۡ جِئۡنَٰكَ بِـَٔايَةٖ مِّن رَّبِّكَۖ وَٱلسَّلَٰمُ عَلَىٰ مَنِ ٱتَّبَعَ ٱلۡهُدَىٰٓ","TajweedText":"فَأْتِيَاهُ فَقُول<tajweed class=madda_obligatory>َآ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َا رَسُولَا رَبِّكَ فَأَرْسِلْ مَعَنَا بَن<tajweed class=madda_obligatory>ِىٓ</tajweed> إِسْر<tajweed class=madda_obligatory>َٲ</tajweed>ٓءِيلَ وَلَا تُعَذِّ<tajweed class=qalaqah>بْ</tajweed>هُمْ‌ۖ قَ<tajweed class=qalaqah>دْ</tajweed> جِئْنَ<tajweed class=madda_normal>ـٰ</tajweed>كَ بِـَٔـايَ<tajweed class=idgham_ghunnah>ةٍ م</tajweed>ّ<tajweed class=idgham_wo_ghunnah>ِن ر</tajweed>َّبِّكَ‌ۖ وَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّلَ<tajweed class=madda_normal>ـٰ</tajweed>مُ عَلَىٰ مَنِ <tajweed class=ham_wasl>ٱ</tajweed>تَّبَعَ <tajweed class=ham_wasl>ٱ</tajweed>لْهُدَىٰٓ <span class=end>٤٧</span>","End":"٤٧","PageNumber":314,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":271,"MaqraNumber":125,"HizbNumber":32,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":48,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّا قَدۡ أُوحِيَ إِلَيۡنَآ أَنَّ ٱلۡعَذَابَ عَلَىٰ مَن كَذَّبَ وَتَوَلَّىٰ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َا قَ<tajweed class=qalaqah>دْ</tajweed> أُوحِىَ إِلَيْن<tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>لْعَذَابَ عَلَىٰ مَ<tajweed class=ikhafa>ن ك</tajweed>َذَّبَ وَتَوَلَّىٰ <span class=end>٤٨</span>","End":"٤٨","PageNumber":314,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":271,"MaqraNumber":125,"HizbNumber":32,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":49,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَ فَمَن رَّبُّكُمَا يَٰمُوسَىٰ","TajweedText":"قَالَ فَم<tajweed class=idgham_wo_ghunnah>َن ر</tajweed>َّبُّكُمَا يَ<tajweed class=madda_normal>ـٰ</tajweed>مُوسَىٰ <span class=end>٤٩</span>","End":"٤٩","PageNumber":314,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":271,"MaqraNumber":125,"HizbNumber":32,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":50,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَ رَبُّنَا ٱلَّذِيٓ أَعۡطَىٰ كُلَّ شَيۡءٍ خَلۡقَهُۥ ثُمَّ هَدَىٰ","TajweedText":"قَالَ رَبُّنَا <tajweed class=ham_wasl>ٱ</tajweed>لَّذ<tajweed class=madda_obligatory>ِىٓ</tajweed> أَعْطَىٰ كُلَّ شَىْءٍ خَلْقَهُ<tajweed class=madda_normal>ۥ</tajweed> ثُ<tajweed class=ghunnah>مّ</tajweed>َ هَدَىٰ <span class=end>٥٠</span>","End":"٥٠","PageNumber":314,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":271,"MaqraNumber":125,"HizbNumber":32,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":51,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَ فَمَا بَالُ ٱلۡقُرُونِ ٱلۡأُولَىٰ","TajweedText":"قَالَ فَمَا بَالُ <tajweed class=ham_wasl>ٱ</tajweed>لْقُرُونِ <tajweed class=ham_wasl>ٱ</tajweed>لْأُولَىٰ <span class=end>٥١</span>","End":"٥١","PageNumber":314,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":271,"MaqraNumber":125,"HizbNumber":32,"HizbDecimal":0.0,"HasSajda":false}]}