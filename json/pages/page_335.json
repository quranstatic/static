jweed class=idgham_ghunnah>رٍ ي</tajweed>َأْتِينَ مِ<tajweed class=ikhafa>ن ك</tajweed>ُلِّ فَجٍّ عَم<tajweed class=madda_permissible>ِي</tajweed><tajweed class=qalaqah>ق</tajweed>ٍ <span class=end>٢٧</span>","End":"٢٧","PageNumber":335,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":288,"MaqraNumber":134,"HizbNumber":34,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":22,"SurahIndex":"022","VerseNumber":28,"ShowSurahName":false,"ShowBismillah":false,"Text":"لِّيَشۡهَدُواْ مَنَٰفِعَ لَهُمۡ وَيَذۡكُرُواْ ٱسۡمَ ٱللَّهِ فِيٓ أَيَّامٖ مَّعۡلُومَٰتٍ عَلَىٰ مَا رَزَقَهُم مِّنۢ بَهِيمَةِ ٱلۡأَنۡعَٰمِۖ فَكُلُواْ مِنۡهَا وَأَطۡعِمُواْ ٱلۡبَآئِسَ ٱلۡفَقِيرَ","TajweedText":"لِّيَشْهَدُو<tajweed class=slnt>اْ</tajweed> مَنَ<tajweed class=madda_normal>ـٰ</tajweed>فِعَ لَهُمْ وَيَذْكُرُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed>سْمَ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ ف<tajweed class=madda_obligatory>ِىٓ</tajweed> أَيَّا<tajweed class=idgham_ghunnah>مٍ م</tajweed>َّعْلُومَ<tajweed class=madda_normal>ـٰ</tajweed>تٍ عَلَىٰ مَا رَزَقَه<tajweed class=idgham_shafawi>ُم م</tajweed>ّ<tajweed class=iqlab>ِنۢ ب</tajweed>َهِيمَةِ <tajweed class=ham_wasl>ٱ</tajweed>لْأَنْعَ<tajweed class=madda_normal>ـٰ</tajweed>مِ‌ۖ فَكُلُو<tajweed class=slnt>اْ</tajweed> مِنْهَا وَأَ<tajweed class=qalaqah>طْ</tajweed>عِمُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed>لْب<tajweed class=madda_obligatory>َا</tajweed>ٓئِسَ <tajweed class=ham_wasl>ٱ</tajweed>لْفَق<tajweed class=madda_permissible>ِي</tajweed>رَ <span class=end>٢٨</span>","End":"٢٨","PageNumber":335,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":288,"MaqraNumber":134,"HizbNumber":34,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":22,"SurahIndex":"022","VerseNumber":29,"ShowSurahName":false,"ShowBismillah":false,"Text":"ثُمَّ لۡيَقۡضُواْ تَفَثَهُمۡ وَلۡيُوفُواْ نُذُورَهُمۡ وَلۡيَطَّوَّفُواْ بِٱلۡبَيۡتِ ٱلۡعَتِيقِ","TajweedText":"ثُ<tajweed class=ghunnah>مّ</tajweed>َ لْيَ<tajweed class=qala