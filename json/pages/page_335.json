{"PageNumber":335,"Verses":[{"SurahNumber":22,"SurahIndex":"022","VerseNumber":24,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَهُدُوٓاْ إِلَى ٱلطَّيِّبِ مِنَ ٱلۡقَوۡلِ وَهُدُوٓاْ إِلَىٰ صِرَٰطِ ٱلۡحَمِيدِ","TajweedText":"وَهُد<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> إِلَى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>طَّيِّبِ مِنَ <tajweed class=ham_wasl>ٱ</tajweed>لْقَوْلِ وَهُد<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> إِلَىٰ صِر<tajweed class=madda_normal>َٲ</tajweed>طِ <tajweed class=ham_wasl>ٱ</tajweed>لْحَم<tajweed class=madda_permissible>ِي</tajweed><tajweed class=qalaqah>د</tajweed>ِ <span class=end>٢٤</span>","End":"٢٤","PageNumber":335,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":287,"MaqraNumber":134,"HizbNumber":34,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":22,"SurahIndex":"022","VerseNumber":25,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّ ٱلَّذِينَ كَفَرُواْ وَيَصُدُّونَ عَن سَبِيلِ ٱللَّهِ وَٱلۡمَسۡجِدِ ٱلۡحَرَامِ ٱلَّذِي جَعَلۡنَٰهُ لِلنَّاسِ سَوَآءً ٱلۡعَٰكِفُ فِيهِ وَٱلۡبَادِۚ وَمَن يُرِدۡ فِيهِ بِإِلۡحَادِۭ بِظُلۡمٖ نُّذِقۡهُ مِنۡ عَذَابٍ أَلِيمٖ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ كَفَرُو<tajweed class=slnt>اْ</tajweed> وَيَصُدُّونَ عَ<tajweed class=ikhafa>ن س</tajweed>َبِيلِ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْمَسْجِدِ <tajweed class=ham_wasl>ٱ</tajweed>لْحَرَامِ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى جَعَلْنَ<tajweed class=madda_normal>ـٰ</tajweed>هُ لِل<tajweed class=ghunnah>نّ</tajweed>َاسِ سَو<tajweed class=madda_obligatory>َا</tajweed>ٓءً <tajweed class=ham_wasl>ٱ</tajweed>لْعَ<tajweed class=madda_normal>ـٰ</tajweed>كِفُ فِيهِ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْبَادِ‌ۚ وَم<tajweed class=idgham_ghunnah>َن ي</tajweed>ُرِ<tajweed class=qalaqah>دْ</tajweed> فِيهِ بِإِلْحَا<tajweed class=iqlab>دِۭ ب</t