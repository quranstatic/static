{"PageNumber":564,"Verses":[{"SurahNumber":67,"SurahIndex":"067","VerseNumber":27,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَلَمَّا رَأَوۡهُ زُلۡفَةٗ سِيٓـَٔتۡ وُجُوهُ ٱلَّذِينَ كَفَرُواْ وَقِيلَ هَٰذَا ٱلَّذِي كُنتُم بِهِۦ تَدَّعُونَ","TajweedText":"فَلَ<tajweed class=ghunnah>مّ</tajweed>َا رَأَوْهُ زُلْفَ<tajweed class=ikhafa>ةً س</tajweed>ِ<tajweed class=madda_obligatory>يٓ</tajweed>ــَٔتْ وُجُوهُ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ كَفَرُو<tajweed class=slnt>اْ</tajweed> وَقِيلَ هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى كُ<tajweed class=ikhafa>نت</tajweed><tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِه<tajweed class=madda_normal>ِۦ</tajweed> تَدَّع<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٧</span>","End":"٢٧","PageNumber":564,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":497,"MaqraNumber":225,"HizbNumber":57,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":67,"SurahIndex":"067","VerseNumber":28,"ShowSurahName":false,"ShowBismillah":false,"Text":"قُلۡ أَرَءَيۡتُمۡ إِنۡ أَهۡلَكَنِيَ ٱللَّهُ وَمَن مَّعِيَ أَوۡ رَحِمَنَا فَمَن يُجِيرُ ٱلۡكَٰفِرِينَ مِنۡ عَذَابٍ أَلِيمٖ","TajweedText":"قُلْ أَرَءَيْتُمْ إِنْ أَهْلَكَنِىَ <tajweed class=ham_wasl>ٱ</tajweed>للَّهُ وَم<tajweed class=idgham_ghunnah>َن م</tajweed>َّعِىَ أَوْ رَحِمَنَا فَم<tajweed class=idgham_ghunnah>َن ي</tajweed>ُجِيرُ <tajweed class=ham_wasl>ٱ</tajweed>لْكَ<tajweed class=madda_normal>ـٰ</tajweed>فِرِينَ مِنْ عَذَابٍ أَل<tajweed class=madda_permissible>ِي</tajweed>مٍ <span class=end>٢٨</span>","End":"٢٨","PageNumber":564,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":497,"MaqraNumber":225,"HizbNumber":57,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":67,"SurahIndex":"067","VerseNumber":29,"ShowSurahName":false,"ShowBismillah":false,"Text":"قُلۡ هُوَ ٱلرَّحۡمَٰنُ ءَامَنَّا بِهِۦ وَعَلَيۡهِ تَوَكَّلۡنَاۖ فَسَتَعۡلَمُونَ مَنۡ هُوَ فِي ضَلَٰلٖ مُّبِينٖ","TajweedText":"قُلْ هُوَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رَّحْمَ<tajweed class=madda_normal>ـٰ</tajweed>نُ ءَامَ<tajweed class=ghunnah>نّ</tajweed>َا بِه<tajweed class=madda_normal>ِۦ</tajweed> وَعَلَيْهِ تَوَكَّلْنَا‌ۖ فَسَتَعْلَمُونَ مَنْ هُوَ فِى ضَلَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>لٍ م</tajweed>ُّب<tajweed class=madda_permissible>ِي</tajweed>نٍ <span class=end>٢٩</span>","End":"٢٩","PageNumber":564,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":497,"MaqraNumber":225,"HizbNumber":57,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":67,"SurahIndex":"067","VerseNumber":30,"ShowSurahName":false,"ShowBismillah":false,"Text":"قُلۡ أَرَءَيۡتُمۡ إِنۡ أَصۡبَحَ مَآؤُكُمۡ غَوۡرٗا فَمَن يَأۡتِيكُم بِمَآءٖ مَّعِينِۭ","TajweedText":"قُلْ أَرَءَيْتُمْ إِنْ أَصْبَحَ م<tajweed class=madda_obligatory>َا</tajweed>ٓؤُكُمْ غَوْ<tajweed class=ikhafa>رًا ف</tajweed>َم<tajweed class=idgham_ghunnah>َن ي</tajweed>َأْتِيك<tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِم<tajweed class=madda_obligatory>َا</tajweed>ٓ<tajweed class=idgham_ghunnah>ءٍ م</tajweed>َّع<tajweed class=madda_permissible>ِي</tajweed>نِۭ <span class=end>٣٠</span>","End":"٣٠","PageNumber":564,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":497,"MaqraNumber":225,"HizbNumber":57,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":68,"SurahIndex":"068","VerseNumber":1,"ShowSurahName":true,"ShowBismillah":true,"Text":"نٓۚ وَٱلۡقَلَمِ وَمَا يَسۡطُرُونَ","TajweedText":"<tajweed class=madda_necessary>نٓ</tajweed>‌ۚ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْقَلَمِ وَمَا يَسْطُر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١</span>","End":"١","PageNumber":564,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":498,"MaqraNumber":226,"HizbNumber":57,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":68,"SurahIndex":"068","VerseNumber":2,"ShowSurahName":false,"ShowBismillah":false,"Text":"مَآ أَنتَ بِنِعۡمَةِ رَبِّكَ بِمَجۡنُونٖ","TajweedText":"م<tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=ikhafa>نت</tajweed>َ بِنِعْمَةِ رَبِّكَ بِمَ<tajweed class=qalaqah>جْ</tajweed>ن<tajweed class=madda_permissible>ُو</tajweed>نٍ <span class=end>٢</span>","End":"٢","PageNumber":564,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":498,"MaqraNumber":226,"HizbNumber":57,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":68,"SurahIndex":"068","VerseNumber":3,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِنَّ لَكَ لَأَجۡرًا غَيۡرَ مَمۡنُونٖ","TajweedText":"وَإِ<tajweed class=ghunnah>نّ</tajweed>َ لَكَ لَأَ<tajweed class=qalaqah>جْ</tajweed>رًا غَيْرَ مَمْن<tajweed class=madda_permissible>ُو</tajweed>نٍ <span class=end>٣</span>","End":"٣","PageNumber":564,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":498,"MaqraNumber":226,"HizbNumber":57,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":68,"SurahIndex":"068","VerseNumber":4,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٖ","TajweedText":"وَإِ<tajweed class=ghunnah>نّ</tajweed>َكَ لَعَلَىٰ خُلُقٍ عَظ<tajweed class=madda_permissible>ِي</tajweed>مٍ <span class=end>٤</span>","End":"٤","PageNumber":564,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":498,"MaqraNumber":226,"HizbNumber":57,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":68,"SurahIndex":"068","VerseNumber":5,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَسَتُبۡصِرُ وَيُبۡصِرُونَ","TajweedText":"فَسَتُ<tajweed class=qalaqah>بْ</tajweed>صِرُ وَيُ<tajweed class=qalaqah>بْ</tajweed>صِر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٥</span>","End":"٥","PageNumber":564,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":498,"MaqraNumber":226,"HizbNumber":57,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":68,"SurahIndex":"068","VerseNumber":6,"ShowSurahName":false,"ShowBismillah":false,"Text":"بِأَييِّكُمُ ٱلۡمَفۡتُونُ","TajweedText":"بِأَييِّكُمُ <tajweed class=ham_wasl>ٱ</tajweed>لْمَفْت<tajweed class=madda_permissible>ُو</tajweed>نُ <span class=end>٦</span>","End":"٦","PageNumber":564,"JuzNumber":29,"Manzil