{"PageNumber":468,"Verses":[{"SurahNumber":40,"SurahIndex":"040","VerseNumber":8,"ShowSurahName":false,"ShowBismillah":false,"Text":"رَبَّنَا وَأَدۡخِلۡهُمۡ جَنَّـٰتِ عَدۡنٍ ٱلَّتِي وَعَدتَّهُمۡ وَمَن صَلَحَ مِنۡ ءَابَآئِهِمۡ وَأَزۡوَٰجِهِمۡ وَذُرِّيَّـٰتِهِمۡۚ إِنَّكَ أَنتَ ٱلۡعَزِيزُ ٱلۡحَكِيمُ","TajweedText":"رَبَّنَا وَأَ<tajweed class=qalaqah>دْ</tajweed>خِلْهُمْ جَ<tajweed class=ghunnah>نّ</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed>تِ عَ<tajweed class=qalaqah>دْ</tajweed>نٍ <tajweed class=ham_wasl>ٱ</tajweed>لَّتِى وَعَ<tajweed class=idgham_mutajanisayn>د</tajweed>تَّهُمْ وَمَ<tajweed class=ikhafa>ن ص</tajweed>َلَحَ مِنْ ءَاب<tajweed class=madda_obligatory>َا</tajweed>ٓئِهِمْ وَأَزْو<tajweed class=madda_normal>َٲ</tajweed>جِهِمْ وَذُرِّيَّ<tajweed class=madda_normal>ـٰ</tajweed>تِهِمْۚ إِ<tajweed class=ghunnah>نّ</tajweed>َكَ أَ<tajweed class=ikhafa>نت</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>لْعَزِيزُ <tajweed class=ham_wasl>ٱ</tajweed>لْحَك<tajweed class=madda_permissible>ِي</tajweed>مُ <span class=end>٨</span>","End":"٨","PageNumber":468,"JuzNumber":24,"ManzilNumber":6,"RukuNumber":404,"MaqraNumber":187,"HizbNumber":47,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":40,"SurahIndex":"040","VerseNumber":9,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَقِهِمُ ٱلسَّيِّـَٔاتِۚ وَمَن تَقِ ٱلسَّيِّـَٔاتِ يَوۡمَئِذٖ فَقَدۡ رَحِمۡتَهُۥۚ وَذَٰلِكَ هُوَ ٱلۡفَوۡزُ ٱلۡعَظِيمُ","TajweedText":"وَقِهِمُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّيِّـَٔـاتِۚ وَمَ<tajweed class=ikhafa>ن ت</tajweed>َقِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّيِّـَٔـاتِ يَوْمَئِ<tajweed class=ikhafa>ذٍ ف</tajweed>َقَ<tajweed class=qalaqah>دْ</tajweed> رَحِمْتَهُ<tajweed class=madda_normal>ۥ</tajweed>ۚ وَذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ هُوَ <tajweed class=ham_wasl>ٱ</tajweed>لْفَوْزُ <tajweed class=ham_wasl>ٱ</tajweed>لْعَظ<tajweed class=madda_permissible>ِي</tajweed>مُ <span class=en