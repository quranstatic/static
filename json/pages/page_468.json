":false},{"SurahNumber":40,"SurahIndex":"040","VerseNumber":14,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَٱدۡعُواْ ٱللَّهَ مُخۡلِصِينَ لَهُ ٱلدِّينَ وَلَوۡ كَرِهَ ٱلۡكَٰفِرُونَ","TajweedText":"فَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=qalaqah>دْ</tajweed>عُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed>للَّهَ مُخْلِصِينَ لَهُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>دِّينَ وَلَوْ كَرِهَ <tajweed class=ham_wasl>ٱ</tajweed>لْكَ<tajweed class=madda_normal>ـٰ</tajweed>فِر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٤</span>","End":"١٤","PageNumber":468,"JuzNumber":24,"ManzilNumber":6,"RukuNumber":405,"MaqraNumber":187,"HizbNumber":47,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":40,"SurahIndex":"040","VerseNumber":15,"ShowSurahName":false,"ShowBismillah":false,"Text":"رَفِيعُ ٱلدَّرَجَٰتِ ذُو ٱلۡعَرۡشِ يُلۡقِي ٱلرُّوحَ مِنۡ أَمۡرِهِۦ عَلَىٰ مَن يَشَآءُ مِنۡ عِبَادِهِۦ لِيُنذِرَ يَوۡمَ ٱلتَّلَاقِ","TajweedText":"رَفِيعُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>دَّرَجَ<tajweed class=madda_normal>ـٰ</tajweed>تِ ذُو <tajweed class=ham_wasl>ٱ</tajweed>لْعَرْشِ يُلْقِى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رُّوحَ مِنْ أَمْرِه<tajweed class=madda_normal>ِۦ</tajweed> عَلَىٰ م<tajweed class=idgham_ghunnah>َن ي</tajweed>َش<tajweed class=madda_obligatory>َا</tajweed>ٓءُ مِنْ عِبَادِه<tajweed class=madda_normal>ِۦ</tajweed> لِيُ<tajweed class=ikhafa>نذ</tajweed>ِرَ يَوْمَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>تَّل<tajweed class=madda_permissible>َا</tajweed><tajweed class=qalaqah>ق</tajweed>ِ <span class=end>١٥</span>","End":"١٥","PageNumber":468,"JuzNumber":24,"ManzilNumber":6,"RukuNumber":405,"MaqraNumber":187,"HizbNumber":47,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":40,"SurahIndex":"040","VerseNumber":16,"ShowSurahName":false,"ShowBismillah":false,"Text":"يَو