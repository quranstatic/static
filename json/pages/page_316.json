{"PageNumber":316,"Verses":[{"SurahNumber":20,"SurahIndex":"020","VerseNumber":65,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالُواْ يَٰمُوسَىٰٓ إِمَّآ أَن تُلۡقِيَ وَإِمَّآ أَن نَّكُونَ أَوَّلَ مَنۡ أَلۡقَىٰ","TajweedText":"قَالُو<tajweed class=slnt>اْ</tajweed> يَ<tajweed class=madda_normal>ـٰ</tajweed>مُوسَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> إِ<tajweed class=ghunnah>مّ</tajweed><tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=ikhafa>ن ت</tajweed>ُلْقِىَ وَإِ<tajweed class=ghunnah>مّ</tajweed><tajweed class=madda_obligatory>َآ</tajweed> أ<tajweed class=idgham_ghunnah>َن ن</tajweed>َّكُونَ أَوَّلَ مَنْ أَلْقَىٰ <span class=end>٦٥</span>","End":"٦٥","PageNumber":316,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":272,"MaqraNumber":126,"HizbNumber":32,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":66,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَ بَلۡ أَلۡقُواْۖ فَإِذَا حِبَالُهُمۡ وَعِصِيُّهُمۡ يُخَيَّلُ إِلَيۡهِ مِن سِحۡرِهِمۡ أَنَّهَا تَسۡعَىٰ","TajweedText":"قَالَ بَلْ أَلْقُو<tajweed class=slnt>اْ‌ۖ</tajweed> فَإِذَا حِبَالُهُمْ وَعِصِيُّهُمْ يُخَيَّلُ إِلَيْهِ مِ<tajweed class=ikhafa>ن س</tajweed>ِحْرِهِمْ أَ<tajweed class=ghunnah>نّ</tajweed>َهَا تَسْعَىٰ <span class=end>٦٦</span>","End":"٦٦","PageNumber":316,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":272,"MaqraNumber":126,"HizbNumber":32,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":67,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَأَوۡجَسَ فِي نَفۡسِهِۦ خِيفَةٗ مُّوسَىٰ","TajweedText":"فَأَوْجَسَ فِى نَفْسِه<tajweed class=madda_normal>ِۦ</tajweed> خِيفَ<tajweed class=idgham_ghunnah>ةً م</tajweed>ُّوسَىٰ <span class=end>٦٧</span>","End":"٦٧","PageNumber":316,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":272,"MaqraNumber":126,"HizbNumber":32,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":68,"ShowSurahName":false,"ShowBismillah":false,"Text":"قُلۡنَا لَا تَخَفۡ إِنَّكَ أَنتَ ٱلۡأَعۡلَىٰ","TajweedText":"قُلْنَا لَا تَخَفْ إِ<tajweed class=ghunnah>نّ</tajweed>َكَ أَ<tajweed class=ikhafa>نت</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>لْأَعْلَىٰ <span class=end>٦٨</span>","End":"٦٨","PageNumber":316,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":272,"MaqraNumber":126,"HizbNumber":32,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":69,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَأَلۡقِ مَا فِي يَمِينِكَ تَلۡقَفۡ مَا صَنَعُوٓاْۖ إِنَّمَا صَنَعُواْ كَيۡدُ سَٰحِرٖۖ وَلَا يُفۡلِحُ ٱلسَّاحِرُ حَيۡثُ أَتَىٰ","TajweedText":"وَأَلْقِ مَا فِى يَمِينِكَ تَلْقَفْ مَا صَنَع<tajweed class=madda_obligatory>ُوٓ<tajweed class=slnt>اْ</tajweed>‌ۖ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َمَا صَنَعُو<tajweed class=slnt>اْ</tajweed> كَيْدُ سَ<tajweed class=madda_normal>ـٰ</tajweed>حِ<tajweed class=idgham_ghunnah>رٍ‌ۖ و</tajweed>َلَا يُفْلِحُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّاحِرُ حَيْثُ أَتَىٰ <span class=end>٦٩</span>","End":"٦٩","PageNumber":316,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":272,"MaqraNumber":126,"HizbNumber":32,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":70,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَأُلۡقِيَ ٱلسَّحَرَةُ سُجَّدٗا قَالُوٓاْ ءَامَنَّا بِرَبِّ هَٰرُونَ وَمُوسَىٰ","TajweedText":"فَأُلْقِىَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّحَرَةُ سُجَّ<tajweed class=ikhafa>دًا ق</tajweed>َال<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> ءَامَ<tajweed class=ghunnah>نّ</tajweed>َا بِرَبِّ هَ<tajweed class=madda_normal>ـٰ</tajweed>رُونَ وَمُوسَىٰ <span class=end>٧٠</span>","End":"٧٠","PageNumber":316,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":272,"MaqraNumber":126,"HizbNumber":32,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":71,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَ ءَامَنتُمۡ لَهُۥ قَبۡلَ أَنۡ ءَاذَنَ لَكُمۡۖ إِنَّهُۥ لَكَبِيرُكُمُ ٱلَّذِي عَلَّمَكُمُ ٱلسِّحۡرَۖ فَلَأُقَطِّعَنَّ أَيۡدِيَكُمۡ وَأَرۡجُلَكُم مِّنۡ خِلَٰفٖ وَلَأُصَلِّبَنَّكُمۡ فِي جُذُوعِ ٱلنَّخۡلِ وَلَتَعۡلَمُنَّ أَيُّنَآ أَشَدُّ عَذَابٗا وَأَبۡقَىٰ","TajweedText":"قَالَ ءَامَ<tajweed class=ikhafa>نت</tajweed>ُمْ لَهُ<tajweed class=madda_normal>ۥ</tajweed> قَ<tajweed class=qalaqah>بْ</tajweed>لَ أَنْ ءَاذَنَ لَكُمْ‌ۖ إِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> لَكَبِيرُكُمُ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى عَلَّمَكُمُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سِّحْرَ‌ۖ فَلَأُقَطِّعَ<tajweed class=ghunnah>نّ</tajweed>َ أَيْدِيَكُمْ وَأَرْجُلَك<tajweed class=idgham_shafawi>ُم م</tajweed>ِّنْ خِلَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>فٍ و</tajweed>َلَأُصَلِّبَ<tajweed class=ghunnah>نّ</tajweed>َكُمْ فِى جُذُوعِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َخْلِ وَلَتَعْلَمُ<tajweed class=ghunnah>نّ</tajweed>َ أَيُّن<tajweed class=madda_obligatory>َآ</tajweed> أَشَدُّ عَذَا<tajweed class=idgham_ghunnah>بًا و</tajweed>َأَ<tajweed class=qalaqah>بْ</tajweed>قَىٰ <span class=end>٧١</span>","End":"٧١","PageNumber":316,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":272,"MaqraNumber":126,"HizbNumber":32,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":72,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالُواْ لَن نُّؤۡثِرَكَ عَلَىٰ مَا جَآءَنَا مِنَ ٱلۡبَيِّنَٰتِ وَٱلَّذِي فَطَرَنَاۖ فَٱقۡضِ مَآ أَنتَ قَاضٍۖ إِنَّمَا تَقۡضِي هَٰذِهِ ٱلۡحَيَوٰةَ ٱلدُّنۡيَآ","TajweedText":"قَالُو<tajweed class=slnt>اْ</tajweed> ل<tajweed class=idgham_ghunnah>َن ن</tajweed>ُّؤْثِرَكَ عَلَىٰ مَا ج<tajweed class=madda_obligatory>َا</tajweed>ٓءَنَا مِنَ <tajweed class=ham_wasl>ٱ</tajweed>لْبَيِّنَ<tajweed class=madda_normal>ـٰ</tajweed>تِ وَ<tajweed class=ham_wasl>ٱ</tajweed>لَّذِى فَطَرَنَا‌ۖ فَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=qalaqah>قْ</tajweed>ضِ م<tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=ikhafa>نت</tajweed>َ قَاضٍ‌ۖ إِ<tajweed class=ghunnah>نّ</tajweed>َمَا تَ<tajweed class=qalaqah>قْ</tajweed>ضِى هَ<tajweed class=madda_normal>ـٰ</tajweed>ذِهِ <tajweed class=ham_wasl>ٱ</tajweed>لْحَيَ<tajweed class=slnt>و</tajweed><tajweed class=madda_normal>ٲ</tajweed>ةَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>دُّنْيَآ <span class=end>٧٢</span>","End":"٧٢","PageNumber":316,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":272,"MaqraNumber":126,"HizbNumber":32,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":73,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّآ ءَامَنَّا بِرَبِّنَا لِيَغۡفِرَ لَنَا خَطَٰيَٰنَا وَمَآ أَكۡرَهۡتَنَا عَلَيۡهِ مِنَ ٱلسِّحۡرِۗ وَٱللَّهُ خَيۡرٞ وَأَبۡقَىٰٓ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed><tajweed class=madda_obligatory>َآ</tajweed> ءَامَ<tajweed class=ghunnah>نّ</tajweed>َا بِرَبِّنَا لِيَغْفِرَ لَنَا خَطَ<tajweed class=madda_normal>ـٰ</tajweed>يَ<tajweed class=madda_normal>ـٰ</tajweed>نَا وَم<tajweed class=madda_obligatory>َآ</tajweed> أَكْرَهْتَنَا عَلَيْهِ مِنَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سِّحْرِ‌ۗ وَ<tajweed class=ham_wasl>ٱ</tajweed>للَّهُ خَيْ<tajweed class=idgham_ghunnah>رٌ و</tajweed>َأَ<tajweed class=qalaqah>بْ</tajweed>قَىٰٓ <span class=end>٧٣</span>","End":"٧٣","PageNumber":316,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":272,"MaqraNumber":126,"HizbNumber":32,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":74,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّهُۥ مَن يَأۡتِ رَبَّهُۥ مُجۡرِمٗا فَإِنَّ لَهُۥ جَهَنَّمَ لَا يَمُوتُ فِيهَا وَلَا يَحۡيَىٰ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> م<tajweed class=idgham_ghunnah>َن ي</tajweed>َأْتِ رَبَّهُ<tajweed class=madda_normal>ۥ</tajweed> مُ<tajweed class=qalaqah>جْ</tajweed>رِ<tajweed class=ikhafa>مًا ف</tajweed>َإِ<tajweed class=ghunnah>نّ</tajweed>َ لَهُ<tajweed class=madda_normal>ۥ</tajweed> جَهَ<tajweed class=ghunnah>نّ</tajweed>َمَ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ <span class=end>٧٤</span>","End":"٧٤","PageNumber":316,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":272,"MaqraNumber":126,"HizbNumber":32,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":75,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَن يَأۡتِهِۦ مُؤۡمِنٗا قَدۡ عَمِلَ ٱلصَّـٰلِحَٰتِ فَأُوْلَـٰٓئِكَ لَهُمُ ٱلدَّرَجَٰتُ ٱلۡعُلَىٰ","TajweedText":"وَم<tajweed class=idgham_ghunnah>َن ي</tajweed>َأْتِه<tajweed class=madda_normal>ِۦ</tajweed> مُؤْمِ<tajweed class=ikhafa>نًا ق</tajweed>َ<tajweed class=qalaqah>دْ</tajweed> عَمِلَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>صَّ<tajweed class=madda_normal>ـٰ</tajweed>لِحَ<tajweed class=madda_normal>ـٰ</tajweed>تِ فَأُ<tajweed class=slnt>وْ</tajweed>لَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ئِكَ لَهُمُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>دَّرَجَ<tajweed class=madda_normal>ـٰ</tajweed>تُ <tajweed class=ham_wasl>ٱ</tajweed>لْعُلَىٰ <span class=end>٧٥</span>","End":"٧٥","PageNumber":316,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":272,"MaqraNumber":126,"HizbNumber":32,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":76,"ShowSurahName":false,"ShowBismillah":false,"Text":"جَنَّـٰتُ عَدۡنٖ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ خَٰلِدِينَ فِيهَاۚ وَذَٰلِكَ جَزَآءُ مَن تَزَكَّىٰ","TajweedText":"جَ<tajweed class=ghunnah>نّ</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed>تُ عَ<tajweed class=qalaqah>دْ</tajweed><tajweed class=ikhafa>نٍ ت</tajweed>َ<tajweed class=qalaqah>جْ</tajweed>رِى مِ<tajweed class=ikhafa>ن ت</tajweed>َحْتِهَا <tajweed 