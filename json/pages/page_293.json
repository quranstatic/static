{"PageNumber":293,"Verses":[{"SurahNumber":17,"SurahIndex":"017","VerseNumber":105,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَبِٱلۡحَقِّ أَنزَلۡنَٰهُ وَبِٱلۡحَقِّ نَزَلَۗ وَمَآ أَرۡسَلۡنَٰكَ إِلَّا مُبَشِّرٗا وَنَذِيرٗا","TajweedText":"وَبِ<tajweed class=ham_wasl>ٱ</tajweed>لْحَقِّ أَ<tajweed class=ikhafa>نز</tajweed>َلْنَ<tajweed class=madda_normal>ـٰ</tajweed>هُ وَبِ<tajweed class=ham_wasl>ٱ</tajweed>لْحَقِّ نَزَلَ‌ۗ وَم<tajweed class=madda_obligatory>َآ</tajweed> أَرْسَلْنَ<tajweed class=madda_normal>ـٰ</tajweed>كَ إِلَّا مُبَشِّ<tajweed class=idgham_ghunnah>رًا و</tajweed>َنَذِيرًا <span class=end>١٠٥</span>","End":"١٠٥","PageNumber":293,"JuzNumber":15,"ManzilNumber":4,"RukuNumber":251,"MaqraNumber":117,"HizbNumber":30,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":17,"SurahIndex":"017","VerseNumber":106,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَقُرۡءَانٗا فَرَقۡنَٰهُ لِتَقۡرَأَهُۥ عَلَى ٱلنَّاسِ عَلَىٰ مُكۡثٖ وَنَزَّلۡنَٰهُ تَنزِيلٗا","TajweedText":"وَقُرْءَا<tajweed class=ikhafa>نًا ف</tajweed>َرَ<tajweed class=qalaqah>قْ</tajweed>نَ<tajweed class=madda_normal>ـٰ</tajweed>هُ لِتَ<tajweed class=qalaqah>قْ</tajweed>رَأَهُ<tajweed class=madda_normal>ۥ</tajweed> عَلَى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َاسِ عَلَىٰ مُكْ<tajweed class=idgham_ghunnah>ثٍ و</tajweed>َنَزَّلْنَ<tajweed class=madda_normal>ـٰ</tajweed>هُ تَ<tajweed class=ikhafa>نز</tajweed>ِيلاً <span class=end>١٠٦</span>","End":"١٠٦","PageNumber":293,"JuzNumber":15,"ManzilNumber":4,"RukuNumber":251,"MaqraNumber":117,"HizbNumber":30,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":17,"SurahIndex":"017","VerseNumber":107,"ShowSurahName":false,"ShowBismillah":false,"Text":"قُلۡ ءَامِنُواْ بِهِۦٓ أَوۡ لَا تُؤۡمِنُوٓاْۚ إِنَّ ٱلَّذِينَ أُوتُواْ ٱلۡعِلۡمَ مِن قَبۡلِهِۦٓ إِذَا يُتۡلَىٰ عَلَيۡهِمۡ يَخِرُّونَۤ لِلۡأَذۡقَانِۤ سُجَّدٗاۤ","TajweedText":"قُلْ ءَامِنُو<tajweed class=slnt>اْ</tajweed> بِه<tajweed 