normal>َٲ</tajweed>تِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>شَّيْطَ<tajweed class=madda_normal>ـٰ</tajweed>نِ‌ۚ إِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> لَكُمْ عَدُ<tajweed class=idgham_ghunnah>وٌّ م</tajweed>ُّب<tajweed class=madda_permissible>ِي</tajweed>نٌ <span class=end>٢٠٨</span>","End":"٢٠٨","PageNumber":32,"JuzNumber":2,"ManzilNumber":1,"RukuNumber":26,"MaqraNumber":13,"HizbNumber":4,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":2,"SurahIndex":"002","VerseNumber":209,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَإِن زَلَلۡتُم مِّنۢ بَعۡدِ مَا جَآءَتۡكُمُ ٱلۡبَيِّنَٰتُ فَٱعۡلَمُوٓاْ أَنَّ ٱللَّهَ عَزِيزٌ حَكِيمٌ","TajweedText":"فَإِ<tajweed class=ikhafa>ن ز</tajweed>َلَلْت<tajweed class=idgham_shafawi>ُم م</tajweed>ّ<tajweed class=iqlab>ِنۢ ب</tajweed>َعْدِ مَا ج<tajweed class=madda_obligatory>َا</tajweed>ٓءَتْكُمُ <tajweed class=ham_wasl>ٱ</tajweed>لْبَيِّنَ<tajweed class=madda_normal>ـٰ</tajweed>تُ فَ<tajweed class=ham_wasl>ٱ</tajweed>عْلَم<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> أَ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>للَّهَ عَزِيزٌ حَك<tajweed class=madda_permissible>ِي</tajweed>مٌ <span class=end>٢٠٩</span>","End":"٢٠٩","PageNumber":32,"JuzNumber":2,"ManzilNumber":1,"RukuNumber":26,"MaqraNumber":13,"HizbNumber":4,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":2,"SurahIndex":"002","VerseNumber":210,"ShowSurahName":false,"ShowBismillah":false,"Text":"هَلۡ يَنظُرُونَ إِلَّآ أَن يَأۡتِيَهُمُ ٱللَّهُ فِي ظُلَلٖ مِّنَ ٱلۡغَمَامِ وَٱلۡمَلَـٰٓئِكَةُ وَقُضِيَ ٱلۡأَمۡرُۚ وَإِلَى ٱللَّهِ تُرۡجَعُ ٱلۡأُمُورُ","TajweedText":"هَلْ يَ<tajweed class=ikhafa>نظ</tajweed>ُرُونَ إِلّ<tajweed class=madda_obligatory>َآ</tajweed> أ<tajweed class=idgham_ghunnah>َن ي</tajweed>َأْتِيَهُمُ <tajweed class=ham_wasl>ٱ</tajweed>للَّهُ فِى ظُلَ<tajweed class=idgham_ghunnah>لٍ م</tajweed>ِّنَ <tajweed class=ham_wasl>ٱ</ta