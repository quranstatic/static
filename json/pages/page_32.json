{"PageNumber":32,"Verses":[{"SurahNumber":2,"SurahIndex":"002","VerseNumber":203,"ShowSurahName":false,"ShowBismillah":false,"Text":"۞وَٱذۡكُرُواْ ٱللَّهَ فِيٓ أَيَّامٖ مَّعۡدُودَٰتٖۚ فَمَن تَعَجَّلَ فِي يَوۡمَيۡنِ فَلَآ إِثۡمَ عَلَيۡهِ وَمَن تَأَخَّرَ فَلَآ إِثۡمَ عَلَيۡهِۖ لِمَنِ ٱتَّقَىٰۗ وَٱتَّقُواْ ٱللَّهَ وَٱعۡلَمُوٓاْ أَنَّكُمۡ إِلَيۡهِ تُحۡشَرُونَ","TajweedText":"۞ وَ<tajweed class=ham_wasl>ٱ</tajweed>ذْكُرُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed>للَّهَ ف<tajweed class=madda_obligatory>ِىٓ</tajweed> أَيَّا<tajweed class=idgham_ghunnah>مٍ م</tajweed>َّعْدُود<tajweed class=madda_normal>َٲ</tajweed><tajweed class=ikhafa>تٍ‌ۚ ف</tajweed>َمَ<tajweed class=ikhafa>ن ت</tajweed>َعَجَّلَ فِى يَوْمَيْنِ فَل<tajweed class=madda_obligatory>َآ</tajweed> إِثْمَ عَلَيْهِ وَمَ<tajweed class=ikhafa>ن ت</tajweed>َأَخَّرَ فَل<tajweed class=madda_obligatory>َآ</tajweed> إِثْمَ عَلَيْهِ‌ۚ لِمَنِ <tajweed class=ham_wasl>ٱ</tajweed>تَّقَىٰ‌ۗ وَ<tajweed class=ham_wasl>ٱ</tajweed>تَّقُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed>للَّهَ وَ<tajweed class=ham_wasl>ٱ</tajweed>عْلَم<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> أَ<tajweed class=ghunnah>نّ</tajweed>َكُمْ إِلَيْهِ تُحْشَر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٠٣</span>","End":"٢٠٣","PageNumber":32,"JuzNumber":2,"ManzilNumber":1,"RukuNumber":26,"MaqraNumber":13,"HizbNumber":4,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":2,"SurahIndex":"002","VerseNumber":204,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمِنَ ٱلنَّاسِ مَن يُعۡجِبُكَ قَوۡلُهُۥ فِي ٱلۡحَيَوٰةِ ٱلدُّنۡيَا وَيُشۡهِدُ ٱللَّهَ عَلَىٰ مَا فِي قَلۡبِهِۦ وَهُوَ أَلَدُّ ٱلۡخِصَامِ","TajweedText":"وَمِنَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َاسِ م<tajweed class=idgham_ghunnah>َن ي</tajweed>ُعْجِبُكَ قَوْلُهُ<tajweed class=madda_normal>ۥ</tajweed> فِى <tajweed class=ham_w