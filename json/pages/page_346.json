{"PageNumber":346,"Verses":[{"SurahNumber":23,"SurahIndex":"023","VerseNumber":60,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَٱلَّذِينَ يُؤۡتُونَ مَآ ءَاتَواْ وَّقُلُوبُهُمۡ وَجِلَةٌ أَنَّهُمۡ إِلَىٰ رَبِّهِمۡ رَٰجِعُونَ","TajweedText":"وَ<tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ يُؤْتُونَ م<tajweed class=madda_obligatory>َآ</tajweed> ءَاتَو<tajweed class=slnt>اْ</tajweed> وَّقُلُوبُهُمْ وَجِلَةٌ أَ<tajweed class=ghunnah>نّ</tajweed>َهُمْ إِلَىٰ رَبِّهِمْ ر<tajweed class=madda_normal>َٲ</tajweed>جِع<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٠</span>","End":"٦٠","PageNumber":346,"JuzNumber":18,"ManzilNumber":4,"RukuNumber":298,"MaqraNumber":138,"HizbNumber":35,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":23,"SurahIndex":"023","VerseNumber":61,"ShowSurahName":false,"ShowBismillah":false,"Text":"أُوْلَـٰٓئِكَ يُسَٰرِعُونَ فِي ٱلۡخَيۡرَٰتِ وَهُمۡ لَهَا سَٰبِقُونَ","TajweedText":"أُ<tajweed class=slnt>وْ</tajweed>لَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ئِكَ يُسَ<tajweed class=madda_normal>ـٰ</tajweed>رِعُونَ فِى <tajweed class=ham_wasl>ٱ</tajweed>لْخَيْر<tajweed class=madda_normal>َٲ</tajweed>تِ وَهُمْ لَهَا سَ<tajweed class=madda_normal>ـٰ</tajweed>بِق<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦١</span>","End":"٦١","PageNumber":346,"JuzNumber":18,"ManzilNumber":4,"RukuNumber":298,"MaqraNumber":138,"HizbNumber":35,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":23,"SurahIndex":"023","VerseNumber":62,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَا نُكَلِّفُ نَفۡسًا إِلَّا وُسۡعَهَاۚ وَلَدَيۡنَا كِتَٰبٞ يَنطِقُ بِٱلۡحَقِّ وَهُمۡ لَا يُظۡلَمُونَ","TajweedText":"وَلَا نُكَلِّفُ نَفْسًا إِلَّا وُسْعَهَا‌ۖ وَلَدَيْنَا كِتَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>بٌ ي</tajweed>َ<tajweed class=ikhafa>نط</tajweed>ِقُ بِ<tajweed class=ham_wasl>ٱ</tajweed>لْحَقِّ‌ۚ وَهُمْ لَا يُظْلَم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٢</span>","End":"٦٢","PageNumber":346,"JuzNumber":18,"ManzilNumber":4,"RukuNumber":298,"MaqraNumber":138,"HizbNumber":35,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":23,"SurahIndex":"023","VerseNumber":63,"ShowSurahName":false,"ShowBismillah":false,"Text":"بَلۡ قُلُوبُهُمۡ فِي غَمۡرَةٖ مِّنۡ هَٰذَا وَلَهُمۡ أَعۡمَٰلٞ مِّن دُونِ ذَٰلِكَ هُمۡ لَهَا عَٰمِلُونَ","TajweedText":"بَلْ قُلُوبُهُمْ فِى غَمْرَ<tajweed class=idgham_ghunnah>ةٍ م</tajweed>ِّنْ هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا وَلَهُمْ أَعْمَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>لٌ م</tajweed>ِّ<tajweed class=ikhafa>ن د</tajweed>ُونِ ذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ هُمْ لَهَا عَ<tajweed class=madda_normal>ـٰ</tajweed>مِل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٣</span>","End":"٦٣","PageNumber":346,"JuzNumber":18,"ManzilNumber":4,"RukuNumber":298,"MaqraNumber":138,"HizbNumber":35,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":23,"SurahIndex":"023","VerseNumber":64,"ShowSurahName":false,"ShowBismillah":false,"Text":"حَتَّىٰٓ إِذَآ أَخَذۡنَا مُتۡرَفِيهِم بِٱلۡعَذَابِ إِذَا هُمۡ يَجۡـَٔرُونَ","TajweedText":"حَتَّ<tajweed class=madda_obligatory>ىٰٓ</tajweed> إِذ<tajweed class=madda_obligatory>َآ</tajweed> أَخَذْنَا مُتْرَفِيه<tajweed class=ikhafa_shafawi>ِم ب</tajweed>ِ<tajweed class=ham_wasl>ٱ</tajweed>لْعَذَابِ إِذَا هُمْ يَ<tajweed class=qalaqah>جْ</tajweed>ــَٔر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٤</span>","End":"٦٤","PageNumber":346,"JuzNumber":18,"ManzilNumber":4,"RukuNumber":298,"MaqraNumber":138,"HizbNumber":35,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":23,"SurahIndex":"023","VerseNumber":65,"ShowSurahName":false,"ShowBismillah":false,"Text":"لَا تَجۡـَٔرُواْ ٱلۡيَوۡمَۖ إِنَّكُم مِّنَّا لَا تُنصَرُونَ","TajweedText":"لَا تَ<tajweed class=qalaqah>جْ</tajweed>ــَٔرُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed>لْيَوْمَ‌ۖ إِ<tajweed class=ghunnah>نّ</tajweed>َك<tajweed class=idgham_shafawi>ُم م</tajweed>ِّ<tajweed class=ghunnah>نّ</tajweed>َا لَا تُ<tajweed class=ikhafa>نص</tajweed>َر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٥</span>","End":"٦٥","PageNumber":346,"JuzNumber":18,"ManzilNumber":4,"RukuNumber":298,"MaqraNumber":138,"HizbNumber":35,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":23,"SurahIndex":"023","VerseNumber":66,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَدۡ كَانَتۡ ءَايَٰتِي تُتۡلَىٰ عَلَيۡكُمۡ فَكُنتُمۡ عَلَىٰٓ أَعۡقَٰبِكُمۡ تَنكِصُونَ","TajweedText":"قَ<tajweed class=qalaqah>دْ</tajweed> كَانَتْ ءَايَ<tajweed class=madda_normal>ـٰ</tajweed>تِى تُتْلَىٰ عَلَيْكُمْ فَكُ<tajweed class=ikhafa>نت</tajweed>ُمْ عَلَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> أَعْقَ<tajweed class=madda_normal>ـٰ</tajweed>بِكُمْ تَ<tajweed class=ikhafa>نك</tajweed>ِص<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٦</span>","End":"٦٦","PageNumber":346,"JuzNumber":18,"ManzilNumber":4,"RukuNumber":298,"MaqraNumber":138,"HizbNumber":35,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":23,"SurahIndex":"023","VerseNumber":67,"ShowSurahName":false,"ShowBismillah":false,"Text":"مُسۡتَكۡبِرِينَ بِهِۦ سَٰمِرٗا تَهۡجُرُونَ","TajweedText":"مُسْتَكْبِرِينَ بِه<tajweed class=madda_normal>ِۦ</tajweed> سَ<tajweed class=madda_normal>ـٰ</tajweed>مِ<tajweed class=ikhafa>رًا ت</tajweed>َهْجُر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٧</span>","End":"٦٧","PageNumber":346,"JuzNumber":18,"ManzilNumber":4,"RukuNumber":298,"MaqraNumber":138,"HizbNumber":35,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":23,"SurahIndex":"023","VerseNumber":68,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَفَلَمۡ يَدَّبَّرُواْ ٱلۡقَوۡلَ أَمۡ جَآءَهُم مَّا لَمۡ يَأۡتِ ءَابَآءَهُمُ ٱلۡأَوَّلِينَ","TajweedText":"أَفَلَمْ يَدَّبَّرُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed>لْقَوْلَ أَمْ ج<tajweed class=madda_obligatory>َا</tajweed>ٓءَه<tajweed class=idgham_shafawi>ُم م</tajweed>َّا لَمْ يَأْتِ ءَاب<tajweed class=madda_obligatory>َا</tajweed>ٓءَهُمُ <tajweed class=ham_wasl>ٱ</tajweed>لْأَوَّل<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٦٨</span>","End":"٦٨","PageNumber":346,"JuzNumber":18,"ManzilNumber":4,"RukuNumber":298,"MaqraNumber":138,"HizbNumber":35,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":23,"SurahIndex":"023","VerseNumber":69,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَمۡ لَمۡ يَعۡرِفُواْ رَسُولَهُمۡ فَهُمۡ لَهُۥ مُنكِرُونَ","TajweedText":"أَمْ لَمْ يَعْرِفُو<tajweed class=slnt>اْ</tajweed> رَسُولَهُمْ فَهُمْ لَهُ<tajweed class=madda_normal>ۥ</tajweed> مُ<tajweed class=ikhafa>نك</tajweed>ِر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٩</span>","End":"٦٩","PageNumber":346,"JuzNumber":18,"ManzilNumber":4,"RukuNumber":298,"MaqraNumber":138,"HizbNumber":35,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":23,"SurahIndex":"023","VerseNumber":70,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَمۡ يَقُولُونَ بِهِۦ جِنَّةُۢۚ بَلۡ جَآءَهُم بِٱلۡحَقِّ وَأَكۡثَرُهُمۡ لِلۡحَقِّ كَٰرِهُونَ","TajweedText":"أَمْ يَقُولُونَ بِه<tajweed class=madda_normal>ِۦ</tajweed> جِ<tajweed class=ghunnah>نّ</tajweed>َ<tajweed class=iqlab>ةُۢ‌ۚ ب</tajweed>َلْ ج<tajweed class=madda_obligatory>َا</tajweed>ٓءَه<tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِ<tajweed class=ham_wasl>ٱ</tajweed>لْحَقِّ وَأَكْثَرُهُمْ لِلْحَقِّ كَ<tajweed class=madda_normal>ـٰ</tajweed>رِه<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٧٠</span>","End":"٧٠","PageNumber":346,"JuzNumber":18,"ManzilNumber":4,"RukuNumber":298,"MaqraNumber":138,"HizbNumber":35,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":23,"SurahIndex":"023","VerseNumber":71,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَوِ ٱتَّبَعَ ٱلۡحَقُّ أَهۡوَآءَهُمۡ لَفَسَدَتِ ٱلسَّمَٰوَٰتُ وَٱلۡأَرۡضُ وَمَن فِيهِنَّۚ بَلۡ أَتَيۡنَٰهُم بِذِكۡرِهِمۡ فَهُمۡ عَن ذِكۡرِهِم مُّعۡرِضُونَ","TajweedText":"وَلَوِ <tajweed class=ham_wasl>ٱ</tajweed>تَّبَعَ <tajweed class=ham_wasl>ٱ</tajweed>لْحَقُّ أَهْو<tajweed class=madda_obligatory>َا</tajweed>ٓءَهُمْ لَفَسَدَتِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّمَ<tajweed class=madda_normal>ـٰ</tajweed>و<tajweed class=madda_normal>َٲ</tajweed>تُ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضُ وَمَ<tajweed class=ikhafa>ن ف</tajweed>ِيهِ<tajweed class=ghunnah>نّ</tajweed>َ‌ۚ بَلْ أَتَيْنَ<tajweed class=madda_normal>ـٰ</tajweed>ه<tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِذِكْرِهِمْ فَهُمْ عَ<tajweed class=ikhafa>ن ذ</tajweed>ِكْرِه<tajweed class=idgham_shafawi>ِم م</tajweed>ُّعْرِض<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٧١</span>","End":"٧١","PageNumber":346,"JuzNumber":18,"ManzilNumber":4,"RukuNumber":298,"MaqraNumber":138,"HizbNumber":35,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":23,"SurahIndex":"023","VerseNumber":72,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَمۡ تَسۡـَٔلُهُمۡ خَرۡجٗا فَخَرَاجُ رَبِّكَ خَيۡرٞۖ وَهُوَ خَيۡرُ ٱلرَّـٰزِقِينَ","TajweedText":"أَمْ تَسْــَٔلُهُمْ خَرْ<tajweed class=ikhafa>جًا ف</tajweed>َخَرَاجُ رَبِّكَ خَيْ<tajweed class=idgham_ghunnah>رٌ‌ۖ و</tajweed>َهُوَ خَيْرُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رّ<tajweed class=madda_normal>َٲ</tajweed>زِق<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٧٢</span>","End":"٧٢","PageNumber":346,"JuzNumber":18,"ManzilNumber":4,"RukuNumber":298,"MaqraNumber":138,"HizbNumber":35,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":23,"SurahIndex":"023","VerseNumber":73,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِنَّكَ لَتَدۡعُوهُمۡ إِلَىٰ صِرَٰطٖ مُّسۡتَقِيمٖ","TajweedText":"وَإِ<tajweed class=ghunnah>نّ</tajweed>َكَ لَتَ<tajweed class=qalaqah>دْ</tajweed>عُوهُمْ إِلَىٰ صِر<tajweed class=madda_normal>َٲ</tajweed><tajweed class=idgham_ghunnah>طٍ م</tajweed>ُّسْتَق<tajweed class=madda_permissible>ِي</tajweed>مٍ <span class=end>٧٣</span>","End":"٧٣","PageNumb