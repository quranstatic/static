{"PageNumber":396,"Verses":[{"SurahNumber":28,"SurahIndex":"028","VerseNumber":85,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّ ٱلَّذِي فَرَضَ عَلَيۡكَ ٱلۡقُرۡءَانَ لَرَآدُّكَ إِلَىٰ مَعَادٖۚ قُل رَّبِّيٓ أَعۡلَمُ مَن جَآءَ بِٱلۡهُدَىٰ وَمَنۡ هُوَ فِي ضَلَٰلٖ مُّبِينٖ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى فَرَضَ عَلَيْكَ <tajweed class=ham_wasl>ٱ</tajweed>لْقُرْءَانَ لَر<tajweed class=madda_necessary>َا</tajweed>ٓدُّكَ إِلَىٰ مَعَا<tajweed class=ikhafa>دٍ‌ۚ ق</tajweed>ُ<tajweed class=idgham_mutaqaribayn>ل</tajweed> رَّبّ<tajweed class=madda_obligatory>ِىٓ</tajweed> أَعْلَمُ مَ<tajweed class=ikhafa>ن ج</tajweed><tajweed class=madda_obligatory>َا</tajweed>ٓءَ بِ<tajweed class=ham_wasl>ٱ</tajweed>لْهُدَىٰ وَمَنْ هُوَ فِى ضَلَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>لٍ م</tajweed>ُّب<tajweed class=madda_permissible>ِي</tajweed>نٍ <span class=end>٨٥</span>","End":"٨٥","PageNumber":396,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":341,"MaqraNumber":158,"HizbNumber":40,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":28,"SurahIndex":"028","VerseNumber":86,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَا كُنتَ تَرۡجُوٓاْ أَن يُلۡقَىٰٓ إِلَيۡكَ ٱلۡكِتَٰبُ إِلَّا رَحۡمَةٗ مِّن رَّبِّكَۖ فَلَا تَكُونَنَّ ظَهِيرٗا لِّلۡكَٰفِرِينَ","TajweedText":"وَمَا كُ<tajweed class=ikhafa>نت</tajweed>َ تَرْج<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> أ<tajweed class=idgham_ghunnah>َن ي</tajweed>ُلْقَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> إِلَيْكَ <tajweed class=ham_wasl>ٱ</tajweed>لْكِتَ<tajweed class=madda_normal>ـٰ</tajweed>بُ إِلَّا رَحْمَ<tajweed class=idgham_ghunnah>ةً م</tajweed>ّ<tajweed class=idgham_wo_ghunnah>ِن ر</tajweed>َّبِّكَ‌ۖ فَلَا تَكُونَ<tajweed class=ghunnah>نّ</tajweed>َ ظَهِي<tajweed class=idgham_wo_ghunnah>رًا ل</tajweed>ِّلْكَ<tajweed class=madda_normal>ـٰ</tajweed>فِر<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٨٦</span>","End":"٨٦","PageNumber":396,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":341,"MaqraNumber":158,"HizbNumber":40,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":28,"SurahIndex":"028","VerseNumber":87,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَا يَصُدُّنَّكَ عَنۡ ءَايَٰتِ ٱللَّهِ بَعۡدَ إِذۡ أُنزِلَتۡ إِلَيۡكَۖ وَٱدۡعُ إِلَىٰ رَبِّكَۖ وَلَا تَكُونَنَّ مِنَ ٱلۡمُشۡرِكِينَ","TajweedText":"وَلَا يَصُدُّ<tajweed class=ghunnah>نّ</tajweed>َكَ عَنْ ءَايَ<tajweed class=madda_normal>ـٰ</tajweed>تِ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ بَعْدَ إِذْ أُ<tajweed class=ikhafa>نز</tajweed>ِلَتْ إِلَيْكَ‌ۖ وَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=qalaqah>دْ</tajweed>عُ إِلَىٰ رَبِّكَ‌ۖ وَلَا تَكُونَ<tajweed class=ghunnah>نّ</tajweed>َ مِنَ <tajweed class=ham_wasl>ٱ</tajweed>لْمُشْرِك<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٨٧</span>","End":"٨٧","PageNumber":396,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":341,"MaqraNumber":158,"HizbNumber":40,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":28,"SurahIndex":"028","VerseNumber":88,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَا تَدۡعُ مَعَ ٱللَّهِ إِلَٰهًا ءَاخَرَۘ لَآ إِلَٰهَ إِلَّا هُوَۚ كُلُّ شَيۡءٍ هَالِكٌ إِلَّا وَجۡهَهُۥۚ لَهُ ٱلۡحُكۡمُ وَإِلَيۡهِ تُرۡجَعُونَ","TajweedText":"وَلَا تَ<tajweed class=qalaqah>دْ</tajweed>عُ مَعَ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ إِلَ<tajweed class=madda_normal>ـٰ</tajweed>هًا ءَاخَرَ‌ۘ ل<tajweed class=madda_obligatory>َآ</tajweed> إِلَ<tajweed class=madda_normal>ـٰ</tajweed>هَ إِلَّا هُوَ‌ۚ كُلُّ شَىْءٍ هَالِكٌ إِلَّا وَ<tajweed class=qalaqah>جْ</tajweed>هَهُ<tajweed class=madda_normal>ۥ</tajweed>‌ۚ لَهُ <tajweed class=ham_wasl>ٱ</tajweed>لْحُكْمُ وَإِلَيْهِ تُرْجَع<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٨٨</span>","End":"٨٨","PageNumber":396,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":341,"MaqraNumber":158,"HizbNumber":40,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":29,"SurahIndex":"029","VerseNumber":1,"ShowSurahName":true,"ShowBismillah":true,"Text":"الٓمٓ","TajweedText":"ا<tajweed class=madda_necessary>لٓ</tajweed><tajweed class=madda_necessary>مٓ</tajweed> <span class=end>١</span>","End":"١","PageNumber":396,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":342,"MaqraNumber":159,"HizbNumber":40,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":29,"SurahIndex":"029","VerseNumber":2,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَحَسِبَ ٱلنَّاسُ أَن يُتۡرَكُوٓاْ أَن يَقُولُوٓاْ ءَامَنَّا وَهُمۡ لَا يُفۡتَنُونَ","TajweedText":"أَحَسِبَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َاسُ أ<tajweed class=idgham_ghunnah>َن ي</tajweed>ُتْرَك<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> أ<tajweed class=idgham_ghunnah>َن ي</tajweed>َقُول<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> ءَامَ<tajweed class=ghunnah>نّ</tajweed>َا وَهُمْ لَا يُفْتَن<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢</span>","End":"٢","PageNumber":396,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":342,"MaqraNumber":159,"HizbNumber":40,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":29,"SurahIndex":"029","VerseNumber":3,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَقَدۡ فَتَنَّا ٱلَّذِينَ مِن قَبۡلِهِمۡۖ فَلَيَعۡلَمَنَّ ٱللَّهُ ٱلَّذِينَ صَدَقُواْ وَلَيَعۡلَمَنَّ ٱلۡكَٰذِبِينَ","TajweedText":"وَلَقَ<tajweed class=qalaqah>دْ</tajweed> فَتَ<tajweed class=ghunnah>نّ</tajweed>َا <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ مِ<tajweed class=ikhafa>ن ق</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>لِهِمْ‌ۖ فَلَيَعْلَمَ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>للَّهُ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ صَدَقُو<tajweed class=slnt>اْ</tajweed> وَلَيَعْلَمَ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>لْكَ<tajweed class=madda_normal>ـٰ</tajweed>ذِب<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٣</span>","End":"٣","PageNumber":396,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":342,"MaqraNumber":159,"HizbNumber":40,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":29,"SurahIndex":"029","VerseNumber":4,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَمۡ حَسِبَ ٱلَّذِينَ يَعۡمَلُونَ ٱلسَّيِّـَٔاتِ أَن يَسۡبِقُونَاۚ سَآءَ مَا يَحۡكُمُونَ","TajweedText":"أَمْ حَسِبَ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ يَعْمَلُونَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّيِّـَٔـاتِ أ<tajweed class=idgham_ghunnah>َن ي</tajweed>َسْبِقُونَا‌ۚ س<tajweed class=madda_obligatory>َا</tajweed>ٓءَ مَا يَحْكُم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٤</span>","End":"٤","PageNumber":396,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":342,"MaqraNumber":159,"HizbNumber":40,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":29,"SurahIndex":"029","VerseNumber":5,"ShowSurahName":false,"ShowBismillah":false,"Text":"مَن كَانَ يَرۡجُواْ لِقَآءَ ٱللَّهِ فَإِنَّ أَجَلَ ٱللَّهِ لَأٓتٖۚ وَهُوَ ٱلسَّمِيعُ ٱلۡعَلِيمُ","TajweedText":"مَ<tajweed class=ikhafa>ن ك</tajweed>َانَ يَرْجُو<tajweed class=slnt>اْ</tajweed> لِق<tajweed class=madda_obligatory>َا</tajweed>ٓءَ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ فَإِ<tajweed class=ghunnah>نّ</tajweed>َ أَجَلَ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ لَأَ<tajweed class=idgham_ghunnah>تٍ‌ۚ و</tajweed>َهُوَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّمِيعُ <tajweed class=ham_wasl>ٱ</tajweed>لْعَل<tajweed class=madda_permissible>ِي</tajweed>مُ <span class=end>٥</span>","End":"٥","PageNumber":396,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":342,"MaqraNumber":159,"HizbNumber":40,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":29,"SurahIndex":"029","VerseNumber":6,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَن جَٰهَدَ فَإِنَّمَا يُجَٰهِدُ لِنَفۡسِهِۦٓۚ إِنَّ ٱللَّهَ لَغَنِيٌّ عَنِ ٱلۡعَٰلَمِينَ","TajweedText":"وَمَ<tajweed class=ikhafa>ن ج</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed>هَدَ فَإِ<tajweed class=ghunnah>نّ</tajweed>َمَا يُجَ<tajweed class=madda_normal>ـٰ</tajweed>هِدُ لِنَفْسِه<tajweed class=madda_obligatory>ِۦٓ‌ۚ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>للَّهَ لَغَنِىٌّ عَنِ <tajweed class=ham_wasl>ٱ</tajweed>لْعَ<tajweed class=madda_normal>ـٰ</tajweed>لَم<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٦</span>","End":"٦","PageNumber":396,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":342,"MaqraNumber":159,"HizbNumber":40,"HizbDecimal":0.5,"HasSajda":false}]}