missible>ِي</tajweed>نَ <span class=end>٨٥</span>","End":"٨٥","PageNumber":218,"JuzNumber":11,"ManzilNumber":3,"RukuNumber":180,"MaqraNumber":87,"HizbNumber":22,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":10,"SurahIndex":"010","VerseNumber":86,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَنَجِّنَا بِرَحۡمَتِكَ مِنَ ٱلۡقَوۡمِ ٱلۡكَٰفِرِينَ","TajweedText":"وَنَجِّنَا بِرَحْمَتِكَ مِنَ <tajweed class=ham_wasl>ٱ</tajweed>لْقَوْمِ <tajweed class=ham_wasl>ٱ</tajweed>لْكَ<tajweed class=madda_normal>ـٰ</tajweed>فِر<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٨٦</span>","End":"٨٦","PageNumber":218,"JuzNumber":11,"ManzilNumber":3,"RukuNumber":180,"MaqraNumber":87,"HizbNumber":22,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":10,"SurahIndex":"010","VerseNumber":87,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَأَوۡحَيۡنَآ إِلَىٰ مُوسَىٰ وَأَخِيهِ أَن تَبَوَّءَا لِقَوۡمِكُمَا بِمِصۡرَ بُيُوتٗا وَٱجۡعَلُواْ بُيُوتَكُمۡ قِبۡلَةٗ وَأَقِيمُواْ ٱلصَّلَوٰةَۗ وَبَشِّرِ ٱلۡمُؤۡمِنِينَ","TajweedText":"وَأَوْحَيْن<tajweed class=madda_obligatory>َآ</tajweed> إِلَىٰ مُوسَىٰ وَأَخِيهِ أَ<tajweed class=ikhafa>ن ت</tajweed>َبَوَّءَا لِقَوْمِكُمَا بِمِصْرَ بُيُو<tajweed class=idgham_ghunnah>تًا و</tajweed>َ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=qalaqah>جْ</tajweed>عَلُو<tajweed class=slnt>اْ</tajweed> بُيُوتَكُمْ قِ<tajweed class=qalaqah>بْ</tajweed>لَ<tajweed class=idgham_ghunnah>ةً و</tajweed>َأَقِيمُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>صَّلَ<tajweed class=slnt>و</tajweed><tajweed class=madda_normal>ٲ</tajweed>ةَ‌ۗ وَبَشِّرِ <tajweed class=ham_wasl>ٱ</tajweed>لْمُؤْمِن<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٨٧</span>","End":"٨٧","PageNumber":218,"JuzNumber":11,"ManzilNumber":3,"RukuNumber":180,"MaqraNumber":87,"HizbNumber":22,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":10,"SurahIndex":"010","VerseNumber":88,"ShowSurahName":false,"Sh