{"PageNumber":303,"Verses":[{"SurahNumber":18,"SurahIndex":"018","VerseNumber":84,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّا مَكَّنَّا لَهُۥ فِي ٱلۡأَرۡضِ وَءَاتَيۡنَٰهُ مِن كُلِّ شَيۡءٖ سَبَبٗا","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َا مَكَّ<tajweed class=ghunnah>نّ</tajweed>َا لَهُ<tajweed class=madda_normal>ۥ</tajweed> فِى <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ وَءَاتَيْنَ<tajweed class=madda_normal>ـٰ</tajweed>هُ مِ<tajweed class=ikhafa>ن ك</tajweed>ُلِّ ش<tajweed class=ikhafa>َىْءٍ س</tajweed>َبَبًا <span class=end>٨٤</span>","End":"٨٤","PageNumber":303,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":262,"MaqraNumber":121,"HizbNumber":31,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":18,"SurahIndex":"018","VerseNumber":85,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَأَتۡبَعَ سَبَبًا","TajweedText":"فَأَتْبَعَ سَبَبًا <span class=end>٨٥</span>","End":"٨٥","PageNumber":303,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":262,"MaqraNumber":121,"HizbNumber":31,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":18,"SurahIndex":"018","VerseNumber":86,"ShowSurahName":false,"ShowBismillah":false,"Text":"حَتَّىٰٓ إِذَا بَلَغَ مَغۡرِبَ ٱلشَّمۡسِ وَجَدَهَا تَغۡرُبُ فِي عَيۡنٍ حَمِئَةٖ وَوَجَدَ عِندَهَا قَوۡمٗاۖ قُلۡنَا يَٰذَا ٱلۡقَرۡنَيۡنِ إِمَّآ أَن تُعَذِّبَ وَإِمَّآ أَن تَتَّخِذَ فِيهِمۡ حُسۡنٗا","TajweedText":"حَتَّ<tajweed class=madda_obligatory>ىٰٓ</tajweed> إِذَا بَلَغَ مَغْرِبَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>شَّمْسِ وَجَدَهَا تَغْرُبُ فِى عَيْنٍ حَمِئَ<tajweed class=idgham_ghunnah>ةٍ و</tajweed>َوَجَدَ عِ<tajweed class=ikhafa>ند</tajweed>َهَا قَوْ<tajweed class=ikhafa>مًا‌ۗ ق</tajweed>ُلْنَا يَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا <tajweed class=ham_wasl>ٱ</tajweed>لْقَرْنَيْنِ إِ<tajweed class=ghunnah>مّ</tajweed><tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=ikhafa>ن ت</tajweed>ُعَذِّبَ وَإِ<tajweed class=ghunnah>مّ</tajweed><tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=ikhafa>ن ت</tajweed>َتَّخِذَ فِيهِمْ حُسْنًا <span class=end>٨٦</span>","End":"٨٦","PageNumber":303,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":262,"MaqraNumber":121,"HizbNumber":31,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":18,"SurahIndex":"018","VerseNumber":87,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَ أَمَّا مَن ظَلَمَ فَسَوۡفَ نُعَذِّبُهُۥ ثُمَّ يُرَدُّ إِلَىٰ رَبِّهِۦ فَيُعَذِّبُهُۥ عَذَابٗا نُّكۡرٗا","TajweedText":"قَالَ أَ<tajweed class=ghunnah>مّ</tajweed>َا مَ<tajweed class=ikhafa>ن ظ</tajweed>َلَمَ فَسَوْفَ نُعَذِّبُهُ<tajweed class=madda_normal>ۥ</tajweed> ثُ<tajweed class=ghunnah>مّ</tajweed>َ يُرَدُّ إِلَىٰ رَبِّه<tajweed class=madda_normal>ِۦ</tajweed> فَيُعَذِّبُهُ<tajweed class=madda_normal>ۥ</tajweed> عَذَا<tajweed class=idgham_ghunnah>بًا ن</tajweed>ُّكْرًا <span class=end>٨٧</span>","End":"٨٧","PageNumber":303,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":262,"MaqraNumber":121,"HizbNumber":31,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":18,"SurahIndex":"018","VerseNumber":88,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَأَمَّا مَنۡ ءَامَنَ وَعَمِلَ صَٰلِحٗا فَلَهُۥ جَزَآءً ٱلۡحُسۡنَىٰۖ وَسَنَقُولُ لَهُۥ مِنۡ أَمۡرِنَا يُسۡرٗا","TajweedText":"وَأَ<tajweed class=ghunnah>مّ</tajweed>َا مَنْ ءَامَنَ وَعَمِلَ صَ<tajweed class=madda_normal>ـٰ</tajweed>لِ<tajweed class=ikhafa>حًا ف</tajweed>َلَهُ<tajweed class=madda_normal>ۥ</tajweed> جَز<tajweed class=madda_obligatory>َا</tajweed>ٓءً <tajweed class=ham_wasl>ٱ</tajweed>لْحُسْنَىٰ‌ۖ وَسَنَقُولُ لَهُ<tajweed class=madda_normal>ۥ</tajweed> مِنْ أَمْرِنَا يُسْرًا <span class=end>٨٨</span>","End":"٨٨","PageNumber":303,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":262,"MaqraNumber":121,"HizbNumber":31,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":18,"SurahIndex":"018","VerseNumber":89,"ShowSurahName":false,"ShowBismillah":false,"Text":"ثُمَّ أَتۡبَعَ سَبَبًا","TajweedText":"ثُ<tajweed class=ghunnah>مّ</tajweed>َ أَتْبَعَ سَبَبًا <span