tajweed class=qalaqah>دْ</tajweed>مًا <span class=end>٩٥</span>","End":"٩٥","PageNumber":303,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":262,"MaqraNumber":121,"HizbNumber":31,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":18,"SurahIndex":"018","VerseNumber":96,"ShowSurahName":false,"ShowBismillah":false,"Text":"ءَاتُونِي زُبَرَ ٱلۡحَدِيدِۖ حَتَّىٰٓ إِذَا سَاوَىٰ بَيۡنَ ٱلصَّدَفَيۡنِ قَالَ ٱنفُخُواْۖ حَتَّىٰٓ إِذَا جَعَلَهُۥ نَارٗا قَالَ ءَاتُونِيٓ أُفۡرِغۡ عَلَيۡهِ قِطۡرٗا","TajweedText":"ءَاتُونِى زُبَرَ <tajweed class=ham_wasl>ٱ</tajweed>لْحَدِيدِ‌ۖ حَتَّ<tajweed class=madda_obligatory>ىٰٓ</tajweed> إِذَا سَاوَىٰ بَيْنَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>صَّدَفَيْنِ قَالَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=ikhafa>نف</tajweed>ُخُو<tajweed class=slnt>اْ‌ۖ</tajweed> حَتَّ<tajweed class=madda_obligatory>ىٰٓ</tajweed> إِذَا جَعَلَهُ<tajweed class=madda_normal>ۥ</tajweed> نَا<tajweed class=ikhafa>رًا ق</tajweed>َالَ ءَاتُون<tajweed class=madda_obligatory>ِىٓ</tajweed> أُفْرِغْ عَلَيْهِ قِ<tajweed class=qalaqah>طْ</tajweed>رًا <span class=end>٩٦</span>","End":"٩٦","PageNumber":303,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":262,"MaqraNumber":121,"HizbNumber":31,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":18,"SurahIndex":"018","VerseNumber":97,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَمَا ٱسۡطَٰعُوٓاْ أَن يَظۡهَرُوهُ وَمَا ٱسۡتَطَٰعُواْ لَهُۥ نَقۡبٗا","TajweedText":"فَمَا <tajweed class=ham_wasl>ٱ</tajweed>سْطَ<tajweed class=madda_normal>ـٰ</tajweed>ع<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> أ<tajweed class=idgham_ghunnah>َن ي</tajweed>َظْهَرُوهُ وَمَا <tajweed class=ham_wasl>ٱ</tajweed>سْتَطَ<tajweed class=madda_normal>ـٰ</tajweed>عُو<tajweed class=slnt>اْ</tajweed> لَهُ<tajweed class=madda_normal>ۥ</tajweed> نَ<tajweed class=qalaqah>قْ</tajweed>بًا <span class=end>٩٧</span>","End":"٩٧","PageNumber":303,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":262,"Maq