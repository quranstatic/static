{"PageNumber":235,"Verses":[{"SurahNumber":11,"SurahIndex":"011","VerseNumber":118,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَوۡ شَآءَ رَبُّكَ لَجَعَلَ ٱلنَّاسَ أُمَّةٗ وَٰحِدَةٗۖ وَلَا يَزَالُونَ مُخۡتَلِفِينَ","TajweedText":"وَلَوْ ش<tajweed class=madda_obligatory>َا</tajweed>ٓءَ رَبُّكَ لَجَعَلَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َاسَ أُ<tajweed class=ghunnah>مّ</tajweed>َ<tajweed class=idgham_ghunnah>ةً و</tajweed><tajweed class=madda_normal>َٲ</tajweed>حِدَ<tajweed class=idgham_ghunnah>ةً‌ۖ و</tajweed>َلَا يَزَالُونَ مُخْتَلِف<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١١٨</span>","End":"١١٨","PageNumber":235,"JuzNumber":12,"ManzilNumber":3,"RukuNumber":192,"MaqraNumber":94,"HizbNumber":24,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":11,"SurahIndex":"011","VerseNumber":119,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِلَّا مَن رَّحِمَ رَبُّكَۚ وَلِذَٰلِكَ خَلَقَهُمۡۗ وَتَمَّتۡ كَلِمَةُ رَبِّكَ لَأَمۡلَأَنَّ جَهَنَّمَ مِنَ ٱلۡجِنَّةِ وَٱلنَّاسِ أَجۡمَعِينَ","TajweedText":"إِلَّا م<tajweed class=idgham_wo_ghunnah>َن ر</tajweed>َّحِمَ رَبُّكَ‌ۚ وَلِذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ خَلَقَهُمْ‌ۗ وَتَ<tajweed class=ghunnah>مّ</tajweed>َتْ كَلِمَةُ رَبِّكَ لَأَمْلَأَ<tajweed class=ghunnah>نّ</tajweed>َ جَهَ<tajweed class=ghunnah>نّ</tajweed>َمَ مِنَ <tajweed class=ham_wasl>ٱ</tajweed>لْجِ<tajweed class=ghunnah>نّ</tajweed>َةِ وَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َاسِ أَ<tajweed class=qalaqah>جْ</tajweed>مَع<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١١٩</span>","End":"١١٩","PageNumber":235,"JuzNumber":12,"ManzilNumber":3,"RukuNumber":192,"MaqraNumber":94,"HizbNumber":24,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":11,"SurahIndex":"011","VerseNumber":120,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَكُلّٗا نَّقُصُّ عَلَيۡكَ مِنۡ أَنۢبَآءِ ٱلرُّسُلِ مَا نُثَبِّتُ بِهِۦ فُؤَادَكَۚ وَجَآءَكَ فِي هَٰذِهِ ٱلۡحَقُّ وَمَوۡعِظَةٞ وَذِكۡرَىٰ لِلۡمُؤۡمِنِينَ","TajweedText":"وَكُل<tajweed class=idgham_ghunnah>اًّ ن</tajweed>َّقُصُّ عَلَيْكَ مِنْ أَ<tajweed class=iqlab>نۢب</tajweed><tajweed class=madda_obligatory>َا</tajweed>ٓءِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رُّسُلِ مَا نُثَبِّتُ بِه<tajweed class=madda_normal>ِۦ</tajweed> فُؤَادَكَ‌ۚ وَج<tajweed class=madda_obligatory>َا</tajweed>ٓءَكَ فِى هَ<tajweed class=madda_normal>ـٰ</tajweed>ذِهِ <tajweed class=ham_wasl>ٱ</tajweed>لْحَقُّ وَمَوْعِظَ<tajweed class=idgham_ghunnah>ةٌ و</tajweed>َذِكْرَىٰ لِلْمُؤْمِن<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٢٠</span>","End":"١٢٠","PageNumber":235,"JuzNumber":12,"ManzilNumber":3,"RukuNumber":192,"MaqraNumber":94,"HizbNumber":24,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":11,"SurahIndex":"011","VerseNumber":121,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَقُل لِّلَّذِينَ لَا يُؤۡمِنُونَ ٱعۡمَلُواْ عَلَىٰ مَكَانَتِكُمۡ إِنَّا عَٰمِلُونَ","TajweedText":"وَقُل لِّلَّذِينَ لَا يُؤْمِنُونَ <tajweed class=ham_wasl>ٱ</tajweed>عْمَلُو<tajweed class=slnt>اْ</tajweed> عَلَىٰ مَكَانَتِكُمْ إِ<tajweed class=ghunnah>نّ</tajweed>َا عَ<tajweed class=madda_normal>ـٰ</tajweed>مِل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٢١</span>","End":"١٢١","PageNumber":235,"JuzNumber":12,"ManzilNumber":3,"RukuNumber":192,"MaqraNumber":94,"HizbNumber":24,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":11,"SurahIndex":"011","VerseNumber":122,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَٱنتَظِرُوٓاْ إِنَّا مُنتَظِرُونَ","TajweedText":"وَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=ikhafa>نت</tajweed>َظِر<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َا مُ<tajweed class=ikhafa>نت</tajweed>َظِر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٢٢</span>","End":"١٢٢","PageNumber":235,"JuzNumber":12,"ManzilNumber":3,"RukuNumber":192,"MaqraNumber":94,"HizbNumber":24,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":11,"SurahIndex":"011","VerseNumber":123,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلِلَّهِ غَيۡبُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَإِلَيۡهِ يُرۡجَعُ ٱلۡأَمۡرُ كُلُّهُۥ فَٱعۡبُدۡهُ وَتَوَكَّلۡ عَلَيۡهِۚ وَمَا رَبُّكَ بِغَٰفِلٍ عَمَّا تَعۡمَلُونَ","TajweedText":"وَلِلَّهِ غَيْبُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّمَ<tajweed class=madda_normal>ـٰ</tajweed>و<tajweed class=madda_normal>َٲ</tajweed>تِ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ وَإِلَيْهِ يُرْجَعُ <tajweed class=ham_wasl>ٱ</tajweed>لْأَمْرُ كُلُّهُ<tajweed class=madda_normal>ۥ</tajweed> فَ<tajweed class=ham_wasl>ٱ</tajweed>عْبُ<tajweed class=qalaqah>دْ</tajweed>هُ وَتَوَكَّلْ عَلَيْهِ‌ۚ وَمَا رَبُّكَ بِغَ<tajweed class=madda_normal>ـٰ</tajweed>فِلٍ عَ<tajweed class=ghunnah>مّ</tajweed>َا تَعْمَل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٢٣</span>","End":"١٢٣","PageNumber":235,"JuzNumber":12,"ManzilNumber":3,"RukuNumber":192,"MaqraNumber":94,"HizbNumber":24,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":12,"SurahIndex":"012","VerseNumber":1,"ShowSurahName":true,"ShowBismillah":true,"Text":"الٓرۚ تِلۡكَ ءَايَٰتُ ٱلۡكِتَٰبِ ٱلۡمُبِينِ","TajweedText":"ا<tajweed class=madda_necessary>لٓ</tajweed>ر‌ۚ تِلْكَ ءَايَ<tajweed class=madda_normal>ـٰ</tajweed>تُ <tajweed class=ham_wasl>ٱ</tajweed>لْكِتَ<tajweed class=madda_normal>ـٰ</tajweed>بِ <tajweed class=ham_wasl>ٱ</tajweed>لْمُب<tajweed class=madda_permissible>ِي</tajweed>نِ <span class=end>١</span>","End":"١","PageNumber":235,"JuzNumber":12,"ManzilNumber":3,"RukuNumber":193,"MaqraNumber":94,"HizbNumber":24,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":12,"SurahIndex":"012","VerseNumber":2,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّآ أَنزَلۡنَٰهُ قُرۡءَٰنًا عَرَبِيّٗا لَّعَلَّكُمۡ تَعۡقِلُونَ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed><tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=ikhafa>نز</tajweed>َلْنَ<tajweed class=madda_normal>ـٰ</tajweed>هُ قُرْء<tajweed class=madda_normal>َٲ</tajweed>نًا عَرَبِي<tajweed class=idgham_wo_ghunnah>ًّا ل</tajweed>َّعَلَّكُمْ تَعْقِل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢</span>","End":"٢","PageNumber":235,"JuzNumber":12,"ManzilNumber":3,"RukuNumber":193,"MaqraNumber":94,"HizbNumber":24,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":12,"SurahIndex":"012","VerseNumber":3,"ShowSurahName":false,"ShowBismillah":false,"Text":"نَحۡنُ نَقُصُّ عَلَيۡكَ أَحۡسَنَ ٱلۡقَصَصِ بِمَآ أَوۡحَيۡنَآ إِلَيۡكَ هَٰذَا ٱلۡقُرۡءَانَ وَإِن كُنتَ مِن قَبۡلِهِۦ لَمِنَ ٱلۡغَٰفِلِينَ","TajweedText":"نَحْنُ نَقُصُّ عَلَيْكَ أَحْسَنَ <tajweed class=ham_wasl>ٱ</tajweed>لْقَصَصِ بِم<tajweed class=madda_obligatory>َآ</tajweed> أَوْحَيْن<tajweed class=madda_obligatory>َآ</tajweed> إِلَيْكَ هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا <tajweed class=ham_wasl>ٱ</tajweed>لْقُرْءَانَ وَإِ<tajweed class=ikhafa>ن ك</tajweed>ُ<tajweed class=ikhafa>نت</tajweed>َ مِ<tajweed class=ikhafa>ن ق</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>لِه<tajweed class=madda_normal>ِۦ</tajweed> لَمِنَ <tajweed class=ham_wasl>ٱ</tajweed>لْغَ<tajweed class=madda_normal>ـٰ</tajweed>فِل<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٣</span>","End":"٣","PageNumber":235,"JuzNumber":12,"ManzilNumber":3,"RukuNumber":193,"MaqraNumber":94,"HizbNumber":24,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":12,"SurahIndex":"012","VerseNumber":4,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِذۡ قَالَ يُوسُفُ لِأَبِيهِ يَـٰٓأَبَتِ إِنِّي رَأَيۡتُ أَحَدَ عَشَرَ كَوۡكَبٗا وَٱلشَّمۡسَ وَٱلۡقَمَرَ رَأَيۡتُهُمۡ لِي سَٰجِدِينَ","TajweedText":"إِذْ قَالَ يُوسُفُ لِأَبِيهِ يَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>أَبَتِ إِ<tajweed class=ghunnah>نّ</tajweed>ِى رَأَيْتُ أَحَدَ عَشَرَ كَوْكَ<tajweed class=idgham_ghunnah>بًا و</tajweed>َ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>شَّمْسَ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْقَمَرَ رَأَيْتُهُمْ لِى سَ<tajweed class=madda_normal>ـٰ</tajweed>جِد<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٤</span>","End":"٤","PageNumber":235,"JuzNumber":12,"ManzilNumber":3,"RukuNumber":193,"MaqraNumber":94,"HizbNumber":24,"HizbDecimal":0.25,"HasSajda":false}]}