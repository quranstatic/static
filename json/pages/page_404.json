{"PageNumber":404,"Verses":[{"SurahNumber":29,"SurahIndex":"029","VerseNumber":64,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَا هَٰذِهِ ٱلۡحَيَوٰةُ ٱلدُّنۡيَآ إِلَّا لَهۡوٞ وَلَعِبٞۚ وَإِنَّ ٱلدَّارَ ٱلۡأٓخِرَةَ لَهِيَ ٱلۡحَيَوَانُۚ لَوۡ كَانُواْ يَعۡلَمُونَ","TajweedText":"وَمَا هَ<tajweed class=madda_normal>ـٰ</tajweed>ذِهِ <tajweed class=ham_wasl>ٱ</tajweed>لْحَيَ<tajweed class=slnt>و</tajweed><tajweed class=madda_normal>ٲ</tajweed>ةُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>دُّنْي<tajweed class=madda_obligatory>َآ</tajweed> إِلَّا لَهْ<tajweed class=idgham_ghunnah>وٌ و</tajweed>َلَعِ<tajweed class=idgham_ghunnah>بٌ‌ۚ و</tajweed>َإِ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>دَّارَ <tajweed class=ham_wasl>ٱ</tajweed>لْأَخِرَةَ لَهِىَ <tajweed class=ham_wasl>ٱ</tajweed>لْحَيَوَانُ‌ۚ لَوْ كَانُو<tajweed class=slnt>اْ</tajweed> يَعْلَم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٤</span>","End":"٦٤","PageNumber":404,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":348,"MaqraNumber":161,"HizbNumber":41,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":29,"SurahIndex":"029","VerseNumber":65,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَإِذَا رَكِبُواْ فِي ٱلۡفُلۡكِ دَعَوُاْ ٱللَّهَ مُخۡلِصِينَ لَهُ ٱلدِّينَ فَلَمَّا نَجَّىٰهُمۡ إِلَى ٱلۡبَرِّ إِذَا هُمۡ يُشۡرِكُونَ","TajweedText":"فَإِذَا رَكِبُو<tajweed class=slnt>اْ</tajweed> فِى <tajweed class=ham_wasl>ٱ</tajweed>لْفُلْكِ دَعَوُ<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed>للَّهَ مُخْلِصِينَ لَهُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>دِّينَ فَلَ<tajweed class=ghunnah>مّ</tajweed>َا نَجَّ<tajweed class=madda_normal>ـٰ</tajweed>هُمْ إِلَى <tajweed class=ham_wasl>ٱ</tajweed>لْبَرِّ إِذَا هُمْ يُشْرِك<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٥</span>","End":"٦٥","PageNumber":404,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":348,"MaqraNumber":161,"HizbNumber":41,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":29,"SurahIndex":"029","VerseNumber":66,"ShowSurahName":false,"ShowBismillah":false,"Text":"لِيَكۡفُرُواْ بِمَآ ءَاتَيۡنَٰهُمۡ وَلِيَتَمَتَّعُواْۚ فَسَوۡفَ يَعۡلَمُونَ","TajweedText":"لِيَكْفُرُو<tajweed class=slnt>اْ</tajweed> بِم<tajweed class=madda_obligatory>َآ</tajweed> ءَاتَيْنَ<tajweed class=madda_normal>ـٰ</tajweed>هُمْ وَلِيَتَمَتَّعُو<tajweed class=slnt>اْ‌ۖ</tajweed> فَسَوْفَ يَعْلَم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٦</span>","End":"٦٦","PageNumber":404,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":348,"MaqraNumber":161,"HizbNumber":41,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":29,"SurahIndex":"029","VerseNumber":67,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَوَلَمۡ يَرَوۡاْ أَنَّا جَعَلۡنَا حَرَمًا ءَامِنٗا وَيُتَخَطَّفُ ٱلنَّاسُ مِنۡ حَوۡلِهِمۡۚ أَفَبِٱلۡبَٰطِلِ يُؤۡمِنُونَ وَبِنِعۡمَةِ ٱللَّهِ يَكۡفُرُونَ","TajweedText":"أَوَلَمْ يَرَوْ<tajweed class=slnt>اْ</tajweed> أَ<tajweed class=ghunnah>نّ</tajweed>َا جَعَلْنَا حَرَمًا ءَامِ<tajweed class=idgham_ghunnah>نًا و</tajweed>َيُتَخَطَّفُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َاسُ مِنْ حَوْلِهِمْ‌ۚ أَفَبِ<tajweed class=ham_wasl>ٱ</tajweed>لْبَ<tajweed class=madda_normal>ـٰ</tajweed>طِلِ يُؤْمِنُونَ وَبِنِعْمَةِ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ يَكْفُر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٧</span>","End":"٦٧","PageNumber":404,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":348,"MaqraNumber":161,"HizbNumber":41,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":29,"SurahIndex":"029","VerseNumber":68,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَنۡ أَظۡلَمُ مِمَّنِ ٱفۡتَرَىٰ عَلَى ٱللَّهِ كَذِبًا أَوۡ كَذَّبَ بِٱلۡحَقِّ لَمَّا جَآءَهُۥٓۚ أَلَيۡسَ فِي جَهَنَّمَ مَثۡوٗى لِّلۡكَٰفِرِينَ","TajweedText":"وَمَنْ أَظْلَمُ مِ<tajweed clas