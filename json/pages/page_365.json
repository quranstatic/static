tajweed class=madda_normal>ـٰ</tajweed>هِلُونَ قَالُو<tajweed class=slnt>اْ</tajweed> سَلَ<tajweed class=madda_normal>ـٰ</tajweed>مًا <span class=end>٦٣</span>","End":"٦٣","PageNumber":365,"JuzNumber":19,"ManzilNumber":4,"RukuNumber":315,"MaqraNumber":146,"HizbNumber":37,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":25,"SurahIndex":"025","VerseNumber":64,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَٱلَّذِينَ يَبِيتُونَ لِرَبِّهِمۡ سُجَّدٗا وَقِيَٰمٗا","TajweedText":"وَ<tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ يَبِيتُونَ لِرَبِّهِمْ سُجَّ<tajweed class=idgham_ghunnah>دًا و</tajweed>َقِيَ<tajweed class=madda_normal>ـٰ</tajweed>مًا <span class=end>٦٤</span>","End":"٦٤","PageNumber":365,"JuzNumber":19,"ManzilNumber":4,"RukuNumber":315,"MaqraNumber":146,"HizbNumber":37,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":25,"SurahIndex":"025","VerseNumber":65,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَٱلَّذِينَ يَقُولُونَ رَبَّنَا ٱصۡرِفۡ عَنَّا عَذَابَ جَهَنَّمَۖ إِنَّ عَذَابَهَا كَانَ غَرَامًا","TajweedText":"وَ<tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ يَقُولُونَ رَبَّنَا <tajweed class=ham_wasl>ٱ</tajweed>صْرِفْ عَ<tajweed class=ghunnah>نّ</tajweed>َا عَذَابَ جَهَ<tajweed class=ghunnah>نّ</tajweed>َمَ‌ۖ إِ<tajweed class=ghunnah>نّ</tajweed>َ عَذَابَهَا كَانَ غَرَامًا <span class=end>٦٥</span>","End":"٦٥","PageNumber":365,"JuzNumber":19,"ManzilNumber":4,"RukuNumber":315,"MaqraNumber":146,"HizbNumber":37,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":25,"SurahIndex":"025","VerseNumber":66,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّهَا سَآءَتۡ مُسۡتَقَرّٗا وَمُقَامٗا","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َهَا س<tajweed class=madda_obligatory>َا</tajweed>ٓءَتْ مُسْتَقَر<tajweed class=idgham_ghunnah>ًّا و</tajweed>َمُقَامًا <span class=end>٦٦</span>","End":"٦٦","PageNumber":365,"JuzNumber":19,"ManzilNumber":4,"RukuNumber":315,"MaqraNumber":146,"HizbNumber":37,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":25,"SurahIndex":"025","VerseNumber":67,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَٱلَّذِينَ إِذَآ أَنفَقُواْ لَمۡ يُسۡرِفُواْ وَلَمۡ يَقۡتُرُواْ وَكَانَ بَيۡنَ ذَٰلِكَ قَوَامٗا","TajweedText":"وَ<tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ إِذ<tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=ikhafa>نف</tajweed>َقُو<tajweed class=slnt>اْ</tajweed> لَمْ يُسْرِفُو<tajweed class=slnt>اْ</tajweed> وَلَمْ يَ<tajweed class=qalaqah>قْ</tajweed>تُرُو<tajweed class=slnt>اْ</tajweed> وَكَانَ بَيْنَ ذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ قَوَامًا <span class=end>٦٧</span>","End":"٦٧","PageNumber":365,"JuzNumber":19,"ManzilNumber":4,"RukuNumber":315,"MaqraNumber":146,"HizbNumber":37,"HizbDecimal":0.25,"HasSajda":false}]}