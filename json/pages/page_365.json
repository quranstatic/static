{"PageNumber":365,"Verses":[{"SurahNumber":25,"SurahIndex":"025","VerseNumber":56,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَآ أَرۡسَلۡنَٰكَ إِلَّا مُبَشِّرٗا وَنَذِيرٗا","TajweedText":"وَم<tajweed class=madda_obligatory>َآ</tajweed> أَرْسَلْنَ<tajweed class=madda_normal>ـٰ</tajweed>كَ إِلَّا مُبَشِّ<tajweed class=idgham_ghunnah>رًا و</tajweed>َنَذِيرًا <span class=end>٥٦</span>","End":"٥٦","PageNumber":365,"JuzNumber":19,"ManzilNumber":4,"RukuNumber":314,"MaqraNumber":146,"HizbNumber":37,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":25,"SurahIndex":"025","VerseNumber":57,"ShowSurahName":false,"ShowBismillah":false,"Text":"قُلۡ مَآ أَسۡـَٔلُكُمۡ عَلَيۡهِ مِنۡ أَجۡرٍ إِلَّا مَن شَآءَ أَن يَتَّخِذَ إِلَىٰ رَبِّهِۦ سَبِيلٗا","TajweedText":"قُلْ م<tajweed class=madda_obligatory>َآ</tajweed> أَسْــَٔلُكُمْ عَلَيْهِ مِنْ أَ<tajweed class=qalaqah>جْ</tajweed>رٍ إِلَّا مَ<tajweed class=ikhafa>ن ش</tajweed><tajweed class=madda_obligatory>َا</tajweed>ٓءَ أ<tajweed class=idgham_ghunnah>َن ي</tajweed>َتَّخِذَ إِلَىٰ رَبِّه<tajweed class=madda_normal>ِۦ</tajweed> سَبِيلاً <span class=end>٥٧</span>","End":"٥٧","PageNumber":365,"JuzNumber":19,"ManzilNumber":4,"RukuNumber":314,"MaqraNumber":146,"HizbNumber":37,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":25,"SurahIndex":"025","VerseNumber":58,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَتَوَكَّلۡ عَلَى ٱلۡحَيِّ ٱلَّذِي لَا يَمُوتُ وَسَبِّحۡ بِحَمۡدِهِۦۚ وَكَفَىٰ بِهِۦ بِذُنُوبِ عِبَادِهِۦ خَبِيرًا","TajweedText":"وَتَوَكَّلْ عَلَى <tajweed class=ham_wasl>ٱ</tajweed>لْحَىِّ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى لَا يَمُوتُ وَسَبِّحْ بِحَمْدِه<tajweed class=madda_normal>ِۦ</tajweed>‌ۚ وَكَفَىٰ بِه<tajweed class=madda_normal>ِۦ</tajweed> بِذُنُوبِ عِبَادِه<tajweed class=madda_normal>ِۦ</tajweed> خَبِيرًا <span class=end>٥٨</span>","End":"٥٨","PageNumber":365,"JuzNumber":19,"ManzilNumber":4,"RukuNumber":314,"MaqraNumber":146,"HizbNumber":37,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":25,"SurahIndex":"025","VerseNumber":59,"ShowSurahName":false,"ShowBismillah":false,"Text":"ٱلَّذِي خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ وَمَا بَيۡنَهُمَا فِي سِتَّةِ أَيَّامٖ ثُمَّ ٱسۡتَوَىٰ عَلَى ٱلۡعَرۡشِۖ ٱلرَّحۡمَٰنُ فَسۡـَٔلۡ بِهِۦ خَبِيرٗا","TajweedText":"ٱلَّذِى خَلَقَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّمَ<tajweed class=madda_normal>ـٰ</tajweed>و<tajweed class=madda_normal>َٲ</tajweed>تِ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضَ وَمَا بَيْنَهُمَا فِى سِتَّةِ أَيَّا<tajweed class=ikhafa>مٍ ث</tajweed>ُ<tajweed class=ghunnah>مّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>سْتَوَىٰ عَلَى <tajweed class=ham_wasl>ٱ</tajweed>لْعَرْشِ‌ۚ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رَّحْمَ<tajweed class=madda_normal>ـٰ</tajweed>نُ فَسْــَٔلْ بِه<tajweed class=madda_normal>ِۦ</tajweed> خَبِيرًا <span class=end>٥٩</span>","End":"٥٩","PageNumber":365,"JuzNumber":19,"ManzilNumber":4,"RukuNumber":314,"MaqraNumber":146,"HizbNumber":37,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":25,"SurahIndex":"025","VerseNumber":60,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِذَا قِيلَ لَهُمُ ٱسۡجُدُواْۤ لِلرَّحۡمَٰنِ قَالُواْ وَمَا ٱلرَّحۡمَٰنُ أَنَسۡجُدُ لِمَا تَأۡمُرُنَا وَزَادَهُمۡ نُفُورٗا۩","TajweedText":"وَإِذَا قِيلَ لَهُمُ <tajweed class=ham_wasl>ٱ</tajweed>سْجُدُو<tajweed class=slnt>اْ</tajweed> لِلرَّحْمَ<tajweed class=madda_normal>ـٰ</tajweed>نِ قَالُو<tajweed class=slnt>اْ</tajweed> وَمَا <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رَّحْمَ<tajweed class=madda_normal>ـٰ</tajweed>نُ أَنَسْجُدُ لِمَا تَأْمُرُنَا وَزَادَهُمْ نُفُورًا ۩ <span class=end>٦٠</span>","End":"٦٠","PageNumber":365,"JuzNumber":19,"ManzilNumber":4,"RukuNumber":314,"MaqraNumber":146,"HizbNumber":37,"HizbDecimal":0.25,"HasSajda":true},{"SurahNumber":25,"SurahIndex":"025","VerseNumber":61,"ShowSurahName":false,"ShowBismillah":false,"Text":"تَبَارَكَ ٱلَّذِي جَعَلَ فِي ٱلسَّمَآءِ بُرُ