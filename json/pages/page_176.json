{"PageNumber":176,"Verses":[{"SurahNumber":7,"SurahIndex":"007","VerseNumber":196,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّ وَلِـِّۧيَ ٱللَّهُ ٱلَّذِي نَزَّلَ ٱلۡكِتَٰبَۖ وَهُوَ يَتَوَلَّى ٱلصَّـٰلِحِينَ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َ وَلِــِّۧىَ <tajweed class=ham_wasl>ٱ</tajweed>للَّهُ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى نَزَّلَ <tajweed class=ham_wasl>ٱ</tajweed>لْكِتَ<tajweed class=madda_normal>ـٰ</tajweed>بَ‌ۖ وَهُوَ يَتَوَلَّى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>صَّ<tajweed class=madda_normal>ـٰ</tajweed>لِح<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٩٦</span>","End":"١٩٦","PageNumber":176,"JuzNumber":9,"ManzilNumber":2,"RukuNumber":145,"MaqraNumber":70,"HizbNumber":18,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":7,"SurahIndex":"007","VerseNumber":197,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَٱلَّذِينَ تَدۡعُونَ مِن دُونِهِۦ لَا يَسۡتَطِيعُونَ نَصۡرَكُمۡ وَلَآ أَنفُسَهُمۡ يَنصُرُونَ","TajweedText":"وَ<tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ تَ<tajweed class=qalaqah>دْ</tajweed>عُونَ مِ<tajweed class=ikhafa>ن د</tajweed>ُونِه<tajweed class=madda_normal>ِۦ</tajweed> لَا يَسْتَطِيعُونَ نَصْرَكُمْ وَل<tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=ikhafa>نف</tajweed>ُسَهُمْ يَ<tajweed class=ikhafa>نص</tajweed>ُر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٩٧</span>","End":"١٩٧","PageNumber":176,"JuzNumber":9,"ManzilNumber":2,"RukuNumber":145,"MaqraNumber":70,"HizbNumber":18,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":7,"SurahIndex":"007","VerseNumber":198,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِن تَدۡعُوهُمۡ إِلَى ٱلۡهُدَىٰ لَا يَسۡمَعُواْۖ وَتَرَىٰهُمۡ يَنظُرُونَ إِلَيۡكَ وَهُمۡ لَا يُبۡصِرُونَ","TajweedText":"وَإِ<tajweed class=ikhafa>ن ت</tajweed>َ<tajweed class=qalaqah>دْ</tajweed>عُوهُمْ إِلَى <tajweed class=ham_wasl>ٱ</tajweed>لْهُدَىٰ لَا يَسْمَعُو<tajweed class=slnt>اْ‌ۖ</tajweed> وَتَرَ<tajweed class=madda_normal>ٮٰ</tajweed>هُمْ يَ<tajweed class=ikhafa>نظ</tajweed>ُرُونَ إِلَيْكَ وَهُمْ لَا يُ<tajweed class=qalaqah>بْ</tajweed>صِر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٩٨</span>","End":"١٩٨","PageNumber":176,"JuzNumber":9,"ManzilNumber":2,"RukuNumber":145,"MaqraNumber":70,"HizbNumber":18,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":7,"SurahIndex":"007","VerseNumber":199,"ShowSurahName":false,"ShowBismillah":false,"Text":"خُذِ ٱلۡعَفۡوَ وَأۡمُرۡ بِٱلۡعُرۡفِ وَأَعۡرِضۡ عَنِ ٱلۡجَٰهِلِينَ","TajweedText":"خُذِ <tajweed class=ham_wasl>ٱ</tajweed>لْعَفْوَ وَأْمُرْ بِ<tajweed class=ham_wasl>ٱ</tajweed>لْعُرْفِ وَأَعْرِضْ عَنِ <tajweed class=ham_wasl>ٱ</tajweed>لْجَ<tajweed class=madda_normal>ـٰ</tajweed>هِل<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٩٩</span>","End":"١٩٩","PageNumber":176,"JuzNumber":9,"ManzilNumber":2,"RukuNumber":145,"MaqraNumber":70,"HizbNumber":18,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":7,"SurahIndex":"007","VerseNumber":200,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِمَّا يَنزَغَنَّكَ مِنَ ٱلشَّيۡطَٰنِ نَزۡغٞ فَٱسۡتَعِذۡ بِٱللَّهِۚ إِنَّهُۥ سَمِيعٌ عَلِيمٌ","TajweedText":"وَإِ<tajweed class=ghunnah>مّ</tajweed>َا يَ<tajweed class=ikhafa>نز</tajweed>َغَ<tajweed class=ghunnah>نّ</tajweed>َكَ مِنَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>شَّيْطَ<tajweed class=madda_normal>ـٰ</tajweed>نِ نَزْ<tajweed class=ikhafa>غٌ ف</tajweed>َ<tajweed class=ham_wasl>ٱ</tajweed>سْتَعِذْ بِ<tajweed class=ham_wasl>ٱ</tajweed>للَّهِ‌ۚ إِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> سَمِيعٌ عَل<tajweed class=madda_permissible>ِي</tajweed>مٌ <span class=end>٢٠٠</span>","End":"٢٠٠","PageNumber":176,"JuzNumber":9,"ManzilNumber":2,"RukuNumber":145,"MaqraNumber":70,"HizbNumber":18,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":7,"SurahIndex":"007","VerseNumber":201,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّ ٱلَّذِينَ ٱتَّقَوۡاْ إِذَا مَسَّهُمۡ طَـٰٓئِفٞ مِّنَ ٱلشَّيۡطَٰنِ تَذَكَّرُواْ فَإِذَا هُم مُّبۡصِرُونَ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ <tajweed class=ham_wasl>ٱ</tajweed>تَّقَوْ<tajweed class=slnt>اْ</tajweed> إِذَا مَسَّهُمْ طَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ئِ<tajweed class=idgham_ghunnah>فٌ م</tajweed>ِّنَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>شَّيْطَ<tajweed class=madda_normal>ـٰ</tajweed>نِ تَذَكَّرُو<tajweed class=slnt>اْ</tajweed> فَإِذَا ه<tajweed class=idgham_shafawi>ُم م</tajweed>ُّ<tajweed class=qalaqah>بْ</tajweed>صِر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٠١</span>","End":"٢٠١","PageNumber":176,"JuzNumber":9,"ManzilNumber":2,"RukuNumber":145,"MaqraNumber":70,"HizbNumber":18,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":7,"SurahIndex":"007","VerseNumber":202,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِخۡوَٰنُهُمۡ يَمُدُّونَهُمۡ فِي ٱلۡغَيِّ ثُمَّ لَا يُقۡصِرُونَ","TajweedText":"وَإِخْو<tajweed class=madda_normal>َٲ</tajweed>نُهُمْ يَمُدُّونَهُمْ فِى <tajweed class=ham_wasl>ٱ</tajweed>لْغَىِّ ثُ<tajweed class=ghunnah>مّ</tajweed>َ لَا يُ<tajweed class=qalaqah>قْ</tajweed>صِر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٠٢</span>","End":"٢٠٢","PageNumber":176,"JuzNumber":9,"ManzilNumber":2,"RukuNumber":145,"MaqraNumber":70,"HizbNumber":18,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":7,"SurahIndex":"007","VerseNumber":203,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِذَا لَمۡ تَأۡتِهِم بِـَٔايَةٖ قَالُواْ لَوۡلَا ٱجۡتَبَيۡتَهَاۚ قُلۡ إِنَّمَآ أَتَّبِعُ مَا يُوحَىٰٓ إِلَيَّ مِن رَّبِّيۚ هَٰذَا بَصَآئِرُ مِن رَّبِّكُمۡ وَهُدٗى وَرَحۡمَةٞ لِّقَوۡمٖ يُؤۡمِنُونَ","TajweedText":"وَإِذَا لَمْ تَأْتِه<tajweed class=ikhafa_shafawi>ِم ب</tajweed>ِـَٔـايَ<tajweed class=ikhafa>ةٍ ق</tajweed>َالُو<tajweed class=slnt>اْ</tajweed> لَوْلَا <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=qalaqah>جْ</tajweed>تَبَيْتَهَا‌ۚ قُلْ إِ<tajweed class=ghunnah>نّ</tajweed>َم<tajweed class=madda_obligatory>َآ</tajweed> أَتَّبِعُ مَا يُوحَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> إِلَىَّ م<tajweed class=idgham_wo_ghunnah>ِن ر</tajweed>َّبِّى‌ۚ هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا بَص<tajweed class=madda_obligatory>َا</tajweed>ٓئِرُ م<tajweed class=idgham_wo_ghunnah>ِن ر</tajweed>َّبِّكُمْ وَهُ<tajweed class=idgham_ghunnah>دًى و</tajweed>َرَحْمَ<tajweed class=idgham_wo_ghunnah>ةٌ ل</tajweed>ِّقَوْ<tajweed class=idgham_ghunnah>مٍ ي</tajweed>ُؤْمِن<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٠٣</span>","End":"٢٠٣","PageNumber":176,"JuzNumber":9,"ManzilNumber":2,"RukuNumber":145,"MaqraNumber":70,"HizbNumber":18,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":7,"SurahIndex":"007","VerseNumber":204,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِذَا قُرِئَ ٱلۡقُرۡءَانُ فَٱسۡتَمِعُواْ لَهُۥ وَأَنصِتُواْ لَعَلَّكُمۡ تُرۡحَمُونَ","TajweedText":"وَإِذَا قُرِئَ <tajweed class=ham_wasl>ٱ</tajweed>لْقُرْءَانُ فَ<tajweed class=ham_wasl>ٱ</tajweed>سْتَمِعُو<tajweed class=slnt>اْ</tajweed> لَهُ<tajweed class=madda_normal>ۥ</tajweed> وَأَ<tajweed class=ikhafa>نص</tajweed>ِتُو<tajweed class=slnt>اْ</tajweed> لَعَلَّكُمْ تُرْحَم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٠٤</span>","End":"٢٠٤","PageNumber":176,"JuzNumber":9,"ManzilNumber":2,"RukuNumber":145,"MaqraNumber":70,"HizbNumber":18,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":7,"SurahIndex":"007","VerseNumber":205,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَٱذۡكُر رَّبَّكَ فِي نَفۡسِكَ تَضَرُّعٗا وَخِيفَةٗ وَدُونَ ٱلۡجَهۡرِ مِنَ ٱلۡقَوۡلِ بِٱلۡغُدُوِّ وَٱلۡأٓصَالِ وَلَا تَكُن مِّنَ ٱلۡغَٰفِلِينَ","TajweedText":"وَ<tajweed class=ham_wasl>ٱ</tajweed>ذْكُر رَّبَّكَ فِى نَفْسِكَ تَضَرُّ<tajweed class=idgham_ghunnah>عًا و</tajweed>َخِيفَ<tajweed class=idgham_ghunnah>ةً و</tajweed>َدُونَ <tajweed class=ham_wasl>ٱ</tajweed>لْجَهْرِ مِنَ <tajweed class=ham_wasl>ٱ</tajweed>لْقَوْلِ بِ<tajweed class=ham_wasl>ٱ</tajweed>لْغُدُوِّ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْأَصَالِ وَلَا تَك<tajweed class=idgham_ghunnah>ُن م</tajweed>ِّنَ <tajweed class=ham_wasl>ٱ</tajweed>لْغَ<tajweed class=madda_normal>ـٰ</tajweed>فِل<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٢٠٥</span>","End":"٢٠٥","PageNumber":176,"JuzNumber":9,"ManzilNumber":2,"RukuNumber":145,"MaqraNumber":70,"HizbNumber":18,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":7,"SurahIndex":"007","VerseNumber":206,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّ ٱلَّذِينَ عِندَ رَبِّكَ لَا يَسۡتَكۡبِرُونَ عَنۡ عِبَادَتِهِۦ وَيُسَبِّحُونَهُۥ وَلَهُۥ يَسۡجُدُونَۤ۩","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ عِ<tajweed class=ikhafa>ند</tajweed>َ رَبِّكَ لَا يَسْتَكْبِرُونَ عَنْ عِبَادَتِه<tajweed class=madda_normal>ِۦ</tajweed> وَيُسَبِّحُونَهُ<tajweed class=madda_normal>ۥ</tajweed> وَلَهُ<tajweed class=madda_normal>ۥ</tajweed> يَسْجُدُ<tajweed class=madda_permissible>و</tajweed>نَ ۩ <span class=end>٢٠٦</span>","End":"٢٠٦","PageNumber":176,"JuzNumber":9,"ManzilNumber":2,"RukuNumber":145,"MaqraNumber":70,"HizbNumber":18,"HizbDecimal":0.25,"HasSajda":true}]}