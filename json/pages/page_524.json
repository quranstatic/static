{"PageNumber":524,"Verses":[{"SurahNumber":52,"SurahIndex":"052","VerseNumber":15,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَفَسِحۡرٌ هَٰذَآ أَمۡ أَنتُمۡ لَا تُبۡصِرُونَ","TajweedText":"أَفَسِحْرٌ هَ<tajweed class=madda_normal>ـٰ</tajweed>ذ<tajweed class=madda_obligatory>َآ</tajweed> أَمْ أَ<tajweed class=ikhafa>نت</tajweed>ُمْ لَا تُ<tajweed class=qalaqah>بْ</tajweed>صِر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٥</span>","End":"١٥","PageNumber":524,"JuzNumber":27,"ManzilNumber":7,"RukuNumber":458,"MaqraNumber":209,"HizbNumber":53,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":52,"SurahIndex":"052","VerseNumber":16,"ShowSurahName":false,"ShowBismillah":false,"Text":"ٱصۡلَوۡهَا فَٱصۡبِرُوٓاْ أَوۡ لَا تَصۡبِرُواْ سَوَآءٌ عَلَيۡكُمۡۖ إِنَّمَا تُجۡزَوۡنَ مَا كُنتُمۡ تَعۡمَلُونَ","TajweedText":"ٱصْلَوْهَا فَ<tajweed class=ham_wasl>ٱ</tajweed>صْبِر<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> أَوْ لَا تَصْبِرُو<tajweed class=slnt>اْ</tajweed> سَو<tajweed class=madda_obligatory>َا</tajweed>ٓءٌ عَلَيْكُمْ‌ۖ إِ<tajweed class=ghunnah>نّ</tajweed>َمَا تُ<tajweed class=qalaqah>جْ</tajweed>زَوْنَ مَا كُ<tajweed class=ikhafa>نت</tajweed>ُمْ تَعْمَل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٦</span>","End":"١٦","PageNumber":524,"JuzNumber":27,"ManzilNumber":7,"RukuNumber":458,"MaqraNumber":209,"HizbNumber":53,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":52,"SurahIndex":"052","VerseNumber":17,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّ ٱلۡمُتَّقِينَ فِي جَنَّـٰتٖ وَنَعِيمٖ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>لْمُتَّقِينَ فِى جَ<tajweed class=ghunnah>نّ</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>تٍ و</tajweed>َنَع<tajweed class=madda_permissible>ِي</tajweed>مٍ <span class=end>١٧</span>","End":"١٧","PageNumber":524,"JuzNumber":27,"ManzilNumber":7,"RukuNumber":458,"MaqraNumber":209,