{"PageNumber":490,"Verses":[{"SurahNumber":43,"SurahIndex":"043","VerseNumber":11,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَٱلَّذِي نَزَّلَ مِنَ ٱلسَّمَآءِ مَآءَۢ بِقَدَرٖ فَأَنشَرۡنَا بِهِۦ بَلۡدَةٗ مَّيۡتٗاۚ كَذَٰلِكَ تُخۡرَجُونَ","TajweedText":"وَ<tajweed class=ham_wasl>ٱ</tajweed>لَّذِى نَزَّلَ مِنَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّم<tajweed class=madda_obligatory>َا</tajweed>ٓءِ م<tajweed class=madda_obligatory>َا</tajweed>ٓ<tajweed class=iqlab>ءَۢ ب</tajweed>ِقَدَ<tajweed class=ikhafa>رٍ ف</tajweed>َأَ<tajweed class=ikhafa>نش</tajweed>َرْنَا بِه<tajweed class=madda_normal>ِۦ</tajweed> بَلْدَ<tajweed class=idgham_ghunnah>ةً م</tajweed>َّيْ<tajweed class=ikhafa>تًا‌ۚ ك</tajweed>َذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ تُخْرَج<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١١</span>","End":"١١","PageNumber":490,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":424,"MaqraNumber":196,"HizbNumber":49,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":12,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَٱلَّذِي خَلَقَ ٱلۡأَزۡوَٰجَ كُلَّهَا وَجَعَلَ لَكُم مِّنَ ٱلۡفُلۡكِ وَٱلۡأَنۡعَٰمِ مَا تَرۡكَبُونَ","TajweedText":"وَ<tajweed class=ham_wasl>ٱ</tajweed>لَّذِى خَلَقَ <tajweed class=ham_wasl>ٱ</tajweed>لْأَزْو<tajweed class=madda_normal>َٲ</tajweed>جَ كُلَّهَا وَجَعَلَ لَك<tajweed class=idgham_shafawi>ُم م</tajweed>ِّنَ <tajweed class=ham_wasl>ٱ</tajweed>لْفُلْكِ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْأَنْعَ<tajweed class=madda_normal>ـٰ</tajweed>مِ مَا تَرْكَب<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٢</span>","End":"١٢","PageNumber":490,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":424,"MaqraNumber":196,"HizbNumber":49,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":13,"ShowSurahName":false,"ShowBismillah":false,"Text":"لِتَسۡتَوُۥاْ عَلَىٰ ظُهُورِهِۦ ثُمَّ تَذۡكُرُواْ نِعۡمَةَ رَبِّكُمۡ إِ