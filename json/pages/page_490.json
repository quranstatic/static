 class=ikhafa_shafawi>ُم ب</tajweed>ِذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ مِنْ عِلْمٍ‌ۖ إِنْ هُمْ إِلَّا يَخْرُص<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٠</span>","End":"٢٠","PageNumber":490,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":425,"MaqraNumber":196,"HizbNumber":49,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":21,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَمۡ ءَاتَيۡنَٰهُمۡ كِتَٰبٗا مِّن قَبۡلِهِۦ فَهُم بِهِۦ مُسۡتَمۡسِكُونَ","TajweedText":"أَمْ ءَاتَيْنَ<tajweed class=madda_normal>ـٰ</tajweed>هُمْ كِتَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>بًا م</tajweed>ِّ<tajweed class=ikhafa>ن ق</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>لِه<tajweed class=madda_normal>ِۦ</tajweed> فَه<tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِه<tajweed class=madda_normal>ِۦ</tajweed> مُسْتَمْسِك<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢١</span>","End":"٢١","PageNumber":490,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":425,"MaqraNumber":196,"HizbNumber":49,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":22,"ShowSurahName":false,"ShowBismillah":false,"Text":"بَلۡ قَالُوٓاْ إِنَّا وَجَدۡنَآ ءَابَآءَنَا عَلَىٰٓ أُمَّةٖ وَإِنَّا عَلَىٰٓ ءَاثَٰرِهِم مُّهۡتَدُونَ","TajweedText":"بَلْ قَال<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َا وَجَ<tajweed class=qalaqah>دْ</tajweed>ن<tajweed class=madda_obligatory>َآ</tajweed> ءَاب<tajweed class=madda_obligatory>َا</tajweed>ٓءَنَا عَلَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> أُ<tajweed class=ghunnah>مّ</tajweed>َ<tajweed class=idgham_ghunnah>ةٍ و</tajweed>َإِ<tajweed class=ghunnah>نّ</tajweed>َا عَلَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> ءَاثَ<tajweed class=madda_normal>ـٰ</tajweed>رِه<tajweed class=idgham_shafawi>ِم م</tajweed>ُّهْتَد<tajweed class=madda_permissible>ُو</tajweed>نَ <span cla