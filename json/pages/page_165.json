lass=madda_normal>ـٰ</tajweed>تِ رَبِّنَا لَ<tajweed class=ghunnah>مّ</tajweed>َا ج<tajweed class=madda_obligatory>َا</tajweed>ٓءَتْنَا‌ۚ رَبَّن<tajweed class=madda_obligatory>َآ</tajweed> أَفْرِغْ عَلَيْنَا صَ<tajweed class=qalaqah>بْ</tajweed><tajweed class=idgham_ghunnah>رًا و</tajweed>َتَوَفَّنَا مُسْلِم<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٢٦</span>","End":"١٢٦","PageNumber":165,"JuzNumber":9,"ManzilNumber":2,"RukuNumber":135,"MaqraNumber":66,"HizbNumber":17,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":7,"SurahIndex":"007","VerseNumber":127,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَقَالَ ٱلۡمَلَأُ مِن قَوۡمِ فِرۡعَوۡنَ أَتَذَرُ مُوسَىٰ وَقَوۡمَهُۥ لِيُفۡسِدُواْ فِي ٱلۡأَرۡضِ وَيَذَرَكَ وَءَالِهَتَكَۚ قَالَ سَنُقَتِّلُ أَبۡنَآءَهُمۡ وَنَسۡتَحۡيِۦ نِسَآءَهُمۡ وَإِنَّا فَوۡقَهُمۡ قَٰهِرُونَ","TajweedText":"وَقَالَ <tajweed class=ham_wasl>ٱ</tajweed>لْمَلَأُ مِ<tajweed class=ikhafa>ن ق</tajweed>َوْمِ فِرْعَوْنَ أَتَذَرُ مُوسَىٰ وَقَوْمَهُ<tajweed class=madda_normal>ۥ</tajweed> لِيُفْسِدُو<tajweed class=slnt>اْ</tajweed> فِى <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ وَيَذَرَكَ وَءَالِهَتَكَ‌ۚ قَالَ سَنُقَتِّلُ أَ<tajweed class=qalaqah>بْ</tajweed>ن<tajweed class=madda_obligatory>َا</tajweed>ٓءَهُمْ وَنَسْتَحْى<tajweed class=madda_normal>ِۦ</tajweed> نِس<tajweed class=madda_obligatory>َا</tajweed>ٓءَهُمْ وَإِ<tajweed class=ghunnah>نّ</tajweed>َا فَوْقَهُمْ قَ<tajweed class=madda_normal>ـٰ</tajweed>هِر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٢٧</span>","End":"١٢٧","PageNumber":165,"JuzNumber":9,"ManzilNumber":2,"RukuNumber":136,"MaqraNumber":66,"HizbNumber":17,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":7,"SurahIndex":"007","VerseNumber":128,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَ مُوسَىٰ لِقَوۡمِهِ ٱسۡتَعِينُواْ بِٱللَّهِ وَٱصۡبِرُوٓاْۖ إِنَّ ٱلۡأَرۡضَ لِلَّهِ يُورِثُهَا مَن يَشَآءُ مِنۡ عِبَادِهِۦۖ وَٱلۡعَٰقِبَةُ لِلۡمُتَّقِينَ","TajweedText":"قَالَ مُوسَىٰ لِقَوْمِهِ <tajweed class=ham_wasl>ٱ</tajweed>سْتَعِينُو<tajweed class=slnt>اْ</tajweed> بِ<tajweed class=ham_wasl>ٱ</tajweed>للَّهِ وَ<tajweed class=ham_wasl>ٱ</tajweed>صْبِر<tajweed class=madda_obligatory>ُوٓ<tajweed class=slnt>اْ</tajweed>‌ۖ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضَ لِلَّهِ يُورِثُهَا م<tajweed class=idgham_ghunnah>َن ي</tajweed>َش<tajweed class=madda_obligatory>َا</tajweed>ٓءُ مِنْ عِبَادِه<tajweed class=madda_normal>ِۦ</tajweed>‌ۖ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْعَ<tajweed class=madda_normal>ـٰ</tajweed>قِبَةُ لِلْمُتَّق<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٢٨</span>","End":"١٢٨","PageNumber":165,"JuzNumber":9,"ManzilNumber":2,"RukuNumber":136,"MaqraNumber":66,"HizbNumber":17,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":7,"SurahIndex":"007","VerseNumber":129,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالُوٓاْ أُوذِينَا مِن قَبۡلِ أَن تَأۡتِيَنَا وَمِنۢ بَعۡدِ مَا جِئۡتَنَاۚ قَالَ عَسَىٰ رَبُّكُمۡ أَن يُهۡلِكَ عَدُوَّكُمۡ وَيَسۡتَخۡلِفَكُمۡ فِي ٱلۡأَرۡضِ فَيَنظُرَ كَيۡفَ تَعۡمَلُونَ","TajweedText":"قَال<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> أُوذِينَا مِ<tajweed class=ikhafa>ن ق</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>لِ أَ<tajweed class=ikhafa>ن ت</tajweed>َأْتِيَنَا وَم<tajweed class=iqlab>ِنۢ ب</tajweed>َعْدِ مَا جِئْتَنَا‌ۚ قَالَ عَسَىٰ رَبُّكُمْ أ<tajweed class=idgham_ghunnah>َن ي</tajweed>ُهْلِكَ عَدُوَّكُمْ وَيَسْتَخْلِفَكُمْ فِى <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ فَيَ<tajweed class=ikhafa>نظ</tajweed>ُرَ كَيْفَ تَعْمَل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٢٩</span>","End":"١٢٩","PageNumber":165,"JuzNumber":9,"ManzilNumber":2,"RukuNumber":136,"MaqraNumber":66,"HizbNumber":17,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":7,"SurahIndex":"007","VerseNumber":130,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَقَدۡ أَخَذۡنَآ ءَالَ فِرۡعَوۡنَ بِٱلسِّنِينَ وَنَ