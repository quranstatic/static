{"PageNumber":165,"Verses":[{"SurahNumber":7,"SurahIndex":"007","VerseNumber":121,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالُوٓاْ ءَامَنَّا بِرَبِّ ٱلۡعَٰلَمِينَ","TajweedText":"قَال<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> ءَامَ<tajweed class=ghunnah>نّ</tajweed>َا بِرَبِّ <tajweed class=ham_wasl>ٱ</tajweed>لْعَ<tajweed class=madda_normal>ـٰ</tajweed>لَم<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٢١</span>","End":"١٢١","PageNumber":165,"JuzNumber":9,"ManzilNumber":2,"RukuNumber":135,"MaqraNumber":66,"HizbNumber":17,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":7,"SurahIndex":"007","VerseNumber":122,"ShowSurahName":false,"ShowBismillah":false,"Text":"رَبِّ مُوسَىٰ وَهَٰرُونَ","TajweedText":"رَبِّ مُوسَىٰ وَهَ<tajweed class=madda_normal>ـٰ</tajweed>ر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٢٢</span>","End":"١٢٢","PageNumber":165,"JuzNumber":9,"ManzilNumber":2,"RukuNumber":135,"MaqraNumber":66,"HizbNumber":17,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":7,"SurahIndex":"007","VerseNumber":123,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَ فِرۡعَوۡنُ ءَامَنتُم بِهِۦ قَبۡلَ أَنۡ ءَاذَنَ لَكُمۡۖ إِنَّ هَٰذَا لَمَكۡرٞ مَّكَرۡتُمُوهُ فِي ٱلۡمَدِينَةِ لِتُخۡرِجُواْ مِنۡهَآ أَهۡلَهَاۖ فَسَوۡفَ تَعۡلَمُونَ","TajweedText":"قَالَ فِرْعَوْنُ ءَامَ<tajweed class=ikhafa>نت</tajweed><tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِه<tajweed class=madda_normal>ِۦ</tajweed> قَ<tajweed class=qalaqah>بْ</tajweed>لَ أَنْ ءَاذَنَ لَكُمْ‌ۖ إِ<tajweed class=ghunnah>نّ</tajweed>َ هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا لَمَكْ<tajweed class=idgham_ghunnah>رٌ م</tajweed>َّكَرْتُمُوهُ فِى <tajweed class=ham_wasl>ٱ</tajweed>لْمَدِينَةِ لِتُخْرِجُو<tajweed class=slnt>اْ</tajweed> مِنْه<tajweed class=madda_obligatory>َآ</tajweed> أَهْلَهَا‌ۖ فَسَوْفَ تَعْلَم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٢٣</span>","End":"١٢٣","PageNumber":165,"JuzNumber":9,"M