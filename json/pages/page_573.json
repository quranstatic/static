{"PageNumber":573,"Verses":[{"SurahNumber":72,"SurahIndex":"072","VerseNumber":14,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَأَنَّا مِنَّا ٱلۡمُسۡلِمُونَ وَمِنَّا ٱلۡقَٰسِطُونَۖ فَمَنۡ أَسۡلَمَ فَأُوْلَـٰٓئِكَ تَحَرَّوۡاْ رَشَدٗا","TajweedText":"وَأَ<tajweed class=ghunnah>نّ</tajweed>َا مِ<tajweed class=ghunnah>نّ</tajweed>َا <tajweed class=ham_wasl>ٱ</tajweed>لْمُسْلِمُونَ وَمِ<tajweed class=ghunnah>نّ</tajweed>َا <tajweed class=ham_wasl>ٱ</tajweed>لْقَ<tajweed class=madda_normal>ـٰ</tajweed>سِطُونَ‌ۖ فَمَنْ أَسْلَمَ فَأُ<tajweed class=slnt>وْ</tajweed>لَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ئِكَ تَحَرَّوْ<tajweed class=slnt>اْ</tajweed> رَشَدًا <span class=end>١٤</span>","End":"١٤","PageNumber":573,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":506,"MaqraNumber":229,"HizbNumber":58,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":72,"SurahIndex":"072","VerseNumber":15,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَأَمَّا ٱلۡقَٰسِطُونَ فَكَانُواْ لِجَهَنَّمَ حَطَبٗا","TajweedText":"وَأَ<tajweed class=ghunnah>مّ</tajweed>َا <tajweed class=ham_wasl>ٱ</tajweed>لْقَ<tajweed class=madda_normal>ـٰ</tajweed>سِطُونَ فَكَانُو<tajweed class=slnt>اْ</tajweed> لِجَهَ<tajweed class=ghunnah>نّ</tajweed>َمَ حَطَبًا <span class=end>١٥</span>","End":"١٥","PageNumber":573,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":506,"MaqraNumber":229,"HizbNumber":58,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":72,"SurahIndex":"072","VerseNumber":16,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَأَلَّوِ ٱسۡتَقَٰمُواْ عَلَى ٱلطَّرِيقَةِ لَأَسۡقَيۡنَٰهُم مَّآءً غَدَقٗا","TajweedText":"وَأَلَّوِ <tajweed class=ham_wasl>ٱ</tajweed>سْتَقَ<tajweed class=madda_normal>ـٰ</tajweed>مُو<tajweed class=slnt>اْ</tajweed> عَلَى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>طَّرِيقَةِ لَأَسْقَيْنَ<tajweed class=madda_normal>ـٰ</tajweed>ه<tajweed class=idgham_shafawi>ُم م</tajweed>ّ<tajweed class=madda_obligatory>َا</tajweed>ٓءً غَدَقًا <span class=end>١٦</span>","End":"١٦","PageNumber":573,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":506,"MaqraNumber":229,"HizbNumber":58,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":72,"SurahIndex":"072","VerseNumber":17,"ShowSurahName":false,"ShowBismillah":false,"Text":"لِّنَفۡتِنَهُمۡ فِيهِۚ وَمَن يُعۡرِضۡ عَن ذِكۡرِ رَبِّهِۦ يَسۡلُكۡهُ عَذَابٗا صَعَدٗا","TajweedText":"لِّنَفْتِنَهُمْ فِيهِ‌ۚ وَم<tajweed class=idgham_ghunnah>َن ي</tajweed>ُعْرِضْ عَ<tajweed class=ikhafa>ن ذ</tajweed>ِكْرِ رَبِّه<tajweed class=madda_normal>ِۦ</tajweed> يَسْلُكْهُ عَذَا<tajweed class=ikhafa>بًا ص</tajweed>َعَدًا <span class=end>١٧</span>","End":"١٧","PageNumber":573,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":506,"MaqraNumber":229,"HizbNumber":58,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":72,"SurahIndex":"072","VerseNumber":18,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَأَنَّ ٱلۡمَسَٰجِدَ لِلَّهِ فَلَا تَدۡعُواْ مَعَ ٱللَّهِ أَحَدٗا","TajweedText":"وَأَ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>لْمَسَ<tajweed class=madda_normal>ـٰ</tajweed>جِدَ لِلَّهِ فَلَا تَ<tajweed class=qalaqah>دْ</tajweed>عُو<tajweed class=slnt>اْ</tajweed> مَعَ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ أَحَدًا <span class=end>١٨</span>","End":"١٨","PageNumber":573,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":506,"MaqraNumber":229,"HizbNumber":58,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":72,"SurahIndex":"072","VerseNumber":19,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَأَنَّهُۥ لَمَّا قَامَ عَبۡدُ ٱللَّهِ يَدۡعُوهُ كَادُواْ يَكُونُونَ عَلَيۡهِ لِبَدٗا","TajweedText":"وَأَ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> لَ<tajweed class=ghunnah>مّ</tajweed>َا قَامَ عَ<tajweed class=qalaqah>بْ</tajweed>دُ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ يَ<tajweed class=qalaqah>دْ</tajweed>عُوهُ كَادُو<tajweed class=slnt>اْ</tajweed> يَكُونُونَ عَلَيْهِ لِبَدًا <span class=end>١٩</span>","End":"١٩","PageNumber":573,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":506,"MaqraNumber":229,"HizbNumber":58,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":72,"SurahIndex":"072","VerseNumber":20,"ShowSurahName":false,"ShowBismillah":false,"Text":"قُلۡ إِنَّمَآ أَدۡعُواْ رَبِّي وَلَآ أُشۡرِكُ بِهِۦٓ أَحَدٗا","TajweedText":"قُلْ إِ<tajweed class=ghunnah>نّ</tajweed>َم<tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=qalaqah>دْ</tajweed>عُو<tajweed class=slnt>اْ</tajweed> رَبِّى وَل<tajweed class=madda_obligatory>َآ</tajweed> أُشْرِكُ بِه<tajweed class=madda_obligatory>ِۦٓ</tajweed> أَحَدًا <span class=end>٢٠</span>","End":"٢٠","PageNumber":573,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":507,"MaqraNumber":229,"HizbNumber":58,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":72,"SurahIndex":"072","VerseNumber":21,"ShowSurahName":false,"ShowBismillah":false,"Text":"قُلۡ إِنِّي لَآ أَمۡلِكُ لَكُمۡ ضَرّٗا وَلَا رَشَدٗا","TajweedText":"قُلْ إِ<tajweed class=ghunnah>نّ</tajweed>ِى ل<tajweed class=madda_obligatory>َآ</tajweed> أَمْلِكُ لَكُمْ ضَر<tajweed class=idgham_ghunnah>ًّا و</tajweed>َلَا رَشَدًا <span class=end>٢١</span>","End":"٢١","PageNumber":573,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":507,"MaqraNumber":229,"HizbNumber":58,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":72,"SurahIndex":"072","VerseNumber":22,"ShowSurahName":false,"ShowBismillah":false,"Text":"قُلۡ إِنِّي لَن يُجِيرَنِي مِنَ ٱللَّهِ أَحَدٞ وَلَنۡ أَجِدَ مِن دُونِهِۦ مُلۡتَحَدًا","TajweedText":"قُلْ إِ<tajweed class=ghunnah>نّ</tajweed>ِى ل<tajweed class=idgham_ghunnah>َن ي</tajweed>ُجِيرَنِى مِنَ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ أَحَ<tajweed class=idgham_ghunnah>دٌ و</tajweed>َلَنْ أَجِدَ مِ<tajweed class=ikhafa>ن د</tajweed>ُونِه<tajweed class=madda_normal>ِۦ</tajweed> مُلْتَحَدًا <span class=end>٢٢</span>","End":"٢٢","PageNumber":573,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":507,"MaqraNumber":229,"HizbNumber":58,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":72,"SurahIndex":"072","VerseNumber":23,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِلَّا بَلَٰغٗا مِّنَ ٱللَّهِ وَرِسَٰلَٰتِهِۦۚ وَمَن يَعۡصِ ٱللَّهَ وَرَسُولَهُۥ فَإِنَّ لَهُۥ نَارَ جَهَنَّمَ خَٰلِدِينَ فِيهَآ أَبَدًا","TajweedText":"إِلَّا بَلَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>غًا م</tajweed>ِّنَ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ وَرِسَ<tajweed class=madda_normal>ـٰ</tajweed>لَ<tajweed class=madda_normal>ـٰ</tajweed>تِه<tajweed class=madda_normal>ِۦ</tajweed>‌ۚ وَم<tajweed class=idgham_ghunnah>َن ي</tajweed>َعْصِ <tajweed class=ham_wasl>ٱ</tajweed>للَّهَ وَرَسُولَهُ<tajweed class=madda_normal>ۥ</tajweed> فَإِ<tajweed class=ghunnah>نّ</tajweed>َ لَهُ<tajweed class=madda_normal>ۥ</tajweed> نَارَ جَهَ<tajweed class=ghunnah>نّ</tajweed>َمَ خَ<tajweed class=madda_normal>ـٰ</tajweed>لِدِينَ فِيه<tajweed class=madda_obligatory>َآ</tajweed> أَبَدًا <span class=end>٢٣</span>","End":"٢٣","PageNumber":573,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":507,"MaqraNumber":229,"HizbNumber":58,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":72,"SurahIndex":"072","VerseNumber":24,"ShowSurahName":false,"ShowBismillah":false,"Text":"حَتَّىٰٓ إِذَا رَأَوۡاْ مَا يُوعَدُونَ فَسَيَعۡلَمُونَ مَنۡ أَضۡعَفُ نَاصِرٗا وَأَقَلُّ عَدَدٗا","TajweedText":"حَتَّ<tajweed class=madda_obligatory>ىٰٓ</tajweed> إِذَا رَأَوْ<tajweed class=slnt>اْ</tajweed> مَا يُوعَدُونَ فَسَيَعْلَمُونَ مَنْ أَضْعَفُ نَاصِ<tajweed class=idgham_ghunnah>رًا و</tajweed>َأَقَلُّ عَدَدًا <span class=end>٢٤</span>","End":"٢٤","PageNumber":573,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":507,"MaqraNumber":229,"HizbNumber":58,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":72,"SurahIndex":"072","VerseNumber":25,"ShowSurahName":false,"ShowBismillah":false,"Text":"قُلۡ إِنۡ أَدۡرِيٓ أَقَرِيبٞ مَّا تُوعَدُونَ أَمۡ يَجۡعَلُ لَهُۥ رَبِّيٓ أَمَدًا","TajweedText":"قُلْ إِنْ أَ<tajweed class=qalaqah>دْ</tajweed>ر<tajweed class=madda_obligatory>ِىٓ</tajweed> أَقَرِي<tajweed class=idgham_ghunnah>بٌ م</tajweed>َّا تُوعَدُونَ أَمْ يَ<tajweed class=qalaqah>جْ</tajweed>عَلُ لَهُ<tajweed class=madda_normal>ۥ</tajweed> رَبّ<tajweed class=madda_obligatory>ِىٓ</tajweed> أَمَدًا <span class=end>٢٥</span>","End":"٢٥","PageNumber":573,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":507,"MaqraNumber":229,"HizbNumber":58,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":72,"SurahIndex":"072","VerseNumber":26,"ShowSurahName":false,"ShowBismillah":false,"Text":"عَٰلِمُ ٱلۡغَيۡبِ فَلَا يُظۡهِرُ عَلَىٰ غَيۡبِهِۦٓ أَحَدًا","TajweedText":"عَ<tajweed class=madda_normal>ـٰ</tajweed>لِمُ <tajweed class=ham_wasl>ٱ</tajweed>لْغَيْبِ فَلَا يُظْهِرُ عَلَىٰ غَيْبِه<tajweed class=madda_obligatory>ِۦٓ</tajweed> أَحَدًا <span class=end>٢٦</span>","End":"٢٦","PageNumber":573,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":507,"MaqraNumber":229,"HizbNumber":58,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":72,"SurahIndex":"072","VerseNumber":27,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِلَّا مَنِ ٱرۡتَضَىٰ مِن رَّسُولٖ فَإِنَّهُۥ يَسۡلُكُ مِنۢ بَيۡنِ يَدَيۡهِ وَمِنۡ خَلۡفِهِۦ رَصَدٗا","TajweedText":"إِلَّا مَنِ <tajweed class=ham_wasl>ٱ</tajweed>رْتَضَىٰ م<tajweed class=idgham_wo_ghunnah>ِن ر</tajweed>َّسُو<tajweed class=ikhafa>لٍ ف</tajweed>َإِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> يَسْلُكُ م<tajweed class=iqlab>ِنۢ ب</tajweed>َيْنِ يَدَيْهِ وَمِنْ خَلْفِه<tajweed class=madda_normal>ِۦ</tajweed> رَصَدًا <span class=end>٢٧</span>","End":"٢٧","PageNumber":573,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":507,"MaqraNumber":229,"HizbNumber":58,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":72,"SurahIndex":"072","VerseNumber":28,"ShowSurahName":false,"ShowBismillah":false,"Text":"لِّيَعۡلَمَ أَن قَدۡ أَبۡلَغُواْ رِسَٰلَٰتِ رَبِّهِمۡ وَأَحَاطَ بِمَا لَدَيۡهِمۡ وَأَحۡصَىٰ كُلَّ شَيۡءٍ عَدَدَۢا","TajweedText":"لِّيَعْلَمَ أَ<tajweed class=ikhafa>ن ق</tajweed>َ<tajweed class=qalaqah>دْ</tajweed> أَ<tajweed class=qalaqah>بْ</tajweed>لَغُو<tajweed class=slnt>اْ</tajweed> رِسَ<tajweed class=madda_normal>ـٰ</tajweed>لَ<tajweed class=madda_normal>ـٰ</tajweed>تِ رَبِّهِمْ وَأَحَاطَ بِمَا لَدَيْهِمْ وَأَحْصَىٰ كُلَّ شَىْءٍ عَدَدَۢا <span class=end>٢٨</span>","End":"٢٨","PageNumber":573,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":507,"MaqraNumber":229,"HizbNumber":58,"HizbDecimal":0.0,"HasSajda":false}]}