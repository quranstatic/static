{"RukuNumber":2,"Verses":[{"SurahNumber":2,"SurahIndex":"002","VerseNumber":1,"ShowSurahName":true,"ShowBismillah":true,"Text":"الٓمٓ","TajweedText":"ا<tajweed class=madda_necessary>لٓ</tajweed><tajweed class=madda_necessary>مٓ</tajweed> <span class=end>١</span>","End":"١","PageNumber":2,"JuzNumber":1,"ManzilNumber":1,"RukuNumber":2,"MaqraNumber":1,"HizbNumber":1,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":2,"SurahIndex":"002","VerseNumber":2,"ShowSurahName":false,"ShowBismillah":false,"Text":"ذَٰلِكَ ٱلۡكِتَٰبُ لَا رَيۡبَۛ فِيهِۛ هُدٗى لِّلۡمُتَّقِينَ","TajweedText":"ذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ <tajweed class=ham_wasl>ٱ</tajweed>لْكِتَ<tajweed class=madda_normal>ـٰ</tajweed>بُ لَا رَيْبَ‌ۛ فِيهِ‌ۛ هُ<tajweed class=idgham_wo_ghunnah>دًى ل</tajweed>ِّلْمُتَّق<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٢</span>","End":"٢","PageNumber":2,"JuzNumber":1,"ManzilNumber":1,"RukuNumber":2,"MaqraNumber":1,"HizbNumber":1,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":2,"SurahIndex":"002","VerseNumber":3,"ShowSurahName":false,"ShowBismillah":false,"Text":"ٱلَّذِينَ يُؤۡمِنُونَ بِٱلۡغَيۡبِ وَيُقِيمُونَ ٱلصَّلَوٰةَ وَمِمَّا رَزَقۡنَٰهُمۡ يُنفِقُونَ","TajweedText":"ٱلَّذِينَ يُؤْمِنُونَ بِ<tajweed class=ham_wasl>ٱ</tajweed>لْغَيْبِ وَيُقِيمُونَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>صَّلَ<tajweed class=slnt>و</tajweed><tajweed class=madda_normal>ٲ</tajweed>ةَ وَمِ<tajweed class=ghunnah>مّ</tajweed>َا رَزَ<tajweed class=qalaqah>قْ</tajweed>نَ<tajweed class=madda_normal>ـٰ</tajweed>هُمْ يُ<tajweed class=ikhafa>نف</tajweed>ِق<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣</span>","End":"٣","PageNumber":2,"JuzNumber":1,"ManzilNumber":1,"RukuNumber":2,"MaqraNumber":1,"HizbNumber":1,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":2,"SurahIndex":"002","VerseNumber":4,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَٱلَّذِينَ يُؤۡمِنُونَ بِمَآ أُنزِلَ إِلَيۡكَ وَمَآ أُنزِلَ مِن قَبۡلِكَ وَبِٱلۡأٓخِرَةِ هُمۡ يُوقِنُونَ","TajweedText":"وَ<tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ يُؤْمِنُونَ بِم<tajweed class=madda_obligatory>َآ</tajweed> أُ<tajweed class=ikhafa>نز</tajweed>ِلَ إِلَيْكَ وَم<tajweed class=madda_obligatory>َآ</tajweed> أُ<tajweed class=ikhafa>نز</tajweed>ِلَ مِ<tajweed class=ikhafa>ن ق</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>لِكَ وَبِ<tajweed class=ham_wasl>ٱ</tajweed>لْأَخِرَةِ هُمْ يُوقِن<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٤</span>","End":"٤","PageNumber":2,"JuzNumber":1,"ManzilNumber":1,"RukuNumber":2,"MaqraNumber":1,"HizbNumber":1,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":2,"SurahIndex":"002","VerseNumber":5,"ShowSurahName":false,"ShowBismillah":false,"Text":"أُوْلَـٰٓئِكَ عَلَىٰ هُدٗى مِّن رَّبِّهِمۡۖ وَأُوْلَـٰٓئِكَ هُمُ ٱلۡمُفۡلِحُونَ","TajweedText":"أُ<tajweed class=slnt>وْ</tajweed>لَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ئِكَ عَلَىٰ هُ<tajweed class=idgham_ghunnah>دًى م</tajweed>ّ<tajweed class=idgham_wo_ghunnah>ِن ر</tajweed>َّبِّهِمْ‌ۖ وَأُ<tajweed class=slnt>وْ</tajweed>لَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ئِكَ هُمُ <tajweed class=ham_wasl>ٱ</tajweed>لْمُفْلِح<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٥</span>","End":"٥","PageNumber":2,"JuzNumber":1,"ManzilNumber":1,"RukuNumber":2,"MaqraNumber":1,"HizbNumber":1,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":2,"SurahIndex":"002","VerseNumber":6,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّ ٱلَّذِينَ كَفَرُواْ سَوَآءٌ عَلَيۡهِمۡ ءَأَنذَرۡتَهُمۡ أَمۡ لَمۡ تُنذِرۡهُمۡ لَا يُؤۡمِنُونَ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ كَفَرُو<tajweed class=slnt>اْ</tajweed> سَو<tajweed class=madda_obligatory>َا</tajweed>ٓءٌ عَلَيْهِمْ ءَأَ<tajweed class=ikhafa>نذ</tajweed>َرْتَهُمْ أَمْ لَمْ تُ<tajweed class=ikhafa>نذ</tajweed>ِرْهُمْ لَا يُؤْمِن<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦</span>","End":"٦","PageNumber":3,"JuzNumber":1,"ManzilNumber":1,"RukuNumber":2,"MaqraNumber":1,"HizbNumber":1,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":2,"SurahIndex":"002","VerseNumber":7,"ShowSurahName":false,"ShowBismillah":false,"Text":"خَتَمَ ٱللَّهُ عَلَىٰ قُلُوبِهِمۡ وَعَلَىٰ سَمۡعِهِمۡۖ وَعَلَىٰٓ أَبۡصَٰرِهِمۡ غِشَٰوَةٞۖ وَلَهُمۡ عَذَابٌ عَظِيمٞ","TajweedText":"خَتَمَ <tajweed class=ham_wasl>ٱ</tajweed>للَّهُ عَلَىٰ قُلُوبِهِمْ وَعَلَىٰ سَمْعِهِمْ‌ۖ وَعَلَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> أَ<tajweed class=qalaqah>بْ</tajweed>صَ<tajweed class=madda_normal>ـٰ</tajweed>رِهِمْ غِشَ<tajweed class=madda_normal>ـٰ</tajweed>وَ<tajweed class=idgham_ghunnah>ةٌ‌ۖ و</tajweed>َلَهُمْ عَذَابٌ عَظ<tajweed class=madda_permissible>ِي</tajweed>مٌ <span class=end>٧</span>","End":"٧","PageNumber":3,"JuzNumber":1,"ManzilNumber":1,"RukuNumber":2,"MaqraNumber":1,"HizbNumber":1,"HizbDecimal":0.0,"HasSajda":false}]}