{"RukuNumber":427,"Verses":[{"SurahNumber":43,"SurahIndex":"043","VerseNumber":36,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَن يَعۡشُ عَن ذِكۡرِ ٱلرَّحۡمَٰنِ نُقَيِّضۡ لَهُۥ شَيۡطَٰنٗا فَهُوَ لَهُۥ قَرِينٞ","TajweedText":"وَم<tajweed class=idgham_ghunnah>َن ي</tajweed>َعْشُ عَ<tajweed class=ikhafa>ن ذ</tajweed>ِكْرِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رَّحْمَ<tajweed class=madda_normal>ـٰ</tajweed>نِ نُقَيِّضْ لَهُ<tajweed class=madda_normal>ۥ</tajweed> شَيْطَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=ikhafa>نًا ف</tajweed>َهُوَ لَهُ<tajweed class=madda_normal>ۥ</tajweed> قَر<tajweed class=madda_permissible>ِي</tajweed>نٌ <span class=end>٣٦</span>","End":"٣٦","PageNumber":492,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":427,"MaqraNumber":197,"HizbNumber":50,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":37,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِنَّهُمۡ لَيَصُدُّونَهُمۡ عَنِ ٱلسَّبِيلِ وَيَحۡسَبُونَ أَنَّهُم مُّهۡتَدُونَ","TajweedText":"وَإِ<tajweed class=ghunnah>نّ</tajweed>َهُمْ لَيَصُدُّونَهُمْ عَنِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّبِيلِ وَيَحْسَبُونَ أَ<tajweed class=ghunnah>نّ</tajweed>َه<tajweed class=idgham_shafawi>ُم م</tajweed>ُّهْتَد<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣٧</span>","End":"٣٧","PageNumber":492,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":427,"MaqraNumber":197,"HizbNumber":50,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":38,"ShowSurahName":false,"ShowBismillah":false,"Text":"حَتَّىٰٓ إِذَا جَآءَنَا قَالَ يَٰلَيۡتَ بَيۡنِي وَبَيۡنَكَ بُعۡدَ ٱلۡمَشۡرِقَيۡنِ فَبِئۡسَ ٱلۡقَرِينُ","TajweedText":"حَتَّ<tajweed class=madda_obligatory>ىٰٓ</tajweed> إِذَا ج<tajweed class=madda_obligatory>َا</tajweed>ٓءَنَا قَالَ يَ<tajweed class=madda_normal>ـٰ</tajweed>لَيْتَ بَيْنِى وَبَيْنَكَ بُعْدَ <tajweed class=ham_wasl>ٱ</tajweed>لْمَشْرِقَيْنِ فَبِئْسَ <tajweed class=ham_wasl>ٱ</tajweed>لْقَر<tajweed class=madda_permissible>ِي</tajweed>نُ <span class=end>٣٨</span>","End":"٣٨","PageNumber":492,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":427,"MaqraNumber":197,"HizbNumber":50,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":39,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَن يَنفَعَكُمُ ٱلۡيَوۡمَ إِذ ظَّلَمۡتُمۡ أَنَّكُمۡ فِي ٱلۡعَذَابِ مُشۡتَرِكُونَ","TajweedText":"وَل<tajweed class=idgham_ghunnah>َن ي</tajweed>َ<tajweed class=ikhafa>نف</tajweed>َعَكُمُ <tajweed class=ham_wasl>ٱ</tajweed>لْيَوْمَ إِ<tajweed class=idgham_mutajanisayn>ذ</tajweed> ظَّلَمْتُمْ أَ<tajweed class=ghunnah>نّ</tajweed>َكُمْ فِى <tajweed class=ham_wasl>ٱ</tajweed>لْعَذَابِ مُشْتَرِك<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣٩</span>","End":"٣٩","PageNumber":492,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":427,"MaqraNumber":197,"HizbNumber":50,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":40,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَفَأَنتَ تُسۡمِعُ ٱلصُّمَّ أَوۡ تَهۡدِي ٱلۡعُمۡيَ وَمَن كَانَ فِي ضَلَٰلٖ مُّبِينٖ","TajweedText":"أَفَأَ<tajweed class=ikhafa>نت</tajweed>َ تُسْمِعُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>صُّ<tajweed class=ghunnah>مّ</tajweed>َ أَوْ تَهْدِى <tajweed class=ham_wasl>ٱ</tajweed>لْعُمْىَ وَمَ<tajweed class=ikhafa>ن ك</tajweed>َانَ فِى ضَلَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>لٍ م</tajweed>ُّب<tajweed class=madda_permissible>ِي</tajweed>نٍ <span class=end>٤٠</span>","End":"٤٠","PageNumber":492,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":427,"MaqraNumber":197,"HizbNumber":50,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":41,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَإِمَّا نَذۡهَبَنَّ بِكَ فَإِنَّا مِنۡهُم مُّنتَقِمُونَ","TajweedText":"فَإِ<tajweed class=ghunnah>مّ</tajweed>َا نَذْهَبَ<tajweed class=ghunnah>نّ</tajweed>َ بِكَ فَإِ<tajweed class=ghunnah>نّ</tajweed>َا مِنْه<tajweed class=idgham_shafawi>ُم م</tajweed>ُّ<tajweed class=ikhafa>نت</tajweed>َقِم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٤١</span>","End":"٤١","PageNumber":492,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":427,"MaqraNumber":197,"HizbNumber":50,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":42,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَوۡ نُرِيَنَّكَ ٱلَّذِي وَعَدۡنَٰهُمۡ فَإِنَّا عَلَيۡهِم مُّقۡتَدِرُونَ","TajweedText":"أَوْ نُرِيَ<tajweed class=ghunnah>نّ</tajweed>َكَ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى وَعَ<tajweed class=qalaqah>دْ</tajweed>نَ<tajweed class=madda_normal>ـٰ</tajweed>هُمْ فَإِ<tajweed class=ghunnah>نّ</tajweed>َا عَلَيْه<tajweed class=idgham_shafawi>ِم م</tajweed>ُّ<tajweed class=qalaqah>قْ</tajweed>تَدِر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٤٢</span>","End":"٤٢","PageNumber":492,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":427,"MaqraNumber":197,"HizbNumber":50,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":43,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَٱسۡتَمۡسِكۡ بِٱلَّذِيٓ أُوحِيَ إِلَيۡكَۖ إِنَّكَ عَلَىٰ صِرَٰطٖ مُّسۡتَقِيمٖ","TajweedText":"فَ<tajweed class=ham_wasl>ٱ</tajweed>سْتَمْسِكْ بِ<tajweed class=ham_wasl>ٱ</tajweed>لَّذ<tajweed class=madda_obligatory>ِىٓ</tajweed> أُوحِىَ إِلَيْكَ‌ۖ إِ<tajweed class=ghunnah>نّ</tajweed>َكَ عَلَىٰ صِر<tajweed class=madda_normal>َٲ</tajweed><tajweed class=idgham_ghunnah>طٍ م</tajweed>ُّسْتَق<tajweed class=madda_permissible>ِي</tajweed>مٍ <span class=end>٤٣</span>","End":"٤٣","PageNumber":492,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":427,"MaqraNumber":197,"HizbNumber":50,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":44,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِنَّهُۥ لَذِكۡرٞ لَّكَ وَلِقَوۡمِكَۖ وَسَوۡفَ تُسۡـَٔلُونَ","TajweedText":"وَإِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> لَذِكْ<tajweed class=idgham_wo_ghunnah>رٌ ل</tajweed>َّكَ وَلِقَوْمِكَ‌ۖ وَسَوْفَ تُسْــَٔل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٤٤</span>","End":"٤٤","PageNumber":492,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":427,"MaqraNumber":197,"HizbNumber":50,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":45,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَسۡـَٔلۡ مَنۡ أَرۡسَلۡنَا مِن قَبۡلِكَ مِن رُّسُلِنَآ أَجَعَلۡنَا مِن دُونِ ٱلرَّحۡمَٰنِ ءَالِهَةٗ يُعۡبَدُونَ","TajweedText":"وَسْــَٔلْ مَنْ أَرْسَلْنَا مِ<tajweed class=ikhafa>ن ق</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>لِكَ م<tajweed class=idgham_wo_ghunnah>ِن ر</tajweed>ُّسُلِن<tajweed class=madda_obligatory>َآ</tajweed> أَجَعَلْنَا مِ<tajweed class=ikhafa>ن د</tajweed>ُونِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رَّحْمَ<tajweed class=madda_normal>ـٰ</tajweed>نِ ءَالِهَ<tajweed class=idgham_ghunnah>ةً ي</tajweed>ُعْبَد<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٤٥</span>","End":"٤٥","PageNumber":492,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":427,"MaqraNumber":197,"HizbNumber":50,"HizbDecimal":0.0,"HasSajda":false}]}