l>ٲ</tajweed>ةَ وَه<tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِ<tajweed class=ham_wasl>ٱ</tajweed>لْأَخِرَةِ هُمْ يُوقِن<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٤</span>","End":"٤","PageNumber":411,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":355,"MaqraNumber":164,"HizbNumber":41,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":31,"SurahIndex":"031","VerseNumber":5,"ShowSurahName":false,"ShowBismillah":false,"Text":"أُوْلَـٰٓئِكَ عَلَىٰ هُدٗى مِّن رَّبِّهِمۡۖ وَأُوْلَـٰٓئِكَ هُمُ ٱلۡمُفۡلِحُونَ","TajweedText":"أُ<tajweed class=slnt>وْ</tajweed>لَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ئِكَ عَلَىٰ هُ<tajweed class=idgham_ghunnah>دًى م</tajweed>ّ<tajweed class=idgham_wo_ghunnah>ِن ر</tajweed>َّبِّهِمْ‌ۖ وَأُ<tajweed class=slnt>وْ</tajweed>لَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ئِكَ هُمُ <tajweed class=ham_wasl>ٱ</tajweed>لْمُفْلِح<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٥</span>","End":"٥","PageNumber":411,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":355,"MaqraNumber":164,"HizbNumber":41,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":31,"SurahIndex":"031","VerseNumber":6,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمِنَ ٱلنَّاسِ مَن يَشۡتَرِي لَهۡوَ ٱلۡحَدِيثِ لِيُضِلَّ عَن سَبِيلِ ٱللَّهِ بِغَيۡرِ عِلۡمٖ وَيَتَّخِذَهَا هُزُوًاۚ أُوْلَـٰٓئِكَ لَهُمۡ عَذَابٞ مُّهِينٞ","TajweedText":"وَمِنَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َاسِ م<tajweed class=idgham_ghunnah>َن ي</tajweed>َشْتَرِى لَهْوَ <tajweed class=ham_wasl>ٱ</tajweed>لْحَدِيثِ لِيُضِلَّ عَ<tajweed class=ikhafa>ن س</tajweed>َبِيلِ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ بِغَيْرِ عِلْ<tajweed class=idgham_ghunnah>مٍ و</tajweed>َيَتَّخِذَهَا هُزُوًا‌ۚ أُ<tajweed class=slnt>وْ</tajweed>لَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ئِكَ لَهُمْ عَذَا<tajweed class=idgham_ghunnah>بٌ م</tajweed>ُّه<tajweed class=madda_permissible>ِي</tajweed>نٌ <span class=end>٦</span>","End":"٦","PageNumber":411,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":355,"MaqraNumber":164,"HizbNumber":41,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":31,"SurahIndex":"031","VerseNumber":7,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِذَا تُتۡلَىٰ عَلَيۡهِ ءَايَٰتُنَا وَلَّىٰ مُسۡتَكۡبِرٗا كَأَن لَّمۡ يَسۡمَعۡهَا كَأَنَّ فِيٓ أُذُنَيۡهِ وَقۡرٗاۖ فَبَشِّرۡهُ بِعَذَابٍ أَلِيمٍ","TajweedText":"وَإِذَا تُتْلَىٰ عَلَيْهِ ءَايَ<tajweed class=madda_normal>ـٰ</tajweed>تُنَا وَلَّىٰ مُسْتَكْبِ<tajweed class=ikhafa>رًا ك</tajweed>َأ<tajweed class=idgham_wo_ghunnah>َن ل</tajweed>َّمْ يَسْمَعْهَا كَأَ<tajweed class=ghunnah>نّ</tajweed>َ ف<tajweed class=madda_obligatory>ِىٓ</tajweed> أُذُنَيْهِ وَ<tajweed class=qalaqah>قْ</tajweed><tajweed class=ikhafa>رًا‌ۖ ف</tajweed>َبَشِّرْهُ بِعَذَابٍ أَل<tajweed class=madda_permissible>ِي</tajweed>مٍ <span class=end>٧</span>","End":"٧","PageNumber":411,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":355,"MaqraNumber":164,"HizbNumber":41,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":31,"SurahIndex":"031","VerseNumber":8,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّـٰلِحَٰتِ لَهُمۡ جَنَّـٰتُ ٱلنَّعِيمِ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ ءَامَنُو<tajweed class=slnt>اْ</tajweed> وَعَمِلُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>صَّ<tajweed class=madda_normal>ـٰ</tajweed>لِحَ<tajweed class=madda_normal>ـٰ</tajweed>تِ لَهُمْ جَ<tajweed class=ghunnah>نّ</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed>تُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َع<tajweed class=madda_permissible>ِي</tajweed>مِ <span class=end>٨</span>","End":"٨","PageNumber":411,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":355,"MaqraNumber":164,"HizbNumber":41,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":31,"SurahIndex":"031","VerseNumber":9,"ShowSurahName":false,"ShowBismillah":false,"Text":"خَٰلِدِينَ فِيهَاۖ وَعۡدَ ٱللَّهِ حَقّٗاۚ وَهُوَ ٱلۡعَزِيزُ ٱلۡحَكِيمُ","TajweedText":"خَ<tajweed class=madda_normal>ـٰ</tajweed>لِدِينَ فِيهَا‌ۖ وَعْدَ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ حَق<tajweed class=idgham_ghunnah>ًّا‌ۚ و</tajweed>َهُوَ <tajweed class=ham_wasl>ٱ</tajweed>لْعَزِيزُ <tajweed class=ham_wasl>ٱ</tajweed>لْحَك<tajweed class=madda_permissible>ِي</tajweed>مُ <span class=end>٩</span>","End":"٩","PageNumber":411,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":355,"MaqraNumber":164,"HizbNumber":41,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":31,"SurahIndex":"031","VerseNumber":10,"ShowSurahName":false,"ShowBismillah":false,"Text":"خَلَقَ ٱلسَّمَٰوَٰتِ بِغَيۡرِ عَمَدٖ تَرَوۡنَهَاۖ وَأَلۡقَىٰ فِي ٱلۡأَرۡضِ رَوَٰسِيَ أَن تَمِيدَ بِكُمۡ وَبَثَّ فِيهَا مِن كُلِّ دَآبَّةٖۚ وَأَنزَلۡنَا مِنَ ٱلسَّمَآءِ مَآءٗ فَأَنۢبَتۡنَا فِيهَا مِن كُلِّ زَوۡجٖ كَرِيمٍ","TajweedText":"خَلَقَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّمَ<tajweed class=madda_normal>ـٰ</tajweed>و<tajweed class=madda_normal>َٲ</tajweed>تِ بِغَيْرِ عَمَ<tajweed class=ikhafa>دٍ ت</tajweed>َرَوْنَهَا‌ۖ وَأَلْقَىٰ فِى <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ رَو<tajweed class=madda_normal>َٲ</tajweed>سِىَ أَ<tajweed class=ikhafa>ن ت</tajweed>َمِيدَ بِكُمْ وَبَثَّ فِيهَا مِ<tajweed class=ikhafa>ن ك</tajweed>ُلِّ د<tajweed class=madda_necessary>َا</tajweed>ٓبَّ<tajweed class=idgham_ghunnah>ةٍ‌ۚ و</tajweed>َأَ<tajweed class=ikhafa>نز</tajweed>َلْنَا مِنَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّم<tajweed class=madda_obligatory>َا</tajweed>ٓءِ م<tajweed class=madda_obligatory>َا</tajweed>ٓ<tajweed class=ikhafa>ءً ف</tajweed>َأَ<tajweed class=iqlab>نۢب</tajweed>َتْنَا فِيهَا مِ<tajweed class=ikhafa>ن ك</tajweed>ُلِّ زَوْ<tajweed class=ikhafa>جٍ ك</tajweed>َر<tajweed class=madda_permissible>ِي</tajweed>مٍ <span class=end>١٠</span>","End":"١٠","PageNumber":411,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":355,"MaqraNumber":164,"HizbNumber":41,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":31,"SurahIndex":"031","VerseNumber":11,"ShowSurahName":false,"ShowBismillah":false,"Text":"هَٰذَا خَلۡقُ ٱللَّهِ فَأَرُونِي مَاذَا خَلَقَ ٱلَّذِينَ مِن دُونِهِۦۚ بَلِ ٱلظَّـٰلِمُونَ فِي ضَلَٰلٖ مُّبِينٖ","TajweedText":"هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا خَلْقُ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ فَأَرُونِى مَاذَا خَلَقَ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ مِ<tajweed class=ikhafa>ن د</tajweed>ُونِه<tajweed class=madda_normal>ِۦ</tajweed>‌ۚ بَلِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>ظَّ<tajweed class=madda_normal>ـٰ</tajweed>لِمُونَ فِى ضَلَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>لٍ م</tajweed>ُّب<tajweed class=madda_permissible>ِي</tajweed>نٍ <span class=end>١١</span>","End":"١١","PageNumber":411,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":355,"MaqraNumber":164,"HizbNumber":41,"HizbDecimal":0.75,"HasSajda":false}]}