{"RukuNumber":465,"Verses":[{"SurahNumber":54,"SurahIndex":"054","VerseNumber":41,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَقَدۡ جَآءَ ءَالَ فِرۡعَوۡنَ ٱلنُّذُرُ","TajweedText":"وَلَقَ<tajweed class=qalaqah>دْ</tajweed> ج<tajweed class=madda_obligatory>َا</tajweed>ٓءَ ءَالَ فِرْعَوْنَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>ُذُرُ <span class=end>٤١</span>","End":"٤١","PageNumber":530,"JuzNumber":27,"ManzilNumber":7,"RukuNumber":465,"MaqraNumber":212,"HizbNumber":53,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":54,"SurahIndex":"054","VerseNumber":42,"ShowSurahName":false,"ShowBismillah":false,"Text":"كَذَّبُواْ بِـَٔايَٰتِنَا كُلِّهَا فَأَخَذۡنَٰهُمۡ أَخۡذَ عَزِيزٖ مُّقۡتَدِرٍ","TajweedText":"كَذَّبُو<tajweed class=slnt>اْ</tajweed> بِـَٔـايَ<tajweed class=madda_normal>ـٰ</tajweed>تِنَا كُلِّهَا فَأَخَذْنَ<tajweed class=madda_normal>ـٰ</tajweed>هُمْ أَخْذَ عَزِي<tajweed class=idgham_ghunnah>زٍ م</tajweed>ُّ<tajweed class=qalaqah>قْ</tajweed>تَدِرٍ <span class=end>٤٢</span>","End":"٤٢","PageNumber":530,"JuzNumber":27,"ManzilNumber":7,"RukuNumber":465,"MaqraNumber":212,"HizbNumber":53,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":54,"SurahIndex":"054","VerseNumber":43,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَكُفَّارُكُمۡ خَيۡرٞ مِّنۡ أُوْلَـٰٓئِكُمۡ أَمۡ لَكُم بَرَآءَةٞ فِي ٱلزُّبُرِ","TajweedText":"أَكُفَّارُكُمْ خَيْ<tajweed class=idgham_ghunnah>رٌ م</tajweed>ِّنْ أُ<tajweed class=slnt>وْ</tajweed>لَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ئِكُمْ أَمْ لَك<tajweed class=ikhafa_shafawi>ُم ب</tajweed>َر<tajweed class=madda_obligatory>َا</tajweed>ٓءَ<tajweed class=ikhafa>ةٌ ف</tajweed>ِى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>زُّبُرِ <span class=end>٤٣</span>","End":"٤٣","PageNumber":530,"JuzNumber":27,"ManzilNumber":7,"RukuNumber":465,"MaqraNumber":212,"HizbNumber":53,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":54,"SurahIndex":"054","VerseNumber":44,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَمۡ يَقُولُونَ نَحۡنُ جَمِيعٞ مُّنتَصِرٞ","TajweedText":"أَمْ يَقُولُونَ نَحْنُ جَمِي<tajweed class=idgham_ghunnah>عٌ م</tajweed>ُّ<tajweed class=ikhafa>نت</tajweed>َصِرٌ <span class=end>٤٤</span>","End":"٤٤","PageNumber":530,"JuzNumber":27,"ManzilNumber":7,"RukuNumber":465,"MaqraNumber":212,"HizbNumber":53,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":54,"SurahIndex":"054","VerseNumber":45,"ShowSurahName":false,"ShowBismillah":false,"Text":"سَيُهۡزَمُ ٱلۡجَمۡعُ وَيُوَلُّونَ ٱلدُّبُرَ","TajweedText":"سَيُهْزَمُ <tajweed class=ham_wasl>ٱ</tajweed>لْجَمْعُ وَيُوَلُّونَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>دُّبُرَ <span class=end>٤٥</span>","End":"٤٥","PageNumber":530,"JuzNumber":27,"ManzilNumber":7,"RukuNumber":465,"MaqraNumber":212,"HizbNumber":53,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":54,"SurahIndex":"054","VerseNumber":46,"ShowSurahName":false,"ShowBismillah":false,"Text":"بَلِ ٱلسَّاعَةُ مَوۡعِدُهُمۡ وَٱلسَّاعَةُ أَدۡهَىٰ وَأَمَرُّ","TajweedText":"بَلِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّاعَةُ مَوْعِدُهُمْ وَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّاعَةُ أَ<tajweed class=qalaqah>دْ</tajweed>هَىٰ وَأَمَرُّ <span class=end>٤٦</span>","End":"٤٦","PageNumber":530,"JuzNumber":27,"ManzilNumber":7,"RukuNumber":465,"MaqraNumber":212,"HizbNumber":53,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":54,"SurahIndex":"054","VerseNumber":47,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّ ٱلۡمُجۡرِمِينَ فِي ضَلَٰلٖ وَسُعُرٖ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>لْمُ<tajweed class=qalaqah>جْ</tajweed>رِمِينَ فِى ضَلَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>لٍ و</tajweed>َسُعُرٍ <span class=end>٤٧</span>","End":"٤٧","PageNumber":530,"JuzNumber":27,"ManzilNumber":7,"RukuNumber":465,"MaqraNumber":212,"HizbNumber":53,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":54,"SurahIndex":"054","VerseNumber":48,"ShowSurahName":false,"ShowBismillah":false,"Text":"يَوۡمَ يُسۡحَبُونَ فِي ٱلنَّارِ عَلَىٰ وُجُوهِهِمۡ ذُوقُواْ مَسَّ سَقَرَ","TajweedText":"يَوْمَ يُسْحَبُونَ فِى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َارِ عَلَىٰ وُجُوهِهِمْ ذُوقُو<tajweed class=slnt>اْ</tajweed> مَسَّ سَقَرَ <span class=end>٤٨</span>","End":"٤٨","PageNumber":530,"JuzNumber":27,"ManzilNumber":7,"RukuNumber":465,"MaqraNumber":212,"HizbNumber":53,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":54,"SurahIndex":"054","VerseNumber":49,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّا كُلَّ شَيۡءٍ خَلَقۡنَٰهُ بِقَدَرٖ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َا كُلَّ شَىْءٍ خَلَ<tajweed class=qalaqah>قْ</tajweed>نَ<tajweed class=madda_normal>ـٰ</tajweed>هُ بِقَدَرٍ <span class=end>٤٩</span>","End":"٤٩","PageNumber":530,"JuzNumber":27,"ManzilNumber":7,"RukuNumber":465,"MaqraNumber":212,"HizbNumber":53,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":54,"SurahIndex":"054","VerseNumber":50,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَآ أَمۡرُنَآ إِلَّا وَٰحِدَةٞ كَلَمۡحِۭ بِٱلۡبَصَرِ","TajweedText":"وَم<tajweed class=madda_obligatory>َآ</tajweed> أَمْرُن<tajweed class=madda_obligatory>َآ</tajweed> إِلَّا و<tajweed class=madda_normal>َٲ</tajweed>حِدَ<tajweed class=ikhafa>ةٌ ك</tajweed>َلَمْ<tajweed class=iqlab>حِۭ ب</tajweed>ِ<tajweed class=ham_wasl>ٱ</tajweed>لْبَصَرِ <span class=end>٥٠</span>","End":"٥٠","PageNumber":531,"JuzNumber":27,"ManzilNumber":7,"RukuNumber":465,"MaqraNumber":212,"HizbNumber":53,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":54,"SurahIndex":"054","VerseNumber":51,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَقَدۡ أَهۡلَكۡنَآ أَشۡيَاعَكُمۡ فَهَلۡ مِن مُّدَّكِرٖ","TajweedText":"وَلَقَ<tajweed class=qalaqah>دْ</tajweed> أَهْلَكْن<tajweed class=madda_obligatory>َآ</tajweed> أَشْيَاعَكُمْ فَهَلْ م<tajweed class=idgham_ghunnah>ِن م</tajweed>ُّدَّكِرٍ <span class=end>٥١</span>","End":"٥١","PageNumber":531,"JuzNumber":27,"ManzilNumber":7,"RukuNumber":465,"MaqraNumber":212,"HizbNumber":53,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":54,"SurahIndex":"054","VerseNumber":52,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَكُلُّ شَيۡءٖ فَعَلُوهُ فِي ٱلزُّبُرِ","TajweedText":"وَكُلُّ ش<tajweed class=ikhafa>َىْءٍ ف</tajweed>َعَلُوهُ فِى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>زُّبُرِ <span class=end>٥٢</span>","End":"٥٢","PageNumber":531,"JuzNumber":27,"ManzilNumber":7,"RukuNumber":465,"MaqraNumber":212,"HizbNumber":53,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":54,"SurahIndex":"054","VerseNumber":53,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَكُلُّ صَغِيرٖ وَكَبِيرٖ مُّسۡتَطَرٌ","TajweedText":"وَكُلُّ صَغِي<tajweed class=idgham_ghunnah>رٍ و</tajweed>َكَبِي<tajweed class=idgham_ghunnah>رٍ م</tajweed>ُّسْتَطَرٌ <span class=end>٥٣</span>","End":"٥٣","PageNumber":531,"JuzNumber":27,"ManzilNumber":7,"RukuNumber":465,"MaqraNumber":212,"HizbNumber":53,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":54,"SurahIndex":"054","VerseNumber":54,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّ ٱلۡمُتَّقِينَ فِي جَنَّـٰتٖ وَنَهَرٖ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>لْمُتَّقِينَ فِى جَ<tajweed class=ghunnah>نّ</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>تٍ و</tajweed>َنَهَرٍ <span class=end>٥٤</span>","End":"٥٤","PageNumber":531,"JuzNumber":27,"ManzilNumber":7,"RukuNumber":465,"MaqraNumber":212,"HizbNumber":53,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":54,"SurahIndex":"054","VerseNumber":55,"ShowSurahName":false,"ShowBismillah":false,"Text":"فِي مَقۡعَدِ صِدۡقٍ عِندَ مَلِيكٖ مُّقۡتَدِرِۭ","TajweedText":"فِى مَ<tajweed class=qa