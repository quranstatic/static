{"RukuNumber":424,"Verses":[{"SurahNumber":43,"SurahIndex":"043","VerseNumber":1,"ShowSurahName":true,"ShowBismillah":true,"Text":"حمٓ","TajweedText":"ح<tajweed class=madda_necessary>مٓ</tajweed> <span class=end>١</span>","End":"١","PageNumber":489,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":424,"MaqraNumber":196,"HizbNumber":49,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":2,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَٱلۡكِتَٰبِ ٱلۡمُبِينِ","TajweedText":"وَ<tajweed class=ham_wasl>ٱ</tajweed>لْكِتَ<tajweed class=madda_normal>ـٰ</tajweed>بِ <tajweed class=ham_wasl>ٱ</tajweed>لْمُب<tajweed class=madda_permissible>ِي</tajweed>نِ <span class=end>٢</span>","End":"٢","PageNumber":489,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":424,"MaqraNumber":196,"HizbNumber":49,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":3,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّا جَعَلۡنَٰهُ قُرۡءَٰنًا عَرَبِيّٗا لَّعَلَّكُمۡ تَعۡقِلُونَ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َا جَعَلْنَ<tajweed class=madda_normal>ـٰ</tajweed>هُ قُرْء<tajweed class=madda_normal>َٲ</tajweed>نًا عَرَبِي<tajweed class=idgham_wo_ghunnah>ًّا ل</tajweed>َّعَلَّكُمْ تَعْقِل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣</span>","End":"٣","PageNumber":489,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":424,"MaqraNumber":196,"HizbNumber":49,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":4,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِنَّهُۥ فِيٓ أُمِّ ٱلۡكِتَٰبِ لَدَيۡنَا لَعَلِيٌّ حَكِيمٌ","TajweedText":"وَإِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> ف<tajweed class=madda_obligatory>ِىٓ</tajweed> أُ<tajweed class=ghunnah>مّ</tajweed>ِ <tajweed class=ham_wasl>ٱ</tajweed>لْكِتَ<tajweed class=madda_normal>ـٰ</tajweed>بِ لَدَيْنَا لَعَلِىٌّ حَك<tajweed class=madda_permissible>ِي</tajweed>مٌ <span class=end>٤</span>","End":"٤","PageNumber":489,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":424,"MaqraNumber":196,"HizbNumber":49,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":5,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَفَنَضۡرِبُ عَنكُمُ ٱلذِّكۡرَ صَفۡحًا أَن كُنتُمۡ قَوۡمٗا مُّسۡرِفِينَ","TajweedText":"أَفَنَضْرِبُ عَ<tajweed class=ikhafa>نك</tajweed>ُمُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>ذِّكْرَ صَفْحًا أَ<tajweed class=ikhafa>ن ك</tajweed>ُ<tajweed class=ikhafa>نت</tajweed>ُمْ قَوْ<tajweed class=idgham_ghunnah>مًا م</tajweed>ُّسْرِف<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٥</span>","End":"٥","PageNumber":489,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":424,"MaqraNumber":196,"HizbNumber":49,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":6,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَكَمۡ أَرۡسَلۡنَا مِن نَّبِيّٖ فِي ٱلۡأَوَّلِينَ","TajweedText":"وَكَمْ أَرْسَلْنَا م<tajweed class=idgham_ghunnah>ِن ن</tajweed>َّبِ<tajweed class=ikhafa>ىٍّ ف</tajweed>ِى <tajweed class=ham_wasl>ٱ</tajweed>لْأَوَّل<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٦</span>","End":"٦","PageNumber":489,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":424,"MaqraNumber":196,"HizbNumber":49,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":7,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَا يَأۡتِيهِم مِّن نَّبِيٍّ إِلَّا كَانُواْ بِهِۦ يَسۡتَهۡزِءُونَ","TajweedText":"وَمَا يَأْتِيه<tajweed class=idgham_shafawi>ِم م</tajweed>ّ<tajweed class=idgham_ghunnah>ِن ن</tajweed>َّبِىٍّ إِلَّا كَانُو<tajweed class=slnt>اْ</tajweed> بِه<tajweed class=madda_normal>ِۦ</tajweed> يَسْتَهْزِء<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٧</span>","End":"٧","PageNumber":489,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":424,"MaqraNumber":196,"HizbNumber":49,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":8,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَأَهۡلَكۡنَآ أَشَدَّ مِنۡهُم بَطۡشٗا وَمَضَىٰ مَثَلُ ٱلۡأَوَّلِينَ","TajweedText":"فَأَهْلَكْن<tajweed class=madda_obligatory>َآ</tajweed> أَشَدَّ مِنْه<tajweed class=ikhafa_shafawi>ُم ب</tajweed>َ<tajweed class=qalaqah>طْ</tajweed><tajweed class=idgham_ghunnah>شًا و</tajweed>َمَضَىٰ مَثَلُ <tajweed class=ham_wasl>ٱ</tajweed>لْأَوَّل<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٨</span>","End":"٨","PageNumber":489,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":424,"MaqraNumber":196,"HizbNumber":49,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":9,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَئِن سَأَلۡتَهُم مَّنۡ خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ لَيَقُولُنَّ خَلَقَهُنَّ ٱلۡعَزِيزُ ٱلۡعَلِيمُ","TajweedText":"وَلَئِ<tajweed class=ikhafa>ن س</tajweed>َأَلْتَه<tajweed class=idgham_shafawi>ُم م</tajweed>َّنْ خَلَقَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّمَ<tajweed class=madda_normal>ـٰ</tajweed>و<tajweed class=madda_normal>َٲ</tajweed>تِ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضَ لَيَقُولُ<tajweed class=ghunnah>نّ</tajweed>َ خَلَقَهُ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>لْعَزِيزُ <tajweed class=ham_wasl>ٱ</tajweed>لْعَل<tajweed class=madda_permissible>ِي</tajweed>مُ <span class=end>٩</span>","End":"٩","PageNumber":489,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":424,"MaqraNumber":196,"HizbNumber":49,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":10,"ShowSurahName":false,"ShowBismillah":false,"Text":"ٱلَّذِي جَعَلَ لَكُمُ ٱلۡأَرۡضَ مَهۡدٗا وَجَعَلَ لَكُمۡ فِيهَا سُبُلٗا لَّعَلَّكُمۡ تَهۡتَدُونَ","TajweedText":"ٱلَّذِى جَعَلَ لَكُمُ <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضَ مَهْ<tajweed class=idgham_ghunnah>دًا و</tajweed>َجَعَلَ لَكُمْ فِيهَا سُبُل<tajweed class=idgham_wo_ghunnah>اً ل</tajweed>َّعَلَّكُمْ تَهْتَد<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٠</span>","End":"١٠","PageNumber":489,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":424,"MaqraNumber":196,"HizbNumber":49,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":11,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَٱلَّذِي نَزَّلَ مِنَ ٱلسَّمَآءِ مَآءَۢ بِقَدَرٖ فَأَنشَرۡنَا بِهِۦ بَلۡدَةٗ مَّيۡتٗاۚ كَذَٰلِكَ تُخۡرَجُونَ","TajweedText":"وَ<tajweed class=ham_wasl>ٱ</tajweed>لَّذِى نَزَّلَ مِنَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّم<tajweed class=madda_obligatory>َا</tajweed>ٓءِ م<tajweed class=madda_obligatory>َا</tajweed>ٓ<tajweed class=iqlab>ءَۢ ب</tajweed>ِقَدَ<tajweed class=ikhafa>رٍ ف</tajweed>َأَ<tajweed class=ikhafa>نش</tajweed>َرْنَا بِه<tajweed class=madda_normal>ِۦ</tajweed> بَلْدَ<tajweed class=idgham_ghunnah>ةً م</tajweed>َّيْ<tajweed class=ikhafa>تًا‌ۚ ك</tajweed>َذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ تُخْرَج<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١١</span>","End":"١١","PageNumber":490,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":424,"MaqraNumber":196,"HizbNumber":49,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":12,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَٱلَّذِي خَلَقَ ٱلۡأَزۡوَٰجَ كُلَّهَا وَجَعَلَ لَكُم مِّنَ ٱلۡفُلۡكِ وَٱلۡأَنۡعَٰمِ مَا تَرۡكَبُونَ","TajweedText":"وَ<tajweed class=ham_wasl>ٱ</tajweed>لَّذِى خَلَقَ <tajweed class=ham_wasl>ٱ</tajweed>لْأَزْو<tajweed class=madda_normal>َٲ</tajweed>جَ كُلَّهَا وَجَعَلَ لَك<tajweed class=idgham_shafawi>ُم م</tajweed>ِّنَ <tajweed class=ham_wasl>ٱ</tajweed>لْفُلْكِ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْأَنْعَ<tajweed class=madda_normal>ـٰ</tajweed>مِ مَا تَرْكَب<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٢</span>","End":"١٢","PageNumber":490,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":424,"MaqraNumber":196,"HizbNumber":49,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":13,"ShowSurahName":false,"ShowBismillah":false,"Text":"لِتَسۡتَوُۥاْ عَلَىٰ ظُهُورِهِۦ ثُمَّ تَذۡكُرُواْ نِعۡمَةَ رَبِّكُمۡ إِذَا ٱسۡتَوَيۡتُمۡ عَلَيۡهِ وَتَقُولُواْ سُبۡحَٰنَ ٱلَّذِي سَخَّرَ لَنَا هَٰذَا وَمَا كُنَّا لَهُۥ مُقۡرِنِينَ","TajweedText":"لِتَسْتَوُ<tajweed class=madda_normal>ۥ</tajweed>اْ عَلَىٰ ظُهُورِه<tajweed class=madda_normal>ِۦ</tajweed> ثُ<tajweed class=ghunnah>مّ</tajweed>َ تَذْكُرُو<tajweed class=slnt>اْ</tajweed> نِعْمَةَ رَبِّكُمْ إِذَا <tajweed class=ham_wasl>ٱ</tajweed>سْتَوَيْتُمْ عَلَيْهِ وَتَقُولُو<tajweed class=slnt>اْ</tajweed> سُ<tajweed class=qalaqah>بْ</tajweed>حَ<tajweed class=madda_normal>ـٰ</tajweed>نَ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى سَخَّرَ لَنَا هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا وَمَا كُ<tajweed class=ghunnah>نّ</tajweed>َا لَهُ<tajweed class=madda_normal>ۥ</tajweed> مُ<tajweed class=qalaqah>قْ</tajweed>رِن<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٣</span>","End":"١٣","PageNumber":490,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":424,"MaqraNumber":196,"HizbNumber":49,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":14,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِنَّآ إِلَىٰ رَبِّنَا لَمُنقَلِبُونَ","TajweedText":"وَإِ<tajweed class=ghunnah>نّ</tajweed><tajweed class=madda_obligatory>َآ</tajweed> إِلَىٰ رَبِّنَا لَمُ<tajweed class=ikhafa>نق</tajweed>َلِب<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٤</span>","End":"١٤","PageNumber":490,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":424,"MaqraNumber":196,"HizbNumber":49,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":15,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَجَعَلُواْ لَهُۥ مِنۡ عِبَادِهِۦ جُزۡءًاۚ إِنَّ ٱلۡإِنسَٰنَ لَكَفُورٞ مُّبِينٌ","TajweedText":"وَجَعَلُو<tajweed class=slnt>اْ</tajweed> لَهُ<ta