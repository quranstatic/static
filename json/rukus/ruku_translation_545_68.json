{"Id":68,"LanguageCode":"bos","Name":"bos-mustafamlivo","Author":"Mustafa Mlivo","Language":"Bosnian","Description":"Bosnian","Direction":"ltr","Source":"http://tanzil.net","Translations":[{"SurahNumber":103,"VerseNumber":1,"Text":"Tako mi vremena"},{"SurahNumber":103,"VerseNumber":2,"Text":"Uistinu, čovjek je u gubitku"},{"SurahNumber":103,"VerseNumber":3,"Text":"Izuzev onih koji vjeruju i čine dobra djela, i preporučuju jedni drugima Istinu i preporučuju jedni drugima strpljenje"}]}