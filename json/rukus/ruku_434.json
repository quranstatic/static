,"ShowSurahName":false,"ShowBismillah":false,"Text":"تِلۡكَ ءَايَٰتُ ٱللَّهِ نَتۡلُوهَا عَلَيۡكَ بِٱلۡحَقِّۖ فَبِأَيِّ حَدِيثِۭ بَعۡدَ ٱللَّهِ وَءَايَٰتِهِۦ يُؤۡمِنُونَ","TajweedText":"تِلْكَ ءَايَ<tajweed class=madda_normal>ـٰ</tajweed>تُ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ نَتْلُوهَا عَلَيْكَ بِ<tajweed class=ham_wasl>ٱ</tajweed>لْحَقِّ‌ۖ فَبِأَىِّ حَدِي<tajweed class=iqlab>ثِۭ ب</tajweed>َعْدَ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ وَءَايَ<tajweed class=madda_normal>ـٰ</tajweed>تِه<tajweed class=madda_normal>ِۦ</tajweed> يُؤْمِن<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦</span>","End":"٦","PageNumber":499,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":434,"MaqraNumber":199,"HizbNumber":50,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":45,"SurahIndex":"045","VerseNumber":7,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَيۡلٞ لِّكُلِّ أَفَّاكٍ أَثِيمٖ","TajweedText":"وَيْ<tajweed class=idgham_wo_ghunnah>لٌ ل</tajweed>ِّكُلِّ أَفَّاكٍ أَث<tajweed class=madda_permissible>ِي</tajweed>مٍ <span class=end>٧</span>","End":"٧","PageNumber":499,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":434,"MaqraNumber":199,"HizbNumber":50,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":45,"SurahIndex":"045","VerseNumber":8,"ShowSurahName":false,"ShowBismillah":false,"Text":"يَسۡمَعُ ءَايَٰتِ ٱللَّهِ تُتۡلَىٰ عَلَيۡهِ ثُمَّ يُصِرُّ مُسۡتَكۡبِرٗا كَأَن لَّمۡ يَسۡمَعۡهَاۖ فَبَشِّرۡهُ بِعَذَابٍ أَلِيمٖ","TajweedText":"يَسْمَعُ ءَايَ<tajweed class=madda_normal>ـٰ</tajweed>تِ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ تُتْلَىٰ عَلَيْهِ ثُ<tajweed class=ghunnah>مّ</tajweed>َ يُصِرُّ مُسْتَكْبِ<tajweed class=ikhafa>رًا ك</tajweed>َأ<tajweed class=idgham_wo_ghunnah>َن ل</tajweed>َّمْ يَسْمَعْهَا‌ۖ فَبَشِّرْهُ بِعَذَابٍ أَل<tajweed class=madda_permissible>ِي</tajweed>مٍ <span class=end>٨</span>","End":"٨","PageNumber":499,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":434,"MaqraNumber":199,"HizbNumber":50,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":45,"SurahIndex":"045","VerseNumber":9,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِذَا عَلِمَ مِنۡ ءَايَٰتِنَا شَيۡـًٔا ٱتَّخَذَهَا هُزُوًاۚ أُوْلَـٰٓئِكَ لَهُمۡ عَذَابٞ مُّهِينٞ","TajweedText":"وَإِذَا عَلِمَ مِنْ ءَايَ<tajweed class=madda_normal>ـٰ</tajweed>تِنَا شَيْــًٔا <tajweed class=ham_wasl>ٱ</tajweed>تَّخَذَهَا هُزُوًا‌ۚ أُ<tajweed class=slnt>وْ</tajweed>لَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ئِكَ لَهُمْ عَذَا<tajweed class=idgham_ghunnah>بٌ م</tajweed>ُّه<tajweed class=madda_permissible>ِي</tajweed>نٌ <span class=end>٩</span>","End":"٩","PageNumber":499,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":434,"MaqraNumber":199,"HizbNumber":50,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":45,"SurahIndex":"045","VerseNumber":10,"ShowSurahName":false,"ShowBismillah":false,"Text":"مِّن وَرَآئِهِمۡ جَهَنَّمُۖ وَلَا يُغۡنِي عَنۡهُم مَّا كَسَبُواْ شَيۡـٔٗا وَلَا مَا ٱتَّخَذُواْ مِن دُونِ ٱللَّهِ أَوۡلِيَآءَۖ وَلَهُمۡ عَذَابٌ عَظِيمٌ","TajweedText":"مّ<tajweed class=idgham_ghunnah>ِن و</tajweed>َر<tajweed class=madda_obligatory>َا</tajweed>ٓئِهِمْ جَهَ<tajweed class=ghunnah>نّ</tajweed>َمُ‌ۖ وَلَا يُغْنِى عَنْه<tajweed class=idgham_shafawi>ُم م</tajweed>َّا كَسَبُو<tajweed class=slnt>اْ</tajweed> شَيْـ<tajweed class=idgham_ghunnah>ـًٔا و</tajweed>َلَا مَا <tajweed class=ham_wasl>ٱ</tajweed>تَّخَذُو<tajweed class=slnt>اْ</tajweed> مِ<tajweed class=ikhafa>ن د</tajweed>ُونِ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ أَوْلِي<tajweed class=madda_obligatory>َا</tajweed>ٓءَ‌ۖ وَلَهُمْ عَذَابٌ عَظ<tajweed class=madda_permissible>ِي</tajweed>مٌ <span class=end>١٠</span>","End":"١٠","PageNumber":499,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":434,"MaqraNumber":199,"HizbNumber":50,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":45,"SurahIndex":"045","VerseNumber":11,"ShowSurahName":false,"ShowBismillah":false,"Text":"هَٰذَا هُدٗىۖ وَٱلَّذِينَ كَفَرُواْ بِـَٔايَٰتِ رَبِّهِمۡ لَهُمۡ عَذَابٞ مِّن رِّجۡزٍ أَلِيمٌ","TajweedText":"هَ<tajweed class=madda_normal>ـ