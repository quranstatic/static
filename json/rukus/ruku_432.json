{"RukuNumber":432,"Verses":[{"SurahNumber":44,"SurahIndex":"044","VerseNumber":30,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَقَدۡ نَجَّيۡنَا بَنِيٓ إِسۡرَـٰٓءِيلَ مِنَ ٱلۡعَذَابِ ٱلۡمُهِينِ","TajweedText":"وَلَقَ<tajweed class=qalaqah>دْ</tajweed> نَجَّيْنَا بَن<tajweed class=madda_obligatory>ِىٓ</tajweed> إِسْر<tajweed class=madda_obligatory>َٲ</tajweed>ٓءِيلَ مِنَ <tajweed class=ham_wasl>ٱ</tajweed>لْعَذَابِ <tajweed class=ham_wasl>ٱ</tajweed>لْمُه<tajweed class=madda_permissible>ِي</tajweed>نِ <span class=end>٣٠</span>","End":"٣٠","PageNumber":497,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":432,"MaqraNumber":199,"HizbNumber":50,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":44,"SurahIndex":"044","VerseNumber":31,"ShowSurahName":false,"ShowBismillah":false,"Text":"مِن فِرۡعَوۡنَۚ إِنَّهُۥ كَانَ عَالِيٗا مِّنَ ٱلۡمُسۡرِفِينَ","TajweedText":"مِ<tajweed class=ikhafa>ن ف</tajweed>ِرْعَوْنَ‌ۚ إِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> كَانَ عَالِ<tajweed class=idgham_ghunnah>يًا م</tajweed>ِّنَ <tajweed class=ham_wasl>ٱ</tajweed>لْمُسْرِف<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٣١</span>","End":"٣١","PageNumber":497,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":432,"MaqraNumber":199,"HizbNumber":50,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":44,"SurahIndex":"044","VerseNumber":32,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَقَدِ ٱخۡتَرۡنَٰهُمۡ عَلَىٰ عِلۡمٍ عَلَى ٱلۡعَٰلَمِينَ","TajweedText":"وَلَقَدِ <tajweed class=ham_wasl>ٱ</tajweed>خْتَرْنَ<tajweed class=madda_normal>ـٰ</tajweed>هُمْ عَلَىٰ عِلْمٍ عَلَى <tajweed class=ham_wasl>ٱ</tajweed>لْعَ<tajweed class=madda_normal>ـٰ</tajweed>لَم<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٣٢</span>","End":"٣٢","PageNumber":497,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":432,"MaqraNumber":199,"HizbNumber":50,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":44,"SurahIndex":"044","VerseNumber":33,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَءَاتَيۡنَٰهُم مِّنَ ٱلۡأٓيَٰتِ مَا فِيهِ بَلَـٰٓؤٞاْ مُّبِينٌ","TajweedText":"وَءَاتَيْنَ<tajweed class=madda_normal>ـٰ</tajweed>ه<tajweed class=idgham_shafawi>ُم م</tajweed>ِّنَ <tajweed class=ham_wasl>ٱ</tajweed>لْأَيَ<tajweed class=madda_normal>ـٰ</tajweed>تِ مَا فِيهِ بَلَ<tajweed class=madda_obligatory>ـٰٓ</tajweed><tajweed class=idgham_ghunnah>ؤٌاْ م</tajweed>ُّب<tajweed class=madda_permissible>ِي</tajweed>نٌ <span class=end>٣٣</span>","End":"٣٣","PageNumber":497,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":432,"MaqraNumber":199,"HizbNumber":50,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":44,"SurahIndex":"044","VerseNumber":34,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّ هَـٰٓؤُلَآءِ لَيَقُولُونَ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َ هَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ؤُل<tajweed class=madda_obligatory>َا</tajweed>ٓءِ لَيَقُول<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣٤</span>","End":"٣٤","PageNumber":497,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":432,"MaqraNumber":199,"HizbNumber":50,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":44,"SurahIndex":"044","VerseNumber":35,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنۡ هِيَ إِلَّا مَوۡتَتُنَا ٱلۡأُولَىٰ وَمَا نَحۡنُ بِمُنشَرِينَ","TajweedText":"إِنْ هِىَ إِلَّا مَوْتَتُنَا <tajweed class=ham_wasl>ٱ</tajweed>لْأُولَىٰ وَمَا نَحْنُ بِمُ<tajweed class=ikhafa>نش</tajweed>َر<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٣٥</span>","End":"٣٥","PageNumber":497,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":432,"MaqraNumber":199,"HizbNumber":50,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":44,"SurahIndex":"044","VerseNumber":36,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَأۡتُواْ بِـَٔابَآئِنَآ إِن كُنتُمۡ صَٰدِقِينَ","TajweedText":"فَأْتُو<tajweed class=slnt>اْ</tajweed> بِـَٔـاب<tajweed class=madda_obligatory>َا</tajweed>ٓئِن<tajweed class=madda_obligatory>َآ</tajweed> إِ<tajweed class=ikhafa>ن ك</tajweed>ُ<tajweed class=ikhafa>نت</tajweed>ُمْ صَ<tajweed class=madda_normal>ـٰ</tajweed>دِق<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٣٦</span>","End":"٣٦","PageNumber":497,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":432,"MaqraNumber":199,"HizbNumber":50,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":44,"SurahIndex":"044","VerseNumber":37,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَهُمۡ خَيۡرٌ أَمۡ قَوۡمُ تُبَّعٖ وَٱلَّذِينَ مِن قَبۡلِهِمۡ أَهۡلَكۡنَٰهُمۡۚ إِنَّهُمۡ كَانُواْ مُجۡرِمِينَ","TajweedText":"أَهُمْ خَيْرٌ أَمْ قَوْمُ تُبَّ<tajweed class=idgham_ghunnah>عٍ و</tajweed>َ<tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ مِ<tajweed class=ikhafa>ن ق</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>لِهِمْ‌ۚ أَهْلَكْنَ<tajweed class=madda_normal>ـٰ</tajweed>هُمْ‌ۖ إِ<tajweed class=ghunnah>نّ</tajweed>َهُمْ كَانُو<tajweed class=slnt>اْ</tajweed> مُ<tajweed class=qalaqah>جْ</tajweed>رِم<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٣٧</span>","End":"٣٧","PageNumber":497,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":432,"MaqraNumber":199,"HizbNumber":50,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":44,"SurahIndex":"044","VerseNumber":38,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَا خَلَقۡنَا ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ وَمَا بَيۡنَهُمَا لَٰعِبِينَ","TajweedText":"وَمَا خَلَ<tajweed class=qalaqah>قْ</tajweed>نَا <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّمَ<tajweed class=madda_normal>ـٰ</tajweed>و<tajweed class=madda_normal>َٲ</tajweed>تِ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضَ وَمَا بَيْنَهُمَا لَ<tajweed class=madda_normal>ـٰ</tajweed>عِب<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٣٨</span>","End":"٣٨","PageNumber":497,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":432,"MaqraNumber":199,"HizbNumber":50,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":44,"SurahIndex":"044","VerseNumber":39,"ShowSurahName":false,"ShowBismillah":false,"Text":"مَا خَلَقۡنَٰهُمَآ إِلَّا بِٱلۡحَقِّ وَلَٰكِنَّ أَكۡثَرَهُمۡ لَا يَعۡلَمُونَ","TajweedText":"مَا خَلَ<tajweed class=qalaqah>قْ</tajweed>نَ<tajweed class=madda_normal>ـٰ</tajweed>هُم<tajweed class=madda_obligatory>َآ</tajweed> إِلَّا بِ<tajweed class=ham_wasl>ٱ</tajweed>لْحَقِّ وَلَ<tajweed class=madda_normal>ـٰ</tajweed>كِ<tajweed class=ghunnah>نّ</tajweed>َ أَكْثَرَهُمْ لَا يَعْلَم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣٩</span>","End":"٣٩","PageNumber":497,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":432,"MaqraNumber":199,"HizbNumber":50,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":44,"SurahIndex":"044","VerseNumber":40,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّ يَوۡمَ ٱلۡفَصۡلِ مِيقَٰتُهُمۡ أَجۡمَعِينَ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َ يَوْمَ <tajweed class=ham_wasl>ٱ</tajweed>لْفَصْلِ مِيقَ<tajweed class=madda_normal>ـٰ</tajweed>تُهُمْ أَ<tajweed class=qalaqah>جْ</tajweed>مَع<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٤٠</span>","End":"٤٠","PageNumber":498,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":432,"MaqraNumber":199,"HizbNumber":50,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":44,"SurahIndex":"044","VerseNumber":41,"ShowSurahName":false,"ShowBismillah":false,"Text":"يَوۡمَ لَا يُغۡنِي مَوۡلًى عَن مَّوۡلٗى شَيۡـٔٗا وَلَا هُمۡ يُنصَرُونَ","TajweedText":"يَوْمَ لَا يُغْنِى مَوْلًى ع<tajweed class=idgham_ghunnah>َن م</tajweed>َّوْ<tajweed class=ikhafa>لًى ش</tajweed>َيْـ<tajweed class=idgham_ghunnah>ـًٔا و</tajweed>َلَا هُمْ يُ<tajweed class=ikhafa>نص</tajweed>َر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٤١</span>","End":"٤١","PageNumber":498,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":432,"MaqraNumber":199,"HizbNumber":50,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":44,"SurahIndex":"044","VerseNumber":42,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِلَّا مَن رَّحِمَ ٱللَّهُۚ إِنَّهُۥ هُوَ ٱلۡعَزِيزُ ٱلرَّحِيمُ","TajweedText":"إِلَّا م<tajweed class=idgham_wo_ghunnah>َن ر</tajweed>َّحِمَ <tajweed class=ham_wasl>ٱ</tajweed>للَّهُ‌ۚ إِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> هُوَ <tajweed class=ham_wasl>ٱ</tajweed>لْعَزِيزُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رَّح<tajweed class=madda_permissible>ِي</tajweed>مُ <span class=end>٤٢</span>","End":"٤٢","PageNumber":498,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":432,"MaqraNumber":199,"HizbNumber":50,"HizbDecimal":0.5,"HasSajda":false}]}