{"RukuNumber":378,"Verses":[{"SurahNumber":35,"SurahIndex":"035","VerseNumber":15,"ShowSurahName":false,"ShowBismillah":false,"Text":"۞يَـٰٓأَيُّهَا ٱلنَّاسُ أَنتُمُ ٱلۡفُقَرَآءُ إِلَى ٱللَّهِۖ وَٱللَّهُ هُوَ ٱلۡغَنِيُّ ٱلۡحَمِيدُ","TajweedText":"۞ يَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>أَيُّهَا <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َاسُ أَ<tajweed class=ikhafa>نت</tajweed>ُمُ <tajweed class=ham_wasl>ٱ</tajweed>لْفُقَر<tajweed class=madda_obligatory>َا</tajweed>ٓءُ إِلَى <tajweed class=ham_wasl>ٱ</tajweed>للَّهِۖ وَ<tajweed class=ham_wasl>ٱ</tajweed>للَّهُ هُوَ <tajweed class=ham_wasl>ٱ</tajweed>لْغَنِىُّ <tajweed class=ham_wasl>ٱ</tajweed>لْحَم<tajweed class=madda_permissible>ِي</tajweed><tajweed class=qalaqah>د</tajweed>ُ <span class=end>١٥</span>","End":"١٥","PageNumber":436,"JuzNumber":22,"ManzilNumber":5,"RukuNumber":378,"MaqraNumber":175,"HizbNumber":44,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":35,"SurahIndex":"035","VerseNumber":16,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِن يَشَأۡ يُذۡهِبۡكُمۡ وَيَأۡتِ بِخَلۡقٖ جَدِيدٖ","TajweedText":"إ<tajweed class=idgham_ghunnah>ِن ي</tajweed>َشَأْ يُذْهِ<tajweed class=qalaqah>بْ</tajweed>كُمْ وَيَأْتِ بِخَلْ<tajweed class=ikhafa>قٍ ج</tajweed>َد<tajweed class=madda_permissible>ِي</tajweed><tajweed class=qalaqah>د</tajweed>ٍ <span class=end>١٦</span>","End":"١٦","PageNumber":436,"JuzNumber":22,"ManzilNumber":5,"RukuNumber":378,"MaqraNumber":175,"HizbNumber":44,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":35,"SurahIndex":"035","VerseNumber":17,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَا ذَٰلِكَ عَلَى ٱللَّهِ بِعَزِيزٖ","TajweedText":"وَمَا ذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ عَلَى <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ بِعَز<tajweed class=madda_permissible>ِي</tajweed>زٍ <span class=end>١٧</span>","End":"١٧","PageNumber":436,"JuzNumber":22,"ManzilNumber":5,"RukuNumber":378,"MaqraNumber":175,"HizbNumber":44,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":35,"SurahIndex":"035","VerseNumber":18,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَا تَزِرُ وَازِرَةٞ وِزۡرَ أُخۡرَىٰۚ وَإِن تَدۡعُ مُثۡقَلَةٌ إِلَىٰ حِمۡلِهَا لَا يُحۡمَلۡ مِنۡهُ شَيۡءٞ وَلَوۡ كَانَ ذَا قُرۡبَىٰٓۗ إِنَّمَا تُنذِرُ ٱلَّذِينَ يَخۡشَوۡنَ رَبَّهُم بِٱلۡغَيۡبِ وَأَقَامُواْ ٱلصَّلَوٰةَۚ وَمَن تَزَكَّىٰ فَإِنَّمَا يَتَزَكَّىٰ لِنَفۡسِهِۦۚ وَإِلَى ٱللَّهِ ٱلۡمَصِيرُ","TajweedText":"وَلَا تَزِرُ وَازِرَ<tajweed class=idgham_ghunnah>ةٌ و</tajweed>ِزْرَ أُخْرَىٰۚ وَإِ<tajweed class=ikhafa>ن ت</tajweed>َ<tajweed class=qalaqah>دْ</tajweed>عُ مُثْقَلَةٌ إِلَىٰ حِمْلِهَا لَا يُحْمَلْ مِنْهُ ش<tajweed class=idgham_ghunnah>َىْءٌ و</tajweed>َلَوْ كَانَ ذَا قُرْبَ<tajweed class=madda_obligatory>ىٰٓۗ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َمَا تُ<tajweed class=ikhafa>نذ</tajweed>ِرُ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ يَخْشَوْنَ رَبَّه<tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِ<tajweed class=ham_wasl>ٱ</tajweed>لْغَيْبِ وَأَقَامُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>صَّلَ<tajweed class=slnt>و</tajweed><tajweed class=madda_normal>ٲ</tajweed>ةَۚ وَمَ<tajweed class=ikhafa>ن ت</tajweed>َزَكَّىٰ فَإِ<tajweed class=ghunnah>نّ</tajweed>َمَا يَتَزَكَّىٰ لِنَفْسِهِ<tajweed class=madda_normal>ۚۦ</tajweed> وَإِلَى <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ <tajweed class=ham_wasl>ٱ</tajweed>لْمَص<tajweed class=madda_permissible>ِي</tajweed>رُ <span class=end>١٨</span>","End":"١٨","PageNumber":436,"JuzNumber":22,"ManzilNumber":5,"RukuNumber":378,"MaqraNumber":175,"HizbNumber":44,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":35,"SurahIndex":"035","VerseNumber":19,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَا يَسۡتَوِي ٱلۡأَعۡمَىٰ وَٱلۡبَصِيرُ","TajweedText":"وَمَا يَسْتَوِى <tajweed class=ham_wasl>ٱ</tajweed>لْأَعْمَىٰ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْبَص<tajweed class=madda_permissible>ِي</