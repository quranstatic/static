tajweed> أَ<tajweed class=ikhafa>نت</tajweed>َ بِمُسْمِ<tajweed class=idgham_ghunnah>عٍ م</tajweed>َّ<tajweed class=ikhafa>ن ف</tajweed>ِى <tajweed class=ham_wasl>ٱ</tajweed>لْقُب<tajweed class=madda_permissible>ُو</tajweed>رِ <span class=end>٢٢</span>","End":"٢٢","PageNumber":437,"JuzNumber":22,"ManzilNumber":5,"RukuNumber":378,"MaqraNumber":175,"HizbNumber":44,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":35,"SurahIndex":"035","VerseNumber":23,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنۡ أَنتَ إِلَّا نَذِيرٌ","TajweedText":"إِنْ أَ<tajweed class=ikhafa>نت</tajweed>َ إِلَّا نَذ<tajweed class=madda_permissible>ِي</tajweed>رٌ <span class=end>٢٣</span>","End":"٢٣","PageNumber":437,"JuzNumber":22,"ManzilNumber":5,"RukuNumber":378,"MaqraNumber":175,"HizbNumber":44,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":35,"SurahIndex":"035","VerseNumber":24,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّآ أَرۡسَلۡنَٰكَ بِٱلۡحَقِّ بَشِيرٗا وَنَذِيرٗاۚ وَإِن مِّنۡ أُمَّةٍ إِلَّا خَلَا فِيهَا نَذِيرٞ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed><tajweed class=madda_obligatory>َآ</tajweed> أَرْسَلْنَ<tajweed class=madda_normal>ـٰ</tajweed>كَ بِ<tajweed class=ham_wasl>ٱ</tajweed>لْحَقِّ بَشِي<tajweed class=idgham_ghunnah>رًا و</tajweed>َنَذِي<tajweed class=idgham_ghunnah>رًاۚ و</tajweed>َإ<tajweed class=idgham_ghunnah>ِن م</tajweed>ِّنْ أُ<tajweed class=ghunnah>مّ</tajweed>َةٍ إِلَّا خَلَا فِيهَا نَذ<tajweed class=madda_permissible>ِي</tajweed>رٌ <span class=end>٢٤</span>","End":"٢٤","PageNumber":437,"JuzNumber":22,"ManzilNumber":5,"RukuNumber":378,"MaqraNumber":175,"HizbNumber":44,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":35,"SurahIndex":"035","VerseNumber":25,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِن يُكَذِّبُوكَ فَقَدۡ كَذَّبَ ٱلَّذِينَ مِن قَبۡلِهِمۡ جَآءَتۡهُمۡ رُسُلُهُم بِٱلۡبَيِّنَٰتِ وَبِٱلزُّبُرِ وَبِٱلۡكِتَٰبِ ٱلۡمُنِيرِ","TajweedText":"وَإ<tajweed class=idgham_ghunnah>ِن ي</tajweed>ُكَذِّبُوكَ فَقَ<tajweed class=qalaqah>دْ</tajweed> كَذَّبَ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ مِ<tajweed class=ikhafa>ن ق</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>لِهِمْ ج<tajweed class=madda_obligatory>َا</tajweed>ٓءَتْهُمْ رُسُلُه<tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِ<tajweed class=ham_wasl>ٱ</tajweed>لْبَيِّنَ<tajweed class=madda_normal>ـٰ</tajweed>تِ وَبِ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>زُّبُرِ وَبِ<tajweed class=ham_wasl>ٱ</tajweed>لْكِتَ<tajweed class=madda_normal>ـٰ</tajweed>بِ <tajweed class=ham_wasl>ٱ</tajweed>لْمُن<tajweed class=madda_permissible>ِي</tajweed>رِ <span class=end>٢٥</span>","End":"٢٥","PageNumber":437,"JuzNumber":22,"ManzilNumber":5,"RukuNumber":378,"MaqraNumber":175,"HizbNumber":44,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":35,"SurahIndex":"035","VerseNumber":26,"ShowSurahName":false,"ShowBismillah":false,"Text":"ثُمَّ أَخَذۡتُ ٱلَّذِينَ كَفَرُواْۖ فَكَيۡفَ كَانَ نَكِيرِ","TajweedText":"ثُ<tajweed class=ghunnah>مّ</tajweed>َ أَخَذْتُ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ كَفَرُو<tajweed class=slnt>اْۖ</tajweed> فَكَيْفَ كَانَ نَك<tajweed class=madda_permissible>ِي</tajweed>رِ <span class=end>٢٦</span>","End":"٢٦","PageNumber":437,"JuzNumber":22,"ManzilNumber":5,"RukuNumber":378,"MaqraNumber":175,"HizbNumber":44,"HizbDecimal":0.5,"HasSajda":false}]}