{"RukuNumber":515,"Verses":[{"SurahNumber":76,"SurahIndex":"076","VerseNumber":23,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّا نَحۡنُ نَزَّلۡنَا عَلَيۡكَ ٱلۡقُرۡءَانَ تَنزِيلٗا","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َا نَحْنُ نَزَّلْنَا عَلَيْكَ <tajweed class=ham_wasl>ٱ</tajweed>لْقُرْءَانَ تَ<tajweed class=ikhafa>نز</tajweed>ِيلاً <span class=end>٢٣</span>","End":"٢٣","PageNumber":579,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":515,"MaqraNumber":232,"HizbNumber":58,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":76,"SurahIndex":"076","VerseNumber":24,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَٱصۡبِرۡ لِحُكۡمِ رَبِّكَ وَلَا تُطِعۡ مِنۡهُمۡ ءَاثِمًا أَوۡ كَفُورٗا","TajweedText":"فَ<tajweed class=ham_wasl>ٱ</tajweed>صْبِرْ لِحُكْمِ رَبِّكَ وَلَا تُطِعْ مِنْهُمْ ءَاثِمًا أَوْ كَفُورًا <span class=end>٢٤</span>","End":"٢٤","PageNumber":579,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":515,"MaqraNumber":232,"HizbNumber":58,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":76,"SurahIndex":"076","VerseNumber":25,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَٱذۡكُرِ ٱسۡمَ رَبِّكَ بُكۡرَةٗ وَأَصِيلٗا","TajweedText":"وَ<tajweed class=ham_wasl>ٱ</tajweed>ذْكُرِ <tajweed class=ham_wasl>ٱ</tajweed>سْمَ رَبِّكَ بُكْرَ<tajweed class=idgham_ghunnah>ةً و</tajweed>َأَصِيلاً <span class=end>٢٥</span>","End":"٢٥","PageNumber":579,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":515,"MaqraNumber":232,"HizbNumber":58,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":76,"SurahIndex":"076","VerseNumber":26,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمِنَ ٱلَّيۡلِ فَٱسۡجُدۡ لَهُۥ وَسَبِّحۡهُ لَيۡلٗا طَوِيلًا","TajweedText":"وَمِنَ <tajweed class=ham_wasl>ٱ</tajweed>لَّيْلِ فَ<tajweed class=ham_wasl>ٱ</tajweed>سْجُ<tajweed class=qalaqah>دْ</tajweed> لَهُ<tajweed class=madda_normal>ۥ</tajweed> وَسَبِّحْهُ لَيْل<tajweed class=ikhafa>اً ط</tajweed>َوِيلاً <span class=end>٢٦</span>","End":"٢٦","PageNumber":580,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":515,"MaqraNumber":232,"HizbNumber":58,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":76,"SurahIndex":"076","VerseNumber":27,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّ هَـٰٓؤُلَآءِ يُحِبُّونَ ٱلۡعَاجِلَةَ وَيَذَرُونَ وَرَآءَهُمۡ يَوۡمٗا ثَقِيلٗا","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َ هَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ؤُل<tajweed class=madda_obligatory>َا</tajweed>ٓءِ يُحِبُّونَ <tajweed class=ham_wasl>ٱ</tajweed>لْعَاجِلَةَ وَيَذَرُونَ وَر<tajweed class=madda_obligatory>َا</tajweed>ٓءَهُمْ يَوْ<tajweed class=ikhafa>مًا ث</tajweed>َقِيلاً <span class=end>٢٧</span>","End":"٢٧","PageNumber":580,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":515,"MaqraNumber":232,"HizbNumber":58,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":76,"SurahIndex":"076","VerseNumber":28,"ShowSurahName":false,"ShowBismillah":false,"Text":"نَّحۡنُ خَلَقۡنَٰهُمۡ وَشَدَدۡنَآ أَسۡرَهُمۡۖ وَإِذَا شِئۡنَا بَدَّلۡنَآ أَمۡثَٰلَهُمۡ تَبۡدِيلًا","TajweedText":"نَّحْنُ خَلَ<tajweed class=qalaqah>قْ</tajweed>نَ<tajweed class=madda_normal>ـٰ</tajweed>هُمْ وَشَدَ<tajweed class=qalaqah>دْ</tajweed>ن<tajweed class=madda_obligatory>َآ</tajweed> أَسْرَهُمْ‌ۖ وَإِذَا شِئْنَا بَدَّلْن<tajweed class=madda_obligatory>َآ</tajweed> أَمْثَ<tajweed class=madda_normal>ـٰ</tajweed>لَهُمْ تَ<tajweed class=qalaqah>بْ</tajweed>دِيلاً <span class=end>٢٨</span>","End":"٢٨","PageNumber":580,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":515,"MaqraNumber":232,"HizbNumber":58,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":76,"SurahIndex":"076","VerseNumber":29,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّ هَٰذِهِۦ تَذۡكِرَةٞۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ سَبِيلٗا","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َ هَ<tajweed class=madda_normal>ـٰ</tajweed>ذِه<tajweed class=madda_normal>ِۦ</tajweed> تَذْكِرَ<tajweed class=ikhafa>ةٌ‌ۖ ف</tajweed>َمَ<tajweed class=ikhafa>ن ش</tajweed><tajweed class=madda_obligatory>َا</tajweed>ٓءَ <tajweed class=ham_wasl>ٱ</tajweed>تَّخَذَ إِلَىٰ رَبِّه<tajweed class=madda_normal>ِۦ</tajweed> سَبِيلاً <span class=end>٢٩</span>","End":"٢٩","PageNumber":580,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":515,"MaqraNumber":232,"HizbNumber":58,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":76,"SurahIndex":"076","VerseNumber":30,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُۚ إِنَّ ٱللَّهَ كَانَ عَلِيمًا حَكِيمٗا","TajweedText":"وَمَا تَش<tajweed class=madda_obligatory>َا</tajweed>ٓءُونَ إِلّ<tajweed class=madda_obligatory>َآ</tajweed> أ<tajweed class=idgham_ghunnah>َن ي</tajweed>َش<tajweed class=madda_obligatory>َا</tajweed>ٓءَ <tajweed class=ham_wasl>ٱ</tajweed>للَّهُ‌ۚ إِ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>للَّهَ كَانَ عَلِيمًا حَكِيمًا <span class=end>٣٠</span>","End":"٣٠","PageNumber":580,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":515,"MaqraNumber":232,"HizbNumber":58,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":76,"SurahIndex":"076","VerseNumber":31,"ShowSurahName":false,"ShowBismillah":false,"Text":"يُدۡخِلُ مَن يَشَآءُ فِي رَحۡمَتِهِۦۚ وَٱلظَّـٰلِمِينَ أَعَدَّ لَهُمۡ عَذَابًا أَلِيمَۢا","TajweedText":"يُ<tajweed class=qalaqah>دْ</tajweed>خِلُ م<tajweed class=idgham_ghunnah>َن ي</tajweed>َش<tajweed class=madda_obligatory>َا</tajweed>ٓءُ فِى رَحْمَتِه<tajweed class=madda_normal>ِۦ</tajweed>‌ۚ وَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>ظَّ<tajweed class=madda_normal>ـٰ</tajweed>لِمِينَ أَعَدَّ لَهُمْ عَذَابًا أَلِيمَۢا <span class=end>٣١</span>","End":"٣١","PageNumber":580,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":515,"MaqraNumber":232,"HizbNumber":58,"HizbDecimal":0.75,"HasSajda":false}]}