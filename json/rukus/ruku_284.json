{"RukuNumber":284,"Verses":[{"SurahNumber":21,"SurahIndex":"021","VerseNumber":94,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَمَن يَعۡمَلۡ مِنَ ٱلصَّـٰلِحَٰتِ وَهُوَ مُؤۡمِنٞ فَلَا كُفۡرَانَ لِسَعۡيِهِۦ وَإِنَّا لَهُۥ كَٰتِبُونَ","TajweedText":"فَم<tajweed class=idgham_ghunnah>َن ي</tajweed>َعْمَلْ مِنَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>صَّ<tajweed class=madda_normal>ـٰ</tajweed>لِحَ<tajweed class=madda_normal>ـٰ</tajweed>تِ وَهُوَ مُؤْمِ<tajweed class=ikhafa>نٌ ف</tajweed>َلَا كُفْرَانَ لِسَعْيِه<tajweed class=madda_normal>ِۦ</tajweed> وَإِ<tajweed class=ghunnah>نّ</tajweed>َا لَهُ<tajweed class=madda_normal>ۥ</tajweed> كَ<tajweed class=madda_normal>ـٰ</tajweed>تِب<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٩٤</span>","End":"٩٤","PageNumber":330,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":284,"MaqraNumber":132,"HizbNumber":33,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":95,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَحَرَٰمٌ عَلَىٰ قَرۡيَةٍ أَهۡلَكۡنَٰهَآ أَنَّهُمۡ لَا يَرۡجِعُونَ","TajweedText":"وَحَر<tajweed class=madda_normal>َٲ</tajweed>مٌ عَلَىٰ قَرْيَةٍ أَهْلَكْنَ<tajweed class=madda_normal>ـٰ</tajweed>ه<tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=ghunnah>نّ</tajweed>َهُمْ لَا يَرْجِع<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٩٥</span>","End":"٩٥","PageNumber":330,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":284,"MaqraNumber":132,"HizbNumber":33,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":96,"ShowSurahName":false,"ShowBismillah":false,"Text":"حَتَّىٰٓ إِذَا فُتِحَتۡ يَأۡجُوجُ وَمَأۡجُوجُ وَهُم مِّن كُلِّ حَدَبٖ يَنسِلُونَ","TajweedText":"حَتَّ<tajweed class=madda_obligatory>ىٰٓ</tajweed> إِذَا فُتِحَتْ يَأْجُوجُ وَمَأْجُوجُ وَه<tajweed class=idgham_shafawi>ُم م</tajweed>ِّ<tajweed class=ikhafa>ن ك</tajweed>ُلِّ حَدَ<tajweed class=idgham_ghunnah>بٍ ي</tajweed>َ<tajweed class=ikhafa>نس</tajweed>ِل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٩٦</span>","End":"٩٦","PageNumber":330,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":284,"MaqraNumber":132,"HizbNumber":33,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":97,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَٱقۡتَرَبَ ٱلۡوَعۡدُ ٱلۡحَقُّ فَإِذَا هِيَ شَٰخِصَةٌ أَبۡصَٰرُ ٱلَّذِينَ كَفَرُواْ يَٰوَيۡلَنَا قَدۡ كُنَّا فِي غَفۡلَةٖ مِّنۡ هَٰذَا بَلۡ كُنَّا ظَٰلِمِينَ","TajweedText":"وَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=qalaqah>قْ</tajweed>تَرَبَ <tajweed class=ham_wasl>ٱ</tajweed>لْوَعْدُ <tajweed class=ham_wasl>ٱ</tajweed>لْحَقُّ فَإِذَا هِىَ شَ<tajweed class=madda_normal>ـٰ</tajweed>خِصَةٌ أَ<tajweed class=qalaqah>بْ</tajweed>صَ<tajweed class=madda_normal>ـٰ</tajweed>رُ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ كَفَرُو<tajweed class=slnt>اْ</tajweed> يَ<tajweed class=madda_normal>ـٰ</tajweed>وَيْلَنَا قَ<tajweed class=qalaqah>دْ</tajweed> كُ<tajweed class=ghunnah>نّ</tajweed>َا فِى غَفْلَ<tajweed class=idgham_ghunnah>ةٍ م</tajweed>ِّنْ هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا بَلْ كُ<tajweed class=ghunnah>نّ</tajweed>َا ظَ<tajweed class=madda_normal>ـٰ</tajweed>لِم<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٩٧</span>","End":"٩٧","PageNumber":330,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":284,"MaqraNumber":132,"HizbNumber":33,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":98,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّكُمۡ وَمَا تَعۡبُدُونَ مِن دُونِ ٱللَّهِ حَصَبُ جَهَنَّمَ أَنتُمۡ لَهَا وَٰرِدُونَ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َكُمْ وَمَا تَعْبُدُونَ مِ<tajweed class=ikhafa>ن د</tajweed>ُونِ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ حَصَبُ جَهَ<tajweed class=ghunnah>نّ</tajweed>َمَ أَ<tajweed class=ikhafa>نت</tajweed>ُمْ لَهَا و<tajweed class=madda_normal>َٲ</tajweed>رِد<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٩٨</span>","End":"٩٨","PageNumber":330,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":284,"MaqraNumber":132,"HizbNumber":33,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":99,"ShowSurahName":false,"ShowBismillah":false,"Text":"لَوۡ كَانَ هَـٰٓؤُلَآءِ ءَالِهَةٗ مَّا وَرَدُوهَاۖ وَكُلّٞ فِيهَا خَٰلِدُونَ","TajweedText":"لَوْ كَانَ هَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ؤُل<tajweed class=madda_obligatory>َا</tajweed>ٓءِ ءَالِهَ<tajweed class=idgham_ghunnah>ةً م</tajweed>َّا وَرَدُوهَا‌ۖ وَكُ<tajweed class=ikhafa>لٌّ ف</tajweed>ِيهَا خَ<tajweed class=madda_normal>ـٰ</tajweed>لِد<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٩٩</span>","End":"٩٩","PageNumber":330,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":284,"MaqraNumber":132,"HizbNumber":33,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":100,"ShowSurahName":false,"ShowBismillah":false,"Text":"لَهُمۡ فِيهَا زَفِيرٞ وَهُمۡ فِيهَا لَا يَسۡمَعُونَ","TajweedText":"لَهُمْ فِيهَا زَفِي<tajweed class=idgham_ghunnah>رٌ و</tajweed>َهُمْ فِيهَا لَا يَسْمَع<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٠٠</span>","End":"١٠٠","PageNumber":330,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":284,"MaqraNumber":132,"HizbNumber":33,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":101,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّ ٱلَّذِينَ سَبَقَتۡ لَهُم مِّنَّا ٱلۡحُسۡنَىٰٓ أُوْلَـٰٓئِكَ عَنۡهَا مُبۡعَدُونَ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ سَبَقَتْ لَه<tajweed class=idgham_shafawi>ُم م</tajweed>ِّ<tajweed class=ghunnah>نّ</tajweed>َا <tajweed class=ham_wasl>ٱ</tajweed>لْحُسْنَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> أُ<tajweed class=slnt>وْ</tajweed>لَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ئِكَ عَنْهَا مُ<tajweed class=qalaqah>بْ</tajweed>عَد<tajw