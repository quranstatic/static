{"RukuNumber":350,"Verses":[{"SurahNumber":30,"SurahIndex":"030","VerseNumber":11,"ShowSurahName":false,"ShowBismillah":false,"Text":"ٱللَّهُ يَبۡدَؤُاْ ٱلۡخَلۡقَ ثُمَّ يُعِيدُهُۥ ثُمَّ إِلَيۡهِ تُرۡجَعُونَ","TajweedText":"ٱللَّهُ يَ<tajweed class=qalaqah>بْ</tajweed>دَؤُ<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed>لْخَلْقَ ثُ<tajweed class=ghunnah>مّ</tajweed>َ يُعِيدُهُ<tajweed class=madda_normal>ۥ</tajweed> ثُ<tajweed class=ghunnah>مّ</tajweed>َ إِلَيْهِ تُرْجَع<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١١</span>","End":"١١","PageNumber":405,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":350,"MaqraNumber":162,"HizbNumber":41,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":30,"SurahIndex":"030","VerseNumber":12,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَيَوۡمَ تَقُومُ ٱلسَّاعَةُ يُبۡلِسُ ٱلۡمُجۡرِمُونَ","TajweedText":"وَيَوْمَ تَقُومُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّاعَةُ يُ<tajweed class=qalaqah>بْ</tajweed>لِسُ <tajweed class=ham_wasl>ٱ</tajweed>لْمُ<tajweed class=qalaqah>جْ</tajweed>رِم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٢</span>","End":"١٢","PageNumber":405,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":350,"MaqraNumber":162,"HizbNumber":41,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":30,"SurahIndex":"030","VerseNumber":13,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَمۡ يَكُن لَّهُم مِّن شُرَكَآئِهِمۡ شُفَعَـٰٓؤُاْ وَكَانُواْ بِشُرَكَآئِهِمۡ كَٰفِرِينَ","TajweedText":"وَلَمْ يَك<tajweed class=idgham_wo_ghunnah>ُن ل</tajweed>َّه<tajweed class=idgham_shafawi>ُم م</tajweed>ِّ<tajweed class=ikhafa>ن ش</tajweed>ُرَك<tajweed class=madda_obligatory>َا</tajweed>ٓئِهِمْ شُفَعَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ؤُ<tajweed class=slnt>اْ</tajweed> وَكَانُو<tajweed class=slnt>اْ</tajweed> بِشُرَك<tajweed class=madda_obligatory>َا</tajweed>ٓئِهِمْ كَ<tajweed class=madda_normal>ـٰ</tajweed>فِر<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٣</span>","End":"١٣","PageNumber":405,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":350,"MaqraNumber":162,"HizbNumber":41,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":30,"SurahIndex":"030","VerseNumber":14,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَيَوۡمَ تَقُومُ ٱلسَّاعَةُ يَوۡمَئِذٖ يَتَفَرَّقُونَ","TajweedText":"وَيَوْمَ تَقُومُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّاعَةُ يَوْمَئِ<tajweed class=idgham_ghunnah>ذٍ ي</tajweed>َتَفَرَّق<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٤</span>","End":"١٤","PageNumber":405,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":350,"MaqraNumber":162,"HizbNumber":41,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":30,"SurahIndex":"030","VerseNumber":15,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَأَمَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّـٰلِحَٰتِ فَهُمۡ فِي رَوۡضَةٖ يُحۡبَرُونَ","TajweedText":"فَأَ<tajweed class=ghunnah>مّ</tajweed>َا <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ ءَامَنُو<tajweed class=slnt>اْ</tajweed> وَعَمِلُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>صَّ<tajweed class=madda_normal>ـٰ</tajweed>لِحَ<tajweed class=madda_normal>ـٰ</tajweed>تِ فَهُمْ فِى رَوْضَ<tajweed class=idgham_ghunnah>ةٍ ي</tajweed>ُحْبَر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٥</span>","End":"١٥","PageNumber":405,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":350,"MaqraNumber":162,"HizbNumber":41,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":30,"SurahIndex":"030","VerseNumber":16,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَأَمَّا ٱلَّذِينَ كَفَرُواْ وَكَذَّبُواْ بِـَٔايَٰتِنَا وَلِقَآيِٕ ٱلۡأٓخِرَةِ فَأُوْلَـٰٓئِكَ فِي ٱلۡعَذَابِ مُحۡضَرُونَ","TajweedText":"وَأَ<tajweed class=ghunnah>مّ</tajweed>َا <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ كَفَرُو<tajweed class=slnt>اْ</tajweed> وَكَذَّبُو<tajweed class=slnt>اْ</tajweed> بِـَٔـايَ<tajweed class=madda_normal>ـٰ</tajweed>تِنَا وَلِقَآىِٕ <tajweed class=ham_wasl>ٱ</tajweed>لْأَخِرَةِ فَأُ<tajweed class=slnt>وْ</tajweed>لَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ئِكَ فِى <tajweed class=ham_wasl>ٱ</tajweed>لْعَذَابِ مُحْضَر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٦</span>","End":"١٦","PageNumber":406,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":350,"MaqraNumber":162,"HizbNumber":41,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":30,"SurahIndex":"030","VerseNumber":17,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَسُبۡحَٰنَ ٱللَّهِ حِينَ تُمۡسُونَ وَحِينَ تُصۡبِحُونَ","TajweedText":"فَسُ<tajweed class=qalaqah>بْ</tajweed>حَ<tajweed class=madda_normal>ـٰ</tajweed>نَ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ حِينَ تُمْسُونَ وَحِينَ تُصْبِح<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٧</span>","End":"١٧","PageNumber":406,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":350,"MaqraNumber":162,"HizbNumber":41,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":30,"SurahIndex":"030","VerseNumber":18,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَهُ ٱلۡحَمۡدُ فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَعَشِيّٗا وَحِينَ تُظۡهِرُونَ","TajweedText":"وَلَهُ <tajweed class=ham_wasl>ٱ</tajweed>لْحَمْدُ فِى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّمَ<tajweed class=madda_normal>ـٰ</tajweed>و<tajweed class=madda_normal>َٲ</tajweed>تِ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ وَعَشِي<tajweed class=idgham_ghunnah>ًّا و</tajweed>َحِينَ تُظْهِر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٨</span>","End":"١٨","PageNumber":406,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":350,"MaqraNumber":162,"HizbNumber":41,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":30,"SurahIndex":"030","VerseNumber":19,"ShowSurahName":false,"ShowBismillah":false,"Text":"يُخۡرِجُ ٱلۡحَيَّ مِنَ ٱلۡمَيِّتِ وَيُخۡرِجُ ٱلۡمَيِّتَ مِنَ ٱلۡحَيِّ وَيُحۡيِ ٱلۡأَرۡضَ بَعۡدَ مَوۡتِهَاۚ وَكَذَٰلِكَ تُخۡرَجُونَ","TajweedText":"يُخْرِجُ <tajweed class=ham_wasl>ٱ</tajweed>لْحَىَّ مِنَ <tajweed class=ham_wasl>ٱ</tajweed>لْمَيِّتِ وَيُخْرِجُ <tajweed class=ham_wasl>ٱ</tajweed>لْمَيِّتَ مِنَ <tajweed class=ham_wasl>ٱ</tajweed>لْحَىِّ وَيُحْىِ <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضَ بَعْدَ مَوْتِهَا‌ۚ وَكَذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ تُخْرَج<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٩</span>","End":"١٩","PageNumber":406,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":350,"MaqraNumber":162,"HizbNumber":41,"HizbDecimal":0.25,"HasSajda":false}]}