{"Id":75,"LanguageCode":"cat","Name":"cat-yousseflyoussi-la","Author":"Youssef Lyoussi","Language":"Catalan","Description":"Catalan - Latinised","Direction":"ltr","Source":"","Translations":[{"SurahNumber":108,"VerseNumber":1,"Text":"T'hem donat l'Abundancia"},{"SurahNumber":108,"VerseNumber":2,"Text":"Ora, doncs, al teu Senyor i oferix sacrificis"},{"SurahNumber":108,"VerseNumber":3,"Text":"Si, es quin t'odia el privat de posteritat"}]}