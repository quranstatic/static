{"RukuNumber":122,"Verses":[{"SurahNumber":7,"SurahIndex":"007","VerseNumber":1,"ShowSurahName":true,"ShowBismillah":true,"Text":"الٓمٓصٓ","TajweedText":"ا<tajweed class=madda_necessary>لٓ</tajweed><tajweed class=madda_necessary>مٓ</tajweed><tajweed class=madda_necessary>صٓ</tajweed> <span class=end>١</span>","End":"١","PageNumber":151,"JuzNumber":8,"ManzilNumber":2,"RukuNumber":122,"MaqraNumber":61,"HizbNumber":16,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":7,"SurahIndex":"007","VerseNumber":2,"ShowSurahName":false,"ShowBismillah":false,"Text":"كِتَٰبٌ أُنزِلَ إِلَيۡكَ فَلَا يَكُن فِي صَدۡرِكَ حَرَجٞ مِّنۡهُ لِتُنذِرَ بِهِۦ وَذِكۡرَىٰ لِلۡمُؤۡمِنِينَ","TajweedText":"كِتَ<tajweed class=madda_normal>ـٰ</tajweed>بٌ أُ<tajweed class=ikhafa>نز</tajweed>ِلَ إِلَيْكَ فَلَا يَكُ<tajweed class=ikhafa>ن ف</tajweed>ِى صَ<tajweed class=qalaqah>دْ</tajweed>رِكَ حَرَ<tajweed class=idgham_ghunnah>جٌ م</tajweed>ِّنْهُ لِتُ<tajweed class=ikhafa>نذ</tajweed>ِرَ بِه<tajweed class=madda_normal>ِۦ</tajweed> وَذِكْرَىٰ لِلْمُؤْمِن<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٢</span>","End":"٢","PageNumber":151,"JuzNumber":8,"ManzilNumber":2,"RukuNumber":122,"MaqraNumber":61,"HizbNumber":16,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":7,"SurahIndex":"007","VerseNumber":3,"ShowSurahName":false,"ShowBismillah":false,"Text":"ٱتَّبِعُواْ مَآ أُنزِلَ إِلَيۡكُم مِّن رَّبِّكُمۡ وَلَا تَتَّبِعُواْ مِن دُونِهِۦٓ أَوۡلِيَآءَۗ قَلِيلٗا مَّا تَذَكَّرُونَ","TajweedText":"ٱتَّبِعُو<tajweed class=slnt>اْ</tajweed> م<tajweed class=madda_obligatory>َآ</tajweed> أُ<tajweed class=ikhafa>نز</tajweed>ِلَ إِلَيْك<tajweed class=idgham_shafawi>ُم م</tajweed>ّ<tajweed class=idgham_wo_ghunnah>ِن ر</tajweed>َّبِّكُمْ وَلَا تَتَّبِعُو<tajweed class=slnt>اْ</tajweed> مِ<tajweed class=ikhafa>ن د</tajweed>ُونِه<tajweed class=madda_obligatory>ِۦٓ</tajweed> أَوْلِي<tajweed class=madda_obligatory>َا</tajweed>ٓءَ‌ۗ قَلِيل<tajweed class=idgham_ghunnah>اً م</tajweed>َّا تَذَكَّر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣</span>","End":"٣","PageNumber":151,"JuzNumber":8,"ManzilNumber":2,"RukuNumber":122,"MaqraNumber":61,"HizbNumber":16,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":7,"SurahIndex":"007","VerseNumber":4,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَكَم مِّن قَرۡيَةٍ أَهۡلَكۡنَٰهَا فَجَآءَهَا بَأۡسُنَا بَيَٰتًا أَوۡ هُمۡ قَآئِلُونَ","TajweedText":"وَك<tajweed class=idgham_shafawi>َم م</tajweed>ِّ<tajweed class=ikhafa>ن ق</tajweed>َرْيَةٍ أَهْلَكْنَ<tajweed class=madda_normal>ـٰ</tajweed>هَا فَج<tajweed class=madda_obligatory>َا</tajweed>ٓءَهَا بَأْسُنَا بَيَ<tajweed class=madda_normal>ـٰ</tajweed>تًا أَوْ هُمْ ق<tajweed class=madda_obligatory>َا</tajweed>ٓئِل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٤</span>","End":"٤","PageNumber":151,"JuzNumber":8,"ManzilNumber":2,"RukuNumber":122,"MaqraNumber":61,"HizbNumber":16,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":7,"SurahIndex":"007","VerseNumber":5,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَمَا كَانَ دَعۡوَىٰهُمۡ إِذۡ جَآءَهُم بَأۡسُنَآ إِلَّآ أَن قَالُوٓاْ إِنَّا كُنَّا ظَٰلِمِينَ","TajweedText":"فَمَا كَانَ دَعْوَ<tajweed class=madda_normal>ٮٰ</tajweed>هُمْ إِذْ ج<tajweed class=madda_obligatory>َا</tajweed>ٓءَه<tajweed class=ikhafa_shafawi>ُم ب</tajweed>َأْسُن<tajweed class=madda_obligatory>َآ</tajweed> إِلّ<tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=ikhafa>ن ق</tajweed>َال<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َا كُ<tajweed class=ghunnah>نّ</tajweed>َا ظَ<tajweed class=madda_normal>ـٰ</tajweed>لِم<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٥</span>","End":"٥","PageNumber":151,"JuzNumber":8,"ManzilNumber":2,"RukuNumber":122,"MaqraNumber":61,"HizbNumber":16,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":7,"SurahIndex":"007","VerseNumber":6,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَلَنَسۡـَٔلَنَّ ٱلَّذِينَ أُرۡسِلَ إِلَيۡهِمۡ وَلَنَسۡـَٔلَنَّ ٱلۡمُرۡسَلِينَ","TajweedText":"فَلَنَسْــَٔلَ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ أُرْسِلَ إِلَيْهِمْ وَلَنَسْــَٔلَ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>لْمُرْسَل<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٦</span>","End":"٦","PageNumber":151,"JuzNumber":8,"ManzilNumber":2,"RukuNumber":122,"MaqraNumber":61,"HizbNumber":16,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":7,"SurahIndex":"007","VerseNumber":7,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَلَنَقُصَّنَّ عَلَيۡهِم بِعِلۡمٖۖ وَمَا كُنَّا غَآئِبِينَ","TajweedText":"فَلَنَقُصَّ<tajweed class=ghunnah>نّ</tajweed>َ عَلَيْه<tajweed class=ikhafa_shafawi>ِم ب</tajweed>ِعِلْ<tajweed class=idgham_ghunnah>مٍ‌ۖ و</tajweed>َمَا كُ<tajweed class=ghunnah>نّ</tajweed>َا غ<tajweed class=madda_obligatory>َا</tajweed>ٓئِب<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٧</span>","End":"٧","PageNumber":151,"JuzNumber":8,"ManzilNumber":2,"RukuNumber":122,"MaqraNumber":61,"HizbNumber":16,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":7,"SurahIndex":"007","VerseNumber":8,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَٱلۡوَزۡنُ يَوۡمَئِذٍ ٱلۡحَقُّۚ فَمَن ثَقُلَتۡ مَوَٰزِينُهُۥ فَأُوْلَـٰٓئِكَ هُمُ ٱلۡمُفۡلِحُونَ","TajweedText":"وَ<tajweed class=ham_wasl>ٱ</tajweed>لْوَزْنُ يَوْمَئِذٍ <tajweed class=ham_wasl>ٱ</tajweed>لْحَقُّ‌ۚ فَمَ<tajweed class=ikhafa>ن ث</tajweed>َقُلَتْ مَو<tajweed class=madda_normal>َٲ</tajweed>زِينُهُ<tajweed class=madda_normal>ۥ</tajweed> فَأُ<tajweed class=slnt>وْ</tajweed>لَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ئِكَ هُمُ <tajweed class=ham_wasl>ٱ</tajweed>لْمُفْلِح<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٨</span>","End":"٨","PageNumber":151,"JuzNumber":8,"ManzilNumber":2,"RukuNumber":122,"MaqraNumber":61,"HizbNumber":16,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":7,"SurahIndex":"007","VerseNumber":9,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَنۡ خَفَّتۡ مَوَٰزِينُهُۥ فَأُوْلَـٰٓئِكَ ٱلَّذِينَ خَسِرُوٓاْ أَنفُسَهُم بِمَا كَانُواْ بِـَٔايَٰتِنَا يَظۡلِمُونَ","TajweedText":"وَمَنْ خَفَّتْ مَو<tajweed class=madda_normal>َٲ</tajweed>زِينُهُ<tajweed class=madda_normal>ۥ</tajweed> فَأُ<tajweed class=slnt>وْ</tajweed>لَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ئِكَ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ خَسِر<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> أَ<tajweed class=ikhafa>نف</tajweed>ُسَه<tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِمَا كَانُو<tajweed class=slnt>اْ</tajweed> بِـَٔـايَ<tajweed class=madda_normal>ـٰ</tajweed>تِنَا يَظْلِم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٩</span>","End":"٩","PageNumber":151,"JuzNumber":8,"ManzilNumber":2,"RukuNumber":122,"MaqraNumber":61,"HizbNumber":16,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":7,"SurahIndex":"007","VerseNumber":10,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَقَدۡ مَكَّنَّـٰكُمۡ فِي ٱلۡأَرۡضِ وَجَعَلۡنَا لَكُمۡ فِيهَا مَعَٰيِشَۗ قَلِيلٗا مَّا تَشۡكُرُونَ","TajweedText":"وَلَقَ<tajweed class=qalaqah>دْ</tajweed> مَكَّ<tajweed class=ghunnah>نّ</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed>كُمْ فِى <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ وَجَعَلْنَا لَكُمْ فِيهَا مَعَ<tajweed class=madda_normal>ـٰ</tajweed>يِشَ‌ۗ قَلِيل<tajweed class=idgham_ghunnah>اً م</tajweed>َّا تَشْكُر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٠</span>","End":"١٠","PageNumber":151,"JuzNumber":8,"ManzilNumber":2,"RukuNumber":122,"MaqraNumber":61,"HizbNumber":16,"HizbDecimal":0.0,"HasSajda":false}]}