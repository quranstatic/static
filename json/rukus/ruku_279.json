er":17,"ManzilNumber":4,"RukuNumber":279,"MaqraNumber":129,"HizbNumber":33,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":22,"ShowSurahName":false,"ShowBismillah":false,"Text":"لَوۡ كَانَ فِيهِمَآ ءَالِهَةٌ إِلَّا ٱللَّهُ لَفَسَدَتَاۚ فَسُبۡحَٰنَ ٱللَّهِ رَبِّ ٱلۡعَرۡشِ عَمَّا يَصِفُونَ","TajweedText":"لَوْ كَانَ فِيهِم<tajweed class=madda_obligatory>َآ</tajweed> ءَالِهَةٌ إِلَّا <tajweed class=ham_wasl>ٱ</tajweed>للَّهُ لَفَسَدَتَا‌ۚ فَسُ<tajweed class=qalaqah>بْ</tajweed>حَ<tajweed class=madda_normal>ـٰ</tajweed>نَ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ رَبِّ <tajweed class=ham_wasl>ٱ</tajweed>لْعَرْشِ عَ<tajweed class=ghunnah>مّ</tajweed>َا يَصِف<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٢</span>","End":"٢٢","PageNumber":323,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":279,"MaqraNumber":129,"HizbNumber":33,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":23,"ShowSurahName":false,"ShowBismillah":false,"Text":"لَا يُسۡـَٔلُ عَمَّا يَفۡعَلُ وَهُمۡ يُسۡـَٔلُونَ","TajweedText":"لَا يُسْــَٔلُ عَ<tajweed class=ghunnah>مّ</tajweed>َا يَفْعَلُ وَهُمْ يُسْــَٔل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٣</span>","End":"٢٣","PageNumber":323,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":279,"MaqraNumber":129,"HizbNumber":33,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":24,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَمِ ٱتَّخَذُواْ مِن دُونِهِۦٓ ءَالِهَةٗۖ قُلۡ هَاتُواْ بُرۡهَٰنَكُمۡۖ هَٰذَا ذِكۡرُ مَن مَّعِيَ وَذِكۡرُ مَن قَبۡلِيۚ بَلۡ أَكۡثَرُهُمۡ لَا يَعۡلَمُونَ ٱلۡحَقَّۖ فَهُم مُّعۡرِضُونَ","TajweedText":"أَمِ <tajweed class=ham_wasl>ٱ</tajweed>تَّخَذُو<tajweed class=slnt>اْ</tajweed> مِ<tajweed class=ikhafa>ن د</tajweed>ُونِه<tajweed class=madda_obligatory>ِۦٓ</tajweed> ءَالِهَ<tajweed class=ikhafa>ةً‌ۖ ق</tajweed>ُلْ هَاتُو<tajweed class=slnt>اْ</tajweed> بُرْهَ<tajweed class=madda_normal>ـٰ</tajweed>نَكُمْ‌ۖ هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا ذِكْرُ م<tajweed class=idgham_ghunnah>َن م</tajweed>َّعِىَ وَذِكْرُ مَ<tajweed class=ikhafa>ن ق</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>لِى‌ۗ بَلْ أَكْثَرُهُمْ لَا يَعْلَمُونَ <tajweed class=ham_wasl>ٱ</tajweed>لْحَقَّ‌ۖ فَه<tajweed class=idgham_shafawi>ُم م</tajweed>ُّعْرِض<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٤</span>","End":"٢٤","PageNumber":323,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":279,"MaqraNumber":129,"HizbNumber":33,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":25,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَآ أَرۡسَلۡنَا مِن قَبۡلِكَ مِن رَّسُولٍ إِلَّا نُوحِيٓ إِلَيۡهِ أَنَّهُۥ لَآ إِلَٰهَ إِلَّآ أَنَا۠ فَٱعۡبُدُونِ","TajweedText":"وَم<tajweed class=madda_obligatory>َآ</tajweed> أَرْسَلْنَا مِ<tajweed class=ikhafa>ن ق</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>لِكَ م<tajweed class=idgham_wo_ghunnah>ِن ر</tajweed>َّسُولٍ إِلَّا نُوح<tajweed class=madda_obligatory>ِىٓ</tajweed> إِلَيْهِ أَ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> ل<tajweed class=madda_obligatory>َآ</tajweed> إِلَ<tajweed class=madda_normal>ـٰ</tajweed>هَ إِلّ<tajweed class=madda_obligatory>َآ</tajweed> أَنَا۟ فَ<tajweed class=ham_wasl>ٱ</tajweed>عْبُد<tajweed class=madda_permissible>ُو</tajweed>نِ <span class=end>٢٥</span>","End":"٢٥","PageNumber":324,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":279,"MaqraNumber":129,"HizbNumber":33,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":26,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَقَالُواْ ٱتَّخَذَ ٱلرَّحۡمَٰنُ وَلَدٗاۗ سُبۡحَٰنَهُۥۚ بَلۡ عِبَادٞ مُّكۡرَمُونَ","TajweedText":"وَقَالُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed>تَّخَذَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رَّحْمَ<tajweed class=madda_normal>ـٰ</tajweed>نُ وَلَ<tajweed class=ikhafa>دًا‌ۗ س</tajweed>ُ<tajweed class=qalaqah>بْ</tajweed>حَ<tajweed class=madda_normal>ـٰ</tajweed>نَهُ<tajweed class=madda_normal>ۥ</tajweed>‌ۚ بَلْ عِبَا<tajweed class=idgham_ghunnah>دٌ م</tajweed>ُّكْرَم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٦</span>","End":"٢٦","PageNumber":324,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":279,"MaqraNumber":129,"HizbNumber":33,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":27,"ShowSurahName":false,"ShowBismillah":false,"Text":"لَا يَسۡبِقُونَهُۥ بِٱلۡقَوۡلِ وَهُم بِأَمۡرِهِۦ يَعۡمَلُونَ","TajweedText":"لَا يَسْبِقُونَهُ<tajweed class=madda_normal>ۥ</tajweed> بِ<tajweed class=ham_wasl>ٱ</tajweed>لْقَوْلِ وَه<tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِأَمْرِه<tajweed class=madda_normal>ِۦ</tajweed> يَعْمَل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٧</span>","End":"٢٧","PageNumber":324,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":279,"MaqraNumber":129,"HizbNumber":33,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":28,"ShowSurahName":false,"ShowBismillah":false,"Text":"يَعۡلَمُ مَا بَيۡنَ أَيۡدِيهِمۡ وَمَا خَلۡفَهُمۡ وَلَا يَشۡفَعُونَ إِلَّا لِمَنِ ٱرۡتَضَىٰ وَهُم مِّنۡ خَشۡيَتِهِۦ مُشۡفِقُونَ","TajweedText":"يَعْلَمُ مَا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْ وَلَا يَشْفَعُونَ إِلَّا لِمَنِ <tajweed class=ham_wasl>ٱ</tajweed>رْتَضَىٰ وَه<tajweed class=idgham_shafawi>ُم م</tajweed>ِّنْ خَشْيَتِه<tajweed class=madda_normal>ِۦ</tajweed> مُشْفِق<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٨</span>","End":"٢٨","PageNumber":324,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":279,"MaqraNumber":129,"HizbNumber":33,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":29,"ShowSurahName":false,"ShowBismillah":false,"Text":"۞وَمَن يَقُلۡ مِنۡهُمۡ إِنِّيٓ إِلَٰهٞ مِّن دُونِهِۦ فَذَٰلِكَ نَجۡزِيهِ جَهَنَّمَۚ كَذَٰلِكَ نَجۡزِي ٱلظَّـٰلِمِينَ","TajweedText":"۞ وَم<tajweed class=idgham_ghunnah>َن ي</tajweed>َقُلْ مِنْهُمْ إِ<tajweed class=ghunnah>نّ</tajweed><tajweed class=madda_obligatory>ِىٓ</tajweed> إِلَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>هٌ م</tajweed>ِّ<tajweed class=ikhafa>ن د</tajweed>ُونِه<tajweed class=madda_normal>ِۦ</tajweed> فَذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ نَ<tajweed class=qalaqah>جْ</tajweed>زِيهِ جَهَ<tajweed class=ghunnah>نّ</tajweed>َمَ‌ۚ كَذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ نَ<tajweed class=qalaqah>جْ</tajweed>زِى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>ظَّ<tajweed class=madda_normal>ـٰ</tajweed>لِم<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٢٩</span>","End":"٢٩","PageNumber":324,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":279,"MaqraNumber":130,"HizbNumber":33,"HizbDecimal":0.25,"HasSajda":false}]}