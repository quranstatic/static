{"RukuNumber":316,"Verses":[{"SurahNumber":26,"SurahIndex":"026","VerseNumber":1,"ShowSurahName":true,"ShowBismillah":true,"Text":"طسٓمٓ","TajweedText":"ط<tajweed class=madda_necessary>سٓ</tajweed><tajweed class=madda_necessary>مٓ</tajweed> <span class=end>١</span>","End":"١","PageNumber":367,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":316,"MaqraNumber":147,"HizbNumber":37,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":26,"SurahIndex":"026","VerseNumber":2,"ShowSurahName":false,"ShowBismillah":false,"Text":"تِلۡكَ ءَايَٰتُ ٱلۡكِتَٰبِ ٱلۡمُبِينِ","TajweedText":"تِلْكَ ءَايَ<tajweed class=madda_normal>ـٰ</tajweed>تُ <tajweed class=ham_wasl>ٱ</tajweed>لْكِتَ<tajweed class=madda_normal>ـٰ</tajweed>بِ <tajweed class=ham_wasl>ٱ</tajweed>لْمُب<tajweed class=madda_permissible>ِي</tajweed>نِ <span class=end>٢</span>","End":"٢","PageNumber":367,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":316,"MaqraNumber":147,"HizbNumber":37,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":26,"SurahIndex":"026","VerseNumber":3,"ShowSurahName":false,"ShowBismillah":false,"Text":"لَعَلَّكَ بَٰخِعٞ نَّفۡسَكَ أَلَّا يَكُونُواْ مُؤۡمِنِينَ","TajweedText":"لَعَلَّكَ بَ<tajweed class=madda_normal>ـٰ</tajweed>خِ<tajweed class=idgham_ghunnah>عٌ ن</tajweed>َّفْسَكَ أَلَّا يَكُونُو<tajweed class=slnt>اْ</tajweed> مُؤْمِن<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٣</span>","End":"٣","PageNumber":367,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":316,"MaqraNumber":147,"HizbNumber":37,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":26,"SurahIndex":"026","VerseNumber":4,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِن نَّشَأۡ نُنَزِّلۡ عَلَيۡهِم مِّنَ ٱلسَّمَآءِ ءَايَةٗ فَظَلَّتۡ أَعۡنَٰقُهُمۡ لَهَا خَٰضِعِينَ","TajweedText":"إ<tajweed class=idgham_ghunnah>ِن ن</tajweed>َّشَأْ نُنَزِّلْ عَلَيْه<tajweed class=idgham_shafawi>ِم م</tajweed>ِّنَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّم<tajweed class=madda_obligatory>َا</tajweed>ٓءِ ءَايَ<tajweed class=ikhafa>ةً ف</tajweed>َظَلَّتْ أَعْنَ<tajweed class=madda_normal>ـٰ</tajweed>قُهُمْ لَهَا خَ<tajweed class=madda_normal>ـٰ</tajweed>ضِع<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٤</span>","End":"٤","PageNumber":367,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":316,"MaqraNumber":147,"HizbNumber":37,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":26,"SurahIndex":"026","VerseNumber":5,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَا يَأۡتِيهِم مِّن ذِكۡرٖ مِّنَ ٱلرَّحۡمَٰنِ مُحۡدَثٍ إِلَّا كَانُواْ عَنۡهُ مُعۡرِضِينَ","TajweedText":"وَمَا يَأْتِيه<tajweed class=idgham_shafawi>ِم م</tajweed>ِّ<tajweed class=ikhafa>ن ذ</tajweed>ِكْ<tajweed class=idgham_ghunnah>رٍ م</tajweed>ِّنَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رَّحْمَ<tajweed class=madda_normal>ـٰ</tajweed>نِ مُحْدَثٍ إِلَّا كَانُو<tajweed class=slnt>اْ</tajweed> عَنْهُ مُعْرِض<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٥</span>","End":"٥","PageNumber":367,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":316,"MaqraNumber":147,"HizbNumber":37,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":26,"SurahIndex":"026","VerseNumber":6,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَقَدۡ كَذَّبُواْ فَسَيَأۡتِيهِمۡ أَنۢبَـٰٓؤُاْ مَا كَانُواْ بِهِۦ يَسۡتَهۡزِءُونَ","TajweedText":"فَقَ<tajweed class=qalaqah>دْ</tajweed> كَذَّبُو<tajweed class=slnt>اْ</tajweed> فَسَيَأْتِيهِمْ أَ<tajweed class=iqlab>نۢب</tajweed>َ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ؤُ<tajweed class=slnt>اْ</tajweed> مَا كَانُو<tajweed class=slnt>اْ</tajweed> بِه<tajweed class=madda_normal>ِۦ</tajweed> يَسْتَهْزِء<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦</span>","End":"٦","PageNumber":367,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":316,"MaqraNumber":147,"HizbNumber":37,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":26,"SurahIndex":"026","VerseNumber":7,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَوَلَمۡ يَرَوۡاْ إِلَى ٱلۡأَرۡضِ كَمۡ أَنۢبَتۡنَا فِيهَا مِن كُلِّ زَوۡجٖ كَرِيمٍ","TajweedText":"أَوَلَمْ يَرَوْ<tajweed class=slnt>اْ</tajweed> إِلَى <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ كَمْ أَ<tajweed class=iqlab>نۢب</tajweed>َتْنَا فِيهَا مِ<tajweed class=ikhafa>ن ك</tajweed>ُلِّ زَوْ<tajweed class=ikhafa>جٍ ك</tajweed>َر<tajweed class=madda_permissible>ِي</tajweed>مٍ <span class=end>٧</span>","End":"٧","PageNumber":367,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":316,"MaqraNumber":147,"HizbNumber":37,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":26,"SurahIndex":"026","VerseNumber":8,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّ فِي ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكۡثَرُهُم مُّؤۡمِنِينَ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َ فِى ذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ لَأَيَ<tajweed class=idgham_ghunnah>ةً‌ۖ و</tajweed>َمَا كَانَ أَكْثَرُه<tajweed class=idgham_shafawi>ُم م</tajweed>ُّؤْمِن<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٨</span>","End":"٨","PageNumber":367,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":316,"MaqraNumber":147,"HizbNumber":37,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":26,"SurahIndex":"026","VerseNumber":9,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِنَّ رَبَّكَ لَهُوَ ٱلۡعَزِيزُ ٱلرَّحِيمُ","TajweedText":"وَإِ<tajweed class=ghunnah>نّ</tajweed>َ رَبَّكَ لَهُوَ <tajweed class=ham_wasl>ٱ</tajweed>لْعَزِيزُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رَّح<tajweed class=madda_permissible>ِي</tajweed>مُ <span class=end>٩</span>","End":"٩","PageNumber":367,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":316,"MaqraNumber":147,"HizbNumber":37,"HizbDecimal":0.5,"HasSajda":false}]}