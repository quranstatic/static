{"Id":446,"LanguageCode":"ukr","Name":"ukr-mykhayloyakubov-la","Author":"Mykhaylo Yakubovych","Language":"Ukrainian","Description":"Ukrainian - Latinised","Direction":"ltr","Source":"","Translations":[{"SurahNumber":107,"VerseNumber":1,"Text":"Chy bachyv ty toho, khto zaperechuye Sud"},{"SurahNumber":107,"VerseNumber":2,"Text":"Ta tse zh toy, khto prohanyaye syrotu"},{"SurahNumber":107,"VerseNumber":3,"Text":"i ne zaklykaye nahoduvaty bidnoho"},{"SurahNumber":107,"VerseNumber":4,"Text":"Lykho zh tym, yaki molyatʹsya"},{"SurahNumber":107,"VerseNumber":5,"Text":"ale stavlyatʹsya do molytov svoyikh nedbalo"},{"SurahNumber":107,"VerseNumber":6,"Text":"yaki roblyatʹ vse lyshe napokaz"},{"SurahNumber":107,"VerseNumber":7,"Text":"i vidmovlyayutʹsya davaty mylostynyu"}]}