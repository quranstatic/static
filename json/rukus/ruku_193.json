{"RukuNumber":193,"Verses":[{"SurahNumber":12,"SurahIndex":"012","VerseNumber":1,"ShowSurahName":true,"ShowBismillah":true,"Text":"الٓرۚ تِلۡكَ ءَايَٰتُ ٱلۡكِتَٰبِ ٱلۡمُبِينِ","TajweedText":"ا<tajweed class=madda_necessary>لٓ</tajweed>ر‌ۚ تِلْكَ ءَايَ<tajweed class=madda_normal>ـٰ</tajweed>تُ <tajweed class=ham_wasl>ٱ</tajweed>لْكِتَ<tajweed class=madda_normal>ـٰ</tajweed>بِ <tajweed class=ham_wasl>ٱ</tajweed>لْمُب<tajweed class=madda_permissible>ِي</tajweed>نِ <span class=end>١</span>","End":"١","PageNumber":235,"JuzNumber":12,"ManzilNumber":3,"RukuNumber":193,"MaqraNumber":94,"HizbNumber":24,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":12,"SurahIndex":"012","VerseNumber":2,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّآ أَنزَلۡنَٰهُ قُرۡءَٰنًا عَرَبِيّٗا لَّعَلَّكُمۡ تَعۡقِلُونَ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed><tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=ikhafa>نز</tajweed>َلْنَ<tajweed class=madda_normal>ـٰ</tajweed>هُ قُرْء<tajweed class=madda_normal>َٲ</tajweed>نًا عَرَبِي<tajweed class=idgham_wo_ghunnah>ًّا ل</tajweed>َّعَلَّكُمْ تَعْقِل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢</span>","End":"٢","PageNumber":235,"JuzNumber":12,"ManzilNumber":3,"RukuNumber":193,"MaqraNumber":94,"HizbNumber":24,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":12,"SurahIndex":"012","VerseNumber":3,"ShowSurahName":false,"ShowBismillah":false,"Text":"نَحۡنُ نَقُصُّ عَلَيۡكَ أَحۡسَنَ ٱلۡقَصَصِ بِمَآ أَوۡحَيۡنَآ إِلَيۡكَ هَٰذَا ٱلۡقُرۡءَانَ وَإِن كُنتَ مِن قَبۡلِهِۦ لَمِنَ ٱلۡغَٰفِلِينَ","TajweedText":"نَحْنُ نَقُصُّ عَلَيْكَ أَحْسَنَ <tajweed class=ham_wasl>ٱ</tajweed>لْقَصَصِ بِم<tajweed class=madda_obligatory>َآ</tajweed> أَوْحَيْن<tajweed class=madda_obligatory>َآ</tajweed> إِلَيْكَ هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا <tajweed class=ham_wasl>ٱ</tajweed>لْقُرْءَانَ وَإِ<tajweed class=ikhafa>ن ك</tajweed>ُ<tajweed class=ikhafa>نت</tajweed>َ مِ<tajweed class=ikhafa>ن ق</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>لِه<tajweed class=madda_normal>ِۦ</tajweed> لَمِنَ <tajweed class=ham_wasl>ٱ</tajweed>لْغَ<tajweed class=madda_normal>ـٰ</tajweed>فِل<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٣</span>","End":"٣","PageNumber":235,"JuzNumber":12,"ManzilNumber":3,"RukuNumber":193,"MaqraNumber":94,"HizbNumber":24,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":12,"SurahIndex":"012","VerseNumber":4,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِذۡ قَالَ يُوسُفُ لِأَبِيهِ يَـٰٓأَبَتِ إِنِّي رَأَيۡتُ أَحَدَ عَشَرَ كَوۡكَبٗا وَٱلشَّمۡسَ وَٱلۡقَمَرَ رَأَيۡتُهُمۡ لِي سَٰجِدِينَ","TajweedText":"إِذْ قَالَ يُوسُفُ لِأَبِيهِ يَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>أَبَتِ إِ<tajweed class=ghunnah>نّ</tajweed>ِى رَأَيْتُ أَحَدَ عَشَرَ كَوْكَ<tajweed class=idgham_ghunnah>بًا و</tajweed>َ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>شَّمْسَ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْقَمَرَ رَأَيْتُهُمْ لِى سَ<tajweed class=madda_normal>ـٰ</tajweed>جِد<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٤</span>","End":"٤","PageNumber":235,"JuzNumber":12,"ManzilNumber":3,"RukuNumber":193,"MaqraNumber":94,"HizbNumber":24,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":12,"SurahIndex":"012","VerseNumber":5,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَ يَٰبُنَيَّ لَا تَقۡصُصۡ رُءۡيَاكَ عَلَىٰٓ إِخۡوَتِكَ فَيَكِيدُواْ لَكَ كَيۡدًاۖ إِنَّ ٱلشَّيۡطَٰنَ لِلۡإِنسَٰنِ عَدُوّٞ مُّبِينٞ","TajweedText":"قَالَ يَ<tajweed class=madda_normal>ـٰ</tajweed>بُنَىَّ لَا تَ<tajweed class=qalaqah>قْ</tajweed>صُصْ رُءْيَاكَ عَلَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> إِخْوَتِكَ فَيَكِيدُو<tajweed class=slnt>اْ</tajweed> لَكَ كَيْدًا‌ۖ إِ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>شَّيْطَ<tajweed class=madda_normal>ـٰ</tajweed>نَ لِلْإِ<tajweed class=ikhafa>نس</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed>نِ عَدُ<tajweed class=idgham_ghunnah>وٌّ م</tajweed>ُّب<tajweed class=madda_permissible>ِي</tajweed>نٌ <span class=end>٥</span>","End":"٥","PageNumber":236,"JuzNumber":12,"ManzilNumber":3,"RukuNumber":193,"MaqraNumber":94,"HizbNumber":24,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":12,"SurahIndex":"012","VerseNumber":6,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَكَذَٰلِكَ يَجۡتَبِيكَ رَبُّكَ وَيُعَلِّمُكَ مِن تَأۡوِيلِ ٱلۡأَحَادِيثِ وَيُتِمُّ نِعۡمَتَهُۥ عَلَيۡكَ وَعَلَىٰٓ ءَالِ يَعۡقُوبَ كَمَآ أَتَمَّهَا عَلَىٰٓ أَبَوَيۡكَ مِن قَبۡلُ إِبۡرَٰهِيمَ وَإِسۡحَٰقَۚ إِنَّ رَبَّكَ عَلِيمٌ حَكِيمٞ","TajweedText":"وَكَذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ يَ<tajweed class=qalaqah>جْ</tajweed>تَبِيكَ رَبُّكَ وَيُعَلِّمُكَ مِ<tajweed class=ikhafa>ن ت</tajweed>َأْوِيلِ <tajweed class=ham_wasl>ٱ</tajweed>لْأَحَادِيثِ وَيُتِ<tajweed class=ghunnah>مّ</tajweed>ُ نِعْمَتَهُ<tajweed class=madda_normal>ۥ</tajweed> عَلَيْكَ وَعَلَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> ءَالِ يَعْقُوبَ كَم<tajweed class=madda_obligatory>َآ</tajweed> أَتَ<tajweed class=ghunnah>مّ</tajweed>َهَا عَلَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> أَبَوَيْكَ مِ<tajweed class=ikhafa>ن ق</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>لُ إِ<tajweed class=qalaqah>بْ</tajweed>ر<tajweed class=madda_normal>َٲ</tajweed>هِيمَ وَإِسْحَ<tajweed class=madda_normal>ـٰ</tajweed>قَ‌ۚ إِ<tajweed class=ghunnah>نّ</tajweed>َ رَبَّكَ عَلِيمٌ حَك<tajweed class=madda_permissible>ِي</tajweed>مٌ <span class=end>٦</span>","End":"٦","PageNumber":236,"JuzNumber":12,"ManzilNumber":3,"RukuNumber":193,"MaqraNumber":94,"HizbNumber":24,"HizbDecimal":0.25,"HasSajda":false}]}