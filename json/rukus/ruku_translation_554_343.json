{"Id":343,"LanguageCode":"sqi","Name":"sqi-sherifahmeti-la","Author":"Sherif Ahmeti","Language":"Albanian","Description":"Albanian - Latinised","Direction":"ltr","Source":"http://tanzil.net","Translations":[{"SurahNumber":112,"VerseNumber":1,"Text":"Thuaj: Ai, All-llahu eshte Nje"},{"SurahNumber":112,"VerseNumber":2,"Text":"All-llahu eshte mbeshtetja (Atij i mbeshtetet cdo krijese)"},{"SurahNumber":112,"VerseNumber":3,"Text":"As s’ka lindur ke, as nuk eshte i lindur"},{"SurahNumber":112,"VerseNumber":4,"Text":"Dhe Atij askush nuk i eshte i barabarte"}]}