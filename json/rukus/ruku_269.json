=laam_shamsiyah>ل</tajweed>سَّمَ<tajweed class=madda_normal>ـٰ</tajweed>و<tajweed class=madda_normal>َٲ</tajweed>تِ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ إِلّ<tajweed class=madda_obligatory>َآ</tajweed> ءَاتِى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رَّحْمَ<tajweed class=madda_normal>ـٰ</tajweed>نِ عَ<tajweed class=qalaqah>بْ</tajweed>دًا <span class=end>٩٣</span>","End":"٩٣","PageNumber":311,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":269,"MaqraNumber":124,"HizbNumber":31,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":19,"SurahIndex":"019","VerseNumber":94,"ShowSurahName":false,"ShowBismillah":false,"Text":"لَّقَدۡ أَحۡصَىٰهُمۡ وَعَدَّهُمۡ عَدّٗا","TajweedText":"لَّقَ<tajweed class=qalaqah>دْ</tajweed> أَحْصَ<tajweed class=madda_normal>ـٰ</tajweed>هُمْ وَعَدَّهُمْ عَدًّا <span class=end>٩٤</span>","End":"٩٤","PageNumber":311,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":269,"MaqraNumber":124,"HizbNumber":31,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":19,"SurahIndex":"019","VerseNumber":95,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَكُلُّهُمۡ ءَاتِيهِ يَوۡمَ ٱلۡقِيَٰمَةِ فَرۡدًا","TajweedText":"وَكُلُّهُمْ ءَاتِيهِ يَوْمَ <tajweed class=ham_wasl>ٱ</tajweed>لْقِيَ<tajweed class=madda_normal>ـٰ</tajweed>مَةِ فَرْدًا <span class=end>٩٥</span>","End":"٩٥","PageNumber":311,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":269,"MaqraNumber":124,"HizbNumber":31,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":19,"SurahIndex":"019","VerseNumber":96,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّـٰلِحَٰتِ سَيَجۡعَلُ لَهُمُ ٱلرَّحۡمَٰنُ وُدّٗا","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ ءَامَنُو<tajweed class=slnt>اْ</tajweed> وَعَمِلُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>صَّ<tajweed class=madda_normal>ـٰ</tajweed>لِحَ<tajweed class=madda_normal>ـٰ</tajweed>تِ سَيَ<tajweed class=qalaqah>جْ</tajweed>عَلُ لَهُمُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رَّحْمَ<tajweed class=madda_normal>ـٰ</tajweed>نُ وُدًّا <span class=end>٩٦</span>","End":"٩٦","PageNumber":312,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":269,"MaqraNumber":124,"HizbNumber":31,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":19,"SurahIndex":"019","VerseNumber":97,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَإِنَّمَا يَسَّرۡنَٰهُ بِلِسَانِكَ لِتُبَشِّرَ بِهِ ٱلۡمُتَّقِينَ وَتُنذِرَ بِهِۦ قَوۡمٗا لُّدّٗا","TajweedText":"فَإِ<tajweed class=ghunnah>نّ</tajweed>َمَا يَسَّرْنَ<tajweed class=madda_normal>ـٰ</tajweed>هُ بِلِسَانِكَ لِتُبَشِّرَ بِهِ <tajweed class=ham_wasl>ٱ</tajweed>لْمُتَّقِينَ وَتُ<tajweed class=ikhafa>نذ</tajweed>ِرَ بِه<tajweed class=madda_normal>ِۦ</tajweed> قَوْ<tajweed class=idgham_wo_ghunnah>مًا ل</tajweed>ُّدًّا <span class=end>٩٧</span>","End":"٩٧","PageNumber":312,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":269,"MaqraNumber":124,"HizbNumber":31,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":19,"SurahIndex":"019","VerseNumber":98,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَكَمۡ أَهۡلَكۡنَا قَبۡلَهُم مِّن قَرۡنٍ هَلۡ تُحِسُّ مِنۡهُم مِّنۡ أَحَدٍ أَوۡ تَسۡمَعُ لَهُمۡ رِكۡزَۢا","TajweedText":"وَكَمْ أَهْلَكْنَا قَ<tajweed class=qalaqah>بْ</tajweed>لَه<tajweed class=idgham_shafawi>ُم م</tajweed>ِّ<tajweed class=ikhafa>ن ق</tajweed>َرْنٍ هَلْ تُحِسُّ مِنْه<tajweed class=idgham_shafawi>ُم م</tajweed>ِّنْ أَحَدٍ أَوْ تَسْمَعُ لَهُمْ رِكْزَۢا <span class=end>٩٨</span>","End":"٩٨","PageNumber":312,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":269,"MaqraNumber":124,"HizbNumber":31,"HizbDecimal":0.75,"HasSajda":false}]}