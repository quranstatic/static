{"RukuNumber":457,"Verses":[{"SurahNumber":51,"SurahIndex":"051","VerseNumber":47,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَٱلسَّمَآءَ بَنَيۡنَٰهَا بِأَيۡيْدٖ وَإِنَّا لَمُوسِعُونَ","TajweedText":"وَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّم<tajweed class=madda_obligatory>َا</tajweed>ٓءَ بَنَيْنَ<tajweed class=madda_normal>ـٰ</tajweed>هَا بِأَيْ<tajweed class=slnt>يْ</tajweed><tajweed class=idgham_ghunnah>دٍ و</tajweed>َإِ<tajweed class=ghunnah>نّ</tajweed>َا لَمُوسِع<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٤٧</span>","End":"٤٧","PageNumber":522,"JuzNumber":27,"ManzilNumber":7,"RukuNumber":457,"MaqraNumber":209,"HizbNumber":53,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":51,"SurahIndex":"051","VerseNumber":48,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَٱلۡأَرۡضَ فَرَشۡنَٰهَا فَنِعۡمَ ٱلۡمَٰهِدُونَ","TajweedText":"وَ<tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضَ فَرَشْنَ<tajweed class=madda_normal>ـٰ</tajweed>هَا فَنِعْمَ <tajweed class=ham_wasl>ٱ</tajweed>لْمَ<tajweed class=madda_normal>ـٰ</tajweed>هِد<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٤٨</span>","End":"٤٨","PageNumber":522,"JuzNumber":27,"ManzilNumber":7,"RukuNumber":457,"MaqraNumber":209,"HizbNumber":53,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":51,"SurahIndex":"051","VerseNumber":49,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمِن كُلِّ شَيۡءٍ خَلَقۡنَا زَوۡجَيۡنِ لَعَلَّكُمۡ تَذَكَّرُونَ","TajweedText":"وَمِ<tajweed class=ikhafa>ن ك</tajweed>ُلِّ شَىْءٍ خَلَ<tajweed class=qalaqah>قْ</tajweed>نَا زَوْجَيْنِ لَعَلَّكُمْ تَذَكَّر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٤٩</span>","End":"٤٩","PageNumber":522,"JuzNumber":27,"ManzilNumber":7,"RukuNumber":457,"MaqraNumber":209,"HizbNumber":53,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":51,"SurahIndex":"051","VerseNumber":50,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَفِرُّوٓاْ إِلَى ٱللَّهِۖ إِنِّي لَكُم مِّنۡهُ نَذِيرٞ مُّبِينٞ","TajweedText":"فَفِرّ<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> إِلَى <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ‌ۖ إِ<tajweed class=ghunnah>نّ</tajweed>ِى لَك<tajweed class=idgham_shafawi>ُم م</tajweed>ِّنْهُ نَذِي<tajweed class=idgham_ghunnah>رٌ م</tajweed>ُّب<tajweed class=madda_permissible>ِي</tajweed>نٌ <span class=end>٥٠</span>","End":"٥٠","PageNumber":522,"JuzNumber":27,"ManzilNumber":7,"RukuNumber":457,"MaqraNumber":209,"HizbNumber":53,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":51,"SurahIndex":"051","VerseNumber":51,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَا تَجۡعَلُواْ مَعَ ٱللَّهِ إِلَٰهًا ءَاخَرَۖ إِنِّي لَكُم مِّنۡهُ نَذِيرٞ مُّبِينٞ","TajweedText":"وَلَا تَ<tajweed class=qalaqah>جْ</tajweed>عَلُو<tajweed class=slnt>اْ</tajweed> مَعَ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ إِلَ<tajweed class=madda_normal>ـٰ</tajweed>هًا ءَاخَرَ‌ۖ إِ<tajweed class=ghunnah>نّ</tajweed>ِى لَك<tajweed class=idgham_shafawi>ُم م</tajweed>ِّنْهُ نَذِي<tajweed class=idgham_ghunnah>رٌ م</tajweed>ُّب<tajweed class=madda_permissible>ِي</tajweed>نٌ <span class=end>٥١</span>","End":"٥١","PageNumber":522,"JuzNumber":27,"ManzilNumber":7,"RukuNumber":457,"MaqraNumber":209,"HizbNumber":53,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":51,"SurahIndex":"051","VerseNumber":52,"ShowSurahName":false,"ShowBismillah":false,"Text":"كَذَٰلِكَ مَآ أَتَى ٱلَّذِينَ مِن قَبۡلِهِم مِّن رَّسُولٍ إِلَّا قَالُواْ سَاحِرٌ أَوۡ مَجۡنُونٌ","TajweedText":"كَذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ م<tajweed class=madda_obligatory>َآ</tajweed> أَتَى <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ مِ<tajweed class=ikhafa>ن ق</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>لِه<tajweed class=idgham_shafawi>ِم م</tajweed>ّ<tajweed class=idgham_wo_ghunnah>ِن ر</tajweed>َّسُولٍ إِلَّا قَالُو<tajweed class=slnt>اْ</tajweed> سَاحِرٌ أَوْ مَ<tajweed class=qalaqah>جْ</tajweed>ن<tajweed class=madda_permissible>ُو</tajweed>نٌ <span class=end>٥٢</span>","End":"٥٢","PageNumber":523,"JuzNumber":27,"ManzilNumber":7,"RukuNumber":457,"MaqraNumber":209,"HizbNumber":53,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":51,"SurahIndex":"051","VerseNumber":53,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَتَوَاصَوۡاْ بِهِۦۚ بَلۡ هُمۡ قَوۡمٞ طَاغُونَ","TajweedText":"أَتَوَاصَوْ<tajweed class=slnt>اْ</tajweed> بِه<tajweed class=madda_normal>ِۦ</tajweed>‌ۚ بَلْ هُمْ قَوْ<tajweed class=ikhafa>مٌ ط</tajweed>َاغ<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٥٣</span>","End":"٥٣","PageNumber":523,"JuzNumber":27,"ManzilNumber":7,"RukuNumber":457,"MaqraNumber":209,"HizbNumber":53,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":51,"SurahIndex":"051","VerseNumber":54,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَتَوَلَّ عَنۡهُمۡ فَمَآ أَنتَ بِمَلُومٖ","TajweedText":"فَتَوَلَّ عَنْهُمْ فَم<tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=ikhafa>نت</tajweed>َ بِمَل<tajweed class=madda_permissible>ُو</tajweed>مٍ <span class=end>٥٤</span>","End":"٥٤","PageNumber":523,"JuzNumber":27,"ManzilNumber":7,"RukuNumber":457,"MaqraNumber":209,"HizbNumber":53,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":51,"SurahIndex":"051","VerseNumber":55,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَذَكِّرۡ فَإِنَّ ٱلذِّكۡرَىٰ تَنفَعُ ٱلۡمُؤۡمِنِينَ","TajweedText":"وَذَكِّرْ فَإِ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>ذِّكْرَىٰ تَ<tajweed class=ikhafa>نف</tajweed>َعُ <tajweed class=ham_wasl>ٱ</tajweed>لْمُؤْمِن<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٥٥</span>","End":"٥٥","PageNumber":523,"JuzNumber":27,"ManzilNumber":7,"RukuNumber":457,"MaqraNumber":209,"HizbNumber":53,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":51,"SurahIndex":"051","VerseNumber":56,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَا خَلَقۡتُ ٱلۡجِنَّ وَٱلۡإِنسَ إِلَّا لِيَعۡبُدُونِ","TajweedText":"وَمَا خَلَ<tajweed class=qalaqah>قْ</tajweed>تُ <tajweed class=ham_wasl>ٱ</tajweed>لْجِ<tajweed class=ghunnah>نّ</tajweed>َ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْإِ<tajweed class=ikhafa>نس</tajweed>َ إِلَّا لِيَعْبُد<tajweed class=madda_permissible>ُو</tajweed>نِ <span class=end>٥٦</span>","End":"٥٦","PageNumber":523,"JuzNumber":27,"ManzilNumber":7,"RukuNumber":457,"MaqraNumber":209,"HizbNumber":53,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":51,"SurahIndex":"051","VerseNumber":57,"ShowSurahName":false,"ShowBismillah":false,"Text":"مَآ أُرِيدُ مِنۡهُم مِّن رِّزۡقٖ وَمَآ أُرِيدُ أَن يُطۡعِمُونِ","TajweedText":"م<tajweed class=madda_obligatory>َآ</tajweed> أُرِيدُ مِنْه<tajweed class=idgham_shafawi>ُم م</tajweed>ّ<tajweed class=idgham_wo_ghunnah>ِن ر</tajweed>ِّزْ<tajweed class=idgham_ghunnah>قٍ و</tajweed>َم<tajweed class=madda_obligatory>َآ</tajweed> أُرِيدُ أ<tajweed class=idgham_ghunnah>َن ي</tajweed>ُ<tajweed class=qalaqah>طْ</tajweed>عِم<tajweed class=madda_permissible>ُو</tajweed>نِ <span class=end>٥٧</span>","End":"٥٧","PageNumber":523,"JuzNumber":27,"ManzilNumber":7,"RukuNumber":457,"MaqraNumber":209,"HizbNumber":53,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":51,"SurahIndex":"051","VerseNumber":58,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّ ٱللَّهَ هُوَ ٱلرَّزَّاقُ ذُو ٱلۡقُوَّةِ ٱلۡمَتِينُ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>للَّهَ هُوَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رَّزَّاقُ ذُو <tajweed class=ham_wasl>ٱ</tajweed>لْقُوَّةِ <tajweed class=ham_wasl>ٱ</tajweed>لْمَت<tajweed class=madda_permissible>ِي</tajweed>نُ <span class=end>٥٨</span>","End":"٥٨","PageNumber":523,"JuzNumber":27,"ManzilNumber":7,"RukuNumber":457,"MaqraNumber":209,"HizbNumber":53,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":51,"SurahIndex":"051","VerseNumber":59,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَإِنَّ لِلَّذِينَ ظَلَمُواْ ذَنُوبٗا مِّثۡلَ ذَنُوبِ أَصۡحَٰبِهِمۡ فَلَا يَسۡتَعۡجِلُونِ","TajweedText":"فَإِ<tajweed class=ghunnah>نّ</tajweed>َ لِلَّذِينَ ظَلَمُو<tajweed class=slnt>اْ</tajweed> ذَنُو<tajweed class=idgham_ghunnah>بًا م</tajweed>ِّثْلَ ذَنُوبِ أَصْحَ<tajweed class=madda_normal>ـٰ</tajweed>بِهِمْ فَلَا يَسْتَعْجِل<tajweed class=madda_permissible>ُو</tajweed>نِ <span class=end>٥٩</span>","End":"٥٩","PageNumber":523,"JuzNumber":27,"ManzilNumber":7,"RukuNumber":457,"MaqraNumber":209,"HizbNumber":53,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":51,"SurahIndex":"051","VerseNumber":60,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَوَيۡلٞ لِّلَّذِينَ كَفَرُواْ مِن يَوۡمِهِمُ ٱلَّذِي يُوعَدُونَ","TajweedText":"فَوَيْ<tajweed class=idgham_wo_ghunnah>لٌ ل</tajweed>ِّلَّذِينَ كَفَرُو<tajweed class=slnt>اْ</tajweed> م<tajweed class=idgham_ghunnah>ِن ي</tajweed>َوْمِهِمُ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى يُوعَد<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٠</span>","End":"٦٠","PageNumber":523,"JuzNumber":27,"ManzilNumber":7,"RukuNumber":457,"MaqraNumber":209,"HizbNumber":53,"HizbDecimal":0.0,"HasSajda":false}]}