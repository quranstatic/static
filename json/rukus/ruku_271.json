 فَم<tajweed class=idgham_wo_ghunnah>َن ر</tajweed>َّبُّكُمَا يَ<tajweed class=madda_normal>ـٰ</tajweed>مُوسَىٰ <span class=end>٤٩</span>","End":"٤٩","PageNumber":314,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":271,"MaqraNumber":125,"HizbNumber":32,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":50,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَ رَبُّنَا ٱلَّذِيٓ أَعۡطَىٰ كُلَّ شَيۡءٍ خَلۡقَهُۥ ثُمَّ هَدَىٰ","TajweedText":"قَالَ رَبُّنَا <tajweed class=ham_wasl>ٱ</tajweed>لَّذ<tajweed class=madda_obligatory>ِىٓ</tajweed> أَعْطَىٰ كُلَّ شَىْءٍ خَلْقَهُ<tajweed class=madda_normal>ۥ</tajweed> ثُ<tajweed class=ghunnah>مّ</tajweed>َ هَدَىٰ <span class=end>٥٠</span>","End":"٥٠","PageNumber":314,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":271,"MaqraNumber":125,"HizbNumber":32,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":51,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَ فَمَا بَالُ ٱلۡقُرُونِ ٱلۡأُولَىٰ","TajweedText":"قَالَ فَمَا بَالُ <tajweed class=ham_wasl>ٱ</tajweed>لْقُرُونِ <tajweed class=ham_wasl>ٱ</tajweed>لْأُولَىٰ <span class=end>٥١</span>","End":"٥١","PageNumber":314,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":271,"MaqraNumber":125,"HizbNumber":32,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":52,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَ عِلۡمُهَا عِندَ رَبِّي فِي كِتَٰبٖۖ لَّا يَضِلُّ رَبِّي وَلَا يَنسَى","TajweedText":"قَالَ عِلْمُهَا عِ<tajweed class=ikhafa>ند</tajweed>َ رَبِّى فِى كِتَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_wo_ghunnah>بٍ‌ۖ ل</tajweed>َّا يَضِلُّ رَبِّى وَلَا يَ<tajweed class=ikhafa>نس</tajweed>َى <span class=end>٥٢</span>","End":"٥٢","PageNumber":315,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":271,"MaqraNumber":125,"HizbNumber":32,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":53,"ShowSurahName":false,"ShowBismillah":false,"Text":"ٱلَّذِي جَعَلَ لَكُمُ ٱلۡأَرۡضَ مَهۡدٗا وَسَلَكَ لَكُمۡ فِيهَا سُبُلٗا وَأَنزَلَ مِنَ ٱلسَّمَآءِ مَآءٗ فَأَخۡرَجۡنَا بِهِۦٓ أَزۡوَٰجٗا مِّن نَّبَاتٖ شَتَّىٰ","TajweedText":"ٱلَّذِى جَعَلَ لَكُمُ <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضَ مَهْ<tajweed class=idgham_ghunnah>دًا و</tajweed>َسَلَكَ لَكُمْ فِيهَا سُبُل<tajweed class=idgham_ghunnah>اً و</tajweed>َأَ<tajweed class=ikhafa>نز</tajweed>َلَ مِنَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّم<tajweed class=madda_obligatory>َا</tajweed>ٓءِ م<tajweed class=madda_obligatory>َا</tajweed>ٓ<tajweed class=ikhafa>ءً ف</tajweed>َأَخْرَ<tajweed class=qalaqah>جْ</tajweed>نَا بِه<tajweed class=madda_obligatory>ِۦٓ</tajweed> أَزْو<tajweed class=madda_normal>َٲ</tajweed><tajweed class=idgham_ghunnah>جًا م</tajweed>ّ<tajweed class=idgham_ghunnah>ِن ن</tajweed>َّبَا<tajweed class=ikhafa>تٍ ش</tajweed>َتَّىٰ <span class=end>٥٣</span>","End":"٥٣","PageNumber":315,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":271,"MaqraNumber":125,"HizbNumber":32,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":20,"SurahIndex":"020","VerseNumber":54,"ShowSurahName":false,"ShowBismillah":false,"Text":"كُلُواْ وَٱرۡعَوۡاْ أَنۡعَٰمَكُمۡۚ إِنَّ فِي ذَٰلِكَ لَأٓيَٰتٖ لِّأُوْلِي ٱلنُّهَىٰ","TajweedText":"كُلُو<tajweed class=slnt>اْ</tajweed> وَ<tajweed class=ham_wasl>ٱ</tajweed>رْعَوْ<tajweed class=slnt>اْ</tajweed> أَنْعَ<tajweed class=madda_normal>ـٰ</tajweed>مَكُمْ‌ۗ إِ<tajweed class=ghunnah>نّ</tajweed>َ فِى ذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ لَأَيَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_wo_ghunnah>تٍ ل</tajweed>ِّأُ<tajweed class=slnt>وْ</tajweed>لِى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>ُهَىٰ <span class=end>٥٤</span>","End":"٥٤","PageNumber":315,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":271,"MaqraNumber":125,"HizbNumber":32,"HizbDecimal":0.0,"HasSajda":false}]}