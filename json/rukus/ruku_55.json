{"RukuNumber":55,"Verses":[{"SurahNumber":3,"SurahIndex":"003","VerseNumber":130,"ShowSurahName":false,"ShowBismillah":false,"Text":"يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ لَا تَأۡكُلُواْ ٱلرِّبَوٰٓاْ أَضۡعَٰفٗا مُّضَٰعَفَةٗۖ وَٱتَّقُواْ ٱللَّهَ لَعَلَّكُمۡ تُفۡلِحُونَ","TajweedText":"يَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>أَيُّهَا <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ ءَامَنُو<tajweed class=slnt>اْ</tajweed> لَا تَأْكُلُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رِّبَ<tajweed class=madda_obligatory><tajweed class=slnt>و</tajweed>ٲٓاْ</tajweed> أَضْعَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>فًا م</tajweed>ُّضَ<tajweed class=madda_normal>ـٰ</tajweed>عَفَ<tajweed class=idgham_ghunnah>ةً‌ۖ و</tajweed>َ<tajweed class=ham_wasl>ٱ</tajweed>تَّقُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed>للَّهَ لَعَلَّكُمْ تُفْلِح<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٣٠</span>","End":"١٣٠","PageNumber":66,"JuzNumber":4,"ManzilNumber":1,"RukuNumber":55,"MaqraNumber":26,"HizbNumber":7,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":3,"SurahIndex":"003","VerseNumber":131,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَٱتَّقُواْ ٱلنَّارَ ٱلَّتِيٓ أُعِدَّتۡ لِلۡكَٰفِرِينَ","TajweedText":"وَ<tajweed class=ham_wasl>ٱ</tajweed>تَّقُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َارَ <tajweed class=ham_wasl>ٱ</tajweed>لَّت<tajweed class=madda_obligatory>ِىٓ</tajweed> أُعِدَّتْ لِلْكَ<tajweed class=madda_normal>ـٰ</tajweed>فِر<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٣١</span>","End":"١٣١","PageNumber":66,"JuzNumber":4,"ManzilNumber":1,"RukuNumber":55,"MaqraNumber":26,"HizbNumber":7,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":3,"SurahIndex":"003","VerseNumber":132,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَأَطِيعُواْ ٱللَّهَ وَٱلرَّسُولَ لَعَلَّكُمۡ تُرۡحَمُونَ","TajweedText":"وَأَطِيعُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed>للَّهَ وَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رَّسُولَ لَعَلَّكُمْ تُرْحَم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٣٢</span>","End":"١٣٢","PageNumber":66,"JuzNumber":4,"ManzilNumber":1,"RukuNumber":55,"MaqraNumber":26,"HizbNumber":7,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":3,"SurahIndex":"003","VerseNumber":133,"ShowSurahName":false,"ShowBismillah":false,"Text":"۞وَسَارِعُوٓاْ إِلَىٰ مَغۡفِرَةٖ مِّن رَّبِّكُمۡ وَجَنَّةٍ عَرۡضُهَا ٱلسَّمَٰوَٰتُ وَٱلۡأَرۡضُ أُعِدَّتۡ لِلۡمُتَّقِينَ","TajweedText":"۞ وَسَارِع<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> إِلَىٰ مَغْفِرَ<tajweed class=idgham_ghunnah>ةٍ م</tajweed>ّ<tajweed class=idgham_wo_ghunnah>ِن ر</tajweed>َّبِّكُمْ وَجَ<tajweed class=ghunnah>نّ</tajweed>َةٍ عَرْضُهَا <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّمَ<tajweed class=madda_normal>ـٰ</tajweed>و<tajweed class=madda_normal>َٲ</tajweed>تُ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضُ أُعِدَّتْ لِلْمُتَّق<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٣٣</span>","End":"١٣٣","PageNumber":67,"JuzNumber":4,"ManzilNumber":1,"RukuNumber":55,"MaqraNumber":27,"HizbNumber":7,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":3,"SurahIndex":"003","VerseNumber":134,"ShowSurahName":false,"ShowBismillah":false,"Text":"ٱلَّذِينَ يُنفِقُونَ فِي ٱلسَّرَّآءِ وَٱلضَّرَّآءِ وَٱلۡكَٰظِمِينَ ٱلۡغَيۡظَ وَٱلۡعَافِينَ عَنِ ٱلنَّاسِۗ وَٱللَّهُ يُحِبُّ ٱلۡمُحۡسِنِينَ","TajweedText":"ٱلَّذِينَ يُ<tajweed class=ikhafa>نف</tajweed>ِقُونَ فِى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّرّ<tajweed class=madda_obligatory>َا</tajweed>ٓءِ وَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>ضَّرّ<tajweed class=madda_obligatory>َا</tajweed>ٓءِ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْكَ<tajweed class=madda_normal>ـٰ</tajweed>ظِمِينَ <tajweed class=ham_wasl>ٱ</tajweed>لْغَيْظَ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْعَافِينَ عَنِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َاسِ‌ۗ وَ<tajweed class=ham_wasl>ٱ</tajweed>للَّهُ يُحِبُّ <tajweed class=ham_wasl>ٱ</tajweed>لْمُحْسِن<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٣٤</span>","End":"١٣٤","PageNumber":67,"JuzNumber":4,"ManzilNumber":1,"RukuNumber":55,"MaqraNumber":27,"HizbNumber":7,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":3,"SurahIndex":"003","VerseNumber":135,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَٱلَّذِينَ إِذَا فَعَلُواْ فَٰحِشَةً أَوۡ ظَلَمُوٓاْ أَنفُسَهُمۡ ذَكَرُواْ ٱللَّهَ فَٱسۡتَغۡفَرُواْ لِذُنُوبِهِمۡ وَمَن يَغۡفِرُ ٱلذُّنُوبَ إِلَّا ٱللَّهُ وَلَمۡ يُصِرُّواْ عَلَىٰ مَا فَعَلُواْ وَهُمۡ يَعۡلَمُونَ","TajweedText":"وَ<tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ إِذَا فَعَلُو<tajweed class=slnt>اْ</tajweed> فَ<tajweed class=madda_normal>ـٰ</tajweed>حِشَةً أَوْ ظَلَم<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> أَ<tajweed class=ikhafa>نف</tajweed>ُسَهُمْ ذَكَرُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed>للَّهَ فَ<tajweed class=ham_wasl>ٱ</tajweed>سْتَغْفَرُو<tajweed class=slnt>اْ</tajweed> لِذُنُوبِهِمْ وَم<tajweed class=idgham_ghunnah>َن ي</tajweed>َغْفِرُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>ذُّنُوبَ إِلَّا <tajweed class=ham_wasl>ٱ</tajweed>للَّهُ وَلَمْ يُصِرُّو<tajweed class=slnt>اْ</tajweed> عَلَىٰ مَا فَعَلُو<tajweed class=slnt>اْ</tajweed> وَهُمْ يَعْلَم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٣٥</span>","End":"١٣٥","PageNumber":67,"JuzNumber":4,"ManzilNumber":1,"RukuNumber":55,"MaqraNumber":27,"HizbNumber":7,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":3,"SurahIndex":"003","VerseNumber":136,"ShowSurahName":false,"ShowBismillah":false,"Text":"أُوْلَـٰٓئِكَ جَزَآؤُهُم مَّغۡفِرَةٞ مِّن رَّبِّهِمۡ وَجَنَّـٰتٞ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ خَٰلِدِينَ فِيهَاۚ وَنِعۡمَ أَجۡرُ ٱلۡعَٰمِلِينَ","TajweedText":"أُ<tajweed class=slnt>وْ</tajweed>لَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ئِكَ جَز<tajweed class=madda_obligatory>َا</tajweed>ٓؤُه<tajweed class=idgham_shafawi>ُم م</tajweed>َّغْفِرَ<tajweed class=idgham_ghunnah>ةٌ م</tajweed>ّ<tajweed class=idgham_wo_ghunnah>ِن ر</tajweed>َّبِّهِمْ وَجَ<tajweed class=ghunnah>نّ</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=ikhafa>تٌ ت</tajweed>َ<tajweed class=qalaqah>جْ</tajweed>رِى مِ<tajweed class=ikhafa>ن ت</tajweed>َحْتِهَا <tajweed class=ham_wasl>ٱ</tajweed>لْأَنْهَ<tajweed class=madda_normal>ـٰ</tajweed>رُ خَ<tajweed class=madda_normal>ـٰ</tajweed>لِدِينَ فِيهَا‌ۚ وَنِعْمَ أَ<tajweed class=qalaqah>جْ</tajweed>رُ <tajweed class=ham_wasl>ٱ</tajweed>لْعَ<tajweed class=madda_normal>ـٰ</tajweed>مِل<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٣٦</span>","End":"١٣٦","PageNumber":67,"JuzNumber":4,"ManzilNumber":1,"RukuNumber":55,"MaqraNumber":27,"HizbNumber":7,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":3,"SurahIndex":"003","VerseNumber":137,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَدۡ خَلَتۡ مِن قَبۡلِكُمۡ سُنَنٞ فَسِيرُواْ فِي ٱلۡأَرۡضِ فَٱنظُرُواْ كَيۡفَ كَانَ عَٰقِبَةُ ٱلۡمُكَذِّبِينَ","TajweedText":"قَ<tajweed class=qalaqah>دْ</tajweed> خَلَتْ مِ<tajweed class=ikhafa>ن ق</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>لِكُمْ سُنَ<tajweed class=ikhafa>نٌ ف</tajweed>َسِيرُو<tajweed class=slnt>اْ</tajweed> فِى <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ فَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=ikhafa>نظ</tajweed>ُرُو<tajweed class=slnt>اْ</tajweed> كَيْفَ كَانَ عَ<tajweed class=madda_normal>ـٰ</tajweed>قِبَةُ <tajweed class=ham_wasl>ٱ</tajweed>لْمُكَذِّب<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٣٧</span>","End":"١٣٧","Pa