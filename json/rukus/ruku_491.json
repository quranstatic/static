h>نّ</tajweed>َم<tajweed class=madda_obligatory>َآ</tajweed> أَمْو<tajweed class=madda_normal>َٲ</tajweed>لُكُمْ وَأَوْلَ<tajweed class=madda_normal>ـٰ</tajweed>دُكُمْ فِتْنَ<tajweed class=idgham_ghunnah>ةٌ‌ۚ و</tajweed>َ<tajweed class=ham_wasl>ٱ</tajweed>للَّهُ عِ<tajweed class=ikhafa>ند</tajweed>َهُ<tajweed class=madda_obligatory>ۥٓ</tajweed> أَ<tajweed class=qalaqah>جْ</tajweed>رٌ عَظ<tajweed class=madda_permissible>ِي</tajweed>مٌ <span class=end>١٥</span>","End":"١٥","PageNumber":557,"JuzNumber":28,"ManzilNumber":7,"RukuNumber":491,"MaqraNumber":222,"HizbNumber":56,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":64,"SurahIndex":"064","VerseNumber":16,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَٱتَّقُواْ ٱللَّهَ مَا ٱسۡتَطَعۡتُمۡ وَٱسۡمَعُواْ وَأَطِيعُواْ وَأَنفِقُواْ خَيۡرٗا لِّأَنفُسِكُمۡۗ وَمَن يُوقَ شُحَّ نَفۡسِهِۦ فَأُوْلَـٰٓئِكَ هُمُ ٱلۡمُفۡلِحُونَ","TajweedText":"فَ<tajweed class=ham_wasl>ٱ</tajweed>تَّقُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed>للَّهَ مَا <tajweed class=ham_wasl>ٱ</tajweed>سْتَطَعْتُمْ وَ<tajweed class=ham_wasl>ٱ</tajweed>سْمَعُو<tajweed class=slnt>اْ</tajweed> وَأَطِيعُو<tajweed class=slnt>اْ</tajweed> وَأَ<tajweed class=ikhafa>نف</tajweed>ِقُو<tajweed class=slnt>اْ</tajweed> خَيْ<tajweed class=idgham_wo_ghunnah>رًا ل</tajweed>ِّأَ<tajweed class=ikhafa>نف</tajweed>ُسِكُمْ‌ۗ وَم<tajweed class=idgham_ghunnah>َن ي</tajweed>ُوقَ شُحَّ نَفْسِه<tajweed class=madda_normal>ِۦ</tajweed> فَأُ<tajweed class=slnt>وْ</tajweed>لَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ئِكَ هُمُ <tajweed class=ham_wasl>ٱ</tajweed>لْمُفْلِح<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٦</span>","End":"١٦","PageNumber":557,"JuzNumber":28,"ManzilNumber":7,"RukuNumber":491,"MaqraNumber":222,"HizbNumber":56,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":64,"SurahIndex":"064","VerseNumber":17,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِن تُقۡرِضُواْ ٱللَّهَ قَرۡضًا حَسَنٗا يُضَٰعِفۡهُ لَكُمۡ وَي