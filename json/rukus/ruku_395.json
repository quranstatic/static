{"RukuNumber":395,"Verses":[{"SurahNumber":38,"SurahIndex":"038","VerseNumber":65,"ShowSurahName":false,"ShowBismillah":false,"Text":"قُلۡ إِنَّمَآ أَنَا۠ مُنذِرٞۖ وَمَا مِنۡ إِلَٰهٍ إِلَّا ٱللَّهُ ٱلۡوَٰحِدُ ٱلۡقَهَّارُ","TajweedText":"قُلْ إِ<tajweed class=ghunnah>نّ</tajweed>َم<tajweed class=madda_obligatory>َآ</tajweed> أَنَا۟ مُ<tajweed class=ikhafa>نذ</tajweed>ِ<tajweed class=idgham_ghunnah>رٌ‌ۖ و</tajweed>َمَا مِنْ إِلَ<tajweed class=madda_normal>ـٰ</tajweed>هٍ إِلَّا <tajweed class=ham_wasl>ٱ</tajweed>للَّهُ <tajweed class=ham_wasl>ٱ</tajweed>لْو<tajweed class=madda_normal>َٲ</tajweed>حِدُ <tajweed class=ham_wasl>ٱ</tajweed>لْقَهّ<tajweed class=madda_permissible>َا</tajweed>رُ <span class=end>٦٥</span>","End":"٦٥","PageNumber":457,"JuzNumber":23,"ManzilNumber":6,"RukuNumber":395,"MaqraNumber":183,"HizbNumber":46,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":38,"SurahIndex":"038","VerseNumber":66,"ShowSurahName":false,"ShowBismillah":false,"Text":"رَبُّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا ٱلۡعَزِيزُ ٱلۡغَفَّـٰرُ","TajweedText":"رَبُّ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّمَ<tajweed class=madda_normal>ـٰ</tajweed>و<tajweed class=madda_normal>َٲ</tajweed>تِ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ وَمَا بَيْنَهُمَا <tajweed class=ham_wasl>ٱ</tajweed>لْعَزِيزُ <tajweed class=ham_wasl>ٱ</tajweed>لْغَفَّ<tajweed class=madda_permissible>ـٰ</tajweed>رُ <span class=end>٦٦</span>","End":"٦٦","PageNumber":457,"JuzNumber":23,"ManzilNumber":6,"RukuNumber":395,"MaqraNumber":183,"HizbNumber":46,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":38,"SurahIndex":"038","VerseNumber":67,"ShowSurahName":false,"ShowBismillah":false,"Text":"قُلۡ هُوَ نَبَؤٌاْ عَظِيمٌ","TajweedText":"قُلْ هُوَ نَبَؤٌاْ عَظ<tajweed class=madda_permissible>ِي</tajweed>مٌ <span class=end>٦٧</span>","End":"٦٧","PageNumber":457,"JuzNumber":23,"ManzilNumber":6,"RukuNumber":395,"MaqraNumber":183,"HizbNumber":46,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":38,"SurahIndex":"038","VerseNumber":68,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَنتُمۡ عَنۡهُ مُعۡرِضُونَ","TajweedText":"أَ<tajweed class=ikhafa>نت</tajweed>ُمْ عَنْهُ مُعْرِض<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٨</span>","End":"٦٨","PageNumber":457,"JuzNumber":23,"ManzilNumber":6,"RukuNumber":395,"MaqraNumber":183,"HizbNumber":46,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":38,"SurahIndex":"038","VerseNumber":69,"ShowSurahName":false,"ShowBismillah":false,"Text":"مَا كَانَ لِيَ مِنۡ عِلۡمِۭ بِٱلۡمَلَإِ ٱلۡأَعۡلَىٰٓ إِذۡ يَخۡتَصِمُونَ","TajweedText":"مَا كَانَ لِىَ مِنْ عِلْ<tajweed class=iqlab>مِۭ ب</tajweed>ِ<tajweed class=ham_wasl>ٱ</tajweed>لْمَلَإِ <tajweed class=ham_wasl>ٱ</tajweed>لْأَعْلَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> إِذْ يَخْتَصِم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٩</span>","End":"٦٩","PageNumber":457,"JuzNumber":23,"ManzilNumber":6,"RukuNumber":395,"MaqraNumber":183,"HizbNumber":46,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":38,"SurahIndex":"038","VerseNumber":70,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِن يُوحَىٰٓ إِلَيَّ إِلَّآ أَنَّمَآ أَنَا۠ نَذِيرٞ مُّبِينٌ","TajweedText":"إ<tajweed class=idgham_ghunnah>ِن ي</tajweed>ُوحَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> إِلَىَّ إِلّ<tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=ghunnah>نّ</tajweed>َم<tajweed class=madda_obligatory>َآ</tajweed> أَنَا۟ نَذِي<tajweed class=idgham_ghunnah>رٌ م</tajweed>ُّب<tajweed class=madda_permissible>ِي</tajweed>نٌ <span class=end>٧٠</span>","End":"٧٠","PageNumber":457,"JuzNumber":23,"ManzilNumber":6,"RukuNumber":395,"MaqraNumber":183,"HizbNumber":46,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":38,"SurahIndex":"038","VerseNumber":71,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِذۡ قَالَ رَبُّكَ لِلۡمَلَـٰٓئِكَةِ إِنِّي خَٰلِقُۢ بَشَرٗا مِّن طِينٖ","TajweedText":"إِذْ قَالَ رَبُّكَ لِلْمَلَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ئِكَةِ إِ<tajweed class=ghunnah>نّ</tajweed>ِى خَ<tajweed class=madda_normal>ـٰ</tajweed>لِ<tajweed class=iqlab>قُۢ ب</tajweed>َشَ<tajweed class=idgham_ghunnah>رًا م</tajweed>ِّ<tajweed class=ikhafa>ن ط</tajweed><tajweed class=madda_permissible>ِي</tajweed>نٍ <span class=end>٧١</span>","End":"٧١","PageNumber":457,"JuzNumber":23,"ManzilNumber":6,"RukuNumber":395,"MaqraNumber":183,"HizbNumber":46,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":38,"SurahIndex":"038","VerseNumber":72,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَإِذَا سَوَّيۡتُهُۥ وَنَفَخۡتُ فِيهِ مِن رُّوحِي فَقَعُواْ لَهُۥ سَٰجِدِينَ","TajweedText":"فَإِذَا سَوَّيْتُهُ<tajweed class=madda_normal>ۥ</tajweed> وَنَفَخْتُ فِيهِ م<tajweed class=idgham_wo_ghunnah>ِن ر</tajweed>ُّوحِى فَقَعُو<tajweed class=slnt>اْ</tajweed> لَهُ<tajweed class=madda_normal>ۥ</tajweed> سَ<tajweed class=madda_normal>ـٰ</tajweed>جِد<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٧٢</span>","End":"٧٢","PageNumber":457,"JuzNumber":23,"ManzilNumber":6,"RukuNumber":395,"MaqraNumber":183,"HizbNumber":46,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":38,"SurahIndex":"038","VerseNumber":73,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَسَجَدَ ٱلۡمَلَـٰٓئِكَةُ كُلُّهُمۡ أَجۡمَعُونَ","TajweedText":"فَسَجَدَ <tajweed class=ham_wasl>ٱ</tajweed>لْمَلَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ئِكَةُ كُلُّهُمْ أَ<tajweed class=qalaqah>جْ</tajweed>مَع<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٧٣</span>","End":"٧٣","PageNumber":457,"JuzNumber":23,"ManzilNumber":6,"RukuNumber":395,"MaqraNumber":183,"HizbNumber":46,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":38,"SurahIndex":"038","VerseNumber":74,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِلَّآ إِبۡلِيسَ ٱسۡتَكۡبَرَ وَكَانَ مِنَ ٱلۡكَٰفِرِينَ","TajweedText":"إِلّ<tajweed class=madda_obligatory>َآ</tajweed> إِ<tajweed class=qalaqah>بْ</tajweed>لِيسَ <tajweed class=ham_wasl>ٱ</tajweed>سْتَكْبَرَ وَكَانَ مِنَ <tajweed class=ham_wasl>ٱ</tajweed>لْكَ<tajweed class=madda_normal>ـٰ</tajweed>فِر<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٧٤</span>","End":"٧٤","PageNumber":457,"JuzNumber":23,"ManzilNumber":6,"RukuNumber":395,"MaqraNumber":183,"HizbNumber":46,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":38,"SurahIndex":"038","VerseNumber":75,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَ يَـٰٓإِبۡلِيسُ مَا مَنَعَكَ أَن تَسۡجُدَ لِمَا خَلَقۡتُ بِيَدَيَّۖ أَسۡتَكۡبَرۡتَ أَمۡ كُنتَ مِنَ ٱلۡعَالِينَ","TajweedText":"قَالَ يَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>إِ<tajweed class=qalaqah>بْ</tajweed>لِيسُ مَا مَنَعَكَ أَ<tajweed class=ikhafa>ن ت</tajweed>َسْجُدَ لِمَا خَلَ<tajweed class=qalaqah>قْ</tajweed>تُ بِيَدَىَّ‌ۖ أَسْتَكْبَرْتَ أَمْ كُ<tajweed class=ikhafa>نت</tajweed>َ مِنَ <tajweed class=ham_wasl>ٱ</tajweed>لْعَال<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٧٥</span>","End":"٧٥","PageNumber":457,"JuzNumber":23,"ManzilNumber":6,"RukuNumber":395,"MaqraNumber":183,"HizbNumber":46,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":38,"SurahIndex":"038","VerseNumber":76,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَ أَنَا۠ خَيۡرٞ مِّنۡهُ خَلَقۡتَنِي مِن نَّارٖ وَخَلَقۡتَهُۥ مِن طِينٖ","TajweedText":"قَالَ أَنَا۟ خَيْ<tajweed class=idgham_ghunnah>رٌ م</tajweed>ِّنْهُ‌ۖ خَلَ<tajweed class=qalaqah>قْ</tajweed>تَنِى م<tajweed class=idgham_ghunnah>ِن ن</tajweed>َّا<tajweed class=idgham_ghunnah>رٍ و</tajweed>َخَلَ<tajweed class=qalaqah>قْ</tajweed>تَهُ<tajweed class=madda_normal>ۥ</tajweed> مِ<tajweed class=ikhafa>ن ط</tajweed><tajweed class=madda_permissible>ِي</tajweed>نٍ <span class=end>٧٦</span>","End":"٧٦","PageNumber":457,"JuzNumber":23,"ManzilNumber":6,"RukuNumber":395,"MaqraNumber":183,"HizbNumber":46,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":38,"SurahIndex":"038","VerseNumber":77,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَ فَٱخۡرُجۡ مِنۡهَا فَإِنَّكَ رَجِيمٞ","TajweedText":"قَالَ فَ<tajweed class=ham_wasl>ٱ</tajweed>خْرُ<tajweed class=qalaqah>جْ</tajweed> مِنْهَا فَإِ<tajweed class=ghunnah>نّ</tajweed>َكَ رَج<tajweed class=madda_permissible>ِي</tajweed>مٌ <span class=end>٧٧</span>","End":"٧٧","PageNumber":457,"JuzNumber":23,"ManzilNumber":6,"RukuNumber":395,"MaqraNumber":183,"HizbNumber":46,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":38,"SurahIndex":"038","VerseNumber":78,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِنَّ عَلَيۡكَ لَعۡنَتِيٓ إِلَىٰ يَوۡمِ ٱلدِّينِ","TajweedText":"وَإِ<tajweed class=ghunnah>نّ</tajweed>َ عَلَيْكَ لَعْنَت<tajweed class=madda_obligatory>ِىٓ</tajweed> إِلَىٰ يَوْمِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>دّ<tajweed class=madda_permissible>ِي</tajweed>نِ <span class=end>٧٨</span>","End":"٧٨","PageNumber":457,"JuzNumber":23,"ManzilNumber":6,"RukuNumber":395,"MaqraNumber":183,"HizbNumber":46,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":38,"SurahIndex":"038","VerseNumber":79,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَ رَبِّ فَأَنظِرۡنِيٓ إِلَىٰ يَوۡمِ يُبۡعَثُونَ","TajweedText":"قَالَ رَبِّ فَأَ<tajweed class=ikhafa>نظ</tajweed>ِرْن<tajweed class=madda_obligatory>ِىٓ</tajweed> إِلَىٰ يَوْمِ يُ<tajweed class=qalaqah>بْ</tajweed>عَث<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٧٩</span>","End":"٧٩","PageNumber":457,"JuzNumber":23,"ManzilNumber":6,"RukuNumber":395,"MaqraNumber":183,"HizbNumber":46,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":38,"SurahIndex":"038","VerseNumber":80,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَ فَإِنَّكَ مِنَ ٱلۡمُنظَرِينَ","TajweedText":"قَالَ فَإِ<tajweed class=ghunnah>نّ</tajweed>َكَ مِنَ <tajweed class=ham_wasl>ٱ</tajweed>لْمُ<tajweed class=ikhafa>نظ</tajweed>َر<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٨٠</span>","End":"٨٠","PageNumber":457,"JuzNumber":23,"ManzilNumber":6,"RukuNumber":395,"MaqraNumber":183,"HizbNumber":46,"HizbDecimal":0.5,"HasSa