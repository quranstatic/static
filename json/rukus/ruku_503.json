{"RukuNumber":503,"Verses":[{"SurahNumber":70,"SurahIndex":"070","VerseNumber":36,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَمَالِ ٱلَّذِينَ كَفَرُواْ قِبَلَكَ مُهۡطِعِينَ","TajweedText":"فَمَالِ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ كَفَرُو<tajweed class=slnt>اْ</tajweed> قِبَلَكَ مُهْطِع<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٣٦</span>","End":"٣٦","PageNumber":569,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":503,"MaqraNumber":228,"HizbNumber":57,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":70,"SurahIndex":"070","VerseNumber":37,"ShowSurahName":false,"ShowBismillah":false,"Text":"عَنِ ٱلۡيَمِينِ وَعَنِ ٱلشِّمَالِ عِزِينَ","TajweedText":"عَنِ <tajweed class=ham_wasl>ٱ</tajweed>لْيَمِينِ وَعَنِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>شِّمَالِ عِز<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٣٧</span>","End":"٣٧","PageNumber":569,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":503,"MaqraNumber":228,"HizbNumber":57,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":70,"SurahIndex":"070","VerseNumber":38,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَيَطۡمَعُ كُلُّ ٱمۡرِيٕٖ مِّنۡهُمۡ أَن يُدۡخَلَ جَنَّةَ نَعِيمٖ","TajweedText":"أَيَ<tajweed class=qalaqah>طْ</tajweed>مَعُ كُلُّ <tajweed class=ham_wasl>ٱ</tajweed>مْرِى<tajweed class=idgham_ghunnah>ٍٕ م</tajweed>ِّنْهُمْ أ<tajweed class=idgham_ghunnah>َن ي</tajweed>ُ<tajweed class=qalaqah>دْ</tajweed>خَلَ جَ<tajweed class=ghunnah>نّ</tajweed>َةَ نَع<tajweed class=madda_permissible>ِي</tajweed>مٍ <span class=end>٣٨</span>","End":"٣٨","PageNumber":569,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":503,"MaqraNumber":228,"HizbNumber":57,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":70,"SurahIndex":"070","VerseNumber":39,"ShowSurahName":false,"ShowBismillah":false,"Text":"كَلَّآۖ إِنَّا خَلَقۡنَٰهُم مِّمَّا يَعۡلَمُونَ","TajweedText":"كَلّ<tajweed class=madda_obligatory>َآ‌ۖ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َا خَلَ<tajweed class=qalaqah>قْ</tajweed>نَ<tajweed class=madda_normal>ـٰ</tajweed>ه<tajweed class=idgham_shafawi>ُم م</tajweed>ِّ<tajweed class=ghunnah>مّ</tajweed>َا يَعْلَم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣٩</span>","End":"٣٩","PageNumber":569,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":503,"MaqraNumber":228,"HizbNumber":57,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":70,"SurahIndex":"070","VerseNumber":40,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَلَآ أُقۡسِمُ بِرَبِّ ٱلۡمَشَٰرِقِ وَٱلۡمَغَٰرِبِ إِنَّا لَقَٰدِرُونَ","TajweedText":"فَل<tajweed class=madda_obligatory>َآ</tajweed> أُ<tajweed class=qalaqah>قْ</tajweed>سِمُ بِرَبِّ <tajweed class=ham_wasl>ٱ</tajweed>لْمَشَ<tajweed class=madda_normal>ـٰ</tajweed>رِقِ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْمَغَ<tajweed class=madda_normal>ـٰ</tajweed>رِبِ إِ<tajweed class=ghunnah>نّ</tajweed>َا لَقَ<tajweed class=madda_normal>ـٰ</tajweed>دِر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٤٠</span>","End":"٤٠","PageNumber":570,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":503,"MaqraNumber":228,"HizbNumber":57,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":70,"SurahIndex":"070","VerseNumber":41,"ShowSurahName":false,"ShowBismillah":false,"Text":"عَلَىٰٓ أَن نُّبَدِّلَ خَيۡرٗا مِّنۡهُمۡ وَمَا نَحۡنُ بِمَسۡبُوقِينَ","TajweedText":"عَلَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> أ<tajweed class=idgham_ghunnah>َن ن</tajweed>ُّبَدِّلَ خَيْ<tajweed class=idgham_ghunnah>رًا م</tajweed>ِّنْهُمْ وَمَا نَحْنُ بِمَسْبُوق<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٤١</span>","End":"٤١","PageNumber":570,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":503,"MaqraNumber":228,"HizbNumber":57,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":70,"SurahIndex":"070","VerseNumber":42,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَذَرۡهُمۡ يَخُوضُواْ وَيَلۡعَبُواْ حَتَّىٰ يُلَٰقُواْ يَوۡمَهُمُ ٱلَّذِي يُوعَدُونَ","TajweedText":"فَذَرْهُمْ يَخُوضُو<tajweed class=slnt>اْ</tajweed> وَيَلْعَبُو<tajweed class=slnt>اْ</tajweed> حَتَّىٰ يُلَ<tajweed class=madda_normal>ـٰ</tajweed>قُو<tajweed class=slnt>اْ</tajweed> يَوْمَهُمُ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى يُوعَد<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٤٢</span>","End":"٤٢","PageNumber":570,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":503,"MaqraNumber":228,"HizbNumber":57,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":70,"SurahIndex":"070","VerseNumber":43,"ShowSurahName":false,"ShowBismillah":false,"Text":"يَوۡمَ يَخۡرُجُونَ مِنَ ٱلۡأَجۡدَاثِ سِرَاعٗا كَأَنَّهُمۡ إِلَىٰ نُصُبٖ يُوفِضُونَ","TajweedText":"يَوْمَ يَخْرُجُونَ مِنَ <tajweed class=ham_wasl>ٱ</tajweed>لْأَ<tajweed class=qalaqah>جْ</tajweed>دَاثِ سِرَا<tajweed class=ikhafa>عًا ك</tajweed>َأَ<tajweed class=ghunnah>نّ</tajweed>َهُمْ إِلَىٰ نُصُ<tajweed class=idgham_ghunnah>بٍ ي</tajweed>ُوفِض<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٤٣</span>","End":"٤٣","PageNumber":570,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":503,"MaqraNumber":228,"HizbNumber":57,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":70,"SurahIndex":"070","VerseNumber":44,"ShowSurahName":false,"ShowBismillah":false,"Text":"خَٰشِعَةً أَبۡصَٰرُهُمۡ تَرۡهَقُهُمۡ ذِلَّةٞۚ ذَٰلِكَ ٱلۡيَوۡمُ ٱلَّذِي كَانُواْ يُوعَدُونَ","TajweedText":"خَ<tajweed class=madda_normal>ـٰ</tajweed>شِعَةً أَ<tajweed class=qalaqah>بْ</tajweed>صَ<tajweed class=madda_normal>ـٰ</tajweed>رُهُمْ تَرْهَقُهُمْ ذِلَّ<tajweed class=ikhafa>ةٌ‌ۚ ذ</tajweed><tajweed class=madda_normal>َٲ</tajweed>لِكَ <tajweed class=ham_wasl>ٱ</tajweed>لْيَوْمُ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى كَانُو<tajweed class=slnt>اْ</tajweed> يُوعَد<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٤٤</span>","End":"٤٤","PageNumber":570,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":503,"MaqraNumber":228,"HizbNumber":57,"HizbDecimal":0.75,"HasSajda":false}]}