{"Id":89,"LanguageCode":"deu","Name":"deu-adeltheodorkhou","Author":"Adel Theodor Khoury","Language":"German","Description":"German","Direction":"ltr","Source":"http://tanzil.net","Translations":[{"SurahNumber":103,"VerseNumber":1,"Text":"Beim Nachmittag"},{"SurahNumber":103,"VerseNumber":2,"Text":"Der Mensch erleidet bestimmt Verlust"},{"SurahNumber":103,"VerseNumber":3,"Text":"Außer denjenigen, die glauben und die guten Werke tun, und einander die Wahrheit nahelegen und die Geduld nahelegen"}]}