Text":"۞وَلَقَدۡ فَتَنَّا قَبۡلَهُمۡ قَوۡمَ فِرۡعَوۡنَ وَجَآءَهُمۡ رَسُولٞ كَرِيمٌ","TajweedText":"۞ وَلَقَ<tajweed class=qalaqah>دْ</tajweed> فَتَ<tajweed class=ghunnah>نّ</tajweed>َا قَ<tajweed class=qalaqah>بْ</tajweed>لَهُمْ قَوْمَ فِرْعَوْنَ وَج<tajweed class=madda_obligatory>َا</tajweed>ٓءَهُمْ رَسُو<tajweed class=ikhafa>لٌ ك</tajweed>َر<tajweed class=madda_permissible>ِي</tajweed>مٌ <span class=end>١٧</span>","End":"١٧","PageNumber":496,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":431,"MaqraNumber":199,"HizbNumber":50,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":44,"SurahIndex":"044","VerseNumber":18,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَنۡ أَدُّوٓاْ إِلَيَّ عِبَادَ ٱللَّهِۖ إِنِّي لَكُمۡ رَسُولٌ أَمِينٞ","TajweedText":"أَنْ أَدّ<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> إِلَىَّ عِبَادَ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ‌ۖ إِ<tajweed class=ghunnah>نّ</tajweed>ِى لَكُمْ رَسُولٌ أَم<tajweed class=madda_permissible>ِي</tajweed>نٌ <span class=end>١٨</span>","End":"١٨","PageNumber":496,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":431,"MaqraNumber":199,"HizbNumber":50,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":44,"SurahIndex":"044","VerseNumber":19,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَأَن لَّا تَعۡلُواْ عَلَى ٱللَّهِۖ إِنِّيٓ ءَاتِيكُم بِسُلۡطَٰنٖ مُّبِينٖ","TajweedText":"وَأ<tajweed class=idgham_wo_ghunnah>َن ل</tajweed>َّا تَعْلُو<tajweed class=slnt>اْ</tajweed> عَلَى <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ‌ۖ إِ<tajweed class=ghunnah>نّ</tajweed><tajweed class=madda_obligatory>ِىٓ</tajweed> ءَاتِيك<tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِسُلْطَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>نٍ م</tajweed>ُّب<tajweed class=madda_permissible>ِي</tajweed>نٍ <span class=end>١٩</span>","End":"١٩","PageNumber":497,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":431,"MaqraNumber":199,"HizbNumber":50,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":44,"SurahIndex":"044","VerseNumber":20,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِنِّي عُذۡتُ بِرَبِّي وَرَبِّكُمۡ أَن تَرۡجُمُونِ","TajweedText":"وَإِ<tajweed class=ghunnah>نّ</tajweed>ِى عُذْتُ بِرَبِّى وَرَبِّكُمْ أَ<tajweed class=ikhafa>ن ت</tajweed>َرْجُم<tajweed class=madda_permissible>ُو</tajweed>نِ <span class=end>٢٠</span>","End":"٢٠","PageNumber":497,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":431,"MaqraNumber":199,"HizbNumber":50,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":44,"SurahIndex":"044","VerseNumber":21,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِن لَّمۡ تُؤۡمِنُواْ لِي فَٱعۡتَزِلُونِ","TajweedText":"وَإ<tajweed class=idgham_wo_ghunnah>ِن ل</tajweed>َّمْ تُؤْمِنُو<tajweed class=slnt>اْ</tajweed> لِى فَ<tajweed class=ham_wasl>ٱ</tajweed>عْتَزِل<tajweed class=madda_permissible>ُو</tajweed>نِ <span class=end>٢١</span>","End":"٢١","PageNumber":497,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":431,"MaqraNumber":199,"HizbNumber":50,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":44,"SurahIndex":"044","VerseNumber":22,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَدَعَا رَبَّهُۥٓ أَنَّ هَـٰٓؤُلَآءِ قَوۡمٞ مُّجۡرِمُونَ","TajweedText":"فَدَعَا رَبَّهُ<tajweed class=madda_obligatory>ۥٓ</tajweed> أَ<tajweed class=ghunnah>نّ</tajweed>َ هَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ؤُل<tajweed class=madda_obligatory>َا</tajweed>ٓءِ قَوْ<tajweed class=idgham_ghunnah>مٌ م</tajweed>ُّ<tajweed class=qalaqah>جْ</tajweed>رِم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٢</span>","End":"٢٢","PageNumber":497,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":431,"MaqraNumber":199,"HizbNumber":50,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":44,"SurahIndex":"044","VerseNumber":23,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَأَسۡرِ بِعِبَادِي لَيۡلًا إِنَّكُم مُّتَّبَعُونَ","TajweedText":"فَأَسْرِ بِعِبَادِى لَيْلاً إِ<tajweed class=ghunnah>نّ</tajweed>َك<tajweed class=idgham_shafawi>ُم م</tajweed>ُّتَّبَع<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٣</span>","End":"٢٣","PageNumber":497,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":431,"MaqraNumber":199,"HizbNumber":50,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":44,"SurahIndex":"044","VerseNumber":24,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَٱتۡرُكِ ٱلۡبَحۡرَ رَهۡوًاۖ إِنَّهُمۡ جُندٞ مُّغۡرَقُونَ","TajweedText":"وَ<tajweed class=ham_wasl>ٱ</tajweed>تْرُكِ <tajweed class=ham_wasl>ٱ</tajweed>لْبَحْرَ رَهْوًا‌ۖ إِ<tajweed class=ghunnah>نّ</tajweed>َهُمْ جُن<tajweed class=idgham_ghunnah>دٌ م</tajweed>ُّغْرَق<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٤</span>","End":"٢٤","PageNumber":497,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":431,"MaqraNumber":199,"HizbNumber":50,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":44,"SurahIndex":"044","VerseNumber":25,"ShowSurahName":false,"ShowBismillah":false,"Text":"كَمۡ تَرَكُواْ مِن جَنَّـٰتٖ وَعُيُونٖ","TajweedText":"كَمْ تَرَكُو<tajweed class=slnt>اْ</tajweed> مِ<tajweed class=ikhafa>ن ج</tajweed>َ<tajweed class=ghunnah>نّ</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>تٍ و</tajweed>َعُي<tajweed class=madda_permissible>ُو</tajweed>نٍ <span class=end>٢٥</span>","End":"٢٥","PageNumber":497,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":431,"MaqraNumber":199,"HizbNumber":50,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":44,"SurahIndex":"044","VerseNumber":26,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَزُرُوعٖ وَمَقَامٖ كَرِيمٖ","TajweedText":"وَزُرُو<tajweed class=idgham_ghunnah>عٍ و</tajweed>َمَقَا<tajweed class=ikhafa>مٍ ك</tajweed>َر<tajweed class=madda_permissible>ِي</tajweed>مٍ <span class=end>٢٦</span>","End":"٢٦","PageNumber":497,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":431,"MaqraNumber":199,"HizbNumber":50,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":44,"SurahIndex":"044","VerseNumber":27,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَنَعۡمَةٖ كَانُواْ فِيهَا فَٰكِهِينَ","TajweedText":"وَنَعْمَ<tajweed class=ikhafa>ةٍ ك</tajweed>َانُو<tajweed class=slnt>اْ</tajweed> فِيهَا فَ<tajweed class=madda_normal>ـٰ</tajweed>كِه<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٢٧</span>","End":"٢٧","PageNumber":497,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":431,"MaqraNumber":199,"HizbNumber":50,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":44,"SurahIndex":"044","VerseNumber":28,"ShowSurahName":false,"ShowBismillah":false,"Text":"كَذَٰلِكَۖ وَأَوۡرَثۡنَٰهَا قَوۡمًا ءَاخَرِينَ","TajweedText":"كَذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ‌ۖ وَأَوْرَثْنَ<tajweed class=madda_normal>ـٰ</tajweed>هَا قَوْمًا ءَاخَر<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٢٨</span>","End":"٢٨","PageNumber":497,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":431,"MaqraNumber":199,"HizbNumber":50,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":44,"SurahIndex":"044","VerseNumber":29,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَمَا بَكَتۡ عَلَيۡهِمُ ٱلسَّمَآءُ وَٱلۡأَرۡضُ وَمَا كَانُواْ مُنظَرِينَ","TajweedText":"فَمَا بَكَتْ عَلَيْهِمُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّم<tajweed class=madda_obligatory>َا</tajweed>ٓءُ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضُ وَمَا كَانُو<tajweed class=slnt>اْ</tajweed> مُ<tajweed class=ikhafa>نظ</tajweed>َر<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٢٩</span>","End":"٢٩","PageNumber":497,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":431,"MaqraNumber":199,"HizbNumber":50,"HizbDecimal":0.5,"HasSajda":false}]}