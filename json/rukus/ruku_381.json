{"RukuNumber":381,"Verses":[{"SurahNumber":36,"SurahIndex":"036","VerseNumber":1,"ShowSurahName":true,"ShowBismillah":true,"Text":"يسٓ","TajweedText":"ي<tajweed class=madda_necessary>سٓ</tajweed> <span class=end>١</span>","End":"١","PageNumber":440,"JuzNumber":22,"ManzilNumber":5,"RukuNumber":381,"MaqraNumber":176,"HizbNumber":44,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":2,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَٱلۡقُرۡءَانِ ٱلۡحَكِيمِ","TajweedText":"وَ<tajweed class=ham_wasl>ٱ</tajweed>لْقُرْءَانِ <tajweed class=ham_wasl>ٱ</tajweed>لْحَك<tajweed class=madda_permissible>ِي</tajweed>مِ <span class=end>٢</span>","End":"٢","PageNumber":440,"JuzNumber":22,"ManzilNumber":5,"RukuNumber":381,"MaqraNumber":176,"HizbNumber":44,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":3,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّكَ لَمِنَ ٱلۡمُرۡسَلِينَ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َكَ لَمِنَ <tajweed class=ham_wasl>ٱ</tajweed>لْمُرْسَل<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٣</span>","End":"٣","PageNumber":440,"JuzNumber":22,"ManzilNumber":5,"RukuNumber":381,"MaqraNumber":176,"HizbNumber":44,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":4,"ShowSurahName":false,"ShowBismillah":false,"Text":"عَلَىٰ صِرَٰطٖ مُّسۡتَقِيمٖ","TajweedText":"عَلَىٰ صِر<tajweed class=madda_normal>َٲ</tajweed><tajweed class=idgham_ghunnah>طٍ م</tajweed>ُّسْتَق<tajweed class=madda_permissible>ِي</tajweed>مٍ <span class=end>٤</span>","End":"٤","PageNumber":440,"JuzNumber":22,"ManzilNumber":5,"RukuNumber":381,"MaqraNumber":176,"HizbNumber":44,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":5,"ShowSurahName":false,"ShowBismillah":false,"Text":"تَنزِيلَ ٱلۡعَزِيزِ ٱلرَّحِيمِ","TajweedText":"تَ<tajweed class=ikhafa>نز</tajweed>ِيلَ <tajweed class=ham_wasl>ٱ</tajweed>لْعَزِيزِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رَّح<tajweed class=madda_permissible>ِي</tajweed>مِ <span class=end>٥</span>","End":"٥","PageNumber":440,"JuzNumber":22,"ManzilNumber":5,"RukuNumber":381,"MaqraNumber":176,"HizbNumber":44,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":6,"ShowSurahName":false,"ShowBismillah":false,"Text":"لِتُنذِرَ قَوۡمٗا مَّآ أُنذِرَ ءَابَآؤُهُمۡ فَهُمۡ غَٰفِلُونَ","TajweedText":"لِتُ<tajweed class=ikhafa>نذ</tajweed>ِرَ قَوْ<tajweed class=idgham_ghunnah>مًا م</tajweed>ّ<tajweed class=madda_obligatory>َآ</tajweed> أُ<tajweed class=ikhafa>نذ</tajweed>ِرَ ءَاب<tajweed class=madda_obligatory>َا</tajweed>ٓؤُهُمْ فَهُمْ غَ<tajweed class=madda_normal>ـٰ</tajweed>فِل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦</span>","End":"٦","PageNumber":440,"JuzNumber":22,"ManzilNumber":5,"RukuNumber":381,"MaqraNumber":176,"HizbNumber":44,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":7,"ShowSurahName":false,"ShowBismillah":false,"Text":"لَقَدۡ حَقَّ ٱلۡقَوۡلُ عَلَىٰٓ أَكۡثَرِهِمۡ فَهُمۡ لَا يُؤۡمِنُونَ","TajweedText":"لَقَ<tajweed class=qalaqah>دْ</tajweed> حَقَّ <tajweed class=ham_wasl>ٱ</tajweed>لْقَوْلُ عَلَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> أَكْثَرِهِمْ فَهُمْ لَا يُؤْمِن<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٧</span>","End":"٧","PageNumber":440,"JuzNumber":22,"ManzilNumber":5,"RukuNumber":381,"MaqraNumber":176,"HizbNumber":44,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":8,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّا جَعَلۡنَا فِيٓ أَعۡنَٰقِهِمۡ أَغۡلَٰلٗا فَهِيَ إِلَى ٱلۡأَذۡقَانِ فَهُم مُّقۡمَحُونَ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َا جَعَلْنَا ف<tajweed class=madda_obligatory>ِىٓ</tajweed> أَعْنَ<tajweed class=madda_normal>ـٰ</tajweed>قِهِمْ أَغْلَ<tajweed class=madda_normal>ـٰ</tajweed>ل<tajweed class=ikhafa>اً ف</tajweed>َهِىَ إِلَى <tajweed class=ham_wasl>ٱ</tajweed>لْأَذْقَانِ فَه<tajweed class=idgham_shafawi>ُم م</tajweed>ُّ<tajweed class=qalaqah>قْ</tajweed>مَح<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٨</span>","End":"٨","PageNumber":440,"JuzNumber":22,"ManzilNumber":5,"RukuNumber":381,"MaqraNumber":176,"HizbNumber":44,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":9,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَجَعَلۡنَا مِنۢ بَيۡنِ أَيۡدِيهِمۡ سَدّٗا وَمِنۡ خَلۡفِهِمۡ سَدّٗا فَأَغۡشَيۡنَٰهُمۡ فَهُمۡ لَا يُبۡصِرُونَ","TajweedText":"وَجَعَلْنَا م<tajweed class=iqlab>ِنۢ ب</tajweed>َيْنِ أَيْدِيهِمْ سَد<tajweed class=idgham_ghunnah>ًّا و</tajweed>َمِنْ خَلْفِهِمْ سَد<tajweed class=ikhafa>ًّا ف</tajweed>َأَغْشَيْنَ<tajweed class=madda_normal>ـٰ</tajweed>هُمْ فَهُمْ لَا يُ<tajweed class=qalaqah>بْ</tajweed>صِر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٩</span>","End":"٩","PageNumber":440,"JuzNumber":22,"ManzilNumber":5,"RukuNumber":381,"MaqraNumber":176,"HizbNumber":44,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":10,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَسَوَآءٌ عَلَيۡهِمۡ ءَأَنذَرۡتَهُمۡ أَمۡ لَمۡ تُنذِرۡهُمۡ لَا يُؤۡمِنُونَ","TajweedText":"وَسَو<tajweed class=madda_obligatory>َا</tajweed>ٓءٌ عَلَيْهِمْ ءَأَ<tajweed class=ikhafa>نذ</tajweed>َرْتَهُمْ أَمْ لَمْ تُ<tajweed class=ikhafa>نذ</tajweed>ِرْهُمْ لَا يُؤْمِن<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٠</span>","End":"١٠","PageNumber":440,"JuzNumber":22,"ManzilNumber":5,"RukuNumber":381,"MaqraNumber":176,"HizbNumber":44,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":11,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّمَا تُنذِرُ مَنِ ٱتَّبَعَ ٱلذِّكۡرَ وَخَشِيَ ٱلرَّحۡمَٰنَ بِٱلۡغَيۡبِۖ فَبَشِّرۡهُ بِمَغۡفِرَةٖ وَأَجۡرٖ كَرِيمٍ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َمَا تُ<tajweed class=ikhafa>نذ</tajweed>ِرُ مَنِ <tajweed class=ham_wasl>ٱ</tajweed>تَّبَعَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>ذِّكْرَ وَخَشِىَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رَّحْمَ<tajweed class=madda_normal>ـٰ</tajweed>نَ بِ<tajweed class=ham_wasl>ٱ</tajweed>لْغَيْبِۖ فَبَشِّرْهُ بِمَغْفِرَ<tajweed class=idgham_ghunnah>ةٍ و</tajweed>َأَ<tajweed class=qalaqah>جْ</tajweed><tajweed class=ikhafa>رٍ ك</tajweed>َر<tajweed class=madda_permissible>ِي</tajweed>مٍ <span class=end>١١</span>","End":"١١","PageNumber":440,"JuzNumber":22,"ManzilNumber":5,"RukuNumber":381,"MaqraNumber":176,"HizbNumber":44,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":12,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّا نَحۡنُ نُحۡيِ ٱلۡمَوۡتَىٰ وَنَكۡتُبُ مَا قَدَّمُواْ وَءَاثَٰرَهُمۡۚ وَكُلَّ شَيۡءٍ أَحۡصَيۡنَٰهُ فِيٓ إِمَامٖ مُّبِينٖ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َا نَحْنُ نُحْىِ <tajweed class=ham_wasl>ٱ</tajweed>لْمَوْتَىٰ وَنَكْتُبُ مَا قَدَّمُو<tajweed class=slnt>اْ</tajweed> وَءَاثَ<tajweed class=madda_normal>ـٰ</tajweed>رَهُمْۚ وَكُلَّ شَىْءٍ أَحْصَيْنَ<tajweed class=madda_normal>ـٰ</tajweed>هُ ف<tajweed class=madda_obligatory>ِىٓ</tajweed> إِمَا<tajweed class=idgham_ghunnah>مٍ م</tajweed>ُّب<tajweed class=madda_permissible>ِي</tajweed>نٍ <span class=end>١٢</span>","End":"١٢","PageNumber":440,"JuzNumber":22,"ManzilNumber":5,"RukuNumber":381,"MaqraNumber":176,"HizbNumber":44,"HizbDecimal":0.75,"HasSajda":false}]}