{"RukuNumber":325,"Verses":[{"SurahNumber":26,"SurahIndex":"026","VerseNumber":176,"ShowSurahName":false,"ShowBismillah":false,"Text":"كَذَّبَ أَصۡحَٰبُ لۡـَٔيۡكَةِ ٱلۡمُرۡسَلِينَ","TajweedText":"كَذَّبَ أَصْحَ<tajweed class=madda_normal>ـٰ</tajweed>بُ لْــَٔيْكَةِ <tajweed class=ham_wasl>ٱ</tajweed>لْمُرْسَل<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٧٦</span>","End":"١٧٦","PageNumber":374,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":325,"MaqraNumber":149,"HizbNumber":38,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":26,"SurahIndex":"026","VerseNumber":177,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِذۡ قَالَ لَهُمۡ شُعَيۡبٌ أَلَا تَتَّقُونَ","TajweedText":"إِذْ قَالَ لَهُمْ شُعَيْبٌ أَلَا تَتَّق<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٧٧</span>","End":"١٧٧","PageNumber":374,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":325,"MaqraNumber":149,"HizbNumber":38,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":26,"SurahIndex":"026","VerseNumber":178,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنِّي لَكُمۡ رَسُولٌ أَمِينٞ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>ِى لَكُمْ رَسُولٌ أَم<tajweed class=madda_permissible>ِي</tajweed>نٌ <span class=end>١٧٨</span>","End":"١٧٨","PageNumber":374,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":325,"MaqraNumber":149,"HizbNumber":38,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":26,"SurahIndex":"026","VerseNumber":179,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَٱتَّقُواْ ٱللَّهَ وَأَطِيعُونِ","TajweedText":"فَ<tajweed class=ham_wasl>ٱ</tajweed>تَّقُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed>للَّهَ وَأَطِيع<tajweed class=madda_permissible>ُو</tajweed>نِ <span class=end>١٧٩</span>","End":"١٧٩","PageNumber":374,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":325,"MaqraNumber":149,"HizbNumber":38,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":26,"SurahIndex":"026","VerseNumber":180,"ShowSurahName":false,"ShowBismillah":fa