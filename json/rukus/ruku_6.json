{"RukuNumber":6,"Verses":[{"SurahNumber":2,"SurahIndex":"002","VerseNumber":40,"ShowSurahName":false,"ShowBismillah":false,"Text":"يَٰبَنِيٓ إِسۡرَـٰٓءِيلَ ٱذۡكُرُواْ نِعۡمَتِيَ ٱلَّتِيٓ أَنۡعَمۡتُ عَلَيۡكُمۡ وَأَوۡفُواْ بِعَهۡدِيٓ أُوفِ بِعَهۡدِكُمۡ وَإِيَّـٰيَ فَٱرۡهَبُونِ","TajweedText":"يَ<tajweed class=madda_normal>ـٰ</tajweed>بَن<tajweed class=madda_obligatory>ِىٓ</tajweed> إِسْر<tajweed class=madda_obligatory>َٲ</tajweed>ٓءِيلَ <tajweed class=ham_wasl>ٱ</tajweed>ذْكُرُو<tajweed class=slnt>اْ</tajweed> نِعْمَتِىَ <tajweed class=ham_wasl>ٱ</tajweed>لَّت<tajweed class=madda_obligatory>ِىٓ</tajweed> أَنْعَمْتُ عَلَيْكُمْ وَأَوْفُو<tajweed class=slnt>اْ</tajweed> بِعَهْد<tajweed class=madda_obligatory>ِىٓ</tajweed> أُوفِ بِعَهْدِكُمْ وَإِيَّ<tajweed class=madda_normal>ـٰ</tajweed>ىَ فَ<tajweed class=ham_wasl>ٱ</tajweed>رْهَب<tajweed class=madda_permissible>ُو</tajweed>نِ <span class=end>٤٠</span>","End":"٤٠","PageNumber":7,"JuzNumber":1,"ManzilNumber":1,"RukuNumber":6,"MaqraNumber":2,"HizbNumber":1,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":2,"SurahIndex":"002","VerseNumber":41,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَءَامِنُواْ بِمَآ أَنزَلۡتُ مُصَدِّقٗا لِّمَا مَعَكُمۡ وَلَا تَكُونُوٓاْ أَوَّلَ كَافِرِۭ بِهِۦۖ وَلَا تَشۡتَرُواْ بِـَٔايَٰتِي ثَمَنٗا قَلِيلٗا وَإِيَّـٰيَ فَٱتَّقُونِ","TajweedText":"وَءَامِنُو<tajweed class=slnt>اْ</tajweed> بِم<tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=ikhafa>نز</tajweed>َلْتُ مُصَدِّ<tajweed class=idgham_wo_ghunnah>قًا ل</tajweed>ِّمَا مَعَكُمْ وَلَا تَكُون<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> أَوَّلَ كَافِ<tajweed class=iqlab>رِۭ ب</tajweed>ِه<tajweed class=madda_normal>ِۦ</tajweed>‌ۖ وَلَا تَشْتَرُو<tajweed class=slnt>اْ</tajweed> بِـَٔـايَ<tajweed class=madda_normal>ـٰ</tajweed>تِى ثَمَ<tajweed class=ikhafa>نًا ق</tajweed>َلِيل<tajweed class=idgham_ghunnah>اً و</tajweed>َإِيَّ<tajweed class=madda_normal>ـٰ</tajweed>ىَ فَ<tajweed class=ham_wasl>ٱ