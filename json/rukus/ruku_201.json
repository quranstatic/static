=qalaqah>بْ</tajweed>لَ وِع<tajweed class=madda_obligatory>َا</tajweed>ٓءِ أَخِيهِ ثُ<tajweed class=ghunnah>مّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>سْتَخْرَجَهَا م<tajweed class=idgham_ghunnah>ِن و</tajweed>ِع<tajweed class=madda_obligatory>َا</tajweed>ٓءِ أَخِيهِ‌ۚ كَذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ كِ<tajweed class=qalaqah>دْ</tajweed>نَا لِيُوسُفَ‌ۖ مَا كَانَ لِيَأْخُذَ أَخَاهُ فِى دِينِ <tajweed class=ham_wasl>ٱ</tajweed>لْمَلِكِ إِلّ<tajweed class=madda_obligatory>َآ</tajweed> أ<tajweed class=idgham_ghunnah>َن ي</tajweed>َش<tajweed class=madda_obligatory>َا</tajweed>ٓءَ <tajweed class=ham_wasl>ٱ</tajweed>للَّهُ‌ۚ نَرْفَعُ دَرَجَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>تٍ م</tajweed>ّ<tajweed class=idgham_ghunnah>َن ن</tajweed>َّش<tajweed class=madda_obligatory>َا</tajweed>ٓءُ‌ۗ وَفَوْقَ كُلِّ ذِى عِلْمٍ عَل<tajweed class=madda_permissible>ِي</tajweed>مٌ <span class=end>٧٦</span>","End":"٧٦","PageNumber":244,"JuzNumber":13,"ManzilNumber":3,"RukuNumber":201,"MaqraNumber":97,"HizbNumber":25,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":12,"SurahIndex":"012","VerseNumber":77,"ShowSurahName":false,"ShowBismillah":false,"Text":"۞قَالُوٓاْ إِن يَسۡرِقۡ فَقَدۡ سَرَقَ أَخٞ لَّهُۥ مِن قَبۡلُۚ فَأَسَرَّهَا يُوسُفُ فِي نَفۡسِهِۦ وَلَمۡ يُبۡدِهَا لَهُمۡۚ قَالَ أَنتُمۡ شَرّٞ مَّكَانٗاۖ وَٱللَّهُ أَعۡلَمُ بِمَا تَصِفُونَ","TajweedText":"۞ قَال<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> إ<tajweed class=idgham_ghunnah>ِن ي</tajweed>َسْرِ<tajweed class=qalaqah>قْ</tajweed> فَقَ<tajweed class=qalaqah>دْ</tajweed> سَرَقَ أَ<tajweed class=idgham_wo_ghunnah>خٌ ل</tajweed>َّهُ<tajweed class=madda_normal>ۥ</tajweed> مِ<tajweed class=ikhafa>ن ق</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>لُ‌ۚ فَأَسَرَّهَا يُوسُفُ فِى نَفْسِه<tajweed class=madda_normal>ِۦ</tajweed> وَلَمْ يُ<tajweed class=qalaqah>بْ</tajweed>دِهَا لَهُمْ‌ۚ قَالَ أَ<tajweed class=ikhafa>نت</tajweed>ُمْ شَ<tajweed class=idgham_ghunnah>رٌّ م</tajweed>َّكَا<tajweed class=idgham_ghunnah>نًا‌ۖ و</tajweed>َ<tajweed class=ham_wasl>ٱ</tajweed>للَّهُ أَعْلَمُ بِمَا تَصِف<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٧٧</span>","End":"٧٧","PageNumber":244,"JuzNumber":13,"ManzilNumber":3,"RukuNumber":201,"MaqraNumber":98,"HizbNumber":25,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":12,"SurahIndex":"012","VerseNumber":78,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالُواْ يَـٰٓأَيُّهَا ٱلۡعَزِيزُ إِنَّ لَهُۥٓ أَبٗا شَيۡخٗا كَبِيرٗا فَخُذۡ أَحَدَنَا مَكَانَهُۥٓۖ إِنَّا نَرَىٰكَ مِنَ ٱلۡمُحۡسِنِينَ","TajweedText":"قَالُو<tajweed class=slnt>اْ</tajweed> يَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>أَيُّهَا <tajweed class=ham_wasl>ٱ</tajweed>لْعَزِيزُ إِ<tajweed class=ghunnah>نّ</tajweed>َ لَهُ<tajweed class=madda_obligatory>ۥٓ</tajweed> أَ<tajweed class=ikhafa>بًا ش</tajweed>َيْ<tajweed class=ikhafa>خًا ك</tajweed>َبِي<tajweed class=ikhafa>رًا ف</tajweed>َخُذْ أَحَدَنَا مَكَانَهُ<tajweed class=madda_obligatory>ۥٓ‌ۖ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َا نَرَ<tajweed class=madda_normal>ٮٰ</tajweed>كَ مِنَ <tajweed class=ham_wasl>ٱ</tajweed>لْمُحْسِن<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٧٨</span>","End":"٧٨","PageNumber":244,"JuzNumber":13,"ManzilNumber":3,"RukuNumber":201,"MaqraNumber":98,"HizbNumber":25,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":12,"SurahIndex":"012","VerseNumber":79,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَ مَعَاذَ ٱللَّهِ أَن نَّأۡخُذَ إِلَّا مَن وَجَدۡنَا مَتَٰعَنَا عِندَهُۥٓ إِنَّآ إِذٗا لَّظَٰلِمُونَ","TajweedText":"قَالَ مَعَاذَ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ أ<tajweed class=idgham_ghunnah>َن ن</tajweed>َّأْخُذَ إِلَّا م<tajweed class=idgham_ghunnah>َن و</tajweed>َجَ<tajweed class=qalaqah>دْ</tajweed>نَا مَتَ<tajweed class=madda_normal>ـٰ</tajweed>عَنَا عِ<tajweed class=ikhafa>ند</tajweed>َهُ<tajweed class=madda_obligatory>ۥٓ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed><tajw