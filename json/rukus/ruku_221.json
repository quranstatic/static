{"RukuNumber":221,"Verses":[{"SurahNumber":15,"SurahIndex":"015","VerseNumber":45,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّ ٱلۡمُتَّقِينَ فِي جَنَّـٰتٖ وَعُيُونٍ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>لْمُتَّقِينَ فِى جَ<tajweed class=ghunnah>نّ</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>تٍ و</tajweed>َعُي<tajweed class=madda_permissible>ُو</tajweed>نٍ <span class=end>٤٥</span>","End":"٤٥","PageNumber":264,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":221,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":46,"ShowSurahName":false,"ShowBismillah":false,"Text":"ٱدۡخُلُوهَا بِسَلَٰمٍ ءَامِنِينَ","TajweedText":"ٱ<tajweed class=qalaqah>دْ</tajweed>خُلُوهَا بِسَلَ<tajweed class=madda_normal>ـٰ</tajweed>مٍ ءَامِن<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٤٦</span>","End":"٤٦","PageNumber":264,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":221,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":47,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَنَزَعۡنَا مَا فِي صُدُورِهِم مِّنۡ غِلٍّ إِخۡوَٰنًا عَلَىٰ سُرُرٖ مُّتَقَٰبِلِينَ","TajweedText":"وَنَزَعْنَا مَا فِى صُدُورِه<tajweed class=idgham_shafawi>ِم م</tajweed>ِّنْ غِلٍّ إِخْو<tajweed class=madda_normal>َٲ</tajweed>نًا عَلَىٰ سُرُ<tajweed class=idgham_ghunnah>رٍ م</tajweed>ُّتَقَ<tajweed class=madda_normal>ـٰ</tajweed>بِل<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٤٧</span>","End":"٤٧","PageNumber":264,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":221,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":48,"ShowSurahName":false,"ShowBismillah":false,"Text":"لَا يَمَسُّهُمۡ فِيهَا نَصَبٞ وَمَا هُم مِّنۡهَا بِمُخۡرَجِينَ","TajweedText":"لَا يَمَسُّهُمْ فِيهَا نَصَ<tajweed class=idgham_ghunnah>بٌ و</tajweed>َمَا ه<tajweed class=idgham_shafawi>ُم م</tajweed>ِّنْهَا بِمُخْرَج<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٤٨</span>","End":"٤٨","PageNumber":264,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":221,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":49,"ShowSurahName":false,"ShowBismillah":false,"Text":"۞نَبِّئۡ عِبَادِيٓ أَنِّيٓ أَنَا ٱلۡغَفُورُ ٱلرَّحِيمُ","TajweedText":"۞ نَبِّئْ عِبَاد<tajweed class=madda_obligatory>ِىٓ</tajweed> أَ<tajweed class=ghunnah>نّ</tajweed><tajweed class=madda_obligatory>ِىٓ</tajweed> أَنَا <tajweed class=ham_wasl>ٱ</tajweed>لْغَفُورُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رَّح<tajweed class=madda_permissible>ِي</tajweed>مُ <span class=end>٤٩</span>","End":"٤٩","PageNumber":264,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":221,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":50,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَأَنَّ عَذَابِي هُوَ ٱلۡعَذَابُ ٱلۡأَلِيمُ","TajweedText":"وَأَ<tajweed class=ghunnah>نّ</tajweed>َ عَذَابِى هُوَ <tajweed class=ham_wasl>ٱ</tajweed>لْعَذَابُ <tajweed class=ham_wasl>ٱ</tajweed>لْأَل<tajweed class=madda_permissible>ِي</tajweed>مُ <span class=end>٥٠</span>","End":"٥٠","PageNumber":264,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":221,"MaqraNumber":106,"HizbNumber":27,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":51,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَنَبِّئۡهُمۡ عَن ضَيۡفِ إِبۡرَٰهِيمَ","TajweedText":"وَنَبِّئْهُمْ عَ<tajweed class=ikhafa>ن ض</tajweed>َيْفِ إِ<tajweed class=qalaqah>بْ</tajweed>ر<tajweed class=madda_normal>َٲ</tajweed>ه<tajweed class=madda_permissible>ِي</tajweed>مَ <span class=end>٥١</span>","End":"٥١","PageNumber":264,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":221,"MaqraNumber":106,"HizbNumber":27,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":52,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِذۡ دَخَلُواْ عَلَيۡهِ فَقَالُواْ سَلَٰمٗا قَالَ إِنَّا مِنكُمۡ وَجِلُونَ","TajweedText":"إِذْ دَخَلُو<tajweed class=slnt>اْ</tajweed> عَلَيْهِ فَقَالُو<tajweed class=slnt>اْ</tajweed> سَلَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=ikhafa>مًا ق</tajweed>َالَ إِ<tajweed class=ghunnah>نّ</tajweed>َا مِ<tajweed class=ikhafa>نك</tajweed>ُمْ وَجِل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٥٢</span>","End":"٥٢","PageNumber":265,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":221,"MaqraNumber":106,"HizbNumber":27,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":53,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالُواْ لَا تَوۡجَلۡ إِنَّا نُبَشِّرُكَ بِغُلَٰمٍ عَلِيمٖ","TajweedText":"قَالُو<tajweed class=slnt>اْ</tajweed> لَا تَوْجَلْ إِ<tajweed class=ghunnah>نّ</tajweed>َا نُبَشِّرُكَ بِغُلَ<tajweed class=madda_normal>ـٰ</tajweed>مٍ عَل<tajweed class=madda_permissible>ِي</tajweed>مٍ <span class=end>٥٣</span>","End":"٥٣","PageNumber":265,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":221,"MaqraNumber":106,"HizbNumber":27,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":54,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَ أَبَشَّرۡتُمُونِي عَلَىٰٓ أَن مَّسَّنِيَ ٱلۡكِبَرُ فَبِمَ تُبَشِّرُونَ","TajweedText":"قَالَ أَبَشَّرْتُمُونِى عَلَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> أ<tajweed class=idgham_ghunnah>َن م</tajweed>َّسَّنِىَ <tajweed class=ham_wasl>ٱ</tajweed>لْكِبَرُ فَبِمَ تُبَشِّر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٥٤</span>","End":"٥٤","PageNumber":265,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":221,"MaqraNumber":106,"HizbNumber":27,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":55,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالُواْ بَشَّرۡنَٰكَ بِٱلۡحَقِّ فَلَا تَكُن مِّنَ ٱلۡقَٰنِطِينَ","TajweedText":"قَالُو<tajweed class=slnt>اْ</tajweed> بَشَّرْنَ<tajweed class=madda_normal>ـٰ</tajweed>كَ بِ<tajweed class=ham_wasl>ٱ</tajweed>لْحَقِّ فَلَا تَك<tajweed class=idgham_ghunnah>ُن م</tajweed>ِّنَ <tajweed class=ham_wasl>ٱ</tajweed>لْقَ<tajweed class=madda_normal>ـٰ</tajweed>نِط<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٥٥</span>","End":"٥٥","PageNumber":265,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":221,"MaqraNumber":106,"HizbNumber":27,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":56,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَ وَمَن يَقۡنَطُ مِن رَّحۡمَةِ رَبِّهِۦٓ إِلَّا ٱلضَّآلُّونَ","TajweedText":"قَالَ وَم<tajweed class=idgham_ghunnah>َن ي</tajweed>َ<tajweed class=qalaqah>قْ</tajweed>نَطُ م<tajweed class=idgham_wo_ghunnah>ِن ر</tajweed>َّحْمَةِ رَبِّه<tajweed class=madda_obligatory>ِۦٓ</tajweed> إِلَّا <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>ضّ<tajweed class=madda_necessary>َا</tajweed>ٓلّ<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٥٦</span>","End":"٥٦","PageNumber":265,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":221,"MaqraNumber":106,"HizbNumber":27,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":57,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَ فَمَا خَطۡبُكُمۡ أَيُّهَا ٱلۡمُرۡسَلُونَ","TajweedText":"قَالَ فَمَا خَ<tajweed class=qalaqah>طْ</tajweed>بُكُمْ أَيُّهَا <tajweed class=ham_wasl>ٱ</tajweed>لْمُرْسَل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٥٧</span>","End":"٥٧","PageNumber":265,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":221,"MaqraNumber":106,"HizbNumber":27,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":58,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالُوٓاْ إِنَّآ أُرۡسِلۡنَآ إِلَىٰ قَوۡمٖ مُّجۡرِمِينَ","TajweedText":"قَال<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed><tajweed class=madda_obligatory>َآ</tajweed> أُرْسِلْن<tajweed class=madda_obligatory>َآ</tajweed> إِلَىٰ قَوْ<tajweed class=idgham_ghunnah>مٍ م</tajweed>ُّ<tajweed class=qalaqah>جْ</tajweed>رِم<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٥٨</span>","End":"٥٨","PageNumber":265,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":221,"MaqraNumber":106,"HizbNumber":27,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":59,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِلَّآ ءَالَ لُوطٍ إِنَّا لَمُنَجُّوهُمۡ أَجۡمَعِينَ","TajweedText":"إِلّ<tajweed class=madda_obligatory>َآ</tajweed> ءَالَ لُوطٍ إِ<tajweed class=ghunnah>نّ</tajweed>َا لَمُنَجُّوهُمْ أَ<tajweed class=qalaqah>جْ</tajweed>مَع<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٥٩</span>","End":"٥٩","PageNumber":265,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":221,"MaqraNumber":106,"HizbNumber":27,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":60,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِلَّا ٱمۡرَأَتَهُۥ قَدَّرۡنَآ إِنَّهَا لَمِنَ ٱلۡغَٰبِرِينَ","TajweedText":"إِلَّا <tajweed class=ham_wasl>ٱ</tajweed>مْرَأَتَهُ<tajweed class=madda_normal>ۥ</tajweed> قَدَّرْن<tajweed class=madda_obligatory>َآ‌ۙ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َهَا لَمِنَ <tajweed class=ham_wasl>ٱ</tajweed>لْغَ<tajweed class=madda_normal>ـٰ</tajweed>بِر<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٦٠</span>","End":"٦٠","PageNumber":265,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":221,"MaqraNumber":106,"HizbNumber":27,"HizbDecimal":0.25,"HasSajda":false}]}