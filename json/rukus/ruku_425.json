{"RukuNumber":425,"Verses":[{"SurahNumber":43,"SurahIndex":"043","VerseNumber":16,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَمِ ٱتَّخَذَ مِمَّا يَخۡلُقُ بَنَاتٖ وَأَصۡفَىٰكُم بِٱلۡبَنِينَ","TajweedText":"أَمِ <tajweed class=ham_wasl>ٱ</tajweed>تَّخَذَ مِ<tajweed class=ghunnah>مّ</tajweed>َا يَخْلُقُ بَنَا<tajweed class=idgham_ghunnah>تٍ و</tajweed>َأَصْفَ<tajweed class=madda_normal>ـٰ</tajweed>ك<tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِ<tajweed class=ham_wasl>ٱ</tajweed>لْبَن<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٦</span>","End":"١٦","PageNumber":490,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":425,"MaqraNumber":196,"HizbNumber":49,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":17,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِذَا بُشِّرَ أَحَدُهُم بِمَا ضَرَبَ لِلرَّحۡمَٰنِ مَثَلٗا ظَلَّ وَجۡهُهُۥ مُسۡوَدّٗا وَهُوَ كَظِيمٌ","TajweedText":"وَإِذَا بُشِّرَ أَحَدُه<tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِمَا ضَرَبَ لِلرَّحْمَ<tajweed class=madda_normal>ـٰ</tajweed>نِ مَثَل<tajweed class=ikhafa>اً ظ</tajweed>َلَّ وَ<tajweed class=qalaqah>جْ</tajweed>هُهُ<tajweed class=madda_normal>ۥ</tajweed> مُسْوَد<tajweed class=idgham_ghunnah>ًّا و</tajweed>َهُوَ كَظ<tajweed class=madda_permissible>ِي</tajweed>مٌ <span class=end>١٧</span>","End":"١٧","PageNumber":490,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":425,"MaqraNumber":196,"HizbNumber":49,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":18,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَوَمَن يُنَشَّؤُاْ فِي ٱلۡحِلۡيَةِ وَهُوَ فِي ٱلۡخِصَامِ غَيۡرُ مُبِينٖ","TajweedText":"أَوَم<tajweed class=idgham_ghunnah>َن ي</tajweed>ُنَشَّؤُ<tajweed class=slnt>اْ</tajweed> فِى <tajweed class=ham_wasl>ٱ</tajweed>لْحِلْيَةِ وَهُوَ فِى <tajweed class=ham_wasl>ٱ</tajweed>لْخِصَامِ غَيْرُ مُب<tajweed class=madda_permissible>ِي</tajweed>نٍ <span class=end>١٨</span>","End":"١٨","PageNumber":490,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":425,"MaqraNumber":196,"HizbNumber":49,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":19,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَجَعَلُواْ ٱلۡمَلَـٰٓئِكَةَ ٱلَّذِينَ هُمۡ عِبَٰدُ ٱلرَّحۡمَٰنِ إِنَٰثًاۚ أَشَهِدُواْ خَلۡقَهُمۡۚ سَتُكۡتَبُ شَهَٰدَتُهُمۡ وَيُسۡـَٔلُونَ","TajweedText":"وَجَعَلُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed>لْمَلَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ئِكَةَ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ هُمْ عِبَ<tajweed class=madda_normal>ـٰ</tajweed>دُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رَّحْمَ<tajweed class=madda_normal>ـٰ</tajweed>نِ إِنَ<tajweed class=madda_normal>ـٰ</tajweed>ثًا‌ۚ أَشَهِدُو<tajweed class=slnt>اْ</tajweed> خَلْقَهُمْ‌ۚ سَتُكْتَبُ شَهَ<tajweed class=madda_normal>ـٰ</tajweed>دَتُهُمْ وَيُسْــَٔل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٩</span>","End":"١٩","PageNumber":490,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":425,"MaqraNumber":196,"HizbNumber":49,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":20,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَقَالُواْ لَوۡ شَآءَ ٱلرَّحۡمَٰنُ مَا عَبَدۡنَٰهُمۗ مَّا لَهُم بِذَٰلِكَ مِنۡ عِلۡمٍۖ إِنۡ هُمۡ إِلَّا يَخۡرُصُونَ","TajweedText":"وَقَالُو<tajweed class=slnt>اْ</tajweed> لَوْ ش<tajweed class=madda_obligatory>َا</tajweed>ٓءَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رَّحْمَ<tajweed class=madda_normal>ـٰ</tajweed>نُ مَا عَبَ<tajweed class=qalaqah>دْ</tajweed>نَ<tajweed class=madda_normal>ـٰ</tajweed>ه<tajweed class=idgham_shafawi>ُم‌ۗ م</tajweed>َّا لَه<tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ مِنْ عِلْمٍ‌ۖ إِنْ هُمْ إِلَّا يَخْرُص<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٠</span>","End":"٢٠","PageNumber":490,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":425,"MaqraNumber":196,"HizbNumber":49,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":21,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَمۡ ءَاتَيۡنَٰهُمۡ كِتَٰبٗا مِّن قَبۡلِهِۦ فَهُم بِهِۦ مُسۡتَمۡسِكُونَ","TajweedText":"أَمْ ءَاتَيْنَ<tajweed class=madda_normal>ـٰ</tajweed>هُمْ كِتَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>بًا م</tajweed>ِّ<tajweed class=ikhafa>ن ق</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>لِه<tajweed class=madda_normal>ِۦ</tajweed> فَه<tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِه<tajweed class=madda_normal>ِۦ</tajweed> مُسْتَمْسِك<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢١</span>","End":"٢١","PageNumber":490,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":425,"MaqraNumber":196,"HizbNumber":49,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":22,"ShowSurahName":false,"ShowBismillah":false,"Text":"بَلۡ قَالُوٓاْ إِنَّا وَجَدۡنَآ ءَابَآءَنَا عَلَىٰٓ أُمَّةٖ وَإِنَّا عَلَىٰٓ ءَاثَٰرِهِم مُّهۡتَدُونَ","TajweedText":"بَلْ قَال<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َا وَجَ<tajweed class=qalaqah>دْ</tajweed>ن<tajweed class=madda_obligatory>َآ</tajweed> ءَاب<tajweed class=madda_obligatory>َا</tajweed>ٓءَنَا عَلَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> أُ<tajweed class=ghunnah>مّ</tajweed>َ<tajweed class=idgham_ghunnah>ةٍ و</tajweed>َإِ<tajweed class=ghunnah>نّ</tajweed>َا عَلَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> ءَاثَ<tajweed class=madda_normal>ـٰ</tajweed>رِه<tajweed class=idgham_shafawi>ِم م</tajweed>ُّهْتَد<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٢</span>","End":"٢٢","PageNumber":490,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":425,"MaqraNumber":196,"HizbNumber":49,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":23,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَكَذَٰلِكَ مَآ أَرۡسَلۡنَا مِن قَبۡلِكَ فِي قَرۡيَةٖ مِّن نَّذِيرٍ إِلَّا قَالَ مُتۡرَفُوهَآ إِنَّا وَجَدۡنَآ ءَابَآءَنَا عَلَىٰٓ أُمَّةٖ وَإِنَّا عَلَىٰٓ ءَاثَٰرِهِم مُّقۡتَدُونَ","TajweedText":"وَكَذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ م<tajweed class=madda_obligatory>َآ</tajweed> أَرْسَلْنَا مِ<tajweed class=ikhafa>ن ق</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>لِكَ فِى قَرْيَ<tajweed class=idgham_ghunnah>ةٍ م</tajweed>ّ<tajweed class=idgham_ghunnah>ِن ن</tajweed>َّذِيرٍ إِلَّا قَالَ مُتْرَفُوه<tajweed class=madda_obligatory>َآ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َا وَجَ<tajweed class=qalaqah>دْ</tajweed>ن<tajweed class=madda_obligatory>َآ</tajweed> ءَاب<tajweed class=madda_obligatory>َا</tajweed>ٓءَنَا عَلَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> أُ<tajweed class=ghunnah>مّ</tajweed>َ<tajweed class=idgham_ghunnah>ةٍ و</tajweed>َإِ<tajweed class=ghunnah>نّ</tajweed>َا عَلَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> ءَاثَ<tajweed class=madda_normal>ـٰ</tajweed>رِه<tajweed class=idgham_shafawi>ِم م</tajweed>ُّ<tajweed class=qalaqah>قْ</tajweed>تَد<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٣</span>","End":"٢٣","PageNumber":491,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":425,"MaqraNumber":196,"HizbNumber":49,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":24,"ShowSurahName":false,"ShowBismillah":false,"Text":"۞قَٰلَ أَوَلَوۡ جِئۡتُكُم بِأَهۡدَىٰ مِمَّا وَجَدتُّمۡ عَلَيۡهِ ءَابَآءَكُمۡۖ قَالُوٓاْ إِنَّا بِمَآ أُرۡسِلۡتُم بِهِۦ كَٰفِرُونَ","TajweedText":"۞ قَ<tajweed class=madda_normal>ـٰ</tajweed>لَ أَوَلَوْ جِئْتُك<tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِأَهْدَىٰ مِ<tajweed class=ghunnah>مّ</tajweed>َا وَجَ<tajweed class=idgham_mutajanisayn>د</tajweed>تُّمْ عَلَيْهِ ءَاب<tajweed class=madda_obligatory>َا</tajweed>ٓءَكُمْ‌ۖ قَال<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َا بِم<tajweed 