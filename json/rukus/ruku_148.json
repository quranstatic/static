{"RukuNumber":148,"Verses":[{"SurahNumber":8,"SurahIndex":"008","VerseNumber":20,"ShowSurahName":false,"ShowBismillah":false,"Text":"يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓاْ أَطِيعُواْ ٱللَّهَ وَرَسُولَهُۥ وَلَا تَوَلَّوۡاْ عَنۡهُ وَأَنتُمۡ تَسۡمَعُونَ","TajweedText":"يَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>أَيُّهَا <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ ءَامَن<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> أَطِيعُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed>للَّهَ وَرَسُولَهُ<tajweed class=madda_normal>ۥ</tajweed> وَلَا تَوَلَّوْ<tajweed class=slnt>اْ</tajweed> عَنْهُ وَأَ<tajweed class=ikhafa>نت</tajweed>ُمْ تَسْمَع<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٠</span>","End":"٢٠","PageNumber":179,"JuzNumber":9,"ManzilNumber":2,"RukuNumber":148,"MaqraNumber":71,"HizbNumber":18,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":8,"SurahIndex":"008","VerseNumber":21,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَا تَكُونُواْ كَٱلَّذِينَ قَالُواْ سَمِعۡنَا وَهُمۡ لَا يَسۡمَعُونَ","TajweedText":"وَلَا تَكُونُو<tajweed class=slnt>اْ</tajweed> كَ<tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ قَالُو<tajweed class=slnt>اْ</tajweed> سَمِعْنَا وَهُمْ لَا يَسْمَع<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢١</span>","End":"٢١","PageNumber":179,"JuzNumber":9,"ManzilNumber":2,"RukuNumber":148,"MaqraNumber":71,"HizbNumber":18,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":8,"SurahIndex":"008","VerseNumber":22,"ShowSurahName":false,"ShowBismillah":false,"Text":"۞إِنَّ شَرَّ ٱلدَّوَآبِّ عِندَ ٱللَّهِ ٱلصُّمُّ ٱلۡبُكۡمُ ٱلَّذِينَ لَا يَعۡقِلُونَ","TajweedText":"۞ إِ<tajweed class=ghunnah>نّ</tajweed>َ شَرَّ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>دَّو<tajweed class=madda_necessary>َا</tajweed>ٓبِّ عِ<tajweed class=ikhafa>ند</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsi