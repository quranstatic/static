 class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_obligatory>ۥٓ</tajweed> إِلَيْهِ تُحْشَر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٤</span>","End":"٢٤","PageNumber":179,"JuzNumber":9,"ManzilNumber":2,"RukuNumber":148,"MaqraNumber":72,"HizbNumber":18,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":8,"SurahIndex":"008","VerseNumber":25,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَٱتَّقُواْ فِتۡنَةٗ لَّا تُصِيبَنَّ ٱلَّذِينَ ظَلَمُواْ مِنكُمۡ خَآصَّةٗۖ وَٱعۡلَمُوٓاْ أَنَّ ٱللَّهَ شَدِيدُ ٱلۡعِقَابِ","TajweedText":"وَ<tajweed class=ham_wasl>ٱ</tajweed>تَّقُو<tajweed class=slnt>اْ</tajweed> فِتْنَ<tajweed class=idgham_wo_ghunnah>ةً ل</tajweed>َّا تُصِيبَ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ ظَلَمُو<tajweed class=slnt>اْ</tajweed> مِ<tajweed class=ikhafa>نك</tajweed>ُمْ خ<tajweed class=madda_necessary>َا</tajweed>ٓصَّ<tajweed class=idgham_ghunnah>ةً‌ۖ و</tajweed>َ<tajweed class=ham_wasl>ٱ</tajweed>عْلَم<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> أَ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>للَّهَ شَدِيدُ <tajweed class=ham_wasl>ٱ</tajweed>لْعِق<tajweed class=madda_permissible>َا</tajweed><tajweed class=qalaqah>ب</tajweed>ِ <span class=end>٢٥</span>","End":"٢٥","PageNumber":179,"JuzNumber":9,"ManzilNumber":2,"RukuNumber":148,"MaqraNumber":72,"HizbNumber":18,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":8,"SurahIndex":"008","VerseNumber":26,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَٱذۡكُرُوٓاْ إِذۡ أَنتُمۡ قَلِيلٞ مُّسۡتَضۡعَفُونَ فِي ٱلۡأَرۡضِ تَخَافُونَ أَن يَتَخَطَّفَكُمُ ٱلنَّاسُ فَـَٔاوَىٰكُمۡ وَأَيَّدَكُم بِنَصۡرِهِۦ وَرَزَقَكُم مِّنَ ٱلطَّيِّبَٰتِ لَعَلَّكُمۡ تَشۡكُرُونَ","TajweedText":"وَ<tajweed class=ham_wasl>ٱ</tajweed>ذْكُر<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> إِذْ أَ<tajweed class=ikhafa>نت</tajweed>ُمْ قَلِي<tajweed class=idgham_ghunnah>لٌ م</tajweed>ُّسْتَضْعَ