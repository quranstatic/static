{"RukuNumber":219,"Verses":[{"SurahNumber":15,"SurahIndex":"015","VerseNumber":16,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَقَدۡ جَعَلۡنَا فِي ٱلسَّمَآءِ بُرُوجٗا وَزَيَّنَّـٰهَا لِلنَّـٰظِرِينَ","TajweedText":"وَلَقَ<tajweed class=qalaqah>دْ</tajweed> جَعَلْنَا فِى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّم<tajweed class=madda_obligatory>َا</tajweed>ٓءِ بُرُو<tajweed class=idgham_ghunnah>جًا و</tajweed>َزَيَّ<tajweed class=ghunnah>نّ</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed>هَا لِل<tajweed class=ghunnah>نّ</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed>ظِر<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٦</span>","End":"١٦","PageNumber":263,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":219,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":17,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَحَفِظۡنَٰهَا مِن كُلِّ شَيۡطَٰنٖ رَّجِيمٍ","TajweedText":"وَحَفِظْنَ<tajweed class=madda_normal>ـٰ</tajweed>هَا مِ<tajweed class=ikhafa>ن ك</tajweed>ُلِّ شَيْطَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_wo_ghunnah>نٍ ر</tajweed>َّج<tajweed class=madda_permissible>ِي</tajweed>مٍ <span class=end>١٧</span>","End":"١٧","PageNumber":263,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":219,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":18,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِلَّا مَنِ ٱسۡتَرَقَ ٱلسَّمۡعَ فَأَتۡبَعَهُۥ شِهَابٞ مُّبِينٞ","TajweedText":"إِلَّا مَنِ <tajweed class=ham_wasl>ٱ</tajweed>سْتَرَقَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّمْعَ فَأَتْبَعَهُ<tajweed class=madda_normal>ۥ</tajweed> شِهَا<tajweed class=idgham_ghunnah>بٌ م</tajweed>ُّب<tajweed class=madda_permissible>ِي</tajweed>نٌ <span class=end>١٨</span>","End":"١٨","PageNumber":263,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":219,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":19,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَٱلۡأَرۡضَ مَدَدۡنَٰهَا وَأَلۡقَيۡنَا فِيهَا رَوَٰسِيَ وَأَنۢبَتۡنَا فِيهَا مِن كُلِّ شَيۡءٖ مَّوۡزُونٖ","TajweedText":"وَ<tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضَ مَدَ<tajweed class=qalaqah>دْ</tajweed>نَ<tajweed class=madda_normal>ـٰ</tajweed>هَا وَأَلْقَيْنَا فِيهَا رَو<tajweed class=madda_normal>َٲ</tajweed>سِىَ وَأَ<tajweed class=iqlab>نۢب</tajweed>َتْنَا فِيهَا مِ<tajweed class=ikhafa>ن ك</tajweed>ُلِّ ش<tajweed class=idgham_ghunnah>َىْءٍ م</tajweed>َّوْز<tajweed class=madda_permissible>ُو</tajweed>نٍ <span class=end>١٩</span>","End":"١٩","PageNumber":263,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":219,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":20,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَجَعَلۡنَا لَكُمۡ فِيهَا مَعَٰيِشَ وَمَن لَّسۡتُمۡ لَهُۥ بِرَٰزِقِينَ","TajweedText":"وَجَعَلْنَا لَكُمْ فِيهَا مَعَ<tajweed class=madda_normal>ـٰ</tajweed>يِشَ وَم<tajweed class=idgham_wo_ghunnah>َن ل</tajweed>َّسْتُمْ لَهُ<tajweed class=madda_normal>ۥ</tajweed> بِر<tajweed class=madda_normal>َٲ</tajweed>زِق<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٢٠</span>","End":"٢٠","PageNumber":263,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":219,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":21,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِن مِّن شَيۡءٍ إِلَّا عِندَنَا خَزَآئِنُهُۥ وَمَا نُنَزِّلُهُۥٓ إِلَّا بِقَدَرٖ مَّعۡلُومٖ","TajweedText":"وَإ<tajweed class=idgham_ghunnah>ِن م</tajweed>ِّ<tajweed class=ikhafa>ن ش</tajweed>َىْءٍ إِلَّا عِ<tajweed class=ikhafa>ند</tajweed>َنَا خَز<tajweed class=madda_obligatory>َا</tajweed>ٓئِنُهُ<tajweed class=madda_normal>ۥ</tajweed> وَمَا نُنَزِّلُهُ<tajweed class=madda_obligatory>ۥٓ</tajweed> إِلَّا بِقَدَ<tajweed class=idgham_ghunnah>رٍ م</tajweed>َّعْل<tajweed class=madda_permissible>ُو</tajweed>مٍ <span class=end>٢١</span>","End":"٢١","PageNumber":263,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":219,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":22,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَأَرۡسَلۡنَا ٱلرِّيَٰحَ لَوَٰقِحَ فَأَنزَلۡنَا مِنَ ٱلسَّمَآءِ مَآءٗ فَأَسۡقَيۡنَٰكُمُوهُ وَمَآ أَنتُمۡ لَهُۥ بِخَٰزِنِينَ","TajweedText":"وَأَرْسَلْنَا <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رِّيَ<tajweed class=madda_normal>ـٰ</tajweed>حَ لَو<tajweed class=madda_normal>َٲ</tajweed>قِحَ فَأَ<tajweed class=ikhafa>نز</tajweed>َلْنَا مِنَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّم<tajweed class=madda_obligatory>َا</tajweed>ٓءِ م<tajweed class=madda_obligatory>َا</tajweed>ٓ<tajweed class=ikhafa>ءً ف</tajweed>َأَسْقَيْنَ<tajweed class=madda_normal>ـٰ</tajweed>كُمُوهُ وَم<tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=ikhafa>نت</tajweed>ُمْ لَهُ<tajweed class=madda_normal>ۥ</tajweed> بِخَ<tajweed class=madda_normal>ـٰ</tajweed>زِن<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٢٢</span>","End":"٢٢","PageNumber":263,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":219,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":23,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِنَّا لَنَحۡنُ نُحۡيِۦ وَنُمِيتُ وَنَحۡنُ ٱلۡوَٰرِثُونَ","TajweedText":"وَإِ<tajweed class=ghunnah>نّ</tajweed>َا لَنَحْنُ نُحْى<tajweed class=madda_normal>ِۦ</tajweed> وَنُمِيتُ وَنَحْنُ <tajweed class=ham_wasl>ٱ</tajweed>لْو<tajweed class=madda_normal>َٲ</tajweed>رِث<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٣</span>","End":"٢٣","PageNumber":263,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":219,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":24,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَقَدۡ عَلِمۡنَا ٱلۡمُسۡتَقۡدِمِينَ مِنكُمۡ وَلَقَدۡ عَلِمۡنَا ٱلۡمُسۡتَـٔۡخِرِينَ","TajweedText":"وَلَقَ<tajweed class=qalaqah>دْ</tajweed> عَلِمْنَا <tajweed class=ham_wasl>ٱ</tajweed>لْمُسْتَ<tajweed class=qalaqah>قْ</tajweed>دِمِينَ مِ<tajweed class=ikhafa>نك</tajweed>ُمْ وَلَقَ<tajweed class=qalaqah>دْ</tajweed> عَلِمْنَا <tajweed class=ham_wasl>ٱ</tajweed>لْمُسْتَــْٔخِر<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٢٤</span>","End":"٢٤","PageNumber":263,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":219,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":25,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِنَّ رَبَّكَ هُوَ يَحۡشُرُهُمۡۚ إِنَّهُۥ حَكِيمٌ عَلِيمٞ","TajweedText":"وَإِ<tajweed class=ghunnah>نّ</tajweed>َ رَبَّكَ هُوَ يَحْشُرُهُمْ‌ۚ إِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> حَكِيمٌ عَل<tajweed class=madda_permissible>ِي</tajweed>مٌ <span class=end>٢٥</span>","End":"٢٥","PageNumber":263,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":219,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false}]}