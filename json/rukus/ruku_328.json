َ عَنۡهُمۡ فَٱنظُرۡ مَاذَا يَرۡجِعُونَ","TajweedText":"ٱذْهَب بِّكِتَ<tajweed class=madda_normal>ـٰ</tajweed>بِى هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا فَأَلْقِهْ إِلَيْهِمْ ثُ<tajweed class=ghunnah>مّ</tajweed>َ تَوَلَّ عَنْهُمْ فَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=ikhafa>نظ</tajweed>ُرْ مَاذَا يَرْجِع<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٨</span>","End":"٢٨","PageNumber":379,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":328,"MaqraNumber":152,"HizbNumber":38,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":29,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَتۡ يَـٰٓأَيُّهَا ٱلۡمَلَؤُاْ إِنِّيٓ أُلۡقِيَ إِلَيَّ كِتَٰبٞ كَرِيمٌ","TajweedText":"قَالَتْ يَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>أَيُّهَا <tajweed class=ham_wasl>ٱ</tajweed>لْمَلَؤُ<tajweed class=slnt>اْ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed><tajweed class=madda_obligatory>ِىٓ</tajweed> أُلْقِىَ إِلَىَّ كِتَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=ikhafa>بٌ ك</tajweed>َر<tajweed class=madda_permissible>ِي</tajweed>مٌ <span class=end>٢٩</span>","End":"٢٩","PageNumber":379,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":328,"MaqraNumber":152,"HizbNumber":38,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":30,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّهُۥ مِن سُلَيۡمَٰنَ وَإِنَّهُۥ بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> مِ<tajweed class=ikhafa>ن س</tajweed>ُلَيْمَ<tajweed class=madda_normal>ـٰ</tajweed>نَ وَإِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> بِسْمِ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رَّحْمَ<tajweed class=madda_normal>ـٰ</tajweed>نِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رَّح<tajweed class=madda_permissible>ِي</tajweed>مِ <span class=end>٣٠</span>","End":"٣٠","PageNumber":379,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":328,"MaqraNumber":152,"HizbNumber":38,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":31,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَلَّا تَعۡلُواْ عَلَيَّ وَأۡتُونِي مُسۡلِمِينَ","TajweedText":"أَلَّا تَعْلُو<tajweed class=slnt>اْ</tajweed> عَلَىَّ وَأْتُونِى مُسْلِم<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٣١</span>","End":"٣١","PageNumber":379,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":328,"MaqraNumber":152,"HizbNumber":38,"HizbDecimal":0.75,"HasSajda":false}]}