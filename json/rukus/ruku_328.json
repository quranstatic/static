er":23,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنِّي وَجَدتُّ ٱمۡرَأَةٗ تَمۡلِكُهُمۡ وَأُوتِيَتۡ مِن كُلِّ شَيۡءٖ وَلَهَا عَرۡشٌ عَظِيمٞ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>ِى وَجَ<tajweed class=idgham_mutajanisayn>د</tajweed>تُّ <tajweed class=ham_wasl>ٱ</tajweed>مْرَأَ<tajweed class=ikhafa>ةً ت</tajweed>َمْلِكُهُمْ وَأُوتِيَتْ مِ<tajweed class=ikhafa>ن ك</tajweed>ُلِّ ش<tajweed class=idgham_ghunnah>َىْءٍ و</tajweed>َلَهَا عَرْشٌ عَظ<tajweed class=madda_permissible>ِي</tajweed>مٌ <span class=end>٢٣</span>","End":"٢٣","PageNumber":379,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":328,"MaqraNumber":151,"HizbNumber":38,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":24,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَجَدتُّهَا وَقَوۡمَهَا يَسۡجُدُونَ لِلشَّمۡسِ مِن دُونِ ٱللَّهِ وَزَيَّنَ لَهُمُ ٱلشَّيۡطَٰنُ أَعۡمَٰلَهُمۡ فَصَدَّهُمۡ عَنِ ٱلسَّبِيلِ فَهُمۡ لَا يَهۡتَدُونَ","TajweedText":"وَجَ<tajweed class=idgham_mutajanisayn>د</tajweed>تُّهَا وَقَوْمَهَا يَسْجُدُونَ لِلشَّمْسِ مِ<tajweed class=ikhafa>ن د</tajweed>ُونِ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ وَزَيَّنَ لَهُمُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>شَّيْطَ<tajweed class=madda_normal>ـٰ</tajweed>نُ أَعْمَ<tajweed class=madda_normal>ـٰ</tajweed>لَهُمْ فَصَدَّهُمْ عَنِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّبِيلِ فَهُمْ لَا يَهْتَد<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٤</span>","End":"٢٤","PageNumber":379,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":328,"MaqraNumber":151,"HizbNumber":38,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":25,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَلَّاۤ يَسۡجُدُواْۤ لِلَّهِ ٱلَّذِي يُخۡرِجُ ٱلۡخَبۡءَ فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَيَعۡلَمُ مَا تُخۡفُونَ وَمَا تُعۡلِنُونَ","TajweedText":"أَلَّا يَسْجُدُو<tajweed class=slnt>اْ</tajweed> لِلَّهِ <tajwe