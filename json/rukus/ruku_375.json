{"RukuNumber":375,"Verses":[{"SurahNumber":34,"SurahIndex":"034","VerseNumber":46,"ShowSurahName":false,"ShowBismillah":false,"Text":"۞قُلۡ إِنَّمَآ أَعِظُكُم بِوَٰحِدَةٍۖ أَن تَقُومُواْ لِلَّهِ مَثۡنَىٰ وَفُرَٰدَىٰ ثُمَّ تَتَفَكَّرُواْۚ مَا بِصَاحِبِكُم مِّن جِنَّةٍۚ إِنۡ هُوَ إِلَّا نَذِيرٞ لَّكُم بَيۡنَ يَدَيۡ عَذَابٖ شَدِيدٖ","TajweedText":"۞ قُلْ إِ<tajweed class=ghunnah>نّ</tajweed>َم<tajweed class=madda_obligatory>َآ</tajweed> أَعِظُك<tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِو<tajweed class=madda_normal>َٲ</tajweed>حِدَةٍۖ أَ<tajweed class=ikhafa>ن ت</tajweed>َقُومُو<tajweed class=slnt>اْ</tajweed> لِلَّهِ مَثْنَىٰ وَفُر<tajweed class=madda_normal>َٲ</tajweed>دَىٰ ثُ<tajweed class=ghunnah>مّ</tajweed>َ تَتَفَكَّرُو<tajweed class=slnt>اْۚ</tajweed> مَا بِصَاحِبِك<tajweed class=idgham_shafawi>ُم م</tajweed>ِّ<tajweed class=ikhafa>ن ج</tajweed>ِ<tajweed class=ghunnah>نّ</tajweed>َةٍۚ إِنْ هُوَ إِلَّا نَذِي<tajweed class=idgham_wo_ghunnah>رٌ ل</tajweed>َّك<tajweed class=ikhafa_shafawi>ُم ب</tajweed>َيْنَ يَدَىْ عَذَا<tajweed class=ikhafa>بٍ ش</tajweed>َد<tajweed class=madda_permissible>ِي</tajweed><tajweed class=qalaqah>د</tajweed>ٍ <span class=end>٤٦</span>","End":"٤٦","PageNumber":433,"JuzNumber":22,"ManzilNumber":5,"RukuNumber":375,"MaqraNumber":174,"HizbNumber":44,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":34,"SurahIndex":"034","VerseNumber":47,"ShowSurahName":false,"ShowBismillah":false,"Text":"قُلۡ مَا سَأَلۡتُكُم مِّنۡ أَجۡرٖ فَهُوَ لَكُمۡۖ إِنۡ أَجۡرِيَ إِلَّا عَلَى ٱللَّهِۖ وَهُوَ عَلَىٰ كُلِّ شَيۡءٖ شَهِيدٞ","TajweedText":"قُلْ مَا سَأَلْتُك<tajweed class=idgham_shafawi>ُم م</tajweed>ِّنْ أَ<tajweed class=qalaqah>جْ</tajweed><tajweed class=ikhafa>رٍ ف</tajweed>َهُوَ لَكُمْۖ إِنْ أَ<tajweed class=qalaqah>جْ</tajweed>رِىَ إِلَّا عَلَى <tajweed class=ham_wasl>ٱ</tajweed>للَّهِۖ وَهُوَ عَلَىٰ كُلِّ ش<tajweed class=ikhafa>َىْءٍ ش</tajweed>َه<tajweed class=madda_permissible>ِي</tajweed><tajweed class=qalaqah>د</tajweed>ٌ <span class=end>٤٧</span>","End":"٤٧","PageNumber":433,"JuzNumber":22,"ManzilNumber":5,"RukuNumber":375,"MaqraNumber":174,"HizbNumber":44,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":34,"SurahIndex":"034","VerseNumber":48,"ShowSurahName":false,"ShowBismillah":false,"Text":"قُلۡ إِنَّ رَبِّي يَقۡذِفُ بِٱلۡحَقِّ عَلَّـٰمُ ٱلۡغُيُوبِ","TajweedText":"قُلْ إِ<tajweed class=ghunnah>نّ</tajweed>َ رَبِّى يَ<tajweed class=qalaqah>قْ</tajweed>ذِفُ بِ<tajweed class=ham_wasl>ٱ</tajweed>لْحَقِّ عَلَّ<tajweed class=madda_normal>ـٰ</tajweed>مُ <tajweed class=ham_wasl>ٱ</tajweed>لْغُي<tajweed class=madda_permissible>ُو</tajweed><tajweed class=qalaqah>ب</tajweed>ِ <span class=end>٤٨</span>","End":"٤٨","PageNumber":433,"JuzNumber":22,"ManzilNumber":5,"RukuNumber":375,"MaqraNumber":174,"HizbNumber":44,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":34,"SurahIndex":"034","VerseNumber":49,"ShowSurahName":false,"ShowBismillah":false,"Text":"قُلۡ جَآءَ ٱلۡحَقُّ وَمَا يُبۡدِئُ ٱلۡبَٰطِلُ وَمَا يُعِيدُ","TajweedText":"قُلْ ج<tajweed class=madda_obligatory>َا</tajweed>ٓءَ <tajweed class=ham_wasl>ٱ</tajweed>لْحَقُّ وَمَا يُ<tajweed class=qalaqah>بْ</tajweed>دِئُ <tajweed class=ham_wasl>ٱ</tajweed>لْبَ<tajweed class=madda_normal>ـٰ</tajweed>طِلُ وَمَا يُع<tajweed class=madda_permissible>ِي</tajweed><tajweed class=qalaqah>د</tajweed>ُ <span class=end>٤٩</span>","End":"٤٩","PageNumber":434,"JuzNumber":22,"ManzilNumber":5,"RukuNumber":375,"MaqraNumber":174,"HizbNumber":44,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":34,"SurahIndex":"034","VerseNumber":50,"ShowSurahName":false,"ShowBismillah":false,"Text":"قُلۡ إِن ضَلَلۡتُ فَإِنَّمَآ أَضِلُّ عَلَىٰ نَفۡسِيۖ وَإِنِ ٱهۡتَدَيۡتُ فَبِمَا يُوحِيٓ إِلَيَّ رَبِّيٓۚ إِنَّهُۥ سَمِيعٞ قَرِيبٞ","TajweedText":"قُلْ إِ<tajweed class=ikhafa>ن ض</tajweed>َلَلْتُ فَإِ<tajweed class=ghunnah>نّ</tajweed>َم<tajweed class=madda_obligatory>َآ</tajweed> أَضِلُّ عَلَىٰ نَفْسِىۖ وَإِنِ <tajweed class=ham_wasl>ٱ</tajweed>هْتَدَيْتُ فَبِمَا يُوح<tajweed class=madda_obligatory>ِىٓ</tajweed> إِلَىَّ رَبّ<tajweed class=madda_obligatory>ِىٓۚ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> سَمِي<tajweed class=ikhafa>عٌ ق</tajweed>َر<tajweed class=madda_permissible>ِي</tajweed><tajweed class=qalaqah>ب</tajweed>ٌ <span class=end>٥٠</span>","End":"٥٠","PageNumber":434,"JuzNumber":22,"ManzilNumber":5,"RukuNumber":375,"MaqraNumber":174,"HizbNumber":44,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":34,"SurahIndex":"034","VerseNumber":51,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَوۡ تَرَىٰٓ إِذۡ فَزِعُواْ فَلَا فَوۡتَ وَأُخِذُواْ مِن مَّكَانٖ قَرِيبٖ","TajweedText":"وَلَوْ تَرَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> إِذْ فَزِعُو<tajweed class=slnt>اْ</tajweed> فَلَا فَوْتَ وَأُخِذُو<tajweed class=slnt>اْ</tajweed> م<tajweed class=idgham_ghunnah>ِن م</tajweed>َّكَا<tajweed class=ikhafa>نٍ ق</tajweed>َر<tajweed class=madda_permissible>ِي</tajweed><tajweed class=qalaqah>ب</tajweed>ٍ <span class=end>٥١</span>","End":"٥١","PageNumber":434,"JuzNumber":22,"ManzilNumber":5,"RukuNumber":375,"MaqraNumber":174,"HizbNumber":44,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":34,"SurahIndex":"034","VerseNumber":52,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَقَالُوٓاْ ءَامَنَّا بِهِۦ وَأَنَّىٰ لَهُمُ ٱلتَّنَاوُشُ مِن مَّكَانِۭ بَعِيدٖ","TajweedText":"وَقَال<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> ءَامَ<tajweed class=ghunnah>نّ</tajweed>َا بِه<tajweed class=madda_normal>ِۦ</tajweed> وَأَ<tajweed class=ghunnah>نّ</tajweed>َىٰ لَهُمُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>تَّنَاوُشُ م<tajweed class=idgham_ghunnah>ِن م</tajweed>َّكَا<tajweed class=iqlab>نِۭ ب</tajweed>َع<tajweed class=madda_permissible>ِي</tajweed><tajweed class=qalaqah>د</tajweed>ٍ <span class=end>٥٢</span>","End":"٥٢","PageNumber":434,"JuzNumber":22,"ManzilNumber":5,"RukuNumber":375,"MaqraNumber":174,"HizbNumber":44,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":34,"SurahIndex":"034","VerseNumber":53,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَقَدۡ كَفَرُواْ بِهِۦ مِن قَبۡلُۖ وَيَقۡذِفُونَ بِٱلۡغَيۡبِ مِن مَّكَانِۭ بَعِيدٖ","TajweedText":"وَقَ<tajweed class=qalaqah>دْ</tajweed> كَفَرُو<tajweed class=slnt>اْ</tajweed> بِه<tajweed class=madda_normal>ِۦ</tajweed> مِ<tajweed class=ikhafa>ن ق</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>لُۖ وَيَ<tajweed class=qalaqah>قْ</tajweed>ذِفُونَ بِ<tajweed class=ham_wasl>ٱ</tajweed>لْغَيْبِ م<tajweed class=idgham_ghunnah>ِن م</tajweed>َّكَا<tajweed class=iqlab>نِۭ ب</tajweed>َع<tajweed class=madda_permissible>ِي</tajweed><tajweed class=qalaqah>د</tajweed>ٍ <span class=end>٥٣</span>","End":"٥٣","PageNumber":434,"JuzNumber":22,"ManzilNumber":5,"RukuNumber":375,"MaqraNumber":174,"HizbNumber":44,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":34,"SurahIndex":"034","VerseNumber":54,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَحِيلَ بَيۡنَهُمۡ وَبَيۡنَ مَا يَشۡتَهُونَ كَمَا فُعِلَ بِأَشۡيَاعِهِم مِّن قَبۡلُۚ إِنَّهُمۡ كَانُواْ فِي شَكّٖ مُّرِيبِۭ","TajweedText":"وَحِيلَ بَيْنَهُمْ وَبَيْنَ مَا يَشْتَهُونَ كَمَا فُعِلَ بِأَشْيَاعِه<tajweed class=idgham_shafawi>ِم م</tajweed>ِّ<tajweed class=ikhafa>ن ق</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>لُۚ إِ<tajweed class=ghunnah>نّ</tajweed>َهُمْ كَانُو<tajweed class=slnt>اْ</tajweed> فِى شَ<tajweed class=idgham_ghunnah>كٍّ م</tajweed>ُّر<tajweed class=madda_permissible>ِي</tajweed><tajweed class=qalaqah>ب</tajweed>ِۭ <span class=end>٥٤</span>","End":"٥٤","PageNumber":434,"JuzNumber":22,"ManzilNumber":5,"RukuNumber":375,"MaqraNumber":174,"HizbNumber":44,"HizbDecimal":0.25,"HasSajda":false}]}