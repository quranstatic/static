obligatory>َا</tajweed>ٓئِكَ رَبِّ شَقِيًّا <span class=end>٤</span>","End":"٤","PageNumber":305,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":264,"MaqraNumber":122,"HizbNumber":31,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":19,"SurahIndex":"019","VerseNumber":5,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِنِّي خِفۡتُ ٱلۡمَوَٰلِيَ مِن وَرَآءِي وَكَانَتِ ٱمۡرَأَتِي عَاقِرٗا فَهَبۡ لِي مِن لَّدُنكَ وَلِيّٗا","TajweedText":"وَإِ<tajweed class=ghunnah>نّ</tajweed>ِى خِفْتُ <tajweed class=ham_wasl>ٱ</tajweed>لْمَو<tajweed class=madda_normal>َٲ</tajweed>لِىَ م<tajweed class=idgham_ghunnah>ِن و</tajweed>َر<tajweed class=madda_obligatory>َا</tajweed>ٓءِى وَكَانَتِ <tajweed class=ham_wasl>ٱ</tajweed>مْرَأَتِى عَاقِ<tajweed class=ikhafa>رًا ف</tajweed>َهَ<tajweed class=qalaqah>بْ</tajweed> لِى م<tajweed class=idgham_wo_ghunnah>ِن ل</tajweed>َّدُ<tajweed class=ikhafa>نك</tajweed>َ وَلِيًّا <span class=end>٥</span>","End":"٥","PageNumber":305,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":264,"MaqraNumber":122,"HizbNumber":31,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":19,"SurahIndex":"019","VerseNumber":6,"ShowSurahName":false,"ShowBismillah":false,"Text":"يَرِثُنِي وَيَرِثُ مِنۡ ءَالِ يَعۡقُوبَۖ وَٱجۡعَلۡهُ رَبِّ رَضِيّٗا","TajweedText":"يَرِثُنِى وَيَرِثُ مِنْ ءَالِ يَعْقُوبَ‌ۖ وَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=qalaqah>جْ</tajweed>عَلْهُ رَبِّ رَضِيًّا <span class=end>٦</span>","End":"٦","PageNumber":305,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":264,"MaqraNumber":122,"HizbNumber":31,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":19,"SurahIndex":"019","VerseNumber":7,"ShowSurahName":false,"ShowBismillah":false,"Text":"يَٰزَكَرِيَّآ إِنَّا نُبَشِّرُكَ بِغُلَٰمٍ ٱسۡمُهُۥ يَحۡيَىٰ لَمۡ نَجۡعَل لَّهُۥ مِن قَبۡلُ سَمِيّٗا","TajweedText":"يَ<tajweed class=madda_normal>ـٰ</tajweed>زَكَرِيّ<tajweed class=madda_obligatory>َآ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َا نُبَشِّرُكَ بِغُلَ<tajweed class=madda_normal>ـٰ</tajweed>مٍ <tajweed class=ham_wasl>ٱ</tajweed>سْمُهُ<tajweed class=madda_normal>ۥ</tajweed> يَحْيَىٰ لَمْ نَ<tajweed class=qalaqah>جْ</tajweed>عَل لَّهُ<tajweed class=madda_normal>ۥ</tajweed> مِ<tajweed class=ikhafa>ن ق</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>لُ سَمِيًّا <span class=end>٧</span>","End":"٧","PageNumber":305,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":264,"MaqraNumber":122,"HizbNumber":31,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":19,"SurahIndex":"019","VerseNumber":8,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَ رَبِّ أَنَّىٰ يَكُونُ لِي غُلَٰمٞ وَكَانَتِ ٱمۡرَأَتِي عَاقِرٗا وَقَدۡ بَلَغۡتُ مِنَ ٱلۡكِبَرِ عِتِيّٗا","TajweedText":"قَالَ رَبِّ أَ<tajweed class=ghunnah>نّ</tajweed>َىٰ يَكُونُ لِى غُلَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>مٌ و</tajweed>َكَانَتِ <tajweed class=ham_wasl>ٱ</tajweed>مْرَأَتِى عَاقِ<tajweed class=idgham_ghunnah>رًا و</tajweed>َقَ<tajweed class=qalaqah>دْ</tajweed> بَلَغْتُ مِنَ <tajweed class=ham_wasl>ٱ</tajweed>لْكِبَرِ عِتِيًّا <span class=end>٨</span>","End":"٨","PageNumber":305,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":264,"MaqraNumber":122,"HizbNumber":31,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":19,"SurahIndex":"019","VerseNumber":9,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَ كَذَٰلِكَ قَالَ رَبُّكَ هُوَ عَلَيَّ هَيِّنٞ وَقَدۡ خَلَقۡتُكَ مِن قَبۡلُ وَلَمۡ تَكُ شَيۡـٔٗا","TajweedText":"قَالَ كَذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ قَالَ رَبُّكَ هُوَ عَلَىَّ هَيِّ<tajweed class=idgham_ghunnah>نٌ و</tajweed>َقَ<tajweed class=qalaqah>دْ</tajweed> خَلَ<tajweed class=qalaqah>قْ</tajweed>تُكَ مِ<tajweed class=ikhafa>ن ق</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>لُ وَلَمْ تَكُ شَيْــًٔا <span class=end>٩</span>","End":"٩","PageNumber":305,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":264,"MaqraNumber":122,"HizbNumber":31,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":19,"SurahIndex":"019","VerseNumber":10,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَ رَبِّ ٱجۡعَل لِّيٓ ءَايَةٗۖ قَالَ ءَايَتُكَ أَلَّا تُكَلِّمَ ٱلنَّاسَ ثَلَٰثَ لَيَالٖ سَوِيّٗا","TajweedText":"قَالَ رَبِّ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=qalaqah>جْ</tajweed>عَل لّ<tajweed class=madda_obligatory>ِىٓ</tajweed> ءَايَ<tajweed class=ikhafa>ةً‌ۚ ق</tajweed>َالَ ءَايَتُكَ أَلَّا تُكَلِّمَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َاسَ ثَلَ<tajweed class=madda_normal>ـٰ</tajweed>ثَ لَيَا<tajweed class=ikhafa>لٍ س</tajweed>َوِيًّا <span class=end>١٠</span>","End":"١٠","PageNumber":305,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":264,"MaqraNumber":122,"HizbNumber":31,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":19,"SurahIndex":"019","VerseNumber":11,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَخَرَجَ عَلَىٰ قَوۡمِهِۦ مِنَ ٱلۡمِحۡرَابِ فَأَوۡحَىٰٓ إِلَيۡهِمۡ أَن سَبِّحُواْ بُكۡرَةٗ وَعَشِيّٗا","TajweedText":"فَخَرَجَ عَلَىٰ قَوْمِه<tajweed class=madda_normal>ِۦ</tajweed> مِنَ <tajweed class=ham_wasl>ٱ</tajweed>لْمِحْرَابِ فَأَوْحَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> إِلَيْهِمْ أَ<tajweed class=ikhafa>ن س</tajweed>َبِّحُو<tajweed class=slnt>اْ</tajweed> بُكْرَ<tajweed class=idgham_ghunnah>ةً و</tajweed>َعَشِيًّا <span class=end>١١</span>","End":"١١","PageNumber":305,"JuzNumber":16,"ManzilNumber":4,"RukuNumber":264,"MaqraNumber":122,"HizbNumber":31,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":19,"SurahIndex":"019","VerseNumber":12,"ShowSurahName":false,"ShowBismillah":false,"Text":"يَٰيَحۡيَىٰ خُذِ ٱلۡكِتَٰبَ بِقُوَّةٖۖ وَءَاتَيۡنَٰهُ ٱلۡحُكۡمَ صَبِيّٗا","TajweedText":"يَ<tajweed class=madda_normal>ـٰ</tajweed>يَحْيَىٰ خُذِ <tajweed class=ham_wasl>ٱ</tajweed>لْكِتَ<tajweed class=madda_normal>ـٰ</tajweed>بَ بِقُوَّ<tajweed class=idgham_ghunnah>ةٍ‌ۖ و</tajweed>َءَاتَيْنَ<tajweed class=madda_normal>ـٰ</tajweed>هُ <tajweed class=ham_wasl>ٱ</tajweed>لْحُكْمَ صَبِيًّا <span class=end>١٢</span>","End":"١٢","PageNumber":306,"