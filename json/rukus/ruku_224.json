{"RukuNumber":224,"Verses":[{"SurahNumber":16,"SurahIndex":"016","VerseNumber":1,"ShowSurahName":true,"ShowBismillah":true,"Text":"أَتَىٰٓ أَمۡرُ ٱللَّهِ فَلَا تَسۡتَعۡجِلُوهُۚ سُبۡحَٰنَهُۥ وَتَعَٰلَىٰ عَمَّا يُشۡرِكُونَ","TajweedText":"أَتَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> أَمْرُ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ فَلَا تَسْتَعْجِلُوهُ‌ۚ سُ<tajweed class=qalaqah>بْ</tajweed>حَ<tajweed class=madda_normal>ـٰ</tajweed>نَهُ<tajweed class=madda_normal>ۥ</tajweed> وَتَعَ<tajweed class=madda_normal>ـٰ</tajweed>لَىٰ عَ<tajweed class=ghunnah>مّ</tajweed>َا يُشْرِك<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١</span>","End":"١","PageNumber":267,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":224,"MaqraNumber":107,"HizbNumber":27,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":16,"SurahIndex":"016","VerseNumber":2,"ShowSurahName":false,"ShowBismillah":false,"Text":"يُنَزِّلُ ٱلۡمَلَـٰٓئِكَةَ بِٱلرُّوحِ مِنۡ أَمۡرِهِۦ عَلَىٰ مَن يَشَآءُ مِنۡ عِبَادِهِۦٓ أَنۡ أَنذِرُوٓاْ أَنَّهُۥ لَآ إِلَٰهَ إِلَّآ أَنَا۠ فَٱتَّقُونِ","TajweedText":"يُنَزِّلُ <tajweed class=ham_wasl>ٱ</tajweed>لْمَلَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ئِكَةَ بِ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رُّوحِ مِنْ أَمْرِه<tajweed class=madda_normal>ِۦ</tajweed> عَلَىٰ م<tajweed class=idgham_ghunnah>َن ي</tajweed>َش<tajweed class=madda_obligatory>َا</tajweed>ٓءُ مِنْ عِبَادِه<tajweed class=madda_obligatory>ِۦٓ</tajweed> أَنْ أَ<tajweed class=ikhafa>نذ</tajweed>ِر<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> أَ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> ل<tajweed class=madda_obligatory>َآ</tajweed> إِلَ<tajweed class=madda_normal>ـٰ</tajweed>هَ إِلّ<tajweed class=madda_obligatory>َآ</tajweed> أَنَا۟ فَ<tajweed class=ham_wasl>ٱ</tajweed>تَّق<tajweed class=madda_permissible>ُو</tajweed>نِ <span class=end>٢</span>","End":"٢","PageNumber":267,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":224,"MaqraNumber":107,"HizbNumber":27,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":16,"SurahIndex":"016","VerseNumber":3,"ShowSurahName":false,"ShowBismillah":false,"Text":"خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ بِٱلۡحَقِّۚ تَعَٰلَىٰ عَمَّا يُشۡرِكُونَ","TajweedText":"خَلَقَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّمَ<tajweed class=madda_normal>ـٰ</tajweed>و<tajweed class=madda_normal>َٲ</tajweed>تِ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضَ بِ<tajweed class=ham_wasl>ٱ</tajweed>لْحَقِّ‌ۚ تَعَ<tajweed class=madda_normal>ـٰ</tajweed>لَىٰ عَ<tajweed class=ghunnah>مّ</tajweed>َا يُشْرِك<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣</span>","End":"٣","PageNumber":267,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":224,"MaqraNumber":107,"HizbNumber":27,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":16,"SurahIndex":"016","VerseNumber":4,"ShowSurahName":false,"ShowBismillah":false,"Text":"خَلَقَ ٱلۡإِنسَٰنَ مِن نُّطۡفَةٖ فَإِذَا هُوَ خَصِيمٞ مُّبِينٞ","TajweedText":"خَلَقَ <tajweed class=ham_wasl>ٱ</tajweed>لْإِ<tajweed class=ikhafa>نس</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed>نَ م<tajweed class=idgham_ghunnah>ِن ن</tajweed>ُّ<tajweed class=qalaqah>طْ</tajweed>فَ<tajweed class=ikhafa>ةٍ ف</tajweed>َإِذَا هُوَ خَصِي<tajweed class=idgham_ghunnah>مٌ م</tajweed>ُّب<tajweed class=madda_permissible>ِي</tajweed>نٌ <span class=end>٤</span>","End":"٤","PageNumber":267,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":224,"MaqraNumber":107,"HizbNumber":27,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":16,"SurahIndex":"016","VerseNumber":5,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَٱلۡأَنۡعَٰمَ خَلَقَهَاۖ لَكُمۡ فِيهَا دِفۡءٞ وَمَنَٰفِعُ وَمِنۡهَا تَأۡكُلُونَ","TajweedText":"وَ<tajweed class=ham_wasl>ٱ</tajweed>لْأَنْعَ<tajweed class=madda_normal>ـٰ</tajweed>مَ خَلَقَهَا‌ۗ لَكُمْ فِيهَا دِفْ<tajweed class=idgham_ghunnah>ءٌ و</tajweed>َمَنَ<tajweed class=madda_normal>ـٰ</tajweed>فِعُ وَمِنْهَا تَأْكُل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٥</span>","End":"٥","PageNumber":267,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":224,"MaqraNumber":107,"HizbNumber":27,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":16,"SurahIndex":"016","VerseNumber":6,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَكُمۡ فِيهَا جَمَالٌ حِينَ تُرِيحُونَ وَحِينَ تَسۡرَحُونَ","TajweedText":"وَلَكُمْ فِيهَا جَمَالٌ حِينَ تُرِيحُونَ وَحِينَ تَسْرَح<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦</span>","End":"٦","PageNumber":267,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":224,"MaqraNumber":107,"HizbNumber":27,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":16,"SurahIndex":"016","VerseNumber":7,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَتَحۡمِلُ أَثۡقَالَكُمۡ إِلَىٰ بَلَدٖ لَّمۡ تَكُونُواْ بَٰلِغِيهِ إِلَّا بِشِقِّ ٱلۡأَنفُسِۚ إِنَّ رَبَّكُمۡ لَرَءُوفٞ رَّحِيمٞ","TajweedText":"وَتَحْمِلُ أَثْقَالَكُمْ إِلَىٰ بَلَ<tajweed class=idgham_wo_ghunnah>دٍ ل</tajweed>َّمْ تَكُونُو<tajweed class=slnt>اْ</tajweed> بَ<tajweed class=madda_normal>ـٰ</tajweed>لِغِيهِ إِلَّا بِشِقِّ <tajweed class=ham_wasl>ٱ</tajweed>لْأَ<tajweed class=ikhafa>نف</tajweed>ُسِ‌ۚ إِ<tajweed class=ghunnah>نّ</tajweed>َ رَبَّكُمْ لَرَءُو<tajweed class=idgham_wo_ghunnah>فٌ ر</tajweed>َّح<tajweed class=madda_permissible>ِي</tajweed>مٌ <span class=end>٧</span>","End":"٧","PageNumber":268,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":224,"MaqraNumber":107,"HizbNumber":27,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":16,"SurahIndex":"016","VerseNumber":8,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَٱلۡخَيۡلَ وَٱلۡبِغَالَ وَٱلۡحَمِيرَ لِتَرۡكَبُوهَا وَزِينَةٗۚ وَيَخۡلُقُ مَا لَا تَعۡلَمُونَ","TajweedText":"وَ<tajweed class=ham_wasl>ٱ</tajweed>لْخَيْلَ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْبِغَالَ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْحَمِيرَ لِتَرْكَبُوهَا وَزِينَ<tajweed class=idgham_ghunnah>ةً‌ۚ و</tajweed>َيَخْلُقُ مَا لَا تَعْلَم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٨</span>","End":"٨","PageNumber":268,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":224,"MaqraNumber":107,"HizbNumber":27,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":16,"SurahIndex":"016","VerseNumber":9,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَعَلَى ٱللَّهِ قَصۡدُ ٱلسَّبِيلِ وَمِنۡهَا جَآئِرٞۚ وَلَوۡ شَآءَ لَهَدَىٰكُمۡ أَجۡمَعِينَ","TajweedText":"وَعَلَى <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ قَصْدُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّبِيلِ وَمِنْهَا ج<tajweed class=madda_obligatory>َا</tajweed>ٓئِ<tajweed class=idgham_ghunnah>رٌ‌ۚ و</tajweed>َلَوْ ش<tajweed class=madda_obligatory>َا</tajweed>ٓءَ لَهَدَ<tajweed class=madda_normal>ٮٰ</tajweed>كُمْ أَ<tajweed class=qalaqah>جْ</tajweed>مَع<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٩</span>","End":"٩","PageNumber":268,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":224,"MaqraNumber":107,"HizbNumber":27,"HizbDecimal":0.5,"HasSajda":false}]}