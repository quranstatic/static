{"RukuNumber":426,"Verses":[{"SurahNumber":43,"SurahIndex":"043","VerseNumber":26,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِذۡ قَالَ إِبۡرَٰهِيمُ لِأَبِيهِ وَقَوۡمِهِۦٓ إِنَّنِي بَرَآءٞ مِّمَّا تَعۡبُدُونَ","TajweedText":"وَإِذْ قَالَ إِ<tajweed class=qalaqah>بْ</tajweed>ر<tajweed class=madda_normal>َٲ</tajweed>هِيمُ لِأَبِيهِ وَقَوْمِه<tajweed class=madda_obligatory>ِۦٓ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َنِى بَر<tajweed class=madda_obligatory>َا</tajweed>ٓ<tajweed class=idgham_ghunnah>ءٌ م</tajweed>ِّ<tajweed class=ghunnah>مّ</tajweed>َا تَعْبُد<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٦</span>","End":"٢٦","PageNumber":491,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":426,"MaqraNumber":197,"HizbNumber":50,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":27,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِلَّا ٱلَّذِي فَطَرَنِي فَإِنَّهُۥ سَيَهۡدِينِ","TajweedText":"إِلَّا <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى فَطَرَنِى فَإِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> سَيَهْد<tajweed class=madda_permissible>ِي</tajweed>نِ <span class=end>٢٧</span>","End":"٢٧","PageNumber":491,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":426,"MaqraNumber":197,"HizbNumber":50,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":28,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَجَعَلَهَا كَلِمَةَۢ بَاقِيَةٗ فِي عَقِبِهِۦ لَعَلَّهُمۡ يَرۡجِعُونَ","TajweedText":"وَجَعَلَهَا كَلِمَ<tajweed class=iqlab>ةَۢ ب</tajweed>َاقِيَ<tajweed class=ikhafa>ةً ف</tajweed>ِى عَقِبِه<tajweed class=madda_normal>ِۦ</tajweed> لَعَلَّهُمْ يَرْجِع<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٨</span>","End":"٢٨","PageNumber":491,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":426,"MaqraNumber":197,"HizbNumber":50,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":29,"ShowSurahName":false,"ShowBismillah":false,"Text":"بَلۡ مَتَّعۡتُ هَـٰٓؤُلَآءِ وَءَابَآءَهُمۡ حَتَّىٰ جَآءَهُمُ ٱلۡحَقُّ وَرَسُولٞ مُّبِينٞ","TajweedText":"بَلْ مَتَّعْتُ هَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ؤُل<tajweed class=madda_obligatory>َا</tajweed>ٓءِ وَءَاب<tajweed class=madda_obligatory>َا</tajweed>ٓءَهُمْ حَتَّىٰ ج<tajweed class=madda_obligatory>َا</tajweed>ٓءَهُمُ <tajweed class=ham_wasl>ٱ</tajweed>لْحَقُّ وَرَسُو<tajweed class=idgham_ghunnah>لٌ م</tajweed>ُّب<tajweed class=madda_permissible>ِي</tajweed>نٌ <span class=end>٢٩</span>","End":"٢٩","PageNumber":491,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":426,"MaqraNumber":197,"HizbNumber":50,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":30,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَمَّا جَآءَهُمُ ٱلۡحَقُّ قَالُواْ هَٰذَا سِحۡرٞ وَإِنَّا بِهِۦ كَٰفِرُونَ","TajweedText":"وَلَ<tajweed class=ghunnah>مّ</tajweed>َا ج<tajweed class=madda_obligatory>َا</tajweed>ٓءَهُمُ <tajweed class=ham_wasl>ٱ</tajweed>لْحَقُّ قَالُو<tajweed class=slnt>اْ</tajweed> هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا سِحْ<tajweed class=idgham_ghunnah>رٌ و</tajweed>َإِ<tajweed class=ghunnah>نّ</tajweed>َا بِه<tajweed class=madda_normal>ِۦ</tajweed> كَ<tajweed class=madda_normal>ـٰ</tajweed>فِر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣٠</span>","End":"٣٠","PageNumber":491,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":426,"MaqraNumber":197,"HizbNumber":50,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":31,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَقَالُواْ لَوۡلَا نُزِّلَ هَٰذَا ٱلۡقُرۡءَانُ عَلَىٰ رَجُلٖ مِّنَ ٱلۡقَرۡيَتَيۡنِ عَظِيمٍ","TajweedText":"وَقَالُو<tajweed class=slnt>اْ</tajweed> لَوْلَا نُزِّلَ هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا <tajweed class=ham_wasl>ٱ</tajweed>لْقُرْءَانُ عَلَىٰ رَجُ<tajweed class=idgham_ghunnah>لٍ م</tajweed>ِّنَ <tajweed class=ham_wasl>ٱ</tajweed>لْقَرْيَتَيْنِ عَظ<tajweed class=madda_permissible>ِي</tajweed>مٍ <span class=end>٣١</span>","End":"٣١","PageNumber":491,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":426,"MaqraNumber":197,"HizbNumber":50,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":32,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَهُمۡ يَقۡسِمُونَ رَحۡمَتَ رَبِّكَۚ نَحۡنُ قَسَمۡنَا بَيۡنَهُم مَّعِيشَتَهُمۡ فِي ٱلۡحَيَوٰةِ ٱلدُّنۡيَاۚ وَرَفَعۡنَا بَعۡضَهُمۡ فَوۡقَ بَعۡضٖ دَرَجَٰتٖ لِّيَتَّخِذَ بَعۡضُهُم بَعۡضٗا سُخۡرِيّٗاۗ وَرَحۡمَتُ رَبِّكَ خَيۡرٞ مِّمَّا يَجۡمَعُونَ","TajweedText":"أَهُمْ يَ<tajweed class=qalaqah>قْ</tajweed>سِمُونَ رَحْمَتَ رَبِّكَ‌ۚ نَحْنُ قَسَمْنَا بَيْنَه<tajweed class=idgham_shafawi>ُم م</tajweed>َّعِيشَتَهُمْ فِى <tajweed class=ham_wasl>ٱ</tajweed>لْحَيَ<tajweed class=slnt>و</tajweed><tajweed class=madda_normal>ٲ</tajweed>ةِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>دُّنْيَا‌ۚ وَرَفَعْنَا بَعْضَهُمْ فَوْقَ بَعْ<tajweed class=ikhafa>ضٍ د</tajweed>َرَجَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_wo_ghunnah>تٍ ل</tajweed>ِّيَتَّخِذَ بَعْضُه<tajweed class=ikhafa_shafawi>ُم ب</tajweed>َعْ<tajweed class=ikhafa>ضًا س</tajweed>ُخْرِي<tajweed class=idgham_ghunnah>ًّا‌ۗ و</tajweed>َرَحْمَتُ رَبِّكَ خَيْ<tajweed class=idgham_ghunnah>رٌ م</tajweed>ِّ<tajweed class=ghunnah>مّ</tajweed>َا يَ<tajweed class=qalaqah>جْ</tajweed>مَع<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣٢</span>","End":"٣٢","PageNumber":491,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":426,"MaqraNumber":197,"HizbNumber":50,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":33,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَوۡلَآ أَن يَكُونَ ٱلنَّاسُ أُمَّةٗ وَٰحِدَةٗ لَّجَعَلۡنَا لِمَن يَكۡفُرُ بِٱلرَّحۡمَٰنِ لِبُيُوتِهِمۡ سُقُفٗا مِّن فِضَّةٖ وَمَعَارِجَ عَلَيۡهَا يَظۡهَرُونَ","TajweedText":"وَلَوْل<tajweed class=madda_obligatory>َآ</tajweed> أ<tajweed class=idgham_ghunnah>َن ي</tajweed>َ