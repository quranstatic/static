{"RukuNumber":280,"Verses":[{"SurahNumber":21,"SurahIndex":"021","VerseNumber":30,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَوَلَمۡ يَرَ ٱلَّذِينَ كَفَرُوٓاْ أَنَّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ كَانَتَا رَتۡقٗا فَفَتَقۡنَٰهُمَاۖ وَجَعَلۡنَا مِنَ ٱلۡمَآءِ كُلَّ شَيۡءٍ حَيٍّۚ أَفَلَا يُؤۡمِنُونَ","TajweedText":"أَوَلَمْ يَرَ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ كَفَر<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> أَ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّمَ<tajweed class=madda_normal>ـٰ</tajweed>و<tajweed class=madda_normal>َٲ</tajweed>تِ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضَ كَانَتَا رَتْ<tajweed class=ikhafa>قًا ف</tajweed>َفَتَ<tajweed class=qalaqah>قْ</tajweed>نَ<tajweed class=madda_normal>ـٰ</tajweed>هُمَا‌ۖ وَجَعَلْنَا مِنَ <tajweed class=ham_wasl>ٱ</tajweed>لْم<tajweed class=madda_obligatory>َا</tajweed>ٓءِ كُلَّ شَىْءٍ حَىٍّ‌ۖ أَفَلَا يُؤْمِن<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣٠</span>","End":"٣٠","PageNumber":324,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":280,"MaqraNumber":130,"HizbNumber":33,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":31,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَجَعَلۡنَا فِي ٱلۡأَرۡضِ رَوَٰسِيَ أَن تَمِيدَ بِهِمۡ وَجَعَلۡنَا فِيهَا فِجَاجٗا سُبُلٗا لَّعَلَّهُمۡ يَهۡتَدُونَ","TajweedText":"وَجَعَلْنَا فِى <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ رَو<tajweed class=madda_normal>َٲ</tajweed>سِىَ أَ<tajweed class=ikhafa>ن ت</tajweed>َمِيدَ بِهِمْ وَجَعَلْنَا فِيهَا فِجَا<tajweed class=ikhafa>جًا س</tajweed>ُبُل<tajweed class=idgham_wo_ghunnah>اً ل</tajweed>َّعَلَّهُمْ يَهْتَد<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣١</span>","End":"٣١","PageNumber":324,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":280,"MaqraNumber":130,"HizbNumber":33,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":32,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَجَعَلۡنَا ٱلسَّمَآءَ سَقۡفٗا مَّحۡفُوظٗاۖ وَهُمۡ عَنۡ ءَايَٰتِهَا مُعۡرِضُونَ","TajweedText":"وَجَعَلْنَا <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّم<tajweed class=madda_obligatory>َا</tajweed>ٓءَ سَ<tajweed class=qalaqah>قْ</tajweed><tajweed class=idgham_ghunnah>فًا م</tajweed>َّحْفُو<tajweed class=idgham_ghunnah>ظًا‌ۖ و</tajweed>َهُمْ عَنْ ءَايَ<tajweed class=madda_normal>ـٰ</tajweed>تِهَا مُعْرِض<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣٢</span>","End":"٣٢","PageNumber":324,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":280,"MaqraNumber":130,"HizbNumber":33,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":33,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَهُوَ ٱلَّذِي خَلَقَ ٱلَّيۡلَ وَٱلنَّهَارَ وَٱلشَّمۡسَ وَٱلۡقَمَرَۖ كُلّٞ فِي فَلَكٖ يَسۡبَحُونَ","TajweedText":"وَهُوَ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى خَلَقَ <tajweed class=ham_wasl>ٱ</tajweed>لَّيْلَ وَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َهَارَ وَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>شَّمْسَ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْقَمَرَ‌ۖ كُ<tajweed class=ikhafa>لٌّ ف</tajweed>ِى فَلَ<tajweed class=idgham_ghunnah>كٍ ي</tajweed>َسْبَح<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣٣</span>","End":"٣٣","PageNumber":324,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":280,"MaqraNumber":130,"HizbNumber":33,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":34,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَا جَعَلۡنَا لِبَشَرٖ مِّن قَبۡلِكَ ٱلۡخُلۡدَۖ أَفَإِيْن مِّتَّ فَهُمُ ٱلۡخَٰلِدُونَ","TajweedText":"وَمَا جَعَلْنَا لِبَشَ<tajweed class=idgham_ghunnah>رٍ م</tajweed>ِّ<tajweed class=ikhafa>ن ق</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>لِكَ <tajweed class=ham_wasl>ٱ</tajweed>لْخُلْدَ‌ۖ أَفَإِ<tajweed class=slnt>يْ</tajweed><tajweed class=idgham_ghunnah>ن م</tajweed>ِّتَّ فَهُمُ <tajweed class=ham_wasl>ٱ</tajweed>لْخَ<tajweed class=madda_normal>ـٰ</tajweed>لِد<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣٤</span>","End":"٣٤","PageNumber":324,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":280,"MaqraNumber":130,"HizbNumber":33,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":35,"ShowSurahName":false,"ShowBismillah":false,"Text":"كُلُّ نَفۡسٖ ذَآئِقَةُ ٱلۡمَوۡتِۗ وَنَبۡلُوكُم بِٱلشَّرِّ وَٱلۡخَيۡرِ فِتۡنَةٗۖ وَإِلَيۡنَا تُرۡجَعُونَ","TajweedText":"كُلُّ نَفْ<tajweed class=ikhafa>سٍ ذ</tajweed><tajweed class=madda_obligatory>َا</tajweed>ٓئِقَةُ <tajweed class=ham_wasl>ٱ</tajweed>لْمَوْتِ‌ۗ وَنَ<tajweed class=qalaqah>بْ</tajweed>لُوك<tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>شَّرِّ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْخَيْرِ فِتْنَ<tajweed class=idgham_ghunnah>ةً‌ۖ و</tajweed>َإِلَيْنَا تُرْجَع<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣٥</span>","End":"٣٥","PageNumber":324,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":280,"MaqraNumber":130,"HizbNumber":33,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":36,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِذَا رَءَاكَ ٱلَّذِينَ كَفَرُوٓاْ إِن يَتَّخِذُونَكَ إِلَّا هُزُوًا أَهَٰذَا ٱلَّذِي يَذۡكُرُ ءَالِهَتَكُمۡ وَهُم بِذِكۡرِ ٱلرَّحۡمَٰنِ هُمۡ كَٰفِرُونَ","TajweedText":"وَإِذَا رَءَاكَ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ كَفَر<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> إ<tajweed class=idgham_ghunnah>ِن ي</tajweed>َتَّخِذُونَكَ إِلَّا هُزُوًا أَهَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى يَذْكُرُ ءَالِهَتَكُمْ وَه<tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِذِكْرِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رَّحْمَ<tajweed class=madda_normal>ـٰ</tajweed>نِ هُمْ كَ<tajweed class=madda_normal>ـٰ</tajweed>فِر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣٦</span>","End":"٣٦","PageNumber":325,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":280,"MaqraNumber":130,"HizbNumber":33,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":37,"ShowSurahName":false,"ShowBismillah":false,"Text":"خُلِقَ ٱلۡإِنسَٰنُ مِنۡ عَجَلٖۚ سَأُوْرِيكُمۡ ءَايَٰتِي فَلَا تَسۡتَعۡجِلُونِ","TajweedText":"خُلِقَ <tajweed class=ham_wasl>ٱ</tajweed>لْإِ<tajweed class=ikhafa>نس</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed>نُ مِنْ عَجَ<tajweed class=ikhafa>لٍ‌ۚ س</tajweed>َأُ<tajweed class=slnt>وْ</tajweed>رِيكُمْ ءَايَ<tajweed class=madda_normal>ـٰ</tajweed>تِى فَلَا تَسْتَعْجِل<tajweed class=madda_permissible>ُو</tajweed>نِ <span class=end>٣٧</span>","End":"٣٧","PageNumber":325,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":280,"MaqraNumber":130,"HizbNumber":33,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":38,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَيَقُولُونَ مَتَىٰ هَٰذَا ٱلۡوَعۡدُ إِن كُنتُمۡ صَٰدِقِينَ","TajweedText":"وَيَقُولُونَ مَتَىٰ هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا <tajweed class=ham_wasl>ٱ</tajweed>لْوَعْدُ إِ<tajweed class=ikhafa>ن ك</tajweed>ُ<tajweed class=ikhafa>نت</tajweed>ُمْ صَ<tajweed class=madda_normal>ـٰ</tajweed>دِق<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٣٨</span>","End":"٣٨","PageNumber":325,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":280,"MaqraNumber":130,"HizbNumber":33,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":39,"ShowSurahName":false,"ShowBismillah":false,"Text":"لَوۡ يَعۡلَمُ ٱلَّذِينَ كَفَرُواْ حِينَ لَا يَكُفُّونَ عَن وُجُوهِهِمُ ٱلنَّارَ وَلَا عَن ظُهُورِهِمۡ وَلَا هُمۡ يُنصَرُونَ","TajweedText":"لَوْ يَعْلَمُ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ كَفَرُو<tajweed class=slnt>اْ</tajweed> حِينَ لَا يَكُفُّونَ ع<tajweed class=idgham_ghunnah>َن و</tajweed>ُجُوهِهِمُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َارَ وَلَا عَ<tajweed class=ikhafa>ن ظ</tajweed>ُهُورِهِمْ وَلَا هُمْ يُ<tajweed class=ikhafa>نص</tajweed>َر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣٩</span>","End":"٣٩","PageNumber":325,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":280,"MaqraNumber":130,"HizbNumber":33,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":40,"ShowSurahName":false,"ShowBismillah":false,"Text":"بَلۡ تَأۡتِيهِم بَغۡتَةٗ فَتَبۡهَتُهُمۡ فَلَا يَسۡتَطِيعُونَ رَدَّهَا وَلَا هُمۡ يُنظَرُونَ","TajweedText":"بَلْ تَأْتِيه<tajweed class=ikhafa_shafawi>ِم ب</tajweed>َغْتَ<tajweed class=ikhafa>ةً ف</tajweed>َتَ<tajweed class=qalaqah>بْ</tajweed>هَتُهُمْ فَلَا يَسْتَطِيعُونَ رَدَّهَا وَلَا هُمْ يُ<tajweed class=ikhafa>نظ</tajweed>َر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٤٠</span>","End":"٤٠","PageNumber":325,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":280,"MaqraNumber":130,"HizbNumber":33,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":41,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَقَدِ ٱسۡتُهۡزِئَ بِرُسُلٖ مِّن قَبۡلِكَ فَحَاقَ بِٱلَّذِينَ سَخِرُواْ مِنۡهُم مَّا كَانُواْ بِهِۦ يَسۡتَهۡزِءُونَ","TajweedText":"وَلَقَدِ <tajweed class=ham_wasl>ٱ</tajweed>سْتُهْزِئَ بِرُسُ<tajweed class=idgham_ghunnah>لٍ م</tajweed>ِّ<tajweed class=ikhafa>ن ق</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>لِكَ فَحَاقَ بِ<tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ سَخِرُو<tajweed class=slnt>اْ</tajweed> مِنْه<tajweed class=idgham_shafawi>ُم م</tajweed>َّا كَانُو<tajweed class=slnt>اْ</tajweed> بِه<tajweed class=madda_normal>ِۦ</tajweed> يَسْتَهْزِء<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٤١</span>","End":"٤١","PageNumber":325,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":280,"MaqraNumber":130,"HizbNumber":33,"HizbDecimal":0.25,"HasSajda":false}]}