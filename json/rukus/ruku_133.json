{"RukuNumber":133,"Verses":[{"SurahNumber":7,"SurahIndex":"007","VerseNumber":94,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَآ أَرۡسَلۡنَا فِي قَرۡيَةٖ مِّن نَّبِيٍّ إِلَّآ أَخَذۡنَآ أَهۡلَهَا بِٱلۡبَأۡسَآءِ وَٱلضَّرَّآءِ لَعَلَّهُمۡ يَضَّرَّعُونَ","TajweedText":"وَم<tajweed class=madda_obligatory>َآ</tajweed> أَرْسَلْنَا فِى قَرْيَ<tajweed class=idgham_ghunnah>ةٍ م</tajweed>ّ<tajweed class=idgham_ghunnah>ِن ن</tajweed>َّبِىٍّ إِلّ<tajweed class=madda_obligatory>َآ</tajweed> أَخَذْن<tajweed class=madda_obligatory>َآ</tajweed> أَهْلَهَا بِ<tajweed class=ham_wasl>ٱ</tajweed>لْبَأْس<tajweed class=madda_obligatory>َا</tajweed>ٓءِ وَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>ضَّرّ<tajweed class=madda_obligatory>َا</tajweed>ٓءِ لَعَلَّهُمْ يَضَّرَّع<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٩٤</span>","End":"٩٤","PageNumber":162,"JuzNumber":9,"ManzilNumber":2,"RukuNumber":133,"MaqraNumber":65,"HizbNumber":17,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":7,"SurahIndex":"007","VerseNumber":95,"ShowSurahName":false,"ShowBismillah":false,"Text":"ثُمَّ بَدَّلۡنَا مَكَانَ ٱلسَّيِّئَةِ ٱلۡحَسَنَةَ حَتَّىٰ عَفَواْ وَّقَالُواْ قَدۡ مَسَّ ءَابَآءَنَا ٱلضَّرَّآءُ وَٱلسَّرَّآءُ فَأَخَذۡنَٰهُم بَغۡتَةٗ وَهُمۡ لَا يَشۡعُرُونَ","TajweedText":"ثُ<tajweed class=ghunnah>مّ</tajweed>َ بَدَّلْنَا مَكَانَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّيِّئَةِ <tajweed class=ham_wasl>ٱ</tajweed>لْحَسَنَةَ حَتَّىٰ عَفَو<tajweed class=slnt>اْ</tajweed> وَّقَالُو<tajweed class=slnt>اْ</tajweed> قَ<tajweed class=qalaqah>دْ</tajweed> مَسَّ ءَاب<tajweed class=madda_obligatory>َا</tajweed>ٓءَنَا <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>ضَّرّ<tajweed class=madda_obligatory>َا</tajweed>ٓءُ وَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّرّ<tajweed class=madda_obligatory>َا</tajweed>ٓءُ فَأَخَذْنَ<tajweed class=madda_normal>