{"RukuNumber":453,"Verses":[{"SurahNumber":50,"SurahIndex":"050","VerseNumber":16,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ وَنَعۡلَمُ مَا تُوَسۡوِسُ بِهِۦ نَفۡسُهُۥۖ وَنَحۡنُ أَقۡرَبُ إِلَيۡهِ مِنۡ حَبۡلِ ٱلۡوَرِيدِ","TajweedText":"وَلَقَ<tajweed class=qalaqah>دْ</tajweed> خَلَ<tajweed class=qalaqah>قْ</tajweed>نَا <tajweed class=ham_wasl>ٱ</tajweed>لْإِ<tajweed class=ikhafa>نس</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed>نَ وَنَعْلَمُ مَا تُوَسْوِسُ بِه<tajweed class=madda_normal>ِۦ</tajweed> نَفْسُهُ<tajweed class=madda_normal>ۥ</tajweed>‌ۖ وَنَحْنُ أَ<tajweed class=qalaqah>قْ</tajweed>رَبُ إِلَيْهِ مِنْ حَ<tajweed class=qalaqah>بْ</tajweed>لِ <tajweed class=ham_wasl>ٱ</tajweed>لْوَر<tajweed class=madda_permissible>ِي</tajweed><tajweed class=qalaqah>د</tajweed>ِ <span class=end>١٦</span>","End":"١٦","PageNumber":519,"JuzNumber":26,"ManzilNumber":7,"RukuNumber":453,"MaqraNumber":207,"HizbNumber":52,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":50,"SurahIndex":"050","VerseNumber":17,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِذۡ يَتَلَقَّى ٱلۡمُتَلَقِّيَانِ عَنِ ٱلۡيَمِينِ وَعَنِ ٱلشِّمَالِ قَعِيدٞ","TajweedText":"إِذْ يَتَلَقَّى <tajweed class=ham_wasl>ٱ</tajweed>لْمُتَلَقِّيَانِ عَنِ <tajweed class=ham_wasl>ٱ</tajweed>لْيَمِينِ وَعَنِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>شِّمَالِ قَع<tajweed class=madda_permissible>ِي</tajweed><tajweed class=qalaqah>د</tajweed>ٌ <span class=end>١٧</span>","End":"١٧","PageNumber":519,"JuzNumber":26,"ManzilNumber":7,"RukuNumber":453,"MaqraNumber":207,"HizbNumber":52,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":50,"SurahIndex":"050","VerseNumber":18,"ShowSurahName":false,"ShowBismillah":false,"Text":"مَّا يَلۡفِظُ مِن قَوۡلٍ إِلَّا لَدَيۡهِ رَقِيبٌ عَتِيدٞ","TajweedText":"مَّا يَلْفِظُ مِ<tajweed class=ikhafa>ن ق</tajweed>َوْلٍ إِلَّا لَدَيْهِ رَقِيبٌ عَت<tajweed class=madda_permissible>ِي</tajweed><tajweed class=qalaqah>د</tajweed>ٌ <span class=end>١٨</span>","End":"١٨","PageNumber":519,"JuzNumber":26,"ManzilNumber":7,"RukuNumber":453,"MaqraNumber":207,"HizbNumber":52,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":50,"SurahIndex":"050","VerseNumber":19,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَجَآءَتۡ سَكۡرَةُ ٱلۡمَوۡتِ بِٱلۡحَقِّۖ ذَٰلِكَ مَا كُنتَ مِنۡهُ تَحِيدُ","TajweedText":"وَج<tajweed class=madda_obligatory>َا</tajweed>ٓءَتْ سَكْرَةُ <tajweed class=ham_wasl>ٱ</tajweed>لْمَوْتِ بِ<tajweed class=ham_wasl>ٱ</tajweed>لْحَقِّ‌ۖ ذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ مَا كُ<tajweed class=ikhafa>نت</tajweed>َ مِنْهُ تَح<tajweed class=madda_permissible>ِي</tajweed><tajweed class=qalaqah>د</tajweed>ُ <span class=end>١٩</span>","End":"١٩","PageNumber":519,"JuzNumber":26,"ManzilNumber":7,"RukuNumber":453,"MaqraNumber":207,"HizbNumber":52,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":50,"SurahIndex":"050","VerseNumber":20,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَنُفِخَ فِي ٱلصُّورِۚ ذَٰلِكَ يَوۡمُ ٱلۡوَعِيدِ","TajweedText":"وَنُفِخَ فِى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>صُّورِ‌ۚ ذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ يَوْمُ <tajweed class=ham_wasl>ٱ</tajweed>لْوَع<tajweed class=madda_permissible>ِي</tajweed><tajweed class=qalaqah>د</tajweed>ِ <span class=end>٢٠</span>","End":"٢٠","PageNumber":519,"JuzNumber":26,"ManzilNumber":7,"RukuNumber":453,"MaqraNumber":207,"HizbNumber":52,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":50,"SurahIndex":"050","VerseNumber":21,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَجَآءَتۡ كُلُّ نَفۡسٖ مَّعَهَا سَآئِقٞ وَشَهِيدٞ","TajweedText":"وَج<tajweed class=madda_obligatory>َا</tajweed>ٓءَتْ كُلُّ نَفْ<tajweed class=idgham_ghunnah>سٍ م</tajweed>َّعَهَا س<tajweed class=madda_obligatory>َا</tajweed>ٓئِ<tajweed class=idgham_ghunnah>قٌ و</tajweed>َشَه<tajweed class=madda_permissible>ِي</tajweed><tajweed class=qalaqah>د</tajweed>ٌ <span class=end>٢١</span>","End":"٢١","PageNumber":519,"JuzNumber":26,"ManzilNumber":7,"RukuNumber":453,"MaqraNumber":207,"HizbNumber":52,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":50,"SurahIndex":"050","VerseNumber":22,"ShowSurahName":false,"ShowBismillah":false,"Text":"لَّقَدۡ كُنتَ فِي غَفۡلَةٖ مِّنۡ هَٰذَا فَكَشَفۡنَا عَنكَ غِطَآءَكَ فَبَصَرُكَ ٱلۡيَوۡمَ حَدِيدٞ","TajweedText":"لَّقَ<tajweed class=qalaqah>دْ</tajweed> كُ<tajweed class=ikhafa>نت</tajweed>َ فِى غَفْلَ<tajweed class=idgham_ghunnah>ةٍ م</tajweed>ِّنْ هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا فَكَشَفْنَا عَ<tajweed class=ikhafa>نك</tajweed>َ غِط<tajweed class=madda_obligatory>َا</tajweed>ٓءَكَ فَبَصَرُكَ <tajweed class=ham_wasl>ٱ</tajweed>لْيَوْمَ حَد<tajweed class=madda_permissible>ِي</tajweed><tajweed class=qalaqah>د</tajweed>ٌ <span class=end>٢٢</span>","End":"٢٢","PageNumber":519,"JuzNumber":26,"ManzilNumber":7,"RukuNumber":453,"MaqraNumber":207,"HizbNumber":52,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":50,"SurahIndex":"050","VerseNumber":23,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَقَالَ قَرِينُهُۥ هَٰذَا مَا لَدَيَّ عَتِيدٌ","TajweedText":"وَقَالَ قَرِينُهُ<tajweed class=madda_normal>ۥ</tajweed> هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا مَا لَدَىَّ عَت<tajweed class=madda_permissible>ِي</tajweed><tajweed class=qalaqah>د</tajweed>ٌ <span class=end>٢٣</span>","End":"٢٣","PageNumber":519,"JuzNumber":26,"ManzilNumber":7,"RukuNumber":453,"MaqraNumber":207,"HizbNumber":52,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":50,"SurahIndex":"050","VerseNumber":24,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَلۡقِيَا فِي جَهَنَّمَ كُلَّ كَفَّارٍ عَنِيدٖ","TajweedText":"أَلْقِيَا فِى جَهَ<tajweed class=ghunnah>نّ</tajweed>َمَ كُلَّ كَفَّارٍ عَن<tajweed class=madda_permissible>ِي</tajweed><tajweed class=qalaqah>د</tajweed>ٍ <span class=end>٢٤</span>","End":"٢٤","PageNumber":519,"JuzNumber":26,"ManzilNumber":7,"RukuNumber":453,"MaqraNumber":207,"HizbNumber":52,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":50,"SurahIndex":"050","VerseNumber":25,"ShowSurahName":false,"ShowBismillah":false,"Text":"مَّنَّاعٖ لِّلۡخَيۡرِ مُعۡتَدٖ مُّرِيبٍ","TajweedText":"مَّ<tajweed class=ghunnah>نّ</tajweed>َا<tajweed class=idgham_wo_ghunnah>عٍ ل</tajweed>ِّلْخَيْرِ مُعْتَ<tajweed class=idgham_ghunnah>دٍ م</tajweed>ُّر<tajweed class=madda_permissible>ِي</tajweed><tajweed class=qalaqah>ب</tajweed>ٍ <span class=end>٢٥</span>","End":"٢٥","PageNumber":519,"JuzNumber":26,"ManzilNumber":7,"RukuNumber":453,"MaqraNumber":207,"HizbNumber":52,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":50,"SurahIndex":"050","VerseNumber":26,"ShowSurahName":false,"ShowBismillah":false,"Text":"ٱلَّذِي جَعَلَ مَعَ ٱللَّهِ إِلَٰهًا ءَاخَرَ فَأَلۡقِيَاهُ فِي ٱلۡعَذَابِ ٱلشَّدِيدِ","TajweedText":"ٱلَّذِى جَعَلَ مَعَ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ إِلَ<tajweed class=madda_normal>ـٰ</tajweed>هًا ءَاخَرَ فَأَلْقِيَاهُ فِى <tajweed class=ham_wasl>ٱ</tajweed>لْعَذَابِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>شَّد<tajweed class=madda_permissible>ِي</tajweed><tajweed class=qalaqah>د</tajweed>ِ <span class=end>٢٦</span>","End":"٢٦","PageNumber":519,"JuzNumber":26,"ManzilNumber":7,"RukuNumber":453,"MaqraNumber":207,"HizbNumber":52,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":50,"SurahIndex":"050","VerseNumber":27,"ShowSurahName":false,"ShowBismillah":false,"Text":"۞قَالَ قَرِينُهُۥ رَبَّنَا مَآ أَطۡغَيۡتُهُۥ وَلَٰكِن كَانَ فِي ضَلَٰلِۭ بَعِيدٖ","TajweedText":"۞ قَالَ قَرِينُهُ<tajweed class=madda_normal>ۥ</tajweed> رَبَّنَا م<tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=qalaqah>طْ</tajweed>غَيْتُهُ<tajweed class=madda_normal>ۥ</tajweed> وَلَ<tajweed class=madda_normal>ـٰ</tajweed>كِ<tajweed class=ikhafa>ن ك</tajweed>َانَ فِى ضَلَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=iqlab>لِۭ ب</tajweed>َع<tajweed class=madda_permissible>ِي</tajweed><tajweed class=qalaqah>د</tajweed>ٍ <span class=end>٢٧</span>","End":"٢٧","PageNumber":519,"JuzNumber":26,"ManzilNumber":7,"RukuNumber":453,"MaqraNumber":208,"HizbNumber":52,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":50,"SurahIndex":"050","VerseNumber":28,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَ لَا تَخۡتَصِمُواْ لَدَيَّ وَقَدۡ قَدَّمۡتُ إِلَيۡكُم بِٱلۡوَعِيدِ","TajweedText":"قَالَ لَا تَخْتَصِمُو<tajweed class=slnt>اْ</tajweed> لَدَىَّ وَقَ<tajweed class=qalaqah>دْ</tajweed> قَدَّمْتُ إِلَيْك<tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِ<tajweed class=ham_wasl>ٱ</tajweed>لْوَع<tajweed class=madda_permissible>ِي</tajweed><tajweed class=qalaqah>د</tajweed>ِ <span class=end>٢٨</span>","End":"٢٨","PageNumber":519,"JuzNumber":26,"ManzilNumber":7,"RukuNumber":453,"MaqraNumber":208,"HizbNumber":52,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":50,"SurahIndex":"050","VerseNumber":29,"ShowSurahName":false,"ShowBismillah":false,"Text":"مَا يُبَدَّلُ ٱلۡقَوۡلُ لَدَيَّ وَمَآ أَنَا۠ بِظَلَّـٰمٖ لِّلۡعَبِيدِ","TajweedText":"مَا يُبَدَّلُ <tajweed class=ham_wasl>ٱ</tajweed>لْقَوْلُ لَدَىَّ وَم<tajweed class=madda_obligatory>َآ</tajweed> أَنَا۟ بِظَلَّ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_wo_ghunnah>مٍ ل</tajweed>ِّلْعَب<tajweed class=madda_permissible>ِي</tajweed><tajweed class=qalaqah>د</tajweed>ِ <span class=end>٢٩</span>","End":"٢٩","PageNumber":519,"JuzNumber":26,"ManzilNumber":7,"RukuNumber":453,"MaqraNumber":208,"HizbNumber":52,"HizbDecimal":0.75,"HasSajda":false}]}