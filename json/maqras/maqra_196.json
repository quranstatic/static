{"MaqraNumber":196.0,"Verses":[{"SurahNumber":42,"SurahIndex":"042","VerseNumber":51,"ShowSurahName":false,"ShowBismillah":false,"Text":"۞وَمَا كَانَ لِبَشَرٍ أَن يُكَلِّمَهُ ٱللَّهُ إِلَّا وَحۡيًا أَوۡ مِن وَرَآيِٕ حِجَابٍ أَوۡ يُرۡسِلَ رَسُولٗا فَيُوحِيَ بِإِذۡنِهِۦ مَا يَشَآءُۚ إِنَّهُۥ عَلِيٌّ حَكِيمٞ","TajweedText":"۞ وَمَا كَانَ لِبَشَرٍ أ<tajweed class=idgham_ghunnah>َن ي</tajweed>ُكَلِّمَهُ <tajweed class=ham_wasl>ٱ</tajweed>للَّهُ إِلَّا وَحْيًا أَوْ م<tajweed class=idgham_ghunnah>ِن و</tajweed>َرَآىِٕ حِجَابٍ أَوْ يُرْسِلَ رَسُول<tajweed class=ikhafa>اً ف</tajweed>َيُوحِىَ بِإِذْنِه<tajweed class=madda_normal>ِۦ</tajweed> مَا يَش<tajweed class=madda_obligatory>َا</tajweed>ٓءُ‌ۚ إِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> عَلِىٌّ حَك<tajweed class=madda_permissible>ِي</tajweed>مٌ <span class=end>٥١</span>","End":"٥١","PageNumber":488,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":423,"MaqraNumber":196,"HizbNumber":49,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":42,"SurahIndex":"042","VerseNumber":52,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَكَذَٰلِكَ أَوۡحَيۡنَآ إِلَيۡكَ رُوحٗا مِّنۡ أَمۡرِنَاۚ مَا كُنتَ تَدۡرِي مَا ٱلۡكِتَٰبُ وَلَا ٱلۡإِيمَٰنُ وَلَٰكِن جَعَلۡنَٰهُ نُورٗا نَّهۡدِي بِهِۦ مَن نَّشَآءُ مِنۡ عِبَادِنَاۚ وَإِنَّكَ لَتَهۡدِيٓ إِلَىٰ صِرَٰطٖ مُّسۡتَقِيمٖ","TajweedText":"وَكَذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ أَوْحَيْن<tajweed class=madda_obligatory>َآ</tajweed> إِلَيْكَ رُو<tajweed class=idgham_ghunnah>حًا م</tajweed>ِّنْ أَمْرِنَا‌ۚ مَا كُ<tajweed class=ikhafa>نت</tajweed>َ تَ<tajweed class=qalaqah>دْ</tajweed>رِى مَا <tajweed class=ham_wasl>ٱ</tajweed>لْكِتَ<tajweed class=madda_normal>ـٰ</tajweed>بُ وَلَا <tajweed class=ham_wasl>ٱ</tajweed>لْإِيمَ<tajweed class=madda_normal>ـٰ</tajweed>نُ وَلَ<tajweed class=madda_normal>ـٰ</tajweed>كِ<tajweed class=ikhafa>ن ج</tajweed>َعَلْنَ<tajweed class=madda_normal>ـٰ</tajweed>هُ نُو<tajweed class=idgham_ghunnah>رًا ن</tajweed>َّهْدِى بِه<tajweed class=madda_normal>ِۦ</tajweed> م<tajweed class=idgham_ghunnah>َن ن</tajweed>َّش<tajweed class=madda_obligatory>َا</tajweed>ٓءُ مِنْ عِبَادِنَا‌ۚ وَإِ<tajweed class=ghunnah>نّ</tajweed>َكَ لَتَهْد<tajweed class=madda_obligatory>ِىٓ</tajweed> إِلَىٰ صِر<tajweed class=madda_normal>َٲ</tajweed><tajweed class=idgham_ghunnah>طٍ م</tajweed>ُّسْتَق<tajweed class=madda_permissible>ِي</tajweed>مٍ <span class=end>٥٢</span>","End":"٥٢","PageNumber":489,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":423,"MaqraNumber":196,"HizbNumber":49,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":42,"SurahIndex":"042","VerseNumber":53,"ShowSurahName":false,"ShowBismillah":false,"Text":"صِرَٰطِ ٱللَّهِ ٱلَّذِي لَهُۥ مَا فِي ٱلسَّمَٰوَٰتِ وَمَا فِي ٱلۡأَرۡضِۗ أَلَآ إِلَى ٱللَّهِ تَصِيرُ ٱلۡأُمُورُ","TajweedText":"صِر<tajweed class=madda_normal>َٲ</tajweed>طِ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى لَهُ<tajweed class=madda_normal>ۥ</tajweed> مَا فِى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّمَ<tajweed class=madda_normal>ـٰ</tajweed>و<tajweed class=madda_normal>َٲ</tajweed>تِ وَمَا فِى <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ‌ۗ أَل<tajweed class=madda_obligatory>َآ</tajweed> إِلَى <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ تَصِيرُ <tajweed class=ham_wasl>ٱ</tajweed>لْأُم<tajweed class=madda_permissible>ُو</tajweed>رُ <span class=end>٥٣</span>","End":"٥٣","PageNumber":489,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":423,"MaqraNumber":196,"HizbNumber":49,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":1,"ShowSurahName":true,"ShowBismillah":true,"Text":"حمٓ","TajweedText":"ح<tajweed class=madda_necessary>مٓ</tajweed> <span class=end>١</span>","End":"١","PageNumber":489,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":424,"MaqraNumber":196,"HizbNumber":49,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":2,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَٱلۡكِتَٰبِ ٱلۡمُبِينِ","TajweedText":"وَ<tajweed class=ham_wasl>ٱ</tajweed>لْكِتَ<tajweed class=madda_normal>ـٰ</tajweed>بِ <tajweed class=ham_wasl>ٱ</tajweed>لْمُب<tajweed class=madda_permissible>ِي</tajweed>نِ <span class=end>٢</span>","End":"٢","PageNumber":489,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":424,"MaqraNumber":196,"HizbNumber":49,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":3,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّا جَعَلۡنَٰهُ قُرۡءَٰنًا عَرَبِيّٗا لَّعَلَّكُمۡ تَعۡقِلُونَ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َا جَعَلْنَ<tajweed class=madda_normal>ـٰ</tajweed>هُ قُرْء<tajweed class=madda_normal>َٲ</tajweed>نًا عَرَبِي<tajweed class=idgham_wo_ghunnah>ًّا ل</tajweed>َّعَلَّكُمْ تَعْقِل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣</span>","End":"٣","PageNumber":489,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":424,"MaqraNumber":196,"HizbNumber":49,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":4,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِنَّهُۥ فِيٓ أُمِّ ٱلۡكِتَٰبِ لَدَيۡنَا لَعَلِيٌّ حَكِيمٌ","TajweedText":"وَإِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> ف<tajweed class=madda_obligatory>ِىٓ</tajweed> أُ<tajweed class=ghunnah>مّ</tajweed>ِ <tajweed class=ham_wasl>ٱ</tajweed>لْكِتَ<tajweed class=madda_normal>ـٰ</tajweed>بِ لَدَيْنَا لَعَلِىٌّ حَك<tajweed class=madda_permissible>ِي</tajweed>مٌ <span class=end>٤</span>","End":"٤","PageNumber":489,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":424,"MaqraNumber":196,"HizbNumber":49,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":5,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَفَنَضۡرِبُ عَنكُمُ ٱلذِّكۡرَ صَفۡحًا أَن كُنتُمۡ قَوۡمٗا مُّسۡرِفِينَ","TajweedText":"أَفَنَضْرِبُ عَ<tajweed class=ikhafa>نك</tajweed>ُمُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>ذِّكْرَ صَفْحًا أَ<tajweed class=ikhafa>ن ك</tajweed>ُ<tajweed class=ikhafa>نت</tajweed>ُمْ قَوْ<tajweed class=idgham_ghunnah>مًا م</tajweed>ُّسْرِف<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٥</span>","End":"٥","PageNumber":489,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":424,"MaqraNumber":196,"HizbNumber":49,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":6,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَكَمۡ أَرۡسَلۡنَا مِن نَّبِيّٖ فِي ٱلۡأَوَّلِينَ","TajweedText":"وَكَمْ أَرْسَلْنَا م<tajweed class=idgham_ghunnah>ِن ن</tajweed>َّبِ<tajweed class=ikhafa>ىٍّ ف</tajweed>ِى <tajweed class=ham_wasl>ٱ</tajweed>لْأَوَّل<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٦</span>","End":"٦","PageNumber":489,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":424,"MaqraNumber":196,"HizbNumber":49,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":7,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَا يَأۡتِيهِم مِّن نَّبِيٍّ إِلَّا كَانُواْ بِهِۦ يَسۡتَهۡزِءُونَ","TajweedText":"وَمَا يَأْتِيه<tajweed class=idgham_shafawi>ِم م</tajweed>ّ<tajweed class=idgham_ghunnah>ِن ن</tajweed>َّبِىٍّ إِلَّا كَانُو<tajweed class=slnt>اْ</tajweed> بِه<tajweed class=madda_normal>ِۦ</tajweed> يَسْتَهْزِء<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٧</span>","End":"٧","PageNumber":489,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":424,"MaqraNumber":196,"HizbNumber":49,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":8,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَأَهۡلَكۡنَآ أَشَدَّ مِنۡهُم بَطۡشٗا وَمَضَىٰ مَثَلُ ٱلۡأَوَّلِينَ","TajweedText":"فَأَهْلَكْن<tajweed class=madda_obligatory>َآ</tajweed> أَشَدَّ مِنْه<tajweed class=ikhafa_shafawi>ُم ب</tajweed>َ<tajweed class=qalaqah>طْ</tajweed><tajweed class=idgham_ghunnah>شًا و</tajweed>َمَضَىٰ مَثَلُ <tajweed class=ham_wasl>ٱ</taj