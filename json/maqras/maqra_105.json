{"MaqraNumber":105.0,"Verses":[{"SurahNumber":15,"SurahIndex":"015","VerseNumber":1,"ShowSurahName":true,"ShowBismillah":true,"Text":"الٓرۚ تِلۡكَ ءَايَٰتُ ٱلۡكِتَٰبِ وَقُرۡءَانٖ مُّبِينٖ","TajweedText":"ا<tajweed class=madda_necessary>لٓ</tajweed>ر‌ۚ تِلْكَ ءَايَ<tajweed class=madda_normal>ـٰ</tajweed>تُ <tajweed class=ham_wasl>ٱ</tajweed>لْكِتَ<tajweed class=madda_normal>ـٰ</tajweed>بِ وَقُرْءَا<tajweed class=idgham_ghunnah>نٍ م</tajweed>ُّب<tajweed class=madda_permissible>ِي</tajweed>نٍ <span class=end>١</span>","End":"١","PageNumber":262,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":218,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":2,"ShowSurahName":false,"ShowBismillah":false,"Text":"رُّبَمَا يَوَدُّ ٱلَّذِينَ كَفَرُواْ لَوۡ كَانُواْ مُسۡلِمِينَ","TajweedText":"رُّبَمَا يَوَدُّ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ كَفَرُو<tajweed class=slnt>اْ</tajweed> لَوْ كَانُو<tajweed class=slnt>اْ</tajweed> مُسْلِم<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٢</span>","End":"٢","PageNumber":262,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":218,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":3,"ShowSurahName":false,"ShowBismillah":false,"Text":"ذَرۡهُمۡ يَأۡكُلُواْ وَيَتَمَتَّعُواْ وَيُلۡهِهِمُ ٱلۡأَمَلُۖ فَسَوۡفَ يَعۡلَمُونَ","TajweedText":"ذَرْهُمْ يَأْكُلُو<tajweed class=slnt>اْ</tajweed> وَيَتَمَتَّعُو<tajweed class=slnt>اْ</tajweed> وَيُلْهِهِمُ <tajweed class=ham_wasl>ٱ</tajweed>لْأَمَلُ‌ۖ فَسَوْفَ يَعْلَم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣</span>","End":"٣","PageNumber":262,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":218,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":4,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَآ أَهۡلَكۡنَا مِن قَرۡيَةٍ إِلَّا وَلَهَا كِتَابٞ مَّعۡلُومٞ","TajweedText":"وَم<tajweed class=madda_obligatory>َآ</tajweed> أَهْلَكْنَا مِ<tajweed class=ikhafa>ن ق</tajweed>َرْيَةٍ إِلَّا وَلَهَا كِتَا<tajweed class=idgham_ghunnah>بٌ م</tajweed>َّعْل<tajweed class=madda_permissible>ُو</tajweed>مٌ <span class=end>٤</span>","End":"٤","PageNumber":262,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":218,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":5,"ShowSurahName":false,"ShowBismillah":false,"Text":"مَّا تَسۡبِقُ مِنۡ أُمَّةٍ أَجَلَهَا وَمَا يَسۡتَـٔۡخِرُونَ","TajweedText":"مَّا تَسْبِقُ مِنْ أُ<tajweed class=ghunnah>مّ</tajweed>َةٍ أَجَلَهَا وَمَا يَسْتَــْٔخِر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٥</span>","End":"٥","PageNumber":262,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":218,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":6,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَقَالُواْ يَـٰٓأَيُّهَا ٱلَّذِي نُزِّلَ عَلَيۡهِ ٱلذِّكۡرُ إِنَّكَ لَمَجۡنُونٞ","TajweedText":"وَقَالُو<tajweed class=slnt>اْ</tajweed> يَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>أَيُّهَا <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى نُزِّلَ عَلَيْهِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>ذِّكْرُ إِ<tajweed class=ghunnah>نّ</tajweed>َكَ لَمَ<tajweed class=qalaqah>جْ</tajweed>ن<tajweed class=madda_permissible>ُو</tajweed>نٌ <span class=end>٦</span>","End":"٦","PageNumber":262,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":218,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":7,"ShowSurahName":false,"ShowBismillah":false,"Text":"لَّوۡمَا تَأۡتِينَا بِٱلۡمَلَـٰٓئِكَةِ إِن كُنتَ مِنَ ٱلصَّـٰدِقِينَ","TajweedText":"لَّوْ مَا تَأْتِينَا بِ<tajweed class=ham_wasl>ٱ</tajweed>لْمَلَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ئِكَةِ إِ<tajweed class=ikhafa>ن ك</tajweed>ُ<tajweed class=ikhafa>نت</tajweed>َ مِنَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>صَّ<tajweed class=madda_normal>ـٰ</tajweed>دِق<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٧</span>","End":"٧","PageNumber":262,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":218,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":8,"ShowSurahName":false,"ShowBismillah":false,"Text":"مَا نُنَزِّلُ ٱلۡمَلَـٰٓئِكَةَ إِلَّا بِٱلۡحَقِّ وَمَا كَانُوٓاْ إِذٗا مُّنظَرِينَ","TajweedText":"مَا نُنَزِّلُ <tajweed class=ham_wasl>ٱ</tajweed>لْمَلَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ئِكَةَ إِلَّا بِ<tajweed class=ham_wasl>ٱ</tajweed>لْحَقِّ وَمَا كَان<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> إِ<tajweed class=idgham_ghunnah>ذًا م</tajweed>ُّ<tajweed class=ikhafa>نظ</tajweed>َر<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٨</span>","End":"٨","PageNumber":262,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":218,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":9,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّا نَحۡنُ نَزَّلۡنَا ٱلذِّكۡرَ وَإِنَّا لَهُۥ لَحَٰفِظُونَ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َا نَحْنُ نَزَّلْنَا <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>ذِّكْرَ وَإِ<tajweed class=ghunnah>نّ</tajweed>َا لَهُ<tajweed class=madda_normal>ۥ</tajweed> لَحَ<tajweed class=madda_normal>ـٰ</tajweed>فِظ<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٩</span>","End":"٩","PageNumber":262,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":218,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":10,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَقَدۡ أَرۡسَلۡنَا مِن قَبۡلِكَ فِي شِيَعِ ٱلۡأَوَّلِينَ","TajweedText":"وَلَقَ<tajweed class=qalaqah>دْ</tajweed> أَرْسَلْنَا مِ<tajweed class=ikhafa>ن ق</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>لِكَ فِى شِيَعِ <tajweed class=ham_wasl>ٱ</tajweed>لْأَوَّل<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٠</span>","End":"١٠","PageNumber":262,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":218,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":11,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَا يَأۡتِيهِم مِّن رَّسُولٍ إِلَّا كَانُواْ بِهِۦ يَسۡتَهۡزِءُونَ","TajweedText":"وَمَا يَأْتِيه<tajweed class=idgham_shafawi>ِم م</tajweed>ّ<tajweed class=idgham_wo_ghunnah>ِن ر</tajweed>َّسُولٍ إِلَّا كَانُو<tajweed class=slnt>اْ</tajweed> بِه<tajweed class=madda_normal>ِۦ</tajweed> يَسْتَهْزِء<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١١</span>","End":"١١","PageNumber":262,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":218,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":12,"ShowSurahName":false,"ShowBismillah":false,"Text":"كَذَٰلِكَ نَسۡلُكُهُۥ فِي قُلُوبِ ٱلۡمُجۡرِمِينَ","TajweedText":"كَذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ نَسْلُكُهُ<tajweed class=madda_normal>ۥ</tajweed> فِى قُلُوبِ <tajweed class=ham_wasl>ٱ</tajweed>لْمُ<tajweed class=qalaqah>جْ</tajweed>رِم<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٢</span>","End":"١٢","PageNumber":262,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":218,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":13,"ShowSurahName":false,"ShowBismillah":false,"Text":"لَا يُؤۡمِنُونَ بِهِۦ وَقَدۡ خَلَتۡ سُنَّةُ ٱلۡأَوَّلِينَ","TajweedText":"لَا يُؤْمِنُونَ بِه<tajweed class=madda_normal>ِۦ</tajweed>‌ۖ وَقَ<tajweed class=qalaqah>دْ</tajweed> خَلَتْ سُ<tajweed class=ghunnah>نّ</tajweed>َةُ <tajweed class=ham_wasl>ٱ</tajweed>لْأَوَّل<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٣</span>","End":"١٣","PageNumber":262,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":218,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":14,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَوۡ فَتَحۡنَا عَلَيۡهِم بَابٗا مِّنَ ٱلسَّمَآءِ فَظَلُّواْ فِيهِ يَعۡرُجُونَ","TajweedText":"وَلَوْ فَتَحْنَا عَلَيْه<tajweed class=ikhafa_shafawi>ِم ب</tajweed>َا<tajweed class=idgham_ghunnah>بًا م</tajweed>ِّنَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّم<tajweed class=madda_obligatory>َا</tajweed>ٓءِ فَظَلُّو<tajweed class=slnt>اْ</tajweed> فِيهِ يَعْرُج<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٤</span>","End":"١٤","PageNumber":262,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":218,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":15,"ShowSurahName":false,"ShowBismillah":false,"Text":"لَقَالُوٓاْ إِنَّمَا سُكِّرَتۡ أَبۡصَٰرُنَا بَلۡ نَحۡنُ قَوۡمٞ مَّسۡحُورُونَ","TajweedText":"لَقَال<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َمَا سُكِّرَتْ أَ<tajweed class=qalaqah>بْ</tajweed>صَ<tajweed class=madda_normal>ـٰ</tajweed>رُنَا بَلْ نَحْنُ قَوْ<tajweed class=idgham_ghunnah>مٌ م</tajweed>َّسْحُور<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٥</span>","End":"١٥","PageNumber":262,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":218,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":16,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَقَدۡ جَعَلۡنَا فِي ٱلسَّمَآءِ بُرُوجٗا وَزَيَّنَّـٰهَا لِلنَّـٰظِرِينَ","TajweedText":"وَلَقَ<tajweed class=qalaqah>دْ</tajweed> جَعَلْنَا فِى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّم<tajweed class=madda_obligatory>َا</tajweed>ٓءِ بُرُو<tajweed class=idgham_ghunnah>جًا و</tajweed>َزَيَّ<tajweed class=ghunnah>نّ</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed>هَا لِل<tajweed class=ghunnah>نّ</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed>ظِر<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٦</span>","End":"١٦","PageNumber":263,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":219,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":17,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَحَفِظۡنَٰهَا مِن كُلِّ شَيۡطَٰنٖ رَّجِيمٍ","TajweedText":"وَحَفِظْنَ<tajweed class=madda_normal>ـٰ</tajweed>هَا مِ<tajweed class=ikhafa>ن ك</tajweed>ُلِّ شَيْطَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_wo_ghunnah>نٍ ر</tajweed>َّج<tajweed class=madda_permissible>ِي</tajweed>مٍ <span class=end>١٧</span>","End":"١٧","PageNumber":263,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":219,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":18,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِلَّا مَنِ ٱسۡتَرَقَ ٱلسَّمۡعَ فَأَتۡبَعَهُۥ شِهَابٞ مُّبِينٞ","TajweedText":"إِلَّا مَنِ <tajweed class=ham_wasl>ٱ</tajweed>سْتَرَقَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّمْعَ فَأَتْبَعَهُ<tajweed class=madda_normal>ۥ</tajweed> شِهَا<tajweed class=idgham_ghunnah>بٌ م</tajweed>ُّب<tajweed class=madda_permissible>ِي</tajweed>نٌ <span class=end>١٨</span>","End":"١٨","PageNumber":263,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":219,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":19,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَٱلۡأَرۡضَ مَدَدۡنَٰهَا وَأَلۡقَيۡنَا فِيهَا رَوَٰسِيَ وَأَنۢبَتۡنَا فِيهَا مِن كُلِّ شَيۡءٖ مَّوۡزُونٖ","TajweedText":"وَ<tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضَ مَدَ<tajweed class=qalaqah>دْ</tajweed>نَ<tajweed class=madda_normal>ـٰ</tajweed>هَا وَأَلْقَيْنَا فِيهَا رَو<tajweed class=madda_normal>َٲ</tajweed>سِىَ وَأَ<tajweed class=iqlab>نۢب</tajweed>َتْنَا فِيهَا مِ<tajweed class=ikhafa>ن ك</tajweed>ُلِّ ش<tajweed class=idgham_ghunnah>َىْءٍ م</tajweed>َّوْز<tajweed class=madda_permissible>ُو</tajweed>نٍ <span class=end>١٩</span>","End":"١٩","PageNumber":263,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":219,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":20,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَجَعَلۡنَا لَكُمۡ فِيهَا مَعَٰيِشَ وَمَن لَّسۡتُمۡ لَهُۥ بِرَٰزِقِينَ","TajweedText":"وَجَعَلْنَا لَكُمْ فِيهَا مَعَ<tajweed class=madda_normal>ـٰ</tajweed>يِشَ وَم<tajweed class=idgham_wo_ghunnah>َن ل</tajweed>َّسْتُمْ لَهُ<tajweed class=madda_normal>ۥ</tajweed> بِر<tajweed class=madda_normal>َٲ</tajweed>زِق<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٢٠</span>","End":"٢٠","PageNumber":263,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":219,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":21,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِن مِّن شَيۡءٍ إِلَّا عِندَنَا خَزَآئِنُهُۥ وَمَا نُنَزِّلُهُۥٓ إِلَّا بِقَدَرٖ مَّعۡلُومٖ","TajweedText":"وَإ<tajweed class=idgham_ghunnah>ِن م</tajweed>ِّ<tajweed class=ikhafa>ن ش</tajweed>َىْءٍ إِلَّا عِ<tajweed class=ikhafa>ند</tajweed>َنَا خَز<tajweed class=madda_obligatory>َا</tajweed>ٓئِنُهُ<tajweed class=madda_normal>ۥ</tajweed> وَمَا نُنَزِّلُهُ<tajweed class=madda_obligatory>ۥٓ</tajweed> إِلَّا بِقَدَ<tajweed class=idgham_ghunnah>رٍ م</tajweed>َّعْل<tajweed class=madda_permissible>ُو</tajweed>مٍ <span class=end>٢١</span>","End":"٢١","PageNumber":263,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":219,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":22,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَأَرۡسَلۡنَا ٱلرِّيَٰحَ لَوَٰقِحَ فَأَنزَلۡنَا مِنَ ٱلسَّمَآءِ مَآءٗ فَأَسۡقَيۡنَٰكُمُوهُ وَمَآ أَنتُمۡ لَهُۥ بِخَٰزِنِينَ","TajweedText":"وَأَرْسَلْنَا <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رِّيَ<tajweed class=madda_normal>ـٰ</tajweed>حَ لَو<tajweed class=madda_normal>َٲ</tajweed>قِحَ فَأَ<tajweed class=ikhafa>نز</tajweed>َلْنَا مِنَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّم<tajweed class=madda_obligatory>َا</tajweed>ٓءِ م<tajweed class=madda_obligatory>َا</tajweed>ٓ<tajweed class=ikhafa>ءً ف</tajweed>َأَسْقَيْنَ<tajweed class=madda_normal>ـٰ</tajweed>كُمُوهُ وَم<tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=ikhafa>نت</tajweed>ُمْ لَهُ<tajweed class=madda_normal>ۥ</tajweed> بِخَ<tajweed class=madda_normal>ـٰ</tajweed>زِن<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٢٢</span>","End":"٢٢","PageNumber":263,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":219,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":23,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِنَّا لَنَحۡنُ نُحۡيِۦ وَنُمِيتُ وَنَحۡنُ ٱلۡوَٰرِثُونَ","TajweedText":"وَإِ<tajweed class=ghunnah>نّ</tajweed>َا لَنَحْنُ نُحْى<tajweed class=madda_normal>ِۦ</tajweed> وَنُمِيتُ وَنَحْنُ <tajweed class=ham_wasl>ٱ</tajweed>لْو<tajweed class=madda_normal>َٲ</tajweed>رِث<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٣</span>","End":"٢٣","PageNumber":263,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":219,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":24,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَقَدۡ عَلِمۡنَا ٱلۡمُسۡتَقۡدِمِينَ مِنكُمۡ وَلَقَدۡ عَلِمۡنَا ٱلۡمُسۡتَـٔۡخِرِينَ","TajweedText":"وَلَقَ<tajweed class=qalaqah>دْ</tajweed> عَلِمْنَا <tajweed class=ham_wasl>ٱ</tajweed>لْمُسْتَ<tajweed class=qalaqah>قْ</tajweed>دِمِينَ مِ<tajweed class=ikhafa>نك</tajweed>ُمْ وَلَقَ<tajweed class=qalaqah>دْ</tajweed> عَلِمْنَا <tajweed class=ham_wasl>ٱ</tajweed>لْمُسْتَــْٔخِر<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٢٤</span>","End":"٢٤","PageNumber":263,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":219,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":25,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِنَّ رَبَّكَ هُوَ يَحۡشُرُهُمۡۚ إِنَّهُۥ حَكِيمٌ عَلِيمٞ","TajweedText":"وَإِ<tajweed class=ghunnah>نّ</tajweed>َ رَبَّكَ هُوَ يَحْشُرُهُمْ‌ۚ إِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> حَكِيمٌ عَل<tajweed class=madda_permissible>ِي</tajweed>مٌ <span class=end>٢٥</span>","End":"٢٥","PageNumber":263,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":219,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":26,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ مِن صَلۡصَٰلٖ مِّنۡ حَمَإٖ مَّسۡنُونٖ","TajweedText":"وَلَقَ<tajweed class=qalaqah>دْ</tajweed> خَلَ<tajweed class=qalaqah>قْ</tajweed>نَا <tajweed class=ham_wasl>ٱ</tajweed>لْإِ<tajweed class=ikhafa>نس</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed>نَ مِ<tajweed class=ikhafa>ن ص</tajweed>َلْصَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>لٍ م</tajweed>ِّنْ حَمَ<tajweed class=idgham_ghunnah>إٍ م</tajweed>َّسْن<tajweed class=madda_permissible>ُو</tajweed>نٍ <span class=end>٢٦</span>","End":"٢٦","PageNumber":263,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":220,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":27,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَٱلۡجَآنَّ خَلَقۡنَٰهُ مِن قَبۡلُ مِن نَّارِ ٱلسَّمُومِ","TajweedText":"وَ<tajweed class=ham_wasl>ٱ</tajweed>لْج<tajweed class=madda_necessary>َا</tajweed>ٓ<tajweed class=ghunnah>نّ</tajweed>َ خَلَ<tajweed class=qalaqah>قْ</tajweed>نَ<tajweed class=madda_normal>ـٰ</tajweed>هُ مِ<tajweed class=ikhafa>ن ق</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>لُ م<tajweed class=idgham_ghunnah>ِن ن</tajweed>َّارِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّم<tajweed class=madda_permissible>ُو</tajweed>مِ <span class=end>٢٧</span>","End":"٢٧","PageNumber":263,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":220,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":28,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِذۡ قَالَ رَبُّكَ لِلۡمَلَـٰٓئِكَةِ إِنِّي خَٰلِقُۢ بَشَرٗا مِّن صَلۡصَٰلٖ مِّنۡ حَمَإٖ مَّسۡنُونٖ","TajweedText":"وَإِذْ قَالَ رَبُّكَ لِلْمَلَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ئِكَةِ إِ<tajweed class=ghunnah>نّ</tajweed>ِى خَ<tajweed class=madda_normal>ـٰ</tajweed>لِ<tajweed class=iqlab>قُۢ ب</tajweed>َشَ<tajweed class=idgham_ghunnah>رًا م</tajweed>ِّ<tajweed class=ikhafa>ن ص</tajweed>َلْصَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>لٍ م</tajweed>ِّنْ حَمَ<tajweed class=idgham_ghunnah>إٍ م</tajweed>َّسْن<tajweed class=madda_permissible>ُو</tajweed>نٍ <span class=end>٢٨</span>","End":"٢٨","PageNumber":263,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":220,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":29,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَإِذَا سَوَّيۡتُهُۥ وَنَفَخۡتُ فِيهِ مِن رُّوحِي فَقَعُواْ لَهُۥ سَٰجِدِينَ","TajweedText":"فَإِذَا سَوَّيْتُهُ<tajweed class=madda_normal>ۥ</tajweed> وَنَفَخْتُ فِيهِ م<tajweed class=idgham_wo_ghunnah>ِن ر</tajweed>ُّوحِى فَقَعُو<tajweed class=slnt>اْ</tajweed> لَهُ<tajweed class=madda_normal>ۥ</tajweed> سَ<tajweed class=madda_normal>ـٰ</tajweed>جِد<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٢٩</span>","End":"٢٩","PageNumber":263,"JuzNumbe