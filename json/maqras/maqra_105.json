_permissible>ِي</tajweed>نَ <span class=end>٤٦</span>","End":"٤٦","PageNumber":264,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":221,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":47,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَنَزَعۡنَا مَا فِي صُدُورِهِم مِّنۡ غِلٍّ إِخۡوَٰنًا عَلَىٰ سُرُرٖ مُّتَقَٰبِلِينَ","TajweedText":"وَنَزَعْنَا مَا فِى صُدُورِه<tajweed class=idgham_shafawi>ِم م</tajweed>ِّنْ غِلٍّ إِخْو<tajweed class=madda_normal>َٲ</tajweed>نًا عَلَىٰ سُرُ<tajweed class=idgham_ghunnah>رٍ م</tajweed>ُّتَقَ<tajweed class=madda_normal>ـٰ</tajweed>بِل<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٤٧</span>","End":"٤٧","PageNumber":264,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":221,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":48,"ShowSurahName":false,"ShowBismillah":false,"Text":"لَا يَمَسُّهُمۡ فِيهَا نَصَبٞ وَمَا هُم مِّنۡهَا بِمُخۡرَجِينَ","TajweedText":"لَا يَمَسُّهُمْ فِيهَا نَصَ<tajweed class=idgham_ghunnah>بٌ و</tajweed>َمَا ه<tajweed class=idgham_shafawi>ُم م</tajweed>ِّنْهَا بِمُخْرَج<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٤٨</span>","End":"٤٨","PageNumber":264,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":221,"MaqraNumber":105,"HizbNumber":27,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":15,"SurahIndex":"015","VerseNumber":49,"ShowSurahName":false,"ShowBismillah":false,"Text":"۞نَبِّئۡ عِبَادِيٓ أَنِّيٓ أَنَا ٱلۡغَفُورُ ٱلرَّحِيمُ","TajweedText":"۞ نَبِّئْ عِبَاد<tajweed class=madda_obligatory>ِىٓ</tajweed> أَ<tajweed class=ghunnah>نّ</tajweed><tajweed class=madda_obligatory>ِىٓ</tajweed> أَنَا <tajweed class=ham_wasl>ٱ</tajweed>لْغَفُورُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رَّح<tajweed class=madda_permissible>ِي</tajweed>مُ <span class=end>٤٩</span>","End":"٤٩","PageNumber":264,"JuzNumber":14,"ManzilNumber":3,"