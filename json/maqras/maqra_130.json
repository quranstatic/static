{"MaqraNumber":130.0,"Verses":[{"SurahNumber":21,"SurahIndex":"021","VerseNumber":29,"ShowSurahName":false,"ShowBismillah":false,"Text":"۞وَمَن يَقُلۡ مِنۡهُمۡ إِنِّيٓ إِلَٰهٞ مِّن دُونِهِۦ فَذَٰلِكَ نَجۡزِيهِ جَهَنَّمَۚ كَذَٰلِكَ نَجۡزِي ٱلظَّـٰلِمِينَ","TajweedText":"۞ وَم<tajweed class=idgham_ghunnah>َن ي</tajweed>َقُلْ مِنْهُمْ إِ<tajweed class=ghunnah>نّ</tajweed><tajweed class=madda_obligatory>ِىٓ</tajweed> إِلَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>هٌ م</tajweed>ِّ<tajweed class=ikhafa>ن د</tajweed>ُونِه<tajweed class=madda_normal>ِۦ</tajweed> فَذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ نَ<tajweed class=qalaqah>جْ</tajweed>زِيهِ جَهَ<tajweed class=ghunnah>نّ</tajweed>َمَ‌ۚ كَذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ نَ<tajweed class=qalaqah>جْ</tajweed>زِى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>ظَّ<tajweed class=madda_normal>ـٰ</tajweed>لِم<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٢٩</span>","End":"٢٩","PageNumber":324,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":279,"MaqraNumber":130,"HizbNumber":33,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":30,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَوَلَمۡ يَرَ ٱلَّذِينَ كَفَرُوٓاْ أَنَّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ كَانَتَا رَتۡقٗا فَفَتَقۡنَٰهُمَاۖ وَجَعَلۡنَا مِنَ ٱلۡمَآءِ كُلَّ شَيۡءٍ حَيٍّۚ أَفَلَا يُؤۡمِنُونَ","TajweedText":"أَوَلَمْ يَرَ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ كَفَر<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> أَ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّمَ<tajweed class=madda_normal>ـٰ</tajweed>و<tajweed class=madda_normal>َٲ</tajweed>تِ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضَ كَانَتَا رَتْ<tajweed class=ikhafa>قًا ف</tajweed>َفَتَ<tajweed class=qalaqah>قْ</tajweed>نَ<tajweed class=madda_normal>ـٰ</tajweed>هُمَا‌ۖ وَجَعَلْنَا مِنَ <tajweed class=ham_wasl>ٱ</tajweed>لْم<tajweed class=madda_obligatory>َا</tajweed>ٓءِ كُلَّ شَىْءٍ حَىٍّ‌ۖ أَفَلَا يُؤْمِن<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣٠</span>","End":"٣٠","PageNumber":324,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":280,"MaqraNumber":130,"HizbNumber":33,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":31,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَجَعَلۡنَا فِي ٱلۡأَرۡضِ رَوَٰسِيَ أَن تَمِيدَ بِهِمۡ وَجَعَلۡنَا فِيهَا فِجَاجٗا سُبُلٗا لَّعَلَّهُمۡ يَهۡتَدُونَ","TajweedText":"وَجَعَلْنَا فِى <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ رَو<tajweed class=madda_normal>َٲ</tajweed>سِىَ أَ<tajweed class=ikhafa>ن ت</tajweed>َمِيدَ بِهِمْ وَجَعَلْنَا فِيهَا فِجَا<tajweed class=ikhafa>جًا س</tajweed>ُبُل<tajweed class=idgham_wo_ghunnah>اً ل</tajweed>َّعَلَّهُمْ يَهْتَد<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣١</span>","End":"٣١","PageNumber":324,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":280,"MaqraNumber":130,"HizbNumber":33,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":32,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَجَعَلۡنَا ٱلسَّمَآءَ سَقۡفٗا مَّحۡفُوظٗاۖ وَهُمۡ عَنۡ ءَايَٰتِهَا مُعۡرِضُونَ","TajweedText":"وَجَعَلْنَا <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّم<tajweed class=madda_obligatory>َا</tajweed>ٓءَ سَ<tajweed class=qalaqah>قْ</tajweed><tajweed class=idgham_ghunnah>فًا م</tajweed>َّحْفُو<tajweed class=idgham_ghunnah>ظًا‌ۖ و</tajweed>َهُمْ عَنْ ءَايَ<tajweed class=madda_normal>ـٰ</tajweed>تِهَا مُعْرِض<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣٢</span>","End":"٣٢","PageNumber":324,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":280,"MaqraNumber":130,"HizbNumber":33,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":33,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَهُوَ ٱلَّذِي خَلَقَ ٱلَّيۡلَ وَٱلنَّهَارَ وَٱلشَّمۡسَ وَٱلۡقَمَرَۖ كُلّٞ فِي فَلَكٖ يَسۡبَحُونَ","TajweedText":"وَهُوَ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى خَلَقَ <tajweed class=ham_wasl>ٱ</tajweed>لَّيْلَ وَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َهَارَ وَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>شَّمْسَ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْقَمَرَ‌ۖ كُ<tajweed class=ikhafa>لٌّ ف</tajweed>ِى فَلَ<tajweed class=idgham_ghunnah>كٍ ي</tajweed>َسْبَح<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣٣</span>","End":"٣٣","PageNumber":324,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":280,"MaqraNumber":130,"HizbNumber":33,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":34,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَا جَعَلۡنَا لِبَشَرٖ مِّن قَبۡلِكَ ٱلۡخُلۡدَۖ أَفَإِيْن مِّتَّ فَهُمُ ٱلۡخَٰلِدُونَ","TajweedText":"وَمَا جَعَلْنَا لِبَشَ<tajweed class=idgham_ghunnah>رٍ م</tajweed>ِّ<tajweed class=ikhafa>ن ق</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>لِكَ <tajweed class=ham_wasl>ٱ</tajweed>لْخُلْدَ‌ۖ أَفَإِ<tajweed class=slnt>يْ</tajweed><tajweed class=idgham_ghunnah>ن م</tajweed>ِّتَّ فَهُمُ <tajweed class=ham_wasl>ٱ</tajweed>لْخَ<tajweed class=madda_normal>ـٰ</tajweed>لِد<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣٤</span>","End":"٣٤","PageNumber":324,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":280,"MaqraNumber":130,"HizbNumber":33,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":35,"ShowSurahName":false,"ShowBismillah":false,"Text":"كُلُّ نَفۡسٖ ذَآئِقَةُ ٱلۡمَوۡتِۗ وَنَبۡلُوكُم بِٱلشَّرِّ وَٱلۡخَيۡرِ فِتۡنَةٗۖ وَإِلَيۡنَا تُرۡجَعُونَ","TajweedText":"كُلُّ نَفْ<tajweed class=ikhafa>سٍ ذ</tajweed><tajweed class=madda_obligatory>َا</tajweed>ٓئِقَةُ <tajweed class=ham_wasl>ٱ</tajweed>لْمَوْتِ‌ۗ وَنَ<tajweed class=qalaqah>بْ</tajweed>لُوك<tajweed class=ikhafa_shafawi>ُ