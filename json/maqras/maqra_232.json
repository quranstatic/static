weed class=ham_wasl>ٱ</tajweed>سْمَ رَبِّكَ بُكْرَ<tajweed class=idgham_ghunnah>ةً و</tajweed>َأَصِيلاً <span class=end>٢٥</span>","End":"٢٥","PageNumber":579,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":515,"MaqraNumber":232,"HizbNumber":58,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":76,"SurahIndex":"076","VerseNumber":26,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمِنَ ٱلَّيۡلِ فَٱسۡجُدۡ لَهُۥ وَسَبِّحۡهُ لَيۡلٗا طَوِيلًا","TajweedText":"وَمِنَ <tajweed class=ham_wasl>ٱ</tajweed>لَّيْلِ فَ<tajweed class=ham_wasl>ٱ</tajweed>سْجُ<tajweed class=qalaqah>دْ</tajweed> لَهُ<tajweed class=madda_normal>ۥ</tajweed> وَسَبِّحْهُ لَيْل<tajweed class=ikhafa>اً ط</tajweed>َوِيلاً <span class=end>٢٦</span>","End":"٢٦","PageNumber":580,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":515,"MaqraNumber":232,"HizbNumber":58,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":76,"SurahIndex":"076","VerseNumber":27,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّ هَـٰٓؤُلَآءِ يُحِبُّونَ ٱلۡعَاجِلَةَ وَيَذَرُونَ وَرَآءَهُمۡ يَوۡمٗا ثَقِيلٗا","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َ هَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ؤُل<tajweed class=madda_obligatory>َا</tajweed>ٓءِ يُحِبُّونَ <tajweed class=ham_wasl>ٱ</tajweed>لْعَاجِلَةَ وَيَذَرُونَ وَر<tajweed class=madda_obligatory>َا</tajweed>ٓءَهُمْ يَوْ<tajweed class=ikhafa>مًا ث</tajweed>َقِيلاً <span class=end>٢٧</span>","End":"٢٧","PageNumber":580,"JuzNumber":29,"ManzilNumber":7,"RukuNumber":515,"MaqraNumber":232,"HizbNumber":58,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":76,"SurahIndex":"076","VerseNumber":28,"ShowSurahName":false,"ShowBismillah":false,"Text":"نَّحۡنُ خَلَقۡنَٰهُمۡ وَشَدَدۡنَآ أَسۡرَهُمۡۖ وَإِذَا شِئۡنَا بَدَّلۡنَآ أَمۡثَٰلَهُمۡ تَبۡدِيلًا","TajweedText":"نَّحْنُ خَلَ<tajweed class=qalaqah>قْ</tajweed>نَ<tajweed class=madda_normal>ـٰ</tajweed>هُمْ وَشَدَ<tajweed class=qalaqah>دْ</tajweed>ن<tajweed class=madda_obligatory>َآ</tajweed> أَسْرَهُمْ‌ۖ وَإِذَا شِئْنَا بَدّ