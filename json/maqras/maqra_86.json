{"MaqraNumber":86.0,"Verses":[{"SurahNumber":10,"SurahIndex":"010","VerseNumber":53,"ShowSurahName":false,"ShowBismillah":false,"Text":"۞وَيَسۡتَنۢبِـُٔونَكَ أَحَقٌّ هُوَۖ قُلۡ إِي وَرَبِّيٓ إِنَّهُۥ لَحَقّٞۖ وَمَآ أَنتُم بِمُعۡجِزِينَ","TajweedText":"۞ وَيَسْتَ<tajweed class=iqlab>نۢب</tajweed>ِــُٔونَكَ أَحَقٌّ هُوَ‌ۖ قُلْ إِى وَرَبّ<tajweed class=madda_obligatory>ِىٓ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> لَحَ<tajweed class=idgham_ghunnah>قٌّ‌ۖ و</tajweed>َم<tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=ikhafa>نت</tajweed><tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِمُعْجِز<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٥٣</span>","End":"٥٣","PageNumber":214,"JuzNumber":11,"ManzilNumber":3,"RukuNumber":176,"MaqraNumber":86,"HizbNumber":22,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":10,"SurahIndex":"010","VerseNumber":54,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَوۡ أَنَّ لِكُلِّ نَفۡسٖ ظَلَمَتۡ مَا فِي ٱلۡأَرۡضِ لَٱفۡتَدَتۡ بِهِۦۗ وَأَسَرُّواْ ٱلنَّدَامَةَ لَمَّا رَأَوُاْ ٱلۡعَذَابَۖ وَقُضِيَ بَيۡنَهُم بِٱلۡقِسۡطِ وَهُمۡ لَا يُظۡلَمُونَ","TajweedText":"وَلَوْ أَ<tajweed class=ghunnah>نّ</tajweed>َ لِكُلِّ نَفْ<tajweed class=ikhafa>سٍ ظ</tajweed>َلَمَتْ مَا فِى <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ لَ<tajweed class=ham_wasl>ٱ</tajweed>فْتَدَتْ بِه<tajweed class=madda_normal>ِۦ</tajweed>‌ۗ وَأَسَرُّو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َدَامَةَ لَ<tajweed class=ghunnah>مّ</tajweed>َا رَأَوُ<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed>لْعَذَابَ‌ۖ وَقُضِىَ بَيْنَه<tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِ<tajweed class=ham_wasl>ٱ</tajweed>لْقِسْطِ‌ۚ وَهُمْ لَا يُظْلَم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٥٤</span>","End":"٥٤","PageNumber":215,"JuzNumber":11,"ManzilNumber":3,"RukuNumber":177,"MaqraNumbe