eed class=madda_obligatory>ىٰٓ</tajweed> ءَاثَ<tajweed class=madda_normal>ـٰ</tajweed>رِ رَحْمَتِ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ كَيْفَ يُحْىِ <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضَ بَعْدَ مَوْتِه<tajweed class=madda_obligatory>َآ‌ۚ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َ ذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ لَمُحْىِ <tajweed class=ham_wasl>ٱ</tajweed>لْمَوْتَىٰ‌ۖ وَهُوَ عَلَىٰ كُلِّ ش<tajweed class=ikhafa>َىْءٍ ق</tajweed>َد<tajweed class=madda_permissible>ِي</tajweed>رٌ <span class=end>٥٠</span>","End":"٥٠","PageNumber":409,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":353,"MaqraNumber":163,"HizbNumber":41,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":30,"SurahIndex":"030","VerseNumber":51,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَئِنۡ أَرۡسَلۡنَا رِيحٗا فَرَأَوۡهُ مُصۡفَرّٗا لَّظَلُّواْ مِنۢ بَعۡدِهِۦ يَكۡفُرُونَ","TajweedText":"وَلَئِنْ أَرْسَلْنَا رِي<tajweed class=ikhafa>حًا ف</tajweed>َرَأَوْهُ مُصْفَر<tajweed class=idgham_wo_ghunnah>ًّا ل</tajweed>َّظَلُّو<tajweed class=slnt>اْ</tajweed> م<tajweed class=iqlab>ِنۢ ب</tajweed>َعْدِه<tajweed class=madda_normal>ِۦ</tajweed> يَكْفُر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٥١</span>","End":"٥١","PageNumber":410,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":353,"MaqraNumber":163,"HizbNumber":41,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":30,"SurahIndex":"030","VerseNumber":52,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَإِنَّكَ لَا تُسۡمِعُ ٱلۡمَوۡتَىٰ وَلَا تُسۡمِعُ ٱلصُّمَّ ٱلدُّعَآءَ إِذَا وَلَّوۡاْ مُدۡبِرِينَ","TajweedText":"فَإِ<tajweed class=ghunnah>نّ</tajweed>َكَ لَا تُسْمِعُ <tajweed class=ham_wasl>ٱ</tajweed>لْمَوْتَىٰ وَلَا تُسْمِعُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>صُّ<tajweed class=ghunnah>مّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>دُّع<tajweed class=madda_obligatory>َا</tajweed>ٓءَ إِذَا وَلَّوْ<tajweed class=slnt>اْ</tajweed> مُ<tajweed class=qalaqah>دْ</tajweed>بِر<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٥٢</span>","End":"٥٢","PageNumber":410,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":353,"MaqraNumber":163,"HizbNumber":41,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":30,"SurahIndex":"030","VerseNumber":53,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَآ أَنتَ بِهَٰدِ ٱلۡعُمۡيِ عَن ضَلَٰلَتِهِمۡۖ إِن تُسۡمِعُ إِلَّا مَن يُؤۡمِنُ بِـَٔايَٰتِنَا فَهُم مُّسۡلِمُونَ","TajweedText":"وَم<tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=ikhafa>نت</tajweed>َ بِهَ<tajweed class=madda_normal>ـٰ</tajweed>دِ <tajweed class=ham_wasl>ٱ</tajweed>لْعُمْىِ عَ<tajweed class=ikhafa>ن ض</tajweed>َلَ<tajweed class=madda_normal>ـٰ</tajweed>لَتِهِمْ‌ۖ إِ<tajweed class=ikhafa>ن ت</tajweed>ُسْمِعُ إِلَّا م<tajweed class=idgham_ghunnah>َن ي</tajweed>ُؤْمِنُ بِـَٔـايَ<tajweed class=madda_normal>ـٰ</tajweed>تِنَا فَه<tajweed class=idgham_shafawi>ُم م</tajweed>ُّسْلِم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٥٣</span>","End":"٥٣","PageNumber":410,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":353,"MaqraNumber":163,"HizbNumber":41,"HizbDecimal":0.5,"HasSajda":false}]}