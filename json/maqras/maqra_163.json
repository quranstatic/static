{"MaqraNumber":163.0,"Verses":[{"SurahNumber":30,"SurahIndex":"030","VerseNumber":31,"ShowSurahName":false,"ShowBismillah":false,"Text":"۞مُنِيبِينَ إِلَيۡهِ وَٱتَّقُوهُ وَأَقِيمُواْ ٱلصَّلَوٰةَ وَلَا تَكُونُواْ مِنَ ٱلۡمُشۡرِكِينَ","TajweedText":"۞ مُنِيبِينَ إِلَيْهِ وَ<tajweed class=ham_wasl>ٱ</tajweed>تَّقُوهُ وَأَقِيمُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>صَّلَ<tajweed class=slnt>و</tajweed><tajweed class=madda_normal>ٲ</tajweed>ةَ وَلَا تَكُونُو<tajweed class=slnt>اْ</tajweed> مِنَ <tajweed class=ham_wasl>ٱ</tajweed>لْمُشْرِك<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٣١</span>","End":"٣١","PageNumber":407,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":352,"MaqraNumber":163,"HizbNumber":41,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":30,"SurahIndex":"030","VerseNumber":32,"ShowSurahName":false,"ShowBismillah":false,"Text":"مِنَ ٱلَّذِينَ فَرَّقُواْ دِينَهُمۡ وَكَانُواْ شِيَعٗاۖ كُلُّ حِزۡبِۭ بِمَا لَدَيۡهِمۡ فَرِحُونَ","TajweedText":"مِنَ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ فَرَّقُو<tajweed class=slnt>اْ</tajweed> دِينَهُمْ وَكَانُو<tajweed class=slnt>اْ</tajweed> شِيَ<tajweed class=ikhafa>عًا‌ۖ ك</tajweed>ُلُّ حِزْ<tajweed class=iqlab>بِۭ ب</tajweed>ِمَا لَدَيْهِمْ فَرِح<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣٢</span>","End":"٣٢","PageNumber":407,"JuzNumber":21,"ManzilNumber":5,"RukuNumber":352,"MaqraNumber":163,"HizbNumber":41,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":30,"SurahIndex":"030","VerseNumber":33,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِذَا مَسَّ ٱلنَّاسَ ضُرّٞ دَعَوۡاْ رَبَّهُم مُّنِيبِينَ إِلَيۡهِ ثُمَّ إِذَآ أَذَاقَهُم مِّنۡهُ رَحۡمَةً إِذَا فَرِيقٞ مِّنۡهُم بِرَبِّهِمۡ يُشۡرِكُونَ","TajweedText":"وَإِذَا مَسَّ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َاسَ ضُ<tajweed class=ikhafa>رٌّ د</tajweed>َعَوْ<tajweed class=slnt>اْ</ta