><tajweed class=slnt>اْ</tajweed> أَءِذَا كُ<tajweed class=ghunnah>نّ</tajweed>َا تُر<tajweed class=madda_normal>َٲ</tajweed><tajweed class=idgham_ghunnah>بًا و</tajweed>َءَاب<tajweed class=madda_obligatory>َا</tajweed>ٓؤُن<tajweed class=madda_obligatory>َآ</tajweed> أَئِ<tajweed class=ghunnah>نّ</tajweed>َا لَمُخْرَج<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٧</span>","End":"٦٧","PageNumber":383,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":332,"MaqraNumber":153,"HizbNumber":39,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":68,"ShowSurahName":false,"ShowBismillah":false,"Text":"لَقَدۡ وُعِدۡنَا هَٰذَا نَحۡنُ وَءَابَآؤُنَا مِن قَبۡلُ إِنۡ هَٰذَآ إِلَّآ أَسَٰطِيرُ ٱلۡأَوَّلِينَ","TajweedText":"لَقَ<tajweed class=qalaqah>دْ</tajweed> وُعِ<tajweed class=qalaqah>دْ</tajweed>نَا هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا نَحْنُ وَءَاب<tajweed class=madda_obligatory>َا</tajweed>ٓؤُنَا مِ<tajweed class=ikhafa>ن ق</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>لُ إِنْ هَ<tajweed class=madda_normal>ـٰ</tajweed>ذ<tajweed class=madda_obligatory>َآ</tajweed> إِلّ<tajweed class=madda_obligatory>َآ</tajweed> أَسَ<tajweed class=madda_normal>ـٰ</tajweed>طِيرُ <tajweed class=ham_wasl>ٱ</tajweed>لْأَوَّل<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٦٨</span>","End":"٦٨","PageNumber":383,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":332,"MaqraNumber":153,"HizbNumber":39,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":69,"ShowSurahName":false,"ShowBismillah":false,"Text":"قُلۡ سِيرُواْ فِي ٱلۡأَرۡضِ فَٱنظُرُواْ كَيۡفَ كَانَ عَٰقِبَةُ ٱلۡمُجۡرِمِينَ","TajweedText":"قُلْ سِيرُو<tajweed class=slnt>اْ</tajweed> فِى <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ فَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=ikhafa>نظ</tajweed>ُرُو<tajweed class=slnt>اْ</tajweed> كَيْفَ كَانَ عَ<tajweed class=madda_normal>ـٰ</tajweed>قِبَةُ <tajweed class=ham_wasl>ٱ</tajweed>لْمُ<tajweed class=qalaqah>جْ</tajweed>رِم<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٦٩</span>","End":"٦٩","PageNumber":383,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":332,"MaqraNumber":153,"HizbNumber":39,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":70,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَا تَحۡزَنۡ عَلَيۡهِمۡ وَلَا تَكُن فِي ضَيۡقٖ مِّمَّا يَمۡكُرُونَ","TajweedText":"وَلَا تَحْزَنْ عَلَيْهِمْ وَلَا تَكُ<tajweed class=ikhafa>ن ف</tajweed>ِى ضَيْ<tajweed class=idgham_ghunnah>قٍ م</tajweed>ِّ<tajweed class=ghunnah>مّ</tajweed>َا يَمْكُر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٧٠</span>","End":"٧٠","PageNumber":383,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":332,"MaqraNumber":153,"HizbNumber":39,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":71,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَيَقُولُونَ مَتَىٰ هَٰذَا ٱلۡوَعۡدُ إِن كُنتُمۡ صَٰدِقِينَ","TajweedText":"وَيَقُولُونَ مَتَىٰ هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا <tajweed class=ham_wasl>ٱ</tajweed>لْوَعْدُ إِ<tajweed class=ikhafa>ن ك</tajweed>ُ<tajweed class=ikhafa>نت</tajweed>ُمْ صَ<tajweed class=madda_normal>ـٰ</tajweed>دِق<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٧١</span>","End":"٧١","PageNumber":383,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":332,"MaqraNumber":153,"HizbNumber":39,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":72,"ShowSurahName":false,"ShowBismillah":false,"Text":"قُلۡ عَسَىٰٓ أَن يَكُونَ رَدِفَ لَكُم بَعۡضُ ٱلَّذِي تَسۡتَعۡجِلُونَ","TajweedText":"قُلْ عَسَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> أ<tajweed class=idgham_ghunnah>َن ي</tajweed>َكُونَ رَدِفَ لَك<tajweed class=ikhafa_shafawi>ُم ب</tajweed>َعْضُ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى تَسْتَعْجِل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٧٢</span>","End":"٧٢","PageNumber":383,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":332,"MaqraNumber":153,"HizbNumber":39,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":73,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِنَّ رَبَّكَ لَذُو فَضۡلٍ عَلَى ٱلنَّاسِ وَلَٰكِنَّ أَكۡثَرَهُمۡ لَا يَشۡكُرُونَ","TajweedText":"وَإِ<tajweed class=ghunnah>نّ</tajweed>َ رَبَّكَ لَذُو فَضْلٍ عَلَى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َاسِ وَلَ<tajweed class=madda_normal>ـٰ</tajweed>كِ<tajweed class=ghunnah>نّ</tajweed>َ أَكْثَرَهُمْ لَا يَشْكُر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٧٣</span>","End":"٧٣","PageNumber":383,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":332,"MaqraNumber":153,"HizbNumber":39,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":74,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِنَّ رَبَّكَ لَيَعۡلَمُ مَا تُكِنُّ صُدُورُهُمۡ وَمَا يُعۡلِنُونَ","TajweedText":"وَإِ<tajweed class=ghunnah>نّ</tajweed>َ رَبَّكَ لَيَعْلَمُ مَا تُكِ<tajweed class=ghunnah>نّ</tajweed>ُ صُدُورُهُمْ وَمَا يُعْلِن<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٧٤</span>","End":"٧٤","PageNumber":383,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":332,"MaqraNumber":153,"HizbNumber":39,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":75,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَا مِنۡ غَآئِبَةٖ فِي ٱلسَّمَآءِ وَٱلۡأَرۡضِ إِلَّا فِي كِتَٰبٖ مُّبِينٍ","TajweedText":"وَمَا مِنْ غ<tajweed class=madda_obligatory>َا</tajweed>ٓئِبَ<tajweed class=ikhafa>ةٍ ف</tajweed>ِى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّم<tajweed class=madda_obligatory>َا</tajweed>ٓءِ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ إِلَّا فِى كِتَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>بٍ م</tajweed>ُّب<tajweed class=madda_permissible>ِي</tajweed>نٍ <span class=end>٧٥</span>","End":"٧٥","PageNumber":383,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":332,"MaqraNumber":153,"HizbNumber":39,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":76,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّ هَٰذَا ٱلۡقُرۡءَانَ يَقُصُّ عَلَىٰ بَنِيٓ إِسۡرَـٰٓءِيلَ أَكۡثَرَ ٱلَّذِي هُمۡ فِيهِ يَخۡتَلِفُونَ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َ هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا <tajweed class=ham_wasl>ٱ</tajweed>لْقُرْءَانَ يَقُصُّ عَلَىٰ بَن<tajweed class=madda_obligatory>ِىٓ</tajweed> إِسْر<tajweed class=madda_obligatory>َٲ</tajweed>ٓءِيلَ أَكْثَرَ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى هُمْ فِيهِ يَخْتَلِف<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٧٦</span>","End":"٧٦","PageNumber":383,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":332,"MaqraNumber":153,"HizbNumber":39,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":77,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِنَّهُۥ لَهُدٗى وَرَحۡمَةٞ لِّلۡمُؤۡمِنِينَ","TajweedText":"وَإِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> لَهُ<tajweed class=idgham_ghunnah>دًى و</tajweed>َرَحْمَ<tajweed class=idgham_wo_ghunnah>ةٌ ل</tajweed>ِّلْمُؤْمِن<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٧٧</span>","End":"٧٧","PageNumber":384,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":332,"MaqraNumber":153,"HizbNumber":39,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":78,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّ رَبَّكَ يَقۡضِي بَيۡنَهُم بِحُكۡمِهِۦۚ وَهُوَ ٱلۡعَزِيزُ ٱلۡعَلِيمُ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َ رَبَّكَ يَ<tajweed class=qalaqah>قْ</tajweed>ضِى بَيْنَه<tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِحُكْمِه<tajweed class=madda_normal>ِۦ</tajweed>‌ۚ وَهُوَ <tajweed class=ham_wasl>ٱ</tajweed>لْعَزِيزُ <tajweed class=ham_wasl>ٱ</tajweed>لْعَل<tajweed class=madda_permissible>ِي</tajweed>مُ <span class=end>٧٨</span>","End":"٧٨","PageNumber":384,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":332,"MaqraNumber":153,"HizbNumber":39,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":79,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَتَوَكَّلۡ عَلَى ٱللَّهِۖ إِنَّكَ عَلَى ٱلۡحَقِّ ٱلۡمُبِينِ","TajweedText":"فَتَوَكَّلْ عَلَى <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ‌ۖ إِ<tajweed class=ghunnah>نّ</tajweed>َكَ عَلَى <tajweed class=ham_wasl>ٱ</tajweed>لْحَقِّ <tajweed class=ham_wasl>ٱ</tajweed>لْمُب<tajweed class=madda_permissible>ِي</tajweed>نِ <span class=end>٧٩</span>","End":"٧٩","PageNumber":384,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":332,"MaqraNumber":153,"HizbNumber":39,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":80,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّكَ لَا تُسۡمِعُ ٱلۡمَوۡتَىٰ وَلَا تُسۡمِعُ ٱلصُّمَّ ٱلدُّعَآءَ إِذَا وَلَّوۡاْ مُدۡبِرِينَ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َكَ لَا تُسْمِعُ <tajweed class=ham_wasl>ٱ</tajweed>لْمَوْتَىٰ وَلَا تُسْمِعُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>صُّ<tajweed class=ghunnah>مّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>دُّع<tajweed class=madda_obligatory>َا</tajweed>ٓءَ إِذَا وَلَّوْ<tajweed class=slnt>اْ</tajweed> مُ<tajweed class=qalaqah>دْ</tajweed>بِر<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٨٠</span>","End":"٨٠","PageNumber":384,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":332,"MaqraNumber":153,"HizbNumber":39,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":27,"SurahIndex":"027","VerseNumber":81,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَآ أَنتَ بِهَٰدِي ٱلۡعُمۡيِ عَن ضَلَٰلَتِهِمۡۖ إِن تُسۡمِعُ إِلَّا مَن يُؤۡمِنُ بِـَٔايَٰتِنَا فَهُم مُّسۡلِمُونَ","TajweedText":"وَم<tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=ikhafa>نت</tajweed>َ بِهَ<tajweed class=madda_normal>ـٰ</tajweed>دِى <tajweed class=ham_wasl>ٱ</tajweed>لْعُمْىِ عَ<tajweed class=ikhafa>ن ض</tajweed>َلَ<tajweed class=madda_normal>ـٰ</tajweed>لَتِهِمْ‌ۖ إِ<tajweed class=ikhafa>ن ت</tajweed>ُسْمِعُ إِلَّا م<tajweed class=idgham_ghunnah>َن ي</tajweed>ُؤْمِنُ بِـَٔـايَ<tajweed class=madda_normal>ـٰ</tajweed>تِنَا فَه<tajweed class=idgham_shafawi>ُم م</tajweed>ُّسْلِم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٨١</span>","End":"٨١","PageNumber":384,"JuzNumber":20,"ManzilNumber":5,"RukuNumber":332,"MaqraNumber":153,"HizbNumber":39,"HizbDecimal":0.0,"HasSajda":false}]}