 مَّطَرٗاۖ فَسَآءَ مَطَرُ ٱلۡمُنذَرِينَ","TajweedText":"وَأَمْطَرْنَا عَلَيْه<tajweed class=idgham_shafawi>ِم م</tajweed>َّطَ<tajweed class=ikhafa>رًا‌ۖ ف</tajweed>َس<tajweed class=madda_obligatory>َا</tajweed>ٓءَ مَطَرُ <tajweed class=ham_wasl>ٱ</tajweed>لْمُ<tajweed class=ikhafa>نذ</tajweed>َر<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٧٣</span>","End":"١٧٣","PageNumber":374,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":324,"MaqraNumber":149,"HizbNumber":38,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":26,"SurahIndex":"026","VerseNumber":174,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّ فِي ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكۡثَرُهُم مُّؤۡمِنِينَ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َ فِى ذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ لَأَيَ<tajweed class=idgham_ghunnah>ةً‌ۖ و</tajweed>َمَا كَانَ أَكْثَرُه<tajweed class=idgham_shafawi>ُم م</tajweed>ُّؤْمِن<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٧٤</span>","End":"١٧٤","PageNumber":374,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":324,"MaqraNumber":149,"HizbNumber":38,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":26,"SurahIndex":"026","VerseNumber":175,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِنَّ رَبَّكَ لَهُوَ ٱلۡعَزِيزُ ٱلرَّحِيمُ","TajweedText":"وَإِ<tajweed class=ghunnah>نّ</tajweed>َ رَبَّكَ لَهُوَ <tajweed class=ham_wasl>ٱ</tajweed>لْعَزِيزُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رَّح<tajweed class=madda_permissible>ِي</tajweed>مُ <span class=end>١٧٥</span>","End":"١٧٥","PageNumber":374,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":324,"MaqraNumber":149,"HizbNumber":38,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":26,"SurahIndex":"026","VerseNumber":176,"ShowSurahName":false,"ShowBismillah":false,"Text":"كَذَّبَ أَصۡحَٰبُ لۡـَٔيۡكَةِ ٱلۡمُرۡسَلِينَ","TajweedText":"كَذَّبَ أَصْحَ<tajweed class=madda_normal>ـٰ</tajweed>بُ لْــَٔيْكَةِ <tajweed class=ham_wasl>ٱ</tajweed>لْمُرْسَل<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٧٦</span>","End":"١٧٦","PageNumber":374,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":325,"MaqraNumber":149,"HizbNumber":38,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":26,"SurahIndex":"026","VerseNumber":177,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِذۡ قَالَ لَهُمۡ شُعَيۡبٌ أَلَا تَتَّقُونَ","TajweedText":"إِذْ قَالَ لَهُمْ شُعَيْبٌ أَلَا تَتَّق<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٧٧</span>","End":"١٧٧","PageNumber":374,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":325,"MaqraNumber":149,"HizbNumber":38,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":26,"SurahIndex":"026","VerseNumber":178,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنِّي لَكُمۡ رَسُولٌ أَمِينٞ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>ِى لَكُمْ رَسُولٌ أَم<tajweed class=madda_permissible>ِي</tajweed>نٌ <span class=end>١٧٨</span>","End":"١٧٨","PageNumber":374,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":325,"MaqraNumber":149,"HizbNumber":38,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":26,"SurahIndex":"026","VerseNumber":179,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَٱتَّقُواْ ٱللَّهَ وَأَطِيعُونِ","TajweedText":"فَ<tajweed class=ham_wasl>ٱ</tajweed>تَّقُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed>للَّهَ وَأَطِيع<tajweed class=madda_permissible>ُو</tajweed>نِ <span class=end>١٧٩</span>","End":"١٧٩","PageNumber":374,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":325,"MaqraNumber":149,"HizbNumber":38,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":26,"SurahIndex":"026","VerseNumber":180,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَآ أَسۡـَٔلُكُمۡ عَلَيۡهِ مِنۡ أَجۡرٍۖ إِنۡ أَجۡرِيَ إِلَّا عَلَىٰ رَبِّ ٱلۡعَٰلَمِينَ","TajweedText":"وَم<tajweed class=madda_obligatory>َآ</tajweed> أَسْــَٔلُكُمْ عَلَيْهِ مِنْ أَ<tajweed class=qalaqah>جْ</tajweed>رٍ‌ۖ إِنْ أَ<tajweed class=qalaqah>جْ</tajweed>رِىَ إِلَّا عَلَىٰ رَبِّ <tajweed class=ham_wasl>ٱ</tajweed>لْعَ<tajweed class=madda_normal>ـٰ</tajweed>لَم<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٨٠</span>","End":"١٨٠","PageNumber":374,"JuzNumber":19,"ManzilNumber":5,"RukuNumber":325,"MaqraNumber":149,"HizbNumber":38,"HizbDecimal":0.0,"HasSajda":false}]}