ajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َاسِ لَعَلَّهُمْ يَشْهَد<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦١</span>","End":"٦١","PageNumber":327,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":282,"MaqraNumber":131,"HizbNumber":33,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":62,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالُوٓاْ ءَأَنتَ فَعَلۡتَ هَٰذَا بِـَٔالِهَتِنَا يَـٰٓإِبۡرَٰهِيمُ","TajweedText":"قَال<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> ءَأَ<tajweed class=ikhafa>نت</tajweed>َ فَعَلْتَ هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا بِـَٔـالِهَتِنَا يَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>إِ<tajweed class=qalaqah>بْ</tajweed>ر<tajweed class=madda_normal>َٲ</tajweed>ه<tajweed class=madda_permissible>ِي</tajweed>مُ <span class=end>٦٢</span>","End":"٦٢","PageNumber":327,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":282,"MaqraNumber":131,"HizbNumber":33,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":63,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَ بَلۡ فَعَلَهُۥ كَبِيرُهُمۡ هَٰذَا فَسۡـَٔلُوهُمۡ إِن كَانُواْ يَنطِقُونَ","TajweedText":"قَالَ بَلْ فَعَلَهُ<tajweed class=madda_normal>ۥ</tajweed> كَبِيرُهُمْ هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا فَسْــَٔلُوهُمْ إِ<tajweed class=ikhafa>ن ك</tajweed>َانُو<tajweed class=slnt>اْ</tajweed> يَ<tajweed class=ikhafa>نط</tajweed>ِق<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٣</span>","End":"٦٣","PageNumber":327,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":282,"MaqraNumber":131,"HizbNumber":33,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":64,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَرَجَعُوٓاْ إِلَىٰٓ أَنفُسِهِمۡ فَقَالُوٓاْ إِنَّكُمۡ أَنتُمُ ٱلظَّـٰلِمُونَ","TajweedText":"فَرَجَع<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> إِلَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> أَ<tajweed class=ikhafa>نف</tajweed>ُسِهِمْ فَقَال<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َكُمْ أَ<tajweed class=ikhafa>نت</tajweed>ُمُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>ظَّ<tajweed class=madda_normal>ـٰ</tajweed>لِم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٤</span>","End":"٦٤","PageNumber":327,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":282,"MaqraNumber":131,"HizbNumber":33,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":65,"ShowSurahName":false,"ShowBismillah":false,"Text":"ثُمَّ نُكِسُواْ عَلَىٰ رُءُوسِهِمۡ لَقَدۡ عَلِمۡتَ مَا هَـٰٓؤُلَآءِ يَنطِقُونَ","TajweedText":"ثُ<tajweed class=ghunnah>مّ</tajweed>َ نُكِسُو<tajweed class=slnt>اْ</tajweed> عَلَىٰ رُءُوسِهِمْ لَقَ<tajweed class=qalaqah>دْ</tajweed> عَلِمْتَ مَا هَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ؤُل<tajweed class=madda_obligatory>َا</tajweed>ٓءِ يَ<tajweed class=ikhafa>نط</tajweed>ِق<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٥</span>","End":"٦٥","PageNumber":327,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":282,"MaqraNumber":131,"HizbNumber":33,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":66,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالَ أَفَتَعۡبُدُونَ مِن دُونِ ٱللَّهِ مَا لَا يَنفَعُكُمۡ شَيۡـٔٗا وَلَا يَضُرُّكُمۡ","TajweedText":"قَالَ أَفَتَعْبُدُونَ مِ<tajweed class=ikhafa>ن د</tajweed>ُونِ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ مَا لَا يَ<tajweed class=ikhafa>نف</tajweed>َعُكُمْ شَيْـ<tajweed class=idgham_ghunnah>ـًٔا و</tajweed>َلَا يَضُرُّكُمْ <span class=end>٦٦</span>","End":"٦٦","PageNumber":327,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":282,"MaqraNumber":131,"HizbNumber":33,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":67,"ShowSurahName"