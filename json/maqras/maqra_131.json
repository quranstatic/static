eed>ئِثَ‌ۗ إِ<tajweed class=ghunnah>نّ</tajweed>َهُمْ كَانُو<tajweed class=slnt>اْ</tajweed> قَوْمَ سَوْ<tajweed class=ikhafa>ءٍ ف</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed>سِق<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٧٤</span>","End":"٧٤","PageNumber":328,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":282,"MaqraNumber":131,"HizbNumber":33,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":75,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَأَدۡخَلۡنَٰهُ فِي رَحۡمَتِنَآۖ إِنَّهُۥ مِنَ ٱلصَّـٰلِحِينَ","TajweedText":"وَأَ<tajweed class=qalaqah>دْ</tajweed>خَلْنَ<tajweed class=madda_normal>ـٰ</tajweed>هُ فِى رَحْمَتِن<tajweed class=madda_obligatory>َآ‌ۖ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> مِنَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>صَّ<tajweed class=madda_normal>ـٰ</tajweed>لِح<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٧٥</span>","End":"٧٥","PageNumber":328,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":282,"MaqraNumber":131,"HizbNumber":33,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":76,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَنُوحًا إِذۡ نَادَىٰ مِن قَبۡلُ فَٱسۡتَجَبۡنَا لَهُۥ فَنَجَّيۡنَٰهُ وَأَهۡلَهُۥ مِنَ ٱلۡكَرۡبِ ٱلۡعَظِيمِ","TajweedText":"وَنُوحًا إِذْ نَادَىٰ مِ<tajweed class=ikhafa>ن ق</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>لُ فَ<tajweed class=ham_wasl>ٱ</tajweed>سْتَجَ<tajweed class=qalaqah>بْ</tajweed>نَا لَهُ<tajweed class=madda_normal>ۥ</tajweed> فَنَجَّيْنَ<tajweed class=madda_normal>ـٰ</tajweed>هُ وَأَهْلَهُ<tajweed class=madda_normal>ۥ</tajweed> مِنَ <tajweed class=ham_wasl>ٱ</tajweed>لْكَرْبِ <tajweed class=ham_wasl>ٱ</tajweed>لْعَظ<tajweed class=madda_permissible>ِي</tajweed>مِ <span class=end>٧٦</span>","End":"٧٦","PageNumber":328,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":283,"MaqraNumber":131,"HizbNumber":33,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":77,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَنَصَرۡنَٰهُ مِنَ ٱلۡقَوۡمِ ٱلَّذِينَ كَذَّبُواْ بِـَٔايَٰتِنَآۚ إِنَّهُمۡ كَانُواْ قَوۡمَ سَوۡءٖ فَأَغۡرَقۡنَٰهُمۡ أَجۡمَعِينَ","TajweedText":"وَنَصَرْنَ<tajweed class=madda_normal>ـٰ</tajweed>هُ مِنَ <tajweed class=ham_wasl>ٱ</tajweed>لْقَوْمِ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ كَذَّبُو<tajweed class=slnt>اْ</tajweed> بِـَٔـايَ<tajweed class=madda_normal>ـٰ</tajweed>تِن<tajweed class=madda_obligatory>َآ‌ۚ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َهُمْ كَانُو<tajweed class=slnt>اْ</tajweed> قَوْمَ سَوْ<tajweed class=ikhafa>ءٍ ف</tajweed>َأَغْرَ<tajweed class=qalaqah>قْ</tajweed>نَ<tajweed class=madda_normal>ـٰ</tajweed>هُمْ أَ<tajweed class=qalaqah>جْ</tajweed>مَع<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٧٧</span>","End":"٧٧","PageNumber":328,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":283,"MaqraNumber":131,"HizbNumber":33,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":78,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَدَاوُۥدَ وَسُلَيۡمَٰنَ إِذۡ يَحۡكُمَانِ فِي ٱلۡحَرۡثِ إِذۡ نَفَشَتۡ فِيهِ غَنَمُ ٱلۡقَوۡمِ وَكُنَّا لِحُكۡمِهِمۡ شَٰهِدِينَ","TajweedText":"وَدَاوُ<tajweed class=madda_normal>ۥ</tajweed>دَ وَسُلَيْمَ<tajweed class=madda_normal>ـٰ</tajweed>نَ إِذْ يَحْكُمَانِ فِى <tajweed class=ham_wasl>ٱ</tajweed>لْحَرْثِ إِذْ نَفَشَتْ فِيهِ غَنَمُ <tajweed class=ham_wasl>ٱ</tajweed>لْقَوْمِ وَكُ<tajweed class=ghunnah>نّ</tajweed>َا لِحُكْمِهِمْ شَ<tajweed class=madda_normal>ـٰ</tajweed>هِد<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٧٨</span>","End":"٧٨","PageNumber":328,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":283,"MaqraNumber":131,"HizbNumber":33,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":79,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَفَهَّمۡنَٰهَا سُلَيۡمَٰنَۚ وَكُلًّا ءَاتَيۡنَا حُكۡمٗا وَعِلۡمٗاۚ وَسَخَّرۡنَا مَعَ دَاوُۥدَ ٱلۡجِبَالَ يُسَبِّحۡنَ وَٱلطَّيۡرَۚ وَكُنَّا فَٰعِلِينَ","TajweedText":"فَفَهَّمْنَ<tajweed class=madda_normal>ـٰ</tajweed>هَا سُلَيْمَ<tajweed class=madda_normal>ـٰ</tajweed>نَ‌ۚ وَكُلاًّ ءَاتَيْنَا حُكْ<tajweed class=idgham_ghunnah>مًا و</tajweed>َعِلْ<tajweed class=idgham_ghunnah>مًا‌ۚ و</tajweed>َسَخَّرْنَا مَعَ دَاوُ<tajweed class=madda_normal>ۥ</tajweed>دَ <tajweed class=ham_wasl>ٱ</tajweed>لْجِبَالَ يُسَبِّحْنَ وَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>طَّيْرَ‌ۚ وَكُ<tajweed class=ghunnah>نّ</tajweed>َا فَ<tajweed class=madda_normal>ـٰ</tajweed>عِل<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٧٩</span>","End":"٧٩","PageNumber":328,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":283,"MaqraNumber":131,"HizbNumber":33,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":80,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَعَلَّمۡنَٰهُ صَنۡعَةَ لَبُوسٖ لَّكُمۡ لِتُحۡصِنَكُم مِّنۢ بَأۡسِكُمۡۖ فَهَلۡ أَنتُمۡ شَٰكِرُونَ","TajweedText":"وَعَلَّمْنَ<tajweed class=madda_normal>ـٰ</tajweed>هُ صَنْعَةَ لَبُو<tajweed class=idgham_wo_ghunnah>سٍ ل</tajweed>َّكُمْ لِتُحْصِنَك<tajweed class=idgham_shafawi>ُم م</tajweed>ّ<tajweed class=iqlab>ِنۢ ب</tajweed>َأْسِكُمْ‌ۖ فَهَلْ أَ<tajweed class=ikhafa>نت</tajweed>ُمْ شَ<tajweed class=madda_normal>ـٰ</tajweed>كِر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٨٠</span>","End":"٨٠","PageNumber":328,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":283,"MaqraNumber":131,"HizbNumber":33,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":81,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلِسُلَيۡمَٰنَ ٱلرِّيحَ عَاصِفَةٗ تَجۡرِي بِأَمۡرِهِۦٓ إِلَى ٱلۡأَرۡضِ ٱلَّتِي بَٰرَكۡنَا فِيهَاۚ وَكُنَّا بِكُلِّ شَيۡءٍ عَٰلِمِينَ","TajweedText":"وَلِسُلَيْمَ<tajweed class=madda_normal>ـٰ</tajweed>نَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رِّيحَ عَاصِفَ<tajweed class=ikhafa>ةً ت</tajweed>َ<tajweed class=qalaqah>جْ</tajweed>رِى بِأَمْرِه<tajweed class=madda_obligatory>ِۦٓ</tajweed> إِلَى <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ <tajweed class=ham_wasl>ٱ</tajweed>لَّتِى بَ<tajweed class=madda_normal>ـٰ</tajweed>رَكْنَا فِيهَا‌ۚ وَكُ<tajweed class=ghunnah>نّ</tajweed>َا بِكُلِّ شَىْءٍ عَ<tajweed class=madda_normal>ـٰ</tajweed>لِم<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٨١</span>","End":"٨١","PageNumber":328,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":283,"MaqraNumber":131,"HizbNumber":33,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":82,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمِنَ ٱلشَّيَٰطِينِ مَن يَغُوصُونَ لَهُۥ وَيَعۡمَلُونَ عَمَلٗا دُونَ ذَٰلِكَۖ وَكُنَّا لَهُمۡ حَٰفِظِينَ","TajweedText":"وَمِنَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>شَّيَ<tajweed class=madda_normal>ـٰ</tajweed>طِينِ م<tajweed class=idgham_ghunnah>َن ي</tajweed>َغُوصُونَ لَهُ<tajweed class=madda_normal>ۥ</tajweed> وَيَعْمَلُونَ عَمَل<tajweed class=ikhafa>اً د</tajweed>ُونَ ذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ‌ۖ وَكُ<tajweed class=ghunnah>نّ</tajweed>َا لَهُمْ حَ<tajweed class=madda_normal>ـٰ</tajweed>فِظ<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٨٢</span>","End":"٨٢","PageNumber":329,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":283,"MaqraNumber":131,"HizbNumber":33,"HizbDecimal":0.5,"HasSajda":false}]}