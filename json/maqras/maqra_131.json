{"MaqraNumber":131.0,"Verses":[{"SurahNumber":21,"SurahIndex":"021","VerseNumber":51,"ShowSurahName":false,"ShowBismillah":false,"Text":"۞وَلَقَدۡ ءَاتَيۡنَآ إِبۡرَٰهِيمَ رُشۡدَهُۥ مِن قَبۡلُ وَكُنَّا بِهِۦ عَٰلِمِينَ","TajweedText":"۞ وَلَقَ<tajweed class=qalaqah>دْ</tajweed> ءَاتَيْن<tajweed class=madda_obligatory>َآ</tajweed> إِ<tajweed class=qalaqah>بْ</tajweed>ر<tajweed class=madda_normal>َٲ</tajweed>هِيمَ رُشْدَهُ<tajweed class=madda_normal>ۥ</tajweed> مِ<tajweed class=ikhafa>ن ق</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>لُ وَكُ<tajweed class=ghunnah>نّ</tajweed>َا بِه<tajweed class=madda_normal>ِۦ</tajweed> عَ<tajweed class=madda_normal>ـٰ</tajweed>لِم<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٥١</span>","End":"٥١","PageNumber":326,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":282,"MaqraNumber":131,"HizbNumber":33,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":52,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِذۡ قَالَ لِأَبِيهِ وَقَوۡمِهِۦ مَا هَٰذِهِ ٱلتَّمَاثِيلُ ٱلَّتِيٓ أَنتُمۡ لَهَا عَٰكِفُونَ","TajweedText":"إِذْ قَالَ لِأَبِيهِ وَقَوْمِه<tajweed class=madda_normal>ِۦ</tajweed> مَا هَ<tajweed class=madda_normal>ـٰ</tajweed>ذِهِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>تَّمَاثِيلُ <tajweed class=ham_wasl>ٱ</tajweed>لَّت<tajweed class=madda_obligatory>ِىٓ</tajweed> أَ<tajweed class=ikhafa>نت</tajweed>ُمْ لَهَا عَ<tajweed class=madda_normal>ـٰ</tajweed>كِف<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٥٢</span>","End":"٥٢","PageNumber":326,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":282,"MaqraNumber":131,"HizbNumber":33,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":53,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالُواْ وَجَدۡنَآ ءَابَآءَنَا لَهَا عَٰبِدِينَ","TajweedText":"قَالُو<tajweed class=slnt>اْ</tajweed> وَجَ<tajweed class=qalaqah>دْ</tajweed>ن<tajweed class=madda_obligatory>