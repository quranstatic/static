{"MaqraNumber":132.0,"Verses":[{"SurahNumber":21,"SurahIndex":"021","VerseNumber":83,"ShowSurahName":false,"ShowBismillah":false,"Text":"۞وَأَيُّوبَ إِذۡ نَادَىٰ رَبَّهُۥٓ أَنِّي مَسَّنِيَ ٱلضُّرُّ وَأَنتَ أَرۡحَمُ ٱلرَّـٰحِمِينَ","TajweedText":"۞ وَأَيُّوبَ إِذْ نَادَىٰ رَبَّهُ<tajweed class=madda_obligatory>ۥٓ</tajweed> أَ<tajweed class=ghunnah>نّ</tajweed>ِى مَسَّنِىَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>ضُّرُّ وَأَ<tajweed class=ikhafa>نت</tajweed>َ أَرْحَمُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رّ<tajweed class=madda_normal>َٲ</tajweed>حِم<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٨٣</span>","End":"٨٣","PageNumber":329,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":283,"MaqraNumber":132,"HizbNumber":33,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":84,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَٱسۡتَجَبۡنَا لَهُۥ فَكَشَفۡنَا مَا بِهِۦ مِن ضُرّٖۖ وَءَاتَيۡنَٰهُ أَهۡلَهُۥ وَمِثۡلَهُم مَّعَهُمۡ رَحۡمَةٗ مِّنۡ عِندِنَا وَذِكۡرَىٰ لِلۡعَٰبِدِينَ","TajweedText":"فَ<tajweed class=ham_wasl>ٱ</tajweed>سْتَجَ<tajweed class=qalaqah>بْ</tajweed>نَا لَهُ<tajweed class=madda_normal>ۥ</tajweed> فَكَشَفْنَا مَا بِه<tajweed class=madda_normal>ِۦ</tajweed> مِ<tajweed class=ikhafa>ن ض</tajweed>ُ<tajweed class=idgham_ghunnah>رٍّ‌ۖ و</tajweed>َءَاتَيْنَ<tajweed class=madda_normal>ـٰ</tajweed>هُ أَهْلَهُ<tajweed class=madda_normal>ۥ</tajweed> وَمِثْلَه<tajweed class=idgham_shafawi>ُم م</tajweed>َّعَهُمْ رَحْمَ<tajweed class=idgham_ghunnah>ةً م</tajweed>ِّنْ عِ<tajweed class=ikhafa>ند</tajweed>ِنَا وَذِكْرَىٰ لِلْعَ<tajweed class=madda_normal>ـٰ</tajweed>بِد<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٨٤</span>","End":"٨٤","PageNumber":329,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":283,"MaqraNumber":132,"HizbNumber":33,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":85,"ShowSurah