llah":false,"Text":"وَٱلَّتِيٓ أَحۡصَنَتۡ فَرۡجَهَا فَنَفَخۡنَا فِيهَا مِن رُّوحِنَا وَجَعَلۡنَٰهَا وَٱبۡنَهَآ ءَايَةٗ لِّلۡعَٰلَمِينَ","TajweedText":"وَ<tajweed class=ham_wasl>ٱ</tajweed>لَّت<tajweed class=madda_obligatory>ِىٓ</tajweed> أَحْصَنَتْ فَرْجَهَا فَنَفَخْنَا فِيهَا م<tajweed class=idgham_wo_ghunnah>ِن ر</tajweed>ُّوحِنَا وَجَعَلْنَ<tajweed class=madda_normal>ـٰ</tajweed>هَا وَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=qalaqah>بْ</tajweed>نَه<tajweed class=madda_obligatory>َآ</tajweed> ءَايَ<tajweed class=idgham_wo_ghunnah>ةً ل</tajweed>ِّلْعَ<tajweed class=madda_normal>ـٰ</tajweed>لَم<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٩١</span>","End":"٩١","PageNumber":330,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":283,"MaqraNumber":132,"HizbNumber":33,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":92,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّ هَٰذِهِۦٓ أُمَّتُكُمۡ أُمَّةٗ وَٰحِدَةٗ وَأَنَا۠ رَبُّكُمۡ فَٱعۡبُدُونِ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َ هَ<tajweed class=madda_normal>ـٰ</tajweed>ذِه<tajweed class=madda_obligatory>ِۦٓ</tajweed> أُ<tajweed class=ghunnah>مّ</tajweed>َتُكُمْ أُ<tajweed class=ghunnah>مّ</tajweed>َ<tajweed class=idgham_ghunnah>ةً و</tajweed><tajweed class=madda_normal>َٲ</tajweed>حِدَ<tajweed class=idgham_ghunnah>ةً و</tajweed>َأَنَا۟ رَبُّكُمْ فَ<tajweed class=ham_wasl>ٱ</tajweed>عْبُد<tajweed class=madda_permissible>ُو</tajweed>نِ <span class=end>٩٢</span>","End":"٩٢","PageNumber":330,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":283,"MaqraNumber":132,"HizbNumber":33,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":93,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَتَقَطَّعُوٓاْ أَمۡرَهُم بَيۡنَهُمۡۖ كُلٌّ إِلَيۡنَا رَٰجِعُونَ","TajweedText":"وَتَقَطَّع<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> أَمْرَه<tajweed class=ikhafa_shafawi>ُم ب</tajweed>َيْنَهُمْ‌ۖ كُلٌّ إِلَيْنَا ر<tajweed class=madda_normal>َٲ</tajweed>جِع<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٩٣</span>","End":"٩٣","PageNumber":330,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":283,"MaqraNumber":132,"HizbNumber":33,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":94,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَمَن يَعۡمَلۡ مِنَ ٱلصَّـٰلِحَٰتِ وَهُوَ مُؤۡمِنٞ فَلَا كُفۡرَانَ لِسَعۡيِهِۦ وَإِنَّا لَهُۥ كَٰتِبُونَ","TajweedText":"فَم<tajweed class=idgham_ghunnah>َن ي</tajweed>َعْمَلْ مِنَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>صَّ<tajweed class=madda_normal>ـٰ</tajweed>لِحَ<tajweed class=madda_normal>ـٰ</tajweed>تِ وَهُوَ مُؤْمِ<tajweed class=ikhafa>نٌ ف</tajweed>َلَا كُفْرَانَ لِسَعْيِه<tajweed class=madda_normal>ِۦ</tajweed> وَإِ<tajweed class=ghunnah>نّ</tajweed>َا لَهُ<tajweed class=madda_normal>ۥ</tajweed> كَ<tajweed class=madda_normal>ـٰ</tajweed>تِب<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٩٤</span>","End":"٩٤","PageNumber":330,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":284,"MaqraNumber":132,"HizbNumber":33,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":95,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَحَرَٰمٌ عَلَىٰ قَرۡيَةٍ أَهۡلَكۡنَٰهَآ أَنَّهُمۡ لَا يَرۡجِعُونَ","TajweedText":"وَحَر<tajweed class=madda_normal>َٲ</tajweed>مٌ عَلَىٰ قَرْيَةٍ أَهْلَكْنَ<tajweed class=madda_normal>ـٰ</tajweed>ه<tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=ghunnah>نّ</tajweed>َهُمْ لَا يَرْجِع<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٩٥</span>","End":"٩٥","PageNumber":330,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":284,"MaqraNumber":132,"HizbNumber":33,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":96,"ShowSurahName":false,"ShowBismillah":false,"Text":"حَتَّىٰٓ إِذَا فُتِحَتۡ يَأۡجُوجُ وَمَأۡجُوجُ وَهُم مِّن كُلِّ حَدَبٖ يَنسِلُونَ","TajweedText":"حَتَّ<tajweed class=madda_obligatory>ىٰٓ</tajweed> إِذَا فُتِحَتْ يَأْجُوجُ وَمَأْجُوجُ وَه<tajweed class=idgham_shafawi>ُم م</tajweed>ِّ<tajweed class=ikhafa>ن ك</tajweed>ُلِّ حَدَ<tajweed class=idgham_ghunnah>بٍ ي</tajweed>َ<tajweed class=ikhafa>نس</tajweed>ِل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٩٦</span>","End":"٩٦","PageNumber":330,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":284,"MaqraNumber":132,"HizbNumber":33,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":97,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَٱقۡتَرَبَ ٱلۡوَعۡدُ ٱلۡحَقُّ فَإِذَا هِيَ شَٰخِصَةٌ أَبۡصَٰرُ ٱلَّذِينَ كَفَرُواْ يَٰوَيۡلَنَا قَدۡ كُنَّا فِي غَفۡلَةٖ مِّنۡ هَٰذَا بَلۡ كُنَّا ظَٰلِمِينَ","TajweedText":"وَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=qalaqah>قْ</tajweed>تَرَبَ <tajweed class=ham_wasl>ٱ</tajweed>لْوَعْدُ <tajweed class=ham_wasl>ٱ</tajweed>لْحَقُّ فَإِذَا هِىَ شَ<tajweed class=madda_normal>ـٰ</tajweed>خِصَةٌ أَ<tajweed class=qalaqah>بْ</tajweed>صَ<tajweed class=madda_normal>ـٰ</tajweed>رُ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ كَفَرُو<tajweed class=slnt>اْ</tajweed> يَ<tajweed class=madda_normal>ـٰ</tajweed>وَيْلَنَا قَ<tajweed class=qalaqah>دْ</tajweed> كُ<tajweed class=ghunnah>نّ</tajweed>َا فِى غَفْلَ<tajweed class=idgham_ghunnah>ةٍ م</tajweed>ِّنْ هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا بَلْ كُ<tajweed class=ghunnah>نّ</tajweed>َا ظَ<tajweed class=madda_normal>ـٰ</tajweed>لِم<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٩٧</span>","End":"٩٧","PageNumber":330,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":284,"MaqraNumber":132,"HizbNumber":33,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":98,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّكُمۡ وَمَا تَعۡبُدُونَ مِن دُونِ ٱللَّهِ حَصَبُ جَهَنَّمَ أَنتُمۡ لَهَا وَٰرِدُونَ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َكُمْ وَمَا تَعْبُدُونَ مِ<tajweed class=ikhafa>ن د</tajweed>ُونِ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ حَصَبُ جَهَ<tajweed class=ghunnah>نّ</tajweed>َمَ أَ<tajweed class=ikhafa>نت</tajweed>ُمْ لَهَا و<tajweed class=madda_normal>َٲ</tajweed>رِد<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٩٨</span>","End":"٩٨","PageNumber":330,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":284,"MaqraNumber":132,"HizbNumber":33,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":99,"ShowSurahName":false,"ShowBismillah":false,"Text":"لَوۡ كَانَ هَـٰٓؤُلَآءِ ءَالِهَةٗ مَّا وَرَدُوهَاۖ وَكُلّٞ فِيهَا خَٰلِدُونَ","TajweedText":"لَوْ كَانَ هَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ؤُل<tajweed class=madda_obligatory>َا</tajweed>ٓءِ ءَالِهَ<tajweed class=idgham_ghunnah>ةً م</tajweed>َّا وَرَدُوهَا‌ۖ وَكُ<tajweed class=ikhafa>لٌّ ف</tajweed>ِيهَا خَ<tajweed class=madda_normal>ـٰ</tajweed>لِد<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٩٩</span>","End":"٩٩","PageNumber":330,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":284,"MaqraNumber":132,"HizbNumber":33,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":100,"ShowSurahName":false,"ShowBismillah":false,"Text":"لَهُمۡ فِيهَا زَفِيرٞ وَهُمۡ فِيهَا لَا يَسۡمَعُونَ","TajweedText":"لَهُمْ فِيهَا زَفِي<tajweed class=idgham_ghunnah>رٌ و</tajweed>َهُمْ فِيهَا لَا يَسْمَع<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٠٠</span>","End":"١٠٠","PageNumber":330,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":284,"MaqraNumber":132,"HizbNumber":33,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":101,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّ ٱلَّذِينَ سَبَقَتۡ لَهُم مِّنَّا ٱلۡحُسۡنَىٰٓ أُوْلَـٰٓئِكَ عَنۡهَا مُبۡعَدُونَ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ سَبَقَتْ لَه<tajweed class=idgham_shafawi>ُم م</tajweed>ِّ<tajweed class=ghunnah>نّ</tajweed>َا <tajweed class=ham_wasl>ٱ</tajweed>لْحُسْنَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> أُ<tajweed class=slnt>وْ</tajweed>لَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ئِكَ عَنْهَا مُ<tajweed class=qalaqah>بْ</tajweed>عَد<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٠١</span>","End":"١٠١","PageNumber":330,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":284,"MaqraNumber":132,"HizbNumber":33,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":102,"ShowSurahName":false,"ShowBismillah":false,"Text":"لَا يَسۡمَعُونَ حَسِيسَهَاۖ وَهُمۡ فِي مَا ٱشۡتَهَتۡ أَنفُسُهُمۡ خَٰلِدُونَ","TajweedText":"لَا يَسْمَعُونَ حَسِيسَهَا‌ۖ وَهُمْ فِى مَا <tajweed class=ham_wasl>ٱ</tajweed>شْتَهَتْ أَ<tajweed class=ikhafa>نف</tajweed>ُسُهُمْ خَ<tajweed class=madda_normal>ـٰ</tajweed>لِد<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٠٢</span>","End":"١٠٢","PageNumber":331,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":284,"MaqraNumber":132,"HizbNumber":33,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":103,"ShowSurahName":false,"ShowBismillah":false,"Text":"لَا يَحۡزُنُهُمُ ٱلۡفَزَعُ ٱلۡأَكۡبَرُ وَتَتَلَقَّىٰهُمُ ٱلۡمَلَـٰٓئِكَةُ هَٰذَا يَوۡمُكُمُ ٱلَّذِي كُنتُمۡ تُوعَدُونَ","TajweedText":"لَا يَحْزُنُهُمُ <tajweed class=ham_wasl>ٱ</tajweed>لْفَزَعُ <tajweed class=ham_wasl>ٱ</tajweed>لْأَكْبَرُ وَتَتَلَقَّ<tajweed class=madda_normal>ـٰ</tajweed>هُمُ <tajweed class=ham_wasl>ٱ</tajweed>لْمَلَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ئِكَةُ هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا يَوْمُكُمُ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى كُ<tajweed class=ikhafa>نت</tajweed>ُمْ تُوعَد<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٠٣</span>","End":"١٠٣","PageNumber":331,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":284,"MaqraNumber":132,"HizbNumber":33,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":104,"ShowSurahName":false,"ShowBismillah":false,"Text":"يَوۡمَ نَطۡوِي ٱلسَّمَآءَ كَطَيِّ ٱلسِّجِلِّ لِلۡكُتُبِۚ كَمَا بَدَأۡنَآ أَوَّلَ خَلۡقٖ نُّعِيدُهُۥۚ وَعۡدًا عَلَيۡنَآۚ إِنَّا كُنَّا فَٰعِلِينَ","TajweedText":"يَوْمَ نَ<tajweed class=qalaqah>طْ</tajweed>وِى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّم<tajweed class=madda_obligatory>َا</tajweed>ٓءَ كَطَىِّ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سِّجِلِّ لِلْكُتُبِ‌ۚ كَمَا بَدَأْن<tajweed class=madda_obligatory>َآ</tajweed> أَوَّلَ خَلْ<tajweed class=idgham_ghunnah>قٍ ن</tajweed>ُّعِيدُهُ<tajweed class=madda_normal>ۥ</tajweed>‌ۚ وَعْدًا عَلَيْن<tajweed class=madda_obligatory>َآ‌ۚ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َا كُ<tajweed class=ghunnah>نّ</tajweed>َا فَ<tajweed class=madda_normal>ـٰ</tajweed>عِل<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٠٤</span>","End":"١٠٤","PageNumber":331,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":284,"MaqraNumber":132,"HizbNumber":33,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":105,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَقَدۡ كَتَبۡنَا فِي ٱلزَّبُورِ مِنۢ بَعۡدِ ٱلذِّكۡرِ أَنَّ ٱلۡأَرۡضَ يَرِثُهَا عِبَادِيَ ٱلصَّـٰلِحُونَ","TajweedText":"وَلَقَ<tajweed class=qalaqah>دْ</tajweed> كَتَ<tajweed class=qalaqah>بْ</tajweed>نَا فِى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>زَّبُورِ م<tajweed class=iqlab>ِنۢ ب</tajweed>َعْدِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>ذِّكْرِ أَ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضَ يَرِثُهَا عِبَادِىَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>صَّ<tajweed class=madda_normal>ـٰ</tajweed>لِح<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٠٥</span>","End":"١٠٥","PageNumber":331,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":284,"MaqraNumber":132,"HizbNumber":33,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":106,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّ فِي هَٰذَا لَبَلَٰغٗا لِّقَوۡمٍ عَٰبِدِينَ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َ فِى هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا لَبَلَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_wo_ghunnah>غًا ل</tajweed>ِّقَوْمٍ عَ<tajweed class=madda_normal>ـٰ</tajweed>بِد<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٠٦</span>","End":"١٠٦","PageNumber":331,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":284,"MaqraNumber":132,"HizbNumber":33,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":107,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَآ أَرۡسَلۡنَٰكَ إِلَّا رَحۡمَةٗ لِّلۡعَٰلَمِينَ","TajweedText":"وَم<tajweed class=madda_obligatory>َآ</tajweed> أَرْسَلْنَ<tajweed class=madda_normal>ـٰ</tajweed>كَ إِلَّا رَحْمَ<tajweed class=idgham_wo_ghunnah>ةً ل</tajweed>ِّلْعَ<tajweed class=madda_normal>ـٰ</tajweed>لَم<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>١٠٧</span>","End":"١٠٧","PageNumber":331,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":284,"MaqraNumber":132,"HizbNumber":33,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":108,"ShowSurahName":false,"ShowBismillah":false,"Text":"قُلۡ إِنَّمَا يُوحَىٰٓ إِلَيَّ أَنَّمَآ إِلَٰهُكُمۡ إِلَٰهٞ وَٰحِدٞۖ فَهَلۡ أَنتُم مُّسۡلِمُونَ","TajweedText":"قُلْ إِ<tajweed class=ghunnah>نّ</tajweed>َمَا يُوحَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> إِلَىَّ أَ<tajweed class=ghunnah>نّ</tajweed>َم<tajweed class=madda_obligatory>َآ</tajweed> إِلَ<tajweed class=madda_normal>ـٰ</tajweed>هُكُمْ إِلَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>هٌ و</tajweed><tajweed class=madda_normal>َٲ</tajweed>حِ<tajweed class=ikhafa>دٌ‌ۖ ف</tajweed>َهَلْ أَ<tajweed class=ikhafa>نت</tajweed><tajweed class=idgham_shafawi>ُم م</tajweed>ُّسْلِم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٠٨</span>","End":"١٠٨","PageNumber":331,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":284,"MaqraNumber":132,"HizbNumber":33,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":109,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَإِن تَوَلَّوۡاْ فَقُلۡ ءَاذَنتُكُمۡ عَلَىٰ سَوَآءٖۖ وَإِنۡ أَدۡرِيٓ أَقَرِيبٌ أَم بَعِيدٞ مَّا تُوعَدُونَ","TajweedText":"فَإِ<tajweed class=ikhafa>ن ت</tajweed>َوَلَّوْ<tajweed class=slnt>اْ</tajweed> فَقُلْ ءَاذَ<tajweed class=ikhafa>نت</tajweed>ُكُمْ عَلَىٰ سَو<tajweed class=madda_obligatory>َا</tajweed>ٓ<tajweed class=idgham_ghunnah>ءٍ‌ۖ و</tajweed>َإِنْ أَ<tajweed class=qalaqah>دْ</tajweed>ر<tajweed class=madda_obligatory>ِىٓ</tajweed> أَقَرِيبٌ أ<tajweed class=ikhafa_shafawi>َم ب</tajweed>َعِي<tajweed class=idgham_ghunnah>دٌ م</tajweed>َّا تُوعَد<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٠٩</span>","End":"١٠٩","PageNumber":331,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":284,"MaqraNumber":132,"HizbNumber":33,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":110,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّهُۥ يَعۡلَمُ ٱلۡجَهۡرَ مِنَ ٱلۡقَوۡلِ وَيَعۡلَمُ مَا تَكۡتُمُونَ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> يَعْلَمُ <tajweed class=ham_wasl>ٱ</tajweed>لْجَهْرَ مِنَ <tajweed class=ham_wasl>ٱ</tajweed>لْقَوْلِ وَيَعْلَمُ مَا تَكْتُم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١١٠</span>","End":"١١٠","PageNumber":331,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":284,"MaqraNumber":132,"HizbNumber":33,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":111,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِنۡ أَدۡرِي لَعَلَّهُۥ فِتۡنَةٞ لَّكُمۡ وَمَتَٰعٌ إِلَىٰ حِينٖ","TajweedText":"وَإِنْ أَ<tajweed class=qalaqah>دْ</tajweed>رِى لَعَلَّهُ<tajweed class=madda_normal>ۥ</tajweed> فِتْنَ<tajweed class=idgham_wo_ghunnah>ةٌ ل</tajweed>َّكُمْ وَمَتَ<tajweed class=madda_normal>ـٰ</tajweed>عٌ إِلَىٰ ح<tajweed class=madda_permissible>ِي</tajweed>نٍ <span class=end>١١١</span>","End":"١١١","PageNumber":331,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":284,"MaqraNumber":132,"HizbNumber":33,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":21,"SurahIndex":"021","VerseNumber":112,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَٰلَ رَبِّ ٱحۡكُم بِٱلۡحَقِّۗ وَرَبُّنَا ٱلرَّحۡمَٰنُ ٱلۡمُسۡتَعَانُ عَلَىٰ مَا تَصِفُونَ","TajweedText":"قَ<tajweed class=madda_normal>ـٰ</tajweed>لَ رَبِّ <tajweed class=ham_wasl>ٱ</tajweed>حْك<tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِ<tajweed class=ham_wasl>ٱ</tajweed>لْحَقِّ‌ۗ وَرَبُّنَا <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رَّحْمَ<tajweed class=madda_normal>ـٰ</tajweed>نُ <tajweed class=ham_wasl>ٱ</tajweed>لْمُسْتَعَانُ عَلَىٰ مَا تَصِف<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١١٢</span>","End":"١١٢","PageNumber":331,"JuzNumber":17,"ManzilNumber":4,"RukuNumber":284,"MaqraNumber":132,"HizbNumber":33,"HizbDecimal":0.75,"HasSajda":false}]}