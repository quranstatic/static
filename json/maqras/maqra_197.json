{"MaqraNumber":197.0,"Verses":[{"SurahNumber":43,"SurahIndex":"043","VerseNumber":24,"ShowSurahName":false,"ShowBismillah":false,"Text":"۞قَٰلَ أَوَلَوۡ جِئۡتُكُم بِأَهۡدَىٰ مِمَّا وَجَدتُّمۡ عَلَيۡهِ ءَابَآءَكُمۡۖ قَالُوٓاْ إِنَّا بِمَآ أُرۡسِلۡتُم بِهِۦ كَٰفِرُونَ","TajweedText":"۞ قَ<tajweed class=madda_normal>ـٰ</tajweed>لَ أَوَلَوْ جِئْتُك<tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِأَهْدَىٰ مِ<tajweed class=ghunnah>مّ</tajweed>َا وَجَ<tajweed class=idgham_mutajanisayn>د</tajweed>تُّمْ عَلَيْهِ ءَاب<tajweed class=madda_obligatory>َا</tajweed>ٓءَكُمْ‌ۖ قَال<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َا بِم<tajweed class=madda_obligatory>َآ</tajweed> أُرْسِلْت<tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِه<tajweed class=madda_normal>ِۦ</tajweed> كَ<tajweed class=madda_normal>ـٰ</tajweed>فِر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٤</span>","End":"٢٤","PageNumber":491,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":425,"MaqraNumber":197,"HizbNumber":50,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":25,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَٱنتَقَمۡنَا مِنۡهُمۡۖ فَٱنظُرۡ كَيۡفَ كَانَ عَٰقِبَةُ ٱلۡمُكَذِّبِينَ","TajweedText":"فَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=ikhafa>نت</tajweed>َقَمْنَا مِنْهُمْ‌ۖ فَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=ikhafa>نظ</tajweed>ُرْ كَيْفَ كَانَ عَ<tajweed class=madda_normal>ـٰ</tajweed>قِبَةُ <tajweed class=ham_wasl>ٱ</tajweed>لْمُكَذِّب<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٢٥</span>","End":"٢٥","PageNumber":491,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":425,"MaqraNumber":197,"HizbNumber":50,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":26,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِذۡ قَالَ إِبۡرَٰهِيمُ لِأَبِيهِ وَقَوۡمِهِۦٓ إِنَّنِي بَرَآءٞ مِّمَّا تَعۡبُدُونَ","TajweedText":"وَإِذْ قَالَ إِ<tajweed class=qalaqah>بْ</tajweed>ر<tajweed class=madda_normal>َٲ</tajweed>هِيمُ لِأَبِيهِ وَقَوْمِه<tajweed class=madda_obligatory>ِۦٓ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َنِى بَر<tajweed class=madda_obligatory>َا</tajweed>ٓ<tajweed class=idgham_ghunnah>ءٌ م</tajweed>ِّ<tajweed class=ghunnah>مّ</tajweed>َا تَعْبُد<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٦</span>","End":"٢٦","PageNumber":491,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":426,"MaqraNumber":197,"HizbNumber":50,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":27,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِلَّا ٱلَّذِي فَطَرَنِي فَإِنَّهُۥ سَيَهۡدِينِ","TajweedText":"إِلَّا <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى فَطَرَنِى فَإِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> سَيَهْد<tajweed class=madda_permissible>ِي</tajweed>نِ <span class=end>٢٧</span>","End":"٢٧","PageNumber":491,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":426,"MaqraNumber":197,"HizbNumber":50,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":28,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَجَعَلَهَا كَلِمَةَۢ بَاقِيَةٗ فِي عَقِبِهِۦ لَعَلَّهُمۡ يَرۡجِعُونَ","TajweedText":"وَجَعَلَهَا كَلِمَ<tajweed class=iqlab>ةَۢ ب</tajweed>َاقِيَ<tajweed class=ikhafa>ةً ف</tajweed>ِى عَقِبِه<tajweed class=madda_normal>ِۦ</tajweed> لَعَلَّهُمْ يَرْجِع<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٨</span>","End":"٢٨","PageNumber":491,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":426,"MaqraNumber":197,"HizbNumber":50,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":29,"ShowSurahName":false,"ShowBismillah":false,"Text":"بَلۡ مَتَّعۡتُ هَـٰٓؤُلَآءِ وَءَابَآءَهُمۡ حَتَّىٰ جَآءَهُمُ ٱلۡحَقُّ وَرَسُولٞ مُّبِينٞ","TajweedText":"بَلْ مَتَّعْتُ هَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ؤُل<tajweed class=madda_obligatory>َا</tajweed>ٓءِ وَءَاب<tajweed class=madda_obligatory>َا</tajweed>ٓءَهُمْ حَتَّىٰ ج<tajweed class=madda_obligatory>َا</tajweed>ٓءَهُمُ <tajweed class=ham_wasl>ٱ</tajweed>لْحَقُّ وَرَسُو<tajweed class=idgham_ghunnah>لٌ م</tajweed>ُّب<tajweed class=madda_permissible>ِي</tajweed>نٌ <span class=end>٢٩</span>","End":"٢٩","PageNumber":491,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":426,"MaqraNumber":197,"HizbNumber":50,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":30,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَمَّا جَآءَهُمُ ٱلۡحَقُّ قَالُواْ هَٰذَا سِحۡرٞ وَإِنَّا بِهِۦ كَٰفِرُونَ","TajweedText":"وَلَ<tajweed class=ghunnah>مّ</tajweed>َا ج<tajweed class=madda_obligatory>َا</tajweed>ٓءَهُمُ <tajweed class=ham_wasl>ٱ</tajweed>لْحَقُّ قَالُو<tajweed class=slnt>اْ</tajweed> هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا سِحْ<tajweed class=idgham_ghunnah>رٌ و</tajweed>َإِ<tajweed class=ghunnah>نّ</tajweed>َا بِه<tajweed class=madda_normal>ِۦ</tajweed> كَ<tajweed class=madda_normal>ـٰ</tajweed>فِر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣٠</span>","End":"٣٠","PageNumber":491,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":426,"MaqraNumber":197,"HizbNumber":50,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":31,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَقَالُواْ لَوۡلَا نُزِّلَ هَٰذَا ٱلۡقُرۡءَانُ عَلَىٰ رَجُلٖ مِّنَ ٱلۡقَرۡيَتَيۡنِ عَظِيمٍ","TajweedText":"وَقَالُو<tajweed class=slnt>اْ</tajweed> لَوْلَا نُزِّلَ هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا <tajweed class=ham_wasl>ٱ</tajweed>لْقُرْءَانُ عَلَىٰ رَجُ<tajweed class=idgham_ghunnah>لٍ م</tajweed>ِّنَ <tajweed class=ham_wasl>ٱ</tajweed>لْقَرْيَتَيْنِ عَظ<tajweed class=madda_permissible>ِي</tajweed>مٍ <span class=end>٣١</span>","End":"٣١","PageNumber":491,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":426,"MaqraNumber":197,"HizbNumber":50,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":32,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَهُمۡ يَقۡسِمُونَ رَحۡمَتَ رَبِّكَۚ نَحۡنُ قَسَمۡنَا بَيۡنَهُم مَّعِيشَتَهُمۡ فِي ٱلۡحَيَوٰةِ ٱلدُّنۡيَاۚ وَرَفَعۡنَا بَعۡضَهُمۡ فَوۡقَ بَعۡضٖ دَرَجَٰتٖ لِّيَتَّخِذَ بَعۡضُهُم بَعۡضٗا سُخۡرِيّٗاۗ وَرَحۡمَتُ رَبِّكَ خَيۡرٞ مِّمَّا يَجۡمَعُونَ","TajweedText":"أَهُمْ يَ<tajweed class=qalaqah>قْ</tajweed>سِمُونَ رَحْمَتَ رَبِّكَ‌ۚ نَحْنُ قَسَمْنَا بَيْنَه<tajweed class=idgham_shafawi>ُم م</tajweed>َّعِيشَتَهُمْ فِى <tajweed class=ham_wasl>ٱ</tajweed>لْحَيَ<tajweed class=slnt>و</tajweed><tajweed class=madda_normal>ٲ</tajweed>ةِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>دُّنْيَا‌ۚ وَرَفَعْنَا بَعْضَهُمْ فَوْقَ بَعْ<tajweed class=ikhafa>ضٍ د</tajweed>َرَجَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_wo_ghunnah>تٍ ل</tajweed>ِّيَتَّخِذَ بَعْضُه<tajweed class=ikhafa_shafawi>ُم ب</tajweed>َعْ<tajweed class=ikhafa>ضًا س</tajweed>ُخْرِي<tajweed class=idgham_ghunnah>ًّا‌ۗ و</tajweed>َرَحْمَتُ رَبِّكَ خَيْ<tajweed class=idgham_ghunnah>رٌ م</tajweed>ِّ<tajweed class=ghunnah>مّ</tajweed>َا يَ<tajweed class=qalaqah>جْ</tajweed>مَع<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣٢</span>","End":"٣٢","PageNumber":491,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":426,"MaqraNumber":197,"HizbNumber":50,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":33,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَوۡلَآ أَن يَكُونَ ٱلنَّاسُ أُمَّةٗ وَٰحِدَةٗ لَّجَعَلۡنَا لِمَن يَكۡفُرُ بِٱلرَّحۡمَٰنِ لِبُيُوتِهِمۡ سُقُفٗا مِّن فِضَّةٖ وَمَعَارِجَ عَلَيۡهَا يَظۡهَرُونَ","TajweedText":"وَلَوْل<tajweed class=madda_obligatory>َآ</tajweed> أ<tajweed class=idgham_ghunnah>َن ي</tajweed>َكُونَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َاسُ أُ<tajweed class=ghunnah>مّ</tajweed>َ<tajweed class=idgham_ghunnah>ةً و</tajweed><tajweed class=madda_normal>َٲ</tajweed>حِدَ<tajweed class=idgham_wo_ghunnah>ةً ل</tajweed>َّجَعَلْنَا لِم<tajweed class=idgham_ghunnah>َن ي</tajweed>َكْفُرُ بِ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رَّحْمَ<tajweed class=madda_normal>ـٰ</tajweed>نِ لِبُيُوتِهِمْ سُقُ<tajweed class=idgham_ghunnah>فًا م</tajweed>ِّ<tajweed class=ikhafa>ن ف</tajweed>ِضَّ<tajweed class=idgham_ghunnah>ةٍ و</tajweed>َمَعَارِجَ عَلَيْهَا يَظْهَر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣٣</span>","End":"٣٣","PageNumber":491,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":426,"MaqraNumber":197,"HizbNumber":50,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":34,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلِبُيُوتِهِمۡ أَبۡوَٰبٗا وَسُرُرًا عَلَيۡهَا يَتَّكِـُٔونَ","TajweedText":"وَلِبُيُوتِهِمْ أَ<tajweed class=qalaqah>بْ</tajweed>و<tajweed class=madda_normal>َٲ</tajweed><tajweed class=idgham_ghunnah>بًا و</tajweed>َسُرُرًا عَلَيْهَا يَتَّكِــٔ<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣٤</span>","End":"٣٤","PageNumber":492,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":426,"MaqraNumber":197,"HizbNumber":50,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":35,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَزُخۡرُفٗاۚ وَإِن كُلُّ ذَٰلِكَ لَمَّا مَتَٰعُ ٱلۡحَيَوٰةِ ٱلدُّنۡيَاۚ وَٱلۡأٓخِرَةُ عِندَ رَبِّكَ لِلۡمُتَّقِينَ","TajweedText":"وَزُخْرُ<tajweed class=idgham_ghunnah>فًا‌ۚ و</tajweed>َإِ<tajweed class=ikhafa>ن ك</tajweed>ُلُّ ذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ لَ<tajweed class=ghunnah>مّ</tajweed>َا مَتَ<tajweed class=madda_normal>ـٰ</tajweed>عُ <tajweed class=ham_wasl>ٱ</tajweed>لْحَيَ<tajweed class=slnt>و</tajweed><tajweed class=madda_normal>ٲ</tajweed>ةِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>دُّنْيَا‌ۚ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْأَخِرَةُ عِ<tajweed class=ikhafa>ند</tajweed>َ رَبِّكَ لِلْمُتَّق<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٣٥</span>","End":"٣٥","PageNumber":492,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":426,"MaqraNumber":197,"HizbNumber":50,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":36,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَن يَعۡشُ عَن ذِكۡرِ ٱلرَّحۡمَٰنِ نُقَيِّضۡ لَهُۥ شَيۡطَٰنٗا فَهُوَ لَهُۥ قَرِينٞ","TajweedText":"وَم<tajweed class=idgham_ghunnah>َن ي</tajweed>َعْشُ عَ<tajweed class=ikhafa>ن ذ</tajweed>ِكْرِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رَّحْمَ<tajweed class=madda_normal>ـٰ</tajweed>نِ نُقَيِّضْ لَهُ<tajweed class=madda_normal>ۥ</tajweed> شَيْطَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=ikhafa>نًا ف</tajweed>َهُوَ لَهُ<tajweed class=madda_normal>ۥ</tajweed> قَر<tajweed class=madda_permissible>ِي</tajweed>نٌ <span class=end>٣٦</span>","End":"٣٦","PageNumber":492,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":427,"MaqraNumber":197,"HizbNumber":50,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":37,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِنَّهُمۡ لَيَصُدُّونَهُمۡ عَنِ ٱلسَّبِيلِ وَيَحۡسَبُونَ أَنَّهُم مُّهۡتَدُونَ","TajweedText":"وَإِ<tajweed class=ghunnah>نّ</tajweed>َهُمْ لَيَصُدُّونَهُمْ عَنِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّبِيلِ وَيَحْسَبُونَ أَ<tajweed class=ghunnah>نّ</tajweed>َه<tajweed class=idgham_shafawi>ُم م</tajweed>ُّهْتَد<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣٧</span>","End":"٣٧","PageNumber":492,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":427,"MaqraNumber":197,"HizbNumber":50,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":38,"ShowSurahName":false,"ShowBismillah":false,"Text":"حَتَّىٰٓ إِذَا جَآءَنَا قَالَ يَٰلَيۡتَ بَيۡنِي وَبَيۡنَكَ بُعۡدَ ٱلۡمَشۡرِقَيۡنِ فَبِئۡسَ ٱلۡقَرِينُ","TajweedText":"حَتَّ<tajweed class=madda_obligatory>ىٰٓ</tajweed> إِذَا ج<tajweed class=madda_obligatory>َا</tajweed>ٓءَنَا قَالَ يَ<tajweed class=madda_normal>ـٰ</tajweed>لَيْتَ بَيْنِى وَبَيْنَكَ بُعْدَ <tajweed class=ham_wasl>ٱ</tajweed>لْمَشْرِقَيْنِ فَبِئْسَ <tajweed class=ham_wasl>ٱ</tajweed>لْقَر<tajweed class=madda_permissible>ِي</tajweed>نُ <span class=end>٣٨</span>","End":"٣٨","PageNumber":492,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":427,"MaqraNumber":197,"HizbNumber":50,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":39,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَن يَنفَعَكُمُ ٱلۡيَوۡمَ إِذ ظَّلَمۡتُمۡ أَنَّكُمۡ فِي ٱلۡعَذَابِ مُشۡتَرِكُونَ","TajweedText":"وَل<tajweed class=idgham_ghunnah>َن ي</tajweed>َ<tajweed class=ikhafa>نف</tajweed>َعَكُمُ <tajweed class=ham_wasl>ٱ</tajweed>لْيَوْمَ إِ<tajweed class=idgham_mutajanisayn>ذ</tajweed> ظَّلَمْتُمْ أَ<tajweed class=ghunnah>نّ</tajweed>َكُمْ فِى <tajweed class=ham_wasl>ٱ</tajweed>لْعَذَابِ مُشْتَرِك<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣٩</span>","End":"٣٩","PageNumber":492,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":427,"MaqraNumber":197,"HizbNumber":50,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":40,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَفَأَنتَ تُسۡمِعُ ٱلصُّمَّ أَوۡ تَهۡدِي ٱلۡعُمۡيَ وَمَن كَانَ فِي ضَلَٰلٖ مُّبِينٖ","TajweedText":"أَفَأَ<tajweed class=ikhafa>نت</tajweed>َ تُسْمِعُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>صُّ<tajweed class=ghunnah>مّ</tajweed>َ أَوْ تَهْدِى <tajweed class=ham_wasl>ٱ</tajweed>لْعُمْىَ وَمَ<tajweed class=ikhafa>ن ك</tajweed>َانَ فِى ضَلَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>لٍ م</tajweed>ُّب<tajweed class=madda_permissible>ِي</tajweed>نٍ <span class=end>٤٠</span>","End":"٤٠","PageNumber":492,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":427,"MaqraNumber":197,"HizbNumber":50,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumbe