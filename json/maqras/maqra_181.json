=idgham_ghunnah>رٌ م</tajweed>ِّنْهُمْ‌ۖ وَقَالَ <tajweed class=ham_wasl>ٱ</tajweed>لْكَ<tajweed class=madda_normal>ـٰ</tajweed>فِرُونَ هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا سَ<tajweed class=madda_normal>ـٰ</tajweed>حِ<tajweed class=ikhafa>رٌ ك</tajweed>َذّ<tajweed class=madda_permissible>َا</tajweed><tajweed class=qalaqah>ب</tajweed>ٌ <span class=end>٤</span>","End":"٤","PageNumber":453,"JuzNumber":23,"ManzilNumber":6,"RukuNumber":391,"MaqraNumber":181,"HizbNumber":46,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":38,"SurahIndex":"038","VerseNumber":5,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَجَعَلَ ٱلۡأٓلِهَةَ إِلَٰهٗا وَٰحِدًاۖ إِنَّ هَٰذَا لَشَيۡءٌ عُجَابٞ","TajweedText":"أَجَعَلَ <tajweed class=ham_wasl>ٱ</tajweed>لْأَلِهَةَ إِلَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>هًا و</tajweed><tajweed class=madda_normal>َٲ</tajweed>حِدًا‌ۖ إِ<tajweed class=ghunnah>نّ</tajweed>َ هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا لَشَىْءٌ عُج<tajweed class=madda_permissible>َا</tajweed><tajweed class=qalaqah>ب</tajweed>ٌ <span class=end>٥</span>","End":"٥","PageNumber":453,"JuzNumber":23,"ManzilNumber":6,"RukuNumber":391,"MaqraNumber":181,"HizbNumber":46,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":38,"SurahIndex":"038","VerseNumber":6,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَٱنطَلَقَ ٱلۡمَلَأُ مِنۡهُمۡ أَنِ ٱمۡشُواْ وَٱصۡبِرُواْ عَلَىٰٓ ءَالِهَتِكُمۡۖ إِنَّ هَٰذَا لَشَيۡءٞ يُرَادُ","TajweedText":"وَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=ikhafa>نط</tajweed>َلَقَ <tajweed class=ham_wasl>ٱ</tajweed>لْمَلَأُ مِنْهُمْ أَنِ <tajweed class=ham_wasl>ٱ</tajweed>مْشُو<tajweed class=slnt>اْ</tajweed> وَ<tajweed class=ham_wasl>ٱ</tajweed>صْبِرُو<tajweed class=slnt>اْ</tajweed> عَلَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> ءَالِهَتِكُمْ‌ۖ إِ<tajweed class=ghunnah>نّ</tajweed>َ هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا لَش<tajweed class=idgham_ghunnah>َىْءٌ ي</tajweed>ُر<tajweed class=madda_permissib