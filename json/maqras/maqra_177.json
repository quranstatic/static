{"MaqraNumber":177.0,"Verses":[{"SurahNumber":36,"SurahIndex":"036","VerseNumber":28,"ShowSurahName":false,"ShowBismillah":false,"Text":"۞وَمَآ أَنزَلۡنَا عَلَىٰ قَوۡمِهِۦ مِنۢ بَعۡدِهِۦ مِن جُندٖ مِّنَ ٱلسَّمَآءِ وَمَا كُنَّا مُنزِلِينَ","TajweedText":"۞ وَم<tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=ikhafa>نز</tajweed>َلْنَا عَلَىٰ قَوْمِه<tajweed class=madda_normal>ِۦ</tajweed> م<tajweed class=iqlab>ِنۢ ب</tajweed>َعْدِه<tajweed class=madda_normal>ِۦ</tajweed> مِ<tajweed class=ikhafa>ن ج</tajweed>ُن<tajweed class=idgham_ghunnah>دٍ م</tajweed>ِّنَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّم<tajweed class=madda_obligatory>َا</tajweed>ٓءِ وَمَا كُ<tajweed class=ghunnah>نّ</tajweed>َا مُ<tajweed class=ikhafa>نز</tajweed>ِل<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٢٨</span>","End":"٢٨","PageNumber":442,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":382,"MaqraNumber":177,"HizbNumber":45,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":29,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِن كَانَتۡ إِلَّا صَيۡحَةٗ وَٰحِدَةٗ فَإِذَا هُمۡ خَٰمِدُونَ","TajweedText":"إِ<tajweed class=ikhafa>ن ك</tajweed>َانَتْ إِلَّا صَيْحَ<tajweed class=idgham_ghunnah>ةً و</tajweed><tajweed class=madda_normal>َٲ</tajweed>حِدَ<tajweed class=ikhafa>ةً ف</tajweed>َإِذَا هُمْ خَ<tajweed class=madda_normal>ـٰ</tajweed>مِد<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٩</span>","End":"٢٩","PageNumber":442,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":382,"MaqraNumber":177,"HizbNumber":45,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":30,"ShowSurahName":false,"ShowBismillah":false,"Text":"يَٰحَسۡرَةً عَلَى ٱلۡعِبَادِۚ مَا يَأۡتِيهِم مِّن رَّسُولٍ إِلَّا كَانُواْ بِهِۦ يَسۡتَهۡزِءُونَ","TajweedText":"يَ<tajweed class=madda_normal>ـٰ</tajweed>حَسْرَةً عَلَى <tajweed class=ham_wasl>ٱ</tajweed>لْعِبَادِ‌ۚ مَا يَأْتِيه<tajweed class=idgham_shafawi>ِم م</tajweed>ّ<tajweed class=idgham_wo_ghunnah>ِن ر</tajweed>َّسُولٍ إِلَّا كَانُو<tajweed class=slnt>اْ</tajweed> بِه<tajweed class=madda_normal>ِۦ</tajweed> يَسْتَهْزِء<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣٠</span>","End":"٣٠","PageNumber":442,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":382,"MaqraNumber":177,"HizbNumber":45,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":31,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَلَمۡ يَرَوۡاْ كَمۡ أَهۡلَكۡنَا قَبۡلَهُم مِّنَ ٱلۡقُرُونِ أَنَّهُمۡ إِلَيۡهِمۡ لَا يَرۡجِعُونَ","TajweedText":"أَلَمْ يَرَوْ<tajweed class=slnt>اْ</tajweed> كَمْ أَهْلَكْنَا قَ<tajweed class=qalaqah>بْ</tajweed>لَه<tajweed class=idgham_shafawi>ُم م</tajweed>ِّنَ <tajweed class=ham_wasl>ٱ</tajweed>لْقُرُونِ أَ<tajweed class=ghunnah>نّ</tajweed>َهُمْ إِلَيْهِمْ لَا يَرْجِع<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣١</span>","End":"٣١","PageNumber":442,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":382,"MaqraNumber":177,"HizbNumber":45,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":32,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِن كُلّٞ لَّمَّا جَمِيعٞ لَّدَيۡنَا مُحۡضَرُونَ","TajweedText":"وَإِ<tajweed class=ikhafa>ن ك</tajweed>ُ<tajweed class=idgham_wo_ghunnah>لٌّ ل</tajweed>َّ<tajweed class=ghunnah>مّ</tajweed>َا جَمِي<tajweed class=idgham_wo_ghunnah>عٌ ل</tajweed>َّدَيْنَا مُحْضَر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣٢</span>","End":"٣٢","PageNumber":442,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":382,"MaqraNumber":177,"HizbNumber":45,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":33,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَءَايَةٞ لَّهُمُ ٱلۡأَرۡضُ ٱلۡمَيۡتَةُ أَحۡيَيۡنَٰهَا وَأَخۡرَجۡنَا مِنۡهَا حَبّٗا فَمِنۡهُ يَأۡكُلُونَ","TajweedText":"وَءَايَ<tajweed class=idgham_wo_ghunnah>ةٌ ل</tajweed>َّهُمُ <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضُ <tajweed class=ham_wasl>ٱ</tajweed>لْمَيْتَةُ أَحْيَيْنَ<tajweed class=madda_normal>ـٰ</tajweed>هَا وَأَخْرَ<tajweed class=qalaqah>جْ</tajweed>نَا مِنْهَا حَب<tajweed class=ikhafa>ًّا ف</tajweed>َمِنْهُ يَأْكُل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣٣</span>","End":"٣٣","PageNumber":442,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":383,"MaqraNumber":177,"HizbNumber":45,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":34,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَجَعَلۡنَا فِيهَا جَنَّـٰتٖ مِّن نَّخِيلٖ وَأَعۡنَٰبٖ وَفَجَّرۡنَا فِيهَا مِنَ ٱلۡعُيُونِ","TajweedText":"وَجَعَلْنَا فِيهَا جَ<tajweed class=ghunnah>نّ</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>تٍ م</tajweed>ّ<tajweed class=idgham_ghunnah>ِن ن</tajweed>َّخِي<tajweed class=idgham_ghunnah>لٍ و</tajweed>َأَعْنَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>بٍ و</tajweed>َفَجَّرْنَا فِيهَا مِنَ <tajweed class=ham_wasl>ٱ</tajweed>لْعُي<tajweed class=madda_permissible>ُو</tajweed>نِ <span class=end>٣٤</span>","End":"٣٤","PageNumber":442,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":383,"MaqraNumber":177,"HizbNumber":45,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":35,"ShowSurahName":false,"ShowBismillah":false,"Text":"لِيَأۡكُلُواْ مِن ثَمَرِهِۦ وَمَا عَمِلَتۡهُ أَيۡدِيهِمۡۚ أَفَلَا يَشۡكُرُونَ","TajweedText":"لِيَأْكُلُو<tajweed class=slnt>اْ</tajweed> مِ<tajweed class=ikhafa>ن ث</tajweed>َمَرِه<tajweed class=madda_normal>ِۦ</tajweed> وَمَا عَمِلَتْهُ أَيْدِيهِمْ‌ۖ أَفَلَا يَشْكُر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣٥</span>","End":"٣٥","PageNumber":442,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":383,"MaqraNumber":177,"HizbNumber":45,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":36,"ShowSurahName":false,"ShowBismillah":false,"Text":"سُبۡحَٰنَ ٱلَّذِي خَلَقَ ٱلۡأَزۡوَٰجَ كُلَّهَا مِمَّا تُنۢبِتُ ٱلۡأَرۡضُ وَمِنۡ أَنفُسِهِمۡ وَمِمَّا لَا يَعۡلَمُونَ","TajweedText":"سُ<tajweed class=qalaqah>بْ</tajweed>حَ<tajweed class=madda_normal>ـٰ</tajweed>نَ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى خَلَقَ <tajweed class=ham_wasl>ٱ</tajweed>لْأَزْو<tajweed class=madda_normal>َٲ</tajweed>جَ كُلَّهَا مِ<tajweed class=ghunnah>مّ</tajweed>َا تُ<tajweed class=iqlab>نۢب</tajweed>ِتُ <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضُ وَمِنْ أَ<tajweed class=ikhafa>نف</tajweed>ُسِهِمْ وَمِ<tajweed class=ghunnah>مّ</tajweed>َا لَا يَعْلَم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣٦</span>","End":"٣٦","PageNumber":442,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":383,"MaqraNumber":177,"HizbNumber":45,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":37,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَءَايَةٞ لَّهُمُ ٱلَّيۡلُ نَسۡلَخُ مِنۡهُ ٱلنَّهَارَ فَإِذَا هُم مُّظۡلِمُونَ","TajweedText":"وَءَايَ<tajweed class=idgham_wo_ghunnah>ةٌ ل</tajweed>َّهُمُ <tajweed class=ham_wasl>ٱ</tajweed>لَّيْلُ نَسْلَخُ مِنْهُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َهَارَ فَإِذَا ه<tajweed class=idgham_shafawi>ُم م</tajweed>ُّظْلِم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣٧</span>","End":"٣٧","PageNumber":442,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":383,"MaqraNumber":177,"HizbNumber":45,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":38,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَٱلشَّمۡسُ تَجۡرِي لِمُسۡتَقَرّٖ لَّهَاۚ ذَٰلِكَ تَقۡدِيرُ ٱلۡعَزِيزِ ٱلۡعَلِيمِ","TajweedText":"وَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>شَّمْسُ تَ<tajweed class=qalaqah>جْ</tajweed>رِى لِمُسْتَقَ<tajweed class=idgham_wo_ghunnah>رٍّ ل</tajweed>َّهَا‌ۚ ذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ تَ<tajweed class=qalaqah>قْ</tajweed>دِيرُ <tajweed class=ham_wasl>ٱ</tajweed>لْعَزِيزِ <tajweed class=ham_wasl>ٱ</tajweed>لْعَل<tajweed class=madda_permissible>ِي</tajweed>مِ <span class=end>٣٨</span>","End":"٣٨","PageNumber":442,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":383,"MaqraNumber":177,"HizbNumber":45,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":39,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَٱلۡقَمَرَ قَدَّرۡنَٰهُ مَنَازِلَ حَتَّىٰ عَادَ كَٱلۡعُرۡجُونِ ٱلۡقَدِيمِ","TajweedText":"وَ<tajweed class=ham_wasl>ٱ</tajweed>لْقَمَرَ قَدَّرْنَ<tajweed class=madda_normal>ـٰ</tajweed>هُ مَنَازِلَ حَتَّىٰ عَادَ كَ<tajweed class=ham_wasl>ٱ</tajweed>لْعُرْجُونِ <tajweed class=ham_wasl>ٱ</tajweed>لْقَد<tajweed class=madda_permissible>ِي</tajweed>مِ <span class=end>٣٩</span>","End":"٣٩","PageNumber":442,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":383,"MaqraNumber":177,"HizbNumber":45,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":40,"ShowSurahName":false,"ShowBismillah":false,"Text":"لَا ٱلشَّمۡسُ يَنۢبَغِي لَهَآ أَن تُدۡرِكَ ٱلۡقَمَرَ وَلَا ٱلَّيۡلُ سَابِقُ ٱلنَّهَارِۚ وَكُلّٞ فِي فَلَكٖ يَسۡبَحُونَ","TajweedText":"لَا <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>شَّمْسُ يَ<tajweed class=iqlab>نۢب</tajweed>َغِى لَه<tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=ikhafa>ن ت</tajweed>ُ<tajweed class=qalaqah>دْ</tajweed>رِكَ <tajweed class=ham_wasl>ٱ</tajweed>لْقَمَرَ وَلَا <tajweed class=ham_wasl>ٱ</tajweed>لَّيْلُ سَابِقُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َهَارِ‌ۚ وَكُ<tajweed class=ikhafa>لٌّ ف</tajweed>ِى فَلَ<tajweed class=idgham_ghunnah>كٍ ي</tajweed>َسْبَح<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٤٠</span>","End":"٤٠","PageNumber":442,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":383,"MaqraNumber":177,"HizbNumber":45,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":41,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَءَايَةٞ لَّهُمۡ أَنَّا حَمَلۡنَا ذُرِّيَّتَهُمۡ فِي ٱلۡفُلۡكِ ٱلۡمَشۡحُونِ","TajweedText":"وَءَايَ<tajweed class=idgham_wo_ghunnah>ةٌ ل</tajweed>َّهُمْ أَ<tajweed class=ghunnah>نّ</tajweed>َا حَمَلْنَا ذُرِّيَّتَهُمْ فِى <tajweed class=ham_wasl>ٱ</tajweed>لْفُلْكِ <tajweed class=ham_wasl>ٱ</tajweed>لْمَشْح<tajweed class=madda_permissible>ُو</tajweed>نِ <span class=end>٤١</span>","End":"٤١","PageNumber":443,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":383,"MaqraNumber":177,"HizbNumber":45,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":42,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَخَلَقۡنَا لَهُم مِّن مِّثۡلِهِۦ مَا يَرۡكَبُونَ","TajweedText":"وَخَلَ<tajweed class=qalaqah>قْ</tajweed>نَا لَه<tajweed class=idgham_shafawi>ُم م</tajweed>ّ<tajweed class=idgham_ghunnah>ِن م</tajweed>ِّثْلِه<tajweed class=madda_normal>ِۦ</tajweed> مَا يَرْكَب<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٤٢</span>","End":"٤٢","PageNumber":443,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":383,"MaqraNumber":177,"HizbNumber":45,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":43,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِن نَّشَأۡ نُغۡرِقۡهُمۡ فَلَا صَرِيخَ لَهُمۡ وَلَا هُمۡ يُنقَذُونَ","TajweedText":"وَإ<tajweed class=idgham_ghunnah>ِن ن</tajweed>َّشَأْ نُغْرِ<tajweed class=qalaqah>قْ</tajweed>هُمْ فَلَا صَرِيخَ لَهُمْ وَلَا هُمْ يُ<tajweed class=ikhafa>نق</tajweed>َذ<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٤٣</span>","End":"٤٣","PageNumber":443,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":383,"MaqraNumber":177,"HizbNumber":45,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":44,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِلَّا رَحۡمَةٗ مِّنَّا وَمَتَٰعًا إِلَىٰ حِينٖ","TajweedText":"إِلَّا رَحْمَ<tajweed class=idgham_ghunnah>ةً م</tajweed>ِّ<tajweed class=ghunnah>نّ</tajweed>َا وَمَتَ<tajweed class=madda_normal>ـٰ</tajweed>عًا إِلَىٰ ح<tajweed class=madda_permissible>ِي</tajweed>نٍ <span class=end>٤٤</span>","End":"٤٤","PageNumber":443,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":383,"MaqraNumber":177,"HizbNumber":45,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":45,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِذَا قِيلَ لَهُمُ ٱتَّقُواْ مَا بَيۡنَ أَيۡدِيكُمۡ وَمَا خَلۡفَكُمۡ لَعَلَّكُمۡ تُرۡحَمُونَ","TajweedText":"وَإِذَا قِيلَ لَهُمُ <tajweed class=ham_wasl>ٱ</tajweed>تَّقُو<tajweed class=slnt>اْ</tajweed> مَا بَيْنَ أَيْدِيكُمْ وَمَا خَلْفَكُمْ لَعَلَّكُمْ تُرْحَم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٤٥</span>","End":"٤٥","PageNumber":443,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":383,"MaqraNumber":177,"HizbNumber":45,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":46,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَا تَأۡتِيهِم مِّنۡ ءَايَةٖ مِّنۡ ءَايَٰتِ رَبِّهِمۡ إِلَّا كَانُواْ عَنۡهَا مُعۡرِضِينَ","TajweedText":"وَمَا تَأْتِيه<tajweed class=idgham_shafawi>ِم م</tajweed>ِّنْ ءَايَ<tajweed class=idgham_ghunnah>ةٍ م</tajweed>ِّنْ ءَايَ<tajweed class=madda_normal>ـٰ</tajweed>تِ رَبِّهِمْ إِلَّا كَانُو<tajweed class=slnt>اْ</tajweed> عَنْهَا مُعْرِض<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٤٦</span>","End":"٤٦","PageNumber":443,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":383,"MaqraNumber":177,"HizbNumber":45,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":47,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِذَا قِيلَ لَهُمۡ أَنفِقُواْ مِمَّا رَزَقَكُمُ ٱللَّهُ قَالَ ٱلَّذِينَ كَفَرُواْ لِلَّذِينَ ءَامَنُوٓاْ أَنُطۡعِمُ مَن لَّوۡ يَشَآءُ ٱللَّهُ أَطۡعَمَهُۥٓ إِنۡ أَنتُمۡ إِلَّا فِي ضَلَٰلٖ مُّبِينٖ","TajweedText":"وَإِذَا قِيلَ لَهُمْ أَ<tajweed class=ikhafa>نف</tajweed>ِقُو<tajweed class=slnt>اْ</tajweed> مِ<tajweed class=ghunnah>مّ</tajweed>َا رَزَقَكُمُ <tajweed class=ham_wasl>ٱ</tajweed>للَّهُ قَالَ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ كَفَرُو<tajweed class=slnt>اْ</tajweed> لِلَّذِينَ ءَامَن<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> أَنُ<tajweed class=qalaqah>طْ</tajweed>عِمُ م<tajweed class=idgham_wo_ghunnah>َن ل</tajweed>َّوْ يَش<tajweed class=madda_obligatory>َا</tajweed>ٓءُ <tajweed class=ham_wasl>ٱ</tajweed>للَّهُ أَ<tajweed class=qalaqah>طْ</tajweed>عَمَهُ<tajweed class=madda_obligatory>ۥٓ</tajweed> إِنْ أَ<tajweed class=ikhafa>نت</tajweed>ُمْ إِلَّا فِى ضَلَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>لٍ م</tajweed>ُّب<tajweed class=madda_permissible>ِي</tajweed>نٍ <span class=end>٤٧</span>","End":"٤٧","PageNumber":443,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":383,"MaqraNumber":177,"HizbNumber":45,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":48,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَيَقُولُونَ مَتَىٰ هَٰذَا ٱلۡوَعۡدُ إِن كُنتُمۡ صَٰدِقِينَ","TajweedText":"وَيَقُولُونَ مَتَىٰ هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا <tajweed class=ham_wasl>ٱ</tajweed>لْوَعْدُ إِ<tajweed class=ikhafa>ن ك</tajweed>ُ<tajweed class=ikhafa>نت</tajweed>ُمْ صَ<tajweed class=madda_normal>ـٰ</tajweed>دِق<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٤٨</span>","End":"٤٨","PageNumber":443,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":383,"MaqraNumber":177,"HizbNumber":45,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":49,"ShowSurahName":false,"ShowBismillah":false,"Text":"مَا يَنظُرُونَ إِلَّا صَيۡحَةٗ وَٰحِدَةٗ تَأۡخُذُهُمۡ وَهُمۡ يَخِصِّمُونَ","TajweedText":"مَا يَ<tajweed class=ikhafa>نظ</tajweed>ُرُونَ إِلَّا صَيْحَ<tajweed class=idgham_ghunnah>ةً و</tajweed><tajweed class=madda_normal>َٲ</tajweed>حِدَ<tajweed class=ikhafa>ةً ت</tajweed>َأْخُذُهُمْ وَهُمْ يَخِصِّم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٤٩</span>","End":"٤٩","PageNumber":443,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":383,"MaqraNumber":177,"HizbNumber":45,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":50,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَلَا يَسۡتَطِيعُونَ تَوۡصِيَةٗ وَلَآ إِلَىٰٓ أَهۡلِهِمۡ يَرۡجِعُونَ","TajweedText":"فَلَا يَسْتَطِيعُونَ تَوْصِيَ<tajweed class=idgham_ghunnah>ةً و</tajweed>َل<tajweed class=madda_obligatory>َآ</tajweed> إِلَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> أَهْلِهِمْ يَرْجِع<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٥٠</span>","End":"٥٠","PageNumber":443,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":383,"MaqraNumber":177,"HizbNumber":45,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":51,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَنُفِخَ فِي ٱلصُّورِ فَإِذَا هُم مِّنَ ٱلۡأَجۡدَاثِ إِلَىٰ رَبِّهِمۡ يَنسِلُونَ","TajweedText":"وَنُفِخَ فِى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>صُّورِ فَإِذَا ه<tajweed class=idgham_shafawi>ُم م</tajweed>ِّنَ <tajweed class=ham_wasl>ٱ</tajweed>لْأَ<tajweed class=qalaqah>جْ</tajweed>دَاثِ إِلَىٰ رَبِّهِمْ يَ<tajweed class=ikhafa>نس</tajweed>ِل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٥١</span>","End":"٥١","PageNumber":443,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":384,"MaqraNumber":177,"HizbNumber":45,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":52,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَالُواْ يَٰوَيۡلَنَا مَنۢ بَعَثَنَا مِن مَّرۡقَدِنَاۜۗ هَٰذَا مَا وَعَدَ ٱلرَّحۡمَٰنُ وَصَدَقَ ٱلۡمُرۡسَلُونَ","TajweedText":"قَالُو<tajweed class=slnt>اْ</tajweed> يَ<tajweed class=madda_normal>ـٰ</tajweed>وَيْلَنَا م<tajweed class=iqlab>َنۢ ب</tajweed>َعَثَنَا م<tajweed class=idgham_ghunnah>ِن م</tajweed>َّرْقَدِنَاۜ‌ۗ هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا مَا وَعَدَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رَّحْمَ<tajweed class=madda_normal>ـٰ</tajweed>نُ وَصَدَقَ <tajweed class=ham_wasl>ٱ</tajweed>لْمُرْسَل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٥٢</span>","End":"٥٢","PageNumber":443,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":384,"MaqraNumber":177,"HizbNumber":45,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":53,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِن كَانَتۡ إِلَّا صَيۡحَةٗ وَٰحِدَةٗ فَإِذَا هُمۡ جَمِيعٞ لَّدَيۡنَا مُحۡضَرُونَ","TajweedText":"إِ<tajweed class=ikhafa>ن ك</tajweed>َانَتْ إِلَّا صَيْحَ<tajweed class=idgham_ghunnah>ةً و</tajweed><tajweed class=madda_normal>َٲ</tajweed>حِدَ<tajweed class=ikhafa>ةً ف</tajweed>َإِذَا هُمْ جَمِي<tajweed class=idgham_wo_ghunnah>عٌ ل</tajweed>َّدَيْنَا مُحْضَر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٥٣</span>","End":"٥٣","PageNumber":443,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":384,"MaqraNumber":177,"HizbNumber":45,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":54,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَٱلۡيَوۡمَ لَا تُظۡلَمُ نَفۡسٞ شَيۡـٔٗا وَلَا تُجۡزَوۡنَ إِلَّا مَا كُنتُمۡ تَعۡمَلُونَ","TajweedText":"فَ<tajweed class=ham_wasl>ٱ</tajweed>لْيَوْمَ لَا تُظْلَمُ نَفْ<tajweed class=ikhafa>سٌ ش</tajweed>َيْـ<tajweed class=idgham_ghunnah>ـًٔا و</tajweed>َلَا تُ<tajweed class=qalaqah>جْ</tajweed>زَوْنَ إِلَّا مَا كُ<tajweed class=ikhafa>نت</tajweed>ُمْ تَعْمَل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٥٤</span>","End":"٥٤","PageNumber":443,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":384,"MaqraNumber":177,"HizbNumber":45,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":55,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّ أَصۡحَٰبَ ٱلۡجَنَّةِ ٱلۡيَوۡمَ فِي شُغُلٖ فَٰكِهُونَ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َ أَصْحَ<tajweed class=madda_normal>ـٰ</tajweed>بَ <tajweed class=ham_wasl>ٱ</tajweed>لْجَ<tajweed class=ghunnah>نّ</tajweed>َةِ <tajweed class=ham_wasl>ٱ</tajweed>لْيَوْمَ فِى شُغُ<tajweed class=ikhafa>لٍ ف</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed>كِه<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٥٥</span>","End":"٥٥","PageNumber":444,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":384,"MaqraNumber":177,"HizbNumber":45,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":56,"ShowSurahName":false,"ShowBismillah":false,"Text":"هُمۡ وَأَزۡوَٰجُهُمۡ فِي ظِلَٰلٍ عَلَى ٱلۡأَرَآئِكِ مُتَّكِـُٔونَ","TajweedText":"هُمْ وَأَزْو<tajweed class=madda_normal>َٲ</tajweed>جُهُمْ فِى ظِلَ<tajweed class=madda_normal>ـٰ</tajweed>لٍ عَلَى <tajweed class=ham_wasl>ٱ</tajweed>لْأَر<tajweed class=madda_obligatory>َا</tajweed>ٓئِكِ مُتَّكِــٔ<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٥٦</span>","End":"٥٦","PageNumber":444,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":384,"MaqraNumber":177,"HizbNumber":45,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":57,"ShowSurahName":false,"ShowBismillah":false,"Text":"لَهُمۡ فِيهَا فَٰكِهَةٞ وَلَهُم مَّا يَدَّعُونَ","TajweedText":"لَهُمْ فِيهَا فَ<tajweed class=madda_normal>ـٰ</tajweed>كِهَ<tajweed class=idgham_ghunnah>ةٌ و</tajweed>َلَه<tajweed class=idgham_shafawi>ُم م</tajweed>َّا يَدَّع<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٥٧</span>","End":"٥٧","PageNumber":444,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":384,"MaqraNumber":177,"HizbNumber":45,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":58,"ShowSurahName":false,"ShowBismillah":false,"Text":"سَلَٰمٞ قَوۡلٗا مِّن رَّبّٖ رَّحِيمٖ","TajweedText":"سَلَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=ikhafa>مٌ ق</tajweed>َوْل<tajweed class=idgham_ghunnah>اً م</tajweed>ّ<tajweed class=idgham_wo_ghunnah>ِن ر</tajweed>َّ<tajweed class=idgham_wo_ghunnah>بٍّ ر</tajweed>َّح<tajweed class=madda_permissible>ِي</tajweed>مٍ <span class=end>٥٨</span>","End":"٥٨","PageNumber":444,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":384,"MaqraNumber":177,"HizbNumber":45,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":59,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَٱمۡتَٰزُواْ ٱلۡيَوۡمَ أَيُّهَا ٱلۡمُجۡرِمُونَ","TajweedText":"وَ<tajweed class=ham_wasl>ٱ</tajweed>مْتَ<tajweed class=madda_normal>ـٰ</tajweed>زُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed>لْيَوْمَ أَيُّهَا <tajweed class=ham_wasl>ٱ</tajweed>لْمُ<tajweed class=qalaqah>جْ</tajweed>رِم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٥٩</span>","End":"٥٩","PageNumber":444,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":384,"MaqraNumber":177,"HizbNumber":45,"HizbDecimal":0.0,"HasSajda":false}]}