/tajweed>زِىَ <tajweed class=ham_wasl>ٱ</tajweed>للَّهُ كُلَّ نَفْ<tajweed class=idgham_ghunnah>سٍ م</tajweed>َّا كَسَبَتْ‌ۚ إِ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>للَّهَ سَرِيعُ <tajweed class=ham_wasl>ٱ</tajweed>لْحِس<tajweed class=madda_permissible>َا</tajweed><tajweed class=qalaqah>ب</tajweed>ِ <span class=end>٥١</span>","End":"٥١","PageNumber":261,"JuzNumber":13,"ManzilNumber":3,"RukuNumber":217,"MaqraNumber":104,"HizbNumber":26,"HizbDecimal":0.75,"HasSajda":false},{"SurahNumber":14,"SurahIndex":"014","VerseNumber":52,"ShowSurahName":false,"ShowBismillah":false,"Text":"هَٰذَا بَلَٰغٞ لِّلنَّاسِ وَلِيُنذَرُواْ بِهِۦ وَلِيَعۡلَمُوٓاْ أَنَّمَا هُوَ إِلَٰهٞ وَٰحِدٞ وَلِيَذَّكَّرَ أُوْلُواْ ٱلۡأَلۡبَٰبِ","TajweedText":"هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا بَلَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_wo_ghunnah>غٌ ل</tajweed>ِّل<tajweed class=ghunnah>نّ</tajweed>َاسِ وَلِيُ<tajweed class=ikhafa>نذ</tajweed>َرُو<tajweed class=slnt>اْ</tajweed> بِه<tajweed class=madda_normal>ِۦ</tajweed> وَلِيَعْلَم<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> أَ<tajweed class=ghunnah>نّ</tajweed>َمَا هُوَ إِلَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>هٌ و</tajweed><tajweed class=madda_normal>َٲ</tajweed>حِ<tajweed class=idgham_ghunnah>دٌ و</tajweed>َلِيَذَّكَّرَ أُ<tajweed class=slnt>وْ</tajweed>لُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed>لْأَلْبَ<tajweed class=madda_permissible>ـٰ</tajweed><tajweed class=qalaqah>ب</tajweed>ِ <span class=end>٥٢</span>","End":"٥٢","PageNumber":261,"JuzNumber":13,"ManzilNumber":3,"RukuNumber":217,"MaqraNumber":104,"HizbNumber":26,"HizbDecimal":0.75,"HasSajda":false}]}