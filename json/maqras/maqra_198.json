{"MaqraNumber":198.0,"Verses":[{"SurahNumber":43,"SurahIndex":"043","VerseNumber":57,"ShowSurahName":false,"ShowBismillah":false,"Text":"۞وَلَمَّا ضُرِبَ ٱبۡنُ مَرۡيَمَ مَثَلًا إِذَا قَوۡمُكَ مِنۡهُ يَصِدُّونَ","TajweedText":"۞ وَلَ<tajweed class=ghunnah>مّ</tajweed>َا ضُرِبَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=qalaqah>بْ</tajweed>نُ مَرْيَمَ مَثَلاً إِذَا قَوْمُكَ مِنْهُ يَصِدّ<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٥٧</span>","End":"٥٧","PageNumber":493,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":429,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":58,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَقَالُوٓاْ ءَأَٰلِهَتُنَا خَيۡرٌ أَمۡ هُوَۚ مَا ضَرَبُوهُ لَكَ إِلَّا جَدَلَۢاۚ بَلۡ هُمۡ قَوۡمٌ خَصِمُونَ","TajweedText":"وَقَال<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> ءَأ<tajweed class=madda_normal>َٲ</tajweed>لِهَتُنَا خَيْرٌ أَمْ هُوَ‌ۚ مَا ضَرَبُوهُ لَكَ إِلَّا جَدَل<tajweed class=iqlab>اَۢ‌ۚ ب</tajweed>َلْ هُمْ قَوْمٌ خَصِم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٥٨</span>","End":"٥٨","PageNumber":493,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":429,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":59,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنۡ هُوَ إِلَّا عَبۡدٌ أَنۡعَمۡنَا عَلَيۡهِ وَجَعَلۡنَٰهُ مَثَلٗا لِّبَنِيٓ إِسۡرَـٰٓءِيلَ","TajweedText":"إِنْ هُوَ إِلَّا عَ<tajweed class=qalaqah>بْ</tajweed>دٌ أَنْعَمْنَا عَلَيْهِ وَجَعَلْنَ<tajweed class=madda_normal>ـٰ</tajweed>هُ مَثَل<tajweed class=idgham_wo_ghunnah>اً ل</tajweed>ِّبَن<tajweed class=madda_obligatory>ِىٓ</tajweed> إِسْر<tajweed class=madda_obligatory>َٲ</tajweed>ٓء<tajweed class=madda_permissible>ِي</tajweed>لَ <span class=end>٥٩</span>","End":"٥٩","PageNumber":493,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":429,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":60,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَوۡ نَشَآءُ لَجَعَلۡنَا مِنكُم مَّلَـٰٓئِكَةٗ فِي ٱلۡأَرۡضِ يَخۡلُفُونَ","TajweedText":"وَلَوْ نَش<tajweed class=madda_obligatory>َا</tajweed>ٓءُ لَجَعَلْنَا مِ<tajweed class=ikhafa>نك</tajweed><tajweed class=idgham_shafawi>ُم م</tajweed>َّلَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ئِكَ<tajweed class=ikhafa>ةً ف</tajweed>ِى <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ يَخْلُف<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٠</span>","End":"٦٠","PageNumber":493,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":429,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":61,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِنَّهُۥ لَعِلۡمٞ لِّلسَّاعَةِ فَلَا تَمۡتَرُنَّ بِهَا وَٱتَّبِعُونِۚ هَٰذَا صِرَٰطٞ مُّسۡتَقِيمٞ","TajweedText":"وَإِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> لَعِلْ<tajweed class=idgham_wo_ghunnah>مٌ ل</tajweed>ِّلسَّاعَةِ فَلَا تَمْتَرُ<tajweed class=ghunnah>نّ</tajweed>َ بِهَا وَ<tajweed class=ham_wasl>ٱ</tajweed>تَّبِعُونِ‌ۚ هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا صِر<tajweed class=madda_normal>َٲ</tajweed><tajweed class=idgham_ghunnah>طٌ م</tajweed>ُّسْتَق<tajweed class=madda_permissible>ِي</tajweed>مٌ <span class=end>٦١</span>","End":"٦١","PageNumber":494,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":429,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":62,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَا يَصُدَّنَّكُمُ ٱلشَّيۡطَٰنُۖ إِنَّهُۥ لَكُمۡ عَدُوّٞ مُّبِينٞ","TajweedText":"وَلَا يَصُدَّ<tajweed class=ghunnah>نّ</tajweed>َكُمُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>شَّيْطَ<tajweed class=madda_normal>ـٰ</tajweed>نُ‌ۖ إِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> لَكُمْ عَدُ<tajweed class=idgham_ghunnah>وٌّ م</tajweed>ُّب<tajweed class=madda_permissible>ِي</tajweed>نٌ <span class=end>٦٢</span>","End":"٦٢","PageNumber":494,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":429,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":63,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَمَّا جَآءَ عِيسَىٰ بِٱلۡبَيِّنَٰتِ قَالَ قَدۡ جِئۡتُكُم بِٱلۡحِكۡمَةِ وَلِأُبَيِّنَ لَكُم بَعۡضَ ٱلَّذِي تَخۡتَلِفُونَ فِيهِۖ فَٱتَّقُواْ ٱللَّهَ وَأَطِيعُونِ","TajweedText":"وَلَ<tajweed class=ghunnah>مّ</tajweed>َا ج<tajweed class=madda_obligatory>َا</tajweed>ٓءَ عِيسَىٰ بِ<tajweed class=ham_wasl>ٱ</tajweed>لْبَيِّنَ<tajweed class=madda_normal>ـٰ</tajweed>تِ قَالَ قَ<tajweed class=qalaqah>دْ</tajweed> جِئْتُك<tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِ<tajweed class=ham_wasl>ٱ</tajweed>لْحِكْمَةِ وَلِأُبَيِّنَ لَك<tajweed class=ikhafa_shafawi>ُم ب</tajweed>َعْضَ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى تَخْتَلِفُونَ فِيهِ‌ۖ فَ<tajweed class=ham_wasl>ٱ</tajweed>تَّقُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed>للَّهَ وَأَطِيع<tajweed class=madda_permissible>ُو</tajweed>نِ <span class=end>٦٣</span>","End":"٦٣","PageNumber":494,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":429,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":64,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّ ٱللَّهَ هُوَ رَبِّي وَرَبُّكُمۡ فَٱعۡبُدُوهُۚ هَٰذَا صِرَٰطٞ مُّسۡتَقِيمٞ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>للَّهَ هُوَ رَبِّى وَرَبُّكُمْ فَ<tajweed class=ham_wasl>ٱ</tajweed>عْبُدُوهُ‌ۚ هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا صِر<tajweed class=madda_normal>َٲ</tajweed><tajweed class=idgham_ghunnah>طٌ م</tajweed>ُّسْتَق<tajweed class=madda_permissible>ِي</tajweed>مٌ <span class=end>٦٤</span>","End":"٦٤","PageNumber":494,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":429,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":65,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَٱخۡتَلَفَ ٱلۡأَحۡزَابُ مِنۢ بَيۡنِهِمۡۖ فَوَيۡلٞ لِّلَّذِينَ ظَلَمُواْ مِنۡ عَذَابِ يَوۡمٍ أَلِيمٍ","TajweedText":"فَ<tajweed class=ham_wasl>ٱ</tajweed>خْتَلَفَ <tajweed class=ham_wasl>ٱ</tajweed>لْأَحْزَابُ م<tajweed class=iqlab>ِنۢ ب</tajweed>َيْنِهِمْ‌ۖ فَوَيْ<tajweed class=idgham_wo_ghunnah>لٌ ل</tajweed>ِّلَّذِينَ ظَلَمُو<tajweed class=slnt>اْ</tajweed> مِنْ عَذَابِ يَوْمٍ أَل<tajweed class=madda_permissible>ِي</tajweed>مٍ <span class=end>٦٥</span>","End":"٦٥","PageNumber":494,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":429,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":66,"ShowSurahName":false,"ShowBismillah":false,"Text":"هَلۡ يَنظُرُونَ إِلَّا ٱلسَّاعَةَ أَن تَأۡتِيَهُم بَغۡتَةٗ وَهُمۡ لَا يَشۡعُرُونَ","TajweedText":"هَلْ يَ<tajweed class=ikhafa>نظ</tajweed>ُرُونَ إِلَّا <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّاعَةَ أَ<tajweed class=ikhafa>ن ت</tajweed>َأْتِيَه<tajweed class=ikhafa_shafawi>ُم ب</tajweed>َغْتَ<tajweed class=idgham_ghunnah>ةً و</tajweed>َهُمْ لَا يَشْعُر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٦</span>","End":"٦٦","PageNumber":494,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":429,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":67,"ShowSurahName":false,"ShowBismillah":false,"Text":"ٱلۡأَخِلَّآءُ يَوۡمَئِذِۭ بَعۡضُهُمۡ لِبَعۡضٍ عَدُوٌّ إِلَّا ٱلۡمُتَّقِينَ","TajweedText":"ٱلْأَخِلّ<tajweed class=madda_obligatory>َا</tajweed>ٓءُ يَوْمَئِ<tajweed class=iqlab>ذِۭ ب</tajweed>َعْضُهُمْ لِبَعْضٍ عَدُوٌّ إِلَّا <tajweed class=ham_wasl>ٱ</tajweed>لْمُتَّق<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٦٧</span>","End":"٦٧","PageNumber":494,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":429,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":68,"ShowSurahName":false,"ShowBismillah":false,"Text":"يَٰعِبَادِ لَا خَوۡفٌ عَلَيۡكُمُ ٱلۡيَوۡمَ وَلَآ أَنتُمۡ تَحۡزَنُونَ","TajweedText":"يَ<tajweed class=madda_normal>ـٰ</tajweed>عِبَادِ لَا خَوْفٌ عَلَيْكُمُ <tajweed class=ham_wasl>ٱ</tajweed>لْيَوْمَ وَل<tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=ikhafa>نت</tajweed>ُمْ تَحْزَن<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٨</span>","End":"٦٨","PageNumber":494,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":430,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":69,"ShowSurahName":false,"ShowBismillah":false,"Text":"ٱلَّذِينَ ءَامَنُواْ بِـَٔايَٰتِنَا وَكَانُواْ مُسۡلِمِينَ","TajweedText":"ٱلَّذِينَ ءَامَنُو<tajweed class=slnt>اْ</tajweed> بِـَٔـايَ<tajweed class=madda_normal>ـٰ</tajweed>تِنَا وَكَانُو<tajweed class=slnt>اْ</tajweed> مُسْلِم<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٦٩</span>","End":"٦٩","PageNumber":494,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":430,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":70,"ShowSurahName":false,"ShowBismillah":false,"Text":"ٱدۡخُلُواْ ٱلۡجَنَّةَ أَنتُمۡ وَأَزۡوَٰجُكُمۡ تُحۡبَرُونَ","TajweedText":"ٱ<tajweed class=qalaqah>دْ</tajweed>خُلُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed>لْجَ<tajweed class=ghunnah>نّ</tajweed>َةَ أَ<tajweed class=ikhafa>نت</tajweed>ُمْ وَأَزْو<tajweed class=madda_normal>َٲ</tajweed>جُكُمْ تُحْبَر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٧٠</span>","End":"٧٠","PageNumber":494,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":430,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":71,"ShowSurahName":false,"ShowBismillah":false,"Text":"يُطَافُ عَلَيۡهِم بِصِحَافٖ مِّن ذَهَبٖ وَأَكۡوَابٖۖ وَفِيهَا مَا تَشۡتَهِيهِ ٱلۡأَنفُسُ وَتَلَذُّ ٱلۡأَعۡيُنُۖ وَأَنتُمۡ فِيهَا خَٰلِدُونَ","TajweedText":"يُطَافُ عَلَيْه<tajweed class=ikhafa_shafawi>ِم ب</tajweed>ِصِحَا<tajweed class=idgham_ghunnah>فٍ م</tajweed>ِّ<tajweed class=ikhafa>ن ذ</tajweed>َهَ<tajweed class=idgham_ghunnah>بٍ و</tajweed>َأَكْوَا<tajweed class=idgham_ghunnah>بٍ‌ۖ و</tajweed>َفِيهَا مَا تَشْتَهِيهِ <tajweed class=ham_wasl>ٱ</tajweed>لْأَ<tajweed class=ikhafa>نف</tajweed>ُسُ وَتَلَذُّ <tajweed class=ham_wasl>ٱ</tajweed>لْأَعْيُنُ‌ۖ وَأَ<tajweed class=ikhafa>نت</tajweed>ُمْ فِيهَا خَ<tajweed class=madda_normal>ـٰ</tajweed>لِد<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٧١</span>","End":"٧١","PageNumber":494,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":430,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":72,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَتِلۡكَ ٱلۡجَنَّةُ ٱلَّتِيٓ أُورِثۡتُمُوهَا بِمَا كُنتُمۡ تَعۡمَلُونَ","TajweedText":"وَتِلْكَ <tajweed class=ham_wasl>ٱ</tajweed>لْجَ<tajweed class=ghunnah>نّ</tajweed>َةُ <tajweed class=ham_wasl>ٱ</tajweed>لَّت<tajweed class=madda_obligatory>ِىٓ</tajweed> أُورِثْتُمُوهَا بِمَا كُ<tajweed class=ikhafa>نت</tajweed>ُمْ تَعْمَل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٧٢</span>","End":"٧٢","PageNumber":494,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":430,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":43,"SurahIndex":"043","VerseNumber":73,"ShowSurahName":false,"ShowBismillah":false,"Text":"لَكُمۡ فِيهَا فَٰكِهَةٞ كَثِيرَةٞ مِّنۡهَا تَأۡكُلُونَ","TajweedText":"لَكُمْ فِيهَا فَ<tajweed class=madda_normal>ـٰ</tajweed>كِهَ<tajweed class=ikhafa>ةٌ ك</tajweed>َثِيرَ<tajweed class=idgham_ghunnah>ةٌ م</tajweed>ِّنْهَا تَأْكُل<t