t":"لَآ إِلَٰهَ إِلَّا هُوَ يُحۡيِۦ وَيُمِيتُۖ رَبُّكُمۡ وَرَبُّ ءَابَآئِكُمُ ٱلۡأَوَّلِينَ","TajweedText":"ل<tajweed class=madda_obligatory>َآ</tajweed> إِلَ<tajweed class=madda_normal>ـٰ</tajweed>هَ إِلَّا هُوَ يُحْى<tajweed class=madda_normal>ِۦ</tajweed> وَيُمِيتُ‌ۖ رَبُّكُمْ وَرَبُّ ءَاب<tajweed class=madda_obligatory>َا</tajweed>ٓئِكُمُ <tajweed class=ham_wasl>ٱ</tajweed>لْأَوَّل<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٨</span>","End":"٨","PageNumber":496,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":431,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":44,"SurahIndex":"044","VerseNumber":9,"ShowSurahName":false,"ShowBismillah":false,"Text":"بَلۡ هُمۡ فِي شَكّٖ يَلۡعَبُونَ","TajweedText":"بَلْ هُمْ فِى شَ<tajweed class=idgham_ghunnah>كٍّ ي</tajweed>َلْعَب<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٩</span>","End":"٩","PageNumber":496,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":431,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":44,"SurahIndex":"044","VerseNumber":10,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَٱرۡتَقِبۡ يَوۡمَ تَأۡتِي ٱلسَّمَآءُ بِدُخَانٖ مُّبِينٖ","TajweedText":"فَ<tajweed class=ham_wasl>ٱ</tajweed>رْتَقِ<tajweed class=qalaqah>بْ</tajweed> يَوْمَ تَأْتِى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّم<tajweed class=madda_obligatory>َا</tajweed>ٓءُ بِدُخَا<tajweed class=idgham_ghunnah>نٍ م</tajweed>ُّب<tajweed class=madda_permissible>ِي</tajweed>نٍ <span class=end>١٠</span>","End":"١٠","PageNumber":496,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":431,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":44,"SurahIndex":"044","VerseNumber":11,"ShowSurahName":false,"ShowBismillah":false,"Text":"يَغۡشَى ٱلنَّاسَۖ هَٰذَا عَذَابٌ أَلِيمٞ","TajweedText":"يَغْشَى <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunna