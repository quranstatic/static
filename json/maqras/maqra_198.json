>ُو</tajweed>نٌ <span class=end>١٤</span>","End":"١٤","PageNumber":496,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":431,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":44,"SurahIndex":"044","VerseNumber":15,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّا كَاشِفُواْ ٱلۡعَذَابِ قَلِيلًاۚ إِنَّكُمۡ عَآئِدُونَ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َا كَاشِفُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed>لْعَذَابِ قَلِيلاً‌ۚ إِ<tajweed class=ghunnah>نّ</tajweed>َكُمْ ع<tajweed class=madda_obligatory>َا</tajweed>ٓئِد<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٥</span>","End":"١٥","PageNumber":496,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":431,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":44,"SurahIndex":"044","VerseNumber":16,"ShowSurahName":false,"ShowBismillah":false,"Text":"يَوۡمَ نَبۡطِشُ ٱلۡبَطۡشَةَ ٱلۡكُبۡرَىٰٓ إِنَّا مُنتَقِمُونَ","TajweedText":"يَوْمَ نَ<tajweed class=qalaqah>بْ</tajweed>طِشُ <tajweed class=ham_wasl>ٱ</tajweed>لْبَ<tajweed class=qalaqah>طْ</tajweed>شَةَ <tajweed class=ham_wasl>ٱ</tajweed>لْكُ<tajweed class=qalaqah>بْ</tajweed>رَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َا مُ<tajweed class=ikhafa>نت</tajweed>َقِم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٦</span>","End":"١٦","PageNumber":496,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":431,"MaqraNumber":198,"HizbNumber":50,"HizbDecimal":0.25,"HasSajda":false}]}