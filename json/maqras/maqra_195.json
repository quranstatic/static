{"MaqraNumber":195.0,"Verses":[{"SurahNumber":42,"SurahIndex":"042","VerseNumber":27,"ShowSurahName":false,"ShowBismillah":false,"Text":"۞وَلَوۡ بَسَطَ ٱللَّهُ ٱلرِّزۡقَ لِعِبَادِهِۦ لَبَغَوۡاْ فِي ٱلۡأَرۡضِ وَلَٰكِن يُنَزِّلُ بِقَدَرٖ مَّا يَشَآءُۚ إِنَّهُۥ بِعِبَادِهِۦ خَبِيرُۢ بَصِيرٞ","TajweedText":"۞ وَلَوْ بَسَطَ <tajweed class=ham_wasl>ٱ</tajweed>للَّهُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رِّزْقَ لِعِبَادِه<tajweed class=madda_normal>ِۦ</tajweed> لَبَغَوْ<tajweed class=slnt>اْ</tajweed> فِى <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ وَلَ<tajweed class=madda_normal>ـٰ</tajweed>ك<tajweed class=idgham_ghunnah>ِن ي</tajweed>ُنَزِّلُ بِقَدَ<tajweed class=idgham_ghunnah>رٍ م</tajweed>َّا يَش<tajweed class=madda_obligatory>َا</tajweed>ٓءُ‌ۚ إِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> بِعِبَادِه<tajweed class=madda_normal>ِۦ</tajweed> خَبِي<tajweed class=iqlab>رُۢ ب</tajweed>َص<tajweed class=madda_permissible>ِي</tajweed>رٌ <span class=end>٢٧</span>","End":"٢٧","PageNumber":486,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":421,"MaqraNumber":195,"HizbNumber":49,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":42,"SurahIndex":"042","VerseNumber":28,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَهُوَ ٱلَّذِي يُنَزِّلُ ٱلۡغَيۡثَ مِنۢ بَعۡدِ مَا قَنَطُواْ وَيَنشُرُ رَحۡمَتَهُۥۚ وَهُوَ ٱلۡوَلِيُّ ٱلۡحَمِيدُ","TajweedText":"وَهُوَ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى يُنَزِّلُ <tajweed class=ham_wasl>ٱ</tajweed>لْغَيْثَ م<tajweed class=iqlab>ِنۢ ب</tajweed>َعْدِ مَا قَنَطُو<tajweed class=slnt>اْ</tajweed> وَيَ<tajweed class=ikhafa>نش</tajweed>ُرُ رَحْمَتَهُ<tajweed class=madda_normal>ۥ</tajweed>‌ۚ وَهُوَ <tajweed class=ham_wasl>ٱ</tajweed>لْوَلِىُّ <tajweed class=ham_wasl>ٱ</tajweed>لْحَم<tajweed class=madda_permissible>ِي</tajweed><tajweed class=qalaqah>د</tajweed>ُ <span class=end>٢٨</span>","End":"٢٨","PageNumber":486,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":421,"MaqraNumber":195,"HizbNumber":49,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":42,"SurahIndex":"042","VerseNumber":29,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمِنۡ ءَايَٰتِهِۦ خَلۡقُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَثَّ فِيهِمَا مِن دَآبَّةٖۚ وَهُوَ عَلَىٰ جَمۡعِهِمۡ إِذَا يَشَآءُ قَدِيرٞ","TajweedText":"وَمِنْ ءَايَ<tajweed class=madda_normal>ـٰ</tajweed>تِه<tajweed class=madda_normal>ِۦ</tajweed> خَلْقُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّمَ<tajweed class=madda_normal>ـٰ</tajweed>و<tajweed class=madda_normal>َٲ</tajweed>تِ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ وَمَا بَثَّ فِيهِمَا مِ<tajweed class=ikhafa>ن د</tajweed><tajweed class=madda_necessary>َا</tajweed>ٓبَّ<tajweed class=idgham_ghunnah>ةٍ‌ۚ و</tajweed>َهُوَ عَلَىٰ جَمْعِهِمْ إِذَا يَش<tajweed class=madda_obligatory>َا</tajweed>ٓءُ قَد<tajweed class=madda_permissible>ِي</tajweed>رٌ <span class=end>٢٩</span>","End":"٢٩","PageNumber":486,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":421,"MaqraNumber":195,"HizbNumber":49,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":42,"SurahIndex":"042","VerseNumber":30,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَآ أَصَٰبَكُم مِّن مُّصِيبَةٖ فَبِمَا كَسَبَتۡ أَيۡدِيكُمۡ وَيَعۡفُواْ عَن كَثِيرٖ","TajweedText":"وَم<tajweed class=madda_obligatory>َآ</tajweed> أَصَ<tajweed class=madda_normal>ـٰ</tajweed>بَك<tajweed class=idgham_shafawi>ُم م</tajweed>ّ<tajweed class=idgham_ghunnah>ِن م</tajweed>ُّصِيبَ<tajweed class=ikhafa>ةٍ ف</tajweed>َبِمَا كَسَبَتْ أَيْدِيكُمْ وَيَعْفُو<tajweed class=slnt>اْ</tajweed> عَ<tajweed class=ikhafa>ن ك</tajweed>َث<tajweed class=madda_permissible>ِي</tajweed>رٍ <span class=end>٣٠</span>","End":"٣٠","PageNumber":486,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":422,"MaqraNumber":195,"HizbNumber":49,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":42,"SurahIndex":"042","VerseNumber":31,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَآ أَنتُم بِمُعۡجِزِينَ فِي ٱلۡأَرۡضِۖ وَمَا لَكُم مِّن دُونِ ٱللَّهِ مِن وَلِيّٖ وَلَا نَصِيرٖ","TajweedText":"وَم<tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=ikhafa>نت</tajweed><tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِمُعْجِزِينَ فِى <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ‌ۖ وَمَا لَك<tajweed class=idgham_shafawi>ُم م</tajweed>ِّ<tajweed class=ikhafa>ن د</tajweed>ُونِ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ م<tajweed class=idgham_ghunnah>ِن و</tajweed>َلِ<tajweed class=idgham_ghunnah>ىٍّ و</tajweed>َلَا نَص<tajweed class=madda_permissible>ِي</tajweed>رٍ <span class=end>٣١</span>","End":"٣١","PageNumber":486,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":422,"MaqraNumber":195,"HizbNumber":49,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":42,"SurahIndex":"042","VerseNumber":32,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمِنۡ ءَايَٰتِهِ ٱلۡجَوَارِ فِي ٱلۡبَحۡرِ كَٱلۡأَعۡلَٰمِ","TajweedText":"وَمِنْ ءَايَ<tajweed class=madda_normal>ـٰ</tajweed>تِهِ <tajweed class=ham_wasl>ٱ</tajweed>لْجَوَارِ فِى <tajweed class=ham_wasl>ٱ</tajweed>لْبَحْرِ كَ<tajweed class=ham_wasl>ٱ</tajweed>لْأَعْلَ<tajweed class=madda_permissible>ـٰ</tajweed>مِ <span class=end>٣٢</span>","End":"٣٢","PageNumber":487,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":422,"MaqraNumber":195,"HizbNumber":49,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":42,"SurahIndex":"042","VerseNumber":33,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِن يَشَأۡ يُسۡكِنِ ٱلرِّيحَ فَيَظۡلَلۡنَ رَوَاكِدَ عَلَىٰ ظَهۡرِهِۦٓۚ إِنَّ فِي ذَٰلِكَ لَأٓيَٰتٖ لِّكُلِّ صَبَّارٖ شَكُورٍ","TajweedText":"إ<tajweed class=idgham_ghunnah>ِن ي</tajweed>َشَأْ يُسْكِنِ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رِّيحَ فَيَظْلَلْنَ رَوَاكِدَ عَلَىٰ ظَهْرِه<tajweed class=madda_obligatory>ِۦٓ‌ۚ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َ فِى ذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ لَأَيَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_wo_ghunnah>تٍ ل</tajweed>ِّكُلِّ صَبَّا<tajweed class=ikhafa>رٍ ش</tajweed>َك<tajweed class=madda_permissible>ُو</tajweed>رٍ <span class=end>٣٣</span>","End":"٣٣","PageNumber":487,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":422,"MaqraNumber":195,"HizbNumber":49,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":42,"SurahIndex":"042","VerseNumber":34,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَوۡ يُوبِقۡهُنَّ بِمَا كَسَبُواْ وَيَعۡفُ عَن كَثِيرٖ","TajweedText":"أَوْ يُوبِ<tajweed class=qalaqah>قْ</tajweed>هُ<tajweed class=ghunnah>نّ</tajweed>َ بِمَا كَسَبُو<tajweed class=slnt>اْ</tajweed> وَيَعْفُ عَ<tajweed class=ikhafa>ن ك</tajweed>َث<tajweed class=madda_permissible>ِي</tajweed>رٍ <span class=end>٣٤</span>","End":"٣٤","PageNumber":487,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":422,"MaqraNumber":195,"HizbNumber":49,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":42,"SurahIndex":"042","VerseNumber":35,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَيَعۡلَمَ ٱلَّذِينَ يُجَٰدِلُونَ فِيٓ ءَايَٰتِنَا مَا لَهُم مِّن مَّحِيصٖ","TajweedText":"وَيَعْلَمَ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ يُجَ<tajweed class=madda_normal>ـٰ</tajweed>دِلُونَ ف<tajweed class=madda_obligatory>ِىٓ</tajweed> ءَايَ<tajweed class=madda_normal>ـٰ</tajweed>تِنَا مَا لَه<tajweed class=idgham_shafawi>ُم م</tajweed>ّ<tajweed class=idgham_ghunnah>ِن م</tajweed>َّح<tajweed class=madda_permissible>ِي</tajweed>صٍ <span class=end>٣٥</span>","End":"٣٥","PageNumber":487,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":422,"MaqraNumber":195,"HizbNumber":49,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":42,"SurahIndex":"042","VerseNumber":36,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَمَآ أُوتِيتُم مِّن شَيۡءٖ فَمَتَٰعُ ٱلۡحَيَوٰةِ ٱلدُّنۡيَاۚ وَمَا عِندَ ٱللَّهِ خَيۡرٞ وَأَبۡقَىٰ لِلَّذِينَ ءَامَنُواْ وَعَلَىٰ رَبِّهِمۡ يَتَوَكَّلُونَ","TajweedText":"فَم<tajweed class=madda_obligatory>َآ</tajweed> أُوتِيت<tajweed class=idgham_shafawi>ُم م</tajweed>ِّ<tajweed class=ikhafa>ن ش</tajweed><tajweed class=ikhafa>َىْءٍ ف<