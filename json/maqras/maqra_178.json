{"MaqraNumber":178.0,"Verses":[{"SurahNumber":36,"SurahIndex":"036","VerseNumber":60,"ShowSurahName":false,"ShowBismillah":false,"Text":"۞أَلَمۡ أَعۡهَدۡ إِلَيۡكُمۡ يَٰبَنِيٓ ءَادَمَ أَن لَّا تَعۡبُدُواْ ٱلشَّيۡطَٰنَۖ إِنَّهُۥ لَكُمۡ عَدُوّٞ مُّبِينٞ","TajweedText":"۞ أَلَمْ أَعْهَ<tajweed class=qalaqah>دْ</tajweed> إِلَيْكُمْ يَ<tajweed class=madda_normal>ـٰ</tajweed>بَن<tajweed class=madda_obligatory>ِىٓ</tajweed> ءَادَمَ أ<tajweed class=idgham_wo_ghunnah>َن ل</tajweed>َّا تَعْبُدُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>شَّيْطَ<tajweed class=madda_normal>ـٰ</tajweed>نَ‌ۖ إِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> لَكُمْ عَدُ<tajweed class=idgham_ghunnah>وٌّ م</tajweed>ُّب<tajweed class=madda_permissible>ِي</tajweed>نٌ <span class=end>٦٠</span>","End":"٦٠","PageNumber":444,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":384,"MaqraNumber":178,"HizbNumber":45,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":61,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَأَنِ ٱعۡبُدُونِيۚ هَٰذَا صِرَٰطٞ مُّسۡتَقِيمٞ","TajweedText":"وَأَنِ <tajweed class=ham_wasl>ٱ</tajweed>عْبُدُونِى‌ۚ هَ<tajweed class=madda_normal>ـٰ</tajweed>ذَا صِر<tajweed class=madda_normal>َٲ</tajweed><tajweed class=idgham_ghunnah>طٌ م</tajweed>ُّسْتَق<tajweed class=madda_permissible>ِي</tajweed>مٌ <span class=end>٦١</span>","End":"٦١","PageNumber":444,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":384,"MaqraNumber":178,"HizbNumber":45,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":62,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَقَدۡ أَضَلَّ مِنكُمۡ جِبِلّٗا كَثِيرًاۖ أَفَلَمۡ تَكُونُواْ تَعۡقِلُونَ","TajweedText":"وَلَقَ<tajweed class=qalaqah>دْ</tajweed> أَضَلَّ مِ<tajweed class=ikhafa>نك</tajweed>ُمْ جِبِل<tajweed class=ikhafa>اًّ ك</tajweed>َثِيرًا‌ۖ أَفَلَمْ تَكُونُو<tajweed class=slnt>اْ</tajweed> تَعْقِل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٢</span>","End":"٦٢","PageNumber":444,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":384,"MaqraNumber":178,"HizbNumber":45,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":63,"ShowSurahName":false,"ShowBismillah":false,"Text":"هَٰذِهِۦ جَهَنَّمُ ٱلَّتِي كُنتُمۡ تُوعَدُونَ","TajweedText":"هَ<tajweed class=madda_normal>ـٰ</tajweed>ذِه<tajweed class=madda_normal>ِۦ</tajweed> جَهَ<tajweed class=ghunnah>نّ</tajweed>َمُ <tajweed class=ham_wasl>ٱ</tajweed>لَّتِى كُ<tajweed class=ikhafa>نت</tajweed>ُمْ تُوعَد<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٣</span>","End":"٦٣","PageNumber":444,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":384,"MaqraNumber":178,"HizbNumber":45,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":64,"ShowSurahName":false,"ShowBismillah":false,"Text":"ٱصۡلَوۡهَا ٱلۡيَوۡمَ بِمَا كُنتُمۡ تَكۡفُرُونَ","TajweedText":"ٱصْلَوْهَا <tajweed class=ham_wasl>ٱ</tajweed>لْيَوْمَ بِمَا كُ<tajweed class=ikhafa>نت</tajweed>ُمْ تَكْفُر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٤</span>","End":"٦٤","PageNumber":444,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":384,"MaqraNumber":178,"HizbNumber":45,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":65,"ShowSurahName":false,"ShowBismillah":false,"Text":"ٱلۡيَوۡمَ نَخۡتِمُ عَلَىٰٓ أَفۡوَٰهِهِمۡ وَتُكَلِّمُنَآ أَيۡدِيهِمۡ وَتَشۡهَدُ أَرۡجُلُهُم بِمَا كَانُواْ يَكۡسِبُونَ","TajweedText":"ٱلْيَوْمَ نَخْتِمُ عَلَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> أَفْو<tajweed class=madda_normal>َٲ</tajweed>هِهِمْ وَتُكَلِّمُن<tajweed class=madda_obligatory>َآ</tajweed> أَيْدِيهِمْ وَتَشْهَدُ أَرْجُلُه<tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِمَا كَانُو<tajweed class=slnt>اْ</tajweed> يَكْسِب<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٥</span>","End":"٦٥","PageNumber":444,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":384,"MaqraNumber":178,"HizbNumber":45,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":66,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَوۡ نَشَآءُ لَطَمَسۡنَا عَلَىٰٓ أَعۡيُنِهِمۡ فَٱسۡتَبَقُواْ ٱلصِّرَٰطَ فَأَنَّىٰ يُبۡصِرُونَ","TajweedText":"وَلَوْ نَش<tajweed class=madda_obligatory>َا</tajweed>ٓءُ لَطَمَسْنَا عَلَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> أَعْيُنِهِمْ فَ<tajweed class=ham_wasl>ٱ</tajweed>سْتَبَقُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>صِّر<tajweed class=madda_normal>َٲ</tajweed>طَ فَأَ<tajweed class=ghunnah>نّ</tajweed>َىٰ يُ<tajweed class=qalaqah>بْ</tajweed>صِر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٦</span>","End":"٦٦","PageNumber":444,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":384,"MaqraNumber":178,"HizbNumber":45,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":67,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَوۡ نَشَآءُ لَمَسَخۡنَٰهُمۡ عَلَىٰ مَكَانَتِهِمۡ فَمَا ٱسۡتَطَٰعُواْ مُضِيّٗا وَلَا يَرۡجِعُونَ","TajweedText":"وَلَوْ نَش<tajweed class=madda_obligatory>َا</tajweed>ٓءُ لَمَسَخْنَ<tajweed class=madda_normal>ـٰ</tajweed>هُمْ عَلَىٰ مَكَانَتِهِمْ فَمَا <tajweed class=ham_wasl>ٱ</tajweed>سْتَطَ<tajweed class=madda_normal>ـٰ</tajweed>عُو<tajweed class=slnt>اْ</tajweed> مُضِي<tajweed class=idgham_ghunnah>ًّا و</tajweed>َلَا يَرْجِع<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٧</span>","End":"٦٧","PageNumber":444,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":384,"MaqraNumber":178,"HizbNumber":45,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":68,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَن نُّعَمِّرۡهُ نُنَكِّسۡهُ فِي ٱلۡخَلۡقِۚ أَفَلَا يَعۡقِلُونَ","TajweedText":"وَم<tajweed class=idgham_ghunnah>َن ن</tajweed>ُّعَ<tajweed class=ghunnah>مّ</tajweed>ِرْهُ نُنَكِّسْهُ فِى <tajweed class=ham_wasl>ٱ</tajweed>لْخَلْقِ‌ۖ أَفَلَا يَعْقِل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦٨</span>","End":"٦٨","PageNumber":444,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":385,"MaqraNumber":178,"HizbNumber":45,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":69,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمَا عَلَّمۡنَٰهُ ٱلشِّعۡرَ وَمَا يَنۢبَغِي لَهُۥٓۚ إِنۡ هُوَ إِلَّا ذِكۡرٞ وَقُرۡءَانٞ مُّبِينٞ","TajweedText":"وَمَا عَلَّمْنَ<tajweed class=madda_normal>ـٰ</tajweed>هُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>شِّعْرَ وَمَا يَ<tajweed class=iqlab>نۢب</tajweed>َغِى لَهُ<tajweed class=madda_obligatory>ۥٓ‌ۚ</tajweed> إِنْ هُوَ إِلَّا ذِكْ<tajweed class=idgham_ghunnah>رٌ و</tajweed>َقُرْءَا<tajweed class=idgham_ghunnah>نٌ م</tajweed>ُّب<tajweed class=madda_permissible>ِي</tajweed>نٌ <span class=end>٦٩</span>","End":"٦٩","PageNumber":444,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":385,"MaqraNumber":178,"HizbNumber":45,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":70,"ShowSurahName":false,"ShowBismillah":false,"Text":"لِّيُنذِرَ مَن كَانَ حَيّٗا وَيَحِقَّ ٱلۡقَوۡلُ عَلَى ٱلۡكَٰفِرِينَ","TajweedText":"لِّيُ<tajweed class=ikhafa>نذ</tajweed>ِرَ مَ<tajweed class=ikhafa>ن ك</tajweed>َانَ حَي<tajweed class=idgham_ghunnah>ًّا و</tajweed>َيَحِقَّ <tajweed class=ham_wasl>ٱ</tajweed>لْقَوْلُ عَلَى <tajweed class=ham_wasl>ٱ</tajweed>لْكَ<tajweed class=madda_normal>ـٰ</tajweed>فِر<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٧٠</span>","End":"٧٠","PageNumber":444,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":385,"MaqraNumber":178,"HizbNumber":45,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":71,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَوَلَمۡ يَرَوۡاْ أَنَّا خَلَقۡنَا لَهُم مِّمَّا عَمِلَتۡ أَيۡدِينَآ أَنۡعَٰمٗا فَهُمۡ لَهَا مَٰلِكُونَ","TajweedText":"أَوَلَمْ يَرَوْ<tajweed class=slnt>اْ</tajweed> أَ<tajweed class=ghunnah>نّ</tajweed>َا خَلَ<tajweed class=qalaqah>قْ</tajweed>نَا لَه<tajweed class=idgham_shafawi>ُم م</tajweed>ِّ<tajweed class=ghunnah>مّ</tajweed>َا عَمِلَتْ أَيْدِين<tajweed class=madda_obligatory>َآ</tajweed> أَنْعَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=ikhafa>مًا ف</tajweed>َهُمْ لَهَا مَ<tajweed class=madda_normal>ـٰ</tajweed>لِك<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٧١</span>","End":"٧١","PageNumber":445,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":385,"MaqraNumber":178,"HizbNumber":45,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":72,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَذَلَّلۡنَٰهَا لَهُمۡ فَمِنۡهَا رَكُوبُهُمۡ وَمِنۡهَا يَأۡكُلُونَ","TajweedText":"وَذَلَّلْنَ<tajweed class=madda_normal>ـٰ</tajweed>هَا لَهُمْ فَمِنْهَا رَكُوبُهُمْ وَمِنْهَا يَأْكُل<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٧٢</span>","End":"٧٢","PageNumber":445,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":385,"MaqraNumber":178,"HizbNumber":45,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":73,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَلَهُمۡ فِيهَا مَنَٰفِعُ وَمَشَارِبُۚ أَفَلَا يَشۡكُرُونَ","TajweedText":"وَلَهُمْ فِيهَا مَنَ<tajweed class=madda_normal>ـٰ</tajweed>فِعُ وَمَشَارِبُ‌ۖ أَفَلَا يَشْكُر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٧٣</span>","End":"٧٣","PageNumber":445,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":385,"MaqraNumber":178,"HizbNumber":45,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":74,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَٱتَّخَذُواْ مِن دُونِ ٱللَّهِ ءَالِهَةٗ لَّعَلَّهُمۡ يُنصَرُونَ","TajweedText":"وَ<tajweed class=ham_wasl>ٱ</tajweed>تَّخَذُو<tajweed class=slnt>اْ</tajweed> مِ<tajweed class=ikhafa>ن د</tajweed>ُونِ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ ءَالِهَ<tajweed class=idgham_wo_ghunnah>ةً ل</tajweed>َّعَلَّهُمْ يُ<tajweed class=ikhafa>نص</tajweed>َر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٧٤</span>","End":"٧٤","PageNumber":445,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":385,"MaqraNumber":178,"HizbNumber":45,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":75,"ShowSurahName":false,"ShowBismillah":false,"Text":"لَا يَسۡتَطِيعُونَ نَصۡرَهُمۡ وَهُمۡ لَهُمۡ جُندٞ مُّحۡضَرُونَ","TajweedText":"لَا يَسْتَطِيعُونَ نَصْرَهُمْ وَهُمْ لَهُمْ جُن<tajweed class=idgham_ghunnah>دٌ م</tajweed>ُّحْضَر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٧٥</span>","End":"٧٥","PageNumber":445,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":385,"MaqraNumber":178,"HizbNumber":45,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":76,"ShowSurahName":false,"ShowBismillah":false,"Text":"فَلَا يَحۡزُنكَ قَوۡلُهُمۡۘ إِنَّا نَعۡلَمُ مَا يُسِرُّونَ وَمَا يُعۡلِنُونَ","TajweedText":"فَلَا يَحْزُ<tajweed class=ikhafa>نك</tajweed>َ قَوْلُهُمْ‌ۘ إِ<tajweed class=ghunnah>نّ</tajweed>َا نَعْلَمُ مَا يُسِرُّونَ وَمَا يُعْلِن<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٧٦</span>","End":"٧٦","PageNumber":445,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":385,"MaqraNumber":178,"HizbNumber":45,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":77,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَوَلَمۡ يَرَ ٱلۡإِنسَٰنُ أَنَّا خَلَقۡنَٰهُ مِن نُّطۡفَةٖ فَإِذَا هُوَ خَصِيمٞ مُّبِينٞ","TajweedText":"أَوَلَمْ يَرَ <tajweed class=ham_wasl>ٱ</tajweed>لْإِ<tajweed class=ikhafa>نس</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed>نُ أَ<tajweed class=ghunnah>نّ</tajweed>َا خَلَ<tajweed class=qalaqah>قْ</tajweed>نَ<tajweed class=madda_normal>ـٰ</tajweed>هُ م<tajweed class=idgham_ghunnah>ِن ن</tajweed>ُّ<tajweed class=qalaqah>طْ</tajweed>فَ<tajweed class=ikhafa>ةٍ ف</tajweed>َإِذَا هُوَ خَصِي<tajweed class=idgham_ghunnah>مٌ م</tajweed>ُّب<tajweed class=madda_permissible>ِي</tajweed>نٌ <span class=end>٧٧</span>","End":"٧٧","PageNumber":445,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":385,"MaqraNumber":178,"HizbNumber":45,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":78,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَضَرَبَ لَنَا مَثَلٗا وَنَسِيَ خَلۡقَهُۥۖ قَالَ مَن يُحۡيِ ٱلۡعِظَٰمَ وَهِيَ رَمِيمٞ","TajweedText":"وَضَرَبَ لَنَا مَثَل<tajweed class=idgham_ghunnah>اً و</tajweed>َنَسِىَ خَلْقَهُ<tajweed class=madda_normal>ۥ</tajweed>‌ۖ قَالَ م<tajweed class=idgham_ghunnah>َن ي</tajweed>ُحْىِ <tajweed class=ham_wasl>ٱ</tajweed>لْعِظَ<tajweed class=madda_normal>ـٰ</tajweed>مَ وَهِىَ رَم<tajweed class=madda_permissible>ِي</tajweed>مٌ <span class=end>٧٨</span>","End":"٧٨","PageNumber":445,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":385,"MaqraNumber":178,"HizbNumber":45,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":79,"ShowSurahName":false,"ShowBismillah":false,"Text":"قُلۡ يُحۡيِيهَا ٱلَّذِيٓ أَنشَأَهَآ أَوَّلَ مَرَّةٖۖ وَهُوَ بِكُلِّ خَلۡقٍ عَلِيمٌ","TajweedText":"قُلْ يُحْيِيهَا <tajweed class=ham_wasl>ٱ</tajweed>لَّذ<tajweed class=madda_obligatory>ِىٓ</tajweed> أَ<tajweed class=ikhafa>نش</tajweed>َأَه<tajweed class=madda_obligatory>َآ</tajweed> أَوَّلَ مَرَّ<tajweed class=idgham_ghunnah>ةٍ‌ۖ و</tajweed>َهُوَ بِكُلِّ خَلْقٍ عَل<tajweed class=madda_permissible>ِي</tajweed>مٌ <span class=end>٧٩</span>","End":"٧٩","PageNumber":445,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":385,"MaqraNumber":178,"HizbNumber":45,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":80,"ShowSurahName":false,"ShowBismillah":false,"Text":"ٱلَّذِي جَعَلَ لَكُم مِّنَ ٱلشَّجَرِ ٱلۡأَخۡضَرِ نَارٗا فَإِذَآ أَنتُم مِّنۡهُ تُوقِدُونَ","TajweedText":"ٱلَّذِى جَعَلَ لَك<tajweed class=idgham_shafawi>ُم م</tajweed>ِّنَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>شَّجَرِ <tajweed class=ham_wasl>ٱ</tajweed>لْأَخْضَرِ نَا<tajweed class=ikhafa>رًا ف</tajweed>َإِذ<tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=ikhafa>نت</tajweed><tajweed class=idgham_shafawi>ُم م</tajweed>ِّنْهُ تُوقِد<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٨٠</span>","End":"٨٠","PageNumber":445,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":385,"MaqraNumber":178,"HizbNumber":45,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":81,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَوَلَيۡسَ ٱلَّذِي خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ بِقَٰدِرٍ عَلَىٰٓ أَن يَخۡلُقَ مِثۡلَهُمۚ بَلَىٰ وَهُوَ ٱلۡخَلَّـٰقُ ٱلۡعَلِيمُ","TajweedText":"أَوَلَيْسَ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِى خَلَقَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّمَ<tajweed class=madda_normal>ـٰ</tajweed>و<tajweed class=madda_normal>َٲ</tajweed>تِ وَ<tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضَ بِقَ<tajweed class=madda_normal>ـٰ</tajweed>دِرٍ عَلَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> أ<tajweed class=idgham_ghunnah>َن ي</tajweed>َخْلُقَ مِثْلَه<tajweed class=ikhafa_shafawi>ُم‌ۚ ب</tajweed>َلَىٰ وَهُوَ <tajweed class=ham_wasl>ٱ</tajweed>لْخَلَّ<tajweed class=madda_normal>ـٰ</tajweed>قُ <tajweed class=ham_wasl>ٱ</tajweed>لْعَل<tajweed class=madda_permissible>ِي</tajweed>مُ <span class=end>٨١</span>","End":"٨١","PageNumber":445,"JuzNumber":23,"ManzilNumber":5,"RukuNumber":385,"MaqraNumber":178,"HizbNumber":45,"HizbDecimal":0.25,"HasSajda":false},{"SurahNumber":36,"SurahIndex":"036","VerseNumber":82,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّمَآ أَمۡرُهُۥٓ إِذَآ أَرَادَ شَيۡـًٔا أَن يَقُولَ لَهُۥ كُن فَيَكُونُ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َم<tajweed class=madda_obligatory>َآ</tajweed> أَمْرُهُ<tajweed class=madda_obligatory>ۥٓ</tajweed> إِذ<tajweed class=madda_obligatory>َآ</tajweed> أَرَادَ شَيْــ