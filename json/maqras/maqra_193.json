{"MaqraNumber":193.0,"Verses":[{"SurahNumber":41,"SurahIndex":"041","VerseNumber":47,"ShowSurahName":false,"ShowBismillah":false,"Text":"۞إِلَيۡهِ يُرَدُّ عِلۡمُ ٱلسَّاعَةِۚ وَمَا تَخۡرُجُ مِن ثَمَرَٰتٖ مِّنۡ أَكۡمَامِهَا وَمَا تَحۡمِلُ مِنۡ أُنثَىٰ وَلَا تَضَعُ إِلَّا بِعِلۡمِهِۦۚ وَيَوۡمَ يُنَادِيهِمۡ أَيۡنَ شُرَكَآءِي قَالُوٓاْ ءَاذَنَّـٰكَ مَامِنَّا مِن شَهِيدٖ","TajweedText":"۞ إِلَيْهِ يُرَدُّ عِلْمُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّاعَةِ‌ۚ وَمَا تَخْرُجُ مِ<tajweed class=ikhafa>ن ث</tajweed>َمَر<tajweed class=madda_normal>َٲ</tajweed><tajweed class=idgham_ghunnah>تٍ م</tajweed>ِّنْ أَكْمَامِهَا وَمَا تَحْمِلُ مِنْ أُ<tajweed class=ikhafa>نث</tajweed>َىٰ وَلَا تَضَعُ إِلَّا بِعِلْمِه<tajweed class=madda_normal>ِۦ</tajweed>‌ۚ وَيَوْمَ يُنَادِيهِمْ أَيْنَ شُرَك<tajweed class=madda_obligatory>َا</tajweed>ٓءِى قَال<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> ءَاذَ<tajweed class=ghunnah>نّ</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed>كَ مَا مِ<tajweed class=ghunnah>نّ</tajweed>َا مِ<tajweed class=ikhafa>ن ش</tajweed>َه<tajweed class=madda_permissible>ِي</tajweed><tajweed class=qalaqah>د</tajweed>ٍ <span class=end>٤٧</span>","End":"٤٧","PageNumber":482,"JuzNumber":25,"ManzilNumber":6,"RukuNumber":418,"MaqraNumber":193,"HizbNumber":49,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":41,"SurahIndex":"041","VerseNumber":48,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَضَلَّ عَنۡهُم مَّا كَانُواْ يَدۡعُونَ مِن قَبۡلُۖ وَظَنُّواْ مَا لَهُم مِّن مَّحِيصٖ","TajweedText":"وَضَلَّ عَنْه<tajweed class=idgham_shafawi>ُم م</tajweed>َّا كَانُو<tajweed class=slnt>اْ</tajweed> يَ<tajweed class=qalaqah>دْ</tajweed>عُونَ مِ<tajweed class=ikhafa>ن ق</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>لُ‌ۖ وَظَ<tajweed class=ghunnah>نّ</tajweed>ُو<tajweed class=slnt>اْ</tajweed> مَا لَه<tajweed class=idgham_shafawi>ُم م</tajweed>ّ<tajweed class=idgham_ghunnah>ِن م</tajweed>َّح<tajweed class=madda_p