 ط</tajweed>َرِي<tajweed class=idgham_ghunnah>ًّا و</tajweed>َتَسْتَخْرِجُو<tajweed class=slnt>اْ</tajweed> مِنْهُ حِلْيَ<tajweed class=ikhafa>ةً ت</tajweed>َلْبَسُونَهَا وَتَرَى <tajweed class=ham_wasl>ٱ</tajweed>لْفُلْكَ مَوَاخِرَ فِيهِ وَلِتَ<tajweed class=qalaqah>بْ</tajweed>تَغُو<tajweed class=slnt>اْ</tajweed> مِ<tajweed class=ikhafa>ن ف</tajweed>َضْلِه<tajweed class=madda_normal>ِۦ</tajweed> وَلَعَلَّكُمْ تَشْكُر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٤</span>","End":"١٤","PageNumber":268,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":225,"MaqraNumber":107,"HizbNumber":27,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":16,"SurahIndex":"016","VerseNumber":15,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَأَلۡقَىٰ فِي ٱلۡأَرۡضِ رَوَٰسِيَ أَن تَمِيدَ بِكُمۡ وَأَنۡهَٰرٗا وَسُبُلٗا لَّعَلَّكُمۡ تَهۡتَدُونَ","TajweedText":"وَأَلْقَىٰ فِى <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ رَو<tajweed class=madda_normal>َٲ</tajweed>سِىَ أَ<tajweed class=ikhafa>ن ت</tajweed>َمِيدَ بِكُمْ وَأَنْهَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>رًا و</tajweed>َسُبُل<tajweed class=idgham_wo_ghunnah>اً ل</tajweed>َّعَلَّكُمْ تَهْتَد<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٥</span>","End":"١٥","PageNumber":269,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":225,"MaqraNumber":107,"HizbNumber":27,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":16,"SurahIndex":"016","VerseNumber":16,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَعَلَٰمَٰتٖۚ وَبِٱلنَّجۡمِ هُمۡ يَهۡتَدُونَ","TajweedText":"وَعَلَ<tajweed class=madda_normal>ـٰ</tajweed>مَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>تٍ‌ۚ و</tajweed>َبِ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َ<tajweed class=qalaqah>جْ</tajweed>مِ هُمْ يَهْتَد<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٦</span>","End":"١٦","PageNumber":269,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":225,"MaqraNumber":107,"HizbNumber":27,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":16,"SurahIndex":"016","VerseNumber":17,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَفَمَن يَخۡلُقُ كَمَن لَّا يَخۡلُقُۚ أَفَلَا تَذَكَّرُونَ","TajweedText":"أَفَم<tajweed class=idgham_ghunnah>َن ي</tajweed>َخْلُقُ كَم<tajweed class=idgham_wo_ghunnah>َن ل</tajweed>َّا يَخْلُقُ‌ۗ أَفَلَا تَذَكَّر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٧</span>","End":"١٧","PageNumber":269,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":225,"MaqraNumber":107,"HizbNumber":27,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":16,"SurahIndex":"016","VerseNumber":18,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِن تَعُدُّواْ نِعۡمَةَ ٱللَّهِ لَا تُحۡصُوهَآۗ إِنَّ ٱللَّهَ لَغَفُورٞ رَّحِيمٞ","TajweedText":"وَإِ<tajweed class=ikhafa>ن ت</tajweed>َعُدُّو<tajweed class=slnt>اْ</tajweed> نِعْمَةَ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ لَا تُحْصُوه<tajweed class=madda_obligatory>َآ‌ۗ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>للَّهَ لَغَفُو<tajweed class=idgham_wo_ghunnah>رٌ ر</tajweed>َّح<tajweed class=madda_permissible>ِي</tajweed>مٌ <span class=end>١٨</span>","End":"١٨","PageNumber":269,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":225,"MaqraNumber":107,"HizbNumber":27,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":16,"SurahIndex":"016","VerseNumber":19,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَٱللَّهُ يَعۡلَمُ مَا تُسِرُّونَ وَمَا تُعۡلِنُونَ","TajweedText":"وَ<tajweed class=ham_wasl>ٱ</tajweed>للَّهُ يَعْلَمُ مَا تُسِرُّونَ وَمَا تُعْلِن<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٩</span>","End":"١٩","PageNumber":269,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":225,"MaqraNumber":107,"HizbNumber":27,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":16,"SurahIndex":"016","VerseNumber":20,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَٱلَّذِينَ يَدۡعُونَ مِن دُونِ ٱللَّهِ لَا يَخۡلُقُونَ شَيۡـٔٗا وَهُمۡ يُخۡلَقُونَ","TajweedText":"وَ<tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ يَ<tajweed class=qalaqah>دْ</tajweed>عُونَ مِ<tajweed class=ikhafa>ن د</tajweed>ُونِ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ لَا يَخْلُقُونَ شَيْـ<tajweed class=idgham_ghunnah>ـًٔا و</tajweed>َهُمْ يُخْلَق<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٠</span>","End":"٢٠","PageNumber":269,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":225,"MaqraNumber":107,"HizbNumber":27,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":16,"SurahIndex":"016","VerseNumber":21,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَمۡوَٰتٌ غَيۡرُ أَحۡيَآءٖۖ وَمَا يَشۡعُرُونَ أَيَّانَ يُبۡعَثُونَ","TajweedText":"أَمْو<tajweed class=madda_normal>َٲ</tajweed>تٌ غَيْرُ أَحْي<tajweed class=madda_obligatory>َا</tajweed>ٓ<tajweed class=idgham_ghunnah>ءٍ‌ۖ و</tajweed>َمَا يَشْعُرُونَ أَيَّانَ يُ<tajweed class=qalaqah>بْ</tajweed>عَث<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢١</span>","End":"٢١","PageNumber":269,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":225,"MaqraNumber":107,"HizbNumber":27,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":16,"SurahIndex":"016","VerseNumber":22,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِلَٰهُكُمۡ إِلَٰهٞ وَٰحِدٞۚ فَٱلَّذِينَ لَا يُؤۡمِنُونَ بِٱلۡأٓخِرَةِ قُلُوبُهُم مُّنكِرَةٞ وَهُم مُّسۡتَكۡبِرُونَ","TajweedText":"إِلَ<tajweed class=madda_normal>ـٰ</tajweed>هُكُمْ إِلَ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=idgham_ghunnah>هٌ و</tajweed><tajweed class=madda_normal>َٲ</tajweed>حِ<tajweed class=ikhafa>دٌ‌ۚ ف</tajweed>َ<tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ لَا يُؤْمِنُونَ بِ<tajweed class=ham_wasl>ٱ</tajweed>لْأَخِرَةِ قُلُوبُه<tajweed class=idgham_shafawi>ُم م</tajweed>ُّ<tajweed class=ikhafa>نك</tajweed>ِرَ<tajweed class=idgham_ghunnah>ةٌ و</tajweed>َه<tajweed class=idgham_shafawi>ُم م</tajweed>ُّسْتَكْبِر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٢</span>","End":"٢٢","PageNumber":269,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":226,"MaqraNumber":107,"HizbNumber":27,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":16,"SurahIndex":"016","VerseNumber":23,"ShowSurahName":false,"ShowBismillah":false,"Text":"لَا جَرَمَ أَنَّ ٱللَّهَ يَعۡلَمُ مَا يُسِرُّونَ وَمَا يُعۡلِنُونَۚ إِنَّهُۥ لَا يُحِبُّ ٱلۡمُسۡتَكۡبِرِينَ","TajweedText":"لَا جَرَمَ أَ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>للَّهَ يَعْلَمُ مَا يُسِرُّونَ وَمَا يُعْلِنُونَ‌ۚ إِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> لَا يُحِبُّ <tajweed class=ham_wasl>ٱ</tajweed>لْمُسْتَكْبِر<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٢٣</span>","End":"٢٣","PageNumber":269,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":226,"MaqraNumber":107,"HizbNumber":27,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":16,"SurahIndex":"016","VerseNumber":24,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِذَا قِيلَ لَهُم مَّاذَآ أَنزَلَ رَبُّكُمۡ قَالُوٓاْ أَسَٰطِيرُ ٱلۡأَوَّلِينَ","TajweedText":"وَإِذَا قِيلَ لَه<tajweed class=idgham_shafawi>ُم م</tajweed>َّاذ<tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=ikhafa>نز</tajweed>َلَ رَبُّكُمْ‌ۙ قَال<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> أَسَ<tajweed class=madda_normal>ـٰ</tajweed>طِيرُ <tajweed class=ham_wasl>ٱ</tajweed>لْأَوَّل<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٢٤</span>","End":"٢٤","PageNumber":269,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":226,"MaqraNumber":107,"HizbNumber":27,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":16,"SurahIndex":"016","VerseNumber":25,"ShowSurahName":false,"ShowBismillah":false,"Text":"لِيَحۡمِلُوٓاْ أَوۡزَارَهُمۡ كَامِلَةٗ يَوۡمَ ٱلۡقِيَٰمَةِ وَمِنۡ أَوۡزَارِ ٱلَّذِينَ يُضِلُّونَهُم بِغَيۡرِ عِلۡمٍۗ أَلَا سَآءَ مَا يَزِرُونَ","TajweedText":"لِيَحْمِل<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> أَوْزَارَهُمْ كَامِلَ<tajweed class=idgham_ghunnah>ةً ي</tajweed>َوْمَ <tajweed class=ham_wasl>ٱ</tajweed>لْقِيَ<tajweed class=madda_normal>ـٰ</tajweed>مَةِ‌ۙ وَمِنْ أَوْزَارِ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ يُضِلُّونَه<tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِغَيْرِ عِلْمٍ‌ۗ أَلَا س<tajweed class=madda_obligatory>َا</tajweed>ٓءَ مَا يَزِر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٥</span>","End":"٢٥","PageNumber":269,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":226,"MaqraNumber":107,"HizbNumber":27,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":16,"SurahIndex":"016","VerseNumber":26,"ShowSurahName":false,"ShowBismillah":false,"Text":"قَدۡ مَكَرَ ٱلَّذِينَ مِن قَبۡلِهِمۡ فَأَتَى ٱللَّهُ بُنۡيَٰنَهُم مِّنَ ٱلۡقَوَاعِدِ فَخَرَّ عَلَيۡهِمُ ٱلسَّقۡفُ مِن فَوۡقِهِمۡ وَأَتَىٰهُمُ ٱلۡعَذَابُ مِنۡ حَيۡثُ لَا يَشۡعُرُونَ","TajweedText":"قَ<tajweed class=qalaqah>دْ</tajweed> مَكَرَ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ مِ<tajweed class=ikhafa>ن ق</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>لِهِمْ فَأَتَى <tajweed class=ham_wasl>ٱ</tajweed>للَّهُ بُنْيَ<tajweed class=madda_normal>ـٰ</tajweed>نَه<tajweed class=idgham_shafawi>ُم م</tajweed>ِّنَ <tajweed class=ham_wasl>ٱ</tajweed>لْقَوَاعِدِ فَخَرَّ عَلَيْهِمُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّ<tajweed class=qalaqah>قْ</tajweed>فُ مِ<tajweed class=ikhafa>ن ف</tajweed>َوْقِهِمْ وَأَتَ<tajweed class=madda_normal>ـٰ</tajweed>هُمُ <tajweed class=ham_wasl>ٱ</tajweed>لْعَذَابُ مِنْ حَيْثُ لَا يَشْعُر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٢٦</span>","End":"٢٦","PageNumber":269,"JuzNumber":14,"ManzilNumber":3,"RukuNumber":227,"MaqraNumber":107,"HizbNumber":27,"HizbDecimal":0.5,"HasSajda":false},{"SurahNumber":16,"SurahIndex":"016","VerseNumber":27,"ShowSurahName":false,"ShowBismillah":false,"Text":"ثُمَّ يَوۡمَ ٱلۡقِيَٰمَةِ يُخۡزِيهِمۡ وَيَقُولُ أَيۡنَ شُرَكَآءِيَ ٱلَّذِينَ كُنتُمۡ تُشَـٰٓقُّونَ فِيهِمۡۚ قَالَ