weed class=madda_necessary>مٓ</tajweed> <span class=end>١</span>","End":"١","PageNumber":2,"JuzNumber":1,"ManzilNumber":1,"RukuNumber":2,"MaqraNumber":1,"HizbNumber":1,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":2,"SurahIndex":"002","VerseNumber":2,"ShowSurahName":false,"ShowBismillah":false,"Text":"ذَٰلِكَ ٱلۡكِتَٰبُ لَا رَيۡبَۛ فِيهِۛ هُدٗى لِّلۡمُتَّقِينَ","TajweedText":"ذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ <tajweed class=ham_wasl>ٱ</tajweed>لْكِتَ<tajweed class=madda_normal>ـٰ</tajweed>بُ لَا رَيْبَ‌ۛ فِيهِ‌ۛ هُ<tajweed class=idgham_wo_ghunnah>دًى ل</tajweed>ِّلْمُتَّق<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٢</span>","End":"٢","PageNumber":2,"JuzNumber":1,"ManzilNumber":1,"RukuNumber":2,"MaqraNumber":1,"HizbNumber":1,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":2,"SurahIndex":"002","VerseNumber":3,"ShowSurahName":false,"ShowBismillah":false,"Text":"ٱلَّذِينَ يُؤۡمِنُونَ بِٱلۡغَيۡبِ وَيُقِيمُونَ ٱلصَّلَوٰةَ وَمِمَّا رَزَقۡنَٰهُمۡ يُنفِقُونَ","TajweedText":"ٱلَّذِينَ يُؤْمِنُونَ بِ<tajweed class=ham_wasl>ٱ</tajweed>لْغَيْبِ وَيُقِيمُونَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>صَّلَ<tajweed class=slnt>و</tajweed><tajweed class=madda_normal>ٲ</tajweed>ةَ وَمِ<tajweed class=ghunnah>مّ</tajweed>َا رَزَ<tajweed class=qalaqah>قْ</tajweed>نَ<tajweed class=madda_normal>ـٰ</tajweed>هُمْ يُ<tajweed class=ikhafa>نف</tajweed>ِق<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٣</span>","End":"٣","PageNumber":2,"JuzNumber":1,"ManzilNumber":1,"RukuNumber":2,"MaqraNumber":1,"HizbNumber":1,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":2,"SurahIndex":"002","VerseNumber":4,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَٱلَّذِينَ يُؤۡمِنُونَ بِمَآ أُنزِلَ إِلَيۡكَ وَمَآ أُنزِلَ مِن قَبۡلِكَ وَبِٱلۡأٓخِرَةِ هُمۡ يُوقِنُونَ","TajweedText":"وَ<tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ يُؤْمِنُونَ بِم<tajweed class=madda_obligatory>َآ</tajweed> أُ<tajweed class=ikhafa>نز</tajweed>ِلَ إِلَيْكَ وَم<tajweed class=madda_obligatory>َآ</tajweed> أُ<tajweed class=ikhafa>نز</tajweed>ِلَ مِ<tajweed class=ikhafa>ن ق</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>لِكَ وَبِ<tajweed class=ham_wasl>ٱ</tajweed>لْأَخِرَةِ هُمْ يُوقِن<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٤</span>","End":"٤","PageNumber":2,"JuzNumber":1,"ManzilNumber":1,"RukuNumber":2,"MaqraNumber":1,"HizbNumber":1,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":2,"SurahIndex":"002","VerseNumber":5,"ShowSurahName":false,"ShowBismillah":false,"Text":"أُوْلَـٰٓئِكَ عَلَىٰ هُدٗى مِّن رَّبِّهِمۡۖ وَأُوْلَـٰٓئِكَ هُمُ ٱلۡمُفۡلِحُونَ","TajweedText":"أُ<tajweed class=slnt>وْ</tajweed>لَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ئِكَ عَلَىٰ هُ<tajweed class=idgham_ghunnah>دًى م</tajweed>ّ<tajweed class=idgham_wo_ghunnah>ِن ر</tajweed>َّبِّهِمْ‌ۖ وَأُ<tajweed class=slnt>وْ</tajweed>لَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ئِكَ هُمُ <tajweed class=ham_wasl>ٱ</tajweed>لْمُفْلِح<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٥</span>","End":"٥","PageNumber":2,"JuzNumber":1,"ManzilNumber":1,"RukuNumber":2,"MaqraNumber":1,"HizbNumber":1,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":2,"SurahIndex":"002","VerseNumber":6,"ShowSurahName":false,"ShowBismillah":false,"Text":"إِنَّ ٱلَّذِينَ كَفَرُواْ سَوَآءٌ عَلَيۡهِمۡ ءَأَنذَرۡتَهُمۡ أَمۡ لَمۡ تُنذِرۡهُمۡ لَا يُؤۡمِنُونَ","TajweedText":"إِ<tajweed class=ghunnah>نّ</tajweed>َ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ كَفَرُو<tajweed class=slnt>اْ</tajweed> سَو<tajweed class=madda_obligatory>َا</tajweed>ٓءٌ عَلَيْهِمْ ءَأَ<tajweed class=ikhafa>نذ</tajweed>َرْتَهُمْ أَمْ لَمْ تُ<tajweed class=ikhafa>نذ</tajweed>ِرْهُمْ لَا يُؤْمِن<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٦</span>","End":"٦","PageNumber":3,"JuzNumber":1,"ManzilNumber":1,"RukuNumber":2,"MaqraNumber":1,"HizbNumber":1,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":2,"SurahIndex":"002","VerseNumber":7,"ShowSurahName":false,"ShowBismillah":false,"Text":"خَتَمَ ٱللَّهُ عَلَىٰ قُلُوبِهِمۡ وَعَلَىٰ سَمۡعِهِمۡۖ وَعَلَىٰٓ أَبۡصَٰرِهِمۡ غِشَٰوَةٞۖ وَلَهُمۡ عَذَابٌ عَظِيمٞ","TajweedText":"خَتَمَ <tajweed class=ham_wasl>ٱ</tajweed>للَّهُ عَلَىٰ قُلُوبِهِمْ وَعَلَىٰ سَمْعِهِمْ‌ۖ وَعَلَ<tajweed class=madda_obligatory>ىٰٓ</tajweed> أَ<tajweed class=qalaqah>بْ</tajweed>صَ<tajweed class=madda_normal>ـٰ</tajweed>رِهِمْ غِشَ<tajweed class=madda_normal>ـٰ</tajweed>وَ<tajweed class=idgham_ghunnah>ةٌ‌ۖ و</tajweed>َلَهُمْ عَذَابٌ عَظ<tajweed class=madda_permissible>ِي</tajweed>مٌ <span class=end>٧</span>","End":"٧","PageNumber":3,"JuzNumber":1,"ManzilNumber":1,"RukuNumber":2,"MaqraNumber":1,"HizbNumber":1,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":2,"SurahIndex":"002","VerseNumber":8,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَمِنَ ٱلنَّاسِ مَن يَقُولُ ءَامَنَّا بِٱللَّهِ وَبِٱلۡيَوۡمِ ٱلۡأٓخِرِ وَمَا هُم بِمُؤۡمِنِينَ","TajweedText":"وَمِنَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َاسِ م<tajweed class=idgham_ghunnah>َن ي</tajweed>َقُولُ ءَامَ<tajweed class=ghunnah>نّ</tajweed>َا بِ<tajweed class=ham_wasl>ٱ</tajweed>للَّهِ وَبِ<tajweed class=ham_wasl>ٱ</tajweed>لْيَوْمِ <tajweed class=ham_wasl>ٱ</tajweed>لْأَخِرِ وَمَا ه<tajweed class=ikhafa_shafawi>ُم ب</tajweed>ِمُؤْمِن<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٨</span>","End":"٨","PageNumber":3,"JuzNumber":1,"ManzilNumber":1,"RukuNumber":3,"MaqraNumber":1,"HizbNumber":1,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":2,"SurahIndex":"002","VerseNumber":9,"ShowSurahName":false,"ShowBismillah":false,"Text":"يُخَٰدِعُونَ ٱللَّهَ وَٱلَّذِينَ ءَامَنُواْ وَمَا يَخۡدَعُونَ إِلَّآ أَنفُسَهُمۡ وَمَا يَشۡعُرُونَ","TajweedText":"يُخَ<tajweed class=madda_normal>ـٰ</tajweed>دِعُونَ <tajweed class=ham_wasl>ٱ</tajweed>للَّهَ وَ<tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ ءَامَنُو<tajweed class=slnt>اْ</tajweed> وَمَا يَخْدَعُونَ إِلّ<tajweed class=madda_obligatory>َآ</tajweed> أَ<tajweed class=ikhafa>نف</tajweed>ُسَهُمْ وَمَا يَشْعُر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٩</span>","End":"٩","PageNumber":3,"JuzNumber":1,"ManzilNumber":1,"RukuNumber":3,"MaqraNumber":1,"HizbNumber":1,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":2,"SurahIndex":"002","VerseNumber":10,"ShowSurahName":false,"ShowBismillah":false,"Text":"فِي قُلُوبِهِم مَّرَضٞ فَزَادَهُمُ ٱللَّهُ مَرَضٗاۖ وَلَهُمۡ عَذَابٌ أَلِيمُۢ بِمَا كَانُواْ يَكۡذِبُونَ","TajweedText":"فِى قُلُوبِه<tajweed class=idgham_shafawi>ِم م</tajweed>َّرَ<tajweed class=ikhafa>ضٌ ف</tajweed>َزَادَهُمُ <tajweed class=ham_wasl>ٱ</tajweed>للَّهُ مَرَ<tajweed class=idgham_ghunnah>ضًا‌ۖ و</tajweed>َلَهُمْ عَذَابٌ أَلِي<tajweed class=iqlab>مُۢ ب</tajweed>ِمَا كَانُو<tajweed class=slnt>اْ</tajweed> يَكْذِب<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٠</span>","End":"١٠","PageNumber":3,"JuzNumber":1,"ManzilNumber":1,"RukuNumber":3,"MaqraNumber":1,"HizbNumber":1,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":2,"SurahIndex":"002","VerseNumber":11,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِذَا قِيلَ لَهُمۡ لَا تُفۡسِدُواْ فِي ٱلۡأَرۡضِ قَالُوٓاْ إِنَّمَا نَحۡنُ مُصۡلِحُونَ","TajweedText":"وَإِذَا قِيلَ لَهُمْ لَا تُفْسِدُو<tajweed class=slnt>اْ</tajweed> فِى <tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ قَال<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َمَا نَحْنُ مُصْلِح<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١١</span>","End":"١١","PageNumber":3,"JuzNumber":1,"ManzilNumber":1,"RukuNumber":3,"MaqraNumber":1,"HizbNumber":1,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":2,"SurahIndex":"002","VerseNumber":12,"ShowSurahName":false,"ShowBismillah":false,"Text":"أَلَآ إِنَّهُمۡ هُمُ ٱلۡمُفۡسِدُونَ وَلَٰكِن لَّا يَشۡعُرُونَ","TajweedText":"أَل<tajweed class=madda_obligatory>َآ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َهُمْ هُمُ <tajweed class=ham_wasl>ٱ</tajweed>لْمُفْسِدُونَ وَلَ<tajweed class=madda_normal>ـٰ</tajweed>ك<tajweed class=idgham_wo_ghunnah>ِن ل</tajweed>َّا يَشْعُر<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٢</span>","End":"١٢","PageNumber":3,"JuzNumber":1,"ManzilNumber":1,"RukuNumber":3,"MaqraNumber":1,"HizbNumber":1,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":2,"SurahIndex":"002","VerseNumber":13,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِذَا قِيلَ لَهُمۡ ءَامِنُواْ كَمَآ ءَامَنَ ٱلنَّاسُ قَالُوٓاْ أَنُؤۡمِنُ كَمَآ ءَامَنَ ٱلسُّفَهَآءُۗ أَلَآ إِنَّهُمۡ هُمُ ٱلسُّفَهَآءُ وَلَٰكِن لَّا يَعۡلَمُونَ","TajweedText":"وَإِذَا قِيلَ لَهُمْ ءَامِنُو<tajweed class=slnt>اْ</tajweed> كَم<tajweed class=madda_obligatory>َآ</tajweed> ءَامَنَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َاسُ قَال<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> أَنُؤْمِنُ كَم<tajweed class=madda_obligatory>َآ</tajweed> ءَامَنَ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سُّفَه<tajweed class=madda_obligatory>َا</tajweed>ٓءُ‌ۗ أَل<tajweed class=madda_obligatory>َآ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َهُمْ هُمُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سُّفَه<tajweed class=madda_obligatory>َا</tajweed>ٓءُ وَلَ<tajweed class=madda_normal>ـٰ</tajweed>ك<tajweed class=idgham_wo_ghunnah>ِن ل</tajweed>َّا يَعْلَم<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٣</span>","End":"١٣","PageNumber":3,"JuzNumber":1,"ManzilNumber":1,"RukuNumber":3,"MaqraNumber":1,"HizbNumber":1,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":2,"SurahIndex":"002","VerseNumber":14,"ShowSurahName":false,"ShowBismillah":false,"Text":"وَإِذَا لَقُواْ ٱلَّذِينَ ءَامَنُواْ قَالُوٓاْ ءَامَنَّا وَإِذَا خَلَوۡاْ إِلَىٰ شَيَٰطِينِهِمۡ قَالُوٓاْ إِنَّا مَعَكُمۡ إِنَّمَا نَحۡنُ مُسۡتَهۡزِءُونَ","TajweedText":"وَإِذَا لَقُو<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ ءَامَنُو<tajweed class=slnt>اْ</tajweed> قَال<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> ءَامَ<tajweed class=ghunnah>نّ</tajweed>َا وَإِذَا خَلَوْ<tajweed class=slnt>اْ</tajweed> إِلَىٰ شَيَ<tajweed class=madda_normal>ـٰ</tajweed>طِينِهِمْ قَال<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed> إِ<tajweed class=ghunnah>نّ</tajweed>َا مَعَكُمْ إِ<tajweed class=ghunnah>نّ</tajweed>َمَا نَحْنُ مُسْتَهْزِء<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٤</span>","End":"١٤","PageNumber":3,"JuzNumber":1,"ManzilNumber":1,"RukuNumber":3,"MaqraNumber":1,"HizbNumber":1,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":2,"SurahIndex":"002","VerseNumber":15,"ShowSurahName":false,"ShowBismillah":false,"Text":"ٱللَّهُ يَسۡتَهۡزِئُ بِهِمۡ وَيَمُدُّهُمۡ فِي طُغۡيَٰنِهِمۡ يَعۡمَهُونَ","TajweedText":"ٱللَّهُ يَسْتَهْزِئُ بِهِمْ وَيَمُدُّهُمْ فِى طُغْيَ<tajweed class=madda_normal>ـٰ</tajweed>نِهِمْ يَعْمَه<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>١٥</span>","End":"١٥","PageNumber":3,"JuzNumber":1,"ManzilNumber":1,"RukuNumber":3,"MaqraNumber":1,"HizbNumber":1,"HizbDecimal":0.0,"HasSajda":false},{"SurahNumber":2,"SurahIndex":"002","VerseNumber":16,"ShowSurahName":false,"ShowBismillah":false,"Text":"أُوْلَـٰٓئِكَ ٱلَّذِينَ ٱشۡتَرَوُاْ ٱلضَّلَٰلَةَ بِٱلۡهُدَىٰ فَمَا رَبِحَت تِّجَٰرَتُهُمۡ وَمَا كَانُواْ مُهۡتَدِينَ","TajweedText":"أُ<tajweed class=slnt>وْ</tajweed>لَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ئِكَ <tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ <tajweed class=ham_wasl>ٱ</tajweed>شْتَرَوُ<tajweed class=slnt>اْ</tajweed> <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>ضَّلَ<tajweed class=madda_normal>ـٰ</tajweed>لَةَ بِ<tajweed class=ham_wasl>ٱ</tajweed>لْهُدَىٰ فَمَا رَبِحَت تِّجَ<tajweed class=madda_normal>ـٰ</tajweed>رَتُهُمْ وَمَا كَانُو<tajweed class=slnt>اْ<